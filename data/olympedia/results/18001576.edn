600"} "1996"] "\n" [:option {:value "31637"} "2000"] "\n" [:option {:value "31674"} "2004"] "\n" [:option {:value "261431"} "2008"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/529"} "Event type"]] [:h1 {:class "event_title"} "Softball, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "21 – 27 July 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2134"} "Yokohama Sutajiamu, Yokohama"] " / " [:a {:href "/venues/2135"} "Fukushima Azuma Baseball Stadium, Fukushima"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/18001576"} "90 from 6 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Round-robin tournament, with the top four teams progressing to medal round."]]]] [:div {:class "description"} [:p {} "Softball had been on the Olympic Program from 1996-2008 but was dropped after the Beijing Olympics. It returned for the 2020 Tokyo Olympics, but with some caveats. The women and the men, who played baseball, would have only six teams in their tournaments, to keep the number of athletes smaller. To avoid requiring the Organizing Committee to build an extra new facility, softball was played on a baseball diamond, with the baseball pitchers’ mound strangely located between second base and the softball mound. Outfield fences were artificially moved in, which meant there was no warning track for outfielders."] "\n\n" [:p {} "The six teams in the Olympic Tournament were Japan, the United States, Canada, Mexico, Australia, and Italy. They played a round-robin tournament that advanced the top two, the USA and Japan, to the gold medal game, while the 3rd- and 4th-place finishers, Mexico and Canada, played for the bronze medal."] "\n\n" [:p {} "The bronze medal game was held first on 27 July. Canada scored two runs in the second inning and added another in the fifth. Mexico chipped away with runs in the third and fifth innings but could not score in the top of the seventh, and Canada held on for the win and the bronze medal, 3-2."] "\n\n" [:p {} "The pitching match-up for the gold medal game was Japan’s " [:a {:href "/athletes/109124"} "Yukiko Ueno"] " facing American " [:a {:href "/athletes/109144"} "Cat Osterman"] ". Osterman had played at the 2004 and 2008 Olympics and had come out of retirement to play in Tokyo at 38-years-old. Osterman was pulled in the third inning, after loading the bases, although " [:a {:href "/athletes/147251"} "Ally Carda"] " got her out of the jam in relief. She gave up runs to Japan in the fourth and fifth innings and was replaced by " [:a {:href "/athletes/113482"} "Monica Abbott"] " but it was too late for the Americans, who never scored. " [:a {:href "/athletes/144441"} "Miu Goto"] " relieved Ueno in the 7th inning and closed out the game for a 2-0 shut-out and a Japanese gold medal. Japan actually defended their gold medal, as they also won in 2008."] "\n"] [:button {:id "button945583", :class "btn btn-default"} "Details"] [:script {} "$('#button945583').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {}] [:th {} "Pos"] [:th {} "Number"] [:th {} "Team"] [:th {} "NOC"] [:th {:style "display: none", :class "split"} "Wins/At Bats"] [:th {:style "display: none", :class "split"} "Losses/Runs"] [:th {:style "display: none", :class "split"} "Points/Hits"] [:th {:style "display: none", :class "split"} "Runs For/Doubles"] [:th {:style "display: none", :class "split"} "Runs Against/Triples"] [:th {:style "display: none", :class "split"} "Home Runs"] [:th {:style "display: none", :class "split"} "RBIs"] [:th {:style "display: none", :class "split"} "Walks"] [:th {:style "display: none", :class "split"} "Strikeouts"] [:th {:style "display: none", :class "split"} "Stolen Bases/Caught Stealing"] [:th {:style "display: none", :class "split"} "Sacrifice Hits/Sacrifi