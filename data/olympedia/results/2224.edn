alue "2184"} "1924"] "\n" [:option {:value "2189"} "1928"] "\n" [:option {:value "2194"} "1932"] "\n" [:option {:value "2199"} "1936"] "\n" [:option {:value "2204"} "1948"] "\n" [:option {:value "2210"} "1952"] "\n" [:option {:value "2217"} "1956"] "\n" [:option {:value "2231"} "1964"] "\n" [:option {:value "2238"} "1968"] "\n" [:option {:value "2245"} "1972"] "\n" [:option {:value "2252"} "1976"] "\n" [:option {:value "2259"} "1980"] "\n" [:option {:value "2266"} "1984"] "\n" [:option {:value "2273"} "1988"] "\n" [:option {:value "2287"} "1992"] "\n" [:option {:value "2301"} "1994"] "\n" [:option {:value "2311"} "1998"] "\n" [:option {:value "2321"} "2002"] "\n" [:option {:value "2334"} "2006"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/368"} "Event type"]] [:h1 {:class "event_title"} "Individual, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "21 – 22 February 1960"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/139"} "Olympic Jumping Hill, Squaw Valley, California"] " / " [:a {:href "/venues/143"} "McKinney Creek Stadium, Tahoma, California"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2224"} "33 from 13 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Normal hill ski jumping and 15 kilometres skiing; placements determined by points table."]]]] [:div {:class "description"} [:p {} "Defending Olympic Champion " [:a {:href "/athletes/97823"} "Sverre Stenersen"] " had shown consistency after 1956, taking the silver medal at the 1958 World Championships and winning at Holmenkollen in 1959. His teammate, " [:a {:href "/athletes/88070"} "Tormod Knutsen"] ", younger by five years but the National Champion in 1959-60 and winner at Holmenkollen in 1958, was considered as Norway’s gold favorite for the 1960 Olympics. Finland’s 1958 World Champion, " [:a {:href "/athletes/88529"} "Paavo Korhonen"] ", was an excellent cross-country skier, but his jumping was very variable and he was depending on two good jumps to be able to fight for the medals."] "\n\n" [:p {} "The Nordic Combination started with the ski jumping event as in the last two Winter Olympic Games. " [:a {:href "/athletes/89562"} "Georg Thoma"] ", a 22-year-old from Hinterzarten in West Germany, won the jumping event ahead of Soviet Union’s " [:a {:href "/athletes/89562"} "Dmitry Kochkin"] " and the Japanese " [:a {:href "/athletes/85577"} "Yosuke Eto"] ", but all three were considered too weak in the cross-country event to contend for the gold medal. Thoma had recently won the West-German championships in ski jumping. Tormod Knutsen, lying fourth after the jumping event, was considered as the main favorite for the gold. World Champion Paavo Korhonen, placing only a modest 24th, seemed out of contention."] "\n\n" [:p {} "The cross-country race on the next day produced some surprising results. George Thoma skied well and produced the fourth fastest time of the day, holding off Tormod Knutsen and won the gold medal with a clear margin over his Norwegian opponent. " [:a {:href "/athletes/86316"} "Nikolay Gusakov"] " of the Soviet Union, a 25-year old Karelian married to 10 km Olympic Champion " [:a {:href "/athletes/81213"} "Mariya Gusakova"] ", was the fastest skier of the day and advanced from tenth place in the jumping event into bronze medal position. " [:a {:href "/athletes/96874"} "Pekka Ristola"] " from Finland placed sixth in both events and advanced to fourth place, ahead of Kochkin, who produced a decent cross-country race but could not defend his silver position from the jumping event."] "\n\n" [:p {} "Georg Thoma, after his breakthrough at the 1960 Olympics, emerged as one of the greatest all-time athletes in Nordic Combined. He won the Holmenkollen event in 1963, 1964 and 1965, and crowned his skiing career as World Champion in the same arena in 1966. He won another Olympic medal by placing third at the 1964 Games in Innsbruck."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Ski Jumping, Normal Hill"] [:th {} "Cross Country Skiing, 15 km"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/98235"} "Georg Thoma"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "457.952"] [:td {} "221.5 (1)"] [:td {} "59:23.8 (4)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/88070"} "Tormod Knutsen"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "453.000"] [:td {} "217.0 (4)"] [:td {} "59:31.0 (5)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/86316"} "Nikolay Gusakov"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "452.000"] [:td {} "212.0 (=10)"] [:td {} "58:29.4 (1)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/96874"} "Pekka Ristola"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]] [:td {} "449.871"] [:td {} "214.0 (=6)"] [:td {} "59:32.8 (6)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {} [:a {:href "/athletes/88085"} "Dmitry Koc