tes/60868"} "Branko Martinović"] ", who had won a silver medal as a lightweight in 1960. Rurua would take over as the dominant wrestler in this class, winning the 1968 gold medal, and the World Championships in 1966-67 and 1969."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Round Eliminated"] [:th {} "Bad Points"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "23"] [:td {} [:a {:href "/athletes/58628"} "Imre Polyák"]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "13"] [:td {} [:a {:href "/athletes/60523"} "Roman Rurua"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "6"] [:td {} [:a {:href "/athletes/60868"} "Branko Martinović"]] [:td {} [:a {:href "/countries/YUG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/YUG.png"}] "YUG"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=4"] [:td {:class "bib"} "24"] [:td {} [:a {:href "/athletes/60626"} "Ron Finley"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}