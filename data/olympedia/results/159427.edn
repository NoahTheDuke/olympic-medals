ion {:value "2012477"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/389"} "Event type"]] [:h1 {:class "event_title"} "Eights, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "22 – 28 July 1996"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/718"} "Lake Sidney Lanier, Gainesville, Georgia"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/159427"} "90 from 10 countries"]]]]] [:div {:class "description"} [:p {} "The last 12 World Championship medals in the men’s coxed eights had gone to four countries: Germany (gold in 1993 and 1995), the United States (gold in 1994, bronze in 1993 and 1995), the Netherlands (silver in 1994 and 1995), and Romania (silver in 1993, bronze in 1994). The Canadians, meanwhile, were the defending Olympic champions, and two returned to the 1996 Games to help defend the crown: " [:a {:href "/athletes/36076"} "Darren Barber"] " and " [:a {:href "/athletes/36113"} "Andy Crosby"] ". With many distinguished rowers on each crew, the event promised to be an exciting one, but the Dutch squad was in control for the entire tournament, qualifying with the fastest time in the opening round and winning gold by a comfortable margin of almost two seconds. Among their lineup were three Olympic medalists in the double sculls: " [:a {:href "/athletes/38897"} "Ronald Florijn"] ", champion in 1988, " [:a {:href "/athletes/39039"} "Henk Jan Zwolle"] ", who earned bronze in 1992, and " [:a {:href "/athletes/38963"} "Nico Rienks"] ", who had been both of their partners. The United States had won the other heat in round one, albeit in a slower time than the Canadians had finished in the Dutch heat, but it was the Germans who put up the strongest fight against the Netherlands in the final and thus earned silver. Somewhat more surprising was Russia’s performance, as they stole bronze from the Canadians by a margin of nearly a second and earned their first Olympic rowing medal as an independent nation (or, at least, not as the Soviet Union) since " [:a {:href "/athletes/39656"} "Mart Kuusik"] " had won bronze in the single sculls in 1912 (and Kuusik was ethnically Estonian)."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Netherlands"] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/39039"} "Henk Jan Zwolle"] " • " [:a {:href "/athletes/38980"} "Diederik Simon"] " • " [:a {:href "/athletes/38850"} "Michiel Bartman"] " • " [:a {:href "/athletes/38947"} "Koos Maasdijk"] " • " [:a {:href "/athletes/39008"} "Niels van der Zwan"] " • " [:a {:href "/athletes/39019"} "Niels van Steenis"] " • " [:a {:href "/athletes/38897"} "Ronald Florijn"] " • " [:a {:href "/athletes/38963"} "Nico Rienks"] " • " [:a {:href "/athletes/38889"} "Jeroen Duyster"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Germany"] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/37967"} "Frank Richter"] " • " [:a {:href "/athletes/37884"} "Mark Kleinschmidt"] " • " [:a {:href "/athletes/37859"} "Wolfram Huhn"] " • " [:a {:href "/athletes/38036"} "Marc Weber"] " • " [:a {:href "/athletes/37880"} "Detlef Kirchhoff"] " • " [:a {:href "/athletes/38007"} "Thorste