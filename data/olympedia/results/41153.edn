-align: top;"} "Olympic Record  (Ranking Round, 216 arrows)"] [:td {} [:a {:href "/results/40957"} "2,031"] " " [:span {:class "label label-primary"} "WR"] " / " [:a {:href "/athletes/1973"} "Jang Yong-Ho"] " • " [:a {:href "/athletes/1974"} "Kim Bo-Ram"] " • " [:a {:href "/athletes/1978"} "Oh Gyo-Mun"] " " [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"] " / 28 July 1996 / " [:a {:href "/records/event_name/2/Ranking%20Round,%20216%20arrows"} "Details"]]]]] [:div {:class "description"} [:p {} "The two top teams in the world were Korea, which had won the World Championship in 1995 and 1997, and Italy, the 1999 World Champions. There were no surprises in Sydney as both teams moved to the final, where Korea won the gold medal easily, 255-247. The defending champion American team won the bronze medal over Russia, in a match which was tied, the Americans winning in a shoot-out."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Republic of Korea"] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/1973"} "Jang Yong-Ho"] " • " [:a {:href "/athletes/1978"} "Oh Gyo-Mun"] " • " [:a {:href "/athletes/83168"} "Kim Cheong-Tae"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Italy"] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} 