:value "19016400"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/278"} "Event type"]] [:h1 {:class "event_title"} "Foil, Individual, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "29 July 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2167"} "Grand Palais, Paris, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2010900"} "37 from 21 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament."]]]] [:div {:class "description"} [:p {} "Hong Kong’s " [:a {:href "/athletes/134324"} "Ka Long “Edgar” Cheung"] " was the defending gold medalist. He had won the 2022 Asian Games and was 2022 Asian Champion, adding a bronze medal that year at the World Championships. He was expected to be challenged by American " [:a {:href "/athletes/147417"} "Nick Itkin"] ", silver medalist at the 2023 World Championships and world ranked #1, and the last two World Champions, " [:a {:href "/athletes/120056"} "Enzo Lefort"] " of France, who won in 2019 and 2022, and Italy’s " [:a {:href "/athletes/151939"} "Tommaso Marini"] ", the 2023 World Champion who was seeded #1 in Paris."] "\n\n" [:p {} "Of the favorites, Marini went out first, losing in the third round to France’s " [:a {:href "/athletes/142870"} "Maxime Pauty"] " by 15-14. Cheung and Lefort met in the quarter-finals, with Cheung also winning by 15-14. The semi-finals came down to Cheung versus Japan’s " [:a {:href "/athletes/151944"} "Kazuki Iimura"] ", and Itkin against Italian " [:a {:href "/athletes/2503318"} "Filippo Macchi"] ". Both matches were decided by 15-11 scores, with Cheung making the finals, but Macchi upsetting Itkin."] "\n\n" [:p {} "The final was very close, with Cheung prevailing over Macchi, 15-14. In the bronze medal match, Itkin had an easier time of it, defeating Iimura 15-12. Cheung’s victory made him the third male foil fencer to win consecutive gold medals, after " [:a {:href "/athletes/22697"} "Nedo Nadi"] " (ITA) (1912-20), and " [:a {:href "/athletes/21837"} "Christian d’Oriola"] " (FRA) in 1952-56. Macchi’s medal was the 23rd in the event for Italy, trailing only France, with 25."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Seed"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "4"] [:td {} [:a {:href "/athletes/134324"} "Edgar Cheung"]] [:td {} [:a {:href "/countries/HKG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HKG.png"}] "HKG"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "11"] [:td {} [:a {:href "/athletes/2503318"} "Filippo Macchi"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "2"] [:td {} [:a {:href "/athletes/147417"} "Nick Itkin"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "9"] [:td {} [:a {:href "/athletes/151944"} "Kazuki Iimura"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {:class "bib"} "3"] [: