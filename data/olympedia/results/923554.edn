int (Classical), Men"] "\n" [:option {:value "923550"} "15 kilometres (Freestyle), Men"] "\n" [:option {:value "923551"} "30 kilometres Skiathlon, Men"] "\n" [:option {:value "923569"} "4 × 10 kilometres Relay, Men"] "\n" [:option {:value "923573"} "Team Sprint (Freestyle), Men"] "\n" [:option {:value "923583"} "Sprint (Classical), Women"] "\n" [:option {:value "923578"} "10 kilometres (Freestyle), Women"] "\n" [:option {:value "923582"} "30 kilometres (Mass Start, Classical), Women"] "\n" [:option {:value "923579"} "15 kilometres Skiathlon, Women"] "\n" [:option {:value "923597"} "4 × 5 kilometres Relay, Women"] "\n" [:option {:value "923601"} "Team Sprint (Freestyle), Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1890"} "1924"] "\n" [:option {:value "1892"} "1928"] "\n" [:option {:value "1894"} "1932"] "\n" [:option {:value "1896"} "1936"] "\n" [:option {:value "1902"} "1948"] "\n" [:option {:value "1908"} "1952"] "\n" [:option {:value "1916"} "1956"] "\n" [:option {:value "1927"} "1960"] "\n" [:option {:value "1938"} "1964"] "\n" [:option {:value "1950"} "1968"] "\n" [:option {:value "1962"} "1972"] "\n" [:option {:value "1974"} "1976"] "\n" [:option {:value "1987"} "1980"] "\n" [:option {:value "2000"} "1984"] "\n" [:option {:value "2014"} "1988"] "\n" [:option {:value "2031"} "1992"] "\n" [:option {:value "2051"} "1994"] "\n" [:option {:value "2071"} "1998"] "\n" [:option {:value "2091"} "2002"] "\n" [:option {:value "2134"} "2006"] "\n" [:option {:value "350067"} "2014"] "\n" [:option {:value "9000278"} "2018"] "\n" [:option {:value "19019713"} "2022"] "\n" [:option {:value "15000134"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/187"} "Event type"]] [:h1 {:class "event_title"} "50 kilometres (Mass Start, Classical), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "28 February 2010 — 9:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/181"} "Whistler Olympic Park, Whistler"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/923554"} "53 from 21 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 49,525 m" [:br {}] "Height Differential: 85 m" [:br {}] "Intermediate 1: 12.3 km" [:br {}] "Intermediate 2: 25.0 km" [:br {}] "Intermediate 3: 39.2 km" [:br {}] "Maximum Climb: 59 m" [:br {}] "Total Climbing: 1,745 m"]]]] [:div {:class "description"} [:p {} "The race was held in a warm rain, with melting snow that made conditions very sticky and slow. It also served to keep the pack together and contributed to the closest mass finish ever in Olympic marathon racing. At various points throughout the race, " [:a {:href "/athletes/118807"} "Martin Johnsrud Sundby"] " (NOR), " [:a {:href "/athletes/118751"} "Daniel Richardsson"] " (SWE) and " [:a {:href "/athletes/109828"} "Aleksandr Legkov"] " (RUS) tried to make breaks, but they were short-lived. With 5 kilometres to go there were still around 18 skiers in the leading group. With a kilometre to go, at least 15 skiers were together. Coming into the stadium, Germany’s " [:a {:href "/athletes/101020"} "Axel Teichmann"] " took the lead going up the final hill. He led on the final turn in the stadium, 100 metres remaining, but barely over Norway’s " [:a {:href "/athletes/118832"} "Petter Northug"] " and Switzerland’s " [:a {:href "/athletes/118753"} "Dario Cologna"] ". Cologna tragically fell in the sprint, and would finish 10th. Northug caught Teichmann in the sprint and pulled away to win the gold medal. The top five places were separated only by 1.6 seconds. Northug’s victory was not unexpected, as he was the 2009 World Champion, although in freestyle, and was leading the 2009-10 World Cup competition. This gave him his second gold medal and fourth medal of the 2010 Winter Olympics. The true meaning of the Olympic spirit was evident when " [:a {:href "/athletes/109855"} "Francesc Soulie"] " (AND) defeated " [:a {:href "/athletes/118773"} "Jonas Thor Olsen"] " (DEN) by 0.1 second – they were actually racing for 47th and 48th places, the last two skiers to complete the course!"] "\n"] [:button {:id "button53905", :class "btn btn-default"} "Details"] [:script {} "$('#button53905').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "Intermediate 1"] [:th {:style "display: none", :class "split"} "Intermediate 2"] [:th {:style "display: none", :class "split"} "Intermediate 3"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/118832"} "Petter Northug"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "2-05:35.5"] [:td {:class "split", :style "display: none"} "31:47.6 (19)"] [:td {:class "split", :style "display: none"} "1-03:37.7 (15)"] [:td {:class "split", :style "display: none"} "1-38:12.7 (10)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "6"] [:td {} [:a {:href "/athletes/101020"} "Axel Teichmann"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "2-05:35.8"] [:td {:class "split", :style "display: none"} "31:49.6 (27)"] [:td {:class "split", :style "displa