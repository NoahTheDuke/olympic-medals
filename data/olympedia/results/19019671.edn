e "19019664"} "Two, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "15000101"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/2581"} "Event type"]] [:h1 {:class "event_title"} "Monobob, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "13 – 14 February 2022"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2144"} "Yanqing National Sliding Centre, West Dazhuangke, Zhangshanying, Yanqing District"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19019671"} "20 from 16 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Curves: 16" [:br {}] "Length: 1,615 m" [:br {}] "Start Altitude: 1,017 m" [:br {}] "Vertical Drop: 121 m"]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/118672"} "Kaillie Humphries"] " (USA) won the inaugural women’s monobob gold medal with a dominant performance, winning by 1.54 seconds from her fellow-American " [:a {:href "/athletes/118644"} "Elana Meyers Taylor"] " (USA). For both Humphries and Meyers Taylor this was their fourth Olympic bobsleigh medal, with Humphries winning her third gold medal, all records for women’s bobsledders."] "\n\n" [:p {} "Humphries competed for Canada from 2010-18, and she therefore became the first female Winter Olympian to win gold medals for two non-politically related nations at the Summer or Winter Games. Only " [:a {:href "/athletes/101557"} "Viktor An"] " (South Korea/Russia) has done this previously at the Winter Olympics."] "\n\n" [:p {} "The United States 1-2 finish was the 19th time they have won gold-silver in a Winter Olympic event, and the eighth time it has been achieved by USA women. The bronze medal was won by Canada’s " [:a {:href "/athletes/136825"} "Christine de Bruin"] ", who competed at PyeongChang 2018 in the two-women bobsleigh, finishing seventh."] "\n\n" [:p {} "Humphries became the oldest gold medallist in women’s bobsledding at 36 years, 163 days. The previous oldest was " [:a {:href "/athletes/110772"} "Heather Moyse"] " (Can), at 35 years 210 days in 2014."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Run #1"] [:th {} "Run #2"] [:th {} "Run #3"] [:th {} "Run #4"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/118672"} "Kaillie Humphries"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "4:19.27"] [:td {} "1:04.44 (1)"] [:td {} "1:04.66 (1)"] [:td {} "1:04.87 (1)"] [:td {} "1:05.30 (3)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/118644"} "Elana Meyers Taylor"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "4:20.81"] [:td {} "1:05.12 (=3)"] [:td {} "1:05.30 (3)"] [:td {} "1:05.28 (3)"] [:td {} "1:05.11 (1)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/136825"} "Christine de Bruin"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {} "4:21.03"] [:td {} "1:05.12 (=3)"] [:td {} "1:05.02 (2)"] [:td {} "1:05.38 (4)"]