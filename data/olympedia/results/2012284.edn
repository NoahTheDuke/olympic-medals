2012215"} "Team All-Around, Men"] "\n" [:option {:value "2012230"} "Floor Exercise, Men"] "\n" [:option {:value "2012233"} "Vault, Men"] "\n" [:option {:value "2012240"} "Parallel Bars, Men"] "\n" [:option {:value "2012243"} "Horizontal Bar, Men"] "\n" [:option {:value "2012246"} "Rings, Men"] "\n" [:option {:value "2012249"} "Pommelled Horse, Men"] "\n" [:option {:value "2012252"} "Individual All-Around, Women"] "\n" [:option {:value "2012263"} "Team All-Around, Women"] "\n" [:option {:value "2012274"} "Floor Exercise, Women"] "\n" [:option {:value "2012277"} "Vault, Women"] "\n" [:option {:value "2012287"} "Balance Beam, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "70180"} "1952"] "\n" [:option {:value "70205"} "1956"] "\n" [:option {:value "70245"} "1960"] "\n" [:option {:value "70289"} "1964"] "\n" [:option {:value "70333"} "1968"] "\n" [:option {:value "70393"} "1972"] "\n" [:option {:value "70451"} "1976"] "\n" [:option {:value "70509"} "1980"] "\n" [:option {:value "70567"} "1984"] "\n" [:option {:value "70625"} "1988"] "\n" [:option {:value "70683"} "1992"] "\n" [:option {:value "70741"} "1996"] "\n" [:option {:value "70825"} "2000"] "\n" [:option {:value "70909"} "2004"] "\n" [:option {:value "259994"} "2008"] "\n" [:option {:value "313039"} "2012"] "\n" [:option {:value "353690"} "2016"] "\n" [:option {:value "19009184"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/330"} "Event type"]] [:h1 {:class "event_title"} "Uneven Bars, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "28 July –  4 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2166"} "Bercy Arena, Bercy, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2012284"} "80 from 35 countries"]]]]] [:div {:class "description"} [:p {} "The Tokyo 2020 champion, Belgium’s " [:a {:href "/athletes/129149"} "Nina Derwael"] ", had struggled with knee and shoulder injuries since her gold medal. In 2022, she had managed a bronze at the World Championships, but she had missed the 2023 edition in front of a home crowd in Antwerp. The world titles of 2021 and 2022 were taken by China’s Wei Xiaoyuan, but she did not qualify for the Chinese team in Paris. The 2023 champion, her compatriot " [:a {:href "/athletes/152578"} "Qiu Qiyuan"] ", did make the team."] "\n\n" [:p {} "Qualifying was led by Algeria’s " [:a {:href "/athletes/152536"} "Kaylia Nemour"] ". She was born in France to an Algerian father and French mother and had competed for France as a junior. A dispute with the French federation, however, led Nemour to change nationality to Algeria, a move that was delayed by the French federation. This made qualifying for the 2023 World Championships (and eventually the Paris Olympics) impossible, and an unsuccessful petition was made to try to persuade the federation. When other gymnasts came out detailing abuse they suffered under the federation, the French minister for sports started an investigation. Among others consequences, this led to the release of Nemour, who qualified for the 2023 Worlds, where she ultimately won a bronze in the uneven bars."] "\n\n" [:p {} "Behind Nemour, Qiu had been second in qualifying, followed by Tokyo all-around champion " [:a {:href "/athletes/147194"} "Suni Lee"] " and Derwael. " [:a {:href "/athletes/132107"} "Simone Biles"] " narrowly missed the final on her “worst” apparatus, placing ninth. The four qualifying leaders would occupy the same positions after the final. Nemour had her best exercise of the tournament, improving on her qualifying score to 15.700, and the score was greeted with great enthusiasm from the French crowd. Qiu had a similarly difficult exercise (7.2), but scored narrowly lower with 15.500, while the rest of the finalists were almost a point behind the Algerian. As the last gymnast, Lee narrowly beat defending champion Derwael for the bronze in 14.800. Nemour’s gold was the first ever Olympic gymnastics medal for Algeria, and the first gold for the country since " [:a {:href "/athletes/122730"} "Taoufik Makhloufi"] " in 2012. It was also the first ever gymnastics medal won by an athlete representing an African NOC."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/152536"} "Kaylia Nemour"]] [:td {} [:a {:href "/countries/ALG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ALG.png"}] "ALG"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/152578"} "Qiu Qiyuan"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/147194"} "Suni Lee"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/129149"} "Nina Derwael"]] [:td {} [:a {:href "/countries/BEL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.e