7"} "2008"] "\n" [:option {:value "332597"} "2012"] "\n" [:option {:value "355450"} "2016"] "\n" [:option {:value "19009619"} "2020"] "\n" [:option {:value "2008093"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/677"} "Event type"]] [:h1 {:class "event_title"} "Super-Heavyweight, Freestyle (≤130 kg), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "29 September –  1 October 1988"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/666"} "Sang-mu Che-yuk-gwan, Seongnam"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/130229"} "15 from 15 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Two groups (A and B).  Double elimination tournament within each group.  Top four in each group advance to placement matches for 1st-8th place."]]]] [:div {:class "description"} [:p {} "This class was different than in past Olympics as there was a maximum weight limit for the first time, with wrestlers required to no more than 130 kg, or 286 lbs. This was to prevent the massive men who had taken over this class since American " [:a {:href ""} "Chris Taylor"] " in 1972, who weighed in at over 400 lbs. (182 kg)."] "\n\n" [:p {} "The two greatest heavyweights in the 1980s and early 90s were American " [:a {:href "/athletes/60571"} "Bruce Baumgartner"] " and Soviet Georgian " [:a {:href "/athletes/60468"} "Davit Gobejishvili"] ". With Gobejishvili boycotted out of the 1984 Olympics, Baumgartner had an easier time winning gold. Gobejishvili had won the 1985 Worlds, while Baumgartner pushed him back to silver in 1986. Gobejishvili briefly lost his first spot as Soviet super-heavyweight to " [:a {:href ""} "Aslan Khadartsev"] ", the 1987 World and 1988-89 European Champion. At the 1988 World Cup Gobejishvili met Baumgartner and defeated him, which caused Soviet wrestling officials to have Khadartsev and Gobejishvili meet in a no time-limit match, which Gobejishvili won in 30 minutes to qualify for the 1988 Olympics."] "\n\n" [:p {} "In Seoul Baumgartner won four matches to win Group A, while Gobejishvili needed five matches in Group B. The final was close but Gobejishvili controlled it throughout, leading 3-0 until Baumgartner scored a late point, losing 3-1. The two would continue to dominate this class through the 1992 Olympics, where Baumgartner came back to win a second gold medal, with Gobejishvili taking bronze. Baumgartner also won a bronze medal at the 1996 Olympics."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Round Eliminated"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Classification Points", :class "footnote"} "CP"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "10"] [:td {} [:a {:href "/athletes/60468"} "Davit Gobejishvili"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/60571"} "Bruce Baumgartner"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "5"] [:td {} [:a {:href "/athletes/58418"} "Andreas Schröder"]] [:td {} [:a {:href "/countries/GDR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-centra