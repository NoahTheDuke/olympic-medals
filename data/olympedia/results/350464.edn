2"} "Slopestyle, Men"] "\n" [:option {:value "350512"} "Halfpipe, Men"] "\n" [:option {:value "350536"} "Cross, Men"] "\n" [:option {:value "350557"} "Parallel Giant Slalom, Women"] "\n" [:option {:value "350581"} "Parallel Slalom, Women"] "\n" [:option {:value "350615"} "Slopestyle, Women"] "\n" [:option {:value "350605"} "Halfpipe, Women"] "\n" [:option {:value "350629"} "Cross, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1636"} "2002"] "\n" [:option {:value "1692"} "2006"] "\n" [:option {:value "924350"} "2010"] "\n" [:option {:value "9000850"} "2018"] "\n" [:option {:value "19020670"} "2022"] "\n" [:option {:value "15001170"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/521"} "Event type"]] [:h1 {:class "event_title"} "Parallel Giant Slalom, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "19 February 2014"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/891"} "Ekstrim-Park Rosa Khutor, Krasnaya Polyana"] " / " [:a {:href "/venues/891"} "Ekstrim-Park Rosa Khutor, Krasnaya Polyana"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/350464"} "32 from 12 countries"]]] [:tr {:class "referees", :style ""} [:th {} "Course Setter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5001764"} "Denis Tikhomirov"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Gates: 29" [:br {}] "Length: 650 m" [:br {}] "Start Altitude: 1175 m" [:br {}] "Vertical Drop: 155 m"]]]] [:div {:class "description"} [:p {} "An American won the gold medal in the parallel giant slalom, but he won it for Russia. " [:a {:href "/athletes/128400"} "Vic Wild"] " grew up in Washington state and became a top Alpine snowboarder, but the Alpine snowboard events were not supported by the US ski federation, which left Wild fighting for funds to continue training. In 2010 Wild had met Russian snowboarder " [:a {:href "/athletes/119555"} "Alyona Zavarzina"] ", and they married in 2011. With the marriage Wild was able to apply for Russian citizenship and their federation was more than willing to support a medal contender, so Wild began competing for Russia in 2012."] "\n\n" [:p {} "The final came down to Wild against Swiss rider " [:a {:href "/athletes/119605"} "Nevin Galmarini"] ". Galmarini won the first run but Wild’s margin on the second run gave him the gold medal, only a few minutes after his wife, Zavarzina, won a bronze medal in the women’s parallel giant slalom. Slovenian " [:a {:href "/athletes/119642"} "Žan Košir"] " won the bronze medal race, defeating German " [:a {:href "/athletes/110885"} "Patrick Büssler"] ". Many of the favorites crashed out early. The last three gold medals had been won by Philipp Schoch (SUI) in 2002-06 and Jasey Jay Anderson (CAN) in 2010 but they both went out in the 1/8th-finals. Two Austrian favorites also struggled as 2013 World Champion " [:a {:href "/athletes/119838"} "Benjamin Karl"] " went out in the quarters, and 2013/14 World Cup leader " [:a {:href "/athletes/127385"} "Lukas Mathies"] " did not make it past qualifying."] "\n\n" [:p {} "Wild thanked the Russian team for their support, noting that he did not speak Russian, and that many of his teammates helped him, stating, “I don’t think many of them like me, but I really appreciate it.”"] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {