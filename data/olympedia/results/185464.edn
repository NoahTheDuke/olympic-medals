.amazonaws.com/ITA.png"}] "ITA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #2"] [:td {:style "width: 400px"} [:a {:href "/athletes/2305651"} "Bernd Springorum"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #3"] [:td {:style "width: 400px"} [:a {:href "/athletes/12293"} "Jack Le Goff"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #4"] [:td {:style "width: 400px"} [:a {:href "/athletes/11773"} "Patrick, Baron Connolly-Carew"]] [:td {} [:a {:href "/countries/IRL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/IRL.png"}] "IRL"]]] [:tr {:class "referees", :style ""} [:th {} "Course Designer"] [:td {:style "width: 400px"} [:a {:href "/athletes/2305735"} "Linda Allen"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]]]] [:div {:class "description"} [:p {} "There were two rounds, with four riders on each team, the top three scores in each round to count. Linda Allen designed the courses, the first woman to do so at the Olympics."] "\n\n" [:p {} "The German team took advantage of the scoring to win a gold medal with the lowest score ever in team jumping, with only 1.75 faults. In the first round rider " [:a {:href "/athletes/12756"} "Franke Sloothaak"] " fell and cut his wrist so badly that he needed stitches, but his round of 60.25 faults was thrown out, giving the team only 0.75 faults for the round. In the second round, Sloothaak was able to compete and rode cleanly, but " [:a {:href "/athletes/12492"} "Lars Nieberg"] " had 12.00 faults. However, Nieberg’s score did not matter as the other three riders had only a total of 1 fault in the round, bringing the gold medal quite easily over the United States. Germany was led by " [:a {:href "/athletes/11606"} "Ludger Beerbaum"] " and " [:a {:href "/athletes/12236"} "Uli Kirchhoff"] ", the individual gold medalists in 1992 and 1996, respectively."] "\n\n" [:p {} "The United States was well ahead of third-placed Brazil to win the silver medal. One rider on the US team, " [:a {:href "/athletes/12391"} "Michael Matz"] ", gained fame outside of equestrian sport both well before and after the Atlanta Olympics. In 1989, Matz was aboard United Airline flight 232 when it crashed in a cornfield near the Sioux City, Iowa airport. Matz survived the burning crash, but returned to the wreckage to rescue two small children who had not escaped. They also survived thanks to Matz’s heroics. In 1998 Matz turned to thoroughbred training and in 2006 trained Barbaro, a horse that won the Kentucky Derby in dominant fashion and was considered a threat to win the Triple Crown. However, in the opening strides of the next race, the Preakness, Barbaro broke down, shattering a foreleg. He underwent multiple surgeries but was eventually put down in early 2007."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "Horse"] [:th {} "NOC"] [:th {} "Faults"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "Germany"] [:td {}] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "1.75"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "345"] [:td {} [:a {:href "/athletes/11606"} "Ludger Beerbaum"] " "] [:td {} [:i {} [:a