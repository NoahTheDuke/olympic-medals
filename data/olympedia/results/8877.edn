ref "/athletes/93814"} "George Bovell"] " taking a historic first ever swimming medal for Trinidad (or indeed the entire English-speaking Caribbean) when he edged out " [:a {:href "/athletes/103162"} "László Cseh, Jr."] " for third place."] "\n\n" [:p {} "This began a run of record four straight Olympic victories for Phelps in an event in which he also won five world titles."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/93860"} "Michael Phelps"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "2:00.01 (1 h7)"] [:td {} "1:58.52 (1 h1)"] [:td {} "1:57.14 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/103585"} "Ryan Lochte"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "2:01.41 (5 h6)"] [:td {} "1:59.58 (2 h1)"] [:td {} "1:58.78 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/93814"} "George Bovell"]] [:td {} [:a {:href "/countries/TTO"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/TTO.png"}] "TTO"]] [:td {} "2:00.65 (1 h5)"] [:td {} "2:00.31 (3 h2)"] [:td {} "1:58.80 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/103162"} "László Cseh, Jr."]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: m