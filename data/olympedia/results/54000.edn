lass "glyphicon glyphicon-info-sign"}] "\nDid you know?\n"] "\n"] "\n" [:div {:class "panel-body"} "\n" [:p {} "The Tikal brothers " [:a {:href "/athletes/118268"} "Steve Tikal"] " (for Australia) and " [:a {:href "/athletes/98274"} "František Tikal"] " (for Czechoslovakia) faced each other in an ice hockey match at the 1960 Winter Olympics to become the first brothers competing head-to-head for different nations."] "\n\n\n"] "\n"] "\n" [:div {:class "container"} "\n" [:p {} "\n" [:a {:href "/users/sign_in"} "Login"] "\n|\n" [:a {:href "/statistics/site"} "Statistics"] "\n|\n" [:a {:href "/static/about"} "About"] "\n|\n" [:a {:href "/static/faq"} "FAQ"] "\n|\n" [:a {:href "/feedbacks/new"} "Feedback"] "\n"] "\n" [:p {} "\n© " [:a {:href "/static/about"} "OlyMADMen"] " 2006 — 2026\n"] "\n"] "\n"] "\n\n" [:script {:src "/assets/lightbox.min-a06f7b5a37bdc88a78a48f95b9149ca917761a07bffb855a6d73c1a435e16552.js"}] #object[org.jsoup.nodes.TextNode 0x11d6ff2a ""] [:script {} "\n  $('.footnote').tooltip();\n"] "\n"] "\n"] "\n")