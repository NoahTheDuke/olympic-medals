13"} "1908"] "\n" [:option {:value "54024"} "1912"] "\n" [:option {:value "54059"} "1920"] "\n" [:option {:value "54076"} "1924"] "\n" [:option {:value "54098"} "1928"] "\n" [:option {:value "54117"} "1932"] "\n" [:option {:value "54121"} "1936"] "\n" [:option {:value "54125"} "1948"] "\n" [:option {:value "54129"} "1952"] "\n" [:option {:value "54141"} "1956"] "\n" [:option {:value "54153"} "1960"] "\n" [:option {:value "54168"} "1964"] "\n" [:option {:value "54180"} "1968"] "\n" [:option {:value "54192"} "1972"] "\n" [:option {:value "54204"} "1976"] "\n" [:option {:value "54216"} "1980"] "\n" [:option {:value "54228"} "1984"] "\n" [:option {:value "54240"} "1988"] "\n" [:option {:value "54252"} "1992"] "\n" [:option {:value "54264"} "1996"] "\n" [:option {:value "54280"} "2000"] "\n" [:option {:value "54300"} "2004"] "\n" [:option {:value "259046"} "2008"] "\n" [:option {:value "309068"} "2012"] "\n" [:option {:value "353750"} "2016"] "\n" [:option {:value "19002200"} "2020"] "\n" [:option {:value "2010600"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/250"} "Event type"]] [:h1 {:class "event_title"} "Springboard, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 7 September 1904"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/212"} "Life Saving Exhibition Lake, Forest Park, St. Louis"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/54000"} "5 from 2 countries"]]]]] [:div {:class "description"} [:p {} "A diving competition was held at the " [:a {:href "/venues/212"} "Life Saving Exhibition Lake"] ", in the middle of the World’s Fairgrounds, on 7 September 1904, concurrent with the " [:a {:href "/editions/3/sports/SWM"} "swimming events"] ".  Only one event was held, a fancy diving competition on springboard.  A St. Louis doctor, Dr. " [:a {:href "/athletes/51563"} "George Sheldon"] ", won the competition, defeating Germany’s " [:a {:href "/athletes/47835"} "Georg Hoffmann"] " fairly easily.  The controversy in this event occurred in the battle for the bronze medal.  The American " [:a {:href "/athletes/51440"} "Frank Kehoe"] " and a German, " [:a {:href "/athletes/47791"} "Alfred Braunschweiger"] ", tied for third with 11.33 points.  The Germans protested this result, thinking that Braunschweiger had easily outperformed Kehoe.  A “dive-off” for third place was scheduled but Braunschweiger refused to compete, and Kehoe was awarded the bronze medal."] "\n\n" [:p {} "The German commissioner to the World’s Fair, Dr. " [:a {:href "/athletes/899227"} "Theodor Lewald"] ", had donated a trophy for the winning diver, but he was so incensed at the outcome that he refused to award it to Sheldon.  The controversy occurred because the Germans thought that they did fancier dives than the Americans, although the Americans protested that the Germans had poorer entries into the water.  The Germans, noting that the event was called a fancy diving contest, thought that was immaterial.  On 29 September, " [:a {:href "/athletes/1202507"} "James E. Sullivan"] " announced the ruling that the protest had not been allowed, although the decision had been made two weeks earlier. The Germans protested again, and this was, at first, overruled.  But two years later, the official result was announced as a tie for third place, although this was never accepted by the Americans, and the final result is disputed."] "\n\n" [:p {} "In many older sources, this event is often described as a platform diving event, but that is incorrect. Photos show that it was held off a springboard, and diving historian " [:a {:href "/athletes/51296"} "Bob Clotworthy"] " (" [:a {:href "/results/54141"} "1956 springboard"] " gold medalist) has also maintained for several years that this was a springboard event."] "\n"] [:table {:class "table table-striped"