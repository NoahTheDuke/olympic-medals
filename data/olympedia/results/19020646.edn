ags.s3.eu-central-1.amazonaws.com/CZE.png"}] "CZE"]]] [:tr {:class "referees", :style ""} [:th {} "Judge D"] [:td {:style "width: 400px"} [:a {:href "/athletes/1500048"} "Jørn Larsen"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]]] [:tr {:class "referees", :style ""} [:th {} "Judge E"] [:td {:style "width: 400px"} [:a {:href "/athletes/1500049"} "Vadim Lisovsky"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]]] [:tr {:class "referees", :style ""} [:th {} "Judge SC"] [:td {:style "width: 400px"} [:a {:href "/athletes/1500045"} "Jürgen Winkler"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Hill Size : 106 m" [:br {}] "Inrun Angle : 35°" [:br {}] "Inrun Length : 100.0 m" [:br {}] "K-Point : 95 m" [:br {}] "Landing Angle: 34.1°" [:br {}] "Take-Off Angle : 11°" [:br {}] "Take-Off Height : 2.37 m" [:br {}] "Total Height : 114.7 m"]]]] [:div {:class "description"} [:p {} "The mixed team normal hill event was a new addition to the Olympic program in Beijing, having been contested at the World Cup since 2012 and the World Championships since 2013. The most recent World Champions were Germany, led by " [:a {:href "/athletes/127860"} "Katharina Althaus"] " and " [:a {:href "/athletes/137327"} "Karl Geiger"] " and supported by " [:a {:href "/athletes/137326"} "Markus Eisenbichler"] " and the non-Olympian Anna Rupprecht. In Beijing, Eisenbichler and Rupprecht were replaced by " [:a {:href "/athletes/148446"} "Constantin Schmid"] " and " [:a {:href "/athletes/148443"} "Selina Freitag"] ". Norway, led by " [:a {:href "/athletes/137753"} "Robert Johansson"] ", was the most recent World runner-up, while bronze had gone to Austria, headed by veteran " [:a {:href "/athletes/127376"} "Daniela Iraschko-Stolz"] ". The event had been held only once in the latest season of the World Cup, with the positions the same aside from Slovenia replacing Germany at the top."] "\n\n" [:p {} "The event attracted significant controversy in the first round when Althaus, Iraschko-Stolz, and " [:a {:href "/athletes/128017"} "Sara Takanashi"] ", one of the stars of the Japanese team, were disqualified for suit violations, despite having worn the same suits in earlier events. As disqualified athletes are unable to contribute to the overall score, this left Slovenia, Norway and Russia as the top three placers in the first round, while Germany was eliminated entirely."] "\n\n" [:p {} "In the final round, however, two of the Norwegian skiers, " [:a {:href "/athletes/2301717"} "Anna Odine Strøm"] " and " [:a {:href "/athletes/137751"} "Silje Opseth"] ", were also disqualified, leaving Norway unable to reach the podium. This left Slovenia in prime position to capture gold, which they did, while Russia was able to move up and claim the runner-up spot. Canada, who had never before won an Olympic ski jumping medal, performed well enough to advance from fourth into the bronze medal position, although it seemed clear that had fourth and fifth-placed Japan and Austria had all of their competitors, they would have taken silver and bronze respectively. The Russian team, meanwhile, won only its second Olympic medal in ski jumping, the first having come from " [:a {:href "/athletes/83981"} "Vladimir Belousov"] "’s victory for the Soviet Union in the large hill in 1968."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Jump #1"] [:th {} "Jump #2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Slovenia"] [:td {} [