 kilometres Pursuit, Men"] "\n" [:option {:value "19019632"} "15 kilometres Mass Start, Men"] "\n" [:option {:value "19019633"} "20 kilometres, Men"] "\n" [:option {:value "19019634"} "4 × 7.5 kilometres Relay, Men"] "\n" [:option {:value "19019635"} "7.5 kilometres Sprint, Women"] "\n" [:option {:value "19019636"} "10 kilometres Pursuit, Women"] "\n" [:option {:value "19019637"} "12.5 kilometres Mass Start, Women"] "\n" [:option {:value "19019639"} "4 × 6 kilometres Relay, Women"] "\n" [:option {:value "19019640"} "4 × 6 kilometres Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1557"} "1992"] "\n" [:option {:value "1568"} "1994"] "\n" [:option {:value "1580"} "1998"] "\n" [:option {:value "1593"} "2002"] "\n" [:option {:value "1608"} "2006"] "\n" [:option {:value "923491"} "2010"] "\n" [:option {:value "350030"} "2014"] "\n" [:option {:value "9000228"} "2018"] "\n" [:option {:value "15000038"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/136"} "Event type"]] [:h1 {:class "event_title"} "15 kilometres, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 7 February 2022 — 17:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2138"} "Zhangjiakou Nordic Centre and Biathlon Centre, Chongli District, Zhangjiakou City, Hebei Province"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19019638"} "87 from 29 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "One-minute penalty for each missed target."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 15,220 m" [:br {}] "Height Differential: 52 m" [:br {}] "Maximum Climb: 21 m" [:br {}] "Shooting 1: Prone at 2.824 km, 50 m range" [:br {}] "Shooting 2: Standing at 5.913 km, 50 m range" [:br {}] "Shooting 3: Prone at 9.002 km, 50 m range" [:br {}] "Shooting 4: Standing at 12.091 km, 50 m range" [:br {}] "Total Climbing: 560 m"]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/127819"} "Denise Herrmann"] " delivered an almost perfect race over 15 kilometres and was rewarded with gold, despite being without a victory in the season’s World Cup. Silver went to " [:a {:href "/athletes/127715"} "Anaïs Chevalier-Bouchet"] " from France (+9.4 seconds), and bronze was won by Norway’s " [:a {:href "/athletes/137711"} "Marte Olsbu Røiseland"] " (+15.3)."] "\n\n" [:p {} "With good wind conditions, the victory was decided by the performance on the shooting range and a perfect pacing on the difficult course. Herrmann, who had won a cross-country skiing medal at the 2014 Winter Games, had a reputation as a fast skier who was less stable on the shooting range. This event is frequently decided by the shooting, as one minute is added to the running time for every miss at the range. In the third round of shooting she missed the first target, but she was not discouraged and had a clean last shooting round, and a strong final round earned her the gold. It was Herrmann’s first Olympic medal in biathlon after one gold, three silver and one bronze at World Championships."] "\n\n" [:p {} "Chevalier-Bouchet also conceded just one penalty minute, but was about 10 seconds slower on the course. Top favourite Marte Olsbu Røiseland missed two targets and was not able to make up for the additional minute, although she was clearly the fastest skier. The best running time was achieved by 2021 World Cup winner " [:a {:href "/athletes/128184"} "Tiril Eckhoff"] ". Five penalty minutes, however, brought her down to 22nd place. Ukraine’s " [:a {:href "/athletes/138235"} "Iryna Petrenko"] " hit all 20 targets, but her skiing time was only good enough for an 11th place finish. A major surprise was Germany’s " [:a {:href "/athletes/148390"} "Vanessa Voigt"] " in her first World Cup season. Her fourth place was a career-high in an individual event."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Adjusted Time"] [:th {} "Misses"] [:th {} "Skiing"] [:th {} "Shooting 1 Misses"] [:th {} "Shooting 1"] [:th {} "Shooting 2 Misses"] [:th {} "Shooting 2"] [:th {} "Shooting 3 Misses"] [:th {} "Shooting 3"] [:th {} "Shooting 4 Misses"] [:th {} "Shooting 4"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/127819"} "Denise Herrmann"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "44:12.7"] [:td {} "1"] [:td {} "43:12.7 (5)"] [:td {} "0"] [:td {} "8:40.8 (3)"] [:td {} "0"] [:td {} "17:28.3 (2)"] [:td {} "1"] [:td {} "27:32.0 (9)"] [:td {} "0"] [:td {} "36:18.9 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/127715"} "Anaïs Chevalier-Bouchet"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "44:22.1"] [:td {} "1"] [:td {} "43:22.1 (6)"] [:td {} "0"] [:td {} "8:43.0 (6)"] [:td {} "0"] [:td {} "17:34.9 (4)"] [:td {} "0"] [:td {} "26:32.6 (2)"] [:td {} "1"] [:td {} "36:23.5 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/137711"} "Marte Olsbu Røiseland"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-centra