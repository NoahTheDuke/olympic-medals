"125234"} "1964"] "\n" [:option {:value "125943"} "1968"] "\n" [:option {:value "126759"} "1972"] "\n" [:option {:value "127614"} "1976"] "\n" [:option {:value "128376"} "1980"] "\n" [:option {:value "129134"} "1984"] "\n" [:option {:value "130167"} "1988"] "\n" [:option {:value "131271"} "1992"] "\n" [:option {:value "132349"} "1996"] "\n" [:option {:value "133253"} "2000"] "\n" [:option {:value "133885"} "2004"] "\n" [:option {:value "263362"} "2008"] "\n" [:option {:value "332552"} "2012"] "\n" [:option {:value "355404"} "2016"] "\n" [:option {:value "2008067"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/676"} "Event type"]] [:h1 {:class "event_title"} "Heavyweight, Freestyle (≤97 kg), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "6 –  7 August 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2125"} "Makuhari Messe, 2-1, Nakase, Mihama-ku, Chiba, Chiba Prefecture, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19009590"} "15 from 15 countries"]]]]] [:div {:class "description"} [:p {} "This was probably the most anticipated wrestling class at the Tokyo Olympics, as the two top seeds were considered by many as the best freestyle wrestlers in the world. The #1 seed was ROC team member " [:a {:href "/athletes/135824"} "Abdulrashid Sadulayev"] ", who had won the gold medal at the Rio Olympics as a light-heavyweight and was twice a World Champion at that weight."] "\n\n" [:p {} "After Rio he moved up to the heavyweight class to face " [:a {:href "/athletes/136404"} "Kyle Snyder"] ", the #2 seed in Tokyo, who was the defending gold medallist in this class. Snyder had faced Sadulayev at the World Championships in 2017-19, winning in 2017, but the Russian came out on top in 2018-19. Nobody else was given much chance for the gold medal."] "\n\n" [:p {} "Sadulayev and Snyder both made it to the semi-finals, seemingly wrestling carefully, just to be certain there were no mistakes on the way to the expected final. In the semis, Sadulayev defeated Cuban " [:a {:href "/athletes/117097"} "Reineris Salas"] " by a safe margin on points, 4-0. Likewise, Snyder took out Turkey’s " [:a {:href "/athletes/146982"} "Süleyman Karadeniz"] " on points, 5-0."] "\n\n" [:p {} "The final was relatively close, but in the second period, Sadulayev started to establish control and moved ahead, eventually winning on points, 6-3, to earn his second gold medal as Snyder had to settle for silver."] "\n\n" [:p {} "Salas won a bronze medal in the repêchage final over Azerbaijani " [:a {:href "/athletes/121432"} "Şərif Şərifov"] ", but only by judges’ decision after they tied in points, 3-3, in regulation time. Karadeniz did not fare as well, losing the bronze medal to Italian " [:a {:href "/athletes/1303101"} "Abraham Conyedo"] ", 6-2."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Classification Points", :class "footnote"} "CP"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Victories by Fall", :class "footnote"} "VF"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Victories by Technical Superiority", :class "footnote"} "ST"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Technical Points", :class "footnote"} "TP"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Technical Points Received", :class "footnote"} "TPR"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/135824"} "Abdulrashid Sadulayev"]] [:td {} [:a {:href "/countries/ROC"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "htt