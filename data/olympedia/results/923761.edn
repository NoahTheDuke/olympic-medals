naws.com/KOR.png"}] "KOR"] " / 13 February 2002 / " [:a {:href "/records/event_name/549"} "Details"]]]]] [:div {:class "description"} [:p {} "China had the strongest team going into this event. Apart from 500 m champion " [:a {:href "/athletes/109921"} "Wang Meng"] ", it featured " [:a {:href ""} "Zhou Yang"] ", who held the 1,500 m world record and had won the season’s World Cup for the distance. The defending World Champion, " [:a {:href ""} "Kim Min-Jeong"] " of South Korea, was not selected for this event, but with " [:a {:href "/athletes/119778"} "Lee Eun-Byeol"] ", " [:a {:href "/athletes/119791"} "Park Seung-Hui"] " and " [:a {:href "/athletes/119757"} "Jo Hae-Ri"] " they fielded a strong team."] "\n\n" [:p {} "All favorites went through to the semi-finals, but the second semi-final heat saw the exit of Wang. Attempting to pass two skaters, Wang caused a pile-up with Jo and " [:a {:href "/athletes/119773"} "Katherine Reutter"] " (United States). She was disqualified for this, while Jo and Reutter were advanced to the final. Also qualified were Lee, " [:a {:href "/athletes/100227"} "Tania Vicent"] ", " [:a {:href "/athletes/109927"} "Erika Huszár"] ", " [:a {:href "/athletes/82151"} "Evgeniya Radanova"] ", Park and Zhou. Three laps from the bell in the crowded final, Zhou opened up a lead on the pack, with only Lee and Park able to follow. Zhou held on until the finish line, while the two Koreans were far enough in front to fight it out for silver (Lee) and bronze (Park)."] "\n\n" [:p {} "After her title, Zhou was naturally ecstatic, and in an interview with Chinese television, she thanked her parents, who had supported her sports dreams, despite their poverty. While this would not have caused raised eyebrows in most of the world, it caused a stir in China, where athletes generally thank their country. IOC member " [:a {:href "/athletes/899411"} "Yu Zaiqing"] " was quoted as saying: )It’s fine to thank your mom and dad [for the gold medal] but one needs to thank the country first and foremost), referring to the country’s government funded sports system. But Yu’s comment received a lot of criticism in China, notably from the younger internet generation, who preferred Zhou’s more natural and enthusiastic response."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Helmet Nr"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Position Last Race"] [:th {} "Positions"] [:th {} "Best Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "114"] [:td {} [:a {:href "/athletes/119816"} "Zhou Yang"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} "AF-1"] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "140"] [:td {} [:a {:href "/athletes/119778"} "Lee Eun-Byeol"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} "AF-2"] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "141"] [:td {} [:a {:href "/athletes/119791"} "Park Seung-Hui"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} "AF-3"] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "157"] [:td {} [:a {:href "/athletes/119773"} "Katherine Reutter"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaw