82"} "12.5 kilometres Pursuit, Men"] "\n" [:option {:value "923485"} "15 kilometres Mass Start, Men"] "\n" [:option {:value "923481"} "20 kilometres, Men"] "\n" [:option {:value "923486"} "4 × 7.5 kilometres Relay, Men"] "\n" [:option {:value "923492"} "10 kilometres Pursuit, Women"] "\n" [:option {:value "923495"} "12.5 kilometres Mass Start, Women"] "\n" [:option {:value "923491"} "15 kilometres, Women"] "\n" [:option {:value "923496"} "4 × 6 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1556"} "1992"] "\n" [:option {:value "1567"} "1994"] "\n" [:option {:value "1579"} "1998"] "\n" [:option {:value "1592"} "2002"] "\n" [:option {:value "1607"} "2006"] "\n" [:option {:value "350027"} "2014"] "\n" [:option {:value "9000225"} "2018"] "\n" [:option {:value "19019635"} "2022"] "\n" [:option {:value "15000035"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/133"} "Event type"]] [:h1 {:class "event_title"} "7.5 kilometres Sprint, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "13 February 2010 — 13:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/181"} "Whistler Olympic Park, Whistler"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/923490"} "88 from 30 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Penalty loop (150 metres) skied for each missed target."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 7,813 m" [:br {}] "Height Differential: 27 m" [:br {}] "Maximum Climb: 25 m" [:br {}] "Shooting 1: Prone at 2.6 km, 50 m range" [:br {}] "Shooting 2: Standing at 5.3 km, 50 m range" [:br {}] "Total Climbing: 84 m"]]]] [:div {:class "description"} [:p {} "This event, held on the first morning of competition, produced the first surprise of the 2010 Games when the Slovakian biathlete " [:a {:href "/athletes/118501"} "Anastasia Kuzmina"] ", having started slowly, won the gold medal in a time of 19:55.6. \nWith many of the favourites missing targets, Kuzmina missed only one and won ahead of Germany’s " [:a {:href "/athletes/118546"} "Magdalena Neuner"] ", a biathlete who came in to the Games with a rich vein of form, and early leader " [:a {:href "/athletes/118550"} "Marie Dorin"] " of France who took silver and bronze some 1.5 seconds and 10.9 seconds respectively behind Kuzmina. \nAlthough the Russian born Kuzmina had won a medal at the 2009 World Championship she had never won a race on the World Cup circuit and her preparation had been hampered by an accident in which she broke two bones in her hand a month before the Games began.\nThis was only her second year competing in Slovakian colours after she had moved to the country to train with her husband, the Israeli cross-country skier Daniel Kuzmin. Her brother, " [:a {:href "/athletes/118508"} "Anton Shipulin"] ", would later add to the family medal haul by winning a bronze medal in the men’s relay. This was Slovakia’s first gold medal at a Winter Olympics although Slovak " [:a {:href "/athletes/95793"} "Ondrej Nepela"] " was an Olympic champion in 1972 representing Czechoslovakia."] "\n\n" [:p {} "World champion " [:a {:href "/athletes/100035"} "Kati Wilhelm"] " of Germany had a poor day at the rifle range and could only finish 30th whilst World Cup leader " [:a {:href "/athletes/118524"} "Helena Jonsson"] " prefaced a disappointing Olympic by placing 12th."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Misses"] [:th {} "Shooting 1 Misses"] [:th {} 