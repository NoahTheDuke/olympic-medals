dividual, Men"] "\n" [:option {:value "19020356"} "Team, Men"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "923615"} "2010"] "\n" [:option {:value "350424"} "2014"] "\n" [:option {:value "9000760"} "2018"] "\n" [:option {:value "15000830"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/741"} "Event type"]] [:h1 {:class "event_title"} "Normal Hill / 10 km, Individual, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 9 February 2022"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2138"} "Zhangjiakou Nordic Centre and Biathlon Centre, Chongli District, Zhangjiakou City, Hebei Province"] " / " [:a {:href "/venues/2139"} "Zhangjiakou National Ski Jumping Centre, Zhangjiakou City, Hebei Province"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19020350"} "45 from 17 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Normal hill ski jumping and 10 kilometres skiing. Pursuit-style cross-country race, with skiers leaving in order of their finish in the ski jumping, so that final placement determined by final placement in cross-country ski race."]] [:tr {:class "referees", :style ""} [:th {} "Judge A"] [:td {:style "width: 400px"} [:a {:href "/athletes/1500045"} "Jürgen Winkler"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]]] [:tr {:class "referees", :style ""} [:th {} "Judge B"] [:td {:style "width: 400px"} [:a {:href "/athletes/1500050"} "Dan Mattoon"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge C"] [:td {:style "width: 400px"} [:a {:href "/athletes/1500047"} "Stanislav Slavík"]] [:td {} [:a {:href "/countries/CZE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CZE.png"}] "CZE"]]] [:tr {:class "referees", :style ""} [:th {} "Judge D"] [:td {:style "width: 400px"} [:a {:href "/athletes/1500046"} "Liang Bing"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]]] [:tr {:class "referees", :style ""} [:th {} "Judge E"] [:td {:style "width: 400px"} [:a {:href "/athletes/1500049"} "Vadim Lisovsky"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]]] [:tr {:class "referees", :style ""} [:th {} "Judge SC"] [:td {:style "width: 400px"} [:a {:href "/athletes/1500048"} "Jørn Larsen"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]]]]] [:div {:class "description"} [:p {} "Four of the top eight athletes from the Nordic Combined World Cup tested positive for Covid-19 upon arrival at Beijing, and it meant that the Germans " [:a {:href "/athletes/119468"} "Eric Frenzel"] " and Terence Weber, " [:a {:href "/athletes/127651"} "Kristjan Ilves"] " from Estonia, and " [:a {:href "/athletes/137749"} "Jarl Magnus Riiber"] " from Norway were unable to compete. Riiber and Frenzel were the respective reigning world and Olympic champions, and their withdrawal meant " [:a {:href "/athletes/147869"} "Johannes Lamparter"] ", the current World Cup leader, was the favourite."] "\n\n" [:p {} [:a {:href "/athletes/148549"} "Ryota Yamamoto"] " made a giant 108-metre jump in the ski jumping competition and was four metres longer than the next best jump. He started the cross country 38 seconds ahead of Austrian " [:a {:href "/athletes/147868"} "Lukas Greiderer"] ", with the Germans " [:a {:href "/athletes/148432"} "Julian Schmid"] " and " [:a {:href "/athletes/119470"} "Johannes Rydzek"] " a few seconds behind. The question was, would the good skiers like " [:a {:href "/athletes/127694"} "Ilkka Herola"] " (Finland), " [:a {:href "/athletes/128220"} "Jørgen Graabak"] " (Norway) and " [:a {:href "/athletes/137317"} "Vinzenz Geiger"] " (Germany) be able to catch the group ahead."] "\n\n" [:p {} "The competition consisted of four laps of 2,5km, and after 1km Yamamoto had lost 20 seconds to the chasing group, and at the end of the first lap, the group had caught him. A large group of seven skiers headed by Herola were in pursuit 30 seconds behind. Rydzek increased the tempo on the second lap with Yamamoto falling behind after 5km. Schmid took the lead in the third lap, and at that point it looked like it would be a German triumph. Geiger passed Herola on the third lap and led a second group going into the last lap. At that point, Geiger was pushing hard, and the group were 18 seconds behind the three men in front of them."] "\n\n" [:p {} "Schmid had apparently pushed too hard on the third lap and fell back when Rydzek increased the speed on the fourth lap. Greiderer who was also struggling, held on to Rydzek until 8,5km. At that point, Geiger was improving and passed Schmid into third place, with Graabak a few metres behind.  Geiger and Graabak sprinted past Rydzek 500m from the finish line, with Geiger taking gold. The Austrians Griederer and Lamparter also overtook the struggling Rydzek, who could only finish in fifth place. Not only were Geiger and Graabak first and second, but they also had the two fastest skiing times in the competition."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time Margin"] [:th {} "Ski Jumping, Normal Hill"] [:th {} "Cross Country Skiing, 10 km"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/137317"} "Vinzenz Geiger"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "25:07.7"] [:td {} "111.4 (11)"] [:td {} "25:07.7 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/128220"} "Jørgen Graabak"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "+0.8"] [:td {} "114.1 (9)"] [:td {} "25:08.5 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/147868"} "Lukas Greiderer"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]] [:td {} "+6.6"] [:td {} "123.4 (2)"] [:td {} "25:14.3 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/147869"} "Johannes Lamparter"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]] [:td {} "+9.0"] [:td {} "116.9 (5)"] [:td {} "25:16.7 (4)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {} [:a {:href "/athletes/119470"} "Johannes Rydzek"]] [:td {} [:a {:href "/countries/