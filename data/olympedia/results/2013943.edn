ption {:value "2013959"} "Pole Vault, Women"] "\n" [:option {:value "9031176"} "Long Jump, Women"] "\n" [:option {:value "9031190"} "Triple Jump, Women"] "\n" [:option {:value "2013998"} "Shot Put, Women"] "\n" [:option {:value "2014015"} "Discus Throw, Women"] "\n" [:option {:value "2014032"} "Hammer Throw, Women"] "\n" [:option {:value "2014049"} "Javelin Throw, Women"] "\n" [:option {:value "2014066"} "Heptathlon, Women"] "\n" [:option {:value "2014114"} "4 × 400 metres Relay, Mixed"] "\n" [:option {:value "2014119"} "Marathon Race Walk Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "57897"} "1928"] "\n" [:option {:value "58127"} "1932"] "\n" [:option {:value "58452"} "1936"] "\n" [:option {:value "58806"} "1948"] "\n" [:option {:value "59185"} "1952"] "\n" [:option {:value "59546"} "1956"] "\n" [:option {:value "60001"} "1960"] "\n" [:option {:value "60417"} "1964"] "\n" [:option {:value "60914"} "1968"] "\n" [:option {:value "61479"} "1972"] "\n" [:option {:value "62046"} "1976"] "\n" [:option {:value "62529"} "1980"] "\n" [:option {:value "63118"} "1984"] "\n" [:option {:value "63790"} "1988"] "\n" [:option {:value "64466"} "1992"] "\n" [:option {:value "65143"} "1996"] "\n" [:option {:value "65800"} "2000"] "\n" [:option {:value "66513"} "2004"] "\n" [:option {:value "257660"} "2008"] "\n" [:option {:value "302547"} "2012"] "\n" [:option {:value "359099"} "2016"] "\n" [:option {:value "19000773"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/107"} "Event type"]] [:h1 {:class "event_title"} "4 × 100 metres Relay, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "8 –  9 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2157"} "Stade de France, Saint-Denis, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2013943"} "67 from 16 countries"]]]]] [:div {:class "description"} [:p {} "Jamaica was the defending gold medalist, but their top sprinters of the last decade, " [:a {:href "/athletes/130722"} "Elaine Thompson-Herah"] " and " [:a {:href "/athletes/114740"} "Shelly-Ann Fraser-Pryce"] ", were now older and injuries would keep them from running the relay, as for their teammate " [:a {:href "/athletes/130733"} "Shericka Jackson"] ". The favorite’s role fell to the United States, who had won gold in 2012 and 2016, and 11 of the 16 times the event had been contested at the Olympic Games."] "\n\n" [:p {} "In an unusual move, the United States ran their A team in the heats, and did not replace any runners for the final. The final was run in a steady rain. " [:a {:href "/athletes/130204"} "Dina Asher-Smith"] " gave Great Britain the lead in the opening leg, and " [:a {:href "/athletes/142959"} "Imani Lansiquot"] " would maintain that position on the backstretch."] "\n\n" [:p {} [:a {:href "/athletes/130312"} "Gina Lückenkemper"] " ran 9.89 for her third leg, the fastest of the final, bringing Germany to the lead, with Great Britain second and France third at the final exchange. The United States was fourth at that point, as 200 metre gold medalist " [:a {:href "/athletes/147109"} "Gabby Thomas"] " ran 10.25 around the far turn."] "\n\n" [:p {} "But the United States had " [:a {:href "/athletes/150638"} "Sha’Carri Richardson"] " on the anchor, and the 100 metre silver medalist closed in 10.09, far faster than the other anchors, to give the USA their 12th gold medal in the event. Behind them, Great Britain held on her silver and Germany took bronze, as " [:a {:href "/athletes/130202"} "Daryll Neita"] " also passed " [:a {:href "/athletes/130328"} "Rebekka Haase"] " on the straight."] "\n\n" [:p {} "This was Thomas’s second gold medal of Paris 2024, and the next day she would win #3 in the 4x400 metre relay. She was the only athlete to win three gold medals in athletics at the 2024 Olympic Games."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "41.94 (1 h1)"] [:td {} "41.78 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "10"} [:a {:href "/athletes/150629"} "Melissa Jefferson"] " • " [:a {:href "/athletes/150643"} "Twanisha Terry"] " • " [:a {:href "/athletes/147109"} "Gabby Thomas"] " • " [:a {:href "/athletes/150638"} "Sha'Carri Richardson"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Great Britain"] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {} "42.03 (1 h2)"] [:td {} "41.85 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "10"} [:a {:href "/athletes/130204"} "Dina Asher-Smith"] " • " [:a {:href "/athletes/142959"} "Imani Lansiquot"] " • " [:a {:href "/athletes/149980"} "Amy Hunt"] " • " [:a {:href "/athletes/130202"} "Daryll Neita"] " • " [:a {:href "/athletes/149981"} "Bianca Williams"] " • " [:a {:href "/athletes/130203"} "Desirèe Henry"]]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} "Germany"] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olym