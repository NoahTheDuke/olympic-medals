etes/67615"} "Akilles Järvinen"] " finished second, while three Americans placed 3rd, 4th, and 5th, led by bronze medalist " [:a {:href "/athletes/78330"} "Ken Doherty"] ", the 1928-29 US champion."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Points (1934 Tables)"] [:th {} "Points (1952 Tables)"] [:th {} "Points (1962 Tables)"] [:th {} "Points (1985 Hand Tables)"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "813"] [:td {} [:a {:href "/athletes/67889"} "Paavo Yrjölä"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]] [:td {} "8053.290"] [:td {} "7071"] [:td {} "6252"] [:td {} "6774"] [:td {} "6587"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "775"] [:td {} [:a {:href "/athletes/67615"} "Akilles Järvinen"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]] [:td {} "7931.500"] [:td {} "7081"] [:td {} "6379"] [:td {} "6815"] [:td {} "6645"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "525"] [:td {} [:a {:href "/athletes/78330"} "Ken Doherty"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "7706.650"] [:td {} "6800"] [:td {} "6039"] [:td {} "6593"] [:td {} "6428"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib