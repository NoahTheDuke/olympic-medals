tes/102883"} "Park Gyeong-Mo"] " " [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"] " / 11 August 2008 / " [:a {:href "/records/event_name/2/Match,%2024%20arrows"} "Details"]]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record  (Ranking Round, 216 arrows)"] [:td {} [:a {:href "/results/40957"} "2,031"] " " [:span {:class "label label-primary"} "WR"] " / " [:a {:href "/athletes/1973"} "Jang Yong-Ho"] " • " [:a {:href "/athletes/1974"} "Kim Bo-Ram"] " • " [:a {:href "/athletes/1978"} "Oh Gyo-Mun"] " " [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"] " / 28 July 1996 / " [:a {:href "/records/event_name/2/Ranking%20Round,%20216%20arrows"} "Details"]]]]] [:div {:class "description"} [:p {} "As current World and Olympic champions South Korea were clear favourites to win a 4th successive Olympic title in London. Also in contention for the medals were the USA, with world number one " [:a {:href "/athletes/111530"} "Brady Ellison"] ", and Ukraine, whose team included two members of the world’s top ten, and the world silver medallists from France. South Korea emerged from the qualifying round in superb shape having destroyed the existing world best and looked in fine form as they dispatched Ukraine in the last eight."] "\n\n" [:p {} "Things changed drastically in the semi-finals and an unusually subdued performance saw Korea exit at the hands of the US team. The other semi-final was a close affair with Italy, who had trailed Mexico throughout, edging through on the last three arrows. The final followed a different pattern and it was the Italian team who held a four-point lead at the halfway mark. America then slowly ground down that lead and one arrow to go the gold medal was still in the balance. To win the title the tubby, bearded Italian anchor-man " [:a {:href "/athletes/1921"} "Michele Frangilli"] " had to finish with a perfect 10. The arrow curved into the air and landed a few millimetres on the correct side on the line and the Italians collapsed into a chaotic group hug in celebration. For Frangilli, a 16-year veteran of Olympic archery, this completed his Olympic medal collection after winning silver in 2000 and bronze in 1996. South Korea regrouped to defeat Mexico for bronze."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Italy"] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/1921"} "Michele Frangilli"] " • " [:a {:href "/athletes/102878"} "Marco Galiazzo"] " • " [:a {:href "/athletes/111536"} "Mauro Nespoli"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/126572"} "Jacob Wukie"] " • " [:a {:href "/athletes/111530"} "Brady Ellison"] " • " [:a {:href "/athletes/127083"} "Jake Kaminski"]]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} "Republic of Korea"] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "