vents/1024"} "28 from 13 countries"]]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/1008"} "15:46.6"] " " [:span {:class "label label-primary"} "WR"] " / " [:a {:href "/athletes/87553"} "Knut Johannesen"] " " [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"] " / 27 February 1960 / " [:a {:href "/records/event_name/534"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003217"} "Leif Hjallum"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/76243"} "Sven Låftman"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]]]]] [:div {:class "description"} [:p {} "Only a few weeks before Norway’s " [:a {:href "/athletes/92057"} "Fred Anton Maier"] " had won the European Championship, taking the 5,000 and 10,000 in the process. A distance specialist, Maier had set the last four world records in the 10K, including two in January 1968, and had already won the 5,000 in Grenoble. He seemed on form for a sure gold medal. He started in the first pair and his time of 15:23.9 was 26+ seconds under the Olympic record, only 3.6 seconds above his world record, and was the second fastest time ever. The gold seemed to be his. A challenger was thought to be " [:a {:href "/athletes/98618"} "Kees Verkerk"] " (NED), but when he finished in 15:33.9 in the third pair, Maier seemed home free. But then Sweden’s " [:a {:href "/athletes/87290"} "Johnny Höglin"] " started in the seventh pair. Though he had competed internationally since 1965, he had no significant reputation at any distance, and had never sniffed a podium before. But he hung on to Maier’s pace, almost equal to it through 8,400 metres. And he hung on, gradually pulling ahead in the next three laps, and finishing in 15:23.6 for one of the most improbable speed skating gold medals ever."] "\n\n" [:p {} "A few weeks later Maier would win the World Championships, and the 5 and 10K at that tournament. In 1968 he set seven world records, won both the European and World Championships and the 5 and 10K at both tournaments, won the 5,000 Olympic gold medal, but missed the one he wanted most. For Höglin, this was his career. He would mount the podium only one other time in a major international, at 1,500 metres at the 1974 European Championships. The bronze medalist, another Swede, was even more surprising. " [:a {:href "/athletes/97149"} "Örjan Sandler"] " had competed around the world since 1964. But until the 1968 Winter Olympics, he had never finished better than 10th at any distance in any major meet."] "\n"] [:button {:id "button619019", :class "btn btn-default"} "Details"] [:script {} "$('#button619019').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "400 m"] [:th {:style "display: none", :class "split"} "800 m"] [:th {:style "display: none", :class "split"} "1200 m"] [:th {:style "display: none", :class "split"} "1600 m"] [:th {:style "display: none", :class "split"} "2000 m"] [:th {:style "display: none", :class "split"} "2400 m"] [:th {:style "display: none", :class "split"} "2800 m"] [:th {:style "display: none", :class "split"} "3200 m"] [:th {:style "display: none", :class "split"} "3600 m"] [:th {:style "display: none", :class "split"} "4000 m"] [:th {:style "display: none", :class "split"} "4400 m"] [:th {:style "display: non