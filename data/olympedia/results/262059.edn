61988"} "Singles, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "44678"} "1920"] "\n" [:option {:value "44979"} "1924"] "\n" [:option {:value "900227"} "1968"] "\n" [:option {:value "900297"} "1968"] "\n" [:option {:value "45211"} "1988"] "\n" [:option {:value "45404"} "1992"] "\n" [:option {:value "45620"} "1996"] "\n" [:option {:value "45838"} "2000"] "\n" [:option {:value "46056"} "2004"] "\n" [:option {:value "324180"} "2012"] "\n" [:option {:value "353385"} "2016"] "\n" [:option {:value "19004780"} "2020"] "\n" [:option {:value "2006680"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/610"} "Event type"]] [:h1 {:class "event_title"} "Doubles, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "12 – 17 August 2008"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/841"} "Beijing Aolinpike Gongyuan Wangqiuchang, Beijing Aolinpike Gongyuan, Beijing"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/262059"} "62 from 21 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament."]]]] [:div {:class "description"} [:p {} "The best doubles team in the world was the Williams’ sisters – " [:a {:href "/athletes/94425"} "Venus"] " and " [:a {:href "/athletes/94424"} "Serena"] ". They had won this gold medal in 2000 but could not defend it in 2004 due to injuries sustained by Serena. In 2008 they had finished 1-2 at Wimbledon and were heavily favored to win this event. However, they did not play all that often so were only seeded #2, behind Russia’s " [:a {:href ""} "Svetlana Kuznetsova"] " and " [:a {:href "/athletes/117620"} "Dinara Safina"] ". The Russian duo went out somewhat early, however, in a long three-set match in the quarters, losing to China’s " [:a {:href "/athletes/107324"} "Yan Zi"] " / " [:a {:href "/athletes/107299"} "Zheng Jie"] ", 6-3, 5-7, 10-8."] "\n\n" [:p {} "The Williams survived a scare in the semi-finals when they were pushed to three sets by the Ukrainian sister team of " [:a {:href "/athletes/117629"} "Alona"] " and " [:a {:href "/athletes/117611"} "Kateryna Bondarenko"] ", but winning the third set easily, 4-6, 6-4, 6-1. This set up a final against Spain’s " [:a {:href "/athletes/107288"} "Anabel Medina"] " and " [:a {:href "/athletes/2414"} "Vivi Ruano"] ", which turned out to be close to a walkover, as the Williams won the gold medal, 6-2, 6-0. They would return in 2012 and win the doubles gold medal for a third time. Yan and Zheng won the bronze medal over the Bondarenko’s, 6-2, 6-2."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/94424"} "Serena Williams"] " / " [:a {:href "/athletes/94425"} "Venus Williams"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/107288"} "Anabel Medina"] " / " [:a {:href "/athletes/2414"} "Vivi Ruano"]] [:td {} [:a {:href "/countries/ESP"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ESP.png"}] "ESP"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/107324"} "Yan Zi"] " / " [:a {