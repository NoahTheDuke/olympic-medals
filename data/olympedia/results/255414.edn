alue "255417"} "Canadian Doubles, Slalom, Men"] "\n" [:option {:value "255438"} "Kayak Singles, Slalom, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "256033"} "1992"] "\n" [:option {:value "256163"} "1996"] "\n" [:option {:value "256278"} "2000"] "\n" [:option {:value "256395"} "2004"] "\n" [:option {:value "258824"} "2008"] "\n" [:option {:value "307000"} "2012"] "\n" [:option {:value "353542"} "2016"] "\n" [:option {:value "19006320"} "2020"] "\n" [:option {:value "2008406"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/174"} "Event type"]] [:h1 {:class "event_title"} "Canadian Singles, Slalom, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "28 August 1972 — 13:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/530"} "Kanuslalomanlage, Augsburg"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/255414"} "22 from 9 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Two runs, best score of two to count."]]]] [:div {:class "description"} [:p {} "Canoe slalom singles appeared at the Olympics for the first time in 1972 (and for the last time until 1992) and, unlike in the sprint events, up to three competitors from a single nation were allowed to compete. West Germany’s " [:a {:href "/athletes/9934"} "Reinhold Kauder"] " was the reigning World Champion and had come in second to his compatriot " [:a {:href "/athletes/9962"} "Wolfgang Peters"] " in 1969, although there were many canoeists in contention. It was an East German, " [:a {:href "/athletes/9817"} "Reinhard Eiben"] ", however, who was in first after run one, with Kauder in second and only 0.39 points behind, and another  East German, " [:a {:href "/athletes/9820"} "Jochen Förster"] " in third. Förster had a medal of each color from the C-1 team event at the World Championships: gold from 1971, silver from 1967, and bronze from 1965. Peters, meanwhile, failed to post a score. Eiben recorded an even better score in the second run to earn a well-deserved gold medal, while Kauder failed to improve upon his point total and was forced to settle for silver. American " [:a {:href "/athletes/11125"} "Jamie McEwan"] ", who had been eighth in the first round, pulled off an impressive run in the second stage to slip ahead of Förster for the bronze medal, while Peters came in fourth in the second portion and fifth overall."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Total Time"] [:th {} "Run #1"] [:th {} "Run #2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "130"] [:td {} [:a {:href "/athletes/9817"} "Reinhard Eiben"]] [:td {} [:a {:href "/countries/GDR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GDR.png"}] "GDR"]] [:td {} "315.84"] [:td {} "327.50 (1)"] [:td {} "315.84 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "178"] [:td {} [:a {:href "/athletes/9934"} "Reinhold Kauder"]] [:td {} [:a {:href "/countries/FRG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRG.png"}] "FRG"]] [:td {} "327.89"] [:td {} "327.89 (2)"] [:td {} "350.31 (3)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "373"] [:td {} [:a {:href "/athletes/11125"} "Jami