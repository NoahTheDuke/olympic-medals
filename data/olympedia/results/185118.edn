function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "185005"} "1912"] "\n" [:option {:value "185026"} "1920"] "\n" [:option {:value "185045"} "1924"] "\n" [:option {:value "185063"} "1928"] "\n" [:option {:value "185082"} "1932"] "\n" [:option {:value "185099"} "1936"] "\n" [:option {:value "185135"} "1952"] "\n" [:option {:value "185153"} "1956"] "\n" [:option {:value "185176"} "1960"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/264"} "Event type"]] [:h1 {:class "event_title"} "Individual, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "10 – 13 August 1948"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/345"} "Army's Command Central Stadium, Aldershot Military Town"] " / " [:a {:href "/venues/346"} "Tweseldown Racecourse, Fleet, Hampshire"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/185118"} "45 from 16 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Dressage, cross-country, and jumping."]]]] [:div {:class "description"} [:p {} "The three-day event began with dressage, which was led by France’s " [:a {:href "/athletes/12196"} "André Jousseaumé"] ", who had already won an " [:a {:href "/results/185128"} "individual dressage"] " silver in London. The following day was the endurance test, which took place near the " [:a {:href "/venues/345"} "Aldershot Military Complex"] ". The course consisted of 33.5 km, starting with 6 km on roads, followed by 3.5 km of steeplechase, another 15 km on the roads, then 8 km of cross-country, and finishing with 1 km on the flat. The steeplechase section was contested on the " [:a {:href "/venues/346"} "Tweseldown Racecourse"] ". The course was actually considered somewhat easy, but not for Jousseaumé, who fell twice and finished last in the phase, and then had to withdraw as his horse was lame. The endurance ride was won by France’s " [:a {:href "/athletes/11752"} "Bernard Chevallier"] " aboard " [:a {:href "/horses/45"} [:em {} "Aiglonne"]] ", who rode a clean course and moved into the lead, well ahead of Americans " [:a {:href "/athletes/11547"} "Charles Anderson"] " and " [:a {:href "/athletes/12110"} "Frank Henry"] "."] "\n\n" [:p {} "The final day was devoted to show jumping, with eight riders going cleanly over the 12 obstacle course. Among them was Chevallier, who thus won the three-day gold medal. Henry also rode cleanly to win the silver medal, but Anderson had 11.5 faults and dropped back to fourth overall, trailing Sweden’s " [:a {:href "/athletes/12728"} "Robert Selfelt"] "."] "\n\n" [:p {} "The 1948 Olympic three-day event was the inspiration for starting the Badminton Horse Trials, which were first held in 1949, and have since become one of the main eventing championships in equestrian sport."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "Horse"] [:th {} "NOC"] [:th {} "Points"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/11752"} "Bernard Chevallier"]] [:td {} [:i {} [:a {:href "/horses/45"} "Aiglonne"]]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "4.00"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/12110"} "Frank Henry"]] [:td {} [:i {} [:a {:href "/horses/2401"} "Swing Low"]]] [:td {} [:a {:href "/countries/USA"} [:img {:s