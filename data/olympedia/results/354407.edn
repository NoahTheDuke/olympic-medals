value "354299"} "Featherweight (≤62 kg), Men"] "\n" [:option {:value "354308"} "Lightweight (≤69 kg), Men"] "\n" [:option {:value "354317"} "Middleweight (≤77 kg), Men"] "\n" [:option {:value "354326"} "Light-Heavyweight (≤85 kg), Men"] "\n" [:option {:value "354335"} "Middle-Heavyweight (≤94 kg), Men"] "\n" [:option {:value "354344"} "Heavyweight (≤105 kg), Men"] "\n" [:option {:value "354353"} "Super-Heavyweight (&gt;105 kg), Men"] "\n" [:option {:value "354362"} "Flyweight (≤48 kg), Women"] "\n" [:option {:value "354371"} "Featherweight (≤53 kg), Women"] "\n" [:option {:value "354380"} "Lightweight (≤58 kg), Women"] "\n" [:option {:value "354389"} "Middleweight (≤63 kg), Women"] "\n" [:option {:value "354398"} "Light-Heavyweight (≤69 kg), Women"] "\n" [:option {:value "354416"} "Super-Heavyweight (&gt;75 kg), Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "30278"} "2000"] "\n" [:option {:value "30413"} "2004"] "\n" [:option {:value "263114"} "2008"] "\n" [:option {:value "331090"} "2012"] "\n" [:option {:value "19002128"} "2020"] "\n" [:option {:value "2013272"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/652"} "Event type"]] [:h1 {:class "event_title"} "Heavyweight (≤75 kg), Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "12 August 2016 — 12:30 (B) (A)"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/924"} "Riocentro Pavilhão 2, Parque Olímpico da Barra, Barra da Tijuca, Rio de Janeiro"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/354407"} "15 from 15 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Total of best lifts in snatch and clean &amp; jerk determined placement.  Ties broken by lightest bodyweight."]]]] [:div {:class "description"} [:p {} "Doping concerns reduced the field for women’s heavyweight wrestling at the 2016 Olympic Games in Rio. Russia’s " [:a {:href "/athletes/116288"} "Nadezhda Yevstyukhina"] ", the 2011, 2013, and 2014 World champion, and 2011 and 2013 European champion, was affected not only by the blanket ban on Russian weightlifters, but also lost her 2008 Olympic bronze medal after a retest. Defending Olympic champion " [:a {:href "/athletes/126840"} "Svetlana Podobedova"] " of Kazakhstan, the most recent World bronze medalist, had also tested positive for banned substances and would lose her gold medal a few months later. Meanwhile China’s " [:a {:href ""} "Kang Yue"] ", the reigning World champion and 2013 and 2014 runner-up, floundered at the National Championships and was not selected for Rio. This left " [:a {:href "/athletes/126913"} "Rim Jong-Sim"] " of North Korea as the favorite: she was the 2012 Olympic champion in the light-heavyweight division, but had taken bronze in 2014 and silver in 2015 at the Worlds in the heavyweight category. The only other recent World Championship medalist was Spain’s " [:a {:href "/athletes/116290"} "Lidia Valentín"] " (bronze in 2013), who was also the 2014 and 2015 European champion and the 2013 runner-up. Valentín was a two-time Olympic veteran who finished fifth in 2008 and fourth in 2012, but was bumped up to the silver and gold medal positions respectively following a series of doping-related disqualifications. The reigning European champion was " [:a {:href "/athletes/132001"} "Iryna Dekha"] " of Ukraine, while France’s " [:a {:href "/athletes/130191"} "Gaëlle Nayo-Ketchanke"] " was the 2015 and 2016 runner-up."] "\n\n" [:p {} "Rim took a significant lead in the snatch portion with a lift of 121 kg. Trailing behind were Valentín and Belarus’ " [:a {:href "/athletes/129202"} "Darya Naumava"] " at 116 kg and Dekha at 114 kg. In her first attempt at the clean and jerk, Rim lifted 145 kg, which was not only 9 more than anyone else in the opening round, but 3 more than any other competitor would lift in the entire competition. She secured her gold medal by lifting 153 kg in her next attempt and used her final lift to try and improve on the Olympic record, but failed. Valentín and Naumava, meanwhile, battled for silver, with the Belarusian coming out on top by 1 kg each round. Dekha, the only other competitor reasonably in contention for a podium spot, struggled in the clean and jerk and placed fifth overall, giving Valentín the bronze."] "\n\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Kilograms"] [:th {} "Bodyweight"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/126913"} "Rim Jong-Sim"]] [:td {} [:a {:href "/countries/PRK"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/PRK.png"}] "PRK"]] [:td {} "274"] [:td {} "74.47"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/129202"} "Daria Navumava"]] [:td {} [:a {:href "/countries/BLR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BLR.png"}] "BLR"]] [:td {} "258"] [:td {} "74.63"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/116290"} "Lydia Valentín"]] [:td {} [:a {:href "/countries/ESP"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ESP.png"}] "ESP"]] [:td {} "257"] [:td {} "74.00"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td