s/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"] " / 23 February 1960 / " [:a {:href "/records/event_name/540"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003217"} "Leif Hjallum"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002468"} "Henny Roos"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]]]]] [:div {:class "description"} [:p {} "At the recent 1968 World Championship, Dutchwoman " [:a {:href "/athletes/82315"} "Ans Schut"] " had won the distance and finished second all-around to her teammate, " [:a {:href "/athletes/80777"} "Stien Kaiser"] ", who won the all-around. This event was expected to be contested between these two. But despite her recent loss, Kaiser had to be favored. She had also won the 1967 World Championship, winning the 3K en route, and had set the last three world records. The most recent had been set nine days before this event in Davos, avenging her loss to Schut, recording 4:54.6."] "\n\n" [:p {} "Their teammate, " [:a {:href "/athletes/80756"} "Wil Burgmeijer"] ", was in the first pair and broke the Olympic record with 5:05.1 for a mark to shoot at, though it would eventually bring her only fifth. Schut was in the fifth pair and blasted through the laps in 4:56.2, the third fastest time ever. Kaiser was in the 12th pair. She was hampered by rain that had started to fall, quickly dropped off Schut’s pace, and was four seconds behind at 1,000 metres. And she would never close that gap, finishing in 5:01.3, also behind " [:a {:href "/athletes/81890"} "Kaija Mustonen"] ", who had finished in 5:01.0 in the seventh pair. In the end that was the podium with Schut getting gold, Mustonen silver, and Kaiser bronze."] "\n\n" [:p {} "Schut had been a top distance skater but she had often finished second at 3,000, usually to Kaiser. But in coming years, she would win the distance frequently, at the 1969 and 1970 World Championships and the 1970 European Championships. Kaiser had a difficult Grenoble Olympics, winning disappointing bronze medals in the 1,500 and 3,000, but she returned in 1972 at Sapporo and win gold in the 3,000."] "\n"] [:button {:id "button365213", :class "btn btn-default"} "Details"] [:script {} "$('#button365213').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "200 m"] [:th {:style "display: none", :class "split"} "600 m"] [:th {:style "display: none", :class "split"} "1000 m"] [:th {:style "display: none", :class "split"} "1400 m"] [:th {:style "display: none", :class "split"} "1800 m"] [:th {:style "display: none", :class "split"} "2200 m"] [:th {:style "display: none", :class "split"} "2600 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "5I"] [:td {} [:a {:href "/athletes/82315"} "Ans Schut"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "4:56.2"] [:td {:class "split", :style "display: none"} "21"] [:td {:class "split", :style "display: none"} "58"] [:td {:class "split", :style "display: none"} "1:36"] [:td {:class "split", :style "display: none"} "2:16"] [:td {:class "split", :style "display: none"} "2:56"] [:td {:class "split", :style "display: none"} "3:36"] [:td {:class "split", :style "display: none"} "4:16"