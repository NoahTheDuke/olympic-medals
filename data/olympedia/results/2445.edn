a-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #3"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004838"} "Walter Vogel"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #4"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002786"} "Jerzy Cieslar"]] [:td {} [:a {:href "/countries/POL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/POL.png"}] "POL"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #5"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004578"} "Tapio Junnonen"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "K-Point: 120 m"]]]] [:div {:class "description"} [:p {} "The events of the 1994 Winter Olympics stayed long in the memory for Japanese sports fans. Needing only a modest distance to secure gold for his team " [:a {:href "/athletes/86456"} "Masahiko Harada"] " made a complete mess of his jump and gifted the title to Germany. The most recent World Championship title had gone to Finland but Japanese success in Nagano had earned them the mantle of favourites for this event."] "\n\n" [:p {} "Halfway through the first round all was going well for Japan. " [:a {:href "/athletes/96009"} "Okabe"] " and " [:a {:href "/athletes/99851"} "Saito"] " had put the Japanese into lead and next it was the turn of world champion Harada to jump, but Harada’s effort turned into an unmitigated disaster, and even caused his team to be subtracted points from their total. Austria, Germany and Norway would all overtake Japan and fill the first three places as the first round closed. During the interval between the two rounds snow fell and it seemed possible that the second round might be cancelled and Austria would be crowned champions. To the relief of the home fans the weather improved and the event continued. The pattern for the second set of jumps mirrored the first and Japan gained back points from their opening jumpers. When Harada stood at the top of the hill for his second jump the title was again within his team’s reach. As his nation collectively held their breath he came down the ramp, leapt and then hung in the air for an eternity, landing only at 137.0 m to equal the Olympic best set minutes earlier by Okabe. This gave Japan a clear lead with only a distance of 90.5 needed by " [:a {:href "/athletes/99850"} "Funaki"] " to ensure victory. Funaki’s leap of 125 m was the cue for wild celebrations and considerable relief for the home team."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Jump #1"] [:th {} "Jump #2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Japan"] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]] [:td {} "933.0"] [:td {} "397.1 (4)"] [:td {} "535.9 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/96009"} "Takanobu Okabe"] " "] [:td {}] [:td {} "259.3"] [:td {} "115.7"] [:td {} "143.6"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/99851"} "Hiroya Saito"] " "] [:td {}] [:td {} "256.2"] [:td {} "131.5"] [:td {} "124.7"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/86456"} "Masahiko Harada"] " "] [:td {}] [:td {} "177.2"] [:td {} "35.6"] [:td {} "141.6"] [:td {}] 