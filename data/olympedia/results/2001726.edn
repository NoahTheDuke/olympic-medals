001516"} "100 metres Freestyle, Men"] "\n" [:option {:value "2001531"} "200 metres Freestyle, Men"] "\n" [:option {:value "2001543"} "400 metres Freestyle, Men"] "\n" [:option {:value "2001551"} "800 metres Freestyle, Men"] "\n" [:option {:value "2001559"} "1,500 metres Freestyle, Men"] "\n" [:option {:value "2001566"} "4 × 100 metres Freestyle Relay, Men"] "\n" [:option {:value "2001571"} "4 × 200 metres Freestyle Relay, Men"] "\n" [:option {:value "2001576"} "100 metres Backstroke, Men"] "\n" [:option {:value "2001588"} "200 metres Backstroke, Men"] "\n" [:option {:value "2001598"} "100 metres Breaststroke, Men"] "\n" [:option {:value "2001611"} "200 metres Breaststroke, Men"] "\n" [:option {:value "2001622"} "100 metres Butterfly, Men"] "\n" [:option {:value "2001636"} "200 metres Butterfly, Men"] "\n" [:option {:value "2001647"} "200 metres Individual Medley, Men"] "\n" [:option {:value "2001659"} "400 metres Individual Medley, Men"] "\n" [:option {:value "2001666"} "4 × 100 metres Medley Relay, Men"] "\n" [:option {:value "2001671"} "50 metres Freestyle, Women"] "\n" [:option {:value "2001688"} "100 metres Freestyle, Women"] "\n" [:option {:value "2001702"} "200 metres Freestyle, Women"] "\n" [:option {:value "2001712"} "400 metres Freestyle, Women"] "\n" [:option {:value "2001719"} "800 metres Freestyle, Women"] "\n" [:option {:value "2001734"} "4 × 100 metres Freestyle Relay, Women"] "\n" [:option {:value "2001739"} "4 × 200 metres Freestyle Relay, Women"] "\n" [:option {:value "2001744"} "100 metres Backstroke, Women"] "\n" [:option {:value "2001756"} "200 metres Backstroke, Women"] "\n" [:option {:value "2001766"} "100 metres Breaststroke, Women"] "\n" [:option {:value "2001778"} "200 metres Breaststroke, Women"] "\n" [:option {:value "2001788"} "100 metres Butterfly, Women"] "\n" [:option {:value "2001799"} "200 metres Butterfly, Women"] "\n" [:option {:value "2001808"} "200 metres Individual Medley, Women"] "\n" [:option {:value "2001818"} "400 metres Individual Medley, Women"] "\n" [:option {:value "2001824"} "4 × 100 metres Medley Relay, Women"] "\n" [:option {:value "2001829"} "4 × 100 metres Medley Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "19000221"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/2570"} "Event type"]] [:h1 {:class "event_title"} "1,500 metres Freestyle, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "30 – 31 July 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2158"} "Paris La Défense Arena, Nanterre, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2001726"} "16 from 12 countries"]]]]] [:div {:class "description"} [:p {} "The women’s 1,500 metre freestyle was on the Olympic Programme for only the second time, débuting at Tokyo 2020, when it was won by American " [:a {:href "/athletes/126653"} "Katie Ledecky"] ". Ledecky was back and remained the overwhelming favorite. She had set the last six world records, had recorded the 22 fastest times in the event, and her current world record was over 18 seconds faster than the second-best performer, Denmark’s " [:a {:href "/athletes/115714"} "Lotte Friis"] "."] "\n\n" [:p {} "Ledecky was expected to win easily, but other medal contenders were Italian " [:a {:href "/athletes/2101961"} "Simona Quadarella"] ", a two-time World Champion in the event, winning in 2019 when Ledecky withdrew with illness, and also earlier in 2024, when Ledecky did not compete; and China’s " [:a {:href "/athletes/141768"} "Li Bingjie"] ", a two-time medalist at the World Championships."] "\n\n" [:p {} "Ledecky and Quadarella qualified 1-2, while Li made the final but had only the sixth fastest qualifier. The third fastest qualifier was the surprising Russian-born Frenchwoman " [:a {:href "/athletes/146183"} "Anastasiya Kirpichnikova"] ". She had competed for Russia at the 2019 World Championships but elected to swim for France in early 2023 because of the restrictions on Russian athletes in international competition."] "\n\n" [:p {} "By 100 metres of the final, Ledecky had over a 1½ second lead on the field, with Kirpichnikova trailing in second. Ledecky had the fastest split for every 100 metres of the final, winning gold by over 10 seconds in front of Kirpichnikova. German " [:a {:href "/athletes/143331"} "Isabel Gose"] " had been fourth for most of the race, behind Quadarella, but closed quickly in the last 200 metres to take the bronze medal. Li was never close to a podium position and finished fifth."] "\n\n" [:p {} "Ledecky recorded 15:30.02, the eighth fastest time ever, to better her Olympic record from Tokyo. She had been ahead of world record pace through 500 metres but could not maintain that. Kirpichnikova’s time of 15:40.35 made her the fourth fastest performer ever for the event."] "\n\n" [:p {} "Ledecky’s gold in this event was her 12th Olympic medal, tying her among female Olympic swimmers with Americans " [:a {:href "/athletes/51218"} "Dara Torres"] ", " [:a {:href "/athletes/51217"} "Jenny Thompson"] ", and " [:a {:href "/athletes/103301"} "Natalie Coughlin"] ", and Australian " [:a {:href "/athletes/129061"} "Emma McKeon"] ", who had won her 12th medal four days before in the 4x100 free relay. Both Ledecky and McKeon would end the Paris Olympics with 14 Olympic medals."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {: