38000"} "1900"] "\n" [:option {:value "38011"} "1904"] "\n" [:option {:value "38017"} "1908"] "\n" [:option {:value "38025"} "1912"] "\n" [:option {:value "38041"} "1920"] "\n" [:option {:value "38068"} "1924"] "\n" [:option {:value "38095"} "1928"] "\n" [:option {:value "38119"} "1932"] "\n" [:option {:value "38129"} "1936"] "\n" [:option {:value "38179"} "1948"] "\n" [:option {:value "38237"} "1952"] "\n" [:option {:value "38305"} "1956"] "\n" [:option {:value "38341"} "1960"] "\n" [:option {:value "38391"} "1964"] "\n" [:option {:value "38432"} "1968"] "\n" [:option {:value "38502"} "1972"] "\n" [:option {:value "38623"} "1980"] "\n" [:option {:value "38678"} "1984"] "\n" [:option {:value "38727"} "1988"] "\n" [:option {:value "38777"} "1992"] "\n" [:option {:value "38827"} "1996"] "\n" [:option {:value "38884"} "2000"] "\n" [:option {:value "38966"} "2004"] "\n" [:option {:value "262918"} "2008"] "\n" [:option {:value "330000"} "2012"] "\n" [:option {:value "396300"} "2016"] "\n" [:option {:value "19001580"} "2020"] "\n" [:option {:value "2003100"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/631"} "Event type"]] [:h1 {:class "event_title"} "Water Polo, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "18 – 27 July 1976"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/558"} "Piscine olympique, Montréal, Québec"] " / " [:a {:href "/venues/564"} "Centre Claude-Robillard, Montréal, Québec"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/38568"} "131 from 12 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Round-robin pools advanced teams to the round-robin final pool."]]]] [:div {:class "description"} [:p {} "Since World War II the top water polo nations had been Hungary, Yugoslavia, Italy, and the Soviet Union. In 1973 FINA instituted the World Aquatics Championship, which gave more idea of who the strongest teams were coming into the Olympic year. But those only showed that little had changed in the water polo world. In 1973 Hungary was World Champion, with the Soviets winning silver, and Yugoslavia bronze, while in 1975 the Soviets won the title, followed by Hungary and Italy. At the 1974 European Championships, the medalists finished in the same order as in 1973 at the Worlds – Hungary, USSR, Yugoslavia."] "\n\n" [:p {} "But in a shocker at Montréal, the Soviet Union did not advance to the medal round, placing only third in Group B, trailing the Netherlands and Romania. The Soviet officials were so upset that they withdrew their team from the consolation pool, forfeiting the first match against Cuba, officially stating that several of their players were sick, but the Olympic water polo officials then convinced them to play on. They did but placed second behind Cuba in the consolations, or eighth overall, the forfeited loss to Cuba being the margin between the two teams."] "\n\n" [:p {} "In Group A Italy and Yugoslavia advanced, while Hungary and West Germany made it out of Group C. The final pool saw Hungary win its sixth Olympic water polo gold medal (1932, 1936, 1952, 1956, 1964, 1976). They won their first four matches in the finals, although every game was close, as they won by scores of 6-5, 5-3, 5-3, 9-8, and then faced their archrival, Yugoslavia, who had not won a game in the final round. The two teams tied, 5-5, which gave Hungary the gold and placed Yugoslavia fifth, without a final round victory. Italy and the Netherlands tied the final match of the tournament, 3-3, which left them tied in the pool, with 2 wins, 2 ties, and 1 loss each. They were also tied on goal differential, but Italy was awarded the silver medal because they had scored more goals in the medal round, 22-18."] "\n\n" [:p {} "Hungary also had the leading goalscorer of the tournament, with " [:a {:href "/athletes/54150"} "Tamás Faragó"] ", who scored 22 times. " [:a {:href "/athletes/54213"} "István Szivós, Jr."] " was also on the Hungarian team, winning his third consecutive Olympic medal, after bronze in 1968 and silver in 1972. He would return in 1980 and win a fourth medal, a bronze."] "\n"] [:button {:id "button880994", :class "btn btn-default"} "Details"] [:script {} "$('#button880994').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {}] [:th {} "Pos"] [:th {} "Number"] [:th {} "Team"] [:th {} "NOC"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Games Played", :class "split", :style "display: none"} "GP"] [:th {:style "display: none", :class "split"} "Goals"] [:th {:style "display: none", :class "split"} "Attempts"] [:th {:style "display: none", :class "split"} "Shot %"] [:th {:style "display: none", :class "split"} "Penalty Shot Goals/Attempts"] [:th {:style "display: none", :class "split"} "Exclusions"] [:th {:style "display: none", :class "split"} "Penalty Fouls"] [:th {:style "display: none", :class "split"} "Exclusion (w/wo Sub)"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {:class "accordion-toggle", :data-toggle "collapse", :data-target ".team-members-568323"} [:div {:class "glyphicon glyphicon-plus"}]] [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "Hungary"] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"]] [:td {:class "split", :style "display: none"} "8"] [:td {:class "split", :style "display: none"} "45"] [:td {:class "split", :style "display: none"} "111"] [:td {:class "split", :style "display: none"} "40.5%"] [:td {:class "split", :style "display: none"} "10/12"] [:td {:class "split", :style "display: none"} "30"] [:td {:class "split", :style "display: none"} "6"] [:td {:class "split", :style "display: none"} "0"] [:td {} [:span {:class "Go