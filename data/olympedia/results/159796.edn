ouble Sculls, Men"] "\n" [:option {:value "159754"} "Quadruple Sculls, Men"] "\n" [:option {:value "159765"} "Coxless Pairs, Men"] "\n" [:option {:value "159776"} "Coxless Fours, Men"] "\n" [:option {:value "159787"} "Eights, Men"] "\n" [:option {:value "159816"} "Lightweight Coxless Fours, Men"] "\n" [:option {:value "159827"} "Single Sculls, Women"] "\n" [:option {:value "159848"} "Double Sculls, Women"] "\n" [:option {:value "159857"} "Quadruple Sculls, Women"] "\n" [:option {:value "159864"} "Coxless Pairs, Women"] "\n" [:option {:value "159873"} "Eights, Women"] "\n" [:option {:value "159879"} "Lightweight Double Sculls, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "159436"} "1996"] "\n" [:option {:value "159620"} "2000"] "\n" [:option {:value "261043"} "2008"] "\n" [:option {:value "319171"} "2012"] "\n" [:option {:value "354013"} "2016"] "\n" [:option {:value "19008486"} "2020"] "\n" [:option {:value "2012485"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/390"} "Event type"]] [:h1 {:class "event_title"} "Lightweight Double Sculls, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "15 – 22 August 2004"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/788"} "Olympiako Kopelatodramio Skhoinia, Schinias National Park"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/159796"} "43 from 21 countries"]]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/92661"} "Tomasz Kucharski"] " and " [:a {:href "/athletes/39412"} "Robert Sycz"] " of Poland were the defending Olympic champions, but they had been runners-up at the last three World Championships, losing every time to Italy’s " [:a {:href "/athletes/92609"} "Elia Luini"] " and " [:a {:href "/athletes/38450"} "Leonardo Pettinari"] ", the 2000 Olympic silver medalists. Although these two nations were favored at the 2004 edition, both lost their opening round heats, Italy to the Greek duo of " [:a {:href "/athletes/38086"} "Vasilios Polymeros"] " and " [:a {:href "/athletes/104366"} "Nikos Skiathitis"] " and Poland to Danes " [:a {:href "/athletes/104381"} "Mads Rasmussen"] " and " [:a {:href "/athletes/104382"} "Rasmus Quist"] ", the 2002 World bronze medalists. The other heats went to Ireland’s " [:a {:href "/athletes/38234"} "Sam Lynch"] " and " [:a {:href "/athletes/92602"} "Gearóid Towey"] ", the 2003 World bronze medalists, and France’s " [:a {:href "/athletes/104375"} "Frédéric Dufour"] " and " [:a {:href "/athletes/92551"} "Pascal Touron"] ", the latter of whom was a 2000 Olympic bronze medalist and both of whom posted the fastest time of the round. A big surprise came in the finals when Italy struggled in a heat won by France and finished fifth behind Ireland, leading to its elimination. Poland won its heat easily and, with its strongest challenger gone, was able to claim the gold medal in the final, although it faced a surprisingly strong challenge from France, who came in for silver just over half a second later. The Greeks, meanwhile, battled the Danes for the final podium spot and came out on top by a margin of only 0.69 seconds to win their nation its first Olympic rowing medal, if one discounts those earned in the odd 6- and 17-man naval rowing boats events at the 1906 Intercalated Games."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/92661"} "Tomasz Kucharski"] " / " [:a {:href "/athletes/39412"} "