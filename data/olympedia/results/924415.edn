value "924379"} "Halfpipe, Men"] "\n" [:option {:value "924389"} "Cross, Men"] "\n" [:option {:value "924444"} "Halfpipe, Women"] "\n" [:option {:value "924454"} "Cross, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1664"} "2002"] "\n" [:option {:value "1752"} "2006"] "\n" [:option {:value "350557"} "2014"] "\n" [:option {:value "9000930"} "2018"] "\n" [:option {:value "19020750"} "2022"] "\n" [:option {:value "15001244"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/525"} "Event type"]] [:h1 {:class "event_title"} "Parallel Giant Slalom, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "26 February 2010"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/175"} "Cypress Mountain, West Vancouver"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/924415"} "29 from 15 countries"]]] [:tr {:class "referees", :style ""} [:th {} "Course Setter"] [:td {:style "width: 400px"} [:a {:href "/athletes/99675"} "Mark Fawcett"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Gates: 22" [:br {}] "Length: 530 m" [:br {}] "Start Altitude: 1128 m" [:br {}] "Vertical Drop: 161 m"]]]] [:div {:class "description"} [:p {} "The last two World Cup leaders were German " [:a {:href "/athletes/110974"} "Amelie Kober"] " (2009) and the Netherlands’ " [:a {:href "/athletes/101489"} "Nicolien Sauerbreij"] " (2008), while the 2009 World Champion was Austrian " [:a {:href "/athletes/119597"} "Marion Kreiner"] ". Rounding out the four favorites was Kreiner’s teammate, " [:a {:href "/athletes/101493"} "Doris Günther"] ", runner-up at the 2009 World Championships and 2008-09 World Cup. Of note, the World Cup standings are for parallel snowboarding, which includes parallel GS and parallel slalom, which is not an Olympic event. Kreiner led the qualifying followed by Sauerbreij, the event being held in torrential rain and poor visibility. When the elimination phase of the event started, Kreiner advanced to the semi-final round with relative ease when her opponents made errors in their races. Sauerbreij also made the semi-finals, again helped by opponents’ faults. The other semi-finalists were Russian " [:a {:href "/athletes/119640"} "Yekaterina Ilyukhina"] ", who had taken out Kober in the quarter-finals, and German " [:a {:href "/athletes/119627"} "Selina Jörg"] ", who had just defeated Austrian " [:a {:href "/athletes/119578"} "Ina Meschik"] " by the narrow margin of 0.08 seconds in the quarter-finals, after taking out Günther in the first round."] "\n\n" [:p {} "In the semi-finals, Ilyukhina crashed out in the first run, but a mistake by Kreiner in the second run saw the Russian advance to the final. Georg had led Sauerbreij narrowly after their first run, but crashed out near the end of the second run when they were neck and neck. Kreiner comfortably won the contest for the bronze medal following mistakes by her opponent. The final was a thriller, with Ilyukhina leading Sauerbreij by 0.02 seconds after the first run. However, in a close contest, it was Sauerbreij who took the title by the narrow margin of 0.23 seconds. This was the first medal of any kind that the Netherlands had won in a “snow” event, all their previous medals being in “ice” sports."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [: