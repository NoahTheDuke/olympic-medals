1243"} "1972"] "\n" [:option {:value "61817"} "1976"] "\n" [:option {:value "62384"} "1980"] "\n" [:option {:value "62879"} "1984"] "\n" [:option {:value "63522"} "1988"] "\n" [:option {:value "64204"} "1992"] "\n" [:option {:value "64883"} "1996"] "\n" [:option {:value "65542"} "2000"] "\n" [:option {:value "66222"} "2004"] "\n" [:option {:value "257355"} "2008"] "\n" [:option {:value "302004"} "2012"] "\n" [:option {:value "358771"} "2016"] "\n" [:option {:value "19000526"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/80"} "Event type"]] [:h1 {:class "event_title"} "Shot Put, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "2 –  3 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2157"} "Stade de France, Saint-Denis, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2013683"} "31 from 24 countries"]]]]] [:div {:class "description"} [:p {} "At Rio 2016 and Tokyo 2020, the podium had been Americans " [:a {:href "/athletes/136264"} "Ryan Crouser"] " and " [:a {:href "/athletes/136251"} "Joe Kovacs"] " with gold and silver, and New Zealand’s " [:a {:href "/athletes/135357"} "Tom Walsh"] " with bronze. This was the first time in Olympic history that the podium had been identical at two consecutive Olympics, in any individual event in any sport. All three were considered among the favorites, with Crouser, the world record holder and 2022 and 2023 World Champion, pipped for gold. Italy’s " [:a {:href "/athletes/2103688"} "Leonardo Fabbri"] " had come to the fore in 2024, bettering 22 metres at all of his 2024 meets, beating the Italian record with 22.95 in May and winning the European Championship in June with 22.45. He was clearly expected to challenge for a medal."] "\n\n" [:p {} "All the favorites made the final, but Walsh would fail to record a legal mark. Crouser opened with 22.64 metres and that decided the gold medal, although he would improve in rounds two and three with 22.69 and 22.90 metres. As rain began to fall, Crouser had no marks in rounds four and five and skipped his final throw as he became the first athlete to three-peat in the men’s shot put."] "\n\n" [:p {} "Jamaica’s surprising " [:a {:href "/athletes/150194"} "Rajindra Campbell"] " moved into second place in round two with a mark of 22.15 metres. Kovacs started slowly and was only in fourth place after five rounds but matched Campbell’s 22.15 on his final throw, despite the wet ring. With a better secondary mark (21.71 to 20.00), Kovacs also three-peated as the silver medalist, while Campbell won bronze for Jamaica’s first medal in the event. Fabbri never got going and eventually finished fifth with 21.70 and only two valid throws, also behind " [:a {:href "/athletes/147345"} "Payton Otterdahl"] " of the United States."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1303"] [:td {} [:a {:href "/athletes/136264"} "Ryan Crouser"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "21.49 (4)"] [:td {} "22.90 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "1325"] [:td {} [:a {:href "/athletes/136251"} "Joe Kovacs"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "21.24 (7)"] [:td {} "22.15 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]