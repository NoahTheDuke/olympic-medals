value "127155"} "1972"] "\n" [:option {:value "127969"} "1976"] "\n" [:option {:value "128674"} "1980"] "\n" [:option {:value "129490"} "1984"] "\n" [:option {:value "130667"} "1988"] "\n" [:option {:value "131761"} "1992"] "\n" [:option {:value "132830"} "1996"] "\n" [:option {:value "133549"} "2000"] "\n" [:option {:value "134134"} "2004"] "\n" [:option {:value "263781"} "2008"] "\n" [:option {:value "355634"} "2016"] "\n" [:option {:value "19009387"} "2020"] "\n" [:option {:value "2007880"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/663"} "Event type"]] [:h1 {:class "event_title"} "Light-Heavyweight, Greco-Roman (≤84 kg), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 6 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/861"} "ExCeL, Newham, London"] " (North Arena 2)"]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/332184"} "20 from 20 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single elimination tournament. Competitors losing to the finalists entered repechage tournament for bronze medals."]]]] [:div {:class "description"} [:p {} "The favorites going into the men’s light-heavyweight Greco-Roman wrestling tournament were " [:a {:href "/athletes/121791"} "Hristo Marinov"] " of Bulgaria, the 2010 World Champion, and " [:a {:href "/athletes/121640"} "Damian Janikowski"] " of Poland, the 2011 World Championship silver medalist. " [:a {:href "/athletes/121057"} "Alim Selimov"] " of Belarus was the reigning World Champion, a title he had held in 2005 as well, but was inconsistent on the world stage and not considered too dangerous in London. The tournament also had its share of Olympic veterans vying for the crown, including Egypt’s " [:a {:href "/athletes/107665"} "Karam Gaber"] ", the 2004 Olympic champion in the heavyweight division, and Turkey’s " [:a {:href "/athletes/60284"} "Nazmi Avluca"] ", who had made appearances at the 1996, 2000, and 2008 editions of the Games, the latter of which netted him a bronze medal.  Nonetheless, it was expected that Marinov and Janikowski would be the most serious challengers for the crown."] "\n\n" [:p {} "In the end it was not to be – Marinov, Selimau, and Avluca were all eliminated in their first bout, Avluca by Janikowski and Selimau by eventual finalist " [:a {:href "/athletes/120829"} "Alan Khugayev"] " of Russia, runner-up at the most recent European Championships. Janikowski survived to the semi-finals, where he was defeated by Gaber, who went on to face Khugayev in the finals. Both rounds of the gold medal match went to " [:em {} "par terre"] ", with Khugayev emerging victorious after a successful defense, and then gut-wrench, of his Egyptian opponent."] "\n\n" [:p {} "In the first bronze medal match, " [:a {:href "/athletes/126866"} "Daniyal Gadzhiyev"] " of Kazakhstan, a rookie wrestler who had managed to defeat Marinov in his first bout and Selimau in the repêchage, and " [:a {:href "/athletes/120319"} "Vladimer Gegeshidze"] " of Georgia, an unusually tall competitor for his weight class who had not seen the podium in his two World Championships. They were evenly matched in their first two rounds, each successfully defending in the " [:em {} "par terre"] ", while, with points and cautions tied 90 seconds into the third round, Gadzhiyev drew the top and Gegeshidze the bottom in the final " [:em {} "par terre"] ". During the round, it seemed at first that the Georgian had won, scoring two points by converting his defense. The Kazakhs protested and, in a controversial decision, the referee’s call was overturned and Gadzhiyev was awarded the point and, consequently, the bronze medal. Gegeshidze, seemingly a fair sport at first, refused to shake hands with his opponent and attempted to exit the arena the wrong way, before kicking at the barricades and storming off. The second bronze medal match, between Janikowski and " [:a {:href "/athletes/107630"} "Mélonin Noumonvi"] ", a three-time Olympian and runner-up at the 2009 World Championships, was far less dramatic, with Janikowski successfully defending in the first " [:em {} "par terre"] " and throwing his opponent out of the ring in the second to clinch the bronze."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/120829"} "Alan Khugayev"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/107665"} "Karam Gaber"]] [:td {} [:a {:href "/countries/EGY"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/EGY.png"}] "EGY"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/126866"} "Daniyal Gadzhiyev"]] [:td {} [:a {:href "/countries/KAZ"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KAZ.png"}] "KAZ"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/121640"} "Damian Janikowski"]] [:td {} [:a {:href "/countries/POL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/POL.png"}] "POL"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=5"] [:td {} [:a {:href "/athletes/107630"} "Mélonin Noumon