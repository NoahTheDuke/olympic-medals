1.0"] " / " [:a {:href "/athletes/85794"} "Wojciech Fortuna"] " " [:a {:href "/countries/POL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/POL.png"}] "POL"] " / 11 February 1972 / " [:a {:href "/records/event_name/519"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #1"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002447"} "Heinz Mann"]] [:td {} [:a {:href "/countries/GDR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GDR.png"}] "GDR"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #2"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002139"} "Fred Rogers"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #3"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004736"} "Valentin Tatarintsev"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #4"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003967"} "Pavel Krznarić"]] [:td {} [:a {:href "/countries/YUG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/YUG.png"}] "YUG"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #5"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004847"} "Walter Schneller"]] [:td {} [:a {:href "/countries/FRG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRG.png"}] "FRG"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "K-Point: 114 m"]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/87347"} "Toni Innauer"] ", Olympic champion in the Normal Hill, was heavily favored for another gold in the Large Hill, but this time the 21-year-old Austian had much stronger competition from the other jumpers. In the first round the 21-year-old Swiss " [:a {:href "/athletes/97963"} "Hansjörg Sumi"] ", made a mighty jump of 117.0 m, taking the lead ahead of " [:a {:href "/athletes/98461"} "Jouko Törmänen"] " from Finland and Austria’s " [:a {:href "/athletes/95804"} "Hubert Neuper"] ". In fourth place, to everyone’s great surprise, was " [:a {:href "/athletes/84834"} "Steve Collins"] ", a 15-year-old Ojibway Indian from Canada, a jumper totally unknown outside his homeland. Innauer was in sixth position, almost 9 points behind Sumi."] "\n\n" [:p {} "In the second round, Neuper was starting first of the favorites and was in a clear lead after a good jump of 114.5 m. Finland’s " [:a {:href "/athletes/96633"} "Jari Puikkonen"] ", lying fifth after the first round, was in second position when his teammate Törmänen impressed with another 117.0 m jump, taking over the lead. First of the challengers was Innauer, but a jump of only 107.0 m placed him behind Puikkonen and outside the medals. Next was the leader after the first round, the Swiss Sumi. He could not duplicate his first jump and landed at 100.0 m, 17.0 m shorter than his first jump. Last to jump was the 15-year-old Collins, a jump of 108.0 m would put him in the bronze medal position. However, the young Collins could not control his nerves, as his 102.5 m dropped him from fourth to ninth."] "\n\n" [:p {} "Finland had fought back against the Austrian/East German dominance in ski jumping, winning gold and bronze. The Austrian team jumped well, placing second, fourth and fifth, but for the East Germans the Large Hill event was a great disappointment, their best " [:a {:href "/athletes/86097"} "Henry Glaß"] " ending as a distant 11th.  Steve Collins won the Junior World Championships in Örnsköldsvik, Sweden five days later. Nine days after that he showed that his first jump in Lake Placid was not just luck, being the youngest ever winner of a World Cup ski jumping event in Lahti, Finland, four days before his 16th birthday."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Jump #1"] [:th {} "Jump #2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/98461"} "Jouko Törmänen"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]] [:td {} "271.0"] [:td {} "133.5 (2)"] [:td {} "137.5 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/95804"} "Hubert Neuper"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]] [:td {} "262.4"] [:td {} "129.9 (3)"] [:td {} "132.5 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/96633"} "Jari Puikkonen"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]] [:td {} "248.5"] [:td {} "126.4 (5)"] [:td {} "122.1 (4)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/87347"} "Toni Innauer"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]] [:td {} "245.7"] [:td {} "126.2 (6)"] [:td {} "119.5 (8)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [