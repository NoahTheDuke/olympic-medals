99"} "1924"] "\n" [:option {:value "57699"} "1928"] "\n" [:option {:value "57983"} "1932"] "\n" [:option {:value "58224"} "1936"] "\n" [:option {:value "58571"} "1948"] "\n" [:option {:value "58930"} "1952"] "\n" [:option {:value "59707"} "1960"] "\n" [:option {:value "60153"} "1964"] "\n" [:option {:value "60592"} "1968"] "\n" [:option {:value "61100"} "1972"] "\n" [:option {:value "61686"} "1976"] "\n" [:option {:value "62243"} "1980"] "\n" [:option {:value "62722"} "1984"] "\n" [:option {:value "63360"} "1988"] "\n" [:option {:value "64041"} "1992"] "\n" [:option {:value "64721"} "1996"] "\n" [:option {:value "65397"} "2000"] "\n" [:option {:value "66089"} "2004"] "\n" [:option {:value "257222"} "2008"] "\n" [:option {:value "302371"} "2012"] "\n" [:option {:value "358633"} "2016"] "\n" [:option {:value "19000431"} "2020"] "\n" [:option {:value "2013583"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/45"} "Event type"]] [:h1 {:class "event_title"} "5,000 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "26 – 28 November 1956"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/396"} "Melbourne Cricket Ground, Melbourne, Victoria"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/59323"} "23 from 13 countries"]]]]] [:div {:class "description"} [:p {} "The great distance champion of the 1952 Olympics, " [:a {:href "/athletes/76736"} "Emil Zátopek"] ", was still competing but chose to run only the marathon in Melbourne. At the 1954 European Championships, the gold was won by Soviet " [:a {:href "/athletes/77531"} "Volodymyr Kuts"] " over Britain’s " [:a {:href "/athletes/68952"} "Chris Chataway"] ", with Zátopek third. Kuts and Chataway both broke the world 5K record in 1954. Then in 1955, Kuts and Hungary’s " [:a {:href "/athletes/71173"} "Sándor Iharos"] " exchanged the record. Iharos had had a dominating year in 1955 in distance running, setting six world records at distance between 1,500 and 5,000 metres, and in early 1956 set world records at six miles and 10K. The Melbourne 5K was expected to be a great battle between Kuts, Iharos, and Chataway. But shortly before the Olympics, the Soviet Union invaded Hungary to put down a democratic uprising in that country. Although Hungary competed in Melbourne, Iharos stayed back home, unsuccessfully working the telephone exchanges."] "\n\n" [:p {} "The final of this event came down to Kuts and a British runner, but it was not Chataway who was suffering from stomach cramps in the final and finished only 11th. Kuts was by far the strongest. He pushed the pace from the beginning, with only the three Britons staying in contact early, Chataway, " [:a {:href "/athletes/69394"} "Gordon Pirie"] " and " [:a {:href "/athletes/69180"} "Derek Ibbotson"] ". But by 4,000, Kuts was clear of the field and continued pulling away, winning by 11 seconds in the largest margin of victory ever for this event."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "200"] [:td {} [:a {:href "/athletes/77531"} "Vladimir Kuts"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "14:15.4 (2 h2)"] [:td {} "13:39.6 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "189"] [:td {} [:a {:href "/athletes/69394"} "Gordon Pirie"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px