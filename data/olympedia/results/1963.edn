 {:value "1961"} "30 kilometres, Men"] "\n" [:option {:value "1962"} "50 kilometres, Men"] "\n" [:option {:value "1967"} "5 kilometres, Women"] "\n" [:option {:value "1968"} "10 kilometres, Women"] "\n" [:option {:value "1969"} "3 × 5 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1897"} "1936"] "\n" [:option {:value "1903"} "1948"] "\n" [:option {:value "1909"} "1952"] "\n" [:option {:value "1917"} "1956"] "\n" [:option {:value "1928"} "1960"] "\n" [:option {:value "1939"} "1964"] "\n" [:option {:value "1951"} "1968"] "\n" [:option {:value "1975"} "1976"] "\n" [:option {:value "1988"} "1980"] "\n" [:option {:value "2001"} "1984"] "\n" [:option {:value "2015"} "1988"] "\n" [:option {:value "2032"} "1992"] "\n" [:option {:value "2052"} "1994"] "\n" [:option {:value "2072"} "1998"] "\n" [:option {:value "2104"} "2002"] "\n" [:option {:value "2148"} "2006"] "\n" [:option {:value "923569"} "2010"] "\n" [:option {:value "350069"} "2014"] "\n" [:option {:value "9000280"} "2018"] "\n" [:option {:value "19019715"} "2022"] "\n" [:option {:value "15000136"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/191"} "Event type"]] [:h1 {:class "event_title"} "4 × 10 kilometres Relay, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "13 February 1972 — 9:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/109"} "Makomanai Cross Country Events Site, Sapporo"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1963"} "56 from 14 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: ?" [:br {}] "Height Differential: 109 m" [:br {}] "Maximum Climb: 67 m" [:br {}] "Total Climbing: 313 m"]]]] [:div {:class "description"} [:p {} "The cross-country relay was expected to be a close duel between defending Olympic Champion Norway and the reigning 1970 World Champion, the Soviet Union. At the first exchange, three teams were close together. Norway’s " [:a {:href "/athletes/84436"} "Oddvar Brå"] " and Sweden’s " [:a {:href "/athletes/92046"} "Thomas Magnusson"] " came in together, with Soviet’s " [:a {:href "/athletes/98725"} "Vladimir Voronkov"] " only two seconds behind, while Switzerland was in fourth place, 44 seconds behind the leader. On the second leg, Soviet " [:a {:href "/athletes/97602"} "Yury Skobov"] " and Norway’s " [:a {:href "/athletes/98447"} "Pål Tyldum"] " were close together at the exchange, with Sweden’s " [:a {:href "/athletes/99339"} "Lars-Göran Åslund"] " in third place over a minute behind. When Norway’s 20-year old " [:a {:href "/athletes/85784"} "Ivar  Formo"] " built up a 1:01 lead on the third leg over Soviet’s " [:a {:href "/athletes/97546"} "Fyodor Simashov"] ", it looked like an easy victory for the defending champions. Sweden in third was now only 20 seconds behind the Soviets, and the silver medalist from the Nordic Combined in 1968, " [:a {:href "/athletes/88762"} "Alois Kälin"] ", brought Switzerland up from sixth to fourth, only two seconds behind Sweden."] "\n\n" [:p {} "The Soviet’s anchor leg skier " [:a {:href "/athletes/98594"} "Vyacheslav Vedenin"] " started strongly, and after 5 km he had reduced the gap to the Norwegian " [:a {:href "/athletes/86487"} "Johs Harviken"] " to around half a minute. The Soviets now began to hope for victory, and 100 m from home Vedenin had caught Harviken. In a desperate try to counterattack, Harviken fell, and Vedenin secured Soviet’s second Olympic relay gold, 16 years after their first win in Cortina d’Ampezzo. The fight for the bronze medal also ended in drama. Sweden’s " [:a {:href "/athletes/91953"} "Sven-Åke Lundbäck"] " and Switzerland’s " [:a {:href "/athletes/86514"} "Edi Hauser"] " arrived in the finishing stretch together, then Lundbäck fell and Hauser garnered for Switzerland their first ever Olympic cross-country relay medal. Alois Kälin is still the last skier, thru 2006, with Olympic medals both in cross-country skiing and Nordic Combined. The team from East Germany, who had won a surprising silver medal in the 1970 World Championships, had the same lineup in Sapporo as they had in 1970, but ended in a disappointing sixth place, over five minutes behind the winning team."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Exchange"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1"] [:td {} "Soviet Union"] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "2-04:47.94"] [:td {} "– (–)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "Lead-Off"] [:td {:class "bib"} "1-1"] [:td {} [:a {:href "/athletes/98725"} "Vladimir Voronkov"] " "] [:td {}] [:td {} "31:12.52"] [:td {} "31:12.52 (3)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2nd Leg"] [:td {:class "bib"} "1-2"] [:td {} [:a {:href "/athletes/97602"} "Yury Skobov"] " "] [:td {}] [:td {} "30:55.42"] [:td {} "1-02:07.94 (1)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3rd Leg"] [:td {:class "bib"} "1-3"] [:td {} [:a {:href "/athletes/97546"} "Fyodor Simashov"] " "] [:td {}] [:td {} "32:18.63"] [:td {} "1-34:26.57 (2)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "Anchor"] [:td {:class "bib"} "1-4"] [:td {} [:a {:href "/athletes/98594"} "Vyacheslav Vedenin"] "