:id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "6078"} "1968"] "\n" [:option {:value "6381"} "1972"] "\n" [:option {:value "6659"} "1976"] "\n" [:option {:value "6895"} "1980"] "\n" [:option {:value "7173"} "1984"] "\n" [:option {:value "7870"} "1992"] "\n" [:option {:value "8216"} "1996"] "\n" [:option {:value "8618"} "2000"] "\n" [:option {:value "9009"} "2004"] "\n" [:option {:value "261748"} "2008"] "\n" [:option {:value "322309"} "2012"] "\n" [:option {:value "357237"} "2016"] "\n" [:option {:value "19000250"} "2020"] "\n" [:option {:value "2001756"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/596"} "Event type"]] [:h1 {:class "event_title"} "200 metres Backstroke, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "25 September 1988"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/643"} "Su-yeong-jang, Ol-lim-pik Gong-won, Seoul"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/7518"} "32 from 23 countries"]]]]] [:div {:class "description"} [:p {} "As a 12-year-old, " [:a {:href "/athletes/48094"} "Krisztina Egerszegi"] " had débuted at the 1987 European Championships, placing fourth in the 200 back. A few days prior to this race she had placed second in the 100 back to East German wonder woman " [:a {:href "/athletes/47512"} "Kristin Otto"] ", and that gave her encouragement for the 200. But the favorite in this event was another East German, " [:a {:href "/athletes/47539"} "Cornelia Sirch"] ". Sirch went to the 100 in the final with a slight lead over Egerszegi but the Hungarian teenager blitzed the third lap, and came home for the gold medal in the second fastest time ever, 2:09.29. Sirch was worn out from her early effort and was passed for silver by her teammate, " [:a {:href "/athletes/47561"} "Kathrin Zimmermann"] ", although Sirch held on for bronze."] "\n\n" [:p {} "Of Egerszegi, Sirch said, “I’m sure she has a great future before her. I’m certain she will break new ground in backstroke swimming.” You could say that. This was the first of three consecutive gold medals in the event for Krisztina Egerszegi, something accomplished in a single Olympic event only by Australian sprint freestyler " [:a {:href "/athletes/45044"} "Dawn Fraser"] " in the women’s 100 free. She would eventually end her Olympic career with five individual gold medals, four in backstroke events, and seven medals in all, an unequalled Olymic best for swimming through 2008. She would win both backstrokes at the 1991 World Championships, and nine titles at the Europeans from 1991-95. In 1992 she won the Europeans in a world record 2:06.62, which would stand as the world record until 2008."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "B Final"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "204"] [:td {} [:a {:href "/athletes/48094"} "Krisztina Egerszegi"]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"]] [:td {} "2:11.01 (1 h4)"] [:td {} "–"] [:td {} "2:09.29 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "184"] [:td {} [:a {:href "/athletes/47561"} "Kathrin Zimmermann"]] [:td {} [:a {:href "/countries/GDR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GDR.png"}] "GDR"]] [:td {} "2:12.81 (1 h3)"] [:td {} "–"] [:td {} "2:10.61 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:clas