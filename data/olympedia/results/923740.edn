e "923676"} "1,000 metres, Men"] "\n" [:option {:value "923697"} "1,500 metres, Men"] "\n" [:option {:value "923712"} "5,000 metres Relay, Men"] "\n" [:option {:value "923719"} "500 metres, Women"] "\n" [:option {:value "923761"} "1,500 metres, Women"] "\n" [:option {:value "923776"} "3,000 metres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "905373"} "1988"] "\n" [:option {:value "601"} "1994"] "\n" [:option {:value "693"} "1998"] "\n" [:option {:value "799"} "2002"] "\n" [:option {:value "916"} "2006"] "\n" [:option {:value "350771"} "2014"] "\n" [:option {:value "9001185"} "2018"] "\n" [:option {:value "19020545"} "2022"] "\n" [:option {:value "15000965"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/548"} "Event type"]] [:h1 {:class "event_title"} "1,000 metres, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "24 – 26 February 2010"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/176"} "Pacific Coliseum, Vancouver"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/923740"} "32 from 18 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Placements 1-8 based on final and B final.  Deeper placements based on placements in earlier rounds, and best time skated."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/799"} "1:31.235"] " / " [:a {:href "/athletes/100218"} "Yang Yang (A)"] " " [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"] " / 23 February 2002 / " [:a {:href "/records/event_name/548"} "Details"]]]]] [:div {:class "description"} [:p {} "Experts were waiting to see the two Chinese short-track stars clash with each other in this event. The winner of the 500 m, " [:a {:href "/athletes/109921"} "Wang Meng"] ", was a sprint specialist, while the winner of the 1,500 m, " [:a {:href "/athletes/119816"} "Zhou Yang"] ", was more of a distance skater. Based on statistics, Wang seemed to have the upper hand, having won the last two world titles in the event, with Zhou finishing second in 2008. Wang also held the world record in the distance. However, Zhou had beaten her earlier in the season, at the World Cup in Montréal, although Wang had taken the distance’s World Cup."] "\n\n" [:p {} "In the quarter-finals, Zhou lowered the Olympic Record to below 1:30.000, but it would not hold for long. In the semi-finals, she went even faster, bettering the world record to 1:29.049, with " [:a {:href "/athletes/119791"} "Park Seung-Hui"] " (South Korea) also beating the old mark. In other semi-final, Wang was narrowly defeated by " [:a {:href "/athletes/119773"} "Katherine Reutter"] ". Early on in the final, Zhou attempted to pass Reutter on the inside, with Wang trying the same on the outside. Impeding Reutter with this move, Zhou knew she was out of contention and fell back, to be disqualified later. This left the field open for Wang, who outpowered Reutter and Park with apparent ease."] "\n\n" [:p {} "Wang’s gold medal for China meant the Chinese had won all four of the women’s short track speed skating events at the Vancouver Olympics; the first time any country achieved this since the sport’s inclusion in 1992. She also equalled the record of four Olympic short track golds, previously held only by " [:a {:href "/athletes/80843"} "Jeon I-Gyeong"] " (South Korea)."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th