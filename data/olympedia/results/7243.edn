ied in the final. Three weeks later the East German medley relay team set another world record of 4:03.69 to win the Friendship Games, followed by the Soviet Union, which recorded 4:08.13."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "4:09.23 (1 h2)"] [:td {} "4:08.34 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "Backstroke"] [:td {:class "bib"} "242"] [:td {} [:a {:href "/athletes/50953"} "Theresa Andrews"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "Breaststroke"] [:td {:class "bib"} "243"] [:td {} [:a {:href "/athletes/50983"} "Tracy Caulkins"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "Butterfly"] [:td {:class "bib"} "252"] [:td {} [:a {:href "/athletes/51118"} "Mary T. Meagher"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "Freestyle"] [:td {:class "bib"} "247"] [:td {} [:a {:href "/athletes/51059"} "Nancy Hogshead"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "Backstroke"] [:td {:class "bib"} "253"] [:td {} [:a {:href "/athletes/51126"} "Betsy Mitchell"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "Breaststroke"] [:td {:class "bib"} "255"] [:td {} [:a {:href "/athletes/51163"} "Susan Rapp"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :styl