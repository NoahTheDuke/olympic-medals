e "19000318"} "400 metres Individual Medley, Women"] "\n" [:option {:value "19000326"} "4 × 100 metres Medley Relay, Women"] "\n" [:option {:value "19000331"} "4 × 100 metres Medley Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "7457"} "1988"] "\n" [:option {:value "7814"} "1992"] "\n" [:option {:value "8160"} "1996"] "\n" [:option {:value "8550"} "2000"] "\n" [:option {:value "8940"} "2004"] "\n" [:option {:value "261674"} "2008"] "\n" [:option {:value "322320"} "2012"] "\n" [:option {:value "357170"} "2016"] "\n" [:option {:value "2001671"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/587"} "Event type"]] [:h1 {:class "event_title"} "50 metres Freestyle, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "30 July –  1 August 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2105"} "Olympic Aquatics Centre, 2-1, 2chome, Tatsumi, Koto-ku, Tatsumi-no-Mori Seaside Park, Tokyo, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19000164"} "81 from 73 countries"]]]]] [:div {:class "description"} [:p {} "As was now traditional the 50 metre freestyle was the last women’s individual swim race of the Tokyo 2020 Olympics. Denmark’s " [:a {:href "/athletes/123149"} "Pernille Blume"] " was the defending gold medallist and was back. Her biggest challengers were expected to be Australian sprinter " [:a {:href "/athletes/129061"} "Emma McKeon"] ", the 2017 World Champion " [:a {:href "/athletes/112272"} "Sarah Sjöström"] " of Sweden, and the Netherlands’ " [:a {:href "/athletes/112317"} "Ranomi Kromowidjojo"] ", who had won gold at London in 2012. " [:a {:href "/athletes/132163"} "Simone Manuel"] ", the 2016 100 freestyle gold medallist and 2019 World Champion in this event, was also back, but she would not make it out of the semi-finals."] "\n\n" [:p {} "For McKeon, the final day of swimming in Tokyo had big implications as she came into this event having already won five medals in 2020. She was likely a slight favorite as she had led both the heats and the semi-finals."] "\n\n" [:p {} "In the final McKeon had one of the slowest reaction times at 0.70, only leaving the blocks ahead of her teammate " [:a {:href "/athletes/112321"} "Cate Campbell"] ", who reacted in 0.76. However, she overcame that to win gold fairly comfortably (0.26 seconds) over Sjöström, with Blume taking bronze, as Kromo just missed the podium in fourth."] "\n\n" [:p {} "For McKeon this was her sixth medal of the Tokyo 2020 Olympics, a feat that only been done before by nine women, and by two other female swimmers – " [:a {:href "/athletes/47512"} "Kristin Otto"] " of the GDR (East Germany) in 1988 and " [:a {:href "/athletes/103301"} "Natalie Coughlin"] " of the USA in 2008. Less than an hour later McKeon would swim the butterfly leg as Australia won the women’s medley relay, giving her seven medals at Tokyo, matching the all-time women’s Olympic best in any sport, set by Soviet gymnast " [:a {:href "/athletes/29183"} "Mariya Gorokhovskaya"] " at Helsinki in 1952."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/129061"} "Emma McKeon"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]] [:td {} "24.02 (1 h10)"] [:td {} "24.00