alue "2012215"} "Team All-Around, Men"] "\n" [:option {:value "2012230"} "Floor Exercise, Men"] "\n" [:option {:value "2012233"} "Vault, Men"] "\n" [:option {:value "2012240"} "Parallel Bars, Men"] "\n" [:option {:value "2012243"} "Horizontal Bar, Men"] "\n" [:option {:value "2012246"} "Rings, Men"] "\n" [:option {:value "2012252"} "Individual All-Around, Women"] "\n" [:option {:value "2012263"} "Team All-Around, Women"] "\n" [:option {:value "2012274"} "Floor Exercise, Women"] "\n" [:option {:value "2012277"} "Vault, Women"] "\n" [:option {:value "2012284"} "Uneven Bars, Women"] "\n" [:option {:value "2012287"} "Balance Beam, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "70003"} "1896"] "\n" [:option {:value "70071"} "1924"] "\n" [:option {:value "70087"} "1928"] "\n" [:option {:value "70109"} "1932"] "\n" [:option {:value "70126"} "1936"] "\n" [:option {:value "70148"} "1948"] "\n" [:option {:value "70170"} "1952"] "\n" [:option {:value "70195"} "1956"] "\n" [:option {:value "70230"} "1960"] "\n" [:option {:value "70274"} "1964"] "\n" [:option {:value "70318"} "1968"] "\n" [:option {:value "70371"} "1972"] "\n" [:option {:value "70429"} "1976"] "\n" [:option {:value "70487"} "1980"] "\n" [:option {:value "70545"} "1984"] "\n" [:option {:value "70603"} "1988"] "\n" [:option {:value "70661"} "1992"] "\n" [:option {:value "70719"} "1996"] "\n" [:option {:value "70792"} "2000"] "\n" [:option {:value "70876"} "2004"] "\n" [:option {:value "259979"} "2008"] "\n" [:option {:value "313018"} "2012"] "\n" [:option {:value "353655"} "2016"] "\n" [:option {:value "19009149"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/322"} "Event type"]] [:h1 {:class "event_title"} "Pommelled Horse, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "27 July –  3 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2166"} "Bercy Arena, Bercy, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2012249"} "64 from 26 countries"]]]]] [:div {:class "description"} [:p {} "The men’s pommelled horse competition at the 2024 Paris Olympics featured a great line-up of pre-event favorites. Ireland’s " [:a {:href "/athletes/143904"} "Rhys McClenaghan"] " entered as the 2022 and 2023 World Champion, having placed seventh in Tokyo. Great Britain’s " [:a {:href "/athletes/123039"} "Max Whitlock"] ", the two-time defending Olympic champion, returned in hope of becoming the first male gymnast to medal at four consecutive Olympics. The 2021 World Champion, " [:a {:href "/athletes/152721"} "Stephen Nedoroscik"] ", was also present. The American became better known worldwide as “Pommel Horse Guy”, being successful in the event despite very poor vision, wearing Coke-bottle glasses, and a lack of depth perception. " [:a {:href "/athletes/152658"} "Ahmad Abu Al-Soud"] " was Jordan’s first ever Olympic gymnast, and with silver and bronze at the last two Worlds, he was also considered a medal threat."] "\n\n" [:p {} "Unfortunately for the Jordanian, he fell twice during qualifying and failed to make the final. First to go in the final was Kazakhstan’s " [:a {:href "/athletes/152669"} "Nariman Kurbanov"] ". A two-time Asian champion, he had not yet medaled in a global tournament but had been fourth at the 2021 and 2022 World Championships. His 15.433 was much higher than any of the qualifying scores, and most of the finalists would not surpass it. Whitlock, starting second, had the highest difficulty at 6.9, but could not convert that into a medal score, eventually settling for fourth. McClenaghan then posted a personal top score of 15.533 to take the top position, followed by Nedoroscik, who pushed Whitlock off the podium."] "\n\n" [:p {} "Both gold and silver medalists won the first ever Olympic gymnastics medals for their countries, Ireland and Kazakhstan respectively. Whitlock’s narrow miss of the podium marked the first time since 2008 that Britain did not medal in this event."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/143904"} "Rhys McClenaghan"]] [:td {} [:a {:href "/countries/IRL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/IRL.png"}] "IRL"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/152669"} "Nariman Kurbanov"]] [:td {} [:a {:href "/countries/KAZ"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KAZ.png"}] "KAZ"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/152721"} "Stephen Nedoroscik"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/123039"} "Max Whitlock"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {} [:a {:href "/athletes/121658"} "Oleh Verniaiev"]] [:td {} [:a {: