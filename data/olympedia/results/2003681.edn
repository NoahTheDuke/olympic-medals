e "2003682"} "Road Race, Individual, Women"] "\n" [:option {:value "2003683"} "Individual Time Trial, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "154879"} "1996"] "\n" [:option {:value "155008"} "2000"] "\n" [:option {:value "155136"} "2004"] "\n" [:option {:value "258959"} "2008"] "\n" [:option {:value "308003"} "2012"] "\n" [:option {:value "356741"} "2016"] "\n" [:option {:value "19001701"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/213"} "Event type"]] [:h1 {:class "event_title"} "Individual Time Trial, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "27 July 2024 — 16:32"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2171"} "Trocadéro (Pont d'Iéna), Paris, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2003681"} "34 from 27 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Distance: 32.4 km" [:br {}] "Intermediate 1: 13.1 km" [:br {}] "Intermediate 2: 22 km"]]]] [:div {:class "description"} [:p {} "The time trial race started and finished on the Pont d’Iéna bridge that spans the River Seine. The 32.4-kilometre course consisted of one loop of Paris and the surrounding areas. The 34 riders started the race, which took place in hazardous conditions on rain-soaked streets."] "\n\n" [:p {} "None of the three medalists from the Tokyo Games were on the start line in Paris. Defending champion Slovenia’s " [:a {:href "/athletes/135863"} "Primož Roglič"] " was ruled out after suffering a crash on stage 12 of the Tour de France just a few weeks before the Olympics. Silver medalist " [:a {:href "/athletes/135249"} "Tom Dumoulin"] " had retired at the end of the 2022 season, and the career of the Australian bronze medalist " [:a {:href "/athletes/123794"} "Rohan Dennis"] " was all but over following his involvement in a fatal road crash in Australia in December 2023. The favorites emerged as the Belgian duo of " [:a {:href "/athletes/141007"} "Remco Evenepoel"] " and " [:a {:href "/athletes/141009"} "Wout Van Aert"] ", time trial specialist and hour record holder " [:a {:href "/athletes/136635"} "Filippo Ganna"] " (ITA), and the up-and-coming " [:a {:href "/athletes/151515"} "Josh Tarling"] " (GBR)."] "\n\n" [:p {} "The podium featured the two Belgians, with Evenepoel winning his first gold of the Olympics, and the first gold by a Belgian cyclist in the Olympic time trial. Ganna was 13 seconds behind Evenepoel to take silver, with Van Aert coming third to win bronze. Josh Tarling finished fourth, just over 27 seconds behind the winning time, but suffered with a puncture during the race, costing him between 15 and 20 seconds, and therefore a medal. The tricky race conditions resulted in two riders not finishing the course, " [:a {:href "/athletes/151618"} "Søren Wærenskjold"] " (NOR) and " [:a {:href "/athletes/140750"} "Luke Plapp"] " (AUS), with Plapp taken to the hospital to undergo surgery following a heavy crash into a barrier."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Intermediate 1"] [:th {} "Intermediate 2"] [:th {} "Split 1-2"] [:th {} "Split 2-Finish"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/141007"} "Remco Evenepoel"]] [:td {} [:a {:href "/countries/BEL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BEL.png"}] "BEL"]] [:td {} "3