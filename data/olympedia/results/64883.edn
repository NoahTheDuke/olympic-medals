64204"} "1992"] "\n" [:option {:value "65542"} "2000"] "\n" [:option {:value "66222"} "2004"] "\n" [:option {:value "257355"} "2008"] "\n" [:option {:value "302004"} "2012"] "\n" [:option {:value "358771"} "2016"] "\n" [:option {:value "19000526"} "2020"] "\n" [:option {:value "2013683"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/80"} "Event type"]] [:h1 {:class "event_title"} "Shot Put, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "26 July 1996"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/711"} "Centennial Olympic Stadium, Atlanta, Georgia"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/64883"} "36 from 24 countries"]]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/78076"} "Randy Barnes"] " had set the world record of 23.12 (75-10¼) in 1990 and had the year’s best throw of 22.40 (73-6), and was favored. But he struggled in the final. He opened with only 19.46 (63-10¼), as " [:a {:href "/athletes/77121"} "Oleksandr Bahach"] " (UKR) led the first round with 20.41 (66-11½). Barnes got 20.44 (67-0¾) in round two, but the lead was taken by Italy’s " [:a {:href "/athletes/71933"} "Paolo Dal Soglio"] " with 20.65 (67-9), and Bagach improved to 20.50 (67-3¼). American " [:a {:href "/athletes/78457"} "John Godina"] " came thru in the fourth and fifth rounds with 20.64 (67-8¾) and 20.79 (68-2½), to move into the lead in round five. Barnes was only in fourth place heading into the final round, but he produced – tossing the shot 21.62 (70-11¼) for the gold medal. Bagach also improved, bumping Dal Soglio out of the medals with 20.75 (68-1). In May 1990, Barnes had tested positive for methyltestosterone and was banned for two years. In April 1998, he tested positive for androstenedione and was banned for life. The life ban was controversial as androstenedione was an over-the-counter supplement in the United States and was not a banned drug internationally until a few months before Barnes’s positive test. He readily admitted taking it, not knowing it was banned. It was the same drug taken by major league home run king Mark McGwire, who also admitted to taking it. Bronze medalist Bagach also was subsequently banned for life. He had tested positive in 1989 for testosterone, tested positive for ephedrine in 1997 at the World Championships, and was banned for life in 2000 after a positive doping test for anabolic steroids."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "2329"] [:td {} [:a {:href "/athletes/78076"} "Randy Barnes"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "20.42 (4)"] [:td {} "21.62 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "2353"] [:td {} [:a {:href "/athletes/78457"} "John Godina"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "20.54 (2)"] [:td {} "20.79 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "2302"] [:td {} [:a {:href "/athletes/77121"} "Oleksandr Bahach"]] [:td {} [:a {:href "/countries/UKR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UKR.png"}] "UKR"]] [:td {} "20.23 (5)"] [:td {} "20.75 (3)"] [:td {} [:span {:class "Bronze"} "Br