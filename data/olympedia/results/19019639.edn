"19019631"} "12.5 kilometres Pursuit, Men"] "\n" [:option {:value "19019632"} "15 kilometres Mass Start, Men"] "\n" [:option {:value "19019633"} "20 kilometres, Men"] "\n" [:option {:value "19019634"} "4 × 7.5 kilometres Relay, Men"] "\n" [:option {:value "19019635"} "7.5 kilometres Sprint, Women"] "\n" [:option {:value "19019636"} "10 kilometres Pursuit, Women"] "\n" [:option {:value "19019637"} "12.5 kilometres Mass Start, Women"] "\n" [:option {:value "19019638"} "15 kilometres, Women"] "\n" [:option {:value "19019640"} "4 × 6 kilometres Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1611"} "2006"] "\n" [:option {:value "923496"} "2010"] "\n" [:option {:value "350031"} "2014"] "\n" [:option {:value "9000229"} "2018"] "\n" [:option {:value "15000039"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/138"} "Event type"]] [:h1 {:class "event_title"} "4 × 6 kilometres Relay, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "16 February 2022 — 15:45"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2138"} "Zhangjiakou Nordic Centre and Biathlon Centre, Chongli District, Zhangjiakou City, Hebei Province"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19019639"} "80 from 20 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Eight shots for each group of five targets. Penalty loop (150 metres) skied for each missed target, with three extra shots allowed to obtain 5 target hits."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 6,228 m" [:br {}] "Height Differential: 35 m" [:br {}] "Maximum Climb: 20 m" [:br {}] "Shooting 1: Prone at 1.864 km, 50 m range" [:br {}] "Shooting 2: Standing at 3.993 km, 50 m range" [:br {}] "Total Climbing: 216 m"]]]] [:div {:class "description"} [:p {} "After a silver medal in 2018, Sweden won its second medal in the women’s biathlon relay by taking gold. Three members of their team competed in PyeongChang: " [:a {:href "/athletes/138150"} "Linn Persson"] ", " [:a {:href "/athletes/138147"} "Mona Brorsson"] ", and " [:a {:href "/athletes/138149"} "Hanna Öberg"] ". The team was completed with Hanna’s younger sister " [:a {:href "/athletes/148988"} "Elvira Öberg"] ". The ROC team took the silver medal with Germany taking the bronze."] "\n\n" [:p {} "The first German runner, " [:a {:href "/athletes/148390"} "Vanessa Voigt"] ", did a good job and gave a courageous performance in what was her first World Cup season and Winter Olympics début. Voigt handed over as the leader, ahead of Sweden (0.5 seconds) and Italy (1.5 seconds). On the second leg, " [:a {:href "/athletes/137247"} "Vanessa Hinz"] " had to reload twice for the last shot of the standing shooting and dropped to fourth place. " [:a {:href "/athletes/148767"} "Kristina Reztsova"] " was first at the second exchange for the ROC with Italy’s " [:a {:href "/athletes/127919"} "Dorothea Wierer"] " in second place."] "\n\n" [:p {} "Despite reloading four times, Hanna Öberg took the lead on the third leg. Italy’s youngest competitor, " [:a {:href "/athletes/2301512"} "Samuela Comola"] ", held on to second place. " [:a {:href "/athletes/148766"} "Svetlana Mironova"] " had to go a penalty loop and dropped to third place. Germany started in fourth place, 45.9 seconds behind. " [:a {:href "/athletes/127806"} "Franziska Preuß"] ", who could not compete for about two months prior to the Games due to an injury and COVID-19 infection, maintained their fourth place."] "\n\n" [:p {} "Elvira Öberg started the anchor leg with a lead of 26 seconds, and the Swede secured the gold medal, reloading just once in the final standing shooting. " [:a {:href "/athletes/137383"} "Federica Sanfilippo"] " for Italy lost almost 90 seconds to the top teams and fell out of the medal ranking, finishing fifth. " [:a {:href "/athletes/137781"} "Uliana Nigmatullina"] " had to reload just once, and took silver for the ROC. Olympic champion " [:a {:href "/athletes/127819"} "Denise Herrmann"] ", Germany’s final runner, could never close the gap but was happy with bronze."] "\n\n" [:p {} "Heavy favourites Norway lost all chances early in the race, when their second runner, " [:a {:href "/athletes/128184"} "Tiril Eckhoff"] " had to go two penalty loops and added 1:40 to Norway’s deficit, which was too much for the last two competitors to claw back."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Misses"] [:th {} "Extra Shots"] [:th {} "Shooting 1 Misses"] [:th {} "Shooting 1 Extra Shots"] [:th {} "Shooting 1"] [:th {} "Shooting 2 Misses"] [:th {} "Shooting 2 Extra Shots"] [:th {} "Shooting 2"] [:th {} "Exchange"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Sweden"] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "1-11:03.9"] [:td {} "0"] [:td {} "6"] [:td {}] [:td {}] [:td {} "– (–)"] [:td {}] [:td {}] [:td {} "– (–)"] [:td {} "– (–)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/138150"} "Linn Perrson"] " "] [:td {}] [:td {} "17:24.9"] [:td {} "0"] [:td {} "1"] [:td {} "0"] [:td {} "0"] [:td {} "6:05.2 (3)"] [:td {} "0"] [:td {} "1"] [:td {} "12:17.9 (1)"] [:td {} "17:24.9 (2)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/138147"} "M