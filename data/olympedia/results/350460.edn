n {:value "350452"} "Large Hill, Individual, Men"] "\n" [:option {:value "350457"} "Large Hill, Team, Men"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "9000823"} "2018"] "\n" [:option {:value "19020643"} "2022"] "\n" [:option {:value "15001066"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/1008"} "Event type"]] [:h1 {:class "event_title"} "Normal Hill, Individual, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "11 February 2014"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/892"} "Kompleks Dlya Pryzhkov Na Lyzhakh s Tramplina &quot;Russkiye Gorki&quot;, Mountain Cluster, Esto-Sadok"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/350460"} "30 from 12 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Two jumps, with both scored on distance and form."]] [:tr {:class "referees", :style ""} [:th {} "Judge #1"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004484"} "Stefan Thoma"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #2"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003841"} "Ole Walseth"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #3"] [:td {:style "width: 400px"} [:a {:href "/athletes/5001613"} "Christian Würsten"]] [:td {} [:a {:href "/countries/SUI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SUI.png"}] "SUI"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #4"] [:td {:style "width: 400px"} [:a {:href "/athletes/87740"} "Yury Kalinin"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #5"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002494"} "Hermann Kothleitner"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "K-Point: 95 m"]]]] [:div {:class "description"} [:p {} "Women’s ski-jumping finally found its place on the Olympic program, albeit with just one event on the normal hill. Japan’s " [:a {:href "/athletes/128017"} "Sara Takanashi"] " was considered the favorite, but after the first round she was only ranked third with a jump of 100.0 m. The surprise leader was German " [:a {:href "/athletes/127863"} "Carina Vogt"] " with the longest jump of 103.0 m followed by France’s " [:a {:href "/athletes/127760"} "Coline Mattel"] ". Even though she was second in the season’s World Cup standings, the 22-year-old German had never won a World Cup event, but nine podiums indicated her ability."] "\n\n" [:p {} "Going in reverse order, Austrian " [:a {:href "/athletes/127376"} "Daniela Iraschko-Stolz"] ", who was fifth after the first round with a jump of 98.5 m, landed a wind-assisted jump of 104.5 m, the longest of the competition, taking the lead with just four jumpers remaining. The next jumper – Italian " [:a {:href "/athletes/127951"} "Evelyn Insam"] " – failed to surpass her score as did Takanashi, who missed the podium. Her second jump of 98.5 m left her in fourth place, after 19 consecutive World Cup podiums prior to the Games and 10 wins in 13 events this season."] "\n\n" [:p {} "Mattel, ranked second after the first round, managed only 97.5 m, but her style points gave her a combined score of 245.2 points to win the bronze medal. Carina Vogt, jumping last, could only equal Mattel’s distance, but her combined score of 247.4 was just enough to win the gold medal and to become the first ever women’s Olympic champion in ski jumping. Although Vogt’s second jump was 7.0 m short of the Austrian’s, superior style marks, her telemark landing and wind compensation points gave her the victory, beating Iraschko-Stolz by 1.2 points, with bronze medalist Mattel only point further back."] "\n\n" [:p {} "Besides a disappointed Takanashi, reigning American world champion " [:a {:href "/athletes/128759"} "Sarah Hendrickson"] " also fell far short of her best performance finishing only 21st after returning from a knee injury."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Jump #1"] [:th {} "Jump #2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/127863"} "Carina Vogt"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "247.4"] [:td {} "126.8 (1)"] [:td {} "120.6 (5)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/127376"} "Daniela Iraschko-Stolz"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]] [:td {} "246.2"] [:td {} "120.2 (5)"] [:td {} "126.0 (1)"] [:td {} [:span {:class "Silver"} "Si