 metres Freestyle, Men"] "\n" [:option {:value "4630"} "4 × 200 metres Freestyle Relay, Men"] "\n" [:option {:value "4596"} "100 metres Backstroke, Men"] "\n" [:option {:value "4607"} "200 metres Breaststroke, Men"] "\n" [:option {:value "4619"} "400 metres Breaststroke, Men"] "\n" [:option {:value "4636"} "100 metres Freestyle, Women"] "\n" [:option {:value "4648"} "4 × 100 metres Freestyle Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "4509"} "1908"] "\n" [:option {:value "4673"} "1920"] "\n" [:option {:value "4752"} "1924"] "\n" [:option {:value "4855"} "1928"] "\n" [:option {:value "4957"} "1932"] "\n" [:option {:value "5049"} "1936"] "\n" [:option {:value "5157"} "1948"] "\n" [:option {:value "5273"} "1952"] "\n" [:option {:value "5398"} "1956"] "\n" [:option {:value "5512"} "1960"] "\n" [:option {:value "5680"} "1964"] "\n" [:option {:value "5887"} "1968"] "\n" [:option {:value "6204"} "1972"] "\n" [:option {:value "6505"} "1976"] "\n" [:option {:value "6773"} "1980"] "\n" [:option {:value "6995"} "1984"] "\n" [:option {:value "7308"} "1988"] "\n" [:option {:value "7664"} "1992"] "\n" [:option {:value "8015"} "1996"] "\n" [:option {:value "8390"} "2000"] "\n" [:option {:value "8795"} "2004"] "\n" [:option {:value "261524"} "2008"] "\n" [:option {:value "322337"} "2012"] "\n" [:option {:value "357035"} "2016"] "\n" [:option {:value "19000054"} "2020"] "\n" [:option {:value "2001559"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/563"} "Event type"]] [:h1 {:class "event_title"} "1,500 metres Freestyle, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "6 – 10 July 1912"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/238"} "Simstadion, Djurgårdsbrunnsviken, Stockholm"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/4585"} "19 from 11 countries"]]]]] [:div {:class "description"} [:p {} "The defending champion was Britain’s " [:a {:href "/athletes/47414"} "Henry Taylor"] ", who also held the world record of 22:48.4, which he had set at London in winning the " [:a {:href "/results/4509"} "1908 Olympic championship"] ".  Taylor had won the ASA mile championship in 1911, but in 1912 he would be defeated by " [:a {:href "/athletes/47282"} "Jack Hatfield"] ", a month after the Olympics, and he would also win that title in 1913-14.  Hatfield had to know he would have a difficult time when Canada’s " [:a {:href "/athletes/45966"} "George Hodgson"] " broke Taylor’s world record in the first round, posting a time of 22:23.0."] "\n\n" [:p {} "In the final, Hatfield was no match for Hodgson.  Hodgson took off at a brisk pace, leading Australia’s " [:a {:href "/athletes/45212"} "Harold Hardwick"] " by 10 metres at the first turn (100 metres).  By 500 metres, he held a 25 metre lead over Hatfield.  Hodgson passed 1,000 metres in 14:37.0, a world record for that distance.  After winning the race in 22:00.0, Hodgson continued on, in an attempt to set a new world record for the mile (1,609 metres), which he did with a time of 23:34.5.  Hodgson’s world record for 1,500 metres lasted for 11 years, until it was broken by " [:a {:href "/athletes/50360"} "Arne Borg"] " (SWE), with a time of 21:35.3 at Göteborg, on 8 July 1923.  In addition to his gold medal, Hodgson also earned possession of the Challenge Trophy for the 1,500 metre freestyle event, which had been donated in 1908 by the Italian Count and IOC Member " [:a {:href "/athletes/899048"} "Eugenio Brunetta d’Usseaux"] "."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Po