option {:value "255240"} "Kayak Doubles, 1,000 metres, Men"] "\n" [:option {:value "255264"} "Canadian Singles, 1,000 metres, Men"] "\n" [:option {:value "255270"} "Canadian Doubles, 1,000 metres, Men"] "\n" [:option {:value "255276"} "Kayak Singles, 500 metres, Women"] "\n" [:option {:value "255282"} "Kayak Doubles, 500 metres, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255315"} "1968"] "\n" [:option {:value "255380"} "1972"] "\n" [:option {:value "255496"} "1976"] "\n" [:option {:value "255633"} "1980"] "\n" [:option {:value "255727"} "1984"] "\n" [:option {:value "255835"} "1988"] "\n" [:option {:value "255981"} "1992"] "\n" [:option {:value "256116"} "1996"] "\n" [:option {:value "256241"} "2000"] "\n" [:option {:value "256352"} "2004"] "\n" [:option {:value "258777"} "2008"] "\n" [:option {:value "307087"} "2012"] "\n" [:option {:value "353492"} "2016"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/165"} "Event type"]] [:h1 {:class "event_title"} "Kayak Fours, 1,000 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "20 – 22 October 1964"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/450"} "Sagami-ko, Sagamihara, Kanagawa"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/255252"} "56 from 14 countries"]]]]] [:div {:class "description"} [:p {} "The men’s K-4 1000 made its Olympic début at the 1964 Games, replacing the kayak relay, 4 x 500 metres, from the previous edition, although it had been held at the World Championships since the tournament’s inception in 1938. Two of the champions from that event, Germany’s " [:a {:href "/athletes/9960"} "Günter Perleberg"] " and " [:a {:href "/athletes/9996"} "Friedhelm Wentzke"] ", were present in Tokyo for this one. East Germany, Romania, and the Soviet Union had finished in that order at the most recent European and World Championships, while the order had been East Germany, the Soviet Union, and Hungary at the 1961 Europeans. It was Romania, the Soviet Union, and Hungary, however, who met in the first heat of the opening round and finished in that order, while a unified Germany captured the other heat. Germany and Hungary were paired together in the semi-finals, which the former won by a significant margin, while the Soviets and the Romanians took the other heats. The final was a close affair, as expected, with only a second separating the first three finishers, the Soviet Union, Germany, and Romania. Hungary was a less than a second behind them in fourth. Romania’s " [:a {:href "/athletes/10627"} "Aurel Vernescu"] " also took bronze in the K-1 1000, while Germany’s " [:a {:href "/athletes/10003"} "Holger Zander"] " captured bronze in the K-2 1000."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Rep"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "Soviet Union"] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "3:18.24 (2 h1)"] [:td {} "–"] [:td {} "3:24.26 (1 h3)"] [:td {} "3:14.67 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Best"} "OB"]]] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "12"} [:a {:href "/athletes/11020"} "Nikolay Chuzhikov"] " • " [:a {:h