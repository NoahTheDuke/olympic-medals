e "313000"} "Team All-Around, Men"] "\n" [:option {:value "313012"} "Floor Exercise, Men"] "\n" [:option {:value "313024"} "Vault, Men"] "\n" [:option {:value "313027"} "Parallel Bars, Men"] "\n" [:option {:value "313021"} "Rings, Men"] "\n" [:option {:value "313018"} "Pommelled Horse, Men"] "\n" [:option {:value "313009"} "Individual All-Around, Women"] "\n" [:option {:value "313003"} "Team All-Around, Women"] "\n" [:option {:value "313033"} "Floor Exercise, Women"] "\n" [:option {:value "313015"} "Vault, Women"] "\n" [:option {:value "313039"} "Uneven Bars, Women"] "\n" [:option {:value "313036"} "Balance Beam, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "9009278"} "1875"] "\n" [:option {:value "70005"} "1896"] "\n" [:option {:value "70029"} "1904"] "\n" [:option {:value "926065"} "1904"] "\n" [:option {:value "70069"} "1924"] "\n" [:option {:value "70085"} "1928"] "\n" [:option {:value "70107"} "1932"] "\n" [:option {:value "70124"} "1936"] "\n" [:option {:value "70146"} "1948"] "\n" [:option {:value "70168"} "1952"] "\n" [:option {:value "70193"} "1956"] "\n" [:option {:value "70224"} "1960"] "\n" [:option {:value "70268"} "1964"] "\n" [:option {:value "70312"} "1968"] "\n" [:option {:value "70367"} "1972"] "\n" [:option {:value "70425"} "1976"] "\n" [:option {:value "70483"} "1980"] "\n" [:option {:value "70541"} "1984"] "\n" [:option {:value "70599"} "1988"] "\n" [:option {:value "70657"} "1992"] "\n" [:option {:value "70715"} "1996"] "\n" [:option {:value "70788"} "2000"] "\n" [:option {:value "70872"} "2004"] "\n" [:option {:value "259973"} "2008"] "\n" [:option {:value "353649"} "2016"] "\n" [:option {:value "19009143"} "2020"] "\n" [:option {:value "2012243"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/319"} "Event type"]] [:h1 {:class "event_title"} "Horizontal Bar, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "28 July –  7 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/872"} "North Greenwich Arena, Greenwich, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/313030"} "70 from 33 countries"]]]]] [:div {:class "description"} [:p {} "Going into the men’s horizontal bar event at the 2012 Summer Olympics, " [:a {:href "/athletes/111922"} "Zou Kai"] " of China already had five Olympic gold medals: three from 2008 in the team, floor exercise, and horizontal bar competitions and two from 2012 in the team and floor exercise categories. He was also the 2009 and 2011 World Champion in the horizontal bar, but would not go unchallenged in his quest for a sixth Olympic gold medal. His compatriot " [:a {:href "/athletes/122116"} "Zhang Chenglong"] ", World Champion in 2010, was also competing, as was " [:a {:href "/athletes/120452"} "Emin Garibov"] " of Russia, the reigning European Champion, and " [:a {:href "/athletes/111970"} "Epke Zonderland"] " of the Netherlands, the 2011 European Champion and world runner-up in 2009 and 2010. Zonderland had also appeared in the finals of the 2008 Olympics, the first Dutch man to appear at the Games since 1928."] "\n\n" [:p {} "In the qualification round, Zonderland came out on top, with Zhang close behind and " [:a {:href "/athletes/126655"} "Danell Leyva"] " of the United States, the 2011 World Champion in parallel bars and the bronze medalist in the London Olympic individual all-around, in third. Garbov and Zou finished further down, in sixth and seventh respectively, but still survived to the finals. In the finals Zou went fourth with the highest difficulty routine of the event, 7.900. His excellent performance of 16.366 set the bar, knocking his teammate Zhang, with a score of 16.266, into second. " [:a {:href "/athletes/107249"} "Fabian Hambüchen"] " of Germany, 2007 World Champion, three time European Champion (2005, 2007, 2008), and bronze medalist at the 2008 Olympic Games, managed to pass Zou’s point total with a less difficult routine, but a much better execution score, the highest of the night. He did not stay long on the top of the podium, however, as Zonderland went next with an outstanding performance that ranked as difficult as Zou’s, but with better execution. Zonderland’s routine included three successive difficult flight elements, Cassica-Kovacs-Kolman, and he became the first person to successfully perform them, having attempted (and failed) at the 2012 European Championships. The final two gymnasts had no answer for this and Zonderland became the Netherlands’ first Olympic champion in gymnastics since the women’s all-around team in 1928, the only other time the nation had medalled in the sport. Hambüchen took home silver and Zou, after being crowned Olympic champion five times, settled for bronze."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "243"] [:td {} [:a {:href "/athletes/111970"} "Epke Zonderland"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "142"] [:td {} [:a {:href "/athletes/107249"} "Fabian Hambüchen"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GE