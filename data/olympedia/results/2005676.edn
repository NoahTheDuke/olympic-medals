lue "2005798"} "Doubles, Women"] "\n" [:option {:value "2005839"} "Doubles, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "900331"} "1972"] "\n" [:option {:value "90016749"} "1988"] "\n" [:option {:value "42070"} "1992"] "\n" [:option {:value "42285"} "1996"] "\n" [:option {:value "42541"} "2000"] "\n" [:option {:value "42764"} "2004"] "\n" [:option {:value "258136"} "2008"] "\n" [:option {:value "304070"} "2012"] "\n" [:option {:value "351630"} "2016"] "\n" [:option {:value "19005277"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/124"} "Event type"]] [:h1 {:class "event_title"} "Doubles, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "27 July –  4 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2159"} "Porte de la Chapelle Arena, Paris, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2005676"} "34 from 15 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament."]]]] [:div {:class "description"} [:p {} "The group stages largely went to form, the only surprise being the defeat of number two seeds " [:a {:href "/athletes/142160"} "Kim Astrup"] " and " [:a {:href "/athletes/142159"} "Anders Skaarup Rasmussen"] " (DEN) to " [:a {:href "/athletes/146852"} "Lee Yang"] " and " [:a {:href "/athletes/146853"} "Wang Chi-Lin"] " (TPE) by 21-15, 19-21, 21-15, although Lee and Wang were current Olympic champions. Both doubles pairs advanced to the quarter-finals, with the Danes being the only double not from an Asian nation."] "\n\n" [:p {} "The unseeded " [:a {:href "/athletes/145202"} "Aaron Chia"] " and " [:a {:href "/athletes/145204"} "Soh Wooi Yik"] " (MAS) then progressed to the semi-finals with a hard fought victory over number three seeds " [:a {:href "/athletes/143762"} "Satwiksairaj Rankireddy"] " and " [:a {:href "/athletes/143761"} "Chirag Shetty"] " (IND), winning 13-21, 21-14, 21-16. The remaining quarter-finals went to form, with top-seeded " [:a {:href "/athletes/150920"} "Liang Weikeng"] " and " [:a {:href "/athletes/150922"} "Wang Chang"] " (CHN) overcoming " [:a {:href "/athletes/150937"} "Fajar Alfian"] " and " [:a {:href "/athletes/150938"} "Muhammad Rian Ardianto"] " in a hard fought match 24-22, 22-20. Astrup and Rasmussen then defeated fourth-seeded " [:a {:href "/athletes/150950"} "Gang Min-Hyeok"] " and " [:a {:href "/athletes/2103818"} "Seo Seung-Jae"] " (KOR) 21-19, 22-20 to set up a re-match with the unseeded Lee and Wang, who advanced by beating " [:a {:href "/athletes/150967"} "Supak Jomkoh"] " and " [:a {:href "/athletes/150966"} "Kittinupong Kedren"] " (THA) by 21-14, 21-17."] "\n\n" [:p {} "The semi-finals were keenly fought, the Chinese Liang and Wang defeating the unseeded pair of Chia and Soh by 21-19, 15-21, 21-17. The other semi-final was a repeat of their group match, with the same outcome as the unseeded Lee and Wang defeating the Danes Astrup and Rasmussen by a score of 18-21, 21-17, 21-10."] "\n\n" [:p {} "There was a reward for the unseeded Malaysians Chia and Soh, as they won a close encounter against Astrup and Rasmussen, winning the bronze medal with the score being 16-21, 22-20, 21-19, in a match lasting well over an hour. The final was just as enthralling, with the reigning champions Lee and Wang finally overcoming Liang and Wang by 21-17, 18-21, 21-19."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {