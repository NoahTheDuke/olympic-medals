02"} "Two Person Dinghy (470), Men"] "\n" [:option {:value "10786"} "One Person Dinghy (Laser), Open"] "\n" [:option {:value "10807"} "Two Person Keelboat (Star), Open"] "\n" [:option {:value "10849"} "Skiff (49er), Open"] "\n" [:option {:value "10828"} "Multihull (Tornado), Open"] "\n" [:option {:value "10880"} "Three Person Keelboat (Soling), Open"] "\n" [:option {:value "10744"} "Windsurfer (Mistral), Women"] "\n" [:option {:value "10723"} "One Person Dinghy (Europe), Women"] "\n" [:option {:value "10765"} "Two Person Dinghy (470), Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "10288"} "1992"] "\n" [:option {:value "10452"} "1996"] "\n" [:option {:value "10949"} "2004"] "\n" [:option {:value "261311"} "2008"] "\n" [:option {:value "320042"} "2012"] "\n" [:option {:value "356085"} "2016"] "\n" [:option {:value "19008725"} "2020"] "\n" [:option {:value "2012701"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/405"} "Event type"]] [:h1 {:class "event_title"} "One Person Dinghy (Finn), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "23 – 30 September 2000"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/768"} "Rushcutters Bay Marina, Rose Bay, New South Wales"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/10660"} "25 from 25 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Points awarded for placement in each race.  Best nine of eleven scores to count for final placement."]]]] [:div {:class "description"} [:p {} "The favorite was Britain’s " [:a {:href "/athletes/92835"} "Iain Percy"] " who had won the 1999 European Championships and the pre-Olympic regatta on the Olympic course. He moved into the lead after placing second in the first race and first in the second. After nine races he had a moderate lead over Sweden’s " [:a {:href "/athletes/62852"} "Fredrik Lööf"] ", and he frustrated him in race 10 by staying in front of him and blocking his wind. Percy eventually finished 14th in that race, but when Loof finished in 10th, that clinched the gold medal for Percy, and he sat out the last race. Loof dropped back into a tie for second with Italian " [:a {:href "/athletes/61833"} "Luca Devoti"] ", who defeated Lööf in the final race to win the silver medal."] "\n\n" [:p {} "Defending champion " [:a {:href "/athletes/62679"} "Mateusz Kusznierewicz"] " of Poland finished in fourth place, but would come back in 2004 and return to the podium with a bronze medal. Percy later switched to the Star class, winning Olympic gold in that class in 2008 and silver in 2012. He also won two World Championships in Star, and seven medals in all from 2002-12. Lööf also switched to the Star class, winning Olympic bronze in 2008 and gold in 2012."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Net Points"] [:th {} "Total Points"] [:th {} "Race #1"] [:th {} "Race #2"] [:th {} "Race #3"] [:th {} "Race #4"] [:th {} "Race #5"] [:th {} "Race #6"] [:th {} "Race #7"] [:th {} "Race #8"] [:th {} "Race #9"] [:th {} "Race #10"] [:th {} "Race #11"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/92835"} "Iain Percy"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {} "35.0"] [:td {} "75.0"] [:td {} "2.0 (2)"] [:td {} "1.0 (1)"] [:td {} "9.0 (9)"] [:td {} "2.0 (2)"] [:td {} "5.0 (5)"] [:td {} "