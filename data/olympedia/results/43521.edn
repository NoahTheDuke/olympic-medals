nd French IOC Member and Minister of Sports, Guy Drut, forbade from using their original routine."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Technical Routine"] [:th {} "Free Routine"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "99.720"] [:td {} "99.200 (1)"] [:td {} "100.000 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "11"} [:a {:href "/athletes/50966"} "Suzannah Bianco"] " • " [:a {:href "/athletes/50987"} "Tammy Cleland"] " • " [:a {:href "/athletes/51009"} "Becky Dyroen-Lancer"] " • " [:a {:href "/athletes/51099"} "Emily LeSueur"] " • " [:a {:href "/athletes/51148"} "Heather Pease"] " • " [:a {:href "/athletes/51178"} "Jill Savery"] " • " [:a {:href "/athletes/51180"} "Nathalie Schneyder"] " • " [:a {:href "/athletes/51194"} "Heather Simmons-Carrasco"] " • " [:a {:href "/athletes/51210"} "Jill Sudduth"] " • " [:a {:href "/athletes/51216"} "Margot Thien"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Canada"] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {} "98.367"] [:td {} "97.933 (2)"] [:td {} "98.600 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "11"} [:a {:href "/athletes/45821"} "Christine Larsen"] " • " [:a {:href "/athletes/45764"} "Karen Clark"] " • " [:a {:href "/athletes/45788"} "Sylvie Fréchette"] " • " [:a {:href "/athletes/45757"} "Janice Bremner"] " • " [:a {:href "/athletes/45787"} "Karen Fonteyne"] " • " [:a {:href "/at