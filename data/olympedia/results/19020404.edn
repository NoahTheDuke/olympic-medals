34"} "Event type"]] [:h1 {:class "event_title"} "10,000 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "11 February 2022 — 16:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2140"} "National Speed Skating Oval, Olympic Green, Beijing"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19020404"} "12 from 9 countries"]]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/9001031"} "12:39.77"] " / " [:a {:href "/athletes/136922"} "Ted-Jan Bloemen"] " " [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"] " / 15 February 2018 / " [:a {:href "/records/event_name/534"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/1805307"} "Hanjo Heideman"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/1805310"} "Yuliya Mitrofanova"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]]]]] [:div {:class "description"} [:p {} "After his impressive win in the 5,000 m, " [:a {:href "/athletes/138219"} "Nils van der Poel"] " had stirred up controversy in the speed skating world. Following a publication of an article about Dutch scientists conferring and perhaps influencing the ice maker for the National Speed Skating Oval, the Swedish skater had staged a press conference in which he accused the Dutch of trying to manipulate the sport. All parties – including ice maker Mark Messer (CAN) – denied any actual manipulation, and the race got underway without any formal protests or other impact."] "\n\n" [:p {} "As in the 5,000 m, " [:a {:href "/athletes/137696"} "Patrick Roest"] " was the first favorite on the ice. Although his personal best of 12:35 had come at a similar rink, conditions and form forced Roest to a slightly slower schedule, which saw him end up at 12:44.59. That time was enough to survive the next two pairs, including the second Dutch skater, 2014 champion " [:a {:href "/athletes/128171"} "Jorrit Bergsma"] ", who ended in 12:48.94."] "\n\n" [:p {} "Nils van der Poel seemed unimpressed by these times. As in the 5,000 m, he went off on a very steady schedule, recording a slowest lap of 30.38 (lap three) and speeding up to a final lap of 28.60. With these lap times, he handsomely defeated Roest again, but also bettered his own world record, which he had set at the 2021 World Championships. Behind the Swede, his pair mate " [:a {:href "/athletes/137427"} "Davide Ghiotto"] " became the surprise of the race. After tagging along Van der Poel for a few laps, he settled into a pace that brought him to 12:45.98, enough for a bronze medal – the second in a row for Italy after " [:a {:href "/athletes/137429"} "Nicola Tumolero"] " in 2018."] "\n\n" [:p {} "As he had already hinted at earlier, van der Poel announced his retirement from the sport after his second gold, although he hinted that he had tried to retire twice before and had failed. Remarkably, he also published a website that detailed his training methods as well as his training schedule since 2019."] "\n"] [:button {:id "button767105", :class "btn btn-default"} "Details"] [:script {} "$('#button767105').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "400 m"] [:th {:style "display: none", :class "split"} "800 m"] [: