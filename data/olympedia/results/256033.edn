value "256036"} "Canadian Doubles, Slalom, Men"] "\n" [:option {:value "256065"} "Kayak Singles, Slalom, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255414"} "1972"] "\n" [:option {:value "256163"} "1996"] "\n" [:option {:value "256278"} "2000"] "\n" [:option {:value "256395"} "2004"] "\n" [:option {:value "258824"} "2008"] "\n" [:option {:value "307000"} "2012"] "\n" [:option {:value "353542"} "2016"] "\n" [:option {:value "19006320"} "2020"] "\n" [:option {:value "2008406"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/174"} "Event type"]] [:h1 {:class "event_title"} "Canadian Singles, Slalom, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 1 August 1992 — 9:45"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/675"} "Parque Olímpico del Segre, Seo de Urgel"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/256033"} "31 from 15 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Two runs, best score of two to count."]]]] [:div {:class "description"} [:p {} "The Olympic program had experimented with canoe slalom events in 1972, but they did not become a permanent fixture until the 1992 Summer Games. " [:a {:href "/athletes/11118"} "Jon Lugbill"] " of the United States and " [:a {:href "/athletes/9944"} "Martin Lang"] " of Germany had won the C-1 at 1989 and 1991 World Championships respectively and were second and fifth after the first run. " [:a {:href "/athletes/9593"} "Jacky Avril"] " of France, the 1991 World bronze medalist, posted the highest score in this portion of the tournament, while " [:a {:href "/athletes/9404"} "Lukáš Pollert"] " of Czechoslovakia was third. Pollert, however, had a fantastic run in the second part and jumped ahead of both Avril and Lugbill, neither of whom improved upon their earlier marks, to capture gold. " [:a {:href "/athletes/9759"} "Gareth Marriott"] " of Great Britain was able to do the same and, although his score was not close to Pollert’s, it remained enough to win the silver medal, while Avril clung to bronze. Lung improved his score slightly, but still sank to sixth in the final rankings. Marriott’s silver was Great Britain’s first Olympic canoeing medal in either the sprints or the slalom. Lugbill’s fourth-place finish was somewhat of a disappointment, as he was considered one of the premier forces in the advancement of slalom canoe as a sport through his innovations in design and technique. Between 1979 and 1991, he won 13 World Championship medals, 12 of them gold, in the C-1 and C-1 team."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Total Time"] [:th {} "Run #1"] [:th {} "Run #2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "217"] [:td {} [:a {:href "/athletes/9404"} "Lukáš Pollert"]] [:td {} [:a {:href "/countries/TCH"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/TCH.png"}] "TCH"]] [:td {} "113.69"] [:td {} "119.71 (3)"] [:td {} "113.69 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "229"] [:td {} [:a {:href "/athletes/9759"} "Gareth Marriott"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {} "116.48"] [:td {} "126.13 (10)"] [:td {} "116.48 (2)"] 