5565"} "1964"] "\n" [:option {:value "126308"} "1968"] "\n" [:option {:value "127190"} "1972"] "\n" [:option {:value "128000"} "1976"] "\n" [:option {:value "128710"} "1980"] "\n" [:option {:value "129525"} "1984"] "\n" [:option {:value "130729"} "1988"] "\n" [:option {:value "131817"} "1992"] "\n" [:option {:value "132889"} "1996"] "\n" [:option {:value "133593"} "2000"] "\n" [:option {:value "134175"} "2004"] "\n" [:option {:value "263827"} "2008"] "\n" [:option {:value "355680"} "2016"] "\n" [:option {:value "19009416"} "2020"] "\n" [:option {:value "2007906"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/664"} "Event type"]] [:h1 {:class "event_title"} "Heavyweight, Greco-Roman (≤96 kg), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 7 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/861"} "ExCeL, Newham, London"] " (North Arena 2)"]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/332230"} "19 from 19 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single elimination tournament. Competitors losing to the finalists entered repechage tournament for bronze medals."]]]] [:div {:class "description"} [:p {} "The reigning World Champion in men’s heavyweight Greco-Roman wrestling, and a favorite for gold at the London Olympics, was " [:a {:href "/athletes/117204"} "Elis Guri"] ", who had first participated in the Olympics in 2008 as a competitor for his native Albania. Thereafter he was absent from major competitions for three years as he switched allegiances to Bulgaria and made his return by winning a bronze medal at the 2011 European Championships prior to his victory at the World Championships. He faced challenges from several wrestlers in his quest for Olympic glory, most notably " [:a {:href "/athletes/120637"} "Jimmy Lidberg"] " of Sweden, who was twice runner-up (2009 and 2011) and once a bronze medalist (2010) at the World Championships."] "\n\n" [:p {} "Guri and Lidberg were drawn into the same half, setting up a potentially exciting semi-final match, but it was not to be: both wrestlers were eliminated in the quarterfinals. Guri was defeated by " [:a {:href "/athletes/121060"} "Timofey Deynichenko"] " of Belarus, runner-up at the 2010 European and World Championships, while Lindberg was bested by 2011 World Championship bronze medalist " [:a {:href "/athletes/120830"} "Rustam Totrov"] " of Russia. Totrov then conquered Deynichenko in the semifinals, eliminating any chance of Guri winning a medal. In the final the Russian met " [:a {:href "/athletes/117209"} "Ghasem Rezaei"] " of Iran, a two-time Asian Champion (2007 and 2008) whose best finish at the World Championships was third in 2007.The first round went to " [:em {} "par terre"] " where, although Totrov almost managed to rise from the bottom position, he was taken down at the last moment by Rezaei and scored upon. The second period again went to " [:em {} "par terre"] ", despite the best efforts of the Russian, who was unable to convert his top advantage to a point, even with a fantastic push that tossed both competitors out of the ring simultaneously (and therefore scored no points). Thus Iran, which had begun the 2012 Olympics with zero Greco-Roman gold medals to its name, left the tournament with three, following earlier victories by " [:a {:href "/athletes/117139"} "Hamid Soryan"] " and " [:a {:href "/athletes/122822"} "Omid Noroozi"] " in the featherweight and lightweight categories respectively."] "\n\n" [:p {} "Lidberg and Deynichenko, meanwhile, met up in a bronze medal bout, where Deynichenko took an early lead by reversing the Swede’s advantage in the first " [:em {} "par terre"] " and scoring two points in the dying seconds of the period. Lidberg struck back in the next two rounds, however, starting with a successful defense in the second " [:em {} "par terre"] " that forced a third, decisive period. This round too went to " [:em {} "par terre"] ", but the Swede had fewer cautions and was therefore granted the top advantage, using it to score four points to Deynichenko’s one in the final twenty-two seconds of the match and clinch the bronze. The final podium spot was decided between " [:a {:href "/athletes/117195"} "Yunior Estrada"] " of Cuba and " [:a {:href "/athletes/120952"} "Artur Aleksanyan"] " of Armenia, the 2012 European Champion and 2011 runner-up. For many years, including an appearance at the 2008 Summer Olympics, Estrada was a light-heavyweight wrestler and had won bronze in this division at the 2007 Pan American Games. He had switched to heavyweight by 2010, however, and won gold at the 2011 Pan American Games. In the bronze medal bout, Aleksanyan was dominant: he converted his top advantage in the round one " [:em {} "par terre"] " to two points and then pushed Estrada out of the ring in the second period to claim victory."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/117209"} "Ghasem Rezaei"]] [:td {} [:a {:href "/countries/IRI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/IRI.png"}] "IRI"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/120830"} "Rustam Totrov"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/120952"} "Artur Aleksanyan"]] [:td {} [:a {:href