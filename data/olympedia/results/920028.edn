ertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BEL.png"}] "BEL"]]] [:tr {:class "referees", :style ""} [:th {} "Judge"] [:td {:style "width: 400px"} [:a {:href "/athletes/5005238"} "Dirk Wolbers"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]]]]] [:div {:class "description"} [:p {} "There were 255 sculptures submitted, including 80 medals and reliefs, according to the " [:strong {} "Official Report"] ", although those details do not match those of the art catalogues."] "\n\n" [:p {} "Austrian " [:a {:href "/athletes/920023"} "Edwin Grienauer"] " earned the gold medal for " [:em {} "Medailles"] " (Medals). Two of them presented a concrete event. One medal was established for the award ceremonies in rowing in Vienna, on 27 June 1927. An angel presents three athletes an olive branch. Another medal, " [:em {} "60th anniversary"] ", was dedicated to rowing. In the background, a coxed eights can be recognized. In the foreground, an athlete (the winner) waves a flag. The subject of rowing was familiar to Grienauer, who was a very good rower, as the 1927 Austrian Champion in double sculls. The third medal showed a naked athlete, the fourth a dragon slayer. It is not known for certain which medal was the gold medal one."] "\n\n" [:p {} "Dutch " [:a {:href "/athletes/921130"} "Chris van der Hoef"] " was the silver medal winner. His work " [:em {} "Médaille pour les Jeux Olympiques 1928"] " (Medal for the 1928 Olympic Games) was also considered for the Official Olympic Medals for the Amsterdam Games, but was not chosen. Nevertheless, he created the Official Olympic Diploma."] "\n\n" [:p {} "The bronze medal went to German " [:a {:href "/athletes/920710"} "Edwin Scharff"] " for " [:em {} "Plaquette"] ", which represented an archer. Bernard Kramer noted, “The classical model depicts the shooter effectively in the center. The design of the rest of the image frame using simple geometric shapes forms an attractive contrast to the figurative representation.”"] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Catalogue Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Translated Title"] [:th {} "Original Title"] [:th {} "Title in Olympic Report or Catalogue"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "115-117"] [:td {} [:a {:href "/athletes/920023"} "Edwin Grienauer"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]] [:td {} "Medals"] [:td {} "Medaillen"] [:td {} "Médaille"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "503b"] [:td {} [:a {:href "/athletes/921130"} "Chris van der Hoef"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "One medal for the Olympic Games 1928"] [:td {} "Herinneringspenning IXe Olympische Spelen te Amsterdam 1928"] [:td {} "1 médaille pour les Jeux Olympiques 1928, (les deux cotés) (br.)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "69"] [:td {} [:a {:href "/athletes/920710"} "Edwin Scharff"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "Medal"] [:td {} "Plakette"] [:td {} "Plaquette (sc.)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} [:span {:class "label label-primary"} [:abbrev {:title "Also Competed"} "AC"]]] [:td {:class "bib"} "53"] [:td {} [: