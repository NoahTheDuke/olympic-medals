 "19000318"} "400 metres Individual Medley, Women"] "\n" [:option {:value "19000326"} "4 × 100 metres Medley Relay, Women"] "\n" [:option {:value "19000331"} "4 × 100 metres Medley Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "4805"} "1924"] "\n" [:option {:value "4905"} "1928"] "\n" [:option {:value "4999"} "1932"] "\n" [:option {:value "5098"} "1936"] "\n" [:option {:value "5208"} "1948"] "\n" [:option {:value "5337"} "1952"] "\n" [:option {:value "5452"} "1956"] "\n" [:option {:value "5599"} "1960"] "\n" [:option {:value "5782"} "1964"] "\n" [:option {:value "6049"} "1968"] "\n" [:option {:value "6355"} "1972"] "\n" [:option {:value "6634"} "1976"] "\n" [:option {:value "6877"} "1980"] "\n" [:option {:value "7150"} "1984"] "\n" [:option {:value "7490"} "1988"] "\n" [:option {:value "7844"} "1992"] "\n" [:option {:value "8191"} "1996"] "\n" [:option {:value "8592"} "2000"] "\n" [:option {:value "8981"} "2004"] "\n" [:option {:value "261717"} "2008"] "\n" [:option {:value "322049"} "2012"] "\n" [:option {:value "357212"} "2016"] "\n" [:option {:value "2001712"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/591"} "Event type"]] [:h1 {:class "event_title"} "400 metres Freestyle, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "25 – 26 July 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2105"} "Olympic Aquatics Centre, 2-1, 2chome, Tatsumi, Koto-ku, Tatsumi-no-Mori Seaside Park, Tokyo, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19000205"} "26 from 19 countries"]]]]] [:div {:class "description"} [:p {} "The defending champion was America’s " [:a {:href "/athletes/126653"} "Katie Ledecky"] " who had not lost at this distance since before the Rio Olympics, where she had set the world record, except for the 2019 World Championships, where she was ill. This was expected to be a two-woman race as Australia’s " [:a {:href "/athletes/140687"} "Ariarne Titmus"] " had been coming closer to Ledecky’s times, had won that match-up at the 2019 Worlds, and recorded the second fastest time ever at the Australian Olympic Trials with 3:56.90."] "\n\n" [:p {} "Both qualified for the final easily, with Ledecky first, Titmus third, and China’s " [:a {:href "/athletes/141768"} "Li Bingjie"] " in the middle. The final was on Monday morning, and was much anticipated. Ledecky took the lead early, splitting 57.67 at 100 metres and holding the lead through almost 350 metres. Titmus, as is her style, held back slightly but was expected to finish faster, and it was notable that although Ledecky led, she never opened much of a gap over Titmus."] "\n\n" [:p {} "And just past 300 metres Titmus pulled ahead slightly, reaching the final turn with a 0.22 margin. Ledecky could not respond as Titmus increased her lead to win gold in 3:56.69, as Ledecky finished in 3:57.36. Titmus’s time was the second fastest ever, and Ledecky swam her second fastest 400 in finishing second."] "\n\n" [:p {} "Immediately the discussion began of the legendary status of the race, many swim experts calling it the greatest ever women’s Olympic race. Few argued with that. Almost as notable as Titmus was her coach, Dean Boxall, who went into a wild celebration of fist-pumping, arm waving, and screaming up in the stands."] "\n\n" [:p {} "Titmus and Ledecky were more restrained and spoke admirably of each other, Titmus noting, “I wouldn’t be here without her. She’s set this standard for middle-distance freestyle. If I didn’t have someone like her to chase, I definitely wouldn’t be swimming the way I am.”"] "\n\n" [:p {} "Ledecky handled the defeat with class, “It can’t get much better than that. It was tremendous racing, a lot of fun and I can’t be too disappointed with that. That was my second-best swim ever and I feel like I fought tooth and nail and that’s all you can ask for.”"] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/140687"} "Ariarne Titmus"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]] [:td {} "4:01.66 (1 h4)"] [:td {} "3:56.69 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/126653"} "Katie Ledecky"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "4:00.45 (1 h3)"] [:td {} "3:57.36 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/141768"} "Li Bingjie"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} "4:01.57 (2 h3)"] [:td {} "4:01.08 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/141457"} "Summer McIntosh"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {} "4:02.72 (3 h3)"] [:td {} "4:02.42 (4)"] [:td {}] [:td {}] [:td 