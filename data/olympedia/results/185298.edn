 Belgium, which won the bronze medal. This was the first medal for Belgium in an equestrian event since 1920."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "Horse"] [:th {} "NOC"] [:th {} "Faults"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "France"] [:td {}] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "40.00"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "53"] [:td {} [:a {:href "/athletes/12539"} "Hubert Parot"] " "] [:td {} [:i {} [:a {:href "/horses/2119"} "Rivage"]]] [:td {}] [:td {} "12.00"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "56"] [:td {} [:a {:href "/athletes/12662"} "Marcel Rozier"] " "] [:td {} [:i {} [:a {:href "/horses/234"} "Bayard de Maupas"]]] [:td {}] [:td {} "12.00"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "55"] [:td {} [:a {:href "/athletes/12646"} "Marc Roguet"] " "] [:td {} [:i {} [:a {:href "/horses/246"} "Belle de Mars"]]] [:td {}] [:td {} "24.00"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "54"] [:td {} [:a {:href "/athletes/12631"} "Michel Roche"] " "] [:td {} [:i {} [:a {:href "/horses/2549"} "Un Espoir"]]] [:td {}] [:td {} "32.00"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "50"] [:td {} [:a {:href "/athletes/2305519"} "Gilles Bertran de Balanda"] " " [:span {:class "label label-primary"} "DNS"]] [:td {}] [:td {}] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} "West Germany"] [:td {}] [:td {} [:a {:href "/countries/FRG"} [:img {:style "pad