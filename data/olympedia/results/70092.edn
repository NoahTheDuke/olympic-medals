-flags.s3.eu-central-1.amazonaws.com/MEX.png"}] "MEX"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Jury"] [:td {:style "width: 400px"} [:a {:href "/athletes/2306377"} "Eugène Richème"]] [:td {} [:a {:href "/countries/SUI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SUI.png"}] "SUI"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Jury"] [:td {:style "width: 400px"} [:a {:href "/athletes/29837"} "Viktor Smeds"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Jury"] [:td {:style "width: 400px"} [:a {:href "/athletes/2306254"} "Hannes Tanner"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Jury"] [:td {:style "width: 400px"} [:a {:href "/athletes/2306424"} "Martin Trieb"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]]]] [:div {:class "description"} [:p {} "The individual all-around consisted of compulsory and freestyle exercises on five apparatuses – horizontal bars, parallel bar, pommelled horse, rings, and horse vault. In Los Angeles, the floor exercises were not included in the all-around as they would later be. The total points on horizontal bar, parallel bars, pommelled horse, and rings were divided by two, with the result of the horse vault divided by four and added to the total, yielding a maximum score of 150.000 points."] "\n\n" [:p {} "The outstanding gymnast was " [:a {:href "/athletes/30532"} "Romeo Neri"] " from Italy, who clearly dominated the competition and won by more than six points ahead of the others. In places 2-5, the gymnasts were separated by only 0.55 points. The silver medal eventually went to the Hungarian " [:a {:href "/athletes/30408"} "István Pelle"] ", slightly ahead of " [:a {:href "/athletes/29833"} "Heikki Savolainen"] " from Finland. All three had also been participants in 1928 at Amsterdam, with Neri placing fourth in the " [:a {:href "/results/70074"} "all-around"] "."] "\n\n" [:p {} "Neri and Pelle would also compete in " [:a {:href "/editions/11/sports/GAR"} "1936"] ", while Savolainen would have the longest career of any Olympic gymnast, competing through the " [:a {:href "/editions/13/sports/GAR"} "1952 Olympics"] ", during which time he would win nine medals and six bronze medals. His six bronzes is still, through 2024, the all-time record for most Olympic bronze medals won, since equaled by four other athletes – " [:a {:href "/athletes/30978"} "Aleksey Nemov"] " (RUS - Gymnastics), " [:a {:href "/athletes/47755"} "Franziska van Almsick"] " (GER - Swimming), " [:a {:href "/athletes/72229"} "Merlene Ottey-Page"] " (JAM - Athletics), and " [:a {:href "/athletes/87989"} "Harri Kirvesniemi"] " (FIN - Cross Country Skiing)."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Points"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/30532"} "Romeo Neri"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} "140.625"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/30408"} "István Pelle"]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-ce