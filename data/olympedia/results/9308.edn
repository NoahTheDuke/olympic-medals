value "9327"} "8 metres, Open"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "9335"} "1928"] "\n" [:option {:value "9367"} "1932"] "\n" [:option {:value "9420"} "1936"] "\n" [:option {:value "9473"} "1948"] "\n" [:option {:value "9538"} "1952"] "\n" [:option {:value "9603"} "1956"] "\n" [:option {:value "9668"} "1960"] "\n" [:option {:value "9733"} "1964"] "\n" [:option {:value "9798"} "1968"] "\n" [:option {:value "9863"} "1972"] "\n" [:option {:value "9937"} "1976"] "\n" [:option {:value "10015"} "1980"] "\n" [:option {:value "10093"} "1984"] "\n" [:option {:value "10184"} "1988"] "\n" [:option {:value "10568"} "1996"] "\n" [:option {:value "10786"} "2000"] "\n" [:option {:value "11117"} "2004"] "\n" [:option {:value "261153"} "2008"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/412"} "Event type"]] [:h1 {:class "event_title"} "One Person Dinghy (Olympic Monotype), Open" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "10 – 13 July 1924"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/203"} "Cercle de la Voile de Paris, Meulan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/9308"} "17 from 17 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Meulan-Les-Mureaux; 9 kilometres course for the finals, 6 kilometres course for the first round."]]]] [:div {:class "description"} [:p {} "This was the first time single-handed boats were included in Olympic competition. The " [:a {:href "/organizations/1"} "IOC"] " decreed that the French sailing authorities should decide on the design of boat to be used and provided these boats for use at the Olympic Games. Unfortunately, the number of entrants exceeded the number of boats available, and a convoluted series of qualifying races had to be scheduled to eliminate just a single boat from the finals. The class was termed the Olympic Monotype, but was actually known as the Monotype national français (or French National Monotype) or Meulan, class, and was chosen as the monotype class by the Union des sociétés nautiques française (USNF). However, only 10 of the 16 boats were Monotype national français, with the other six slightly different and possibly of the very similar Belgian/Dutch Scheldejol class"] "\n\n" [:p {} [:a {:href "/athletes/62421"} "Léon Huybrechts"] ", a Belgian who had won silver medals in both " [:a {:href "/results/9217"} "1908"] " and " [:a {:href "/results/9262"} "1920"] ", proved himself a master of the fickle French winds. He posted a comfortable victory in the first of the two races that made up the Olympic final, and  then held off the challenge of the Dutch boat to win the second race and confirm himself as champion. Behind him, there was a three-way tie for second place and so a tie-breaker race had to be scheduled. Spain’s " [:a {:href "/athletes/61157"} "Santiago Amat"] " led at halfway but faltered badly and allowed " [:a {:href "/athletes/63466"} "Henrik Robert"] " of Norway and " [:a {:href "/athletes/61847"} "Hans Dittmar"] " of Finland to pass him and claim silver and bronze, respectively."] "\n\n" [:p {} "Although she failed to reach the final stages, Swiss sailor " [:a {:href "/athletes/60999"} "Ella Maillart"] " made a piece of history by becoming the first woman to skipper a boat in Olympic competition. Maillart, who also competed internationally in hockey and alpine skiing, later became better known as an adventurer and acclaimed travel writer."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}