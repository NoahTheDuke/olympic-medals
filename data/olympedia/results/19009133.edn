tion {:value "2012233"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/316"} "Event type"]] [:h1 {:class "event_title"} "Vault, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "24 July –  2 August 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2113"} "Ariake Gymnastics Centre, 10-1, 1chome, Ariake, Koto-ku, Tokyo, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19009133"} "24 from 18 countries"]]]]] [:div {:class "description"} [:p {} "The 2019 world champion " [:a {:href "/athletes/135778"} "Nikita Nagorny"] " (ROC) qualified in third place for the vault final. Korea’s " [:a {:href "/athletes/145029"} "Sin Jae-Hwan"] " headed the qualifiers with Armenia’s " [:a {:href "/athletes/120896"} "Artur Davtyan"] ", who had recovered from a back injury he suffered in 2020, qualifying in second place. The Rio silver medalist " [:a {:href "/athletes/120449"} "Denis Ablyazin"] ", also of the ROC, was ranked fifth in qualifying. Competition was extremely close, with 0.05 points separating the first three and less than one point between the first and seventh placed gymnasts."] "\n\n" [:p {} "The first to perform was " [:a {:href "/athletes/146962"} "Adem Asil"] " of Turkey, and he did his medal chances a great deal of good with a first vault that scored 15.266 points, the only 15-point vault of the final. His second vault, however, was a disappointing 13.633 and he ended up in sixth place. Davtyan, starting fourth, put himself in the lead with a total score of 14.733. Korea’s Sin Jae-Hwan then overtook him with a second vault of 14.833, which gave him a total of 14.783. Ablyazin was the seventh man up and his second vault of 14.800 put him level with Sin. The last man to go was " [:a {:href "/athletes/145888"} "Carlos Edriel Yulo"] ", who was hoping to become the Philippines first Olympic gymnastics medalist and needed to score 15 with his second vault. He only managed 14.866, however, for fourth place. Sin won the tie break by virtue of his best vault being 14.833 to Ablyazin’s 14.800. Sin won Korea’s first gymnastics gold of the Tokyo Games and only their second gymnastics gold since " [:a {:href "/athletes/124600"} "Yang Hak-Seon"] " won the vault at London 2012."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "156"] [:td {} [:a {:href "/athletes/145029"} "Sin Jae-Hwan"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "168"] [:td {} [:a {:href "/athletes/120449"} "Denis Ablyazin"]] [:td {} [:a {:href "/countries/ROC"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ROC.png"}] "ROC"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "102"] [:td {} [:a {:href "/athletes/120896"} "Artur Davtyan"]] [:td {} [:a {:href "/countries/ARM"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ARM.png"}] "ARM"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "166"] [:td {} [:a {:href "/athletes/145888"} "Carlos Yulo"]] [:td {} [:a {:href "/countries/PHI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/PHI.png"}] "PHI"]] [:td {