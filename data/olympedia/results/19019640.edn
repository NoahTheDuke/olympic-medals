9019631"} "12.5 kilometres Pursuit, Men"] "\n" [:option {:value "19019632"} "15 kilometres Mass Start, Men"] "\n" [:option {:value "19019633"} "20 kilometres, Men"] "\n" [:option {:value "19019634"} "4 × 7.5 kilometres Relay, Men"] "\n" [:option {:value "19019635"} "7.5 kilometres Sprint, Women"] "\n" [:option {:value "19019636"} "10 kilometres Pursuit, Women"] "\n" [:option {:value "19019637"} "12.5 kilometres Mass Start, Women"] "\n" [:option {:value "19019638"} "15 kilometres, Women"] "\n" [:option {:value "19019639"} "4 × 6 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "15000040"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/2687"} "Event type"]] [:h1 {:class "event_title"} "4 × 6 kilometres Relay, Mixed" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 5 February 2022 — 17:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2138"} "Zhangjiakou Nordic Centre and Biathlon Centre, Chongli District, Zhangjiakou City, Hebei Province"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19019640"} "80 from 20 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Eight shots for each group of five targets. Penalty loop (150 metres) skied for each missed target, with three extra shots allowed to obtain 5 target hits."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 6,228 m" [:br {}] "Height Differential: 35 m" [:br {}] "Maximum Climb: 20 m" [:br {}] "Shooting 1: Prone at 1.864 km, 50 m range / Prone at 2.411 km, 50 m range" [:br {}] "Shooting 2: Standing at 3.993 km, 50 m range / Standing at 5.087 km, 50 m range" [:br {}] "Total Climbing: 312 m / 510 m"]]]] [:div {:class "description"} [:p {} "For the first time, the mixed relay was raced over 4 x 6 km legs. Previously it had been 2 x 6 km for the women and 2 x 7.5 km for the men. Gusty winds made the first event in biathlon at the 2022 Winter Games a turbulent affair. Nevertheless, the favourites eventually collected their medals with Norway winning gold ahead of France and the ROC in third."] "\n\n" [:p {} "The first team that fell victim to the conditions was Germany with rookie " [:a {:href "/athletes/148390"} "Vanessa Voigt"] ". Although known as an excellent shooter, she started with two penalty rounds. Norway, with " [:a {:href "/athletes/137711"} "Marte Olsbu Røiseland"] ", held the lead at the first exchange. Italy’s " [:a {:href "/athletes/127919"} "Dorothea Wierer"] " was the best markswoman of the top teams on the second leg, finishing second in the second exchange behind France’s " [:a {:href "/athletes/148329"} "Julia Simon"] ". This time, Norway’s " [:a {:href "/athletes/128184"} "Tiril Eckhoff"] " went three penalty rounds and dropped back to fifth place."] "\n\n" [:p {} "The weather conditions improved when the men took over. " [:a {:href "/athletes/137169"} "Émilien Jacquelin"] " had a brilliant start with a clean first round of shooting. At the standing shooting, however, it was his turn to suffer two extra penalty rounds. " [:a {:href "/athletes/128306"} "Aleksandr Loginov"] "’s third leg brought the ROC from seventh to first at the last exchange, followed by Sweden, with France third. The United States were a surprise fourth, with Norway in fifth, but still only 21.9 seconds behind the leaders."] "\n\n" [:p {} "Eventually the skiing speed of " [:a {:href "/athletes/128188"} "Johannes Thingnes Bø"] " and " [:a {:href "/athletes/137167"} "Quentin Fillon Maillet"] " would decide the race. They closed in on ROC’s " [:a {:href "/athletes/148769"} "Eduard Latypov"] ". A three-way battle ensued on the final lap, in which the Norwegians had the upper hand, with only 1.5 seconds separating the three top teams."] "\n\n" [:p {} "For Norway this was their third consecutive medal in the mixed relay, in what was the third edition of this event, having won gold in 2014, and silver in 2018. Tiril Eckhoff became the first biathlete to win three medals in the mixed relay, as she had been on each of those three teams."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Misses"] [:th {} "Extra Shots"] [:th {} "Shooting 1 Misses"] [:th {} "Shooting 1 Extra Shots"] [:th {} "Shooting 1"] [:th {} "Shooting 2 Misses"] [:th {} "Shooting 2 Extra Shots"] [:th {} "Shooting 2"] [:th {} "Exchange"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Norway"] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "1-06:45.6"] [:td {} "3"] [:td {} "13"] [:td {} "–"] [:td {} "–"] [:td {} "– (–)"] [:td {} "–"] [:td {} "–"] [:td {} "– (–)"] [:td {} "– (–)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/137711"} "Marte Olsbu Røiseland"] " "] [:td {}] [:td {} "17:18.6"] [:td {} "0"] [:td {} "1"] [:td {} "0"] [:td {} "0"] [:td {} "6:34.1 (10)"] [:td {} "0"] [:td {} "1"] [:td {} "12:24.7 (2)"] [:td {} "17:18.6 (1)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/128184"} "Tiril Eckhoff"] " "] [:td {}] [:td {} "19:12.6"] [:td {} "1"] [:td {} "3"] [:td {} "2"] [:td {} "3"] [:td {} "24:07.2 (2)"] [:td {} "3"] [:td {} "6"] [:td {} "31:38.4 (5)"] [:td {} "36:31.2 (5)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/11