"/results/1033"} "43.33"] " / " [:a {:href "/athletes/81283"} "Anne Henning"] " " [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"] " / 10 February 1972 / " [:a {:href "/records/event_name/537"} "Details"] [:br {}] [:a {:href "/results/1033"} "43.33"] " / " [:a {:href "/athletes/81283"} "Anne Henning"] " " [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"] " / 10 February 1972 / " [:a {:href "/records/event_name/537"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/99265"} "Manfred Zojer"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/1200586"} "Jean Heckly"]] [:td {} [:a {:href "/countries/SUI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SUI.png"}] "SUI"]]]]] [:div {:class "description"} [:p {} "The fastest sprinter of the early 70s was American " [:a {:href "/athletes/83093"} "Sheila Young"] ", who won the World Sprints in 1973, 1975, and would win them again a few weeks later in 1976. Except for a fall in one 500 at the 1974 World Sprints, she had lost only one international 500 since the 1972 Winter Olympics, and only a week before the Olympics, had set her second 500 world record with 40.91 at Davos. She was heavily favored in Innsbruck. Her biggest challengers were expected to be Soviet " [:a {:href "/athletes/80567"} "Tayana Averina"] ", who had set two world records at the distance, and her teammate, " [:a {:href "/athletes/82114"} "Leah Poulos"] ", who had won the 1974 World Sprints when Young had fallen in one race. Of the favorites, Young was the first to start, in the fifth pair, and she recorded 42.76 to move into the lead ahead of Canada’s " [:a {:href "/athletes/82127"} "Cathy Priestner"] ", who had skated in the pair before her and posted 43.12. Poulos started in the eighth pair, but could not match either time, finishing in 43.21, which would eventually place her fourth. In the next pair, Soviet " [:a {:href "/athletes/81562"} "Vera Krasnova"] " put a scare into Young with a very fast 100 in 10.64, 0.18 ahead of Young’s start, but she could not maintain that pace and would finish fifth. When Averina finished the 12th pairing in 43.17, the medals were set, with Young winning as expected, Priestner getting silver, and Averina the bronze. A few weeks later, Young would win all four races at the 1976 World Sprints. She was also a cycling sprint champion, winning the women’s sprint at the 1973 World Championships, finishing third in 1975, and she would again win the World Championship in the cycling sprint later in 1976 and in 1981."] "\n"] [:button {:id "button982296", :class "btn btn-default"} "Details"] [:script {} "$('#button982296').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "100 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "5O"] [:td {} [:a {:href "/athletes/83093"} "Sheila Young"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "42.76"] [:td {:class "split", :style "display: none"} "10.82"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style