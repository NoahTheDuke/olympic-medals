30 kilometres, Men"] "\n" [:option {:value "1975"} "4 × 10 kilometres Relay, Men"] "\n" [:option {:value "1979"} "5 kilometres, Women"] "\n" [:option {:value "1980"} "10 kilometres, Women"] "\n" [:option {:value "1981"} "4 × 5 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1890"} "1924"] "\n" [:option {:value "1892"} "1928"] "\n" [:option {:value "1894"} "1932"] "\n" [:option {:value "1896"} "1936"] "\n" [:option {:value "1902"} "1948"] "\n" [:option {:value "1908"} "1952"] "\n" [:option {:value "1916"} "1956"] "\n" [:option {:value "1927"} "1960"] "\n" [:option {:value "1938"} "1964"] "\n" [:option {:value "1950"} "1968"] "\n" [:option {:value "1962"} "1972"] "\n" [:option {:value "1987"} "1980"] "\n" [:option {:value "2000"} "1984"] "\n" [:option {:value "2014"} "1988"] "\n" [:option {:value "2031"} "1992"] "\n" [:option {:value "2051"} "1994"] "\n" [:option {:value "2071"} "1998"] "\n" [:option {:value "2091"} "2002"] "\n" [:option {:value "2134"} "2006"] "\n" [:option {:value "923554"} "2010"] "\n" [:option {:value "350067"} "2014"] "\n" [:option {:value "9000278"} "2018"] "\n" [:option {:value "19019713"} "2022"] "\n" [:option {:value "15000134"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/187"} "Event type"]] [:h1 {:class "event_title"} "50 kilometres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "14 February 1976 — 8:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/59"} "Langlaufstadion, Seefeld"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1974"} "59 from 17 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: ?" [:br {}] "Height Differential: 162 m" [:br {}] "Intermediate 1: 15.0 km" [:br {}] "Intermediate 2: 25.0 km" [:br {}] "Intermediate 3: 40.0 km" [:br {}] "Maximum Climb: 98 m" [:br {}] "Total Climbing: 1,190 m"]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/85784"} "Ivar Formo"] ", a 24-year old engineering student from Oslo, was the only Norwegian who had done as expected so far in the Olympic cross-country tracks around Seefeld. He was full of self confidence before the last event, the 50 km race, organized the day before the closing of the Games. With defending Olympic champion " [:a {:href "/athletes/98447"} "Pål Tyldum"] " also on the team Norway hoped for revenge, but they feared the Soviet skiers, and also the reigning World Champion, East German " [:a {:href "/athletes/86231"} "Gerhard Grimmer"] ", who was counted as a major contender for the gold."] "\n\n" [:p {} "At 10 km, the 24-year old Soviet " [:a {:href "/athletes/96904"} "Vasily Rochev"] ", bronze medalist in 15 km at the 1974 World Championship, had taken the lead, 13 seconds ahead of " [:a {:href "/athletes/91953"} "Sven-Åke  Lundbäck"] " from Sweden, 1972 Olympic Champion in the 15 km. At the halfway point, the amazing American " [:a {:href "/athletes/88083"} "Bill Koch"] ", skiing his first ever 50 km in competition, had advanced from fourth to the top of the leaderboard, 8 seconds ahead of East Germany’s " [:a {:href "/athletes/88016"} "Gert-Dietmar Klause"] ". Formo followed in third place, while Rochev had dropped down to fourth. Now Formo started his move. At the 40 km intermediate mark, he was in the lead, 32 seconds ahead of Klause. Rochev was now in third, still in contention for a medal, but he was closely followed by the steadily advancing Swede " [:a {:href "/athletes/98086"} "Benny Södergren"] ", the youngster Koch and World Champion Grimmer. Over the last 10 km, Rochev and Koch faded badly, losing five minutes more to the leaders and dropped down to 12th and 13th place in the final results. Formo ran a perfect calculated race, finished fastest of all and restored Norwegian cross-country pride with a gold medal, Norway being the first nation to win the 50 km at three consecutive Winter Olympics. Klause was a clear second, and Södergren’s well paced finish earned Sweden their only Nordic skiing medal at the 1976 winter Olympics. The best Soviet skier, " [:a {:href "/athletes/85932"} "Ivan Garanin"] " had advanced steadily over the last part of the race and ended as fourth, a minute too late to secure a medal."] "\n"] [:button {:id "button7154", :class "btn btn-default"} "Details"] [:script {} "$('#button7154').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "Intermediate 1"] [:th {:style "display: none", :class "split"} "Intermediate 2"] [:th {:style "display: none", :class "split"} "Intermediate 3"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "42"] [:td {} [:a {:href "/athletes/85784"} "Ivar Formo"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "2-37:30.05"] [:td {:class "split", :style "display: none"} "46:08.01 (5)"] [:td {:class "split", :style "display: none"} "1-17:21.32 (3)"] [:td {:class "split", :style "display: none"} "2-05:29.91 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "37"] [:td {} [:a {:href "/athletes/88016"} "Gert-Dietmar Klause"]] [:td {} [:a {:href "/countries/GDR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GDR.png"}