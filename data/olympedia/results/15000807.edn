817"} "Doubles, Women"] "\n" [:option {:value "15000820"} "Team Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:span {} "Not held in other editions"]] " | " [:a {:href "/event_names/2688"} "Event type"]] [:h1 {:class "event_title"} "Doubles, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "11 February 2026 — 17:48"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2202"} "Eugenio Monti Sliding Centre, Cortina d'Ampezzo, Belluno"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/15000807"} "34 from 11 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Two runs, total time determined placement."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Curves: 16" [:br {}] "Finish Altitude: 1255 m" [:br {}] "Length: 1410 m" [:br {}] "Maximum Gradient: 18°" [:br {}] "Start Altitude: 1308 m" [:br {}] "Vertical Drop: 95 m"]]]] [:div {:class "description"} [:p {} "For the first time since the sport’s introduction in 1964, the luge doubles was split into two events, men’s and women’s. Previously it had always technically been an open event, although no women had ever competed in it at the Olympic Winter Games."] "\n\n" [:p {} "The last three consecutive gold medals were won by Germany’s " [:a {:href "/athletes/127853"} "Tobias Arlt"] " and " [:a {:href "/athletes/127856"} "Tobias Wendl"] ". They returned for their fourth Olympics and again managed to claim another medal in the doubles, however, only bronze. After placing fifth in the first run they came from behind to secure the medal by placing second in run two. The German surprise World Champions of 2025 and silver medallists in the doubles of the 2016 Youth Olympic Winter Games, " [:a {:href "/athletes/2301464"} "Paul Gubitz"] " and " [:a {:href "/athletes/2301467"} "Hannes Orlamünder"] ", did not qualify after an unfortunate season."] "\n\n" [:p {} "The best time in run two brought the Italian doubles team of  " [:a {:href "/athletes/127948"} "Emanuel Rieder"] " and " [:a {:href "/athletes/2300493"} "Simon Kainzwaldner"] " from third to first to win Italy’s first gold in the luge doubles since 1994. The Austrian pair " [:a {:href "/athletes/136737"} "Thomas Steu"] " and " [:a {:href "/athletes/119464"} "Wolfgang Kindl"] " defended a narrow lead of only 2/100ths of a second for silver. Steu was a bronze medallist four years ago in Beijing with his long-term teammate " [:a {:href "/athletes/136736"} "Lorenz Koller"] ". In Cortina, he teamed up with five-time Olympian Wolgang Kindl, who added his first doubles’ silver to the two silvers from Beijing in the men’s singles and the team relay. The surprise leaders after run one, the Americans " [:a {:href "/athletes/157304"} "Marcus Mueller"] " and " [:a {:href "/athletes/157303"} "Ansel Haugsjaa"] ", dropped to sixth place after a flawed second run."] "\n\n" [:p {} "In open doubles and men’s combined a German team has now won 12 of 18 gold medals followed by Italy and Austria with three each. Only seven of the 54 medals have not gone to one of these three countries."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Pair"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Run #1"] [:th {} "Run #2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "8"] [:td {} [:a {:href "/athletes/127948"} "Emanuel Rieder"] " / " [:a {:href "/athletes/2300493"} "Simon Kainzwaldner"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} "1:45.086"] [:td {} "52.499 (3)"] [:td {} "52.587 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} 