t').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "29"} "1964"] "\n" [:option {:value "46"} "1968"] "\n" [:option {:value "59"} "1972"] "\n" [:option {:value "76"} "1976"] "\n" [:option {:value "93"} "1980"] "\n" [:option {:value "110"} "1984"] "\n" [:option {:value "127"} "1988"] "\n" [:option {:value "144"} "1992"] "\n" [:option {:value "178"} "1998"] "\n" [:option {:value "195"} "2002"] "\n" [:option {:value "212"} "2006"] "\n" [:option {:value "924220"} "2010"] "\n" [:option {:value "350405"} "2014"] "\n" [:option {:value "400000"} "2018"] "\n" [:option {:value "19020300"} "2022"] "\n" [:option {:value "15000800"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/358"} "Event type"]] [:h1 {:class "event_title"} "Singles, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "13 – 14 February 1994"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/69"} "Olympiske Bob- og Akebane, Hunderfossen"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/161"} "33 from 18 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Four runs, total time determined placement."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Curves: 16" [:br {}] "Length: 1365 m" [:br {}] "Start Altitude: 350 m" [:br {}] "Vertical Drop: 110 m"]]]] [:div {:class "description"} [:p {} "Although America’s " [:a {:href ""} "Wendell Suckow"] " scored an upset victory at the 1993 World Championship the consensus was that the two men who had placed first and second at the Albertville Olympics would still be the men to beat at Lillehammer. Olympic champion " [:a {:href "/athletes/86358"} "Georg Hackl"] " of Germany was a consummate championship performer whilst Austria’s " [:a {:href "/athletes/96599"} "Markus Prock"] " had proved his consistency by winning three successive World Cups.\nThe first two runs were taken by Hackl but his lead over Prock was limited to just a hundredth of a second at half way. The third run changed things around as the German could not quite match Prock’s speed and the Austrian rose to the gold medal position, but this was a position he could not hang on to permanently. Prock’s time on the final run was only seventh fastest and the clock stopped to reveal that Hackl had retained his title by a miniscule nine hundreths of a second. Hackl became the first man in history to successfully defend an Olympic singles title. In his first Olympic Games Italian " [:a {:href "/athletes/99296"} "Armin Zöggeler"] " took home the bronze meal. This was a task made considerably easier by the crash that ended the hopes of America’s " [:a {:href "/athletes/87878"} "Duncan Kennedy"] " on the third run."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Run #1"] [:th {} "Run #2"] [:th {} "Run #3"] [:th {} "Run #4"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/86358"} "Georg Hackl"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "3:21.571"] [:td {} "50.296 (1)"] [:td {} "50.560 (1)"] [:td {} "50.224 (2)"] [:td {} "50.491 (2)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/96599"} "Markus Prock"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.