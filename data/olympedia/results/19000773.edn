00784"} "20 kilometres Race Walk, Women"] "\n" [:option {:value "19000785"} "High Jump, Women"] "\n" [:option {:value "19000790"} "Pole Vault, Women"] "\n" [:option {:value "9031120"} "Long Jump, Women"] "\n" [:option {:value "9031134"} "Triple Jump, Women"] "\n" [:option {:value "19000829"} "Shot Put, Women"] "\n" [:option {:value "19000846"} "Discus Throw, Women"] "\n" [:option {:value "19000863"} "Hammer Throw, Women"] "\n" [:option {:value "19000880"} "Javelin Throw, Women"] "\n" [:option {:value "19000897"} "Heptathlon, Women"] "\n" [:option {:value "19000947"} "4 × 400 metres Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "57897"} "1928"] "\n" [:option {:value "58127"} "1932"] "\n" [:option {:value "58452"} "1936"] "\n" [:option {:value "58806"} "1948"] "\n" [:option {:value "59185"} "1952"] "\n" [:option {:value "59546"} "1956"] "\n" [:option {:value "60001"} "1960"] "\n" [:option {:value "60417"} "1964"] "\n" [:option {:value "60914"} "1968"] "\n" [:option {:value "61479"} "1972"] "\n" [:option {:value "62046"} "1976"] "\n" [:option {:value "62529"} "1980"] "\n" [:option {:value "63118"} "1984"] "\n" [:option {:value "63790"} "1988"] "\n" [:option {:value "64466"} "1992"] "\n" [:option {:value "65143"} "1996"] "\n" [:option {:value "65800"} "2000"] "\n" [:option {:value "66513"} "2004"] "\n" [:option {:value "257660"} "2008"] "\n" [:option {:value "302547"} "2012"] "\n" [:option {:value "359099"} "2016"] "\n" [:option {:value "2013943"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/107"} "Event type"]] [:h1 {:class "event_title"} "4 × 100 metres Relay, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "5 –  6 August 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2106"} "Japan National Stadium, Kasumigaoka, Shinjuku, Tokyo"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19000773"} "68 from 16 countries"]]]]] [:div {:class "description"} [:p {} "Jamaica had finished 1-2-3 in the women’s 100 metres, with " [:a {:href "/athletes/130722"} "Elaine Thompson-Herah"] ", " [:a {:href "/athletes/114740"} "Shelly-Ann Fraser-Pryce"] ", and " [:a {:href "/athletes/130733"} "Shericka Jackson"] ", so as long as they got the baton around, the gold medal was going to be theirs. The United States had the second-best set of sprinters, but they were no match for the Jamaicans."] "\n\n" [:p {} "In the first heat Great Britain surprisingly finished first, ahead of the United States with Jamaica third, although they did not run their first squad. Britain was aided by the return of " [:a {:href "/athletes/130204"} "Dina Asher-Smith"] ", who had injured her hamstring in the 100 and did not run the 200, in which she was favored. Germany won the second heat."] "\n\n" [:p {} "The final was close throughout, as " [:a {:href "/athletes/144237"} "Briana Williams"] " started off for Jamaica, and handed off to Thompson-Herah, but they had no significant advantage over the USA, who opened with " [:a {:href "/athletes/147112"} "Javianne Oliver"] " and " [:a {:href "/athletes/147131"} "Teahna Daniels"] ". On the third leg Fraser-Pryce took over but could not gain ground on the turn against " [:a {:href "/athletes/132034"} "Jenna Prandini"] ", primarily a 200 runner. The Jamaicans really only took the lead when Prandini and US anchor " [:a {:href "/athletes/147109"} "Gabrielle Thomas"] " had a slightly rough exchange. That gave Jackson the gap she needed, and Jamaica won gold in 41.02, with the United States taking silver in 41.45. Great Britain anchor " [:a {:href "/athletes/130202"} "Daryll Neita"] " closed quickly to bring them home for the bronze."] "\n\n" [:p {} "For Thompson-Herah this completed her sprint triple, after winning the 100 and 200 in Tokyo, making her only the fifth woman to win gold in the three sprint events – after " [:a {:href "/athletes/73711"} "Fanny Blankers-Koen"] " (NED-1948), " [:a {:href "/athletes/64506"} "Betty Cuthbert"] " (AUS-1956), " [:a {:href "/athletes/77958"} "Wilma Rudolph"] " (USA-1960), and " [:a {:href "/athletes/77849"} "Florence Griffith Joyner"] " (USA-1988)."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "Jamaica"] [:td {} [:a {:href "/countries/JAM"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JAM.png"}] "JAM"]] [:td {} "42.15 (3 h1)"] [:td {} "41.02 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "10"} [:a {:href "/athletes/144237"} "Briana Williams"] " • " [:a {:href "/athletes/130722"} "Elaine Thompson-Herah"] " • " [:a {:href "/athletes/114740"} "Shelly-Ann Fraser-Pryce"] " • " [:a {:href "/athletes/130733"} "Shericka Jackson"] " • " [:a {:href "/athletes/144245"} "Natasha Morrison"] " • " [:a {:href "/athletes/144246"} "Remona Burchell"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "41.90 (2 h1)"] [:td {} "41.45 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "10"} [:a {:href