n\n" [:p {} "Takhti would become Iran’s greatest wrestling champion, achieving legendary status in their most popular sport. He won another Olympic silver medal in 1960 at Roma, and was World Champion in 1959 and 1961. Kulayev would also finish second at the 1957 World Championships."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Round Eliminated"] [:th {} "Bad Points"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "92"] [:td {} [:a {:href "/athletes/58829"} "Gholam Reza Takhti"]] [:td {} [:a {:href "/countries/IRI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/IRI.png"}] "IRI"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "163"] [:td {} [:a {:href "/athletes/60497"} "Boris Kulayev"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "97"] [:td {} [:a {:href "/athletes/60576"} "Pete Blair"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "93"] [:td {} [:a {:href "/athletes/58844"} "Gerry Martina"]] [:td {} [:a {:href "/countries/IRL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/IRL.png"}] "IRL"]] [:td {} "–"] [:td {} "–"] [