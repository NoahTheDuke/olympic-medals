"} "Double Sculls, Men"] "\n" [:option {:value "19008446"} "Quadruple Sculls, Men"] "\n" [:option {:value "19008455"} "Coxless Pairs, Men"] "\n" [:option {:value "19008468"} "Coxless Fours, Men"] "\n" [:option {:value "19008478"} "Eights, Men"] "\n" [:option {:value "19008504"} "Single Sculls, Women"] "\n" [:option {:value "19008537"} "Double Sculls, Women"] "\n" [:option {:value "19008550"} "Quadruple Sculls, Women"] "\n" [:option {:value "19008559"} "Coxless Pairs, Women"] "\n" [:option {:value "19008572"} "Coxless Fours, Women"] "\n" [:option {:value "19008581"} "Eights, Women"] "\n" [:option {:value "19008589"} "Lightweight Double Sculls, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "159436"} "1996"] "\n" [:option {:value "159620"} "2000"] "\n" [:option {:value "159796"} "2004"] "\n" [:option {:value "261043"} "2008"] "\n" [:option {:value "319171"} "2012"] "\n" [:option {:value "354013"} "2016"] "\n" [:option {:value "2012485"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/390"} "Event type"]] [:h1 {:class "event_title"} "Lightweight Double Sculls, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "24 – 29 July 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2129"} "Sea Forest Waterway, 6-44, 3chome, Uminomori, Koto-ku, Tokyo Bay, Tokyo, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19008486"} "36 from 18 countries"]]]]] [:div {:class "description"} [:p {} "Huge favourites coming in were Ireland’s " [:a {:href "/athletes/134536"} "Paul O’Donovan"] " and " [:a {:href "/athletes/143918"} "Fintan McCarthy"] ", 2019 World Champions, and winners of every competition they had entered since then. Top challengers were seen to be Germany’s " [:a {:href "/athletes/143459"} "Jonathan Rommelmann"] " and " [:a {:href "/athletes/134220"} "Jason Osborne"] ", as well as Italy’s " [:a {:href "/athletes/134636"} "Stefano Oppo"] " and " [:a {:href "/athletes/127173"} "Pietro Ruta"] ", having gained silver and bronze respectively at the 2019 World Championships. The Norwegian team of " [:a {:href "/athletes/121191"} "Kristoffer Brun"] " and " [:a {:href "/athletes/121193"} "Are Strandli"] " were also a threat to medal, having won bronze at the 2016 Olympics, and more recently being victors at World Rowing Cup III."] "\n\n" [:p {} "The final featured most of the favourites, with the exception of Norway, who ran into trouble in the semi-finals as inclement weather conditions led them to capsize, and failed to move through. The Czech Republic, Belgium, and Uruguay filled out the rest of the field. In the end, the race turned out to be a showdown between Ireland and Germany. The Germans, who had been very strong in the heats and semi-final, moved out fast and held the lead in the initial portion of the race, with Italy and Ireland in pursuit. Ireland soon reeled in Italy and then were neck and neck with the Germans before pulling away to victory, with Germany second and Italy third. A great day for Ireland, as they won their first ever Olympic rowing gold medal."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/143918"} "Fintan McCarthy"] " / " [:a {:href "/athletes/134536"} "Paul O'Donovan"]] [:td {} [:a {:href "/countries/IRL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/IRL.png"}] "IRL"]] [:td {} [: