 {:href "/records/event_name/518"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #1"] [:td {:style "width: 400px"} [:a {:href "/athletes/5001814"} "Don Burdick"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #2"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002216"} "Georges Gottardi"]] [:td {} [:a {:href "/countries/SUI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SUI.png"}] "SUI"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #3"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003030"} "Karol Strba"]] [:td {} [:a {:href "/countries/TCH"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/TCH.png"}] "TCH"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #4"] [:td {:style "width: 400px"} [:a {:href "/athletes/5001991"} "Ernie Marchiori"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #5"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004524"} "Sulo Kuronen"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "K-Point: 89 m"]]]] [:div {:class "description"} [:p {} "The two dominant forces in ski jumping throughout the eighties were Finland’s " [:a {:href "/athletes/95937"} "Matti Nykänen"] " and " [:a {:href "/athletes/98886"} "Jens Weißflog"] " and in their first Olympic meeting in 1984 the two men had shared the honours with each winning a gold and silver apiece. Neither Nykänen or Weißflog held the world title, that championship having been won by Czechoslovakia’s " [:a {:href "/athletes/96218"} "Jiří Parma"] " in 1985 but  Nykänen would arrive at Calgary as the holder of the prestigious Four Hills tournament. Norwegian hopes were pinned on World Cup holder " [:a {:href "/athletes/96077"} "Vegard Opaas"] " whilst the Austrian pairing of " [:a {:href "/athletes/85665"} "Andreas Felder"] " and " [:a {:href "/athletes/98632"} "Ernst Vettori"] " had been consistently amongst the world’s best since the last Olympic Games."] "\n\n" [:p {} "After the completion of the first round the leader board had a strange look to it. It may have been no surprise to find Nykänen in the gold medal position but the top fifteen included only one Austrian, no Germans from either side of the border and no Norwegians. Weißflog did make the lower region of the top twenty but Opaas, the top Norwegian, languished all the way down in twenty-sixth place. Czechoslovakian and Yugoslavian jumpers were the top performers on the first jump with the two nations combining to produce eight of the top thirteen at the half way mark."] "\n\n" [:p {} "Nykänen’s second jump was a copy of his first and no one could challenge the mastery of the twenty four year old Finn. If there was little drama in the challenge for the Olympic title the same could not be said of the other medals with less than a point covering the next three jumpers. Pavel Ploc maintained the excellent form he had shown on the World Cup circuit to narrowly place second ahead of his less well known team-mate " [:a {:href "/athletes/92081"} "Jiří Malec"] ". While Nykänen’s feat was covered widely by the world’s press another jumper equaled him in terms of media coverage. " [:a {:href "/athletes/85413"} "Eddie Edwards"] " was a British ski jumper who had only two years of jumping behind him and was, at 74 kg and wearing a thick pair of spectacles, an unlikely competitor. His two jumps, both of 55 m, were well behind even of those of the next-to-last jumper."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Jump #1"] [:th {} "Jump #2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/95937"} "Matti Nykänen"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]] [:td {} "229.1"] [:td {} "114.8 (1)"] [:td {} "114.3 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/96484"} "Pavel Ploc"]] [:td {} [:a {:href "/countries/TCH"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/TCH.png"}] "TCH"]] [:td {} "212.1"] [:td {} "105.3 (=7)"] [:td {} "106.8 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/92081"} "Jiří Malec"]] [:td {} [:a {:href "/countries/TCH"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/TCH.png"}] "TCH"]] [:td {} "211.8"] [:td {} "106.9 (2)"] [:td {} "104.9 (4)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/98197"} "Miran Tepeš"]] [:td {} [:a {:href "/countries/YUG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/YUG.png"}] "YUG"]] [:td {} "211.2"] [:td {} "106.0 (3)"] [:td {} "105.2 (3)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {} [:a {:href "/athletes/96218"} "Jiří Parma"]] [:td {} [:a {:href "/countries/TCH"} [:img {:style "padding-right: 2px; vertical-al