"15000922"} "1,500 metres, Men"] "\n" [:option {:value "15000937"} "5,000 metres Relay, Men"] "\n" [:option {:value "15000944"} "500 metres, Women"] "\n" [:option {:value "15000965"} "1,000 metres, Women"] "\n" [:option {:value "15000986"} "1,500 metres, Women"] "\n" [:option {:value "15001001"} "3,000 metres Relay, Women"] "\n" [:option {:value "15001008"} "2,000 metres Mixed Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "905307"} "1988"] "\n" [:option {:value "481"} "1992"] "\n" [:option {:value "555"} "1994"] "\n" [:option {:value "647"} "1998"] "\n" [:option {:value "739"} "2002"] "\n" [:option {:value "857"} "2006"] "\n" [:option {:value "923676"} "2010"] "\n" [:option {:value "350707"} "2014"] "\n" [:option {:value "9001121"} "2018"] "\n" [:option {:value "19020481"} "2022"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/544"} "Event type"]] [:h1 {:class "event_title"} "1,000 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "10 – 12 February 2026"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2193"} "Forum di Milano, Assago, Milano, Milano"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/15000901"} "32 from 17 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Placements 1-8 based on A and B final.  Deeper placements based on placements in earlier rounds, and best time skated."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/19020481"} "1:23.042"] " / " [:a {:href "/athletes/137644"} "Hwang Dae-Heon"] " " [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"] " /  5 February 2022 / " [:a {:href "/records/event_name/544"} "Details"]]]]] [:div {:class "description"} [:p {} "Of the Beijing podium, champion " [:a {:href "/athletes/136984"} "Ren Ziwei"] " had retired, while runner-up " [:a {:href "/athletes/148133"} "Li Wenlong"] " did not qualify for any individual events in Milano. Bronze medallist " [:a {:href "/athletes/137351"} "Shaoang Liu"] " had followed-up with the 2022 world title, but had then taken a forced break as he switched nationality from Hungary to China. Other skaters had earned World titles in the intervening years: Park Ji-Won had won in 2023 but had not qualified for the Korean team, while " [:a {:href "/athletes/156214"} "William Dandjinou"] " won in 2024 and " [:a {:href "/athletes/148016"} "Steven Dubois"] " in 2025. The 2025/26 World Tour season had seen 4 different winners in 4 races: " [:a {:href "/athletes/148510"} "Pietro Sighel"] ", Dandjinou, " [:a {:href "/athletes/148681"} "Jens van ‘t Wout"] " and the young up-and-coming Korean " [:a {:href "/athletes/156852"} "In Jong-Eon"] "."] "\n\n" [:p {} "Of the favorites, only Dubois failed to reach the quarter-finals due to a fall, while Sighel eliminated himself in the quarter-finals with a loudly booed penalty. Liu made it into the semi-finals, but was unable to contend for a qualifying spot. Dandjinou, Van ‘t Wout and In did reach the last round, with " [:a {:href "/athletes/148134"} "Sun Long"] " and " [:a {:href "/athletes/148636"} "Roberts Krūzbergs"] " also making it. Dandjinou grabbed the lead off the pistol, but was overtaken by Van ‘t Wout after one lap, although the Canadian reverted this another lap later. At the bell, Van ‘t Wout passed Dandjinou again, on the inside. As the Canadian tried to counter this, Sun passed him on the outside. The five skaters were nearly side by side at the finish, with Van ‘t Wout only just holding off Sun. In, who’d been fifth just a lap earlier, passed Dandjinou on the outside for the bronze."] "\n\n" [:p {} "Jens van ‘t Wout’s gold medal was the first by a male short tracker from the Netherlands, and only their second medal ever in the event. At 18 years and 103 days, In Jong-Eon was the second youngest medalist in the event, after fellow 18-year-old " [:a {:href "/athletes/100242"} "Kim Dong-Seong"] " won  in 1998."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Final Round Placement"] [:th {} "Semi-Final Placement"] [:th {} "Quarter-Final Placement"] [:th {} "Round One Placement"] [:th {} "Best Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "2"] [:td {} [:a {:href "/athletes/148681"} "Jens van 't Wout"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "1"] [:td {} "2"] [:td {} "1"] [:td {} "1"] [:td {} "1:24.537"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "9"] [:td {} [:a {:href "/athletes/148134"} "Sun Long"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} "2"] [:td {} "2"] [:td {} "1"] [:td {} "2"] [:td {} "1:23.585"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "113"] [:td {} [:a {:href "/athletes/156852"} "In Jong-Eon"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td 