lue "2013209"} "Middleweight (≤73 kg), Men"] "\n" [:option {:value "2013218"} "Light-Heavyweight (≤89 kg), Men"] "\n" [:option {:value "2013227"} "Heavyweight (≤102 kg), Men"] "\n" [:option {:value "2013236"} "Super-Heavyweight (&gt;102 kg), Men"] "\n" [:option {:value "2013245"} "Flyweight (≤49 kg), Women"] "\n" [:option {:value "2013254"} "Lightweight (≤59 kg), Women"] "\n" [:option {:value "2013263"} "Middleweight (≤71 kg), Women"] "\n" [:option {:value "2013281"} "Super-Heavyweight (&gt;81 kg), Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "30278"} "2000"] "\n" [:option {:value "30413"} "2004"] "\n" [:option {:value "263114"} "2008"] "\n" [:option {:value "331090"} "2012"] "\n" [:option {:value "354407"} "2016"] "\n" [:option {:value "19002128"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/652"} "Event type"]] [:h1 {:class "event_title"} "Heavyweight (≤81 kg), Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "10 August 2024 — 16:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2165"} "Paris Expo Porte de Versailles, Paris, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2013272"} "13 from 13 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Total of best lifts in snatch and clean &amp; jerk determined placement. Ties broken by best result's attempt number – the athlete who achieved the result earliest according to the Calling Order."]]]] [:div {:class "description"} [:p {} "The second heaviest weight class for women was contested at a maximum bodyweight of 81 kg, down from the 87 kg that was contested in Tokyo. None of the three medalists from Tokyo returned to compete in this class in Paris, although bronze medalist " [:a {:href "/athletes/142207"} "Crismery Santana"] " (DOM) did participate in the super-heavyweight class."] "\n\n" [:p {} "Liang Xiaomei of China was the world record holder going into the Games but was not selected to compete due to the number of places allocated to each NOC. While no firm favorite was established, the field featured former European champions " [:a {:href "/athletes/155581"} "Weronika Zielińska"] " (POL) and " [:a {:href "/athletes/155578"} "Solfrid Koanda"] " (NOR), the African champion " [:a {:href "/athletes/129926"} "Sara Samir"] " (EGY), the Pan American champion " [:a {:href "/athletes/129899"} "Neisi Dajomes"] " (ECU), and the Commonwealth champion " [:a {:href "/athletes/155539"} "Eileen Cikamatana"] " (AUS)."] "\n\n" [:p {} "Dajomes took the lead in the competition in the snatch, when she lifted 122 kg, just ahead of Koanda, who cleared 121 kg. Samir and Cikamatana both lifted 117 kg, with Samir taking a slight advantage due to a lower bodyweight. It proved to be a disastrous Olympics for Poland’s Zielińska, who failed to produce a valid lift with her three attempts, which resulted in her elimination."] "\n\n" [:p {} "In the clean &amp; jerk, Samir lifted 151 kg with her second attempt to set an Olympic record. This was short-lived, however, with Koanda then lifting 154 kg to take the lead in the competition. " [:a {:href "/athletes/155553"} "Yudelina Mejía"] " (DOM), Cikamatana, and Dajomes all lifted 145 kg to keep them in contention. The Cuban lifter " [:a {:href "/athletes/155551"} "Ayamey Medina"] " failed to make a valid lift with her first two attempts before declining to make a third attempt to be eliminated from the competition."] "\n\n" [:p {} "Solfrid Koanda became the first woman for Norway to win a weightlifting medal of any color at the Olympics when she won gold with an Olympic record of 275 kg. It was only Norway’s second-ever medal in weightlifting at the Olympics, after " [:a {:href "/athletes/56434"} "Leif Jensen"] " won gold in the light-heavyweight class (up to 82.5 kg) at the 1972 München Games. Samir finished second to win silver, with Dajomes taking home bronze."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Kilograms"] [:th {} "Bodyweight"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/155578"} "Solfrid Koanda"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "275"] [:td {} "81.00"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/129926"} "Sara Samir"]] [:td {} [:a {:href "/countries/EGY"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/EGY.png"}] "EGY"]] [:td {} "268"] [:td {} "80.10"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/129899"} "Neisi Dajomes"]] [:td {} [:a {:href "/countries/ECU"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ECU.png"}] "ECU"]] [:td {} "267"] [:td {} "80.50"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/155539"} "Eileen Cikamatana"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]] [:td {} "262"] [:td