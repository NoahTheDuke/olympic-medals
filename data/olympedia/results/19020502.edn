9020481"} "1,000 metres, Men"] "\n" [:option {:value "19020517"} "5,000 metres Relay, Men"] "\n" [:option {:value "19020524"} "500 metres, Women"] "\n" [:option {:value "19020545"} "1,000 metres, Women"] "\n" [:option {:value "19020566"} "1,500 metres, Women"] "\n" [:option {:value "19020581"} "3,000 metres Relay, Women"] "\n" [:option {:value "19020588"} "2,000 metres Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "905322"} "1988"] "\n" [:option {:value "759"} "2002"] "\n" [:option {:value "876"} "2006"] "\n" [:option {:value "923697"} "2010"] "\n" [:option {:value "350728"} "2014"] "\n" [:option {:value "9001142"} "2018"] "\n" [:option {:value "15000922"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/545"} "Event type"]] [:h1 {:class "event_title"} "1,500 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 9 February 2022"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/845"} "Shoudu Tiyguan, Beijing"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19020502"} "36 from 16 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Placements 1-12 based on final and B final.  Deeper placements based on placements in earlier rounds, and best time skated."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/9001142"} "2:10.485"] " / " [:a {:href "/athletes/137647"} "Im Hyo-Jun"] " " [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"] " / 10 February 2018 / " [:a {:href "/records/event_name/545"} "Details"]]]]] [:div {:class "description"} [:p {} "Already with two gold medals to his name (the 1,000 m and the mixed relay), China’s " [:a {:href "/athletes/136984"} "Ren Ziwei"] " was the favorite for the 1,500 m. Ren had also won the last two World Cup races of the season, with the others going to 35-year-old " [:a {:href "/athletes/110402"} "Yuri Confortola"] " and " [:a {:href "/athletes/119800"} "Semyon Yelistratov"] ". Veteran star " [:a {:href "/athletes/109918"} "Charles Hamelin"] " had claimed two of the world titles since the 2018 Olympics (2018 and 2021), while the 2019 champion " [:a {:href "/athletes/137647"} "Im Hyo-Jun"] " was not in competition after a harassment scandal and nationality change."] "\n\n" [:p {} "The quarter-finals proceeded without major incidents or upsets. The first two semi-finals were also fairly uneventful, but the third, which featured Ren, Hamelin, Confortola, as well as " [:a {:href "/athletes/137351"} "Shaoang Liu"] ", bronze medallist in the 1,000 m, and " [:a {:href "/athletes/148603"} "Park Jang-Hyuk"] ", who had earned three World Cup bronzes earlier in the year, saw some drama. Early in the race, Hamelin blocked Confortola and Treacy in an overtake attempt, causing the Italian to crash. Similarly, Ren arm blocked Galiakhmetov, meaning both Ren and Hamelin were penalized. All of the five other racers qualified for the final, bringing that to a massive 10-person field."] "\n\n" [:p {} "There were no penalties in the final, which saw a lot of lead changes in the opening laps. With 9 laps to go, " [:a {:href "/athletes/137644"} "Hwang Dae-Heon"] ", moved up from the middle of the pack to the lead, passing all on the outside within a lap. Closely followed by " [:a {:href "/athletes/148016"} "Steven Dubois"] " and Yelistratov, the Korean then gradually increased the pace, making it very hard for the others to pass. Despite furious attempts by among others Yelistratov, the top three did not change again. It was Hwang’s second Olympic medal, having won silver in the 2018 500 m, while Yelistratov retained the bronze he had also won in PyeongChang."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Helmet Nr"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Position Last Race"] [:th {} "Positions"] [:th {} "Best Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "52"] [:td {} [:a {:href "/athletes/137644"} "Hwang Dae-Heon"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} "AF-1"] [:td {} "1-1"] [:td {} "2:09.219"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "16"] [:td {} [:a {:href "/athletes/148016"} "Steven Dubois"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {} "AF-2"] [:td {} "6-3"] [:td {} "2:09.254"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "3"] [:td {} [:a {:href "/athletes/119800"} "Semyon Yelistratov"]] [:td {} [:a {:href "/countries/ROC"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ROC.png"}] "ROC"]] [:td {} "AF-3"] [:td {} "2-2"] [:td {} "2:09.267"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/137351"} "Shaoang Liu"]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaw