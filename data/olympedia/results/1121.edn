al-1.amazonaws.com/GER.png"}] "GER"] " / 20 February 1998 / " [:a {:href "/records/event_name/541"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003182"} "Lars Jennersten"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5001986"} "Ernest Kretschmann"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]]]] [:div {:class "description"} [:p {} "With 5-time World Champion and world record holder " [:a {:href "/athletes/81514"} "Gunda Niemann-Stirnemann"] " away on maternity leave, the Olympic gold in the 5,000 m seemed predestined for the 1994 and 1998 champion, " [:a {:href "/athletes/82053"} "Claudia Pechstein"] ". Prior to the Games, she might have feared stiff competition from compatriot, " [:a {:href "/athletes/99411"} "Anni Friesinger"] ", winner of the only 5,000 m World Cup race earlier in the season. But Friesinger had not done well in the Olympic 3,000 m, while Pechstein had won that race."] "\n\n" [:p {} "Instead competition for Pechstein came from two women who had only recently picked up speed skating again. Canadian " [:a {:href "/athletes/13139"} "Clara Hughes"] " had been a speed skater before choosing a cycling career that earned her two Olympic bronze medals in the 1996 Games. She had picked up her old sport again in 2001, and had set a time of 7.00,10 at the Canadian Olympic Trials. " [:a {:href "/athletes/100970"} "Gretha Smit"] " had been the surprise of the Dutch Olympic Trials. Dominant in women’s marathon skating, she had taken a stab at long track skating, and had overwhelmingly won the 3,000 m and 5,000 m at the selection competition."] "\n\n" [:p {} "Skating in the first pair, Smit shattered Niemann’s world record, which had been set in March 2001, lowering it to 6:49.22. Only in the sixth pair did Hughes manage to approach the time with 6:53.53, mainly due to her steady final laps. Undaunted by these times, Pechstein set off faster than Smit. This appeared to have cost her, as she fell behind the Dutchwoman at 1,800 m and started to lose more time in the ensuing laps. The gap increased to 2.76 seconds at 3,400 m, but Smit’s final 33 and 34-second laps left room for improvement. Pechstein seized that opportunity, turning around her deficit at the bell to a sizable margin of victory at the finish line."] "\n"] [:button {:id "button842728", :class "btn btn-default"} "Details"] [:script {} "$('#button842728').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "200 m"] [:th {:style "display: none", :class "split"} "600 m"] [:th {:style "display: none", :class "split"} "1000 m"] [:th {:style "display: none", :class "split"} "1400 m"] [:th {:style "display: none", :class "split"} "1800 m"] [:th {:style "display: none", :class "split"} "2200 m"] [:th {:style "display: none", :class "split"} "2600 m"] [:th {:style "display: none", :class "split"} "3000 m"] [:th {:style "display: none", :class "split"} "3400 m"] [:th {:style "display: none", :class "split"} "3800 m"] [:th {:style "display: none", :class "split"} "4200 m"] [:th {:style "display: none", :class "split"} "4600 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "7O"] [:td {} [:a {:href "/athletes/82053"} "Claudia Pechstein"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "6:46.91"] [: