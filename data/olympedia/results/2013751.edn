lue "2013959"} "Pole Vault, Women"] "\n" [:option {:value "9031176"} "Long Jump, Women"] "\n" [:option {:value "9031190"} "Triple Jump, Women"] "\n" [:option {:value "2013998"} "Shot Put, Women"] "\n" [:option {:value "2014015"} "Discus Throw, Women"] "\n" [:option {:value "2014032"} "Hammer Throw, Women"] "\n" [:option {:value "2014049"} "Javelin Throw, Women"] "\n" [:option {:value "2014066"} "Heptathlon, Women"] "\n" [:option {:value "2014114"} "4 × 400 metres Relay, Mixed"] "\n" [:option {:value "2014119"} "Marathon Race Walk Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "56970"} "1912"] "\n" [:option {:value "57228"} "1920"] "\n" [:option {:value "57515"} "1924"] "\n" [:option {:value "57843"} "1928"] "\n" [:option {:value "58080"} "1932"] "\n" [:option {:value "58376"} "1936"] "\n" [:option {:value "58715"} "1948"] "\n" [:option {:value "59089"} "1952"] "\n" [:option {:value "59475"} "1956"] "\n" [:option {:value "59906"} "1960"] "\n" [:option {:value "60318"} "1964"] "\n" [:option {:value "60814"} "1968"] "\n" [:option {:value "61311"} "1972"] "\n" [:option {:value "61885"} "1976"] "\n" [:option {:value "62432"} "1980"] "\n" [:option {:value "62947"} "1984"] "\n" [:option {:value "63590"} "1988"] "\n" [:option {:value "64272"} "1992"] "\n" [:option {:value "64951"} "1996"] "\n" [:option {:value "65610"} "2000"] "\n" [:option {:value "66290"} "2004"] "\n" [:option {:value "257423"} "2008"] "\n" [:option {:value "302536"} "2012"] "\n" [:option {:value "358863"} "2016"] "\n" [:option {:value "19000594"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/93"} "Event type"]] [:h1 {:class "event_title"} "Decathlon, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "2 –  3 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2157"} "Stade de France, Saint-Denis, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2013751"} "22 from 13 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Scoring by 1985 point tables."]]]] [:div {:class "description"} [:p {} "The men’s decathlon was almost more notable for who did not start and did not finish than for the final result. Canadian " [:a {:href "/athletes/141491"} "Pierce LePage"] " won the 2023 World Championships, but he withdrew with an injury a few days before the Olympics. The two-time Olympic silver medalist 2016-2020, two-time world champion 2017-2022, and world record holder " [:a {:href "/athletes/125947"} "Kévin Mayer"] " likewise opted not to compete just before the Games due to injury once again."] "\n\n" [:p {} "This left Canada’s " [:a {:href "/athletes/122729"} "Damian Warner"] ", the defending gold medalist and eight-time champion at the Hypo-Meeting in Götzis, Austria, as the favorite. Another medal contender was expected to be German " [:a {:href "/athletes/150048"} "Leo Neugebauer"] ", the biggest ever international decathlete at 2.01 m and 110 kg, and world leader with  8,961 points, ranking sixth on the all-time best performers list."] "\n\n" [:p {} "As expected, Warner won the 100 metres and still led after the long jump, but Neugebauer took the lead after the shot put and led at the end of the first day with 4,650 points, ahead of Puerto Rico’s " [:a {:href "/athletes/150464"} "Ayden Owens-Delerme"] " and Norway’s " [:a {:href "/athletes/150397"} "Sander Skotheim"] ", with Warner in fourth."] "\n\n" [:p {} "Warner’s speed put him back in the lead after the first event of the second day, the 110 metre hurdles, but Neugebauer’s size and strength brought him back on top after the discus throw, with Warner second and Skotheim in third. It looked like these three would battle for the medals."] "\n\n" [:p {} "But the pole vault changed everything as Warner and Skotheim both no-heighted. Warner withdrew after that while Skotheim continued but would place only 18th. Neugebauer maintained the overall lead after he cleared 5.00 metres in the vault. Norway’s " [:a {:href "/athletes/150395"} "Markus Rooth"] " moved up to second by posting multiple personal bests, finishing with a clearance of 5.30 metres."] "\n\n" [:p {} "The javelin is one of Neugebauer’s worst events, despite his size, and his throw of 56.64, well off his PR, dropped him into second, 16 points behind the surprising Rooth, who led with 8,113 points going into the 1,500. Rooth had the best 1,500 PR of the contenders and he held on for the gold medal, as Neugebauer took silver. Bronze went to Grenada’s " [:a {:href "/athletes/136555"} "Lindon Toussaint-Victor"] ". Rooth’s gold medal was the first gold medal for Norway in the event since " [:a {:href "/athletes/74187"} "Helge Løvland"] " in 1920."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Points"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1099"] [:td {} [:a {:href "/athletes/150395"} "Markus Rooth"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "8796"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "759"] [:td {} [:a {:href "/athletes/150048"} "Leo Neugebauer"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "87