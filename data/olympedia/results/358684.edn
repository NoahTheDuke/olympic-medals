lver, as Drouin added another gold medal."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "2197"] [:td {} [:a {:href "/athletes/122690"} "Derek Drouin"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {} "2.29 (=1)"] [:td {} "2.38 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "2878"] [:td {} [:a {:href "/athletes/124789"} "Mutaz Essa Barshim"]] [:td {} [:a {:href "/countries/QAT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/QAT.png"}] "QAT"]] [:td {} "2.29 (=1)"] [:td {} "2.36 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "3026"] [:td {} [:a {:href "/athletes/122551"} "Bohdan Bondarenko"]] [:td {} [:a {:href "/countries/UKR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UKR.png"}] "UKR"]] [:td {} "2.29 (=1)"] [:td {} "2.33 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=4"] [:td {:class "bib"} "3032"] [:td {} [:a {:href "/athletes/122550"} "Andriy Protsenko"]] [:td {} [:a {:href "/countries/UKR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UKR.png"}] "UKR"]] [:td {} "2.29 (=7)"] [:td {} "2.33 (=4)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=4"] [:td {:class "bib"} "2456"] [:td {} [:a {:href "/athletes/124070"} "Robbie Grabarz"]] [:td {} [:a {:hre