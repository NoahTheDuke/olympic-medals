 kilometres, Men"] "\n" [:option {:value "1939"} "4 × 10 kilometres Relay, Men"] "\n" [:option {:value "1943"} "5 kilometres, Women"] "\n" [:option {:value "1944"} "10 kilometres, Women"] "\n" [:option {:value "1945"} "3 × 5 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1890"} "1924"] "\n" [:option {:value "1892"} "1928"] "\n" [:option {:value "1894"} "1932"] "\n" [:option {:value "1896"} "1936"] "\n" [:option {:value "1902"} "1948"] "\n" [:option {:value "1908"} "1952"] "\n" [:option {:value "1916"} "1956"] "\n" [:option {:value "1927"} "1960"] "\n" [:option {:value "1950"} "1968"] "\n" [:option {:value "1962"} "1972"] "\n" [:option {:value "1974"} "1976"] "\n" [:option {:value "1987"} "1980"] "\n" [:option {:value "2000"} "1984"] "\n" [:option {:value "2014"} "1988"] "\n" [:option {:value "2031"} "1992"] "\n" [:option {:value "2051"} "1994"] "\n" [:option {:value "2071"} "1998"] "\n" [:option {:value "2091"} "2002"] "\n" [:option {:value "2134"} "2006"] "\n" [:option {:value "923554"} "2010"] "\n" [:option {:value "350067"} "2014"] "\n" [:option {:value "9000278"} "2018"] "\n" [:option {:value "19019713"} "2022"] "\n" [:option {:value "15000134"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/187"} "Event type"]] [:h1 {:class "event_title"} "50 kilometres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 5 February 1964 — 8:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/59"} "Langlaufstadion, Seefeld"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1938"} "41 from 14 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: ?" [:br {}] "Height Differential: 196 m" [:br {}] "Intermediate 1: 10.0 km" [:br {}] "Intermediate 2: 25.0 km" [:br {}] "Intermediate 3: 35.0 km" [:br {}] "Maximum Climb: 98 m" [:br {}] "Total Climbing: 1,578 m"]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/86390"} "Sixten Jernberg"] " was definitively the king of the 50 km cross country in the late 1950-s and early 1960-s. He was World Champion in 1958 and 1962 and Olympic Champion in 1956. His only loss in a major championships was when he placed fifth in the 1960 Olympic Games. In the 1962 World Championships he won by a comfortable margin ahead of countryman " [:a {:href "/athletes/97051"} "Assar Rönnlund"] " and defending Olympic Champion " [:a {:href "/athletes/87281"} "Kalevi Hämälainen"] ". The 50 km was organized three days after the 15 km race and one day before Jernberg’s 35th birthday."] "\n\n" [:p {} "Hämälainen was in the lead after 10 km, 14 seconds ahead of " [:a {:href "/athletes/86266"} "Harald Grønningen"] " and with Rönnlund and Jernberg close behind. At the halfway point Hämälainen had increased his lead to 49 seconds, with Rönnlund now in second position and Jernberg close behind in third. At 35 km Hämälainen was apparently struggling, Jernberg now in second place was only 20 seconds behind. The Norwegian " [:a {:href "/athletes/99310"} "Einar Østby"] " was now in third place almost half a minute behind Jernberg, closely followed by " [:a {:href "/athletes/98265"} "Arto Tiainen"] ", an experienced Finnish skier (aged 33) competing in his third Olympics. Rönnlund was down in fifth place but still in contention for the medals, only 18 seconds behind Østby. Another Swede, " [:a {:href "/athletes/97794"} "Janne Stefansson"] ", was moving steadily ahead and had advanced to sixth place."] "\n\n" [:p {} "In the final part of the race defending champion Hämälainen “hit the wall” and lost almost 9 minutes to Jernberg in the last 15 km. He ended in sixteenth place. Jernberg had complete control over his opponents and finished in superb style, winning his third Olympic gold medal, over a minute ahead of team-mate Rönnlund, who after a good finish secured a Swedish double. A tired Tiainen snatched the bronze medal only six seconds ahead of Stefansson, preventing a clean sweep for the Swedes. The fastest finisher of all was the Norwegian favorite " [:a {:href "/athletes/97794"} "Sverre Stensheim"] ", winner of the Holmenkollen 50 km three times in a row (1959-1961). He advanced from a modest 13th place at the halfway point ending fifth, only 17 seconds from the bronze medal. Double Olympic Champion " [:a {:href "/athletes/95693"} "Eero Mäntyranta"] " was apparently tired after his two victories earlier in the week and ended up ninth."] "\n"] [:button {:id "button185923", :class "btn btn-default"} "Details"] [:script {} "$('#button185923').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "Intermediate 1"] [:th {:style "display: none", :class "split"} "Intermediate 2"] [:th {:style "display: none", :class "split"} "Intermediate 3"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "41"] [:td {} [:a {:href "/athletes/87535"} "Sixten Jernberg"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "2-43:52.6"] [:td {:class "split", :style "display: none"} "32:56 (4)"] [:td {:class "split", :style "display: none"} "1-19:19 (3)"] [:td {:class "split", :style "display: none"} "1-54:23 (2)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "18"] [:td {} [:a {:href "/at