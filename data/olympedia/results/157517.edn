ginal competition. The second final went off with three boats, and the race won comfortably by Hamburg’s Germania Ruder Club. Both finals are usually considered as valid Olympic events and the results listed in most medal standings for the 1900 Olympics."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Germania Ruder Club, Hamburg"] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/37824"} "Oscar Goßler"] " • " [:a {:href "/athletes/37874"} "Walther Katzenstein"] " • " [:a {:href "/athletes/38013"} "Waldemar Tietgens"] " • " [:a {:href "/athletes/37823"} "Gustav Goßler"] " • " [:a {:href "/athletes/37822"} "Carl Heinrich Goßler"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Minerva Amsterdam"] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/38991"} "Johannes Terwogt"] " • " [:a {:href "/athletes/38937"} "Paul Lotsij"] " • " [:a {:href "/athletes/38908"} "Coenraad Hiebendaal"] " • " [:a {:href "/athletes/38936"} "Geert Lotsij"] " • " [:a {:href "/athletes/38866"} "Hermanus Brockmann"]]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} "Ludwigshafener Ruder Verein"] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} [:span {:class "Bronze"} "Bronze"]