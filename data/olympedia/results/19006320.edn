n {:value "19006326"} "Kayak Singles, Slalom, Women"] "\n" [:option {:value "19006332"} "Canadian Singles, Slalom, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255414"} "1972"] "\n" [:option {:value "256033"} "1992"] "\n" [:option {:value "256163"} "1996"] "\n" [:option {:value "256278"} "2000"] "\n" [:option {:value "256395"} "2004"] "\n" [:option {:value "258824"} "2008"] "\n" [:option {:value "307000"} "2012"] "\n" [:option {:value "353542"} "2016"] "\n" [:option {:value "2008406"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/174"} "Event type"]] [:h1 {:class "event_title"} "Canadian Singles, Slalom, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "25 – 26 July 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2130"} "Kasai Canoe Slalom Centre, 1-1, Rinkaicho, Edogawa-ku, Tokyo, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19006320"} "18 from 18 countries"]]]]] [:div {:class "description"} [:p {} "Neither reigning Olympic champion " [:a {:href "/athletes/133830"} "Denis Gargaud Chanut"] " of France, nor his compatriot, the reigning World Champion Cédric Joly, competed; they were replaced by " [:a {:href "/athletes/142849"} "Martin Thomas"] ". Interestingly, out of the first six qualified nations from the World Championships, five sent different athletes to the Olympics. \nAlthough the Russian NOC did not qualify, their athlete, " [:a {:href "/athletes/135761"} "Pavel Eygel"] ", competed, having already earned a quota in the Men’s K-1 event. He finished 18th and last."] "\n\n" [:p {} "Only one former World Champion, the Slovenian " [:a {:href "/athletes/125768"} "Benjamin Savšek"] ", who was also a three-time European champion, participated in the event. Other favourites were the German " [:a {:href "/athletes/125329"} "Sideris Tasiadis"] ", the 2012 European champion and Olympic silver medallist the same year, and local favourite " [:a {:href "/athletes/116477"} "Haneda Takuya"] ", the Rio bronze medallist."] "\n\n" [:p {} "In the preliminary round on the first day of competition, the 2016 silver medallist, " [:a {:href "/athletes/135976"} "Matej Beňuš"] " from Slovakia, led, followed by " [:a {:href "/athletes/125768"} "Savšek"] " and the Briton " [:a {:href "/athletes/143126"} "Adam Burgess"] ". On the second day, only three athletes completed the course without penalties in the semi-finals, including " [:a {:href "/athletes/142849"} "Martin Thomas"] ", who was overall first. In the final, " [:a {:href "/athletes/125768"} "Savšek"] " who had finished only fifth in the semi-final, made an impressive run that eventually earned him the gold medal, the first for his country in this sport. The silver medal went to the Czech " [:a {:href "/athletes/142092"} "Lukáš Rohan"] ", and the bronze to " [:a {:href "/athletes/125329"} "Tasiadis"] ". Rohan was coached by his father, " [:a {:href "/athletes/9406"} "Jiri"] ", a two-time Olympic medallist in C-2 in 1992 and 1996. Savsek’s victory ended the 25-year domination of the Slovakian and French paddlers. The eighth-placed Spaniard " [:a {:href "/athletes/116473"} "Ander Elosegi"] ", and tenth-placed Haneda, were both competing in their fourth Olympics."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "3"] [:td {} [:a {:href "/athletes/125768"} "Ben