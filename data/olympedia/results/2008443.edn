n {:value "2008400"} "Kayak Singles, Slalom, Men"] "\n" [:option {:value "2008406"} "Canadian Singles, Slalom, Men"] "\n" [:option {:value "2008437"} "Kayak Singles, Slalom, Women"] "\n" [:option {:value "2008449"} "Kayak Cross, Slalom, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "19006332"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/2578"} "Event type"]] [:h1 {:class "event_title"} "Canadian Singles, Slalom, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "30 – 31 July 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2180"} "National Olympic Nautical Stadium d'Île-de-France, Vaires-sur-Marne, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2008443"} "21 from 21 countries"]]]]] [:div {:class "description"} [:p {} "This event was on the Olympic Programme for only the second time. " [:a {:href "/athletes/123753"} "Jess Fox"] " was the defending gold medalist and the favorite, and she did not disappoint, adding a gold medal in this event to the one she had already won in Paris in the kayak singles. The World Champion in the event in 2013, 2014, 2015, and 2018, she became only the third woman to defend a gold medal in an Olympic canoe slalom event, after " [:a {:href "/athletes/9386"} "Štěpánka Hilgertová"] " (CZE) in 1996-2000 and " [:a {:href "/athletes/10714"} "Elena Kaliská"] " (SVK) in 2004-2008 in kayak singles."] "\n\n" [:p {} [:a {:href "/athletes/142983"} "Mallory Franklin"] " (GBR) came in ranked #2 in the world in this event but struggled in the final and finished last of the 12 finalists. This opened up the medals, and Germany’s " [:a {:href "/athletes/151235"} "Elena Lilik"] " came through for the silver medal, although she had qualified only fifth and was seventh in the semi-finals. American " [:a {:href "/athletes/147158"} "Evy Leibfarth"] " took bronze in her second Olympic appearance, although she was only 20-years-old in Paris. Czechia’s " [:a {:href "/athletes/151207"} "Gabriela Satková"] " came in world ranked #3 and led the qualifying and the semi-finals but could finish only seventh in the final. Fox’s sixth Olympic medal moved her to the top of the medal list in canoe slalom, and her three Olympic gold medals have been matched only by " [:a {:href "/athletes/90175"} "Tony Estanguet"] " (FRA) and the Slovakian Hochschorner brothers, " [:a {:href "/athletes/90262"} "Pavel"] " and " [:a {:href "/athletes/90263"} "Peter"] "."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/123753"} "Jess Fox"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]] [:td {} "100.05 (2)"] [:td {} "106.08 (2)"] [:td {} "101.06 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "3"] [:td {} [:a {:href "/athletes/151235"} "Elena Lilik"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "103.29 (5)"] [:td {} "113.59 (7)"] [:td {} "103.54 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td