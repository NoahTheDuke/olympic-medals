ight: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Judge / Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004563"} "Tage Bergman"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Judge / Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004695"} " Ba Winn"]] [:td {} [:a {:href "/countries/MYA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/MYA.png"}] "MYA"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Judge / Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004719"} "V. Dumitrescu"]] [:td {} [:a {:href "/countries/ROU"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ROU.png"}] "ROU"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Judge / Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/2967"} "Valle Resko"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Judge / Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004759"} "Vicente Calace"]] [:td {} [:a {:href "/countries/UNK"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UNK.png"}] "UNK"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Judge / Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004824"} "W. Hanks"]] [:td {} [:a {:href "/countries/UNK"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UNK.png"}] "UNK"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Judge / Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004829"} "W. Schreiber"]] [:td {} [:a {:href "/countries/UNK"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UNK.png"}] "UNK"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Judge / Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004830"} "W. Than Yin"]] [:td {} [:a {:href "/countries/UNK"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UNK.png"}] "UNK"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Judge / Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004831"} "W. Van Eecken"]] [:td {} [:a {:href "/countries/BEL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BEL.png"}] "BEL"]]]]] [:div {:class "description"} [:p {} "The middleweight division was not short of quality and, as such, it was hard to predict which of the many talented boxers would earn the laurels. Europe was well represented by the reigning European champion, " [:a {:href "/athletes/3030"} "Aimé-Joseph Escudie"] " of France, and Ireland’s " [:a {:href "/athletes/3997"} "Mick McKeon"] ". Home favorite " [:a {:href "/athletes/3536"} "Johnny Wright"] ", a 19-year-old sailor with just a few months experience at this weight, beat the European silver medalist Wally Thom just to qualify for the British team. Hungary’s " [:a {:href "/athletes/3832"} "László Papp"] " had remained undefeated since a defeat to " [:a {:href "/athletes/8281"} "Július Torma"] " (who would win the " [:a {:href "/results/22352"} "welterweight"] " title in London] in 1947. Adding in the highly touted American " [:a {:href "/athletes/8705"} "Washington Jones"] " and the tough Uruguayan " [:a {:href "/athletes/8590"} "Dogomar Martínez"] ", the expectation of a memorable tournament was hard to suppress."] "\n\n" [:p {} "The first of the favorites to fall was Jones, victim of what was seen to be a harsh disqualification for “hitting with an open glove” against his Belgian opponent, " [:a {:href "/athletes/7515"} "Auguste Cavignac"] ", in a second round bout. Cavignac failed to last a round against Papp in the quarter-finals, but the other three bouts all went the full distance. The victory of Mick McKeon over Escudie was one of the most fiercely contested fights of the entire Games, both inside and outside of the ring. The French officials resigned in protest after the bout, after McKeon was awarded the win. The Irishman followed this with another brutal contest against Johnny Wright in the last four. Wright won the decision but both men were left bloodied and bruised. Papp came through his half of the draw with three overwhelming victories and was the fresher man for the final. Although he was not yet the fighter he would come to be in the next decade, the Hungarian was superior to the Englishman and would take his first Olympic title."] "\n\n" [:p {} "Bela Keri, trainer to both Papp and fellow Hungarian gold medalist " [:a {:href "/athletes/3788"} "Tibor Csík"] ", promised that, if both men took Olympic titles, he would jump fully clothed into the nearby swimming pool. The next morning, the Hungarian newspapers showed a very wet coach on their front page."] "\n\n" [:p {} "Bronze medalist " [:a {:href "/athletes/4114"} "Ivano Fontana"] " of Italy and the Dane " [:a {:href "/athletes/1711"} "Martin Hansen"] " went to achieve a modicum of success in the pro ranks."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:t