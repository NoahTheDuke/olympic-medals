6"} "2016"] "\n" [:option {:value "2013536"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/42"} "Event type"]] [:h1 {:class "event_title"} "400 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "1 –  5 August 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2106"} "Japan National Stadium, Kasumigaoka, Shinjuku, Tokyo"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19000394"} "48 from 33 countries"]]]]] [:div {:class "description"} [:p {} "There was no single favorite in this event but two runners, Bahamian " [:a {:href "/athletes/132635"} "Steven Gardiner"] " and American " [:a {:href "/athletes/147342"} "Michael Norman"] ", were expecting to fight it out for the gold medal. The defending champion and world record holder " [:a {:href "/athletes/135688"} "Wayde van Niekerk"] " (RSA) was also considered highly, but in October 2017 he had torn his anterior cruciate ligament playing football (soccer), and he was not back to his pre-injury level. Also expected to challenge for the medals were Grenadian " [:a {:href "/athletes/120724"} "Kirani James"] ", the 2012 London gold medalist and 2011 World Champion, and the 2018 Commonwealth Games Champion, " [:a {:href "/athletes/120888"} "Isaac Makwala"] " of Botswana."] "\n\n" [:p {} "All of the favorites save for van Niekerk made it to the final, where they were joined by another top American, " [:a {:href "/athletes/147341"} "Michael Cherry"] ". James had been especially impressive in winning his semi-final in 43.88, as Gardiner led the third semi-final over Norman and Makwala, with van Niekerk trailing and not qualifying."] "\n\n" [:p {} "In the final James and Norman were out fastest with James holding a narrow lead at the halfway mark, as Gardiner was a good three metres back. At 300 metres, James still led but Gardiner had closed on the final turn and was close. Gardiner passed James on the straight to win the gold medal, as James was also passed by the Colombian " [:a {:href "/athletes/133243"} "Anthony Zambrano"] ", who had been a silver medalist at the 2017 World Championships. Cherry finished fourth and Norman fifth as no Americans won a medal, unusual for the event, and Makwala was never a factor, placing seventh."] "\n\n" [:p {} "Gardiner won the first athletics gold medal for the Bahamas. For James, it was his third consecutive Olympics on the podium, completing his set of Olympic medals, after gold in 2012, and silver in 2016."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1136"] [:td {} [:a {:href "/athletes/132635"} "Steven Gardiner"]] [:td {} [:a {:href "/countries/BAH"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BAH.png"}] "BAH"]] [:td {} "45.05 (1 h5)"] [:td {} "44.14 (1 h3)"] [:td {} "43.85 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "1551"] [:td {} [:a {:href "/athletes/133243"} "Anthony Zambrano"]] [:td {} [:a {:href "/countries/COL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/COL.png"}] "COL"]] [:td {} "44.87 (1 h4)"] [:td {} "43.93 (2 h1)"] [:td {} "44.08 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "2235"] [:td {} [:a {:href "/athletes/120724"} "Kirani James"]] [:td {} [:a {:href "/countries/GRN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-fla