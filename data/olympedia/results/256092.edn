ion {:value "256080"} "Kayak Singles, 1,000 metres, Men"] "\n" [:option {:value "256104"} "Kayak Doubles, 1,000 metres, Men"] "\n" [:option {:value "256116"} "Kayak Fours, 1,000 metres, Men"] "\n" [:option {:value "256124"} "Canadian Singles, 500 metres, Men"] "\n" [:option {:value "256132"} "Canadian Singles, 1,000 metres, Men"] "\n" [:option {:value "256140"} "Canadian Doubles, 500 metres, Men"] "\n" [:option {:value "256152"} "Canadian Doubles, 1,000 metres, Men"] "\n" [:option {:value "256169"} "Kayak Singles, 500 metres, Women"] "\n" [:option {:value "256181"} "Kayak Doubles, 500 metres, Women"] "\n" [:option {:value "256193"} "Kayak Fours, 500 metres, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255468"} "1976"] "\n" [:option {:value "255607"} "1980"] "\n" [:option {:value "255701"} "1984"] "\n" [:option {:value "255809"} "1988"] "\n" [:option {:value "255953"} "1992"] "\n" [:option {:value "256226"} "2000"] "\n" [:option {:value "256337"} "2004"] "\n" [:option {:value "258763"} "2008"] "\n" [:option {:value "2008517"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/162"} "Event type"]] [:h1 {:class "event_title"} "Kayak Doubles, 500 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "31 July –  4 August 1996"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/718"} "Lake Sidney Lanier, Gainesville, Georgia"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/256092"} "46 from 23 countries"]]]]] [:div {:class "description"} [:p {} "Germany’s " [:a {:href "/athletes/9894"} "Kay Bluhm"] " and " [:a {:href "/athletes/9915"} "Torsten Gutsche"] " were the reigning Olympic champions, as well as the 1989, 1993, and 1994 World Champions, and were favored to defend their title at the 1996 Games, but they would have to deal with a challenge from Italy’s " [:a {:href "/athletes/10159"} "Beniamino Bonomi"] " and " [:a {:href "/athletes/10207"} "Daniele Scarpa"] ", the reigning World Champions. " [:a {:href "/athletes/10475"} "Maciej Freimut"] " of Poland, a 1992 Olympic runner-up, had a new partner in " [:a {:href "/athletes/10537"} "Adam Wysocki"] ", with whom he had been third in this event at the 1995 World Championships. Poland was second to Italy in the opening heats, while Germany and the Hungarian duo of " [:a {:href "/athletes/10042"} "Krisztián Bártfai"] " and " [:a {:href "/athletes/10061"} "Zsolt Gyulay"] ",the 1995 World runners-up, took a third heat. The Hungarians and Poles were then fourth and third in respectively in semi-final heats won by Italy and Germany. Hungary led the final for most of the course, but a flurry of activity saw them passed by five other nations, most notably Germany, who charged towards the finish line and managed to hold off the Italians by a mere 0.032 seconds to defend their title and get their revenge on Scarpa, who had helped deny them gold in the K-1 1000 (Bonomi had spent that day winning silver in the K-1 1000). Australia’s " [:a {:href "/athletes/8998"} "Danny Collins"] " and " [:a {:href "/athletes/9041"} "Andrew Trim"] ", meanwhile, were the surprise bronze medalists, stealing third place from Russians " [:a {:href "/athletes/10645"} "Oleg Goroby"] " and " [:a {:href "/athletes/10652"} "Anatoly Tishchenko"] " by 0.268 seconds."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Pair"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Rep"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:c