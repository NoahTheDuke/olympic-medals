value "308003"} "Individual Time Trial, Men"] "\n" [:option {:value "308001"} "Road Race, Individual, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "154919"} "1996"] "\n" [:option {:value "155046"} "2000"] "\n" [:option {:value "155176"} "2004"] "\n" [:option {:value "259029"} "2008"] "\n" [:option {:value "356867"} "2016"] "\n" [:option {:value "19001703"} "2020"] "\n" [:option {:value "2003683"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/243"} "Event type"]] [:h1 {:class "event_title"} "Individual Time Trial, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 1 August 2012 — 12:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/883"} "Hampton Court Palace, Richmond upon Thames, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/308002"} "24 from 16 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Distance: 29 km" [:br {}] "Intermediate 1: 9.1 km" [:br {}] "Intermediate 2: 20.4 km"]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/103695"} "Kristin Armstrong"] " of the United States (no relation to the famous " [:a {:href "/athletes/13434"} "Lance"] ") had been the winner of the individual time trial at the 2008 Summer Olympics and retired following her victory at the 2009 World Championships in order to start a family. She returned in 2011, however, with the goal of defending her Olympic title in 2012 and had strong performances in the time trial in the lead-up to the London Games. A fall that broke her collarbone just over two months before the Olympics, however, jeopardized her chances of competing in the event, but an accelerated recovery left her as the favorite for the top spot on the podium in 2012. Among her strongest challengers were Germany’s " [:a {:href "/athletes/13057"} "Judith Arndt"] ", the reigning World Champion who had been winning cycling medals since her Olympic individual pursuit bronze in 1996, and the Danish-born " [:a {:href "/athletes/113099"} "Linda Villumsen"] ", competing for New Zealand since 2010, who was the runner-up in the event at the 2011 World Championships. Also notable were " [:a {:href "/athletes/113075"} "Emma Pooley"] ", the 2008 Olympic runner-up and the host nation’s best chance for a medal in the event, and Canadian " [:a {:href "/athletes/13139"} "Clara Hughes"] ", vying to become her country’s most decorated Olympian after having won two cycling bronze medals at the 1996 Summer Olympics before switching to speed skating and earning four Olympic medals at the Winter Olympics between 2002 and 2010, including gold in the 5000m event in 2006. The Dutch cyclist " [:a {:href "/athletes/113070"} "Marianne Vos"] ", who just days before had won the road race and who, in 2008, had won the Olympic points race, could not be ignored either."] "\n\n" [:p {} "In a tough field it was once again the lower-ranked Russian " [:a {:href "/athletes/120531"} "Olga Zabelinskaya"] " who, after surprising spectators with a bronze medal win the road race over the weekend, set an incredibly high bar earlier on by finishing the course with a time of 37:57.35. Pooley, Hughes, and Villumsen all failed to best this mark and, with Vos having been overtaken by Arndt (thus making up the 90 second difference in their starts), Zabelinskaya’s time guaranteed her a medal. Arndt slid in at a comfortable seven seconds ahead of her Russian competitor, but Armstrong’s raw power never lapsed throughout the event and she arrived at the finish line over fifteen seconds faster than the German, easily defending her Olympic title."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Intermediate 1"] [:th {} "Intermediate 2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/103695"} "Kristin Armstrong"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "37:34.82"] [:td {} "13:56.38 (1)"] [:td {} "27:13.96 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "2"] [:td {} [:a {:href "/athletes/13057"} "Judith Arndt"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "37:50.29"] [:td {} "14:06.67 (5)"] [:td {} "27:21.38 (3)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "15"] [:td {} [:a {:href "/athletes/120531"} "Olga Zabelinskaya"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]] [:td {} "37:57.35"] [:td {} "14:13.72 (6)"] [:td {} "27:26.52 (4)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "4"] [:td {} [:a {:href "/athletes/113099"} "Linda Villumsen"]] [:td {} [:a {:href "/countries/NZL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NZL.png"}] "NZL"]] [:td {} "37:59.18"] [:td {} "13:57.89 (2)"] [:td {} "27:18.85 (2)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:t