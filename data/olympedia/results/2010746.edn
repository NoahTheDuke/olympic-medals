42"} "Min Suck-Hong"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]]] [:tr {:class "referees", :style ""} [:th {} "Execution Judges 3"] [:td {:style "width: 400px"} [:a {:href "/athletes/90619"} "Angelique Rodríguez"]] [:td {} [:a {:href "/countries/PUR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/PUR.png"}] "PUR"]]] [:tr {:class "referees", :style ""} [:th {} "Execution Judges 4"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003791"} "Nikolaos Touloudis"]] [:td {} [:a {:href "/countries/GRE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GRE.png"}] "GRE"]]] [:tr {:class "referees", :style ""} [:th {} "Execution Judges 5"] [:td {:style "width: 400px"} [:a {:href "/athletes/90609"} "Yeoh Ken Nee"]] [:td {} [:a {:href "/countries/MAS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/MAS.png"}] "MAS"]]] [:tr {:class "referees", :style ""} [:th {} "Execution Judges 6"] [:td {:style "width: 400px"} [:a {:href "/athletes/2000762"} "Ángel Luis Pérez"]] [:td {} [:a {:href "/countries/ESP"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ESP.png"}] "ESP"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronisation Judges 1"] [:td {:style "width: 400px"} [:a {:href "/athletes/45759"} "Barbara Bush"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronisation Judges 2"] [:td {:style "width: 400px"} [:a {:href "/athletes/2000763"} "Nataša Kolić Kadijević"]] [:td {} [:a {:href "/countries/CRO"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CRO.png"}] "CRO"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronisation Judges 3"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004164"} "Ricardo Bañuelos"]] [:td {} [:a {:href "/countries/MEX"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/MEX.png"}] "MEX"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronisation Judges 4"] [:td {:style "width: 400px"} [:a {:href "/athletes/1900064"} "Nóra Székffy"]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronisation Judges 5"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004892"} "William Lee"]] [:td {} [:a {:href "/countries/SGP"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SGP.png"}] "SGP"]]]]] [:div {:class "description"} [:p {} "Like all diving events, the Chinese were favorites for the gold medal. The dominant diving nation had previously won the event all but once at both the Olympics and World Championships, with Russia winning the sole non-Chinese gold on both occasions. China’s entrants " [:a {:href "/athletes/151701"} "Chang Yani"] " and " [:a {:href "/athletes/151702"} "Chen Yiwen"] " were the 2022, 2023, and 2024 Doha World champions, with Chang also having won the 2017 title (with " [:a {:href "/athletes/129588"} "Shi Tingmao"] "). Diving first, Chang and Chen took the lead from the start and were never seriously threatened, recording the best marks in all five dives."] "\n\n" [:p {} "The competition for the other medals was much closer. The British duo ranked second after one dive, but a poorly executed first optional dive dropped them back to sixth. Meanwhile, the American pair of " [:a {:href "/athletes/151751"} "Sarah Bacon"] " and " [:a {:href "/athletes/132075"} "Kassidy Cook"] " recorded the same score as the Chinese in dive two, and they moved up to second place. The experienced Australian divers " [:a {:href "/athletes/128983"} "Maddison Keeney"] " and " [:a {:href "/athletes/123765"} "Anabelle Smith"] " (silver in Doha) had a poor first dive (sixth), but recorded three great scores to move up to third after four dives, less than a point behind the Americans."] "\n\n" [:p {} "In their final dive, however, Australia’s Smith almost missed the board. She did manage to complete the routine, but collected the lowest score of the round, and instead of silver or bronze, it moved them back to fifth. The Britons " [:a {:href "/athletes/151721"} "Yasmin Harper"] " and " [:a {:href "/athletes/142993"} "Scarlett Mew Jensen"] " benefited from the mistake, taking the bronze, as they had done at the 2024 World Championships."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Points"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "People's Republic of China"] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} "337.68"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "9"} [:a {:href "/athletes/151701"} "Chang Yani"] " • " [:a {:href "/athletes/151702"} "Chen Yiwen"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "314.64"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {