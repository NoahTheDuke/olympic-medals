lue "307012"} "Canadian Doubles, Slalom, Men"] "\n" [:option {:value "307020"} "Kayak Singles, Slalom, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255411"} "1972"] "\n" [:option {:value "256030"} "1992"] "\n" [:option {:value "256160"} "1996"] "\n" [:option {:value "256271"} "2000"] "\n" [:option {:value "256388"} "2004"] "\n" [:option {:value "258816"} "2008"] "\n" [:option {:value "353502"} "2016"] "\n" [:option {:value "19006314"} "2020"] "\n" [:option {:value "2008400"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/167"} "Event type"]] [:h1 {:class "event_title"} "Kayak Singles, Slalom, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "29 July –  1 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/869"} "Lee Valley White Water Centre, Waltham Cross"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/307006"} "22 from 22 countries"]]]]] [:div {:class "description"} [:p {} "Neither the 2008 Olympic champion or runner-up, Germany’s " [:a {:href "/athletes/116496"} "Alexander Grimm"] ", nor France’s " [:a {:href "/athletes/105123"} "Fabien Lefèvre"] " respectively, returned to defend their medals at the 2012 Summer Games. Grimm’s spot was taken by " [:a {:href "/athletes/125319"} "Hannes Aigner"] ", who had defeated the gold medalist in the trials for the Olympics, while Lefèvre met the same fate at the hands of " [:a {:href "/athletes/124654"} "Etienne Daille"] ". Crowd favorite " [:a {:href "/athletes/105126"} "Benjamin Boukpeti"] ", the bronze medalist from 2008 and the first person to win an Olympic medal for Togo, did return, but was not viewed as a significant threat. This left the field somewhat more open, although Slovenia’s " [:a {:href "/athletes/116494"} "Peter Kauzer"] ", World Champion in 2009 and 2011, and " [:a {:href "/athletes/116495"} "Daniele Molmenti"] ", the 2010 World Champion, were seen as having an advantage in the field."] "\n\n" [:p {} "Aigner had the fastest time in the heats and the second-fastest in the semi-finals, although he dropped to fifth place after hitting a gate and incurring a two-second penalty. Kauzer won the semi-finals handily, emerging victorious even after a two-second penalty of his own. Boukpeti survived to the finals as well, but incurred 52 seconds worth of penalties after missing, and later hitting, a gate in a final run that would not have earned a medal even if it had been flawless. The Czech Republic’s " [:a {:href "/athletes/116498"} "Vavřinec Hradílek"] " was only the third man to descend the course in the final, but managed a near flawless run that eventually garnered him a silver medal, bettering his 11th-place finish of 2008 and earning his country’s first medal of the Games. Only Molmenti bested his time, winning Italy’s first gold medal in canoe slalom since " [:a {:href "/athletes/10178"} "Pierpaolo Ferrazzi’s"] " victory at the 1992 Games in the kayak singles, while Aigner took home the bronze."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "3"] [:td {} [:a {:href "/athletes/116495"} "Daniele Molmenti"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} "88.68 (9)"] [:td {} "96.37 (3)"] [:td {} "93.43 (1