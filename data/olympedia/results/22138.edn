22014"} "Bantamweight (≤118 pounds), Men"] "\n" [:option {:value "22044"} "Featherweight (≤126 pounds), Men"] "\n" [:option {:value "22075"} "Lightweight (≤135 pounds), Men"] "\n" [:option {:value "22107"} "Welterweight (≤147 pounds), Men"] "\n" [:option {:value "22163"} "Light-Heavyweight (≤175 pounds), Men"] "\n" [:option {:value "22191"} "Heavyweight (&gt;175 pounds), Men"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "21223"} "1904"] "\n" [:option {:value "21263"} "1908"] "\n" [:option {:value "21390"} "1920"] "\n" [:option {:value "21593"} "1924"] "\n" [:option {:value "21801"} "1928"] "\n" [:option {:value "21946"} "1932"] "\n" [:option {:value "22384"} "1948"] "\n" [:option {:value "22691"} "1952"] "\n" [:option {:value "22927"} "1956"] "\n" [:option {:value "23236"} "1960"] "\n" [:option {:value "23565"} "1964"] "\n" [:option {:value "23930"} "1968"] "\n" [:option {:value "24340"} "1972"] "\n" [:option {:value "24746"} "1976"] "\n" [:option {:value "25093"} "1980"] "\n" [:option {:value "25478"} "1984"] "\n" [:option {:value "25972"} "1988"] "\n" [:option {:value "26385"} "1992"] "\n" [:option {:value "26829"} "1996"] "\n" [:option {:value "27265"} "2000"] "\n" [:option {:value "27627"} "2004"] "\n" [:option {:value "258458"} "2008"] "\n" [:option {:value "305259"} "2012"] "\n" [:option {:value "356522"} "2016"] "\n" [:option {:value "19005748"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/152"} "Event type"]] [:h1 {:class "event_title"} "Middleweight (≤160 pounds), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "11 – 15 August 1936"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/316"} "Deutschlandhalle, Berlin"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/22138"} "19 from 19 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single elimination tournament."]]]] [:div {:class "description"} [:p {} "One of the hot favorites for the Olympic title never reached the ring. " [:a {:href "/athletes/1005580"} "Irving Pease"] " of Canada was considered the best fighter from outside Europe, but failed to make the required weight amidst allegations from the Canadian delegation that he had treated the trip to Berlin as a mere “joyride”."] "\n\n" [:p {} "When the competition got underway, the crowd saw the first ever Chinese boxer take part in Olympic competition, although his début was a brief one. " [:a {:href "/athletes/1290"} "Jin Guidi"] " was knocked out in the opening round of his first bout, but his opponent, " [:a {:href "/athletes/3495"} "Richard Shrimpton"] " of Britain, was then disqualified for not obeying the referee’s instructions prior to the knockout blow. Unfortunately for the Chinese boxer, the decision was reversed the next day."] "\n\n" [:p {} "Two other boxers who failed to record a victory were the reigning European champion, " [:a {:href "/athletes/3841"} "Lajos Szigeti"] " of Hungary, and the " [:a {:href "/results/21925"} "welterweight bronze medalist from Los Angeles"] ", Finland’s " [:a {:href "/athletes/2925"} "Bruno Ahlberg"] ". Both were defeated in the second series, having drawn byes in the first round of competition. The Norwegian fighter " [:a {:href "/athletes/4864"} "Henry Tiller"] " moved through the rounds, and his countrymen began seeing him as a prospective champion when he defeated the champions of South Africa, England, and Germany in succession, and then knocked down " [:a {:href "/athletes/7706"} "Henryk Chmielewski"] " of Poland “at least half a dozen” times to gain a place in the gold medal match. The Norwegians were to be disappointed by a stylish French boxer by the name of " [:a {:href "/athletes/3022"} "Jean Despeaux"] ". Despeaux varied his punches and style of fighting during the final and avoided the harder punches of Tiller. The Frenchman’s speed of hand became the deciding factor, as the final was fought at a distance."] "\n\n" [:p {} "When the two men met again later in the year, Tiller beat Despeaux in contests in both Trondheim and Oslo. Despeaux turned professional and continued to box during the German occupation. He held the national middleweight twice between 1941 and 1945. After the war, he had a brief career acting in French movies. Tiller stayed as an amateur and dominated Norwegian boxing. He even claimed the British ABA championship in 1938 - a rarity for a fighter from outside Britain and Ireland, and unique for a Norwegian. He would have been one for the favorites if the " [:a {:href "/editions/51"} "1940 Games"] " had gone ahead. With the lure of an Olympic title gone, he opted for a professional career, which ended prematurely after the German invasion of Norway."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/3022"} "Jean Despeaux"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/4864"} "Henry Tiller"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href