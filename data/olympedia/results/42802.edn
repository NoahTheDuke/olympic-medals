ue "42840"} "Doubles, Women"] "\n" [:option {:value "42878"} "Doubles, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "900340"} "1972"] "\n" [:option {:value "90016756"} "1988"] "\n" [:option {:value "42107"} "1992"] "\n" [:option {:value "42323"} "1996"] "\n" [:option {:value "42579"} "2000"] "\n" [:option {:value "258065"} "2008"] "\n" [:option {:value "304111"} "2012"] "\n" [:option {:value "351671"} "2016"] "\n" [:option {:value "19005318"} "2020"] "\n" [:option {:value "2005717"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/125"} "Event type"]] [:h1 {:class "event_title"} "Singles, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "14 – 19 August 2004"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/783"} "Olympiako Gymnastirio Goudiou, Olympiako Syngrotima Goudiou, Athina"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/42802"} "32 from 21 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament."]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/105905"} "Zhang Ning"] " had been on the Chinese National team since 1991, but had not yet competed at the Olympics. She was the 2003 World Champion and was seeded #1 in Athina. She made it to the final despite losing sets in both the first round and the quarter-finals. There she met " [:a {:href "/athletes/248"} "Mia Audina"] " representing the Netherlands. Audina had been a badminton prodigy, competing in the Uber Cup when she was only 14 in 1994, at which time she competed for her native Indonesia. She was the singles silver medalist in 1996. She had since married a Dutch gospel singer and settled in the Netherlands, representing them at the 2000 and 2004 Olympics. Zhang and Audina had first competed against each other at the 1994 Uber Cup, with Audina winning the final match of the final in front of a very partisan crowd in Jakarta. The first set of the Athina final was similar, Audina winning 11-8. But Zhang persevered and won the last two sets to win the gold medal. The bronze medal match was an all-Chinese affair, " [:a {:href "/athletes/105898"} "Zhou Mi"] " defeating " [:a {:href "/athletes/105881"} "Gong Ruina"] "."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/105905"} "Zhang Ning"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/248"} " Mia Audina"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/105898"} "Zhou Mi"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/105881"} "Gong Ruina"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "