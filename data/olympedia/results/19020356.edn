"https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]]] [:tr {:class "referees", :style ""} [:th {} "Judge C"] [:td {:style "width: 400px"} [:a {:href "/athletes/1500050"} "Dan Mattoon"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge D"] [:td {:style "width: 400px"} [:a {:href "/athletes/1500048"} "Jørn Larsen"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]]] [:tr {:class "referees", :style ""} [:th {} "Judge E"] [:td {:style "width: 400px"} [:a {:href "/athletes/1500046"} "Liang Bing"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]]] [:tr {:class "referees", :style ""} [:th {} "Judge SC"] [:td {:style "width: 400px"} [:a {:href "/athletes/1500049"} "Vadim Lisovsky"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]]]]] [:div {:class "description"} [:p {} "The pre-tournament favourites were Germany and Norway, with Austria as an outside chance of the title. Norway had won the World Championship team prize in both 2019 and 2021, while Germany were the reigning Olympic Champions from PyeongChang 2018."] "\n\n" [:p {} "The ski jumping element of the competition was pretty close with the three favourites being close together, and with Japan within 12 seconds. France was fifth, almost one and a half minutes behind. The best jumper was Austrian " [:a {:href "/athletes/136738"} "Franz-Josef Rehrl"] ", ahead of his countryman " [:a {:href "/athletes/147869"} "Johannes Lamparter"] " and the German " [:a {:href "/athletes/148432"} "Julian Schmid"] ". The German veteran " [:a {:href "/athletes/119468"} "Eric Frenzel"] " was back on the team after his Covid quarantine, and he replaced another veteran " [:a {:href "/athletes/119470"} "Johannes Rydzek"] "."] "\n\n" [:p {} "Austria’s Rehrl went out hard at the front on the first leg, but at the end of the leg just four seconds separated the first four teams. It remained close on the second lap. Germany put Frenzel on to contest the third leg. Normally regarded as one of the best skiers it was, however, the Norwegian " [:a {:href "/athletes/148708"} "Jens Lurås Oftebro"] " who showed his strength on this leg and built up a 10-second lead after his 5 km, on what was the fastest leg of the day. Norway led ahead of Japan and Austria, with Germany 30 seconds behind after Frenzel had “hit the wall”."] "\n\n" [:p {} "Norway had the double medallist " [:a {:href "/athletes/128220"} "Jørgen Graabak"] " to go on the last leg, and it soon became apparent to the other teams that the fight for gold was over and there were just the other medal places to fight for. Germany’s " [:a {:href "/athletes/137317"} "Vinzenz Geiger"] ", the Normal Hill/10km champion, set off hard and got level with Japan and Austria after about 17 km. After the first lap of the last leg, Norway had amassed a 43-second lead, and the three teams behind focussed on the battle for silver."] "\n\n" [:p {} "Entering the stadium Geiger started to break away but Yamamoto stayed with him. Austria faded slightly and in the final 100 metres, Yamamoto fought hard to catch Geiger but could not get up for the silver and they had to settle for bronze. However, it was Norway who reigned supreme in Nordic Combined at Beijing 2022, as they won two gold and two silver medals with Jørgen Graabak personally collecting two golds and a silver."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time Margi