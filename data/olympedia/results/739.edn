"} "1,500 metres, Men"] "\n" [:option {:value "773"} "5,000 metres Relay, Men"] "\n" [:option {:value "779"} "500 metres, Women"] "\n" [:option {:value "799"} "1,000 metres, Women"] "\n" [:option {:value "819"} "1,500 metres, Women"] "\n" [:option {:value "832"} "3,000 metres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "905307"} "1988"] "\n" [:option {:value "481"} "1992"] "\n" [:option {:value "555"} "1994"] "\n" [:option {:value "647"} "1998"] "\n" [:option {:value "857"} "2006"] "\n" [:option {:value "923676"} "2010"] "\n" [:option {:value "350707"} "2014"] "\n" [:option {:value "9001121"} "2018"] "\n" [:option {:value "19020481"} "2022"] "\n" [:option {:value "15000901"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/544"} "Event type"]] [:h1 {:class "event_title"} "1,000 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "13 – 16 February 2002"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/132"} "Salt Lake Ice Center, Salt Lake City, Utah"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/739"} "32 from 20 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Placements 1-8 based on final and B final.  Deeper placements based on points earned in earlier rounds, and time in final round skated."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/647"} "1:29.398"] " / " [:a {:href "/athletes/98202"} "Satoru Terao"] " " [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"] " / 17 February 1998 / " [:a {:href "/records/event_name/544"} "Details"]]]]] [:div {:class "description"} [:p {} "The story of the 1,000 m short track was not with one of the favorites, but with an Australian outsider, " [:a {:href "/athletes/84320"} "Steven Bradbury"] ". A veteran of two Winter Olympics, he’d won a bronze medal with the Australian relay team in 1994, and had been a relay World Champion in 1991. But by 2002, Bradbury was no longer considered a factor. His participation in Salt Lake City was remarkable already, having broken two neck vertebrae in a training crash in late 2000."] "\n\n" [:p {} "Bradbury easily survived the heats, but appeared to go out in the quarter-finals until star skater " [:a {:href "/athletes/85904"} "Marc Gagnon"] " was disqualified for obstructing a Japanese rival, which allowed the Australian to advance. A similar situation occurred in the semi-finals, when Bradbury was in third place when the defending champion, " [:a {:href "/athletes/100242"} "Kim Dong-Seong"] ", collided with " [:a {:href "/athletes/98202"} "Satoru Terao"] ", eliminating them both. Bradbury again advanced for an unexpected spot in the final. That appeared the best he could do, as the other four finalists quickly distanced themselves from Bradbury. In the very last curve, crowd favorite " [:a {:href "/athletes/101555"} "Apolo Anton Ohno"] " and " [:a {:href "/athletes/89605"} "Li Jiajun"] " of China collided, taking " [:a {:href "/athletes/101556"} "Mathieu Turcotte"] " and " [:a {:href "/athletes/101557"} "An Hyeon-Su"] " with them. With the rest of field laying scattered on the ice, Bradbury crossed the line first. As he raised his arms in disbelief, the others scrambled to get up and cross the line, Ohno throwing his skate over the line first, followed by Turcotte."] "\n\n" [:p {} "Bradbury’s surprise victory was Australia’s first ever gold medal in the Winter Olympics, and it made him a celebrity in his home country. Just days after the final, Australia Post issued a stamp with his likeness, and “doing a Bradbury” entered Australian vocabulary as a term for a miraculous victory."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Helmet Nr"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Best Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "300"] [:td {} [:a {:href "/athletes/84320"} "Steven Bradbury"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "369"] [:td {} [:a {:href "/athletes/101555"} "Apolo Anton Ohno"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "319"] [:td {} [:a {:href "/athletes/101556"} "Mathieu Turcotte"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "348"] [:td {} [:a {:href "/athletes/101557"} "Hyeon-Su An"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [