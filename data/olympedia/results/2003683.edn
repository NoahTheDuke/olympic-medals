lue "2003681"} "Individual Time Trial, Men"] "\n" [:option {:value "2003682"} "Road Race, Individual, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "154919"} "1996"] "\n" [:option {:value "155046"} "2000"] "\n" [:option {:value "155176"} "2004"] "\n" [:option {:value "259029"} "2008"] "\n" [:option {:value "308002"} "2012"] "\n" [:option {:value "356867"} "2016"] "\n" [:option {:value "19001703"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/243"} "Event type"]] [:h1 {:class "event_title"} "Individual Time Trial, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "27 July 2024 — 14:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2171"} "Trocadéro (Pont d'Iéna), Paris, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2003683"} "35 from 26 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Distance: 32.4 km" [:br {}] "Intermediate 1: 13.1 km" [:br {}] "Intermediate 2: 22 km"]]]] [:div {:class "description"} [:p {} "The time trial race started and finished on the Pont d’Iéna bridge that spans the River Seine. The 32.4-kilometre course consisted of one loop of Paris and the surrounding areas. The 35 riders started the race, which took place in hazardous conditions on rain-soaked streets."] "\n\n" [:p {} "None of the three medalists from the Tokyo Games were on the start line in Paris. Defending champion " [:a {:href "/athletes/121890"} "Annemiek van Vleuten"] " (NED) had retired at the end of the 2023 season. Silver medalist " [:a {:href "/athletes/146639"} "Marlen Reusser"] " (SUI) was ruled out due to health issues, and bronze medalist " [:a {:href "/athletes/131139"} "Anna van der Breggen"] " (NED) had also announced her retirement prior to the Olympics. A strong field of favorites emerged, which included " [:a {:href "/athletes/145459"} "Demi Vollering"] " (NED), " [:a {:href "/athletes/129144"} "Lotte Kopecky"] " (BEL), " [:a {:href "/athletes/132066"} "Chloé Dygert"] " (USA), " [:a {:href "/athletes/140603"} "Grace Brown"] " (AUS), and " [:a {:href "/athletes/151499"} "Anna Henderson"] " (GBR)."] "\n\n" [:p {} "Grace Brown went on to win the race to become the first Australian cyclist to win gold in the individual time trial. Brown finished more than 90 seconds ahead of Great Britain’s Anna Henderson, who herself finished less than a second ahead of Chloé Dygert. Dygert was on pace to win at least silver, and possibly gold, but suffered a crash during the second half of the course. Despite the treacherous conditions, all 35 cyclists finished the course."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Intermediate 1"] [:th {} "Intermediate 2"] [:th {} "Split 1-2"] [:th {} "Split 2-Finish"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "2"] [:td {} [:a {:href "/athletes/140603"} "Grace Brown"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]] [:td {} "39:38.24"] [:td {} "16:02.34 (1)"] [:td {} "27:08.88 (1)"] [:td {} "11:06.54 (1)"] [:td {} "12:29.36 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "4"] [:td {} [:a {:href "/athletes/151499"} "Anna Henderson"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :s