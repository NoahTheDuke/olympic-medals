257670"} "High Jump, Women"] "\n" [:option {:value "257692"} "Pole Vault, Women"] "\n" [:option {:value "9030952"} "Long Jump, Women"] "\n" [:option {:value "9030966"} "Triple Jump, Women"] "\n" [:option {:value "257754"} "Shot Put, Women"] "\n" [:option {:value "257771"} "Discus Throw, Women"] "\n" [:option {:value "257788"} "Hammer Throw, Women"] "\n" [:option {:value "257805"} "Javelin Throw, Women"] "\n" [:option {:value "257822"} "Heptathlon, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "302175"} "2012"] "\n" [:option {:value "359093"} "2016"] "\n" [:option {:value "19000767"} "2020"] "\n" [:option {:value "2013937"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/700"} "Event type"]] [:h1 {:class "event_title"} "3,000 metres Steeplechase, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "15 – 17 August 2008"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/813"} "Beijing Guojia Tiyuchang, Beijing Aolinpike Gongyuan, Beijing"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/257653"} "51 from 30 countries"]]]]] [:div {:class "description"} [:p {} "This was the inaugural steeplechase event at the Olympics for women, but the event had been held at the World Championships in 2005 and 2007. In the heats the newness of the event was evident when one runner fell face-first into the water jump. The 2007 champion was " [:a {:href "/athletes/114459"} "Yekaterina Volkova"] " but the world record holder was her teammate " [:a {:href "/athletes/104993"} "Gulnara Samitova-Galkina"] ", who had set it back in 2004. Samitova-Galkina had run at the Athina Olympics in the 5K, placing sixth. In the final, Samitova-Galkina took the lead early and pulled along four other runners – " [:a {:href "/athletes/114444"} "Tatyana Petrova"] " (RUS), " [:a {:href "/athletes/114458"} "Eunice Jepkorir"] " (KEN), " [:a {:href "/athletes/114422"} "Ruth Bisibori"] " (KEN), and " [:a {:href "/athletes/114460"} "Zemzem Ahmed"] " (ETH). After 1,000 metres only Petrova and Jepkorir remained with Samitova-Galkina, but at 2K, she was running alone. She won by half the final straight in 8:58.81, a world record, and became the first woman to break 9-minutes for the steeple. Jepkorir held on for the silver medal. Volkova had not been a factor early, but caught the chase group at the bell, and was able to pull away for the bronze medal."] "\n\n" [:p {} "That was how the event and the results seemed to have ended. In 2015, however, the IOC began re-testing samples from the 2008 Beijing and 2012 London Olympics, using newer, more advanced testing techniques, in an effort to find those who had used performance enhancing drugs (PEDs), but in whom it could not be detected at the time of those Olympics. This was one of the many events affected."] "\n\n" [:p {} "In October 2016 " [:a {:href "/athletes/114459"} "Yekaterina Volkova"] " of Russia was revealed to have a positive re-test for turinabol (dehydrochloromethyltestosterone), and was disqualified, losing her bronze medal, which was re-assigned to her teammate, " [:a {:href "/athletes/94692"} "Tatyana Petrova"] "."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "2783"] [:td {} [:a {:href "/athletes/104993"} "Gulnara Galkina"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle",