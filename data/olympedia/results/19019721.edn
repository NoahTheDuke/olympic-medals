option {:value "19019712"} "15 kilometres (Classical), Men"] "\n" [:option {:value "19019713"} "50 kilometres (Mass Start, Freestyle), Men"] "\n" [:option {:value "19019714"} "30 kilometres Skiathlon, Men"] "\n" [:option {:value "19019715"} "4 × 10 kilometres Relay, Men"] "\n" [:option {:value "19019716"} "Team Sprint (Classical), Men"] "\n" [:option {:value "19019733"} "10 kilometres (Classical), Women"] "\n" [:option {:value "19019734"} "30 kilometres (Mass Start, Freestyle), Women"] "\n" [:option {:value "19019735"} "15 kilometres Skiathlon, Women"] "\n" [:option {:value "19019736"} "4 × 5 kilometres Relay, Women"] "\n" [:option {:value "19019737"} "Team Sprint (Classical), Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "2114"} "2002"] "\n" [:option {:value "2162"} "2006"] "\n" [:option {:value "923583"} "2010"] "\n" [:option {:value "350075"} "2014"] "\n" [:option {:value "9000286"} "2018"] "\n" [:option {:value "15000142"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/193"} "Event type"]] [:h1 {:class "event_title"} "Sprint (Freestyle), Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 8 February 2022"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2138"} "Zhangjiakou Nordic Centre and Biathlon Centre, Chongli District, Zhangjiakou City, Hebei Province"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19019721"} "90 from 34 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Final standings based on time achieved in last round competed in."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 1,176 m" [:br {}] "Height Differential: 27 m" [:br {}] "Maximum Climb: 25 m" [:br {}] "Total Climbing: 43 m"]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/2300905"} "Jonna Sundling"] " and " [:a {:href "/athletes/148990"} "Maja Dahlqvist"] ", both first-time Olympians, finished 1-2 for Sweden in the women’s freestyle sprint final. Sundling secured gold having earlier won the world title quite comfortably, by almost three seconds, despite Dahlqvist winning three of the four sprints contested the season’s World Cup. Bronze in Beijing went to " [:a {:href "/athletes/128689"} "Jessie Diggins"] " from the USA."] "\n\n" [:p {} "Sundling dominated the event, clocking the best time in the qualification, and then winning her quarter-final as well as her semi-final. Dahlqvist only qualified as the fastest lucky loser in the first semi-final behind Sundling and the Swiss skier " [:a {:href "/athletes/138036"} "Nadine Fähndrich"] ". In the slower second semi-final, only " [:a {:href "/athletes/148993"} "Emma Ribom"] ", also from Sweden, and Jessie Diggins advanced to the final. The last Norwegian, 2018 silver medalist " [:a {:href "/athletes/118799"} "Maiken Caspersen Falla"] ", missed the final after a fourth place in the second semi."] "\n\n" [:p {} "The final consisted of three Swedes, two Americans (Diggins and " [:a {:href "/athletes/138267"} "Rosie Brennan"] "), and one Swiss. Sundling led from the start followed by her two team-mates. With 500 m to the finish, it was a 1-2-3 for Sweden, when Ribom lost her momentum and could not keep up with the pace. Sundling increased her lead and won by a margin rarely seen in world class sprint events. Dahlqvist just managed to hold Diggins at bay for the silver medal."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "QF"] [:th {} "SF"] [:th {} "Final"] [:th {}] 