"19020481"} "1,000 metres, Men"] "\n" [:option {:value "19020502"} "1,500 metres, Men"] "\n" [:option {:value "19020517"} "5,000 metres Relay, Men"] "\n" [:option {:value "19020545"} "1,000 metres, Women"] "\n" [:option {:value "19020566"} "1,500 metres, Women"] "\n" [:option {:value "19020581"} "3,000 metres Relay, Women"] "\n" [:option {:value "19020588"} "2,000 metres Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "905352"} "1988"] "\n" [:option {:value "510"} "1992"] "\n" [:option {:value "581"} "1994"] "\n" [:option {:value "673"} "1998"] "\n" [:option {:value "779"} "2002"] "\n" [:option {:value "896"} "2006"] "\n" [:option {:value "923719"} "2010"] "\n" [:option {:value "350750"} "2014"] "\n" [:option {:value "9001164"} "2018"] "\n" [:option {:value "15000944"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/547"} "Event type"]] [:h1 {:class "event_title"} "500 metres, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "5 –  7 February 2022"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/845"} "Shoudu Tiyguan, Beijing"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19020524"} "32 from 15 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Placements 1-8 based on final and B final.  Deeper placements based on placements in earlier rounds, and best time skated."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/9001164"} "42.422"] " / " [:a {:href "/athletes/137639"} "Choi Min-Jeong"] " " [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"] " / 13 February 2018 / " [:a {:href "/records/event_name/547"} "Details"]]]]] [:div {:class "description"} [:p {} "One of the medal contenders for the 500 m, Poland’s " [:a {:href "/athletes/137932"} "Natalia Maliszewska"] ", was unable to race in Beijing as she was still in quarantine due to a positive COVID19 test. Even more dramatically, 2019 World Champion " [:a {:href "/athletes/128175"} "Lara van Ruijven"] " (NED) had passed away in 2020 as the result of an autoimmune disease."] "\n\n" [:p {} "All of the other favorites were there: 2018 champion " [:a {:href "/athletes/109931"} "Arianna Fontana"] ", as well as her main rival and 2021 World Champion " [:a {:href "/athletes/137698"} "Suzanne Schulting"] ". In addition to Fontana, Schulting, and Maliszewska, the fourth skater to win a 500 m World Cup earlier in the season was Canada’s " [:a {:href "/athletes/136927"} "Kim Boutin"] ", also the 2018 bronze medalist."] "\n\n" [:p {} "There were no upsets in the heats, but the quarter-finals saw the surprise exit of 2018 World Champion " [:a {:href "/athletes/137639"} "Choi Min-Jeong"] ". Boutin led most of the first semi-final. At the bell, Fontana displayed her form by overtaking the Canadian on the outside, winning by a clear margin. Boutin held on for second, beating " [:a {:href "/athletes/148868"} "Yelena Seryogina"] " by half a blade. Schulting also impressed in her semi, opening a large gap right from the start and finishing unchallenged. Belgium’s " [:a {:href "/athletes/147886"} "Hanne Desmet"] " seemed to hold on for second, but was tripped by " [:a {:href "/athletes/136983"} "Qu Chunyu"] " and thus advanced to the final along with second-placed " [:a {:href "/athletes/148132"} "Zhang Yuting"] "."] "\n\n" [:p {} "The final had some trouble getting underway. After a false start, the field got underway, with Schulting and Fontana battling it out for the lead. The Italian fell, but as this was within the first half lap, the race was restarted again. Despite Fontana starting from the inside lane, it was Schulting leading after the first curve. But unlike the semi-finals, she was unable to build out that advantage, with Fontana remaining closely behind. With 1½ laps to go, the Italian made a decisive pass on the inside of Schulting, and Fontana held on to retain the title she won in 2018, making her the third athlete with back-to-back wins in the event. For Fontana, it was her 10th Olympic medal in the sport, a record. With Schulting in second and Boutin in third, the podium was very similar to PyeongChang, with only Schulting taking her compatriot " [:a {:href "/athletes/128174"} "Yara van Kerkhof"] "’s place in second."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Helmet Nr"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Position Last Race"] [:th {} "Positions"] [:th {} "Best Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "3"] [:td {} [:a {:href "/athletes/109931"} "Arianna Fontana"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} "AF-1"] [:td {} "1-1-1"] [:td {} "42.387"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/137698"} "Suzanne Schulting"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "AF-2"] [:td {} "1-1-1"] [:td {} "42.379"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "35"] [:td {} [:a {:h