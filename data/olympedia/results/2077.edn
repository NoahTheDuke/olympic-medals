en"] "\n" [:option {:value "2070"} "30 kilometres (Classical), Men"] "\n" [:option {:value "2071"} "50 kilometres (Freestyle), Men"] "\n" [:option {:value "2067"} "10/15 kilometres Pursuit, Men"] "\n" [:option {:value "2072"} "4 × 10 kilometres Relay, Men"] "\n" [:option {:value "2076"} "5 kilometres (Classical), Women"] "\n" [:option {:value "2080"} "15 kilometres (Classical), Women"] "\n" [:option {:value "2081"} "30 kilometres (Freestyle), Women"] "\n" [:option {:value "2082"} "4 × 5 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "2037"} "1992"] "\n" [:option {:value "2057"} "1994"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/201"} "Event type"]] [:h1 {:class "event_title"} "5/10 kilometres Pursuit, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "10 February 1998"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/80"} "Snow Harp, Hakuba"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2077"} "69 from 25 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "5 kilometres (Classical) style race on day one. On day two, runners left in order of their finish in the 5 kilometres (Classical), based on time differential, and skiied 10 kilometres (Freestyle), with final placements determined by finish of that race."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 10,000 m" [:br {}] "Height Differential: 57 m" [:br {}] "Maximum Climb: 51 m" [:br {}] "Total Climbing: 378 m"]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/81634"} "Larisa Lazutina"] " had won the 5 km classical three days earlier in a driving snow. The freestyle pursuit was held in a heavy rain. Lazutina, the 1995 World Champion, started first, with a 5-second lead over " [:a {:href "/athletes/81928"} "Kateřina Neumannová"] ". Neumannová chased hard, but could never catch the Russian, who won her second gold medal in Hakuba. Near the end of the pursuit, her teammate, " [:a {:href "/athletes/80915"} "Olga Danilova"] " passed Neumannová and won the silver medal. Danilova would later add two golds in Hakuba, winning the 15 km and skiing on the winning Russian relay team with Lazutina. Lazutina won five medals in 1998, including three golds. Four years later, things would not be as good for the Russian lasses, as both were disqualified in Salt Lake City for doping, when their tests were positive for darbopoietin, an erythropoietin analogue. Neumannová would fare better, adding two silver medals in 2002 and a gold and silver in 2006, giving her six Winter Olympic medals, all in individual events. She also competed in mountain biking at the 1996 Atlanta Olympics, finishing 18th."] "\n"] [:button {:id "button129942", :class "btn btn-default"} "Details"] [:script {} "$('#button129942').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "Start Behind"] [:th {:style "display: none", :class "split"} "Race"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/81634"} "Larisa Lazutina"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]] [:td {} "28:29.9"] [:td {:class "split", :style "display: none"} "—"] [:td {:class "split", :style "display: none"} "28:29.9 (5)"] [:td {} [:span {:class "G