 "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5001695"} "Daniel Cabelduc"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]]]]] [:div {:class "description"} [:p {} "There were many favorites for the first Olympic mass start title. The reigning world champion was " [:a {:href "/athletes/128784"} "Joey Mantia"] ", bringing his skills from the sport of inline skating. His predecessor was " [:a {:href "/athletes/119690"} "Lee Seung-Hun"] ", leader in the World Cup standings and 2010 Olympic champion in the 10,000 m as well as the home favorite. The list of medal contenders was long, though, and included among others " [:a {:href "/athletes/127962"} "Andrea Giovannini"] ", " [:a {:href "/athletes/138108"} "Livio Wenger"] ", " [:a {:href "/athletes/127397"} "Bart Swings"] ", " [:a {:href "/athletes/137776"} "Peter Michael"] ", " [:a {:href "/athletes/119653"} "Alexis Contin"] " and " [:a {:href "/athletes/128173"} "Koen Verweij"] "."] "\n\n" [:p {} "Most of the contenders survived the tactical semi-finals, although the elimination of 5,000 m bronze medallist " [:a {:href "/athletes/128237"} "Sverre Lunde Pedersen"] " was a surprise. In the final, Wenger and " [:a {:href "/athletes/137072"} "Viktor Hald Thorup"] " staged an attack after 6 laps, gaining some 75 m on the pack. Skating in service of Lee, " [:a {:href "/athletes/137636"} "Chung Jae-Won"] " caught the attackers. With three laps to go, 4-time Olympic champion " [:a {:href "/athletes/109681"} "Sven Kramer"] " launched an attack, with the intent of either personal gain or launching his team mate Verweij. Kramer was caught by small group, led by Swings but including Lee and Verweij. The Korean was by far the strongest in the resulting sprint, to the delight of the home crowd. Swings placed second to win Belgium’s first Winter Olympic medal in 20 years, while Verweij held on for the bronze."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/119690"} "Lee Seung-Hun"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} "16 (6 h1)"] [:td {} "16 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/127397"} "Bart Swings"]] [:td {} [:a {:href "/countries/BEL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BEL.png"}] "BEL"]] [:td {} "16 (5 h2)"] [:td {} "16 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/128173"} "Koen Verweij"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "16 (5 h1)"] [:td {} "16 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/138108"} "Livio Wenger"]] [:td {} [:a {:href "/countries/SUI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SUI.png"}] "SUI"]] [:td {} "16 (7 h2)"] [:td {} "16 (4)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {} [:a {:href "/athletes/137072"} "Viktor Hald Thorup"]] [:td {} [:a {:href "/countries/DEN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://