ults/185045"} "individual event"] " had also been won by a Dutchman, " [:a {:href "/athletes/12904"} "Adolph van der Voort van Zijp"] "."] "\n\n" [:p {} "The Dutch quartet was glad to leave Paris, in spite of their gold medals. They had been housed at Hotel Exelmans. Not only was this situated far from most of the competition venues, but personnel and food quality were below par - even for four soldiers."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "Horse"] [:th {} "NOC"] [:th {} "Points"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "Netherlands"] [:td {}] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "5,297.50"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/12904"} "Adolf van der Voort van Zijp"] " "] [:td {} [:i {} [:a {:href "/horses/2293"} "Silver Piece"]]] [:td {}] [:td {} "1,976.00"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/12534"} "Charles Pahud de Mortanges"] " "] [:td {} [:i {} [:a {:href "/horses/1278"} "Johnny Walker"]]] [:td {}] [:td {} "1,828.00"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/11827"} "Gerard de Kruijff"] " "] [:td {} [:i {} [:a {:href "/horses/22"} "Addio"]]] [:td {}] [:td {} "1,493.50"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/11768"} "Anton Colenbrander"] " "] [:td {} [:i {} [:a {:href "/horses/1344"} "King of Hearts"]]] [:td {}] [:td {} "952.50"] [:td {}] [:td {} [:span {:class "label label-default"} "non-scoring"]]