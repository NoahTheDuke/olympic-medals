0"} "High Jump, Women"] "\n" [:option {:value "257692"} "Pole Vault, Women"] "\n" [:option {:value "9030952"} "Long Jump, Women"] "\n" [:option {:value "9030966"} "Triple Jump, Women"] "\n" [:option {:value "257754"} "Shot Put, Women"] "\n" [:option {:value "257771"} "Discus Throw, Women"] "\n" [:option {:value "257788"} "Hammer Throw, Women"] "\n" [:option {:value "257805"} "Javelin Throw, Women"] "\n" [:option {:value "257822"} "Heptathlon, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "61484"} "1972"] "\n" [:option {:value "62051"} "1976"] "\n" [:option {:value "62530"} "1980"] "\n" [:option {:value "63123"} "1984"] "\n" [:option {:value "63799"} "1988"] "\n" [:option {:value "64471"} "1992"] "\n" [:option {:value "65149"} "1996"] "\n" [:option {:value "65810"} "2000"] "\n" [:option {:value "66518"} "2004"] "\n" [:option {:value "302552"} "2012"] "\n" [:option {:value "359105"} "2016"] "\n" [:option {:value "19000779"} "2020"] "\n" [:option {:value "2013948"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/108"} "Event type"]] [:h1 {:class "event_title"} "4 × 400 metres Relay, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "22 – 23 August 2008"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/813"} "Beijing Guojia Tiyuchang, Beijing Aolinpike Gongyuan, Beijing"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/257665"} "69 from 16 countries"]]]]] [:div {:class "description"} [:p {} "The race was expected to be between the United States and Russia, with the US slight favorites. But the US sprinters had not performed well in Beijing, making this hard to call. Due to injuries, top US runner " [:a {:href "/athletes/105045"} "Sanya Richards"] " was asked to run in the heats and there was concern that this would tire her for the final, where she would anchor. In the final, " [:a {:href "/athletes/114820"} "Yuliya Gushchina "] " put Russia in the lead on the opening leg with 50.62, Jamaica second and the US third. " [:a {:href "/athletes/105293"} "Allyson Felix"] " ran the second leg for the US, and blitzed a 48.55 lap to move slightly ahead of the Russians at the second changeover. " [:a {:href "/athletes/107780"} "Monique Henderson "] " ran the third leg for the US and opened a big lead on the backstretch but " [:a {:href "/athletes/107763"} "Tatyana Firova"] " caught her on the straightaway and pulled ahead by a few metres as she handed the baton to " [:a {:href "/athletes/114815"} "Anastasiya Kapachinskaya"] ". Richards got the baton for the US 6/10ths down at the bell, with Jamaica another second back. Kapachinskaya opened the lead up even further on the backstretch and the US appeared to be too far behind. But on the final curve, Richards found another gear, and gradually starting closing the gap. She caught Kapachinskaya about 30 metres from the finish, but it was not over, as Kapachinskaya would not yield. But Richards held on to get the gold for the US by 0.28 seconds, with Jamaica winning the bronze medal."] "\n\n" [:p {} "That was how the event and the results seemed to have ended. In 2015, however, the IOC began re-testing samples from the 2008 Beijing and 2012 London Olympics, using newer, more advanced testing techniques, in an effort to find those who had used performance enhancing drugs (PEDs), but in whom it could not be detected at the time of those Olympics. This was one of the many events affected."] "\n\n" [:p {} "Russia originally received the silver medal, but two of their runners, " [:a {:href "/athletes/107763"} "Tatyana Firova"] " and " [:a {:href "/athletes/114815"} "Anastasiya Kapachinskaya"] ", both had positive re-tests for turinabol (dehydrochloromethyltestosterone), with Firova also testing positive for 3a-hydroxy-5a-androst-1-en-17-one, and Kapachinskaya throwing in a stanozolol chaser. The Russian team was disqualified, all runners losing their silver medal, with Jamaica moving up to the silver medal, and Great Britain receiving the bronze medal. Great Britain had originally finished only fifth, with Belarus fourth. However, Belarus was also disqualified after the re-test of " [:a {:href "/athletes/105041"} "Svetlana Usovich"] ", who was positive for turinabol (dehydrochloromethyltestosterone) in November 2016."] "\n\n" [:p {} "Firova was later quoted as saying, “We sportsmen are performers, we follow the rules that are given to us by the system. A normal person can take banned substances if they want to. So why can’t athletes take them as well? How else can we achieve high results?”"] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "3:22.45 (1 h2)"] [:td {} "3:18.54 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "10"} [:a {:href "/athletes/114816"} "Mary Wineberg"] " • " [:a {:href "/athletes/105293"} "Allyson Felix"] " • " [:a {:href "/athletes/107780"} "Monique Henderson"] " • " [:a {:href "/athletes/105045"} "Sanya Richards-Ross"] " • " [:a {:href "/athletes/115277"} "Natasha Hastings"] " • " [:a {:href "/athletes/923937"} "Ebonie Floyd"] [:small {} " (DNS)"]]] [:tr {: