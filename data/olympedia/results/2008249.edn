g), Men"] "\n" [:option {:value "2007828"} "Welterweight, Greco-Roman (≤67 kg), Men"] "\n" [:option {:value "2007854"} "Middleweight, Greco-Roman (≤77 kg), Men"] "\n" [:option {:value "2007880"} "Light-Heavyweight, Greco-Roman (≤87 kg), Men"] "\n" [:option {:value "2007906"} "Heavyweight, Greco-Roman (≤97 kg), Men"] "\n" [:option {:value "2007932"} "Super-Heavyweight, Greco-Roman (≤130 kg), Men"] "\n" [:option {:value "2007958"} "Featherweight, Freestyle (≤57 kg), Men"] "\n" [:option {:value "2007984"} "Welterweight, Freestyle (≤65 kg), Men"] "\n" [:option {:value "2008010"} "Middleweight, Freestyle (≤74 kg), Men"] "\n" [:option {:value "2008041"} "Light-Heavyweight, Freestyle (≤86 kg), Men"] "\n" [:option {:value "2008067"} "Heavyweight, Freestyle (≤97 kg), Men"] "\n" [:option {:value "2008093"} "Super-Heavyweight, Freestyle (≤125 kg), Men"] "\n" [:option {:value "2008119"} "Flyweight, Freestyle (≤50 kg), Women"] "\n" [:option {:value "2008145"} "Featherweight, Freestyle (≤53 kg), Women"] "\n" [:option {:value "2008171"} "Lightweight, Freestyle (≤57 kg), Women"] "\n" [:option {:value "2008197"} "Middleweight, Freestyle (≤62 kg), Women"] "\n" [:option {:value "2008223"} "Light-Heavyweight, Freestyle (≤68 kg), Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "134346"} "2004"] "\n" [:option {:value "263571"} "2008"] "\n" [:option {:value "332782"} "2012"] "\n" [:option {:value "356002"} "2016"] "\n" [:option {:value "19009793"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/681"} "Event type"]] [:h1 {:class "event_title"} "Heavyweight, Freestyle (≤76 kg), Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "10 – 11 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2173"} "Grand Palais Éphémère, Paris, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2008249"} "16 from 16 countries"]]]]] [:div {:class "description"} [:p {} "The heavyweight was the only weight class in women’s freestyle wrestling where Japan never won gold, or even had an Olympic finalist. In the history of this sport, including Tokyo 2020, Japan had won 15 out of 19 gold medals in all other divisions and, in Paris 2024, Japan won three of five golds in the lower weight classes. This time, however, the favorite in the heavyweight class was a Japanese competitor. The 22-year-old " [:a {:href "/athletes/2505394"} "Yuka Kagami"] " won bronze and gold in the last two World championships, and in 2018 she had been a bronze medalist at the Youth Olympic Games. Both finalists of the Tokyo Olympics did not compete in Paris. German gold medalist " [:a {:href "/athletes/130431"} "Aline Rotter-Focken"] " retired, and American " [:a {:href "/athletes/132192"} "Adeline Gray"] " was ousted in the US trials by 20-years old newcomer " [:a {:href "/athletes/155753"} "Kennedy Blades"] "."] "\n\n" [:p {} "Kagami won her first three bouts with solid, but not really superior, victories on points. In the semi-final, she defeated #3 seeded Colombian " [:a {:href "/athletes/155643"} "Tatiana Rentería"] ", the 2022 U-23 World champion. In the upper half of the brackets, the #1 seeded " [:a {:href "/athletes/144873"} "Aiperi Medet"] " from Kyrgyzstan had an equally difficult time reaching the semi-final. After placing fifth in Tokyo, she took silver at the 2023 World Championships, losing the final against Kagami. In the Paris semi, Medet met Kennedy Blades, who achieved an upset victory, winning 8-6 on points."] "\n\n" [:p {} "In the final, Kagami claimed the first women’s heavyweight gold for Japan. Nevertheless, Blades did a good job holding Kagami to a 1-1 draw after the first period. Eventually, the Japanese wrestler scored the match’s only takedown for two points. Kagami’s defense was too strong for Blades’ late attempts to come back. In her bronze medal match, the Cuban " [:a {:href "/athletes/2504823"} "Milaimys Marín"] " snatched the medal from Aiperi Medet after a clear upset victory of 6-0 on points. In an all-South American bronze medal match, Rentería secured the medal for Colombia, by a narrow 2-1 success over " [:a {:href "/athletes/155649"} "Génesis Reasco"] " from Ecuador."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Classification Points", :class "footnote"} "CP"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Victories by Fall", :class "footnote"} "VF"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Victories by Technical Superiority", :class "footnote"} "ST"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Technical Points", :class "footnote"} "TP"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Technical Points Received", :class "footnote"} "TPR"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/2505394"} "Yuka Kagami"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]] [:td {} "12"] [:td {} "0"] [:td {} "0"] [:td {} "12"] [:td {} "3"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/155753"} "Kennedy Blades"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle",