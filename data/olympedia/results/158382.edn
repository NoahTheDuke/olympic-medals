alue "158332"} "Coxless Pairs, Men"] "\n" [:option {:value "158347"} "Coxed Pairs, Men"] "\n" [:option {:value "158357"} "Coxless Fours, Men"] "\n" [:option {:value "158367"} "Coxed Fours, Men"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "157523"} "1900"] "\n" [:option {:value "157532"} "1904"] "\n" [:option {:value "157561"} "1908"] "\n" [:option {:value "157617"} "1912"] "\n" [:option {:value "157661"} "1920"] "\n" [:option {:value "157710"} "1924"] "\n" [:option {:value "157854"} "1928"] "\n" [:option {:value "157918"} "1932"] "\n" [:option {:value "157985"} "1936"] "\n" [:option {:value "158096"} "1948"] "\n" [:option {:value "158218"} "1952"] "\n" [:option {:value "158302"} "1956"] "\n" [:option {:value "158458"} "1964"] "\n" [:option {:value "158539"} "1968"] "\n" [:option {:value "158637"} "1972"] "\n" [:option {:value "158723"} "1976"] "\n" [:option {:value "158849"} "1980"] "\n" [:option {:value "158968"} "1984"] "\n" [:option {:value "159100"} "1988"] "\n" [:option {:value "159271"} "1992"] "\n" [:option {:value "159427"} "1996"] "\n" [:option {:value "159611"} "2000"] "\n" [:option {:value "159787"} "2004"] "\n" [:option {:value "261034"} "2008"] "\n" [:option {:value "319000"} "2012"] "\n" [:option {:value "354004"} "2016"] "\n" [:option {:value "19008478"} "2020"] "\n" [:option {:value "2012477"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/389"} "Event type"]] [:h1 {:class "event_title"} "Eights, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "31 August –  3 September 1960"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/418"} "Lago Albano, Castel Gandolfo"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/158382"} "127 from 14 countries"]]]]] [:div {:class "description"} [:p {} "Since it had first been contested in 1900, the United States had never lost an Olympic coxed eights final (Great Britain won in 1908 and 1912 when the Americans did not submit a crew) and, with no strong favorites from Europe, seemed poised once again to capture the title. In Rome the nation was represented by rowers from the United States Navy. Italy was a possible contender, having won the 1957 and 1958 European Championships, but it was Germany that most observers had their eye on, as they sent their 1959 European Championship-winning lineup to the 1960 Olympics. This crew was known as the “Ratzeburg” crew, even though their members came from both the Ratzeburg and Ditmarsia Kiel clubs, and their prowess was attributed partially to their new oar design. Finally there were the Canadians, who had won the 1958 British Empire and Commonwealth Games and been runners-up at the 1959 Pan American Games. Still, even with this slightly more open field, few could have predicted the final result."] "\n\n" [:p {} "The first shock came in the opening round, when the Canadians defeated their southern neighbors by nearly five seconds while, in another heat, the Germans also outperformed the Americans’ time by over four seconds and France was only 0.02 seconds off of the United States’ time. This forced the defending champions into a repêchage where, perhaps conserving their strength, they won their heat in a notably slow time and faced a legitimate challenge from Great Britain. Yet even if spectators might have predicted that the United States would finally be dethroned, they almost certainly could not have guessed that the country who had reigned supreme in the coxed eights for several decades would finish off the podium. The Germans, however, were clearly dominant and finished four seconds ahead of the Canadians, who took silver. Bronze went to Czechslovakia, the 1959 European runners-up, while the United States finished in fifth, nearly 11 seconds behind the gold-medal winning German crew, losing an Olympic final in the coxed eights for the first time in 60 years."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Unified Team of Germany"] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/37975"} "Manfred Rulffs"] " • " [:a {:href "/athletes/37989"} "Walter Schröder"] " • " [:a {:href "/athletes/37981"} "Frank Schepke"] " • " [:a {:href "/athletes/37982"} "Kraft Schepke"] " • " [:a {:href "/athletes/38032"} "Moritz von Groddeck"] " • " [:a {:href "/athletes/37855"} "Karl-Heinz Hopp"] " • " [:a {:href "/athletes/37767"} "Klaus Bittner"] " • " [:a {:href "/athletes/37910"} "Hans Lenk"] " • " [:a {:href "/athletes/37948"} "Willi Padge"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Canada"] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/36072"} "Don Arnold"] " • " [:a {:href "/athletes/36119"} "Walter D'Hondt"] " • " [:a {:href "/athletes/36180"} "Nelson Kuhn"] " • " [:a {:href "/athletes/36188"} "John Lecky"] " • " [:a {:href "/athletes/36071"} "David Anderson"] " • " [:a {:href "/athletes/36200"} "Archie MacKinnon"] " • " [:a {:href "/athletes