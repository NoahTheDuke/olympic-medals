ical-align: top;"} "Olympic Record  (Ranking Round, 216 arrows)"] [:td {} [:a {:href "/results/41055"} "1,984"] " " [:span {:class "label label-primary"} "WR"] " / " [:a {:href "/athletes/1960"} "Kim Jo-Sun"] " • " [:a {:href "/athletes/1961"} "Kim Gyeong-Uk"] " • " [:a {:href "/athletes/1967"} "Yun Hye-Yeong"] " " [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"] " / 28 July 1996 / " [:a {:href "/records/event_name/26/Ranking%20Round,%20216%20arrows"} "Details"]]]]] [:div {:class "description"} [:p {} "In 1999 Korea was upset at the World Championships, which were won by Italy, stopping a streak of five straight Korean world titles. But for the third consecutive Olympics, Korea’s women archers set a world record in the ranking round. Italy struggled, placing only seventh in the ranking round. They would go out in the quarter-finals against Ukraine, who moved on to the final against Korea. But Korea dominated that match, winning their fourth of four gold medals in the women’s archery team event. Germany, which had won silver in 1996, took the bronze medal, defeating Turkey, which had also placed fourth in 1996."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Republic of Korea"] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/1962"} "Kim Su-Nyeong"] " • " [:a {:href "/athletes/83169"} "Kim Nam-Sun"] " • " [:a {:href "/athletes/83170"} "Yun Mi-Jin"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Ukraine"] [:td {} [:a {:href "/cou