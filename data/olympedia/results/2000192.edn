00096"} "Individual, Women"] "\n" [:option {:value "2000170"} "Team, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "18000470"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/2563"} "Event type"]] [:h1 {:class "event_title"} "Team, Mixed" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 2 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2174"} "Les Invalides, Paris, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2000192"} "54 from 27 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Ranking round consisted of 72 arrows at 70 m. Matches consisted of up to 5 sets of 2 arrows per archer, first team to reach 5 points."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record  (Ranking Round, 144 arrows)"] [:td {} [:a {:href "/results/18000470"} "1368"] " " [:span {:class "label label-primary"} "WR"] " / " [:a {:href "/athletes/144969"} "Kim Je-Deok"] " • " [:a {:href "/athletes/144886"} "An San"] " " [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"] " / 23 July 2021 / " [:a {:href "/records/event_name/2563/Ranking%20Round,%20144%20arrows"} "Details"]]]]] [:div {:class "description"} [:p {} "The scores of the top two archers for each nation from the individual ranking rounds were added and the top 16 teams advanced to a single-elimination tournament. With Koreans finishing first in both the Men’s and Women’s ranking round, through " [:a {:href "/athletes/149548"} "Im Si-Hyeon"] " and " [:a {:href "/athletes/134919"} "Kim Wu-Jin"] ", the favorites for the event comfortably advanced to the elimination rounds with an Olympic record score of 1,380 (out of a possible 1,440)."] "\n\n" [:p {} "However, there were some surprises in the round of 16. China, who finished fourth in the ranking round, lost to Spain by a score of 6-2. The Republic of Korea team seemed to be on their way to a comfortable victory against Chinese Taipei when they won the first two sets, but Chinese Taipei won the final two sets to force a shoot-off. The Koreans won the shoot-off by 20-19, to advance to the quarter-finals. Their progress to the final was much easier, as they defeated Italy by 6-2 in the quarter-finals, and India by the same score in the semi-finals. Their opponents in the final were Germany in a repeat of the 2023 World Championship final. Germany had a similar path to the final, requiring a shoot-off against Colombia in the round of 16, which they won 18-17. A comfortable 5-1 victory against Mexico in the quarter-finals meant a contest against the United States for a place in the final. After losing the first set and drawing the second, the Germans won the next two sets to advance to the final."] "\n\n" [:p {} "The bronze medal match was dominated by the United States, whose archers were world-ranked #1 woman " [:a {:href "/athletes/147091"} "Casey Kaufhold"] " and three-time Olympic medalist " [:a {:href "/athletes/111530"} "Brady Ellison"] ". They won the first two sets, lost the third set to the Indian team of " [:a {:href "/athletes/149534"} "Ankita Bhakat"] " and " [:a {:href "/athletes/149536"} "Dhiraj Bommadevara"] ", but came through to win the fourth set, securing the bronze medal by 6-2. The final was relatively disappointing, nerves affecting both teams, but more especially the German team of " [:a {:href "/athletes/143234"} "Michelle Kroppen"] " and " [:a {:href "/athletes/143339"} "Florian Unruh"] ". In the final analysis, the Koreans Im and Kim won 38-35, 36-35, 36-35, to each claim their second gold medal of the 2024 Olympic archery and retain the Olympic title in this event for the Republic of Korea."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Republic of Korea"] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/149548"} "Im Si-Hyeon"] " • " [:a {:href "/athletes/134919"} "Kim Wu-Jin"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Germany"] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/143234"} "Michelle Kroppen"] " • " [:a {:href "/athletes/143339"} "Florian Unruh"]]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/111530"} "Brady Ellison"] " • " [:a {:href "/athletes/147091"} "Casey Kaufhold"]]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} "India"] [:td {} [:a {:href "/countries/IND"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/IND.