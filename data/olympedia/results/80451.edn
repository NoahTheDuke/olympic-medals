al-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Jury"] [:td {:style "width: 400px"} [:a {:href "/athletes/22751"} "Rodolfo Terlizzi"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Jury"] [:td {:style "width: 400px"} [:a {:href "/athletes/23812"} "Harold Van Buskirk"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Jury"] [:td {:style "width: 400px"} [:a {:href "/athletes/899391"} "Clarence, Greve von Rosen"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]]]]] [:div {:class "description"} [:p {} "The Italian fencer " [:a {:href "/athletes/22684"} "Gustavo Marzi"] ", who had won a silver in " [:a {:href "/results/79878"} "team sabre at Amsterdam"] ", was the favorite and was never challenged, defeating all his final pool opponents with only 17 touches scored against him. The 1931 World champion " [:a {:href "/athletes/21931"} "René Lemoine"] " did not make the French team for the individual event and did not compete. American " [:a {:href "/athletes/23736"} "Joe Levis"] " reached a surprising second place, and Italian " [:a {:href "/athletes/22668"} "Giulio Gaudini"] ", the 1930 World champion, won the bronze medal, as Italy took three of the top four places."] "\n\n" [:p {} "The hopes of the Germans were concentrated on " [:a {:href "/athletes/22251"} "Erwin Casmir"] ", but he had some unfortunate defeats in the final against Marzi, the Argent