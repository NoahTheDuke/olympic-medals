6130"} "1904"] "\n" [:option {:value "56207"} "1906"] "\n" [:option {:value "56349"} "1908"] "\n" [:option {:value "56624"} "1912"] "\n" [:option {:value "57113"} "1920"] "\n" [:option {:value "57390"} "1924"] "\n" [:option {:value "57690"} "1928"] "\n" [:option {:value "57977"} "1932"] "\n" [:option {:value "58217"} "1936"] "\n" [:option {:value "58564"} "1948"] "\n" [:option {:value "59317"} "1956"] "\n" [:option {:value "59701"} "1960"] "\n" [:option {:value "60143"} "1964"] "\n" [:option {:value "60581"} "1968"] "\n" [:option {:value "61086"} "1972"] "\n" [:option {:value "61675"} "1976"] "\n" [:option {:value "62233"} "1980"] "\n" [:option {:value "62710"} "1984"] "\n" [:option {:value "63350"} "1988"] "\n" [:option {:value "64031"} "1992"] "\n" [:option {:value "64710"} "1996"] "\n" [:option {:value "65388"} "2000"] "\n" [:option {:value "66080"} "2004"] "\n" [:option {:value "257212"} "2008"] "\n" [:option {:value "302226"} "2012"] "\n" [:option {:value "358624"} "2016"] "\n" [:option {:value "19000422"} "2020"] "\n" [:option {:value "2013570"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/44"} "Event type"]] [:h1 {:class "event_title"} "1,500 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "24 – 26 July 1952"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/368"} "Helsingin Olympiastadion, Helsinki"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/58918"} "52 from 26 countries"]]]]] [:div {:class "description"} [:p {} "There was no favorite for the 1952 1,500, but the field had outstanding depth. At least 25 runners had run under 3:50 or 4:10 leading up to Helsinki. For the first time, the event had three rounds, with two semi-finals qualifying six runners in each heat for the final."] "\n\n" [:p {} "The leading qualifiers for the final were " [:a {:href "/athletes/78772"} "Bob McMillen"] " (USA), " [:a {:href "/athletes/68218"} "Patrick El Mabrouk"] " (FRA), " [:a {:href "/athletes/70390"} "Werner Lueg"] " (GER), " [:a {:href "/athletes/74114"} "Audun Boysen"] " (NOR), " [:a {:href "/athletes/73231"} "Josy Barthel"] " (LUX), and " [:a {:href "/athletes/68857"} "Roger Bannister"] " (GBR). The first lap was led by Germany’s " [:a {:href "/athletes/70373"} "Rolf Lamers"] " in the overly fast time of 57.8. He still led after two laps but in a more reasonable 2:01.4. Lueg led thru 1,000 metres in 2:32.8, with the field still closely bunched. He continued to lead into the last curve, with McMillen, Bannister, Barthel and El Mabrouk chasing him. Lueg finally tied up on the straight and Barthel and McMillen passed him, while Bannister and El Mabrouk began to slow. In one of the greatest Olympic finishes ever, Barthel barely held off McMillen, while Lueg recovered slightly to get the bronze medal. Roger Bannister finished fourth."] "\n\n" [:p {} "A bit less than two years later, on 6 May 1954, at the Iffley Road track at Oxford, Bannister ran the mile in the British AAA vs. Oxford meet. His time that day was a world record of 3:59.4, making him the first runner to better the magical 4-minute mile barrier. Barthel’s gold medal was the “first” ever for tiny Luxembourg, although in the 1990s, French athletics historian Alain Bouillé discovered that the " [:a {:href "/results/56066"} "1900 marathon"] " gold medalist, " [:a {:href "/athletes/68519"} "Michel Théato"] ", was actually a Luxembourgish national."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "406"] [:td {} [:a {:href "/athletes/73231"} "Josy Barthel"]] [:td {} [:a {:href "/countries/LUX"} [:img {:style "padding-