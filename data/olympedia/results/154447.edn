rican boycott, the race was almost an Eastern European championship. Of the top eight teams, only Italy in fifth and Finland in seventh could break-up the Eastern dominance."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "Soviet Union"] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "2-01:21.74"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "9"} [:a {:href "/athletes/15015"} "Yury Kashirin"] " • " [:a {:href "/athletes/15356"} "Oleg Logvin"] " • " [:a {:href "/athletes/16600"} "Sergey Shelpakov"] " • " [:a {:href "/athletes/14897"} "Anatoly Yarkin"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} "East Germany"] [:td {} [:a {:href "/countries/GDR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GDR.png"}] "GDR"]] [:td {} "2-02:53.19"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "9"} [:a {:href "/athletes/13646"} "Falk Boden"] " • " [:a {:href "/athletes/14195"} "Bernd Drogan"] " • " [:a {:href "/athletes/15388"} "Olaf Ludwig"] " • " [:a {:href "/athletes/14676"} "Hans-Joachim Hartnick"]]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "–"] [:td {} "Czechoslovakia"] [:td {} [:a {:href "/countries/TCH"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/TCH.png"}] "TCH"]] [:td {} "2-02:53.89"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td 