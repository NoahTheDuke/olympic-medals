n"] "\n" [:option {:value "255094"} "Kayak Singles, 10,000 metres, Men"] "\n" [:option {:value "255095"} "Kayak Doubles, 1,000 metres, Men"] "\n" [:option {:value "255102"} "Kayak Doubles, 10,000 metres, Men"] "\n" [:option {:value "255104"} "Canadian Singles, 1,000 metres, Men"] "\n" [:option {:value "255106"} "Canadian Singles, 10,000 metres, Men"] "\n" [:option {:value "255113"} "Canadian Doubles, 10,000 metres, Men"] "\n" [:option {:value "255114"} "Kayak Singles, 500 metres, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255017"} "1936"] "\n" [:option {:value "255043"} "1948"] "\n" [:option {:value "255074"} "1952"] "\n" [:option {:value "255203"} "1960"] "\n" [:option {:value "255270"} "1964"] "\n" [:option {:value "255334"} "1968"] "\n" [:option {:value "255399"} "1972"] "\n" [:option {:value "255545"} "1976"] "\n" [:option {:value "255657"} "1980"] "\n" [:option {:value "255763"} "1984"] "\n" [:option {:value "255886"} "1988"] "\n" [:option {:value "256022"} "1992"] "\n" [:option {:value "256152"} "1996"] "\n" [:option {:value "256265"} "2000"] "\n" [:option {:value "256382"} "2004"] "\n" [:option {:value "258809"} "2008"] "\n" [:option {:value "307107"} "2012"] "\n" [:option {:value "353532"} "2016"] "\n" [:option {:value "19016188"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/172"} "Event type"]] [:h1 {:class "event_title"} "Canadian Doubles, 1,000 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 1 December 1956"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/399"} "Lake Wendouree, Ballarat, Victoria"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/255107"} "20 from 10 countries"]]]]] [:div {:class "description"} [:p {} "Only two prior Olympic medalists in the C-2 1000 travelled to the 1956 Summer Olympics for another chance at glory, Germany’s " [:a {:href "/athletes/9902"} "Egon Drews"] ", a 1956 bronze medalist, and " [:a {:href "/athletes/9624"} "Georges Dransart"] ", who achieved the same result in 1948. Dransart was also the only World medalist present in Melbourne, having been runner-up in 1950, and had also won a silver medal in the C-2 10000 with his partner " [:a {:href "/athletes/9671"} "Marcel Renaud"] " the previous day. The reigning World Champions, the Austrians, were represented by " [:a {:href "/athletes/9094"} "Otto Schindler"] " and " [:a {:href "/athletes/9104"} "Walter Waldner"] ", while defending Olympic champion Denmark sent " [:a {:href "/athletes/9459"} "Kaj Sylvan"] " and " [:a {:href "/athletes/9426"} "Gerner Christiansen"] ". All this meant that there were no particularly strong favorites in this event."] "\n\n" [:p {} "The opening heats were won by " [:a {:href "/athletes/10584"} "Alexe Dumitru"] " and " [:a {:href "/athletes/10592"} "Simion Ismailciuc"] " of Romania, who were relatively unknown, and Hungary’s " [:a {:href "/athletes/10081"} "Ferenc Mohácsi"] " and " [:a {:href "/athletes/10117"} "Károly Wieland"] ", the latter of whom was one of the reigning World Champions in the C-2 10000. Drews and his partner " [:a {:href "/athletes/9939"} "Herbert Kirschner"] ", meanwhile, were eliminated in the Romanian heat. The final developed into a race to the finish between Dumitru and Ismailciuc and the Soviet duo of " [:a {:href "/athletes/10969"} "Pavel Kharin"] " and " [:a {:href "/athletes/10950"} "Gratsian Botev"] ", which the former won, leaving silver to the latter. The Hungarians, meanwhile, were far enough ahead of the rest of the field (albeit even farther behind the leaders) that they captured bronze with ease. The Danes, however, had worse luck, as Sylvan and Christiansen were disqualified for crossing into another lane. Kharin and Botev’s medal was their second of the tournament, as they had also won the C-2 10000 the day before."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Pair"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/10584"} "Dumitru Alexe"] " / " [:a {:href "/athletes/10592"} "Simion Ismailciuc"]] [:td {} [:a {:href "/countries/ROU"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ROU.png"}] "ROU"]] [:td {} "4:48.1 (1 h1)"] [:td {} "4:47.4 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/10969"} "Pavel Kharin"] " / " [:a {:href "/athletes/10950"} "Gratsian Botev"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "4:52.4 (2 h1)"] [:td {} "4:48.6 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/10117"} "Károly Wieland"] " / " [:a {:href "/athletes/10081"} "Ferenc Mohácsi"]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"]] [:td {} "5:02.5 (1 h2)"] [:td {} "4:54.3 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/9624"} "Georges Dransart"] " / " [:a {:href "/athletes/9671"} "Ma