alue "256163"} "Canadian Singles, Slalom, Men"] "\n" [:option {:value "256166"} "Canadian Doubles, Slalom, Men"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255438"} "1972"] "\n" [:option {:value "256065"} "1992"] "\n" [:option {:value "256310"} "2000"] "\n" [:option {:value "256430"} "2004"] "\n" [:option {:value "258863"} "2008"] "\n" [:option {:value "307020"} "2012"] "\n" [:option {:value "353600"} "2016"] "\n" [:option {:value "19006326"} "2020"] "\n" [:option {:value "2008437"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/181"} "Event type"]] [:h1 {:class "event_title"} "Kayak Singles, Slalom, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "27 July 1996 — 10:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/719"} "Ocoee Whitewater Center, Polk County, Tennessee"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/256201"} "30 from 18 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Two runs, best score of two to count."]]]] [:div {:class "description"} [:p {} "All three medalists from the previous edition’s women’s K-1 slalom, " [:a {:href "/athletes/9870"} "Elisabeth Micheler-Jones"] " of Germany, " [:a {:href "/athletes/8991"} "Danielle Woodward"] " of Australia, and " [:a {:href "/athletes/11029"} "Dana Chladek"] " of the United States, returned to the Olympics in 1996 to compete once again. The Czech Republic’s " [:a {:href "/athletes/9392"} "Marcela Sadilová"] " was the reigning European champion, while " [:a {:href "/athletes/9575"} "Myriam Fox"] " of France and " [:a {:href "/athletes/9702"} "Lynn Simpson"] " of Great Britain were the 1993 and 1995 World Champions respectively. None of these women, however, were in the top three after the first run: Fox was fourth, Micheler-Jones was fifth, and the next best was Sadilová, who was 18th. Occupying the first three positions were " [:a {:href "/athletes/9386"} "Štěpánka Hilgertová"] " of the Czech Republic, " [:a {:href "/athletes/9567"} "Anne Boixel"] " of France, and " [:a {:href "/athletes/11037"} "Cathy Hearn"] " of the United States. Of the top five, only Fox improved her score in the second run, although Hilgertová’s remained good enough to earn the gold medal. Chladek, however, who had been last after the first round (save for Latvia’s " [:a {:href "/athletes/10286"} "Dzintra Blūma"] ", who failed to complete the course), had an amazing run in the second portion of the tournament and managed to tie the Czech’s gold medal-winning mark, although her low first-round score left her with silver. Fox’s improvement, meanwhile, was good enough to take bronze over Italy’s " [:a {:href "/athletes/10144"} "Maria Cristina Giai Pron"] ", who was third in the second round and fourth overall."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Total Time"] [:th {} "Run #1"] [:th {} "Run #2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "3"] [:td {} [:a {:href "/athletes/9386"} "Štěpánka Hilgertová"]] [:td {} [:a {:href "/countries/CZE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CZE.png"}] "CZE"]] [:td {} "169.49"] [:td {} "169.49 (1)"] [:td {} "171.97 (4)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "30"] [:td {} [:a {:href "/athletes/11029"} "Dana Chladek"]] [:td {} [:a {:href "/countr