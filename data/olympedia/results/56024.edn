.  This event started while the " [:a {:href "/results/56017"} "marathon"] " was being run, and was interrupted by the frenzy of the crowd when " [:a {:href "/athletes/70782"} "Spyros Louis"] " came into the stadium and won that event."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Best Height Cleared"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/78578"} "Bill Hoyt"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "3.30"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/79145"} "Albert Tyler"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "3.20"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/70717"} "Evangelos Damaskos"]] [:td {} [:a {:href "/countries/GRE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GRE.png"}] "GRE"]] [:td {} "2.60"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/70860"} "Ioannis Theodoropoulos"]] [:td {} [:a {:href "/countries/GRE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GRE.png"}] "GRE"]]