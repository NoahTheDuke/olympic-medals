-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #3"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004119"} "Räto Wohlwend"]] [:td {} [:a {:href "/countries/SUI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SUI.png"}] "SUI"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #4"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002239"} "Gerhard Wenninger"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #5"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003344"} "Miroslav Martinák"]] [:td {} [:a {:href "/countries/SVK"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SVK.png"}] "SVK"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "K-Point: 123 m"]]]] [:div {:class "description"} [:p {} "Traditionally the domain of the Finns and Norwegians, the two nations had won all but one of the world and Olympic championships to be held, the 1994 Olympic title was to be decided between two nations who had never challenged for a major title beforehand. After the first round Germany and Japan were separated by less than a point but " [:a {:href "/athletes/95870"} "Jinya Nishikata"] " and " [:a {:href "/athletes/96009"} "Takanobu Okabe"] " performed well in the second round and with one man left for each nation Japan held the advantage. By the time " [:a {:href "/athletes/86456"} "Masahiko Harada"] " stood at the top of the jump he knew what he had to do to ensure a Japanese victory. A jump of around 105 m would be enough and since he had made a leap of 122 m in the first round this appeared to be a relative formality. Instead the jump turned into a disaster as he mistimed his leap and landed at just 97.5 m. One of the defining images of the 1994 Games is of Harada kneeling in the snow with head in his hands as his team-mates stood in disbelief. Prior to 1994 only the best three jumps of each team counted per round but the rules were changed before Lillehammer and all jumps were now added to the team’s score. If the old rules had still been in place Japan would have recorded a clear victory."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Jump #1"] [:th {} "Jump #2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Germany"] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "970.1"] [:td {} "486.8 (1)"] [:td {} "483.3 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/98886"} "Jens Weißflog"] " "] [:td {}] [:td {} "277.7"] [:td {} "136.3"] [:td {} "141.4"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/98234"} "Dieter Thoma"] " "] [:td {}] [:td {} "254.1"] [:td {} "126.8"] [:td {} "127.3"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/87693"} "Hansjörg Jäkle"] " "] [:td {}] [:td {} "231.8"] [:td {} "110.1"] [:td {} "121.7"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/85319"} "Christof Duffner"] " "] [:td {}] [:td {} "206.5"] [:td {} "113.6"] [:td {} "92.9"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Japan"] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]] [:td {} "956.9"] [:td {} "486.0 (