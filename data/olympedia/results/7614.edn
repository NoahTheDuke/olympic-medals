e in 100 free and two in 50 free."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "B Final"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "186"] [:td {} [:a {:href "/athletes/50058"} "Aleksandr Popov"]] [:td {} [:a {:href "/countries/EUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/EUN.png"}] "EUN"]] [:td {} "22.21 (1 h8)"] [:td {} "–"] [:td {} "21.91 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "603"] [:td {} [:a {:href "/athletes/51266"} "Matt Biondi"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "22.32 (1 h10)"] [:td {} "–"] [:td {} "22.09 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "614"] [:td {} [:a {:href "/athletes/51417"} "Tom Jager"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "22.45 (1 h9)"] [:td {} "–"] [:td {} "22.30 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=4"] [:td {:class "bib"} "227"] [:td {} [:a {:href "/athletes/46866"} "Christophe Kalfayan"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "22.70 (=3 h9)"] [:td {} "–"] [:td {} "22.50 (=4)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=4"] [:td {:class "bib"} "528"] [:td {} [:a {:href "