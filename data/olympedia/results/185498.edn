lympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #2"] [:td {:style "width: 400px"} [:a {:href "/athletes/2305606"} "Graham Davey"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #3"] [:td {:style "width: 400px"} [:a {:href "/athletes/2305680"} "Leonidas Georgopoulos"]] [:td {} [:a {:href "/countries/GRE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GRE.png"}] "GRE"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #4"] [:td {:style "width: 400px"} [:a {:href "/athletes/2305716"} "Peter Herchel"]] [:td {} [:a {:href "/countries/SVK"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SVK.png"}] "SVK"]]] [:tr {:class "referees", :style ""} [:th {} "Course Designer"] [:td {:style "width: 400px"} [:a {:href "/athletes/2305748"} "Leopoldo Palacios"]] [:td {} [:a {:href "/countries/VEN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/VEN.png"}] "VEN"]]]]] [:div {:class "description"} [:p {} "The event was the same as in 1996 with qualifying consisting of three rounds, with the top 25 advancing to the final, with no more than three riders from any nation in the final. The final was again two rounds with the total score for both rounds to count. The favorite was Brazilian " [:a {:href "/athletes/12558"} "Rodrigo Pessoa"] ", ranked #1 in the world and who, in April 2000, became the first rider ever to win three consecutive events in the World Cup. He led the qualifying, and then had a clean round in the first round of the final, tied with three other riders. Unfortunately, in round two, his horse, " [:a {:href "/horses/"} "Baloubet du Rouet"] ", balked and refused three times at obstacle seven, eliminating the pair."] "\n\n" [:p {} "This allowed two of the riders who had gone clean in round one, " [:a {:href "/athletes/90722"} "Jeroen Dubbeldam"] " (NED) and " [:a {:href "/athletes/11523"} "Khaled Al-Eid"] " (KSA) to tie with a total of 4.00 faults, joined by another Dutch rider, " [:a {:href "/athletes/90725"} "Albert Voorn"] ", who had a clean ride in round two. The three jumped off to decide the medal and Dubbeldam again went clear to win the gold medal. Both Voorn and Al-Eid had four faults, but Voorn won the silver based on time, 44.72 to 44.86. Al-Eid’s bronze medal was the first ever won in equestrianism by Saudi Arabia. For Pessoa, he would get his gold medal, but would wait four years, winning at Athina in 2004."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "Horse"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "276"] [:td {} [:a {:href "/athletes/90722"} "Jeroen Dubbeldam"]] [:td {} [:i {} [:a {:href "/horses/2309"} "De Sjiem"]]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "12.50 (5)"] [:td {} "4.00 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "277"] [:td {} [:a {:href "/athletes/90725"} "Albert Voorn"]] [:td {} [:i {} [:a {:href "/horses/1409"} "Lando"]]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "20.00 (=18)"] [:td {} "4.00 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""