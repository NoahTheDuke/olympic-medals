 heats but was replaced in the final by " [:a {:href "/athletes/80289"} "Egmont Zahn"] ", who has previously been listed as Gustav-Adolph Moths. Few 1900 sources even contain the names of the coxswains in the 1900 rowing."] "\n\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Cercle de l'Aviron Roubaix"] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "7:11.0"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "9"} [:a {:href "/athletes/36923"} "Émile Delchambre"] " • " [:a {:href "/athletes/36897"} "Jean Cau"] " • " [:a {:href "/athletes/36877"} "Henri Bouckaert"] " • " [:a {:href "/athletes/36984"} "Henri Hazebrouck"] " • " [:a {:href "/athletes/36900"} " Charlot"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Club Nautique de Lyon"] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "7:18.0"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "9"} [:a {:href "/athletes/37065"} "Charles Perrin"] " • " [:a {:href "/athletes/37102"} "Daniel Soubeyran"] " • " [:a {:href "/athletes/37129"} "Émile Wegelin"] " • " [:a {:href "/athletes/37025"} "Georges Lumpp"]]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} "Favorite Hammonia"] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "7:18.2"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""