tyle "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #2"] [:td {:style "width: 400px"} [:a {:href "/athletes/1500125"} "Anatoly Yakheyev"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #3"] [:td {:style "width: 400px"} [:a {:href "/athletes/1500128"} "Sarah Simson"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #4"] [:td {:style "width: 400px"} [:a {:href "/athletes/1500118"} "Kiryl Kruchok"]] [:td {} [:a {:href "/countries/BLR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BLR.png"}] "BLR"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #5"] [:td {:style "width: 400px"} [:a {:href "/athletes/1500121"} "Tao Yongchun"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Name: Secret Garden Olympic Aerials Course" [:br {}] "In-Run Distance / Gradient: 72.0 m / 27°" [:br {}] "Kicker 2 Distance / Height / Gradient: 6.50 m / 3.40 m / 66°" [:br {}] "Kicker 3 Distance / Height / Gradient: 6.50 m / 3.40 m / 66°" [:br {}] "Kicker 4 Distance / Height / Gradient: 8.00 m / 4.10 m / 71°" [:br {}] "Kicker 5 Distance / Height / Gradient: 8.00 m / 4.10 m / 71°" [:br {}] "Landing Distance / Gradient: 30.0 m / 37°" [:br {}] "Table: 19.0 m"]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/127406"} "Hanna Huskova"] " of Belarus returned to Beijing in 2022 to defend her Olympic title in the aerials and was joined by bronze medalist " [:a {:href "/athletes/136949"} "Kong Fanyu"] " of China. The reigning World Champion was Australia’s " [:a {:href "/athletes/127293"} "Laura Peel"] ", while " [:a {:href "/athletes/119040"} "Xu Mengtao"] ", the 2013 World Champion and 2014 Olympic runner-up, was leading the most recent World Cup rankings."] "\n\n" [:p {} "Peel finished first in qualifying, with Xu in third and " [:a {:href "/athletes/118948"} "Ashley Caldwell"] " of the United States, the 2017 World Champion and 2021 World runner-up, between them. Huskova was the final round one qualifier in sixth, while Kong advanced after the second round. The best jump of the first final went to Caldwell, but she was only 0.03 points ahead of Xu, with Kong not far behind. While Xu, all but assured of a place in final 2, bowed out of the second round, Caldwell improved her score, with Peel and Huskova in third."] "\n\n" [:p {} "With the scores wiped for final 2, Huskova put on an impressive performance, but was outdone by Xu, who captured the gold medal with a back full-full-full that led to uncharacteristic cheering from the home crowd. Huskova took silver, but Caldwell, Peel, and Kong all fell on their jumps. This left the only remaining finalist, American " [:a {:href "/athletes/149095"} "Megan Nick"] ", as the surprise bronze medalist."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final Round 1"] [:th {} "Final Round 2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/119040"} "Xu Mengtao"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} "101.10 (3)"] [:td {} "103.89