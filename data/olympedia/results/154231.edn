 "154152"} "1,000 metres Time Trial, Men"] "\n" [:option {:value "154256"} "Individual Pursuit (4,000 metres), Men"] "\n" [:option {:value "154269"} "Team Pursuit (4,000 metres), Men"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "153101"} "1906"] "\n" [:option {:value "153181"} "1908"] "\n" [:option {:value "153270"} "1920"] "\n" [:option {:value "153334"} "1924"] "\n" [:option {:value "153389"} "1928"] "\n" [:option {:value "153441"} "1932"] "\n" [:option {:value "153499"} "1936"] "\n" [:option {:value "153584"} "1948"] "\n" [:option {:value "153659"} "1952"] "\n" [:option {:value "153726"} "1956"] "\n" [:option {:value "153826"} "1960"] "\n" [:option {:value "153935"} "1964"] "\n" [:option {:value "154088"} "1968"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/220"} "Event type"]] [:h1 {:class "event_title"} "Tandem Sprint (2,000 metres), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "3 –  4 September 1972"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/537"} "Radstadion, Olympiapark, München"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/154231"} "28 from 14 countries"]]]]] [:div {:class "description"} [:p {} "The tandem sprint had been on the Olympic Program since 1906, with the exception of 1912 when no track events were contested. But the event would be eliminated after the München Olympics as it was not that popular. The defending champions were " [:a {:href "/athletes/15736"} "Daniel Morelon"] " and " [:a {:href "/athletes/16888"} "Pierre Trentin"] " of France. But Trentin had retired and Morelon was riding the tandem now with Gérard Quintyn. Unfortunately one month before the Olympics Quintyn crashed and was unable to compete. Trentin was called back to the saddle to support Morelon but their lack of preparation showed in München. They made it to the semi-finals but were soundly beaten in two races by the completely unknown Soviet pair of " [:a {:href "/athletes/16540"} "Vladimir Semenets"] " and " [:a {:href "/athletes/16908"} "Igor Tselovalnikov"] ". The East German World Champions, " [:a {:href "/athletes/14468"} "Hans-Jürgen Geschke"] " and " [:a {:href "/athletes/15976"} "Werner Otto"] ", made it to the final with ease, having not lost a race, and they won the first race in the final sitting up. But the Soviet tandem came back to win the final two races in close matches and won a shocking gold medal. Neither Soviet rider ever placed at the World Championships in any event."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {} "R1"] [:th {} "R1 Rep"] [:th {} "QF"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/16540"} "Vladimir Semenets"] " / " [:a {:href "/athletes/16908"} "Igor Tselovalnikov"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "10.37 (1 h4)"] [:td {} "–"] [:td {} "2 (1 h4)"] [:td {} "2 (1 h2)"] [:td {} "2 (1 h1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/15976"} "Werner Otto"] " / " [:a {:href "/athletes/14468"} "Hans-Jürgen Geschke"]] [:td {} [:a {:href "/countries/GDR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GDR.png"}] "GDR"]] [:td {} "11.66 (1 h1)"] [:td {} "–