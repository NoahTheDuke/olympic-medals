lue "255417"} "Canadian Doubles, Slalom, Men"] "\n" [:option {:value "255438"} "Kayak Singles, Slalom, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "256030"} "1992"] "\n" [:option {:value "256160"} "1996"] "\n" [:option {:value "256271"} "2000"] "\n" [:option {:value "256388"} "2004"] "\n" [:option {:value "258816"} "2008"] "\n" [:option {:value "307006"} "2012"] "\n" [:option {:value "353502"} "2016"] "\n" [:option {:value "19006314"} "2020"] "\n" [:option {:value "2008400"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/167"} "Event type"]] [:h1 {:class "event_title"} "Kayak Singles, Slalom, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "28 August 1972 — 13:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/530"} "Kanuslalomanlage, Augsburg"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/255411"} "37 from 15 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Two runs, best score of two to count."]]]] [:div {:class "description"} [:p {} "Canoe slalom singles appeared at the Olympics for the first time in 1972 (and for the last time until 1992) and, unlike in the sprint events, up to three competitors from a single nation were allowed to compete. The reigning World Champion, " [:a {:href "/athletes/9828"} "Siegbert Horn"] " of East Germany, was considered the favorite, although there were many canoeists in contention. After the first run, Horn was in 17th place, while " [:a {:href "/athletes/9093"} "Norbert Sattler"] " of Austria, a 1971 World Champion in the K-1 team, was in first. Behind him were two West Germans, 1971 World bronze medalist in both the K-1 and K-1 team " [:a {:href ""} "Ulrich Peters"] " and " [:a {:href "/athletes/9889"} "Alfred Baum"] ", another K-1 team bronze medalist from 1971. It was only the best of the two runs that mattered, however, and Horn pulled off a fantastic performance in the second run that edged out Sattler by 2.2 points and earned Horn the gold medal. Sattler settled for silver while another East German, " [:a {:href "/athletes/9821"} "Harald Gimpel"] ", had a surprisingly well-executed run that placed him ahead of Peters and Baum and onto the final podium spot."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Total Time"] [:th {} "Run #1"] [:th {} "Run #2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "140"] [:td {} [:a {:href "/athletes/9828"} "Siegbert Horn"]] [:td {} [:a {:href "/countries/GDR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GDR.png"}] "GDR"]] [:td {} "268.56"] [:td {} "363.20 (17)"] [:td {} "268.56 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "16"] [:td {} [:a {:href "/athletes/9093"} "Norbert Sattler"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]] [:td {} "270.76"] [:td {} "270.76 (1)"] [:td {} "301.31 (6)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "134"] [:td {} [:a {:href "/athletes/9821"} "Harald Gimpel"]] [:td {} [:a {:href "/countries/GDR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.