2044"} "Featherweight (≤126 pounds), Men"] "\n" [:option {:value "22075"} "Lightweight (≤135 pounds), Men"] "\n" [:option {:value "22107"} "Welterweight (≤147 pounds), Men"] "\n" [:option {:value "22138"} "Middleweight (≤160 pounds), Men"] "\n" [:option {:value "22163"} "Light-Heavyweight (≤175 pounds), Men"] "\n" [:option {:value "22191"} "Heavyweight (&gt;175 pounds), Men"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "21200"} "1904"] "\n" [:option {:value "21288"} "1920"] "\n" [:option {:value "21440"} "1924"] "\n" [:option {:value "21670"} "1928"] "\n" [:option {:value "21860"} "1932"] "\n" [:option {:value "22214"} "1948"] "\n" [:option {:value "22468"} "1952"] "\n" [:option {:value "22769"} "1956"] "\n" [:option {:value "22975"} "1960"] "\n" [:option {:value "23312"} "1964"] "\n" [:option {:value "23661"} "1968"] "\n" [:option {:value "24037"} "1972"] "\n" [:option {:value "24454"} "1976"] "\n" [:option {:value "24854"} "1980"] "\n" [:option {:value "25185"} "1984"] "\n" [:option {:value "25620"} "1988"] "\n" [:option {:value "26126"} "1992"] "\n" [:option {:value "26570"} "1996"] "\n" [:option {:value "27013"} "2000"] "\n" [:option {:value "27411"} "2004"] "\n" [:option {:value "258236"} "2008"] "\n" [:option {:value "305037"} "2012"] "\n" [:option {:value "356337"} "2016"] "\n" [:option {:value "19005600"} "2020"] "\n" [:option {:value "2000950"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/145"} "Event type"]] [:h1 {:class "event_title"} "Flyweight (≤112 pounds), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "10 – 15 August 1936"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/316"} "Deutschlandhalle, Berlin"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/21983"} "24 from 24 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single elimination tournament."]]]] [:div {:class "description"} [:p {} "Two men who had been looked at as possible champions were not eligible for the trip to Berlin, as Great Britain’s Pat Palmer, the 1934 European and British Empire champion. had recently turned professional, as had Johnny Marceline, the US champion of 1935."] "\n\n" [:p {} "The new regulations concerning weighing-in caused more difficulties in the flyweight division than in any other. A number of fancied competitors were forced to move up a weight class in order to avoid the possibility of disqualification. This made the prediction of medal hopefuls very difficult, although " [:a {:href "/athletes/8715"} "Lou Laurie"] " of the USA, the Frenchman " [:a {:href "/athletes/3031"} "Gaston Fayaud"] ", " [:a {:href "/athletes/7662"} "Felipe Nuñag"] " of the Philippines, and the Argentine " [:a {:href "/athletes/3319"} "Alfredo Carlomagno"] " were touted by some as possible champions."] "\n\n" [:p {} "The 18-year old American Lou Laurie, the youngest member of the US team in Berlin, caught the eye in his first round points victory over " [:a {:href "/athletes/8245"} "Rudolf Bezděk"] " of Czechoslovakia with his speed and accuracy. After a bye in the opening round, the German fighter " [:a {:href "/athletes/3614"} "Willi Kaiser"] " was also impressive, as he forced the referee to stop his second round bout against the Chilean " [:a {:href "/athletes/1268"} "Guillermo López"] " to save the South American from unnecessary punishment. Kaiser continued his progress with a win over the Uruguayan " [:a {:href "/athletes/8606"} "Fidel Tricánico"] " in the last eight. Tricánico had been fortunate enough to gain a bye in the first round, and then saw his prospective second round opponent from Peru withdraw in protest at the treatment of the Peruvian " [:a {:href "/results/33641"} "football"] " team."] "\n\n" [:p {} "The semi-final stage saw Laurie defeated by the strong Sardinian " [:a {:href "/athletes/4134"} "Gavino Matta"] " in a close fight, whilst Kaiser turned back the challenge of Carlomagno of Argentina. Laurie won the bronze medal when Carlomagno withdrew, and his boxing skills were recognized by the award of the inaugural " [:a {:href "/definitions/127"} "Val Barker Award"] ", presented to the most stylish boxer in the tournament."] "\n\n" [:p {} "In the final, Kaiser went on the attack from the outset, forcing the tempo at close quarters and keeping his opponent at bay. When Matta tried to fight back, Kaiser pushed the pace even higher and left the Italian with cuts around both eyes. As he tried to turn the fight around, Matta became desperate and was warned for fouling his opponent. Towards the end of the fight the Italian tired, and Kaiser wrapped up a points decision and Germany’s first ever boxing gold."] "\n\n" [:p {} "The two men met again a year later, in the European championship, with the same result, although this time it was for the bronze medal rather than gold. Matta and Laurie later turned professional, the Italian winning his national title."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/3614"} "Willi Kaiser"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/4134"} "Gavino Matta"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; ver