923482"} "12.5 kilometres Pursuit, Men"] "\n" [:option {:value "923481"} "20 kilometres, Men"] "\n" [:option {:value "923486"} "4 × 7.5 kilometres Relay, Men"] "\n" [:option {:value "923490"} "7.5 kilometres Sprint, Women"] "\n" [:option {:value "923492"} "10 kilometres Pursuit, Women"] "\n" [:option {:value "923495"} "12.5 kilometres Mass Start, Women"] "\n" [:option {:value "923491"} "15 kilometres, Women"] "\n" [:option {:value "923496"} "4 × 6 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1602"} "2006"] "\n" [:option {:value "350024"} "2014"] "\n" [:option {:value "9000222"} "2018"] "\n" [:option {:value "19019632"} "2022"] "\n" [:option {:value "15000032"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/130"} "Event type"]] [:h1 {:class "event_title"} "15 kilometres Mass Start, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "21 February 2010 — 11:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/181"} "Whistler Olympic Park, Whistler"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/923485"} "30 from 16 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Penalty loop (150 metres) skied for each missed target."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 14,830 m" [:br {}] "Height Differential: 40 m" [:br {}] "Maximum Climb: 41 m" [:br {}] "Shooting 1: Prone at 3.0 km, 50 m range" [:br {}] "Shooting 2: Prone at 6.0 km, 50 m range" [:br {}] "Shooting 3: Standing at 9.0 km, 50 m range" [:br {}] "Shooting 4: Standing at 12.0 km, 50 m range" [:br {}] "Total Climbing: 535 m"]]]] [:div {:class "description"} [:p {} "Contested by only the top thirty finishers in the pursuit the 15 km event is the only one at the Winter Games where all competitors start at the same time. A pack of over twenty athletes arrived at the range for the first shoot of the race and when the firing was done it was " [:a {:href "/athletes/118582"} "Simon Eder"] " of Austria who was the early leader. He kept his lead until halfway but two targets missed at each of the third and fourth shooting phases saw him drop off the pace and eventually finish 25th. The lead was then taken over by the unlikely figure of " [:a {:href "/athletes/109639"} "Pavol Hurajt"] ", a Slovakian who had competed at the top level for a decade but whose only previous podium finishes at World Cup level had come six years earlier. With a flawless shooting display Hurajt was the leader from around the half way stage and maintained that lead until after the final shooting phase. However Russia’s " [:a {:href "/athletes/118609"} "Yevgeny Ustyugov"] ", following a slow start, had worked his way up the field with a perfect shooting display. He passed Hurajt after the final round of shooting and built up a considerable lead to win the gold medal in a time of 35:35.7. Following a poor start, " [:a {:href "/athletes/118554"} "Martin Fourcade"] " of France, moved up from 28th after the first round of shooting, where he missed two targets, to pass Hurajt close to the finishing line and win the silver medal, 10.5 seconds behind Ustyugov. Hurajt held on to take the bronze medal 16.6 seconds behind Ustyugov, but well ahead of the 4th place finisher."] "\n\n" [:p {} [:a {:href "/athletes/101201"} "Bjorn Ferry"] "’s attempt to add the 15 km event to his victory in the pursuit floundered, when in a strong third place, at the final phase of shooting whilst " [:a {:href "/athletes/84154"} "Ole Einar Bjørndalen"] "’s attempt to win a 10th Olympic medal was ruined when he missed 7 out of the 20 targets."] "\n\n" [:p {} "In 2020 the apparent winner, " [:a {:href "/athletes/118609"} "Yevgeny Ustyugov"] ", was found guilty of blood doping, based on his biological passport, by the Court of Arbitration for Sport (CAS). Ustyugov appealed that decision, and the appeal dragged on for quite some time. However, in November 2024, the CAS denied his appeal, disqualifying all of Ustyugov’s results from January 2010 through the end of the 2014 season. Ustygov then appealed to the Swiss Federal Tribunal and that appeal was (finally) rejected in May 2025, which will clear the way for the IOC to advance Martin Fourcade to the gold medal and move all the other places up. The IOC announced in September 2025 at an Executive Board Meeting that the medals will be updated, and Fourcade, Hurajt, and Sumann will receive their new medals at a ceremony during the 2026 Olympic Winter Games in Milano-Cortina."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Misses"] [:th {} "Shooting 1 Misses"] [:th {} "Shooting 1"] [:th {} "Shooting 2 Misses"] [:th {} "Shooting 2"] [:th {} "Shooting 3 Misses"] [:th {} "Shooting 3"] [:th {} "Shooting 4 Misses"] [:th {} "Shooting 4"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/118554"} "Martin Fourcade"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "35:46.2"] [:td {} "3"] [:td {} "2"] [:td {} "7:46.7 (28)"] [:td {} "0"] [:td {} "14:57.5 (23)"] [:td {} "0"] [:td {} "21:57.1 (=9)"] [:td {} "1"] [:td {} "29:24.9 (5)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/109639"} "Pavol Hurajt"]] [:td {} [:a {:href "/countries/SVK"} [:img {:style "padding-right: 