353621"} "Team All-Around, Men"] "\n" [:option {:value "353636"} "Floor Exercise, Men"] "\n" [:option {:value "353639"} "Vault, Men"] "\n" [:option {:value "353649"} "Horizontal Bar, Men"] "\n" [:option {:value "353652"} "Rings, Men"] "\n" [:option {:value "353655"} "Pommelled Horse, Men"] "\n" [:option {:value "353658"} "Individual All-Around, Women"] "\n" [:option {:value "353669"} "Team All-Around, Women"] "\n" [:option {:value "353680"} "Floor Exercise, Women"] "\n" [:option {:value "353683"} "Vault, Women"] "\n" [:option {:value "353690"} "Uneven Bars, Women"] "\n" [:option {:value "353693"} "Balance Beam, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "9009279"} "1875"] "\n" [:option {:value "9009307"} "1889"] "\n" [:option {:value "70006"} "1896"] "\n" [:option {:value "70027"} "1904"] "\n" [:option {:value "926064"} "1904"] "\n" [:option {:value "70068"} "1924"] "\n" [:option {:value "70084"} "1928"] "\n" [:option {:value "70106"} "1932"] "\n" [:option {:value "70123"} "1936"] "\n" [:option {:value "70145"} "1948"] "\n" [:option {:value "70167"} "1952"] "\n" [:option {:value "70192"} "1956"] "\n" [:option {:value "70221"} "1960"] "\n" [:option {:value "70265"} "1964"] "\n" [:option {:value "70309"} "1968"] "\n" [:option {:value "70365"} "1972"] "\n" [:option {:value "70423"} "1976"] "\n" [:option {:value "70481"} "1980"] "\n" [:option {:value "70539"} "1984"] "\n" [:option {:value "70597"} "1988"] "\n" [:option {:value "70655"} "1992"] "\n" [:option {:value "70713"} "1996"] "\n" [:option {:value "70786"} "2000"] "\n" [:option {:value "70870"} "2004"] "\n" [:option {:value "259970"} "2008"] "\n" [:option {:value "313027"} "2012"] "\n" [:option {:value "19009140"} "2020"] "\n" [:option {:value "2012240"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/317"} "Event type"]] [:h1 {:class "event_title"} "Parallel Bars, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "6 – 16 August 2016"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/913"} "Arena Olímpica do Rio, Parque Olímpico da Barra, Barra da Tijuca, Rio de Janeiro"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/353646"} "67 from 33 countries"]]]]] [:div {:class "description"} [:p {} "The eight starters in the parallel bars consisted of some of the best exponents on this apparatus in the world. There was the 2014 World Champion and 2015 silver medallist " [:a {:href "/athletes/121658"} "Oleh Verniaiev"] " of Ukraine, the only man to qualify for as many as four individual finals in Rio, and he was the highest scoring qualifier for the parallel bars final. There was also the 2015 World Champion " [:a {:href "/athletes/133180"} "You Hao"] " of China and his team-mate " [:a {:href "/athletes/133181"} "Deng Shudi"] ", who was the bronze medallist in 2015. The silver and bronze medallists from the 2014 Worlds, " [:a {:href "/athletes/126655"} "Danell Leyva"] " of the USA and " [:a {:href "/athletes/120644"} "Ryohei Kato"] " of Japan, made up the strong line-up. The 2013 World Champion " [:a {:href "/athletes/133179"} "Lin Chaopan"] " of China missed out on qualification despite finishing sixth, but he was not eligible for the final as he was the third best placed Chinese gymnast and only two per country were eligible for the final."] "\n\n" [:p {} "The American Leyva set the pace with an opening 15.900. The Chinese gymnasts were up third and fourth and both chose the two toughest routines. You Hao’s had a difficulty of 7.400, but a fall backwards on landing was costly and his 14.833 put him into last place, although Deng’s 15.766 off a difficulty of 7.200 put him into second place. He was soon relegated to third after Russia’s " [:a {:href "/athletes/120451"} "David Belyavsky"] "’s routine scored him 15.783. The positions changed again when Verniaiev scored a massive 16.041, the best of the day, and that is how it remained as the last two, Cuba’s " [:a {:href "/athletes/133371"} "Manrique Larduet"] " and Japan’s Kato, did nothing to change the medal order. Verniaiev won Ukraine’s first gold of the Games and added to the silver he won in the all-round individual competition. The silver medal for Leyva was a sweet one because he was originally a reserve on the US team, despite being the only American male to win a medal in 2012, but injury to " [:a {:href "/athletes/126730"} "John Orozco"] "’s ankle in training led to Leyva being called into the team."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "191"] [:td {} [:a {:href "/athletes/121658"} "Oleh Verniaiev"]] [:td {} [:a {:href "/countries/UKR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UKR.png"}] "UKR"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "194"] [:td {} [:a {:href "/athletes/126655"} "Danell Leyva"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "176"] [:td {} [:a {:href "/athletes/120451"} "David Belyavsky"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :