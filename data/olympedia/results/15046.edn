alue "15091"} "Heavyweight (&gt;80 kilograms), Men"] "\n" [:option {:value "15118"} "Open Class, Men"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "15240"} "1972"] "\n" [:option {:value "15540"} "1976"] "\n" [:option {:value "15917"} "1980"] "\n" [:option {:value "16293"} "1984"] "\n" [:option {:value "16697"} "1988"] "\n" [:option {:value "17130"} "1992"] "\n" [:option {:value "17886"} "1996"] "\n" [:option {:value "18631"} "2000"] "\n" [:option {:value "19359"} "2004"] "\n" [:option {:value "260425"} "2008"] "\n" [:option {:value "316510"} "2012"] "\n" [:option {:value "354730"} "2016"] "\n" [:option {:value "18001088"} "2020"] "\n" [:option {:value "2006968"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/346"} "Event type"]] [:h1 {:class "event_title"} "Middleweight (≤80 kilograms), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "21 October 1964 — 13:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/465"} "Nippon Budokan, Chiyoda, Tokyo"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/15046"} "25 from 20 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Round-robin pools advanced judoka to single-elimination tournament."]]]] [:div {:class "description"} [:p {} "The favorite was " [:a {:href "/athletes/34183"} "Isao Okano"] ", a 3rd Dan from Chuo University. With only an Open Class conducted at the World Championships until 1965, he had no major international title, but he had not been defeated in several years. His only competition was thought to be the Korean, " [:a {:href "/athletes/33914"} "Kim Eui-Tae"] ". There were eight pools in the event. The second pool was won by " [:a {:href "/athletes/33519"} "Jim Bregman"] ", an American who had trained extensively in Japan. Kim won the sixth pool, and Okano won the eighth pool. In the quarter-finals, Okano faced France’s " [:a {:href "/athletes/33794"} "Lionel Grossain"] ", 1962 European Champion. After five minutes, Grossain found himself on his back, but reversed Okano, putting him onto his back, and at high risk of defeat. Okano grabbed Grossain’s collar in a form of " [:em {} "okuri-eri-jime"] ", and suddenly he realized that Grossain was not putting up any fight. He looked at the referee, trying to signal that Grossain was unconscious, but the referee did not acknowledge it. When a Japanese coach pointed out the limp legs of the Frenchman, the referee declared " [:em {} "ippon"] " for Okano. Okano immediately set to work to revive Grossain, using " [:em {} "katsu"] ", a traditional Japanese resuscitation technique, and he was not injured. After that, the semi-finals were anticlimactic. Okano defeated Kim in the second match by decision while in the first semi-final, " [:a {:href "/athletes/33835"} "Wolfgang Hoffman"] " (GER) defeated Bregman. The final was not competitive, as Okano sidestepped Hoffman’s attempt to throw him, and clamped on a " [:em {} "yoko-shiho-gatame"] ", ending the match in 1:36."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/34183"} "Isao Okano"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/33835"} "Wolfgang Hofmann"]] [: