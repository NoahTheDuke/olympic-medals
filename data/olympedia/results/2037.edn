en"] "\n" [:option {:value "2030"} "30 kilometres (Classical), Men"] "\n" [:option {:value "2031"} "50 kilometres (Freestyle), Men"] "\n" [:option {:value "2027"} "10/15 kilometres Pursuit, Men"] "\n" [:option {:value "2032"} "4 × 10 kilometres Relay, Men"] "\n" [:option {:value "2036"} "5 kilometres (Classical), Women"] "\n" [:option {:value "2040"} "15 kilometres (Classical), Women"] "\n" [:option {:value "2041"} "30 kilometres (Freestyle), Women"] "\n" [:option {:value "2042"} "4 × 5 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "2057"} "1994"] "\n" [:option {:value "2077"} "1998"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/201"} "Event type"]] [:h1 {:class "event_title"} "5/10 kilometres Pursuit, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "13 February 1992"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/11"} "Les Saisies"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2037"} "58 from 21 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "5 kilometres (Classical) style race on day one. On day two, runners left in order of their finish in the 5 kilometres (Classical), based on time differential, and skiied 10 kilometres (Freestyle), with final placements determined by finish of that race."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: ?" [:br {}] "Height Differential: 87 m" [:br {}] "Maximum Climb: 61 m" [:br {}] "Total Climbing: 381 m"]]]] [:div {:class "description"} [:p {} "This was the first time the pursuit was contested at the Winter Olympics, and it would not feature at the World Championships until the next year. The event consisted of results from the 5 km individual race, skied in the classical style. In the second section, skiers skied 10 km freestyle, starting in the order of their placements from the 5 km. Thus, the first skier across the line was the winner of the race. The co-leaders at the start were " [:a {:href "/athletes/81715"} "Marjut Lukkarinen"] ", winner of the 5 km, and " [:a {:href "/athletes/83087"} "Lyubov Yegorova"] ", who had won the silver in that event. The margin of victory in that race had been 0.9 seconds, but because starting margins are rounded down to the lesser second, they started together. Yegorova would post the fastest freestyle time to win the gold medal in this event. The fourth starter, " [:a {:href "/athletes/80627"} "Stefania Belmondo"] ", took the early lead in the freestyle section, but Yegorova moved ahead at 6.5 km and defeated her by over 24 seconds. " [:a {:href "/athletes/82972"} "Yelena Välbe"] " started third, having finished third in the 5 km, she posted the third fastest freestyle section, and won the bronze medal in this event as well. Lukkarinen dropped back to fouth place, with only the seventh fastest freestyle split. In 1993, Belmondo would win the inaugural World Championship in this event, with Yegorova placing third."] "\n"] [:button {:id "button742954", :class "btn btn-default"} "Details"] [:script {} "$('#button742954').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "Start Behind"] [:th {:style "display: none", :class "split"} "Race"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "2"] [:td {} [:a {:href "/athletes/83087"} "Lyubov Yegorova"]] [:td {} [:a {:href "/countries/EUN"} [:img {:style "padding-right: 2px;