ion {:value "255688"} "Kayak Singles, 1,000 metres, Men"] "\n" [:option {:value "255701"} "Kayak Doubles, 500 metres, Men"] "\n" [:option {:value "255714"} "Kayak Doubles, 1,000 metres, Men"] "\n" [:option {:value "255727"} "Kayak Fours, 1,000 metres, Men"] "\n" [:option {:value "255739"} "Canadian Singles, 500 metres, Men"] "\n" [:option {:value "255751"} "Canadian Singles, 1,000 metres, Men"] "\n" [:option {:value "255757"} "Canadian Doubles, 500 metres, Men"] "\n" [:option {:value "255763"} "Canadian Doubles, 1,000 metres, Men"] "\n" [:option {:value "255775"} "Kayak Doubles, 500 metres, Women"] "\n" [:option {:value "255782"} "Kayak Fours, 500 metres, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255046"} "1948"] "\n" [:option {:value "255081"} "1952"] "\n" [:option {:value "255114"} "1956"] "\n" [:option {:value "255209"} "1960"] "\n" [:option {:value "255276"} "1964"] "\n" [:option {:value "255340"} "1968"] "\n" [:option {:value "255420"} "1972"] "\n" [:option {:value "255557"} "1976"] "\n" [:option {:value "255663"} "1980"] "\n" [:option {:value "255897"} "1988"] "\n" [:option {:value "256039"} "1992"] "\n" [:option {:value "256169"} "1996"] "\n" [:option {:value "256292"} "2000"] "\n" [:option {:value "256409"} "2004"] "\n" [:option {:value "258840"} "2008"] "\n" [:option {:value "307130"} "2012"] "\n" [:option {:value "353567"} "2016"] "\n" [:option {:value "19016226"} "2020"] "\n" [:option {:value "2008572"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/178"} "Event type"]] [:h1 {:class "event_title"} "Kayak Singles, 500 metres, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "6 – 10 August 1984"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/604"} "Lake Casitas, Los Padres National Forest, California"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/255769"} "11 from 11 countries"]]]]] [:div {:class "description"} [:p {} "Unlike the 1980 American-led boycott, which had had a limited impact on the canoeing events, the Soviet boycott of the 1984 Summer Olympics severely depleted the field in the sport. This was noticeable in the women’s K-1 500, as nations that had been podium finishers at the last edition and won six of the last nine World Championship medals were absent. The most notable absentee, and a practical shoo-in for gold in this event, was " [:a {:href "/athletes/9879"} "Birgit Fischer"] ", who had helped East Germany win all nine gold medals in women’s disciplines at the last three Worlds. The only recent World Championship medalist in the event who was present was Sweden’s " [:a {:href "/athletes/10730"} "Agneta Andersson"] ", runner-up in 1982 and bronze medalist in 1981. " [:a {:href "/athletes/10566"} "Maria Ştefan"] " of Romania had finished third at the most recent World Championships, but was only competing in the K-4 500 at Los Angeles, and thus her nation was represented by " [:a {:href "/athletes/10558"} "Tecla Marinescu-Borcănea"] "."] "\n\n" [:p {} "In the opening round, Marinescu-Borcănea came third in her heat, behind Andersson and Australia’s " [:a {:href "/athletes/8974"} "Elizabeth Blencowe"] ", while the fastest time went to " [:a {:href "/athletes/9875"} "Barbara Schüttpelz"] " of West Germany. In the final, Andersson took the gold medal with ease, while Schüttpelz, Marinescu-Borcănea, and the Netherlands’ " [:a {:href "/athletes/10343"} "Annemiek Derckx"] " battled to the line for the remaining podium spots. Schüttpelz crossed first to win silver, but only 0.19 seconds separated her from fourth-placed Marinescu-Borcănea, who lost bronze to Derckx by the slimmest possible margin: 0.01 seconds. Andersson would go on to become a double Olympic champion later that day, when she won the K-2 500, and she captured silver in the K-4 500 the following day. Schüttpelz, meanwhile, would nab bronze in the K-2 500."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Rep"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "33"] [:td {} [:a {:href "/athletes/10730"} "Agneta Andersson"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "2:03.99 (1 h1)"] [:td {} "–"] [:td {} "1:58.72 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "14"] [:td {} [:a {:href "/athletes/9875"} "Barbara Schüttpelz"]] [:td {} [:a {:href "/countries/FRG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRG.png"}] "FRG"]] [:td {} "2:02.14 (1 h2)"] [:td {} "–"] [:td {} "1:59.93 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "22"] [:td {} [:a {:href "/athletes/10343"} "Annemiek Derckx"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "2:04.75 (3 h2)"] [:td {} "–"] [:td {} "2:00.11 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "31"] [:td {} [:a {:href "/athletes/10558"} "Tecla Marinescu-Borcănea"]] [:td {} [:a {:href "/countries/ROU"} [:img {:style "padd