7 points behind the runners-up, was the Netherlands, with Belgium a further 53 points adrift in fourth place."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Points"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Switzerland"] [:td {} [:a {:href "/countries/SUI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SUI.png"}] "SUI"]] [:td {} "2,271"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/44090"} "Conrad Karl Röderer"] " "] [:td {}] [:td {} "503"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/44109"} "Konrad Stäheli"] " "] [:td {}] [:td {} "453"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/44088"} "Louis Richardet"] " "] [:td {}] [:td {} "448"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/44078"} "Friedrich Lüthi"] " "] [:td {}] [:td {} "435"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/44084"} "Paul Probst"] " "] [:td {}] [:td {} "432"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "France"] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "2,203"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/42206"} "Achille Paroche"] " "] [:td {}] [:td {} "466"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/42140"} "Louis Dutfoy"] " "] [:td {}] [:td {} "442"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [