55"} "1952"] "\n" [:option {:value "123832"} "1956"] "\n" [:option {:value "124345"} "1960"] "\n" [:option {:value "125071"} "1964"] "\n" [:option {:value "125753"} "1968"] "\n" [:option {:value "127425"} "1976"] "\n" [:option {:value "128212"} "1980"] "\n" [:option {:value "128918"} "1984"] "\n" [:option {:value "129845"} "1988"] "\n" [:option {:value "131061"} "1992"] "\n" [:option {:value "132126"} "1996"] "\n" [:option {:value "133080"} "2000"] "\n" [:option {:value "133724"} "2004"] "\n" [:option {:value "263178"} "2008"] "\n" [:option {:value "332368"} "2012"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/672"} "Event type"]] [:h1 {:class "event_title"} "Lightweight, Freestyle (≤68 kg), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "27 – 31 August 1972"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/539"} "Ringer-Judo-Halle, Messegelände (Halle 14), München"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/126551"} "25 from 25 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Scoring by negative points, with negative points given for any result short of a fall (win by fall-0.0; win by superior decision-0.5; win by decision-1.0; draw-2.0; loss by decision-3.0; loss by superior decision-3.5; loss by fall-4.0). Accumulation of 6 negative points eliminated the wrestler. When three or fewer wrestlers remained, they advanced to a final round, with preliminary results carried forward."]]]] [:div {:class "description"} [:p {} "Iran’s " [:a {:href "/athletes/58810"} "Abdullah Movahed"] " had won five World Championships from 1965-70 but he was not favored in München. That role fell to the 1971 World Champion, " [:a {:href "/athletes/60636"} "Dan Gable"] ", considered by many the greatest wrestler America had ever produced. Gable had been undefeated in high school and college, until his final match in his senior year of college, when he was defeated in the NCAA final by Larry Owings. No such fate befell him in München as he won three of his first five bouts by falls, and won two decisions by shutouts. Nobody scored a point off him as he dominated the class to win the gold medal. In the final round he decisioned Soviet " [:a {:href "/athletes/60445"} "Ruslan Ashuraliyev"] " to win the gold medal, having beaten the other finalist, Japan’s " [:a {:href "/athletes/59114"} "Kikuo Wada"] " by decision in round four. Wada won the silver with Ashuraliyev taking bronze. Movahed was injured and withdrew after the second round."] "\n\n" [:p {} "Gable retired after the 1972 Olympics, although he made a limited comeback in 1976 trying to make another Olympic team, but he wrestled only a few matches. He later became the greatest wrestling coach in the US, leading his University of Iowa team to 15 NCAA team championships. Ashuraliyev moved up to welterweight and was the World Champion in that class in 1974 and 1975 and European Champion in 1974. Wada had no other major international podium finishes."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Round Eliminated"] [:th {} "Bad Points"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "389"] [:td {} [:a {:href "/athletes/60636"} "Dan Gable"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "210"] [:td {} [:a {:href "/athletes/59114"} "Kikuo Wada"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "http