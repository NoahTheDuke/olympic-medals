dividual Medley, Women"] "\n" [:option {:value "2001824"} "4 × 100 metres Medley Relay, Women"] "\n" [:option {:value "2001829"} "4 × 100 metres Medley Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "6086"} "1968"] "\n" [:option {:value "6389"} "1972"] "\n" [:option {:value "6666"} "1976"] "\n" [:option {:value "6901"} "1980"] "\n" [:option {:value "7181"} "1984"] "\n" [:option {:value "7527"} "1988"] "\n" [:option {:value "7880"} "1992"] "\n" [:option {:value "8225"} "1996"] "\n" [:option {:value "8629"} "2000"] "\n" [:option {:value "9020"} "2004"] "\n" [:option {:value "261759"} "2008"] "\n" [:option {:value "322107"} "2012"] "\n" [:option {:value "357247"} "2016"] "\n" [:option {:value "19000261"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/597"} "Event type"]] [:h1 {:class "event_title"} "100 metres Breaststroke, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "28 – 29 July 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2158"} "Paris La Défense Arena, Nanterre, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2001766"} "37 from 32 countries"]]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/132158"} "Lilly King"] " (USA) was the 2016 gold medalist and had won bronze at Tokyo 2020. She was also the world record holder, having set it while winning the 2017 World Championships. " [:a {:href "/athletes/146399"} "Tatjana Schoenmaker-Smith"] " of South Africa was a strong medal contender, having won silver in this event in 2020 and gold in the 200 breaststroke, while still Tatjana Schoenmaker. She had recently married before the Paris Olympics."] "\n\n" [:p {} "Schoenmaker-Smith led both the heats and semi-finals, oddly both in 1:05.00. Ireland’s " [:a {:href "/athletes/2505293"} "Mona McSharry"] " was second in the semis, followed by King, and then China’s " [:a {:href "/athletes/141770"} "Tang Qianting"] "."] "\n\n" [:p {} "Tang was the leader on the first lap of the final, but she did not finish well, coming home with the second slowest final lap, although she would hold on for the silver medal. King was in seventh at the turn, and while her last lap would be the fastest of the race, it was too late, as she would finish in a tie for fourth with Italy’s " [:a {:href "/athletes/144102"} "Benedetta Pilato"] "."] "\n\n" [:p {} "Schoenmaker-Smith was out somewhat slowly, tied for fourth at the turn with Pilato, but her final lap was bettered only by King, and would bring the South African the gold medal. McSharry was steady on both laps, edging out King and Pilato for bronze by only 1/100th of a second. She became only the second Olympic swimming medalist from Ireland, after " [:a {:href "/athletes/48302"} "Michelle Smith"] " won three gold medals and four medals at Atlanta 1996."] "\n\n" [:p {} "Two days later, Schoenmaker-Smith would take silver in the 200 breaststroke, giving her gold-silver in the two backstroke events at both the 2020 and 2024 Olympics, although she reversed the order in Paris."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/146399"} "Tatjana Schoenmaker-Smith"]] [:td {} [:a {:href "/countries/RSA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RSA.png"}] "RSA"]] [:td {} "1:05.00 (1 h4)"] [:t