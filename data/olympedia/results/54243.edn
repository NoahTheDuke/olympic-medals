value "54249"} "Platform, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "54001"} "1906"] "\n" [:option {:value "54002"} "1908"] "\n" [:option {:value "54030"} "1912"] "\n" [:option {:value "54054"} "1920"] "\n" [:option {:value "54082"} "1924"] "\n" [:option {:value "54104"} "1928"] "\n" [:option {:value "54118"} "1932"] "\n" [:option {:value "54122"} "1936"] "\n" [:option {:value "54126"} "1948"] "\n" [:option {:value "54132"} "1952"] "\n" [:option {:value "54144"} "1956"] "\n" [:option {:value "54157"} "1960"] "\n" [:option {:value "54171"} "1964"] "\n" [:option {:value "54183"} "1968"] "\n" [:option {:value "54195"} "1972"] "\n" [:option {:value "54207"} "1976"] "\n" [:option {:value "54219"} "1980"] "\n" [:option {:value "54231"} "1984"] "\n" [:option {:value "54255"} "1992"] "\n" [:option {:value "54268"} "1996"] "\n" [:option {:value "54284"} "2000"] "\n" [:option {:value "54304"} "2004"] "\n" [:option {:value "259050"} "2008"] "\n" [:option {:value "309102"} "2012"] "\n" [:option {:value "353784"} "2016"] "\n" [:option {:value "19002234"} "2020"] "\n" [:option {:value "2010634"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/251"} "Event type"]] [:h1 {:class "event_title"} "Platform, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "26 – 27 September 1988"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/643"} "Su-yeong-jang, Ol-lim-pik Gong-won, Seoul"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/54243"} "26 from 15 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "10 metres platform."]]]] [:div {:class "description"} [:p {} "The 1976 Olympic platform final had featured Italy’s " [:a {:href "/athletes/48511"} "Klaus Dibiasi"] " against the next great thing, 16-year-old " [:a {:href "/athletes/51468"} "Greg Louganis"] ". Dibiasi won his third consecutive gold medal, with Louganis getting silver, only to see him dominate diving over the next 12 years. In Seoul, the men’s platform event evoked memories of Montréal, with Louganis now the world’s greatest diver, but he was challenged by the new next great thing, China’s 14-year-old " [:a {:href "/athletes/46156"} "Xiong Ni"] ". Louganis had won this event in 1984, and had already won the springboard in Seoul, after the trauma of hitting his head on the board on a qualifying dive."] "\n\n" [:p {} "The event was very close in the final, with no more than 10 points separating either diver after every round. After nine rounds, Xiong led by 3.00 points, and he dove first on the final round. He ripped his inward 3½ tuck for a 9.0 and four 8.5s, scoring 82.56 points. Louganis had chosen a reverse 3½ tuck on his final effort, the so-called “Dive of Death,” so named because Soviet diver Sergey Chalibashvilli had died after attempting the dive and hitting his head on the platform at the 1983 Universiade. But Louganis performed it well, not perfectly, but well, and scored all 8.5s from the judges. With the DD of 3.4, this gave him 85.56 points for the dive and the gold medal by 1.14 points."] "\n\n" [:p {} "Louganis announced his retirement from diving a few weeks after the Seoul Olympics. He is considered the greatest diver of all-time, having won the diving double-double in 1984 and 1988, a World diving double-double in 1982 and 1986, and a Pan American Games triple-double in 1979, 1983, and 1987. Only the 1980 USA-led boycott of the Moscow Olympics prevented him from a probable triple-double at the Olympics."] "\n\n" [:p {} "Xiong was far from finished. He won a bronze medal on platform at the 1992 Olympics, and then won three gold medals, on springboard in 1996 and 2000, and in synchro springboard in 2000. His great opponent in the 1990s, " [:a {:href "/athletes/50061"} "Dmitry Sautin"] ", would later call him the “King of Divers.”"] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/51468"} "Greg Louganis"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "617.67 (1)"] [:td {} "638.61 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/46156"} "Xiong Ni"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} "601.50 (2)"] [:td {} "637.47 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/49215"} "Jesús Mena"]] [:td {} [:a {:href "/countries/MEX"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/MEX.png"}] "MEX"]] [:td {} "523.50 (10)"] [:td {} "594.39 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/50917"} "Giorgi Chogovadze"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "540.90 (7)"] [:td {} "585.96 (4)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {} [:a {:href "/athletes/4