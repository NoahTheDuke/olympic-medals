e "2000170"} "Team, Women"] "\n" [:option {:value "2000192"} "Team, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "40687"} "1988"] "\n" [:option {:value "40788"} "1992"] "\n" [:option {:value "40957"} "1996"] "\n" [:option {:value "41153"} "2000"] "\n" [:option {:value "41345"} "2004"] "\n" [:option {:value "257024"} "2008"] "\n" [:option {:value "301000"} "2012"] "\n" [:option {:value "351144"} "2016"] "\n" [:option {:value "18000566"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/2"} "Event type"]] [:h1 {:class "event_title"} "Team, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "29 July 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2174"} "Les Invalides, Paris, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2000074"} "36 from 12 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Teams consisted of three archers.  Ranking rounds scores based on scores carried over from individual ranking round.  Tie-breaking for the final placements was done by the following method.  Losers in each round were ranked according to the score they shot in that round.  Ties in that round were broken by the number of 10s shot in that round and then the number of 9s shot in that round. If still tied the score in the preceding round was used as the tie-breaker, followed by number of 10s, and then number of 9s in the preceding round.  Team event shot entirely at 70 metres. Matches consisted of a minium of 18 arrows, 6 per archer."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record  (Ranking Round, 216 arrows)"] [:td {} [:a {:href "/results/301000"} "2087"] " " [:span {:class "label label-primary"} "WR"] " / " [:a {:href "/athletes/102882"} "Im Dong-Hyeon"] " • " [:a {:href "/athletes/124391"} "Kim Beop-Min"] " • " [:a {:href "/athletes/124388"} "Oh Jin-Hyeok"] " " [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"] " / 27 July 2012 / " [:a {:href "/records/event_name/2/Ranking%20Round,%20216%20arrows"} "Details"]]]]] [:div {:class "description"} [:p {} "As the top ranked team in the world, the Republic of Korea was expected to do well in this event. As they had the top two finishers in the ranking round, they finished as the leading nation in the team event ranking."] "\n\n" [:p {} "The round of 16 went to form, although it took shoot-offs for Italy to defeat Kazakhstan, and for Türkiye, containing reigning Olympic, World and European champion " [:a {:href "/athletes/136120"} "Mete Gazoz"] ", to defeat Colombia. None of the quarter-finals matches were close, each of the winners defeating their opponents by four points. The main surprise was the victory of Türkiye over the world’s second ranked team India (and third highest finishers in the ranking round) by 6-2. The first semi-final saw the Republic of Korea taking on China, which Korea won comfortably 5-1. France, the host nation and second highest finishers from the ranking round, competed against Türkiye in the other semi-final in a very tight match. Tied 4-4 after four sets, the shoot-off resulted in a further 27-27 tie, but the French advanced as the arrow shot by " [:a {:href "/athletes/142799"} "Thomas Chirault"] " was closest to the centre."] "\n\n" [:p {} "In the bronze medal match, Türkiye took an early lead before China won the second set. The remaining two sets were close, but Türkiye took the match 5-3, to win their first ever medal in this event. France were also guaranteed their first medal in this event as they met the Republic of Korea in the final. However, this was to be silver, as the Koreans were in superb form, dropping just five points in 18 arrows, winning the match 5-1. Thus, " [:a {:href "/athletes/134919"} "Kim Wu-Jin"] ", " [:a {:href "/athletes/144969"} "Kim Je-Deok"] ", and " [:a {:href "/athletes/ 2103814"} "Lee U-Seok"] " became the champions."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Republic of Korea"] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/2103814"} "Lee U-Seok"] " • " [:a {:href "/athletes/144969"} "Kim Je-Deok"] " • " [:a {:href "/athletes/134919"} "Kim Wu-Jin"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "France"] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/142799"} "Thomas Chirault"] " • " [:a {:href "/athletes/111548"} "Jean-Charles Valladont"] " • " [:a {:href "/athletes/149525"} "Baptiste Addis"]]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} "Türkiye"] [:td {} [:a {:href "/countries/TUR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/TUR.png"}] "TUR"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"}