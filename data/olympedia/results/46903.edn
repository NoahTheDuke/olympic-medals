n {:value "47065"} "Doubles, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "47350"} "1992"] "\n" [:option {:value "47784"} "1996"] "\n" [:option {:value "48187"} "2000"] "\n" [:option {:value "48480"} "2004"] "\n" [:option {:value "262591"} "2008"] "\n" [:option {:value "328000"} "2012"] "\n" [:option {:value "395960"} "2016"] "\n" [:option {:value "19004030"} "2020"] "\n" [:option {:value "2006127"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/627"} "Event type"]] [:h1 {:class "event_title"} "Singles, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "23 September –  1 October 1988"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/661"} "Che-yuk-gwan, Seo-ul Dae-hak-gyo, Seoul"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/46903"} "48 from 28 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Round-robin qualifying pools, followed by single-elimination tournament."]]]] [:div {:class "description"} [:p {} "China had a monopoly on the leading players in the world. The #1 ranked player was 1987 World Champion He Zhili and #3 was Dai Lili. But neither player was chosen to play. Wallechinsky has noted that He was being punished for refusing to throw a match to another Chinese player during the 1987 Worlds. But their absence hardly mattered, as the Chinese swept the medals. The gold went to " [:a {:href "/athletes/778"} "Chen Jing"] ", who was only 21-years-old and had little international experience. Chen would later defect to Taiwan (Chinese Taipei in the Olympic Movement) and represent that nation at the 1996 and 2000 Olympics. He Zhili would also emigrate, settling in Japan, where she took the name " [:a {:href "/athletes/843"} "Chire Koyama"] ", and she also competed at the 1996 and 2000 Olympics. The bronze medalist in 1988 was " [:a {:href "/athletes/2284"} "Jiao Zhimin"] ". The Korean press were all over her during the Seoul Olympics because of her romance with Korean doubles player " [:a {:href "/athletes/911"} "Ahn Jae-Hyung"] ". Jiao and Ahn did eventually marry and settled in Korea, but neither player ever competed again at the Olympics."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/778"} "Chen Jing"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/2285"} "Li Huifen"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/2284"} "Jiao Zhimin"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/2640"} "Marie Hrachová"]] [:td {} [:a {:href "/countries/TCH"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/TCH.png"}]