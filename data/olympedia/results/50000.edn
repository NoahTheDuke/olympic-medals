("<!DOCTYPE html>" "\n" [:html {} "\n" [:head {} "\n" [:title {} "Olympedia – Individual, Men"] "\n" [:meta {:name "csrf-param", :content "authenticity_token"}] "\n" [:meta {:name "csrf-token", :content "U5a4LUzum5anTYb7naMGZeZJcXhkv-u7lxJTXh5HoAL8W4B9cf8Vp6ztlP80xX416N7CFwEvGHFp8hD0lm65ag"}] "\n" [:meta {:content "text/html; charset=UTF-8", :http-equiv "Content-Type"}] "\n" [:meta {:content "EN", :http-equiv "content-language"}] "\n" [:meta {:content "width=device-width, initial-scale=1", :name "viewport"}] "\n" [:link {:rel "stylesheet", :href "/assets/bootstrap.min-03423cd68c2bff228a73520e849f02d78d1236de443661f3f5dcd658dd9cbc46.css", :media "all"}] "\n" [:link {:rel "stylesheet", :href "/assets/bootstrap-sortable-515ee97c8b372ddae7796a36ec518e0785e0e3d3d266162ba2c44a3623540f7b.css", :media "all"}] "\n" [:link {:rel "stylesheet", :href "/assets/jquery-ui-1.11.4.min-35aebb4aa1818460c44d32da4f18101d34f332741a347654907911af0d145e88.css", :media "all"}] "\n" [:link {:rel "stylesheet", :href "/assets/lightbox-3afc0e08d652072ea73df78af7d454f122da80b9124d782fb609a7b4b05e0197.css", :media "screen"}] "\n" [:link {:rel "stylesheet", :href "/assets/application-4f84d527cff438ca091e50578c30f46bea0e80f407f0317732495990ae6f2d0f.css", :media "all", :data-turbolinks-track "true"}] "\n" [:link {:rel "stylesheet", :href "https://cdn.jsdelivr.net/npm/ol@v10.0.0/ol.css", :media "screen"}] "\n" [:script {:src "https://cdn.jsdelivr.net/npm/ol@v10.0.0/dist/ol.js"}] #object[org.jsoup.nodes.TextNode 0x61477d69 ""] [:script {:src "/assets/omm-34ac1a3b4884461c87bafa8ec1c1c21bcc434c53c51d3b1f82d1dff57ad3856b.js"}] #object[org.jsoup.nodes.TextNode 0x707368be ""] [:script {:src "/assets/jquery-1.11.2.min-224c81cc15edb399b9465fc371dffb02e6fe4c043716571b49b1a7b2bcc09ef1.js"}] #object[org.jsoup.nodes.TextNode 0xf6aca09 ""] [:script {:src "/assets/jquery-ui-1.11.4.min-96b45d6922993b35cca7b07ede8f0bf64353715e3729b9019eb2e46a8737dac8.js"}] #object[org.jsoup.nodes.TextNode 0x70425770 ""] [:script {:src "/assets/jquery-ujs-f09ebd8e2bbe3d80718935c572e83dbb10f72e7a2aec58b193ee1e2e2e8e373a.js"}] #object[org.jsoup.nodes.TextNode 0x2a34d024 ""] [:script {:src "/assets/bootstrap.min-2b9640a7175349197c70d8b752f484837518c6cbdce416dead60cdeebd875294.js"}] #object[org.jsoup.nodes.TextNode 0x41697b44 ""] [:script {:src "/assets/moment-93e00e6729db142363a35d17328084c3bd3d62304ecd27f91e9c954550daa1ce.js"}] #object[org.jsoup.nodes.TextNode 0x188acbe2 ""] [:script {:src "/assets/bootstrap-sortable-e790a4de58d52fde6861014956b371ac860d665b62c23af929a33a9f39e84d04.js"}] #object[org.jsoup.nodes.TextNode 0x7a91f654 ""]] "\n\n" [:body {} "\n" [:div {:class "navbar navbar-default navbar-fixed-top", :role "navigation"} "\n" [:div {:class "navbar-header"} "\n" [:div {:class "button navbar-toggle", :data-target ".navbar-ex1-collapse", :data-toggle "collapse", :type "button"} "\n" [:span {:class "sr-only"} "Toggle navigation"] "\n" [:span {:class "icon-bar"} "\n" [:span {:class "icon-bar"} "\n" [:span {:class "icon-bar"}] "\n"] "\n"] "\n"] "\n" [:a {:class "navbar-brand", :href "/", :style "padding-top: 10px"} "\n" [:img {:height "30px", :src "/images/olymadmen.png", :width "30px"}] "\n"] "\n" [:a {:class "navbar-brand", :href "/"} "Olympedia"] "\n"] "\n" [:div {:class "collapse navbar-collapse navbar-ex1-collapse"} "\n" [:ul {:class "nav navbar-nav"} "\n" [:li {:class "dropdown"} "\n" [:a {:class "dropdown-toggle", :data-toggle "dropdown", :href "#"} "\nAthletes\n" [:b {:class "caret"}] "\n"] "\n" [:ul {:class "dropdown-menu"} "\n" [:li {} [:a {:href "/athletes/advanced_search"} "Advanced search"]] "\n" [:li {} [:a {:href "/horses"} "Horse search"]] "\n" [:li {} [:a {:href "/family_relations"} "Related Olympians"]] "\n" [:li {} [:a {:href "/counts"} "Counts"]] "\n" [:li {} [:a {:href "/athletes/doubles"} "Doubles"]] "\n" [:li {} [:a {:href "/athletes/lists"} "Lists"]] "\n" [:li {} [:a {:href "/athletes/country_representation"} "Country representation"]] "\n" [:li {:class "divider"}] "\n