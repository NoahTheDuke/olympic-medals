25943"} "1968"] "\n" [:option {:value "126759"} "1972"] "\n" [:option {:value "127614"} "1976"] "\n" [:option {:value "128376"} "1980"] "\n" [:option {:value "129134"} "1984"] "\n" [:option {:value "130167"} "1988"] "\n" [:option {:value "131271"} "1992"] "\n" [:option {:value "132349"} "1996"] "\n" [:option {:value "133253"} "2000"] "\n" [:option {:value "133885"} "2004"] "\n" [:option {:value "263362"} "2008"] "\n" [:option {:value "355404"} "2016"] "\n" [:option {:value "19009590"} "2020"] "\n" [:option {:value "2008067"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/676"} "Event type"]] [:h1 {:class "event_title"} "Heavyweight, Freestyle (≤96 kg), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "12 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/861"} "ExCeL, Newham, London"] " (North Arena 2)"]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/332552"} "17 from 17 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single elimination tournament. Competitors losing to the finalists entered repechage tournament for bronze medals."]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/117098"} "Reza Yazdani"] " of Iran was the reigning World Champion in men’s heavyweight freestyle wrestling, but he had also found success as a light-heavyweight earlier in his career, with two World Championship bronze medals (2006 and 2007) and an Asian Games title from 2006. He had switched to heavyweight in 2010 and again won a gold medal in the Asian Games, as well as at that year’s Asian Championships. Yazdani was a favorite, but he was expected to be challenged by " [:a {:href "/athletes/120367"} "Abdusalam Gadisov"] " who, as the 2012 European Champion, represented the strong Russian presence in this event, as Russian wrestlers had won the past two Olympics. These two were the favorites and, when they were drawn into the same bracket, the question of who would challenge for gold remained an elusive one."] "\n\n" [:p {} "Yazdani and Gadisov met in the 1/8th finals, where Yazdani emerged victorious and moved on to the semi-finals, where he experienced intense pain from an old knee injury in the first period fight against " [:a {:href "/athletes/121336"} "Valeriy Andriitsev"] " of Ukraine and had to be taken out of the arena in a wheelchair. Andriitsev was the runner-up at the most recent European Championships and met " [:a {:href "/athletes/126623"} "Jake Varner"] " of the United States in the gold medal match, who was a bronze medalist from the 2011 World Championships. The two were ferocious, but evenly-matched, in the final but Varner was able to score just one point in each period to earn the Olympic crown."] "\n\n" [:p {} "The first bronze medal bout was contested between " [:a {:href "/athletes/117113"} "Kurban Kurbanov"] " of Uzbekistan, 2011 Asian Champion, runner-up at the 2010 Asian Games, and bronze medalist at the 2007 World Championships, and " [:a {:href "/athletes/117110"} "Giorgi Gogshelidze"] " of Georgia, a former competitor for Russia who was a 2008 Olympic bronze medalist, 2001 World Champion, and 2008 European Champion among a host of other accolades. Kurbanov managed to push Gogshelidze out of the ring in the first period to win it, but the Georgian got his revenge by scoring four unanswered points in the first minute of the second round. In the final period, Gogshelidze continued to be dominant and evoked little response from the Uzbek, winning the bronze medal with a score of 2-0. The battle for the final podium spot would ostensibly have been between Yazdani and the winner of repêchage round two but, with the Iranian injured, the true deciding match was the repêchage, fought between " [:a {:href "/athletes/123525"} "Rustam Iskandari"] " of Tajikistan, a rookie, and " [:a {:href "/athletes/117109"} "Xetaq Qazyumov"] " of Azerbaijan, 2008 Olympic bronze medalist, 2010 World Champion, 2009 world runner-up, and thrice European Champion (2009-2011). Qazyumov was the overwhelming favorite and did not disappoint; although Iskandari scored the first point, he was not able to repeat it, losing 1-3 and 0-3 to give the Azerbaijani his second Olympic bronze."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/126623"} "Jake Varner"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/121336"} "Valeriy Andriytsev"]] [:td {} [:a {:href "/countries/UKR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UKR.png"}] "UKR"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/117109"} "Xetaq Qazyumov"]] [:td {} [:a {:href "/countries/AZE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AZE.png"}] "AZE"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/117110"} "Giorgi Gogshelidze"]] [:td {} [:a {:href "/countries/GEO"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GEO.png"}] "GEO"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=5"] [:td {} [:a {:href "/athletes/117098"} "Reza Yazdani"]] 