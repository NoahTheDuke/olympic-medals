on {:value "2006203"} "Team, Women"] "\n" [:option {:value "2006304"} "Doubles, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "46903"} "1988"] "\n" [:option {:value "47350"} "1992"] "\n" [:option {:value "47784"} "1996"] "\n" [:option {:value "48187"} "2000"] "\n" [:option {:value "48480"} "2004"] "\n" [:option {:value "262591"} "2008"] "\n" [:option {:value "328000"} "2012"] "\n" [:option {:value "395960"} "2016"] "\n" [:option {:value "19004030"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/627"} "Event type"]] [:h1 {:class "event_title"} "Singles, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "27 July –  3 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2165"} "Paris Expo Porte de Versailles, Paris, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2006127"} "67 from 44 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament"]]]] [:div {:class "description"} [:p {} "For the singles, each nation was allowed to register two athletes from the respective team competition. An additional 22 qualified through continental qualifying tournaments. There was also the possibility of qualifying in an international qualification tournament. Also, the best placed athlete in the ITTF world rankings who had not yet qualified received a quota place."] "\n\n" [:p {} "The two finalists were the same as in Tokyo three years before. " [:a {:href "/athletes/141782"} "Chen Meng"] " successfully defended her title, defeating world No.1 " [:a {:href "/athletes/2504735"} "Sun Yingsha"] " in a thrilling final. The second seed emerged victorious, joining an elite group of players to win back-to-back Olympic table tennis gold medals, after fellow Chinese players " [:a {:href "/athletes/781"} "Deng Yaping"] " (1992, 1996) and " [:a {:href "/athletes/107444"} "Zhang Yining"] " (2004, 2008). " [:a {:href "/athletes/155141"} "Hina Hayata"] " secured the bronze medal for Japan, defeating " [:a {:href "/athletes/144958"} "Sin Yu-Bin"] " of South Korea. This marked the second consecutive Olympics with a Japanese player on the women’s singles podium, following " [:a {:href "/athletes/130838"} "Mima Ito"] "’s bronze medal in Tokyo 2020."] "\n\n" [:p {} "Starting in 1988, this was the tenth addition of the Olympic women’s singles, and was also the tenth Chinese gold in this discipline. Typical of the Asian dominance, seven of the best eight ranked players in Paris came from Asia. Silver medalist Sun Yingsha won a gold medal in the mixed pairs event. The 51-year-old China born Luxembourgian " [:a {:href "/athletes/93997"} "Xia Lian Ni"] " participated in her sixth Olympics. The 58-year-old Chilean " [:a {:href "/athletes/155115"} "Tania Zeng"] " made her Olympic début in Paris, almost four decades after missing out on being selected for China at Los Angeles 1984."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/141782"} "Chen Meng"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/2504735"} "Sun Yingsha"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align