02514"} "High Jump, Women"] "\n" [:option {:value "302198"} "Pole Vault, Women"] "\n" [:option {:value "9031008"} "Long Jump, Women"] "\n" [:option {:value "9031022"} "Triple Jump, Women"] "\n" [:option {:value "302181"} "Shot Put, Women"] "\n" [:option {:value "302021"} "Discus Throw, Women"] "\n" [:option {:value "302480"} "Hammer Throw, Women"] "\n" [:option {:value "302463"} "Javelin Throw, Women"] "\n" [:option {:value "302147"} "Heptathlon, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "257653"} "2008"] "\n" [:option {:value "359093"} "2016"] "\n" [:option {:value "19000767"} "2020"] "\n" [:option {:value "2013937"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/700"} "Event type"]] [:h1 {:class "event_title"} "3,000 metres Steeplechase, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "4 –  6 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/874"} "Olympic Stadium, Olympic Park, Stratford, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/302175"} "44 from 26 countries"]]]]] [:div {:class "description"} [:p {} "Russia’s " [:a {:href "/athletes/121311"} "Yuliya Zaripova"] " had won the steeple at the 2011 World Championships, and had steadily moved up the world rankings, ranking 3rd in 2009, 2nd in 2010, and 1st in 2011. She came into London favored and proved the experts correct, winning the gold medal in a comfortable 9:06.72, almost two seconds ahead of the runner-up " [:a {:href "/athletes/114432"} "Habiba Ghribi"] " of Tunisia. Zaripova led from the start and continued to string out the field with her excellent hurdling technique. After two kilometres, only Al-Ghribi, " [:a {:href "/athletes/114449"} "Sofia Assefa"] " of Ethiopia and " [:a {:href "/athletes/121089"} "Milcah Chemos"] " of Kenya could maintain contact with her. On the final lap, Al-Ghribi moved to Zaripova’s shoulder and seemed ready to pass her, but Zaripova picked up the pace and waltzed away to victory, not hampered by having led from the start. Zaripova said, “It was easy to win this gold. I was very confident about winning.” Assefa followed Al-Ghribi across the line for the bronze medal, with Chemos finishing fourth. Defending champion " [:a {:href "/athletes/104993"} "Gulnara Samitova-Galkina"] " competed in the final but did not finish."] "\n\n" [:p {} "Al-Ghribi did not have an easy time competing as a Tunisian woman in athletics. Radicals in Tunisia claimed her behavior was un-Islamic and they urged the Tunisian government to strip her of her nationality because her running gear was too revealing."] "\n\n" [:p {} "That was how the event and the results seemed to have ended. In 2015, however, the IOC began re-testing samples from the 2008 Beijing and 2012 London Olympics, using newer, more advanced testing techniques, in an effort to find those who had used performance enhancing drugs (PEDs), but in whom it could not be detected at the time of those Olympics. This was one of the many events affected."] "\n\n" [:p {} "The gold medalist, " [:a {:href "/athletes/121311"} "Yuliya Zaripova"] ", was found guilty of a biological passport offense in March 2016 and was disqualified. Tunisia’s " [:a {:href "/athletes/114432"} "Habiba Ghribi"] " was advanced to the gold medal, while the silver went to the original bronze medalist, " [:a {:href "/athletes/114449"} "Sofia Assefa"] " of Ethiopia, with original fourth-place finisher " [:a {:href "/athletes/121089"} "Milcah Chemos"] " was awarded the bronze medal."] "\n\n" [:p {} "No other medalists were affected but between May and December 2015, three runners were also disqualified for biological passport offenses. These were Spaniard " [:a {:href "/athletes/67120"} "Marta Domínguez"] ", who finished 12th in the final, Turkish runner " [:a {:href "/athletes/104966"} "Binnaz Uslu"] ", and Ukrainian " [:a {:href "/athletes/122555"} "Svitlana Shmidt"] ", both of whom did not advance out of the first round. Another runner, " [:a {:href "/athletes/125358"} "Gülcan Mıngır"] ", who also did not make the final, was later disqualified for a retroactive doping positive announced in February 2020."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "3069"] [:td {} [:a {:href "/athletes/114432"} "Habiba Ghribi"]] [:td {} [:a {:href "/countries/TUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/TUN.png"}] "TUN"]] [:td {} "9:27.42 (2 h2)"] [:td {} "9:08.37 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "1699"] [:td {} [:a {:href "/athletes/114449"} "Sofia Assefa"]] [:td {} [:a {:href "/countries/ETH"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ETH.png"}] "ETH"]] [:td {} "9:25.42 (1 h2)"] [:td {} "9:09.84 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "2328"] [:td {} [:a {:href "/athletes/121089"} "Milcah Chemos Cheywa"]] [:td {} [:a {:href "/countries/KEN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KEN.png"}] "KEN"]] [:td {} "9:27.09 (3 h1)"] [:td {} "9:09.88 (3)"] [:td {} [:span {:c