56763"} "1912"] "\n" [:option {:value "57196"} "1920"] "\n" [:option {:value "57478"} "1924"] "\n" [:option {:value "57760"} "1928"] "\n" [:option {:value "58031"} "1932"] "\n" [:option {:value "58303"} "1936"] "\n" [:option {:value "58634"} "1948"] "\n" [:option {:value "59008"} "1952"] "\n" [:option {:value "59390"} "1956"] "\n" [:option {:value "59789"} "1960"] "\n" [:option {:value "60226"} "1964"] "\n" [:option {:value "60678"} "1968"] "\n" [:option {:value "61188"} "1972"] "\n" [:option {:value "61763"} "1976"] "\n" [:option {:value "62325"} "1980"] "\n" [:option {:value "62818"} "1984"] "\n" [:option {:value "63462"} "1988"] "\n" [:option {:value "64137"} "1992"] "\n" [:option {:value "64828"} "1996"] "\n" [:option {:value "65488"} "2000"] "\n" [:option {:value "66164"} "2004"] "\n" [:option {:value "257298"} "2008"] "\n" [:option {:value "302440"} "2012"] "\n" [:option {:value "358704"} "2016"] "\n" [:option {:value "19000487"} "2020"] "\n" [:option {:value "2013644"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/75"} "Event type"]] [:h1 {:class "event_title"} "Pole Vault, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "24 July 1908"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/216"} "White City Stadium, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/56461"} "15 from 7 countries"]]]]] [:div {:class "description"} [:p {} "The world record was 12-9 (3.90), which had recently been set by " [:a {:href "/athletes/78336"} "Walter Dray"] " (USA), on 13 June 1908.  The Olympic record had been set by " [:a {:href "/athletes/78355"} "Charles Dvorak"] " at " [:a {:href "/results/56143"} "St. Louis in 1904"] ", with 11-6 (3.50).  Neither Dvorak nor Dray competed, although Dray had finished in a four-way tie for first at the 1908 IC4A Meet, on 30 May.  Dray had tied with " [:a {:href "/athletes/78453"} "A. C. Gilbert"] ", " [:a {:href "/athletes/78836"} "Frank Nelson"] ", and Charles Campbell, and all four competed for Yale University’s track team.  Dray withdrew because his mother was concerned that he might be injured if he competed.  Gilbert had also won the Eastern Olympic Trial, with Dray and Nelson tying for second.  Among other nations, the top vaulters were Sweden’s " [:a {:href "/athletes/76418"} "Bruno Söderström"] ", 1907 AAA champion and silver medalist in " [:a {:href "/results/56225"} "1906"] ", and Canada’s " [:a {:href "/athletes/65950"} "Ed Archibald"] ", who had cleared 12-5 (3.80) in Canada earlier in the season and, three weeks before the Games, had won the British title at 12-0 (3.66)."] "\n\n" [:p {} "Five competitors broke the Olympic record, and two more equaled the former record.  The Americans Alfred “A. C.” Gilbert and " [:a {:href "/athletes/78262"} "Ed Cook"] " shared first place at 12-2 (3.71), with Archibald and Söderström tying with " [:a {:href "/athletes/78593"} "Clare Jacobs"] " (USA) for third.  The closing stages of the competition were considerably delayed, as they coincided with the dramatic happenings at the finish of the " [:a {:href "/results/56369"} "marathon"] ".  Because of the time factor, the officials decided against holding jump-offs for first and third places and, in an unusual decision, two gold and three bronze medals were awarded."] "\n\n" [:p {} "For the last time in Olympic competition, the “climbing” technique was permitted, although it remained legal in England until 1920.  Among their numerous protests, the Americans argued about the fact that there was no pit or hole in which to plant the pole, and also that there was no sandpit or bales of straw to break the competitors falls.  This protest was understandable as the organizers were definitely behind the times in these matters, as these facilities had been provided at the two previous Olympic Games."] "\n\n" [:p {} "Ed Cook was a fine all-around jumper and hurdler.  He won the IC4A long jump in 1908 and 1909, the AAU pole vault in 1907, and tied for first in the AAU pole vault in 1911.  Gilbert spread his athletic talents even farther, winning the 1905 Yale gymnastics championship, and was intercollegiate wrestling champion in 1906.  Gilbert earned an M.D. degree from Yale but never practiced medicine.  He later made a fortune as president of the toy company that bore his name, and manufactured Erector Sets, American Flyer electric trains, and other popular toys."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "=1"] [:td {} [:a {:href "/athletes/78453"} "A. C. Gilbert"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "3.66 (2)"] [:td {} "3.71 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record (equalled)"} "=OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "=1"] [:td {} [:a {:href "/athletes/78262"} "Ed Cook"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "3.71 (1)"] [:td {} "3.66 (2)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record (equalled)"} "=OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/78593"} "Clare Jacobs"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "3.50 (5)"] 