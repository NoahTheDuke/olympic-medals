lue "2184"} "1924"] "\n" [:option {:value "2189"} "1928"] "\n" [:option {:value "2194"} "1932"] "\n" [:option {:value "2199"} "1936"] "\n" [:option {:value "2204"} "1948"] "\n" [:option {:value "2210"} "1952"] "\n" [:option {:value "2217"} "1956"] "\n" [:option {:value "2224"} "1960"] "\n" [:option {:value "2231"} "1964"] "\n" [:option {:value "2238"} "1968"] "\n" [:option {:value "2245"} "1972"] "\n" [:option {:value "2259"} "1980"] "\n" [:option {:value "2266"} "1984"] "\n" [:option {:value "2273"} "1988"] "\n" [:option {:value "2287"} "1992"] "\n" [:option {:value "2301"} "1994"] "\n" [:option {:value "2311"} "1998"] "\n" [:option {:value "2321"} "2002"] "\n" [:option {:value "2334"} "2006"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/368"} "Event type"]] [:h1 {:class "event_title"} "Individual, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "8 –  9 February 1976"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/55"} "Kombinationssprungschanze, Seefeld"] " / " [:a {:href "/venues/59"} "Langlaufstadion, Seefeld"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2252"} "34 from 14 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Normal hill ski jumping and 15 kilometres skiing; placements determined by points table."]]]] [:div {:class "description"} [:p {} "Since 1972, the defending Olympic Champion " [:a {:href "/athletes/98862"} "Ulrich Wehling"] " had been dominant on the international Nordic Combined scene, winning the 1974 World Championships and the 1975 Holmenkollen. He was the hot favorite for another Olympic gold and was heading a strong East German team with the silver medalist from the 1974 World Championships " [:a {:href "/athletes/85113"} "Günther  Deckert"] " and two promising youngsters, " [:a {:href "/athletes/98993"} "Konrad Winkler"] " and " [:a {:href "/athletes/98416"} "Claus Tuchscherer"] " on the team."] "\n\n" [:p {} "In ski jumping, Wehling showed excellent form, having the longest and best jump in all three rounds. His Finnish rival, Olympic silver medalist from 1972 " [:a {:href "/athletes/95429"} "Rauno Miettinen"] " was in second place, followed by two more East Germans, Tuchscherer and Winkler."] "\n\n" [:p {} "Wehling, normally considered a better cross-country skier than Miettinen, started three minutes behind the Finn and could easily control his rival in the 15 km cross-country event the day after. The surprise of the event was " [:a {:href "/athletes/86616"} "Urban Hettich"] ", a West German from Schwarzwald, who had been very satisfied with his 11th place in the jumping event. He skied excellently, posting the fastest time of the day, over a minute better than the second best, Norwegian " [:a {:href "/athletes/86302"} "Stein Erik Gullikstad"] ". Hettich advanced to the silver medal position, beating Winkler by a scant margin in the final classification. Miettinen could do no better than 19th place in the cross-country, dropping from second to fourth, barely beating Tuchscherer in fifth place. Gullikstad, placing 30th out of 33 in the jumping event, was far behind in the total points, but the third fastest in the cross-country race, while the Soviet Union’s " [:a {:href "/athletes/95723"} "Nikolay Nogovitsyn"] " advanced from 16th to sixth place. Wehling, still only 23, became the second skier to defend his Olympic gold in Nordic Combined after " [:a {:href "/athletes/86270"} "Johan Grøttumsbråten"] " did it in Lake Placid 44 years earlier."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Ski Jumping, Normal Hill"] [:th {} "Cross Country Skiing, 15 km"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/98862"} "