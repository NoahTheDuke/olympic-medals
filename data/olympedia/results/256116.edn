ticipants"] [:td {} [:a {:href "/events/256116"} "64 from 16 countries"]]]]] [:div {:class "description"} [:p {} "Germany was the reigning Olympic champion in the K-4 1000, as well as victors at two of the last three World Championships, and was favored to defend its title at the 1996 Games. Hungary, the defending Olympic runners-up and the Germans’ traditional rivals, had been third in 1993 and runner-up in 1995 at the Worlds, while Russia had taken a surprise title in 1994. Germany and Russia met in the first opening heat, which the former won with ease, while Hungary posted the round’s fastest time in the other. Germany then went on to win the final in Olympic record time, leaving silver to the Hungarians and bronze to the Russians."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "R1"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "Germany"] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "3:07.908 (1 h1)"] [:td {} "–"] [:td {} "2:51.528 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "11"} [:a {:href "/athletes/9925"} "Detlef Hofmann"] " • " [:a {:href "/athletes/9999"} "Olaf Winter"] " • " [:a {:href "/athletes/9966"} "Thomas Reineck"] " • " [:a {:href "/athletes/10002"} "Mark Zabel"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} "Hungary"] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"]] [:td {} "3:07.517 (1 h2)"] [:td {} "–"] [:td {} "2:53.184 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [