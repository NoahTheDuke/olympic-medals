nts/1023"} "38 from 17 countries"]]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/1015"} "7:38.4"] " / " [:a {:href "/athletes/87553"} "Knut Johannesen"] " " [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"] " /  5 February 1964 / " [:a {:href "/records/event_name/533"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003217"} "Leif Hjallum"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/76243"} "Sven Låftman"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]]]]] [:div {:class "description"} [:p {} "Based on recent results, the favorite was Norway’s " [:a {:href "/athletes/92057"} "Fred Anton Maier"] ", who had recently won the distance and the all-around at the 1968 European Championship and in January had broken the world record in this event, posting 7:26.2. His biggest challenge was expected to come from " [:a {:href "/athletes/98618"} "Kees Verkerk"] ", who had won the distance and the all-around title at the 1966 and 1967 World Championships and the 1967 European Championship."] "\n\n" [:p {} "Verkerk was in the third pair, with no significant leading time to shoot at. He was ahead of world record pace throughout and finished in 7:23.2, surpassing Maier’s world record. Two pairs later Maier toed the line. He crept ahead of Verkerk’s pace at 1,800 m, and was three seconds clear at 3,800 metres. He then held on to finish in 7:22.4, re-taking the world record, which would secure for him the gold medal. In the 10th pair, the Netherlands’ " [:a {:href "/athletes/95908"} "Petrus Nottet"] " finished in 7:25.5, also under the previous world record, a mark that brought him the bronze medal."] "\n\n" [:p {} "Maier had been around internationally since 1960, but 1968 was his greatest year. A distance specialist, he set seven world records, won both the European and World Championships, and the 5 and 10K at both tournaments, and won this Olympic gold medal. One day after this race, Verkerk would win the gold medal in the 1,500."] "\n"] [:button {:id "button692211", :class "btn btn-default"} "Details"] [:script {} "$('#button692211').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "200 m"] [:th {:style "display: none", :class "split"} "600 m"] [:th {:style "display: none", :class "split"} "1000 m"] [:th {:style "display: none", :class "split"} "1400 m"] [:th {:style "display: none", :class "split"} "1800 m"] [:th {:style "display: none", :class "split"} "2200 m"] [:th {:style "display: none", :class "split"} "2600 m"] [:th {:style "display: none", :class "split"} "3000 m"] [:th {:style "display: none", :class "split"} "3400 m"] [:th {:style "display: none", :class "split"} "3800 m"] [:th {:style "display: none", :class "split"} "4200 m"] [:th {:style "display: none", :class "split"} "4600 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "5I"] [:td {} [:a {:href "/athletes/92057"} "Fred Anton Maier"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "7:22.4"] [:td {:class "split", :style "display: none"} "20"] [:td {:class "split", :style "display: none"} "54"] [:td {:class "spl