value "2006203"} "Team, Women"] "\n" [:option {:value "2006304"} "Doubles, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "46500"} "1988"] "\n" [:option {:value "47135"} "1992"] "\n" [:option {:value "47562"} "1996"] "\n" [:option {:value "48003"} "2000"] "\n" [:option {:value "48369"} "2004"] "\n" [:option {:value "262349"} "2008"] "\n" [:option {:value "328079"} "2012"] "\n" [:option {:value "395800"} "2016"] "\n" [:option {:value "19003870"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/625"} "Event type"]] [:h1 {:class "event_title"} "Singles, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "27 July –  4 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2165"} "Paris Expo Porte de Versailles, Paris, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2005950"} "67 from 46 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament"]]]] [:div {:class "description"} [:p {} "For the singles, each nation was allowed to register two athletes from the respective team competition. An additional 22 qualified through continental qualifying tournaments. There was also the possibility of qualifying in an international qualification tournament. Also, the best placed athlete in the ITTF world rankings who had not yet qualified received a quota place."] "\n\n" [:p {} "Defending Olympic champion, China’s " [:a {:href "/athletes/121929"} "Ma Long"] ", was only nominated for the team event, and therefore the main favorites for the singles were the world No.1 " [:a {:href "/athletes/2502769"} "Wang Chuqin"] ", and the reigning world champion and runner-up from the previous Olympics, " [:a {:href "/athletes/1800098"} "Fan Zhendong"] ", also of China (ranked No.4 in the world)."] "\n\n" [:p {} "Surprisingly, Wang lost to world No.26, Sweden’s " [:a {:href "/athletes/2504051"} "Truls Möregårdh"] ", in the Round of 32, who at the end of the competition finished in second place to end Sweden’s 24-year medal drought. The bronze medal went to the 18-year-old French shooting star " [:a {:href "/athletes/155128"} "Félix Lebrun"] ", who became the youngest-ever singles medalist in Olympic table tennis history. Since 1992, it was only the second time that two European athletes finished in a medal position, when three of the medalists, like Paris 2024, were also from Sweden, France, and China."] "\n\n" [:p {} "All three individual medalists in Paris won the exact same medals in the team event. The 43-year-old German " [:a {:href "/athletes/93972"} "Timo Boll"] " joined " [:a {:href "/athletes/2632"} "Jörgen Persson"] ", " [:a {:href "/athletes/2344"} "Zoran Primorac"] ", " [:a {:href "/athletes/1027"} "Segun Toriola"] ", and " [:a {:href "/athletes/682"} "Jean-Michel Saive"] " by participating in his record seventh Olympics."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/1800098"} "Fan Zhendong"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/2504051"} "Truls Möregårdh"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedi