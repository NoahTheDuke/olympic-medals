lue "15000901"} "1,000 metres, Men"] "\n" [:option {:value "15000922"} "1,500 metres, Men"] "\n" [:option {:value "15000937"} "5,000 metres Relay, Men"] "\n" [:option {:value "15000944"} "500 metres, Women"] "\n" [:option {:value "15000986"} "1,500 metres, Women"] "\n" [:option {:value "15001001"} "3,000 metres Relay, Women"] "\n" [:option {:value "15001008"} "2,000 metres Mixed Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "905373"} "1988"] "\n" [:option {:value "601"} "1994"] "\n" [:option {:value "693"} "1998"] "\n" [:option {:value "799"} "2002"] "\n" [:option {:value "916"} "2006"] "\n" [:option {:value "923740"} "2010"] "\n" [:option {:value "350771"} "2014"] "\n" [:option {:value "9001185"} "2018"] "\n" [:option {:value "19020545"} "2022"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/548"} "Event type"]] [:h1 {:class "event_title"} "1,000 metres, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "14 – 16 February 2026"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2193"} "Forum di Milano, Assago, Milano, Milano"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/15000965"} "32 from 14 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Placements 1-8 based on A and B final.  Deeper placements based on placements in earlier rounds, and best time skated."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/19020545"} "1:26.514"] " " [:span {:class "label label-primary"} "WR"] " / " [:a {:href "/athletes/137698"} "Suzanne Schulting"] " " [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"] " / 11 February 2022 / " [:a {:href "/records/event_name/548"} "Details"]]]]] [:div {:class "description"} [:p {} "Two-time champion " [:a {:href "/athletes/137698"} "Suzanne Schulting"] " had mostly focused on long track speed skating since the Beijing Olympics, and had in fact raced the 1,000 m in that sport in Milano. In her absence, there was a wide field of favourites: " [:a {:href "/athletes/147886"} "Hanne Desmet"] " (2025), " [:a {:href "/athletes/149168"} "Kristen Santos-Griswold"] " (2024), " [:a {:href "/athletes/148679"} "Xandra Velzeboer"] " (2023) and " [:a {:href "/athletes/137639"} "Choi Min-Jeong"] " (2022) had divided the World titles since Beijing. Canada’s " [:a {:href "/athletes/148015"} "Courtney Sarault"] " had been most successful in the 2025/26 season, winning three of the four World Tour races, the fourth won being won by Desmet."] "\n\n" [:p {} "All favourites survived the heats, but Santos-Griswold was eliminated in her quarter-final, finishing narrowly behind Velzeboer and " [:a {:href "/athletes/156835"} "Kim Gil-Ri"] ". In the first semi-final, Desmet eliminated herself from contention with a failed overtake attempt on Kim, who fell but was advanced into the final. All three of the 500 m medalists – Velzeboer, " [:a {:href "/athletes/109931"} "Arianna Fontana"] " and Sarault – again made it into the final, with Kim being added and a surprising " [:a {:href "/athletes/2301312"} "Gong Li"] " also making it."] "\n\n" [:p {} "Sarault led the pack in the final. As Kim tried to make a move on Velzeboer, the Dutchwomen passed Sarault on the inside to take the lead. Kim then made a great move to pass both Sarault and Velzeboer in a single turn, but going slightly wide Velzeboer immediately grabbed the lead back, Sarault following one turn later. The final lap saw no further changes, giving Velzeboer the win."] "\n\n" [:p {} "For Velzeboer it was her second gold medal of the Games, after the 500 m, while for Sarault it was her third medal of Milano, having medalled in the mixed relay and 500 m. It was the third gold medal in a row for the Netherlands, and the third time the same skater won both the 500 m and 1,000 m, after " [:a {:href "/athletes/100218"} "Yang Yang (A)"] " in 2002 and " [:a {:href "/athletes/109921"} "Wang Meng"] " in 2010."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Helmet Nr"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Final Round Placement"] [:th {} "Semi-Final Placement"] [:th {} "Quarter-Final Placement"] [:th {} "Round One Placement"] [:th {} "Best Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "2"] [:td {} [:a {:href "/athletes/148679"} "Xandra Velzeboer"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "1"] [:td {} "1"] [:td {} "1"] [:td {} "1"] [:td {} "1:27.816"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "14"] [:td {} [:a {:href "/athletes/148015"} "Courtney Sarault"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {} "2"] [:td {} "1"] [:td {} "1"] [:td {} "1"] [:td {} "1:28.097"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "6"] [:td {} [:a {:href "/athletes/156835"} "Kim Gil-Ri"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] 