, Men"] "\n" [:option {:value "19020403"} "5,000 metres, Men"] "\n" [:option {:value "19020404"} "10,000 metres, Men"] "\n" [:option {:value "19020405"} "Mass Start, Men"] "\n" [:option {:value "19020410"} "Team Pursuit (8 laps), Men"] "\n" [:option {:value "19020424"} "500 metres, Women"] "\n" [:option {:value "19020425"} "1,000 metres, Women"] "\n" [:option {:value "19020426"} "1,500 metres, Women"] "\n" [:option {:value "19020427"} "3,000 metres, Women"] "\n" [:option {:value "19020428"} "5,000 metres, Women"] "\n" [:option {:value "19020429"} "Mass Start, Women"] "\n" [:option {:value "19020434"} "Team Pursuit (6 laps), Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1038"} "1976"] "\n" [:option {:value "1047"} "1980"] "\n" [:option {:value "1056"} "1984"] "\n" [:option {:value "1065"} "1988"] "\n" [:option {:value "1075"} "1992"] "\n" [:option {:value "1085"} "1994"] "\n" [:option {:value "1097"} "1998"] "\n" [:option {:value "1111"} "2002"] "\n" [:option {:value "1125"} "2006"] "\n" [:option {:value "924503"} "2010"] "\n" [:option {:value "350647"} "2014"] "\n" [:option {:value "9001028"} "2018"] "\n" [:option {:value "15001101"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/531"} "Event type"]] [:h1 {:class "event_title"} "1,000 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "18 February 2022 — 16:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2140"} "National Speed Skating Oval, Olympic Green, Beijing"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19020401"} "30 from 16 countries"]]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/1111"} "1:07.18"] " " [:span {:class "label label-primary"} "WR"] " / " [:a {:href "/athletes/98555"} "Gerard van Velde"] " " [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"] " / 16 February 2002 / " [:a {:href "/records/event_name/531"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/1805307"} "Hanjo Heideman"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/1805308"} "Roland Steenbeck"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]]]]] [:div {:class "description"} [:p {} "It was assumed that the Dutch would dominate this event. At the three World Cups where they had raced, the Dutch had swept the podium, with " [:a {:href "/athletes/148675"} "Thomas Krol"] " capturing two wins, and " [:a {:href "/athletes/148676"} "Hein Otterspeer"] " one. A third Dutchman, " [:a {:href "/athletes/137697"} "Kai Verbij"] ", was the 2019 and 2021 World Champion. The fourth, " [:a {:href "/athletes/137695"} "Kjeld Nuis"] ", was defending champion but had failed at the Dutch Olympic Trials and did not qualify."] "\n\n" [:p {} "The race was held under somewhat tougher ice conditions than the previous races, leading to less impressive times. The first to break the 1:09-barrier was " [:a {:href "/athletes/137930"} "Piotr Michalski"] ", who set 1:08.56 in the fourth pair. His time would remain unbeaten for a long time. Outsiders for a medal such as the two-time World Champion and world record holder " [:a {:href "/athletes/148864"} "Pavel Kulizhnikov"] " or up-and-coming 17-year-old talent " [:a {:href "/athletes/140168"} "Jordan Stolz"] " couldn’t break the Pole’s time. " [:a {:href "/athletes/148370"} "Cornelius Kersten"] " was the first to come close, recording 1:08.79, which would be the ninth fastest time of the day and the best British speed skating result in 58 years. " [:a {:href "/athletes/137092"} "Marten Liiv"] ", " [:a {:href "/athletes/147903"} "Ignat Golovatsiuk"] " and " [:a {:href "/athletes/148866"} "Viktor Mushtakov"] " all hit the 1:08, but with six skaters to go, it was still Michalski in the lead."] "\n\n" [:p {} "The 13th pair saw 1,500 m silver medalist Krol against 2018 silver medalist " [:a {:href "/athletes/128235"} "Håvard Holmefjord Lorentzen"] ". The favored Dutchman started on a conservative speed, trailing Michalski’s time at the bell, with the Norwegian close pursuit. With the best final lap of the day, Krol raced to 1:07.92, with Lorentzen half a second behind, both beating the leading time. Race 14 had Otterspeer against the local favorite, " [:a {:href "/athletes/148129"} "Ning Zhongyan"] ". Both were still on Krol’s pace at 600 m but faded in the last lap and fell out of medal contention. That left only the final pair. Reigning world champion Verbij saw Canadian " [:a {:href "/athletes/136925"} "Laurent Dubreuil"] " take off at world record pace. At 600 m, the two-time world bronze medalist was so far ahead that at the final crossing, Verbij had to give way, choosing to stand up and glide out the race rather than hindering the Canadian and risking disqualification."] "\n\n" [:p {} "Dubreuil held sufficient speed to finish in 1:08.32, enough for silver, a great relief after missing the podium in the 500 m. With both his father " [:a {:href "/athletes/85312"} "Robert Dubreuil"] " and his mother " [:a {:href "/athletes/81704"} "Ariane Loignon"] " former Olympic speed skaters, he became the first Olympic speed skating medalist with two Olympian parents."] "\n"] [:button {:id "button173261", :class "btn btn-default"} "Details"] [:script {} "$('#button173261').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "200 m"] [:th {:style "display: none", :class "split"} "600 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "13I"] [:td {} [:a {:href "/athletes/148675"} "Thomas Krol"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "1:07.92"] [:td {:class "split", :style "display: none"} "16.60"] [:td {:class "split", :style "display: none"} "41.55"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "15I"] [:td {} [:a {:href "/athletes/136925"} "Laurent Dubreuil"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {} "1:08.32"] [:td {:class "split", :style "display: none"} "16.09"] [:td {:class "split", :style "display: none"} "40.82"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "13O"] [:td {} [:a {:href "/athletes/128235"} "Håvard Lorentzen"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "1:08.48"] [:td {:class "split", :style "display: none"} "16.80"] [:td {:class "split", :style "display: none"} "41.70"] [:td {} [:span {:class "Bronze"} "Bronze"]