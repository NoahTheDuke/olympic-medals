0023"} "12.5 kilometres Pursuit, Men"] "\n" [:option {:value "350024"} "15 kilometres Mass Start, Men"] "\n" [:option {:value "350025"} "20 kilometres, Men"] "\n" [:option {:value "350026"} "4 × 7.5 kilometres Relay, Men"] "\n" [:option {:value "350028"} "10 kilometres Pursuit, Women"] "\n" [:option {:value "350029"} "12.5 kilometres Mass Start, Women"] "\n" [:option {:value "350030"} "15 kilometres, Women"] "\n" [:option {:value "350031"} "4 × 6 kilometres Relay, Women"] "\n" [:option {:value "350032"} "2 × 6 kilometres and 2 × 7.5 kilometres Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1556"} "1992"] "\n" [:option {:value "1567"} "1994"] "\n" [:option {:value "1579"} "1998"] "\n" [:option {:value "1592"} "2002"] "\n" [:option {:value "1607"} "2006"] "\n" [:option {:value "923490"} "2010"] "\n" [:option {:value "9000225"} "2018"] "\n" [:option {:value "19019635"} "2022"] "\n" [:option {:value "15000035"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/133"} "Event type"]] [:h1 {:class "event_title"} "7.5 kilometres Sprint, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 9 February 2014 — 18:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/889"} "Kompleks Dlya Sorevnovaniy Po Lyzhnym Gonkam i Biatlonu Laura, Mountain Cluster, Krasnaya Polyana"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/350027"} "84 from 33 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Penalty loop (150 metres) skied for each missed target."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 7,741 m" [:br {}] "Height Differential: 31 m" [:br {}] "Maximum Climb: 31 m" [:br {}] "Shooting 1: Prone at 2.574 km, 50 m range" [:br {}] "Shooting 2: Standing at 5.107 km, 50 m range" [:br {}] "Total Climbing: 258 m"]]]] [:div {:class "description"} [:p {} "Former Russian (now Slovakian) " [:a {:href "/athletes/118501"} "Anastasia Kuzmina"] " repeated as gold medalist in a surprising biathlon sprint, as the favorites fell short, with pre-race contender " [:a {:href "/athletes/128304"} "Olga Vilukhina"] " placing second for Russia. Several of the early favorites missed on the easier prone stage, as " [:a {:href "/athletes/110008"} "Tora Berger"] " missed one shot, " [:a {:href "/athletes/118516"} "Darya Domracheva"] " missed one shot, and " [:a {:href "/athletes/118522"} "Gabriela Soukalová"] " even missed three. Domracheva and Berger were in the top three among the early skiers but were bumped down in the later stages. Kuzmina was the defending champion and shot cleanly to repeat. Vilukhina, who shot cleanly, clawed her way up the standings late in the race to earn her silver, the home Russian crowd roaring as she came in second. Ukraine’s " [:a {:href "/athletes/118600"} "Vita Semerenko"] " finished strongly to win the bronze medal, only 1.8 seconds behind Semerenko."] "\n\n" [:p {} "That was how the results stood until the Oswald Commission and the release of the McLaren Report in December 2016. Three Russian skiiers were disqualified retroactively for doping - " [:a {:href "/athletes/"} "Yana Romanova"] ", " [:a {:href "/athletes/"} "Olga Zaytseva"] ", and " [:a {:href "/athletes/"} "Olga Vilukhina"] ", with Vilukhina losing her silver medal. As of April 2019, it had not been re-allocated. However, in February 2020, Vilukhina was reinstated after an appeal to CAS and her silver medal was restored."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {