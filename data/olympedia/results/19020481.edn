"19020502"} "1,500 metres, Men"] "\n" [:option {:value "19020517"} "5,000 metres Relay, Men"] "\n" [:option {:value "19020524"} "500 metres, Women"] "\n" [:option {:value "19020545"} "1,000 metres, Women"] "\n" [:option {:value "19020566"} "1,500 metres, Women"] "\n" [:option {:value "19020581"} "3,000 metres Relay, Women"] "\n" [:option {:value "19020588"} "2,000 metres Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "905307"} "1988"] "\n" [:option {:value "481"} "1992"] "\n" [:option {:value "555"} "1994"] "\n" [:option {:value "647"} "1998"] "\n" [:option {:value "739"} "2002"] "\n" [:option {:value "857"} "2006"] "\n" [:option {:value "923676"} "2010"] "\n" [:option {:value "350707"} "2014"] "\n" [:option {:value "9001121"} "2018"] "\n" [:option {:value "15000901"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/544"} "Event type"]] [:h1 {:class "event_title"} "1,000 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "5 –  7 February 2022"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/845"} "Shoudu Tiyguan, Beijing"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19020481"} "32 from 17 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Placements 1-8 based on final and B final.  Deeper placements based on placements in earlier rounds, and best time skated."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/9001121"} "1:23.407"] " / " [:a {:href "/athletes/109918"} "Charles Hamelin"] " " [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"] " / 13 February 2018 / " [:a {:href "/records/event_name/544"} "Details"]]]]] [:div {:class "description"} [:p {} "Many former champions in the event did not compete in Beijng. Defending champion " [:a {:href "/athletes/136931"} "Samuel Girard"] " had retired in 2019. His compatriot, 2018 World Champion " [:a {:href "/athletes/109918"} "Charles Hamelin"] " was in Beijing, but was not selected for the 1,000 m. The 2019 champion, " [:a {:href "/athletes/137647"} "Im Hyo-Jun"] " had been suspended by the Korean federation over a sexual harassment conviction (which was later overturned), and while he had joined the Chinese team and was hoping to race as Lin Xiaojun, his nationality change was not submitted in time to compete for a different NOC than in 2018."] "\n\n" [:p {} "The 2021 World Champion, " [:a {:href "/athletes/127892"} "Shaolin Sándor Liu"] " was present, as was his brother and world runner-up, " [:a {:href "/athletes/137351"} "Shaoang Liu"] ". Other favorites included " [:a {:href "/athletes/137644"} "Hwang Dae-Heon"] " and " [:a {:href "/athletes/136984"} "Ren Ziwei"] ", who had both won World Cup races earlier in the season, as had Sándor."] "\n\n" [:p {} "Despite a flurry of disqualifications and advances in the heats and quarter-finals, most of the favorites reached the semi-finals. One casualty was Korea’s " [:a {:href "/athletes/148603"} "Park Jang-Hyuk"] ". In his quarter-final, he collided with " [:a {:href "/athletes/148510"} "Pietro Sighel"] ". While spinning on the ice, " [:a {:href "/athletes/127580"} "Wu Dajing"] " skated into his hand, causing a serious injury that required 12 stitches, leaving him unable to race the semi-finals (to which he as advanced)."] "\n\n" [:p {} "Hwang and Ren seemed to proceed from the first semi-finals, but Hwang was judged to have impeded " [:a {:href "/athletes/148133"} "Li Wenlong"] " in his move overtaking Ren and Li, and was relegated. The second semi-final also ended badly for the South Koreans. The Liu brothers dominated much of the race, but after " [:a {:href "/athletes/148602"} "Lee June-Seo"] " had overtaken Shaoang, he blocked the Hungarian’s attempt to comeback, and was also penalized."] "\n\n" [:p {} "This left the final a Chinese affair, with Ren, Li and Wu Dajing, as well as the Chinese-Hungarian Liu brothers. Wu was leading the race when it was halted, as a piece from of the skates of Li had broken off and damaged the ice. In the restarted race, Ren was the early leader, but was passed by Sándor Shaolin with four laps to go, at which point Wu and Shaoang had lost touch with the others. Liu only just held on until the finish line, crossing it falling and cheering. But after some agonizing minutes waiting for the referee to review the race, Liu was penalized for an overtaking infringement earlier in the race, giving Ren his second gold medal of the Games. As a minor consolation for Hungary, this moved Shaoang up to bronze."] "\n\n" [:p {} "Another notable competitor was " [:a {:href "/athletes/149045"} "Furkan Akar"] ". The 19-year-old Turkish skater made his country’s first Olympic appearance in short-track. Benefiting from disqualifications in his heat and quarter-final, he eventually reaced the B-final, recording a remarkable sixth place in the final standings, the best ever for a Turkish competitor in any sport at the Olympic Winter Games."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Helmet Nr"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Position Last Race"] [:th {} "Positions"] [:th {} "Best Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "54"] [:td {} [:a {:href "/athletes/136984"} "Ren Ziwei"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: mi