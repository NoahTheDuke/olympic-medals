ue "2012215"} "Team All-Around, Men"] "\n" [:option {:value "2012230"} "Floor Exercise, Men"] "\n" [:option {:value "2012233"} "Vault, Men"] "\n" [:option {:value "2012240"} "Parallel Bars, Men"] "\n" [:option {:value "2012246"} "Rings, Men"] "\n" [:option {:value "2012249"} "Pommelled Horse, Men"] "\n" [:option {:value "2012252"} "Individual All-Around, Women"] "\n" [:option {:value "2012263"} "Team All-Around, Women"] "\n" [:option {:value "2012274"} "Floor Exercise, Women"] "\n" [:option {:value "2012277"} "Vault, Women"] "\n" [:option {:value "2012284"} "Uneven Bars, Women"] "\n" [:option {:value "2012287"} "Balance Beam, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "9009278"} "1875"] "\n" [:option {:value "70005"} "1896"] "\n" [:option {:value "70029"} "1904"] "\n" [:option {:value "926065"} "1904"] "\n" [:option {:value "70069"} "1924"] "\n" [:option {:value "70085"} "1928"] "\n" [:option {:value "70107"} "1932"] "\n" [:option {:value "70124"} "1936"] "\n" [:option {:value "70146"} "1948"] "\n" [:option {:value "70168"} "1952"] "\n" [:option {:value "70193"} "1956"] "\n" [:option {:value "70224"} "1960"] "\n" [:option {:value "70268"} "1964"] "\n" [:option {:value "70312"} "1968"] "\n" [:option {:value "70367"} "1972"] "\n" [:option {:value "70425"} "1976"] "\n" [:option {:value "70483"} "1980"] "\n" [:option {:value "70541"} "1984"] "\n" [:option {:value "70599"} "1988"] "\n" [:option {:value "70657"} "1992"] "\n" [:option {:value "70715"} "1996"] "\n" [:option {:value "70788"} "2000"] "\n" [:option {:value "70872"} "2004"] "\n" [:option {:value "259973"} "2008"] "\n" [:option {:value "313030"} "2012"] "\n" [:option {:value "353649"} "2016"] "\n" [:option {:value "19009143"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/319"} "Event type"]] [:h1 {:class "event_title"} "Horizontal Bar, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "27 July –  5 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2166"} "Bercy Arena, Bercy, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2012243"} "67 from 29 countries"]]]]] [:div {:class "description"} [:p {} "At Tokyo 2020, " [:a {:href "/athletes/144639"} "Daiki Hashimoto"] " had claimed gold on the horizontal bar for Japan. He had also been the top performer in the interim, winning the 2023 World Championships and finishing second in 2021 and 2022. The title in these years had been won by Hu Xuwei (the Chinese wouldn’t come to Paris) and " [:a {:href "/athletes/147423"} "Brody Malone"] " (USA). Other contenders included the Tokyo silver medalist " [:a {:href "/athletes/141997"} "Tin Srbić"] ", World Champion in 2017, with silver in 2019 and 2023, and " [:a {:href "/athletes/155807"} "Su Weide"] ", who took World bronze in 2023."] "\n\n" [:p {} "Hashimoto’s exercise in qualifying showed his typical aerial moves, but his landing failed completely, and he had to touch the floor with both hands, severely reducing his execution score to just 13.733, too low for a spot in the final. Malone had an even worse showing, missing the bar on one release, and stalling on another, and fell to 59th place. Su and Srbić did make the cut, as the leading score went to " [:a {:href "/athletes/152584"} "Zhang Boheng"] ", silver medalist in the all-around."] "\n\n" [:p {} "The final was filled with errors. Zhang, Su and " [:a {:href "/athletes/133406"} "Marios Georgiou"] " all had problems landing, while Srbić and " [:a {:href "/athletes/152666"} "Takaaki Sugino"] " fell from the bar during their exercise. The remaining three gymnasts all reached the podium. All-around champion " [:a {:href "/athletes/152665"} "Shinnosuke Oka"] " had the lowest planned difficulty of the field, but his 14.533 proved enough for gold. " [:a {:href "/athletes/152586"} "Ángel Barajas"] " of Colombia matched the score but ranked second on account of his lower execution score. Chinese Taipei’s " [:a {:href "/athletes/146858"} "Tang Chia-Hung"] " held on for bronze with 13.966, tying with Zhang who had the exact same score."] "\n\n" [:p {} "Barajas’ silver medal was the first ever gymnastics medal for Colombia, which made it only the second South American nation (after Brazil) to win an Olympic medal in the sport. For Oka, it was his third gold (after the team and individual all-around), making him (with an additional bronze) the top male gymnast at the Paris Games."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/152665"} "Shinnosuke Oka"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/152586"} "Ángel Barajas"]] [:td {} [:a {:href "/countries/COL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/COL.png"}] "COL"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/152584"} "Zhang Boheng"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} [:span {:class "Bronze"} "Bronze"