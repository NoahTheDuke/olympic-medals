0 kilometres, Men"] "\n" [:option {:value "2001"} "4 × 10 kilometres Relay, Men"] "\n" [:option {:value "2005"} "5 kilometres, Women"] "\n" [:option {:value "2006"} "10 kilometres, Women"] "\n" [:option {:value "2007"} "20 kilometres, Women"] "\n" [:option {:value "2008"} "4 × 5 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1914"} "1956"] "\n" [:option {:value "1925"} "1960"] "\n" [:option {:value "1936"} "1964"] "\n" [:option {:value "1948"} "1968"] "\n" [:option {:value "1960"} "1972"] "\n" [:option {:value "1972"} "1976"] "\n" [:option {:value "1985"} "1980"] "\n" [:option {:value "2012"} "1988"] "\n" [:option {:value "2086"} "2002"] "\n" [:option {:value "2130"} "2006"] "\n" [:option {:value "923550"} "2010"] "\n" [:option {:value "350066"} "2014"] "\n" [:option {:value "9000277"} "2018"] "\n" [:option {:value "19019712"} "2022"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/184"} "Event type"]] [:h1 {:class "event_title"} "15 kilometres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "13 February 1984 — 8:45"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/124"} "Veliko Polje, Igman"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1998"} "91 from 31 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: ?" [:br {}] "Height Differential: 120 m" [:br {}] "Intermediate 1: 5.0 km" [:br {}] "Intermediate 2: 10.0 km" [:br {}] "Maximum Climb: 36 m" [:br {}] "Total Climbing: 562 m"]]]] [:div {:class "description"} [:p {} "Defending champion " [:a {:href "/athletes/98835"} "Thomas Wassberg"] " chose to save himself for the 50 km race and did not participate. His great rival from the 1980 games, " [:a {:href "/athletes/95428"} "Juha Mieto"] ", who lost to Wassberg in 1980 by the closest possible margin, one one hundredth of a second, was present. The Finnish veteran, now 34, was still hoping for an Olympic gold medal. Another Finn, " [:a {:href "/athletes/87989"} "Harri Kirvesniemi"] ", was in the lead after 5.8 km, six seconds ahead of the new 22-year-old Swedish cross-country star " [:a {:href "/athletes/98002"} "Gunde Svan"] ". The Finns were doing well, " [:a {:href "/athletes/87811"} "Aki Karvonen"] " in third position, only two seconds behind Svan, and Mieto followed in fourth place, ahead of the 30 km winner " [:a {:href "/athletes/99245"} "Nikolay Zimyatov"] ". At the next intermediate checkpoint, Svan had taken over the lead, but it was very close. Kirvesniemi was in second and Karvonen in third place, only five and seven seconds behind the leader. Mieto was still fourth, 20 seconds behind. Zimyatov had slowed down to eighth, 50 seconds behind the young Swedish leader. In the final stages of the race Svan skied brilliantly, maintaining the Swedish tradition and secured his country’s sixth Olympic gold medal at the distance. Karvonen finished stronger than Kirvesniemi and was rewarded with the silver medal, Mieto once again missed the podium in fourth place. The Norwegian " [:a {:href "/athletes/83751"} "Ove Aunli"] " finished with the fifth best time, but was disqualified for using skating strokes over the last 200 m."] "\n\n" [:p {} "In 1984, Gunde Svan was at the dawn of a great career which would last for seven more seasons. He remains, thru 2009, the youngest male Olympic cross-country champion of all time, being 22 years, 1 month and 1 day old when he won the 1984 15 km race. Closest to him is " [:a {:href "/athletes/83560"} "Thomas  Alsgaard"] " from Norway, who won the 1994 30 km race when he was 22 years, 1 month and 4 days old."] "\n"] [:button {:id "button849758", :class "btn btn-default"} "Details"] [:script {} "$('#button849758').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "Intermediate 1"] [:th {:style "display: none", :class "split"} "Intermediate 2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "73"] [:td {} [:a {:href "/athletes/98002"} "Gunde Svan"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "41:25.6"] [:td {:class "split", :style "display: none"} "17:54.7 (2)"] [:td {:class "split", :style "display: none"} "29:55.3 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "63"] [:td {} [:a {:href "/athletes/87811"} "Aki Karvonen"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]] [:td {} "41:34.9"] [:td {:class "split", :style "display: none"} "17:56.7 (3)"] [:td {:class "split", :style "display: none"} "30:02.2 (3)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "37"] [:td {} [:a {:href "/athletes/87989"} "Harri Kirvesniemi"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]] [:td {} "41:45.6"] [:td {:class "split", :style "display: none"} "17:48.7 (1)"] [:td {:class "split", :style "display: none"} "30:00.8 (2)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style "