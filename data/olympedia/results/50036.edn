value "50000"} "1912"] "\n" [:option {:value "50009"} "1920"] "\n" [:option {:value "50018"} "1924"] "\n" [:option {:value "50027"} "1928"] "\n" [:option {:value "50045"} "1936"] "\n" [:option {:value "50054"} "1948"] "\n" [:option {:value "50063"} "1952"] "\n" [:option {:value "50081"} "1956"] "\n" [:option {:value "50099"} "1960"] "\n" [:option {:value "50117"} "1964"] "\n" [:option {:value "50135"} "1968"] "\n" [:option {:value "50153"} "1972"] "\n" [:option {:value "50171"} "1976"] "\n" [:option {:value "50189"} "1980"] "\n" [:option {:value "50207"} "1984"] "\n" [:option {:value "50225"} "1988"] "\n" [:option {:value "50243"} "1992"] "\n" [:option {:value "50261"} "1996"] "\n" [:option {:value "50270"} "2000"] "\n" [:option {:value "50288"} "2004"] "\n" [:option {:value "260915"} "2008"] "\n" [:option {:value "317000"} "2012"] "\n" [:option {:value "351850"} "2016"] "\n" [:option {:value "19002500"} "2020"] "\n" [:option {:value "2003825"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/361"} "Event type"]] [:h1 {:class "event_title"} "Individual, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "2 –  6 August 1932"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/306"} "Riviera Country Club, Pacific Palisades, California"] " / " [:a {:href "/venues/307"} "State Armory of the 160th Infantry, Olympic Park, Los Angeles, California"] " / " [:a {:href "/venues/308"} "Los Angeles Police Pistol Range, Elysian Park, Los Angeles, California"] " / " [:a {:href "/venues/305"} "Olympic Park Swimming Stadium, Los Angeles, California"] " / " [:a {:href "/venues/309"} "Sunset Fields Golf Club, Los Angeles, California"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/50036"} "25 from 10 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Point-for-place scoring."]]]] [:div {:class "description"} [:p {} "Still with no real way to choose favorites because of the lack of international competition or an International Federation, the " [:a {:href "/results/50018"} "1924"] " and " [:a {:href "/results/50027"} "1928"] " Swedish gold medalists were back – " [:a {:href "/athletes/35073"} "Bo Lindman"] " (1924) and " [:a {:href "/athletes/23459"} "Sven Thofelt"] " (1928). Sweden had won all the medals in this event since " [:a {:href "/results/50000"} "1912"] ", except for the bronze won in 1928 by Germany’s " [:a {:href "/athletes/34820"} "Helmut Kahl"] ", so they were expected to be strong. Lindman had lost the 1928 gold medal because of poor performances in shooting and fencing, placing only 15th with the pistol and 22nd with the sword."] "\n\n" [:p {} "In 1932, Bo Lindman started strongly by winning the horse steeplechase and placing equal second with the sword. After two phases, he narrowly led America’s " [:a {:href "/athletes/35159"} "Richard Mayo"] ". But shooting was again a problem for Lindman, as he placed 19th with the pistol. Mayo, who was a lieutenant in the Field Artillery Regiment at Fort Sill, Oklahoma, won that event with 197 points, to take a big lead after three phases – 7½ points over " [:a {:href "/athletes/34904"} "Carlo Simonetti"] " of Italy in second at 17, Sweden’s " [:a {:href "/athletes/35079"} "Johan Oxenstierna"] " in third with 20, and Lindman now fourth. However, Mayo struggled in the final two sports, placing 14th in the swim and 17th in the cross-country run. He would hang on for a bronze medal, the first ever in modern pentathlon for the USA. The gold went to Oxenstierna, who placed fifth in the swim and seventh running. He was the first Naval officer to win the modern pentathlon. Mayo still led after swimming, but Oxenstierna and Lindman passed him with their run placements."] "\n\n" [:p {} "Lindman’s silver medal was his third in modern pentathlon, following gold in 1924 and silver in 1928. Sven Thofelt placed fourth, hampered by his riding score, in which his horse fell three times. The seventh-place finisher, " [:a {:href "/athletes/71280"} "Elemér Somfay"] " (HUN), had competed in track &amp; field athletics at the 1924 Olympics in the " [:a {:href "/results/57571"} "pentathlon"] " and " [:a {:href "/results/57515"} "decathlon"] ", winning a silver medal in pentathlon. Somfay fell in the riding, which cost him a better placing. Portugal’s " [:a {:href "/athletes/35002"} "Sebastião Herédia"] " was hampered by a very poor score in the opening phase, riding. His horse, " [:em {} "Dan Anthony"] ", went out of control and bolted from the course, running for over three miles before handlers could get him under control. Herédia was given another attempt on " [:em {} "Dan Anthony"] ", but the horse again bolted and ran away from the course."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Ordinals"] [:th {} "Riding"] [:th {} "Fencing"] [:th {} "Shooting"] [:th {} "Swimming"] [:th {} "Running"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/35079"} "Johan, Greve Oxenstierna"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "32.0"] [:td {} "100 (4)"] [:td {} "21 (14)"] [:td {} "20 (2)"] [:td {} "4:52.8 (5)"] [:td {} "16:25.6 (7)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/35073"} "Bo Lindman"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "35.5"] [:td {} "100 (1)"] [:td {} "32 (=2)"] [:td {} "19 (19)"] [:td {} "5:05.1 (9)"] [:td {} "16:05.2 (4)"] [:td {} 