yle ""} [:th {} "Judge #1"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003166"} "Lasse Tuure Johansson"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #2"] [:td {:style "width: 400px"} [:a {:href "/athletes/5001858"} "Erik Lundberg"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #3"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003341"} "Mikhail Khimichev"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #4"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004037"} "Pietro Pertile"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #5"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002628"} "J. Borgula"]] [:td {} [:a {:href "/countries/POL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/POL.png"}] "POL"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "K-Point: 70 m"]]]] [:div {:class "description"} [:p {} "A record number of 58 ski jumpers from 17 countries were entered for the Olympic ski jumping competitions in 1968. The Norwegian " [:a {:href "/athletes/98998"} "Bjørn Wirkola"] " had won both ski jumping competitions at the World Championships in Oslo 1966 and had dominated the international scene in the following years, winning at Holmenkollen in 1966 and 1967 and the 1967 and 1968 Four Hills Tournament."] "\n\n" [:p {} "In the Normal Hill competition, the young Soviet jumper " [:a {:href "/athletes/99108"} "Anatoly Zheglanov"] " took an early lead with an excellent jump of 79.5 m. The Austrian " [:a {:href "/athletes/96574"} "Baldur Preiml"] ", starting 28th, produced the longest jump of the day with 80.0 m and was still in the lead until one of the last starters, Czechoslovakian " [:a {:href "/athletes/96722"} "Jiří Raška"] " jumped 79.0 m with superb style and bettered Preindl’s total points. The 21-year old Finn " [:a {:href "/athletes/95250"} "Topi Mattila"] " was lying third after the first round, beating Zheglanov’s point score with a 78.0 m jump. Wirkola was a disappointing sixth."] "\n\n" [:p {} "In the second round the jumps were considerably shorter. Austrian " [:a {:href "/athletes/83779"} "Reinhold Bachler"] " produced the longest jump of the round with 76.0 m and advanced from eighth to the silver medal position. Raška had a more mediocre jump of 72.5 m but claimed the first ever gold medal in ski jumping for Czechoslovakia. Preindl was able to hold off Wirkola in the battle for the bronze medal. Defending Champion " [:a {:href "/athletes/87767"} "Veikko Kankkonen"] " was a distant 17th, seemingly totally out of form."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Jump #1"] [:th {} "Jump #2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/96722"} "Jiří Raška"]] [:td {} [:a {:href "/countries/TCH"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/TCH.png"}] "TCH"]] [:td {} "216.5"] [:td {} "115.2 (1)"] [:td {} "101.3 (=8)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/83779"} "Reinhold