/athletes/97475"} "Jack Shea"] " " [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"] " /  4 February 1932 / " [:a {:href "/records/event_name/530"} "Details"] [:br {}] [:a {:href "/results/961"} "43.4"] " / " [:a {:href "/athletes/85582"} "Bernt Evensen"] " " [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"] " / 13 February 1928 / " [:a {:href "/records/event_name/530"} "Details"] [:br {}] [:a {:href "/results/961"} "43.4"] " / " [:a {:href "/athletes/98260"} "Clas Thunberg"] " " [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"] " / 13 February 1928 / " [:a {:href "/records/event_name/530"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002409"} "Hans Valär"]] [:td {} [:a {:href "/countries/SUI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SUI.png"}] "SUI"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/96042"} "Oskar Olsen"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/1202443"} "Gerrit van Laer"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002161"} "Gerhard Karlsen"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]]]]] [:div {:class "description"} [:p {} "After the cancelled " [:a {:href "/results/964"} "10,000 m in 1928"] " and the disputed pack style rules in " [:a {:href "/editions/31/sports/SSK"} "1932"] ", the 500 m in Garmisch also saw controversy. The event was surprisingly won by Norway’s " [:a {:href "/athletes/83820"} "Ivar Ballangrud"] ". Ballangrud was hardly a rookie: he was already a triple Olympic medalist by that time, and was the World Champion of 1926 and 1932, and European Champion of 1929, 1930, and 1933. He had dominated the 1936 season, winning the European and World title in the month prior to the Games. However, Ballangrud was not considered a top sprinter, and even his selection for the Norwegian team on this distance was somewhat contentious. But the controversy lay in the fact that he beat " [:a {:href "/athletes/88648"} "Georg Krog"] ", Norway’s top sprinter. While the result of the official timekeepers all agree on the times of both skaters, various (Norwegian) journalists have different accounts. It was quite common in these days for the media to keep their own stopwatches, and check on the times. Some claim Krog’s time, officially 43.5, should have been four tenths faster - owing the difference to an ambiguous call by the timekeepers to the referee. Others claim Ballangrud’s time was simply one second too fast, and should have been 44.4 seconds. Norwegian radio reporter Finn Amundsen even re-timed Ballangrud’s race from the start and finish signals on his own audiotape, and clocked 44.4, like he had during the actual race. In spite of all this, no official protest appears to have been lodged, and the result stands as listed below."] "\n\n" [:p {} "Behind the two Norwegians, several favorites competed for third. Norway’s two other contenders, " [:a {:href "/athletes/86457"} "Harry Haraldsen"] " and " [:a {:href "/athletes/85518"} "Hans Engnestangen"] ", both fell. All four United States skaters were medal potentials, despite the absence of defending Olympic Champion " [:a {:href "/athletes/97475"} "Jack Shea"] ". He was not too fond of travelling to Nazi Germany, and could not afford to stay away from his family that long. " [:a {:href "/athletes/96552"} "Allan Potts"] " had lowered the World Record to 42.4 the month before the Games, but he could do no better than 6th at the Olympics. " [:a {:href "/athletes/89376"} "Del Lamb"] ", winner of the sprint at the World Championships, placed 5th, which left " [:a {:href "/athletes/85843"} "Leo Freisinger"] ", who won the bronze medal. He narrowly edged out " [:a {:href "/athletes/87370"} "Shozo Ishihara"] ", who came within a tenth of Japan’s first Olympic speed skating medal."] "\n"] [:button {:id "button390945", :class "btn btn-default"} "Details"] [:script {} "$('#button390945').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "6"] [:td {} [:a {:href "/athletes/83820"} "Ivar Ballangrud"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "43.4"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record (equalled)"} "=OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/88648"} "Georg Krog"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "43.5"] [:td {} [:span {:class "Sil