anta final, with Khadem Azgadhi winning a workmanlike final, 3-0. His brother, " [:a {:href "/athletes/58783"} "Amir Reza Khadem Azgadhi"] ", won a bronze medal in Atlanta, as a freestyle middleweight."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Classification Points", :class "footnote"} "CP"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Technical Points", :class "footnote"} "TP"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "12"] [:td {} [:a {:href "/athletes/58785"} "Rasoul Khadem Azgadhi"]] [:td {} [:a {:href "/countries/IRI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/IRI.png"}] "IRI"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "20"] [:td {} [:a {:href "/athletes/59866"} "Makharbek Khadartsev"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "3"] [:td {} [:a {:href "/athletes/58324"} "Eldar Kurtanidze"]] [:td {} [:a {:href "/countries/GEO"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GEO.png"}] "GEO"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "7"] [:td {} [:a {:href "/athletes/59995"} "Jozef Lohyňa"]] [:td {} [:a {:href "/countries/SVK"} [:img {:style "padding-right: 2px; verti