tion {:value "1462"} "Giant Slalom, Men"] "\n" [:option {:value "1465"} "Slalom, Men"] "\n" [:option {:value "1468"} "Combined, Men"] "\n" [:option {:value "1474"} "Downhill, Women"] "\n" [:option {:value "1475"} "Super G, Women"] "\n" [:option {:value "1476"} "Giant Slalom, Women"] "\n" [:option {:value "1479"} "Slalom, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1171"} "1936"] "\n" [:option {:value "1189"} "1948"] "\n" [:option {:value "1377"} "1988"] "\n" [:option {:value "1403"} "1992"] "\n" [:option {:value "1429"} "1994"] "\n" [:option {:value "1455"} "1998"] "\n" [:option {:value "1510"} "2006"] "\n" [:option {:value "924561"} "2010"] "\n" [:option {:value "350019"} "2014"] "\n" [:option {:value "9000119"} "2018"] "\n" [:option {:value "19019519"} "2022"] "\n" [:option {:value "15000019"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/38"} "Event type"]] [:h1 {:class "event_title"} "Combined, Women" [:small {} [:a {:class "footnote", :href "#", :title "The downhill was postponed because of heavy winds, so the slalom runs were conducted first.", :data-toggle "tooltip", :data-placement "right"} "1"]]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "14 February 2002"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/125"} "Snowbasin Ski Resort, Huntsville, Utah"] " (Wildflower)"]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1482"} "31 from 14 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "One downhill run and two slalom runs, total time determined placement."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Gates: 53" [:br {}] "Length: ?" [:br {}] "Start Altitude: 2100 m" [:br {}] "Vertical Drop: 152 m"]]]] [:div {:class "description"} [:p {} "The women’s combined downhill was delayed a few hours due to high winds and held after the slalom. The 2001 World Cup champion was Croatian " [:a {:href "/athletes/99432"} "Janica Kostelić"] ", who had overcome significant knee problems to get to that level. During a training run in December 1999, she had sustained a multi-ligament knee injury and the resultant surgery kept her out until the 2000 season. After winning the World Cup, she had undergone a series of knee surgeries in the summer of 2001, and was still recovering as she came into Salt Lake City. Better in the slalom than the downhill, the weather delay helped her as she was able to take the lead by placing first in the slalom, ahead of " [:a {:href "/athletes/81037"} "Martina Ertl"] ", the 2001 World Champion. The downhill was won by Austrian " [:a {:href "/athletes/81225"} "Renate Götschl"] ", who had been fourth in the slalom. It moved her up to second place, but Kostelić placed third in the downhill, to hold onto her lead and take the gold medal. It was her first ever Olympic gold medal, but during the 2002 Winter Olympics, she would win three golds and four medals. Her four Alpine gold medals at one Olympics was a record for any alpine skier of either gender."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Slalom"] [:th {} "Downhill"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/99432"} "Janica Kostelić"]] [:td {} [:a {:href "/countries/CRO"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CRO.png"}] "CRO"]] [:td {} "2:43.28"] [:td {} "1:27.28 (1)"] [:td {} "1:16