hletes/60592"} "Nate Carr"] " won the bronze medal by defeating Japan’s " [:a {:href "/athletes/58984"} "Kosei Akaishi"] " by decision. Akaishi had won a silver medal in 1984 as a featherweight, and in 1992, won Olympic bronze in this class."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Round Eliminated"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Classification Points", :class "footnote"} "CP"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "23"] [:td {} [:a {:href "/athletes/60810"} "Arsen Fadzayev"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "12"] [:td {} [:a {:href "/athletes/59219"} "Park Jang-Sun"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "26"] [:td {} [:a {:href "/athletes/60592"} "Nate Carr"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "9"] [:td {} [:a {:href "/athletes/58984"} "Kosei Akaishi"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazon