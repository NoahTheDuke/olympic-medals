value "353818"} "Synchronized Springboard, Men"] "\n" [:option {:value "353829"} "Synchronized Platform, Men"] "\n" [:option {:value "353840"} "Springboard, Women"] "\n" [:option {:value "353896"} "Synchronized Springboard, Women"] "\n" [:option {:value "353905"} "Synchronized Platform, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "54112"} "1928"] "\n" [:option {:value "54120"} "1932"] "\n" [:option {:value "54124"} "1936"] "\n" [:option {:value "54128"} "1948"] "\n" [:option {:value "54138"} "1952"] "\n" [:option {:value "54150"} "1956"] "\n" [:option {:value "54165"} "1960"] "\n" [:option {:value "54177"} "1964"] "\n" [:option {:value "54189"} "1968"] "\n" [:option {:value "54201"} "1972"] "\n" [:option {:value "54213"} "1976"] "\n" [:option {:value "54225"} "1980"] "\n" [:option {:value "54237"} "1984"] "\n" [:option {:value "54249"} "1988"] "\n" [:option {:value "54261"} "1992"] "\n" [:option {:value "54276"} "1996"] "\n" [:option {:value "54294"} "2000"] "\n" [:option {:value "54314"} "2004"] "\n" [:option {:value "259060"} "2008"] "\n" [:option {:value "309136"} "2012"] "\n" [:option {:value "19002318"} "2020"] "\n" [:option {:value "2010718"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/256"} "Event type"]] [:h1 {:class "event_title"} "Platform, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "17 – 18 August 2016"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/919"} "Parque Aquático Maria Lenk, Parque Olímpico da Barra, Barra da Tijuca, Rio de Janeiro"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/353868"} "28 from 17 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "10 metres platform."]]]] [:div {:class "description"} [:p {} "With five-time Olympic gold medalist " [:a {:href "/athletes/116031"} "Chen Ruolin"] " not defending the title she won in 2008 and 2012, the way was open for the new Chinese prodigy, 15-year-old " [:a {:href "/athletes/129587"} "Ren Qian"] ", to win gold. At the 2016 Rio Test and World Cup event, Ren received four perfect 10s in her first four dives and then in her final dive received 10s from all seven judges in what was described as the “Dive of the Tournament”. She won the event by more than 43 points from her team-mate " [:a {:href "/athletes/129589"} "Si Yajie"] ". On her way to winning the bronze medal at the 2015 World Championship in Kazan, Ren also registered a maximum 10. The individual platform event at the 2015 World Championships was won by " [:a {:href "/athletes/131439"} "Kim Kuk-Hyang"] " of North Korea, with " [:a {:href "/athletes/116060"} "Pandelela Rinong"] ", the London 2012 bronze medalist, in third place behind Ren."] "\n\n" [:p {} "Canada’s " [:a {:href "/athletes/116038"} "Meaghan Benfeito"] " led after the first round of dives of the preliminary round, but it was the Chinese pair of Si and Ren who finished one and two, with Ren 11.65 points behind Si, but a massive 39 points ahead of the third best qualifier, " [:a {:href "/athletes/132074"} "Jessica Parratto"] " of the US. Rinong qualified for the semi-final in sixth place. The world champion Kim Kuk-Hyang finished 25th and was outside the top 18 to make it through to the next round; her best dive brought her just 67.50 points as she was eliminated. Last of the qualifiers was Russia’s " [:a {:href "/athletes/131570"} "Yuliya Timoshinina"] " who landed face first into the pool on her second dive and received just 14 points, never recovering from that, but what an Olympic pedigree she had. Her parents " [:a {:href "/athletes/50042"} "Svetlana"] " and " [:a {:href "/athletes/50064"} "Vladimir"] " were both Olympic divers, her grandfather " [:a {:href "/athletes/40383"} "Aleksandr Timoshinin"] "  was a two-time Olympic gold medallist rower and her grandmother " [:a {:href "/athletes/50720"} "Nataliya Kuznetsova"] " won a diving silver medal in 1968."] "\n\n" [:p {} "The semi-final saw the two Chinese divers separated at the top of the leaderboard by the American Parratto as Ren slipped from second to third after a poor third dive, a backward three and a half somersault, for which the judges gave her just 46.20 points. She recovered with two final dives of 81.60 to stay in contention while her team-mate Si Jayjie remained in the gold medal position helped by a brilliant third dive, an armstand back double somersault with one and a half twists, for which she received four 9s from the seven judges and a total of 84.80 as she went into the final 22.30 points ahead of Jessica Parratto with Australia’s " [:a {:href "/athletes/116032"} "Melissa Wu"] " up to fourth."] "\n\n" [:p {} "Canada’s Meaghan Benfeito led after the first round dives in the final with Si and Parratto sharing second place. But after dive two, Si was in the lead with Ren moving up from fourth to second, with Parratto in third and Benfeito relegated to fourth, but then the competition all changed. Ren Qian  took the lead after her third dive, a brilliantly executed inward three-and-a-half somersault, which earned her 94.05, the highest score of the night, and, in the same round, Parratto moved out of contention with the worst dive of the night, which scored just 44.80. Ren’s two final dives were both in excess of 90 points and she achieved four 10s in those two dives. Only Si stayed with her but even she knew it was all over before her final dive as she needed over 100 to win. While the two Chinese divers were pulling away from the field, Benfeito dived consistently to win the bronze medal, albeit 30 points behind Si and 50 points behind Ren, to add to the bronze she won in the synchronised platform event. On winning at 15 years and 180 days, Ren became the youngest medalist at the Rio Games, as she was 120 days younger than Japan’s Mima Ito who won bronze in the women’s team table tennis two days earlier."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/129587"} "Ren Qian"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} "385.80 (2)"] [:td {} "362.40 (3)"] [:td {} "439.25 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/129589"} "Si Yajie"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} "397.45 (1)"] [:td {} "389.30 (1)"] [:td {} "419.40 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/116038"} "Meaghan Benfeito"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {} "329.15 (7)"] [:td {} "332.80 (9)"] [:td {} "389.20 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/107918"} "Paola Espinosa"]] [:td {} [:a {:href "/countries/MEX"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/MEX.png"}] "MEX"]] [:td {} "313.70 (13)"] 