lue "258959"} "Individual Time Trial, Men"] "\n" [:option {:value "259029"} "Individual Time Trial, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "154567"} "1984"] "\n" [:option {:value "154673"} "1988"] "\n" [:option {:value "154793"} "1992"] "\n" [:option {:value "154918"} "1996"] "\n" [:option {:value "155045"} "2000"] "\n" [:option {:value "155175"} "2004"] "\n" [:option {:value "308001"} "2012"] "\n" [:option {:value "356866"} "2016"] "\n" [:option {:value "19001702"} "2020"] "\n" [:option {:value "2003682"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/242"} "Event type"]] [:h1 {:class "event_title"} "Road Race, Individual, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "10 August 2008 — 14:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/820"} "Gonglu Zixingche Saichang, Juyongguan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/259030"} "66 from 33 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "126 km. mass start race."]]]] [:div {:class "description"} [:p {} "The women’s road race was held over 126.4 km. and was the first women’s cycling event of the Beijing Olympics. Although many riders had trained for hot, humid conditions, the race was held in terrible weather, as rain began to fall shortly after the start, and much of the race was held in a downpour with strong winds. Several crashes occurred on the slick course, and several of these were blamed on poor marking of the course which confused the riders. On the final lap, a five-rider break went off the front, led by Italy’s " [:a {:href "/athletes/103707"} "Tatiana Guderzo"] ", with only one favorite in the group – " [:a {:href "/athletes/103694"} "Nicole Cooke"] " of Great Britain. Guderzo had placed second at the 2004 World Championships road race, but Cooke was considered much stronger, having been on the podium at the Worlds in both 2005 and 2006. Coming to the finish up the Badaling section of the Great Wall climb, Cooke and Guderzo were joined by Sweden’s " [:a {:href "/athletes/113110"} "Emma Johansson"] ", as they dropped " [:a {:href "/athletes/103705"} "Christiane Soeder"] " (AUT) and " [:a {:href "/athletes/113099"} "Linda Serup"] " (DEN). Over the top of the climb, Cooke took the lead and held on to win by a bike length. One rider who was not present was Italy’s Maria Bastianelli, the 2007 World Champion, who had tested positive for flenfluramine in July and was not eligible."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Margin"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/103694"} "Nicole Cooke"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {} "3-32:24"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/113110"} "Emma Johansson"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "3-32:24"] [:td {} "same time"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athlet