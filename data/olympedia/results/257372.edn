 [:a {:href "/athletes/73799"} "Erik de Bruin"] " (NED) did it in 1984."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1639"] [:td {} [:a {:href "/athletes/105709"} "Gerd Kanter"]] [:td {} [:a {:href "/countries/EST"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/EST.png"}] "EST"]] [:td {} "64.66 (5)"] [:td {} "68.82 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "2600"] [:td {} [:a {:href "/athletes/114697"} "Piotr Małachowski"]] [:td {} [:a {:href "/countries/POL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/POL.png"}] "POL"]] [:td {} "65.94 (1)"] [:td {} "67.82 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "2369"] [:td {} [:a {:href "/athletes/73209"} "Virgilijus Alekna"]] [:td {} [:a {:href "/countries/LTU"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/LTU.png"}] "LTU"]] [:td {} "65.84 (2)"] [:td {} "67.79 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "1893"] [:td {} [:a {:href "/athletes/114699"} "Robert Harting"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "64.19 (8)"] [:td {} "67.09 (4)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {:class "bib"} "1630"] [:td {} [:a {:href "/athletes/83470"} "Frank Casa