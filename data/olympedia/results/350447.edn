amazonaws.com/AUT.png"}] "AUT"] " / 12 February 2010 / " [:a {:href "/records/event_name/518"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #1"] [:td {:style "width: 400px"} [:a {:href "/athletes/87740"} "Yury Kalinin"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #2"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002494"} "Hermann Kothleitner"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #3"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003923"} "Pascal Malec"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #4"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004484"} "Stefan Thoma"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #5"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003841"} "Ole Walseth"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "K-Point: 95 m"]]]] [:div {:class "description"} [:p {} "Because a number of jumpers won World Cup events early in the winter, there was no clear favorite for the first ski jumping event. After the first round in the final, World Cup leader " [:a {:href "/athletes/109725"} "Kamil Stoch"] " from Poland took the lead with 105.5 m, followed by the Norwegian world champion [Anders Bardal] (/athletes/101142) and Slovenian " [:a {:href "/athletes/119539"} "Peter Prevc"] "."] "\n\n" [:p {} "Germany’s " [:a {:href "/athletes/127867"} "Andreas Wellinger"] ", who was only ranked 14th after the first round, scored 257.1 points and led the contest with only five jumpers remaining. " [:a {:href "/athletes/127377"} "Thomas Diethart"] " (AUT) later passed him with 258.3 points to place fourth overall. The top three after the first round finally took the medals. Bardal, already bronze medalist with the team in Vancouver, finished third with 264.1 points and Prevc moving from third to second with 265.3 points. Suffering from a headache, stomach ache and high temperature earlier in the day, Stoch had again the longest jump with 103.5 m, finishing with a total score of 278.0 points to take the gold medal with a large margin."] "\n\n" [:p {} "For other favorites, the outcome of this event was a major disappointment: Last year’s World Cup winner " [:a {:href "/athletes/119523"} "Gregor Schlierenzauer"] " from Austria finished 11th after placing 18th in the first round. One of the top jumpers in recent years, triple Olympic Champion " [:a {:href "/athletes/109740"} "Thomas Morgenstern"] ", suffered a terrible crash in training on 10 January. His participation was a last-minute decision and many observers criticized the medical staff for giving him the green light to compete, and he never seriously challenged the medalists and finished 14th. " [:a {:href "/athletes/99870"} "Simon Ammann"] ", winner of four individual ski-jumping gold medals for Switzerland in 2002 and 2010, could place only 17th."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/109725"}