ue "313012"} "Floor Exercise, Men"] "\n" [:option {:value "313024"} "Vault, Men"] "\n" [:option {:value "313027"} "Parallel Bars, Men"] "\n" [:option {:value "313030"} "Horizontal Bar, Men"] "\n" [:option {:value "313021"} "Rings, Men"] "\n" [:option {:value "313018"} "Pommelled Horse, Men"] "\n" [:option {:value "313009"} "Individual All-Around, Women"] "\n" [:option {:value "313003"} "Team All-Around, Women"] "\n" [:option {:value "313033"} "Floor Exercise, Women"] "\n" [:option {:value "313015"} "Vault, Women"] "\n" [:option {:value "313039"} "Uneven Bars, Women"] "\n" [:option {:value "313036"} "Balance Beam, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "70024"} "1904"] "\n" [:option {:value "926071"} "1904"] "\n" [:option {:value "70046"} "1906"] "\n" [:option {:value "70049"} "1908"] "\n" [:option {:value "70055"} "1912"] "\n" [:option {:value "70059"} "1920"] "\n" [:option {:value "70063"} "1924"] "\n" [:option {:value "70075"} "1928"] "\n" [:option {:value "70098"} "1932"] "\n" [:option {:value "70114"} "1936"] "\n" [:option {:value "70136"} "1948"] "\n" [:option {:value "70158"} "1952"] "\n" [:option {:value "70183"} "1956"] "\n" [:option {:value "70208"} "1960"] "\n" [:option {:value "70252"} "1964"] "\n" [:option {:value "70296"} "1968"] "\n" [:option {:value "70354"} "1972"] "\n" [:option {:value "70412"} "1976"] "\n" [:option {:value "70470"} "1980"] "\n" [:option {:value "70528"} "1984"] "\n" [:option {:value "70586"} "1988"] "\n" [:option {:value "70644"} "1992"] "\n" [:option {:value "70702"} "1996"] "\n" [:option {:value "70760"} "2000"] "\n" [:option {:value "70844"} "2004"] "\n" [:option {:value "259961"} "2008"] "\n" [:option {:value "353621"} "2016"] "\n" [:option {:value "19009115"} "2020"] "\n" [:option {:value "2012215"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/312"} "Event type"]] [:h1 {:class "event_title"} "Team All-Around, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "28 – 30 July 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/872"} "North Greenwich Arena, Greenwich, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/313000"} "60 from 12 countries"]]]]] [:div {:class "description"} [:p {} "Even after coming in second at the last two World Championships, Japan, with its star team member " [:a {:href "/athletes/111925"} "Kohei Uchimura"] ", was favored to take the gold medal in the men’s gymnastics team all-around event at the 2012 Summer Olympics. They could not ignore China, however, who had finished first at the 2000 and 2008 Olympic Games, as well as the two most recent World Championships, and still had many multiple World Championship titleholders amongst its ranks. The teams from the Germany and the United States, which had won bronze medals at the 2010 and 2011 World Championships respectively, were seen as strong contenders for the final podium spot."] "\n\n" [:p {} "The qualification round took a surprising twist, with the United States coming out on top and Japan and China finishing fifth and sixth respectively. The home team impressed as well, with Great Britain finishing third behind Russia. Germany in fourth rounded out the top six while Ukraine and France nabbed the last two spots for the final. In the race for the medals, the United States lost the steam it had had in the qualifications and sank to fifth place by the end of the competition. Ukraine and Great Britain battled to gain a solid grasp on the final podium spot, with the home nation coming out on top and setting themselves up to take home their first team medal in men’s gymnastics since 1912, when Great Britain had finished third. China had already guaranteed itself the gold medal and, with Japan in second place and only Uchimura left with an apparatus (the pommel horse), that nation seemed poised for the silver. Uchimura tumbled from the pommel horse during his dismount, however, and his team suffered for it, being dragged down into fourth place and surrendering the silver medal to Great Britain. This would have been only the second time British gymnastics had won silver, and the first since " [:a {:href "/athletes/30181"} "Walter Tysall"] "’s placement in the 1908 individual all-around. The Japanese team launched an inquiry into Uchimura’s score, however, claiming that he was penalized too harshly for his dismount, and won the appeal. The judges raised his total by 0.7, enough to bump the nation back into silver medal position. This sent the home team back to bronze and knocked Ukraine off the podium entirely, an unfortunately dramatic end to an otherwise rousing competition."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "People's Republic of China"] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/111921"} "Chen Yibing"] " • " [:a {:href "/athletes/122117"} "Feng Zhe"] " • " [:a {:href "/athletes/127150"} "Guo Weiyang"] " • " [:a {:href "/athletes/122116"} "Zhang Chenglong"] " • " [:a {:href "/athletes/111922"} "Zou Kai"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} "Japan"] [:t