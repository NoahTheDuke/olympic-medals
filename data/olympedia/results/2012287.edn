e "2012215"} "Team All-Around, Men"] "\n" [:option {:value "2012230"} "Floor Exercise, Men"] "\n" [:option {:value "2012233"} "Vault, Men"] "\n" [:option {:value "2012240"} "Parallel Bars, Men"] "\n" [:option {:value "2012243"} "Horizontal Bar, Men"] "\n" [:option {:value "2012246"} "Rings, Men"] "\n" [:option {:value "2012249"} "Pommelled Horse, Men"] "\n" [:option {:value "2012252"} "Individual All-Around, Women"] "\n" [:option {:value "2012263"} "Team All-Around, Women"] "\n" [:option {:value "2012274"} "Floor Exercise, Women"] "\n" [:option {:value "2012277"} "Vault, Women"] "\n" [:option {:value "2012284"} "Uneven Bars, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "70181"} "1952"] "\n" [:option {:value "70206"} "1956"] "\n" [:option {:value "70248"} "1960"] "\n" [:option {:value "70292"} "1964"] "\n" [:option {:value "70336"} "1968"] "\n" [:option {:value "70395"} "1972"] "\n" [:option {:value "70453"} "1976"] "\n" [:option {:value "70511"} "1980"] "\n" [:option {:value "70569"} "1984"] "\n" [:option {:value "70627"} "1988"] "\n" [:option {:value "70685"} "1992"] "\n" [:option {:value "70743"} "1996"] "\n" [:option {:value "70827"} "2000"] "\n" [:option {:value "70911"} "2004"] "\n" [:option {:value "259997"} "2008"] "\n" [:option {:value "313036"} "2012"] "\n" [:option {:value "353693"} "2016"] "\n" [:option {:value "19009187"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/331"} "Event type"]] [:h1 {:class "event_title"} "Balance Beam, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "28 July –  5 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2166"} "Bercy Arena, Bercy, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2012287"} "78 from 34 countries"]]]]] [:div {:class "description"} [:p {} "Despite being a strong balance beam performer, " [:a {:href "/athletes/132107"} "Simone Biles"] " had not yet won an Olympic title in this event, placing third in both 2016 (after a trip to the floor) and 2020 (suffering from mental health issues). She had returned to gymnastics in 2023 with a world title on the beam, however, her fourth. Defending champion " [:a {:href "/athletes/141696"} "Guan Chenchen"] " did not compete in Paris. Remarkably, four Japanese women had won medals in the 2021 and 2022 World Championships (including both golds), but neither of them competed in Paris."] "\n\n" [:p {} "Leader after qualifying was China’s " [:a {:href "/athletes/152581"} "Zhou Yaqin"] ", runner-up at the 2023 Worlds, ahead of Biles and " [:a {:href "/athletes/129288"} "Rebeca Andrade"] " of Brazil. On the error-prone beam, however, this proved a poor prediction for the final, which turned out to be an error festival. Zhou narrowly avoided falling but had to grab the beam, costing her precious points, and leading to a 14.100 score. " [:a {:href "/athletes/147194"} "Suni Lee"] " (USA) and Brazil’s " [:a {:href "/athletes/152556"} "Júlia Soares"] " fell. Italy’s " [:a {:href "/athletes/152651"} "Manila Esposito"] " had a major wobble and earned a 14.000 score, although it would bring her a bronze, and then Romania’s " [:a {:href "/athletes/152699"} "Sabrina Maneca-Voinea"] " fell twice in her routine. Italy’s " [:a {:href "/athletes/144053"} "Alice D’Amato"] " was the first with a stable routine and, with 14.366, she moved into first place. Then came Biles, who had a great opening to her routine, before slipping off the beam after a jump. The final gymnast, all-around silver medalist and 2023 beam medalist at the Worlds, Rebeca Andrade, placed just outside the medals."] "\n\n" [:p {} "D’Amato’s gold was a surprise, particularly as she had never won a medal in the event internationally, although she had won all-around and uneven bar medals. Italy had only won one Olympic medal in a women’s individual event (" [:a {:href "/athletes/117690"} "Vanessa Ferrari"] " on the floor in 2020) and now won gold and bronze in a single event. It was also the first Italian gymnastics gold since " [:a {:href "/athletes/91501"} "Igor Cassina"] " in 2004."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/144053"} "Alice D'Amato"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/152581"} "Zhou Yaqin"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/152651"} "Manila Esposito"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/129288"} "Rebeca Andrade"]] [:td {} [:a {:href "/countries/BRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BRA.png"}] "BRA"]] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :s