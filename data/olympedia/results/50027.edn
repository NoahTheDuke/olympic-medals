 "50000"} "1912"] "\n" [:option {:value "50009"} "1920"] "\n" [:option {:value "50018"} "1924"] "\n" [:option {:value "50036"} "1932"] "\n" [:option {:value "50045"} "1936"] "\n" [:option {:value "50054"} "1948"] "\n" [:option {:value "50063"} "1952"] "\n" [:option {:value "50081"} "1956"] "\n" [:option {:value "50099"} "1960"] "\n" [:option {:value "50117"} "1964"] "\n" [:option {:value "50135"} "1968"] "\n" [:option {:value "50153"} "1972"] "\n" [:option {:value "50171"} "1976"] "\n" [:option {:value "50189"} "1980"] "\n" [:option {:value "50207"} "1984"] "\n" [:option {:value "50225"} "1988"] "\n" [:option {:value "50243"} "1992"] "\n" [:option {:value "50261"} "1996"] "\n" [:option {:value "50270"} "2000"] "\n" [:option {:value "50288"} "2004"] "\n" [:option {:value "260915"} "2008"] "\n" [:option {:value "317000"} "2012"] "\n" [:option {:value "351850"} "2016"] "\n" [:option {:value "19002500"} "2020"] "\n" [:option {:value "2003825"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/361"} "Event type"]] [:h1 {:class "event_title"} "Individual, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "31 July –  4 August 1928"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/288"} "Zwemstadion, Amsterdam"] " / " [:a {:href "/venues/289"} "Sportpark, Hilversum"] " / " [:a {:href "/venues/291"} "Schermzaal, Amsterdam"] " / " [:a {:href "/venues/294"} "Schietterrein, Zeeburg, Amsterdam"] " / " [:a {:href "/venues/295"} "Rijschool, Willem III-kazerne, Amersfoort"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/50027"} "37 from 14 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Point-for-place scoring."]]]] [:div {:class "description"} [:p {} "The defending champion, " [:a {:href "/athletes/35073"} "Bo Lindman"] ", was back. As only Swedes had won the medals in this event in 1912-1924, he and his teammates, " [:a {:href "/athletes/23459"} "Sven Thofelt"] " and " [:a {:href "/athletes/35048"} "Ingvar Berg"] ", were expected to lead the event. Thofelt took the lead after the second phase, swimming, finishing second in that sport. Lindman was hampered by a poor start in shooting, finishing only 15th, and, although he moved up with a fifth-place in swimming, he stood only seventh after two phases. Thofelt maintained the lead after fencing, finishing fourth with the épée. German " [:a {:href "/athletes/34820"} "Helmut Kahl"] " placed second in fencing and moved into second place overall. Lindman again struggled, finishing 22nd with the sword. Now in ninth place, his chances for gold, or even a medal, seemed remote. But he moved up into a tie for fourth place after the cross-country run, as Thofelt and Kahl continued to lead, despite mediocre running performances."] "\n\n" [:p {} "After four phases, the places were: Thofelt 1st with 33; Kahl 2nd with 40; " [:a {:href "/athletes/34976"} "Willem van Rhijn"] " (NED) 3rd with 43; and Lindman tied with Italy’s " [:a {:href "/athletes/34898"} "Eugenio Pagnini"] " in fourth with 45 points. But Lindman almost caught the leaders. He rode well, finishing third in the steeplechase, and moved up to the silver medal. Thofelt finished only 21st on the horse, but hung on for the gold. Kahl won bronze, the first medal ever won in modern pentathlon by a non-Swede."] "\n\n" [:p {} "Thofelt would return to the Olympics in modern pentathlon in " [:a {:href "/results/50036"} "1932"] " and " [:a {:href "/results/50045"} "1936"] ", but did not medal. However, he won Olympic medals in fencing in both " [:a {:href "/results/84035"} "1936"] " and " [:a {:href "/results/86162"} "1948"] ". He would later become President of the " [:a {:href "/organizations/80"} "Union Internationale de Pentathlon Moderne"] " (UIPM) after its formation in 1948, would serve in that post for 23 years, and also became an " [:a {:href "/organizations/1"} "IOC"] " Member from 1970-76."] "\n\n" [:p {} "The shooting section of the 1928 modern pentathlon was won by " [:a {:href "/athletes/42540"} "Heinz Hax"] ", who would win two silver medals in shooting in " [:a {:href "/results/51632"} "1932"] " and " [:a {:href "/results/51634"} "1936"] ", and was the son of " [:a {:href "/athletes/47819"} "Georg Hax"] ", who competed in the Olympics in " [:a {:href "/results/38000"} "water polo in 1900"] " and " [:a {:href "/results/70046"} "gymnastics in 1906"] "."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Ordinals"] [:th {} "Shooting"] [:th {} "Swimming"] [:th {} "Fencing"] [:th {} "Running"] [:th {} "Riding"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/23459"} "Sven Thofelt"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "47"] [:td {} "20 (6)"] [:td {} "5:02.4 (2)"] [:td {} "– (4)"] [:td {} "15:48.8 (21)"] [:td {} "100 (14)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/35073"} "Bo Lindman"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "50"] [:td {} "20 (15)"] [:td {} "5:19.4 (5)"] [:td {} "– (22)"] [:td {} "14:30.2 (3)"] [:td {} "100 (5)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/34820"} "Helmut Kahl"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "52