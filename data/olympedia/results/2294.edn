on.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "2280"} "1988"] "\n" [:option {:value "2306"} "1994"] "\n" [:option {:value "2316"} "1998"] "\n" [:option {:value "2329"} "2002"] "\n" [:option {:value "2342"} "2006"] "\n" [:option {:value "923621"} "2010"] "\n" [:option {:value "350430"} "2014"] "\n" [:option {:value "9000766"} "2018"] "\n" [:option {:value "19020356"} "2022"] "\n" [:option {:value "15000836"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/370"} "Event type"]] [:h1 {:class "event_title"} "Team, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "16 – 17 February 1992"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/5"} "Le Praz, Courchevel"] " / " [:a {:href "/venues/11"} "Les Saisies"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2294"} "33 from 11 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Normal hill ski jumping and 3 x 10 kilometre relay skiing; placements determined by points table.  Three members per team, with each individual's ski jump score to count towards team total.  Pursuit-style cross-country relay race, with skiers leaving in order of their finish in the ski jumping, so that final placement determined by final placement in cross-country ski race."]]]] [:div {:class "description"} [:p {} "While West Germany and Norway had won the first four World Championship in team Nordic combined, the 1991 World Championship was won by Austria, with France second, and the surprising Japanese third. In Albertville, the Japanese jumped to a commanding lead on the normal hill, leading by 29.5, giving them a start margin of 2:27 for the relay, with Austria second, and Germany third, and the dangerous Norwegians a full 6:16 back. In the relay, Norway, which had placed sixth in jumping, would post the best time, moving them up to the silver medal. Japan would place only sixth in the skiing, but it was enough for them to win the gold medal easily, with a 1:26.4 margin over Norway. They were never in danger during the relay. Austria was third in the relay and dropped back to third overall and the bronze medal position. The hometown French team had been fifth on the jumping hill, and was second in the relay, but could not move onto the podium, finishing fourth."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time Margin"] [:th {} "Ski Jumping, Normal Hill"] [:th {} "Cross Country Skiing, 3 × 10 km Relay"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Japan"] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]] [:td {} "—"] [:td {} "645.1 (1)"] [:td {} "1-23:36.5 (6)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/95434"} "Reiichi Mikata"] " "] [:td {}] [:td {} "–"] [:td {} "227.5"] [:td {} "28:22.5"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/88502"} "Takanori Kono"] " "] [:td {}] [:td {} "–"] [:td {} "199.0"] [:td {} "28:40.2"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/95987"} "Kenji Ogiwara"] " "] [:td {}] [:td {} "–"] [:td {} "218.6"] [:td {} "26:33.8"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Norway"] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags