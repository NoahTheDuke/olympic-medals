 and Spain had been tied for third after round one, but both stumbled in round two, as Italy moved up from fifth to third, winning the bronze medal."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "Horse"] [:th {} "NOC"] [:th {} "Faults"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "West Germany"] [:td {}] [:td {} [:a {:href "/countries/FRG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRG.png"}] "FRG"]] [:td {} "32.00"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "148"] [:td {} [:a {:href "/athletes/12321"} "Fritz Ligges"] " "] [:td {} [:i {} [:a {:href "/horses/2124"} "Robin"]]] [:td {}] [:td {} "8.00"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "136"] [:td {} [:a {:href "/athletes/13008"} "Gerd Wiltfang"] " "] [:td {} [:i {} [:a {:href "/horses/168"} "Askan"]]] [:td {}] [:td {} "12.00"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "149"] [:td {} [:a {:href "/athletes/12785"} "Hartwig Steenken"] " "] [:td {} [:i {} [:a {:href "/horses/2294"} "Simona"]]] [:td {}] [:td {} "12.00"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "334"] [:td {} [:a {:href "/athletes/13010"} "Hans Günter Winkler"] " "] [:td {} [:i {} [:a {:href "/horses/2490"} "Torphy"]]] [:td {}] [:td {} "16.00"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} "United States"] [:td {}] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "32.25"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] 