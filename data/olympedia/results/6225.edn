trong to catch a tiring Ivey and won the silver medal."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "207"] [:td {} [:a {:href "/athletes/47595"} "Roland Matthes"]] [:td {} [:a {:href "/countries/GDR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GDR.png"}] "GDR"]] [:td {} "2:06.62 (1 h5)"] [:td {} "2:02.82 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "572"] [:td {} [:a {:href "/athletes/51575"} "Mike Stamm"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "2:07.51 (1 h2)"] [:td {} "2:04.09 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "562"] [:td {} [:a {:href "/athletes/51413"} "Mitch Ivey"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "2:09.32 (1 h4)"] [:td {} "2:04.33 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "8"] [:td {} [:a {:href "/athletes/45181"} "Brad Cooper"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]] [:td {} "2:07.90 (1 h3)"] [:td {} "2:06.59 (4)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {:class "bib"} "567"] [:td {} [:a {:href "/athletes/51482"} "Tim McKee"]] [:td {} [:a {:href