value "50000"} "1912"] "\n" [:option {:value "50009"} "1920"] "\n" [:option {:value "50018"} "1924"] "\n" [:option {:value "50027"} "1928"] "\n" [:option {:value "50036"} "1932"] "\n" [:option {:value "50054"} "1948"] "\n" [:option {:value "50063"} "1952"] "\n" [:option {:value "50081"} "1956"] "\n" [:option {:value "50099"} "1960"] "\n" [:option {:value "50117"} "1964"] "\n" [:option {:value "50135"} "1968"] "\n" [:option {:value "50153"} "1972"] "\n" [:option {:value "50171"} "1976"] "\n" [:option {:value "50189"} "1980"] "\n" [:option {:value "50207"} "1984"] "\n" [:option {:value "50225"} "1988"] "\n" [:option {:value "50243"} "1992"] "\n" [:option {:value "50261"} "1996"] "\n" [:option {:value "50270"} "2000"] "\n" [:option {:value "50288"} "2004"] "\n" [:option {:value "260915"} "2008"] "\n" [:option {:value "317000"} "2012"] "\n" [:option {:value "351850"} "2016"] "\n" [:option {:value "19002500"} "2020"] "\n" [:option {:value "2003825"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/361"} "Event type"]] [:h1 {:class "event_title"} "Individual, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "2 –  6 August 1936"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/322"} "Truppenübungsplatz, Döberitz, Brandenburg"] " / " [:a {:href "/venues/324"} "Haus des Sports, Kuppelsaal, Reichssportfeld, Berlin"] " / " [:a {:href "/venues/333"} "Schießstände, Ruhleben, Berlin"] " / " [:a {:href "/venues/320"} "Schwimmstadion, Reichssportfeld, Berlin"] " / " [:a {:href "/venues/334"} "Golfplatz, Wannsee, Berlin"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/50045"} "42 from 16 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Point-for-place scoring."]]]] [:div {:class "description"} [:p {} "With the lack of international competition, it was again very difficult to handicap the event. Sweden had won 13 of the 15 medals awarded in Olympic competition since " [:a {:href "/results/50000"} "1912"] ", so they were expected to be tough. There had been a European Championship in 1935, won by " [:a {:href "/athletes/34871"} "Nándor Orbán"] " (HUN), but nothing else is known of the competition. The " [:a {:href "/results/50027"} "1928"] " champion, " [:a {:href "/athletes/23459"} "Sven Thofelt"] " (SWE), was back, and he also competed in fencing in 1936, in which he won a medal in " [:a {:href "/results/84035"} "team épée"] "."] "\n\n" [:p {} [:a {:href "/athletes/34875"} "Silvano Abbà"] " (ITA) took the early lead, winning the horse steeplechase, with Germany’s " [:a {:href "/athletes/34817"} "Gotthard Handrick"] " and Belgium’s " [:a {:href "/athletes/34624"} "Raoul Mollet"] " tying for second. Handrick then placed second in épée fencing and took a big lead, with only 4½ points after two phases. The third phase was rapid-fire pistol shooting and " [:a {:href "/athletes/35155"} "Charles Leonard"] " (USA) scored big here, winning the competition with the first ever possible of 200 in modern pentathlon rapid-fire pistol shooting. This moved him into fourth place overall, but Handrick was still well ahead. Handrick maintained his lead after the swim, followed by Thofelt, who moved into second, placing third in the swim. Leonard was sixth in the 300 metre freestyle to move into the bronze medal position after four days of competition. The cross-country run was won by Austria’s " [:a {:href "/athletes/89483"} "Karl Leban"] ", although it only served to move him from 35th to 26th place. Handrick placed 14th in the run, but was not really challenged for the gold medal. Leonard tied for seventh running to move up to a silver medal, followed by Abbà, who won the bronze medal, with Thofelt falling to fourth (as in 1932) with a 24th place finish in the run. For the first time ever, no Swede won a medal."] "\n\n" [:p {} "Handrick soon afterwards became a fighter pilot with the “Legion Condor,” a squadron of German volunteers for the Fascist cause in the Spanish Civil War.  Between this and WW II, he claimed 15 victories in aerial combat. Abbà, who won the riding section of the Modern Pentathlon, was killed during the Battle of Izbushensky, where the 700 riders of the Italian Army’s Savoy Cavalry mounted the last successful cavalry charge in military history."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Ordinals"] [:th {} "Riding"] [:th {} "Fencing"] [:th {} "Shooting"] [:th {} "Swimming"] [:th {} "Running"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/34817"} "Gotthard Handrick"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "31.5"] [:td {} "0.0 (=2)"] [:td {} "25 (2)"] [:td {} "20 (4)"] [:td {} "4:51.9 (9)"] [:td {} "14:41.7 (14)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/35155"} "Charles Leonard"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "39.5"] [:td {} "0.0 (15)"] [:td {} "22 (10)"] [:td {} "20 (1)"] [:td {} "4:40.9 (6)"] [:td {} "14:15.8 (=7)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/34875"} "Silvano Abbà"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} "45.5"] [:td {} "0.0 (1)"] [:td {} "17 (=15)"] [:td {} "20 (10)"] [:td {} "5:13.8 (14)"] [:t