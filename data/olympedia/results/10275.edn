 "10197"} "Windsurfer (Lechner Division II), Open"] "\n" [:option {:value "10184"} "One Person Dinghy (Finn), Open"] "\n" [:option {:value "10223"} "Two Person Keelboat (Star), Open"] "\n" [:option {:value "10249"} "Multihull (Tornado), Open"] "\n" [:option {:value "10262"} "Three Person Keelboat (Soling), Open"] "\n" [:option {:value "10236"} "Two Person Heavyweight Dinghy (Flying Dutchman), Open"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "10365"} "1992"] "\n" [:option {:value "10547"} "1996"] "\n" [:option {:value "10765"} "2000"] "\n" [:option {:value "11075"} "2004"] "\n" [:option {:value "261254"} "2008"] "\n" [:option {:value "320178"} "2012"] "\n" [:option {:value "356219"} "2016"] "\n" [:option {:value "19008859"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/410"} "Event type"]] [:h1 {:class "event_title"} "Two Person Dinghy (470), Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "20 – 27 September 1988"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/658"} "Busan Yachting Center, Busan"] " (Course Alpha)"]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/10275"} "42 from 21 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Points awarded for placement in each race.  Best six of seven scores to count for final placement."]]]] [:div {:class "description"} [:p {} "This was the first Olympic sailing event open only to women. The 470 class had been added to the Olympic Program in 1976 and held from 1976-84 as a mixed event, but in 1988 it was split into two events for men and women."] "\n\n" [:p {} "The two favorites were the American and Swedish boats, who had raced six times at recent international championships, with Swedish skipper " [:a {:href "/athletes/61062"} "Marit Söderström"] " defeating the US skipper, " [:a {:href "/athletes/60974"} "Allison Jolly"] ", four times. Through the first four races, Jolly’s boat was by far the best, with two race wins, a second and a third, but they were disqualified in race five, and the Soviet crew of " [:a {:href "/athletes/61049"} "Iryna Chunykhovska"] " and " [:a {:href "/athletes/61015"} "Larysa Moskalenko"] " went ahead. Jolly and " [:a {:href "/athletes/60970"} "Lynne Jewell"] " came back to finish second in race six and re-take the lead, as the Soviets placed eighth. Jolly and Jewell had to start race seven, but only needed to finish 14th or higher to win gold, but in mid-race, their jib wire broke and their jib sail sagged down. Jolly was distraught and thought she had lost the gold medal, but Jewell was able to repair the jib sail with some spare nylon rope. They sailed on, finished ninth in the final race, and won the first gold medal in women’s Olympic sailing."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Net Points"] [:th {} "Total Points"] [:th {} "Race #1"] [:th {} "Race #2"] [:th {} "Race #3"] [:th {} "Race #4"] [:th {} "Race #5"] [:th {} "Race #6"] [:th {} "Race #7"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "26.7"] [:td {} "54.7"] [:td {} "5.7 (3)"] [:td {} ".0 (1)"] [:td {} ".0 (1)"] [:td {} "3.0 (2)"] [:td {} "[28.0] (" [:span {:class "label label-primary"} [:abbrev {:title "Disqualified"} "DQ"]] ")"] [:td {} "3.0 (2)"] [:td {} "15.0 (9)"] [:td 