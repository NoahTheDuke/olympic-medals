"} "Singles, Women"] "\n" [:option {:value "44678"} "Doubles, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "44067"} "1900"] "\n" [:option {:value "44200"} "1906"] "\n" [:option {:value "44542"} "1912"] "\n" [:option {:value "45001"} "1924"] "\n" [:option {:value "900237"} "1968"] "\n" [:option {:value "900305"} "1968"] "\n" [:option {:value "324218"} "2012"] "\n" [:option {:value "353423"} "2016"] "\n" [:option {:value "19004818"} "2020"] "\n" [:option {:value "2006718"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/611"} "Event type"]] [:h1 {:class "event_title"} "Doubles, Mixed" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "17 – 24 August 1920"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/244"} "Royal Beerschot Tennis &amp; Hockey Club, Antwerpen"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/44692"} "32 from 7 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament."]]]] [:div {:class "description"} [:p {} "In the mixed doubles, " [:a {:href "/athletes/2455"} "Suzanne Lenglen"] " teamed with " [:a {:href "/athletes/12"} "Max Decugis"] " to win the title, with the loss of only one set.  Decugis had also won bronze in the " [:a {:href "/results/44626"} "men’s doubles"] ", teaming with " [:a {:href "/athletes/2464"} "Pierre Albarran"] "."] "\n\n" [:p {} "For Max Decugis, it was the end of the most distinguished Olympic tennis career ever.  It began in 1900, when the Olympics were held in his hometown of Paris, and he won a " [:a {:href "/results/44047"} "silver medal in the doubles"] ".  He did not travel to " [:a {:href "/editions/3/sports/TEN"} "St. Louis in 1904"] ", but he competed at the Olympic tennis events in 1906, winning a gold medal in all three events, " [:a {:href "/results/44135"} "singles"] ", " [:a {:href "/results/44167"} "doubles"] ", and " [:a {:href "/results/44200"} "mixed"] ".  Decugis entered the Olympic tennis events in both " [:a {:href "/editions/5/sports/TEN"} "1908"] " and " [:a {:href "/editions/6/sports/TEN"} "1912"] ", but he did not compete in 1912 and, although he entered in 1908, he withdrew.  His 1920 medals closed his Olympic tennis career with six medals, four of them gold, both of which are Olympic records (if including the 1906 Intercalated Olympics).  At the " [:a {:href "/editions/8/sports/TEN"} "1924 Olympic tennis event in Paris"] ", the last held as a medal sport prior to " [:a {:href "/editions/22/sports/TEN"} "1988"] ", he was an honored spectator.  Between 1902 and 1920, Decugis won 33 titles (eight singles, 11 doubles, 14 mixed) at the French Championships, in those days closed to French players.  He reached the semi-finals of the All-Comers Singles at Wimbledon in 1911-12, and won the Wimbledon doubles title in 1911, with " [:a {:href "/athletes/20"} "André Gobert"] "."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/2455"} "Suzanne Lenglen"] " / " [:a {:href "/athletes/12"} "Max Decugis"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/59"} "Kitty McKane"] " / " [:a {:href "/athletes/122"} "Max Woosnam"]] [:td {} [:a {:href "/cou