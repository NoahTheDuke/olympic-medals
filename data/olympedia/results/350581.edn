8"} "Parallel Slalom, Men"] "\n" [:option {:value "350522"} "Slopestyle, Men"] "\n" [:option {:value "350512"} "Halfpipe, Men"] "\n" [:option {:value "350536"} "Cross, Men"] "\n" [:option {:value "350557"} "Parallel Giant Slalom, Women"] "\n" [:option {:value "350615"} "Slopestyle, Women"] "\n" [:option {:value "350605"} "Halfpipe, Women"] "\n" [:option {:value "350629"} "Cross, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:span {} "Not held in other editions"]] " | " [:a {:href "/event_names/1010"} "Event type"]] [:h1 {:class "event_title"} "Parallel Slalom, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "22 February 2014"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/891"} "Ekstrim-Park Rosa Khutor, Krasnaya Polyana"] " / " [:a {:href "/venues/891"} "Ekstrim-Park Rosa Khutor, Krasnaya Polyana"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/350581"} "32 from 15 countries"]]] [:tr {:class "referees", :style ""} [:th {} "Course Setter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5001609"} "Christian Rufer"]] [:td {} [:a {:href "/countries/SUI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SUI.png"}] "SUI"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Gates: 28" [:br {}] "Length: 325 m" [:br {}] "Start Altitude: 1090 m" [:br {}] "Vertical Drop: 80 m"]]]] [:div {:class "description"} [:p {} "The parallel special slalom was a new addition to the Winter Olympic Program, although it had been contested at the World Championships since 1996. Russia was looking for medals in the event, led by 2013 World Champion " [:a {:href "/athletes/110969"} "Yekaterina Tudegesheva"] " and the bronze medalist in the parallel giant slalom (PGS), " [:a {:href "/athletes/119555"} "Alyona Zavarzina"] ", but the three Russian riders, including " [:a {:href "/athletes/128392"} "Nataliya Soboleva"] ", all went out in the 1/8th-finals. The pre-race favorite was Switzerland’s " [:a {:href "/athletes/128534"} "Patrizia Kummer"] ", who had already won the PGS, but she too failed to make the quarters."] "\n\n" [:p {} "The final came down to Austrian " [:a {:href "/athletes/127379"} "Julia Dujmovits"] " against German " [:a {:href "/athletes/119556"} "Anke Karstens"] ". Karstens won the first run but Dujmovits came back to give Austria its first snowboarding gold medal at the Olympics. In the bronze medal race, " [:a {:href "/athletes/110974"} "Amelie Kober"] " repeated her finish at the 2013 World Championships to put two Germans on the podium, defeating Italian " [:a {:href "/athletes/110971"} "Corinna Boccacini"] "."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "13"] [:td {} [:a {:href "/athletes/127379"} "Julia Dujmovits"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "9"] [:td {} [:a {:href "/athletes/119556"} "Anke Karstens"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "5"] [:td {} [:a {:href "/athletes/110974"} "Amelie Kober"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "ht