3"} "30 kilometres, Men"] "\n" [:option {:value "1974"} "50 kilometres, Men"] "\n" [:option {:value "1975"} "4 × 10 kilometres Relay, Men"] "\n" [:option {:value "1979"} "5 kilometres, Women"] "\n" [:option {:value "1981"} "4 × 5 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1913"} "1952"] "\n" [:option {:value "1921"} "1956"] "\n" [:option {:value "1932"} "1960"] "\n" [:option {:value "1944"} "1964"] "\n" [:option {:value "1956"} "1968"] "\n" [:option {:value "1968"} "1972"] "\n" [:option {:value "1993"} "1980"] "\n" [:option {:value "2006"} "1984"] "\n" [:option {:value "2020"} "1988"] "\n" [:option {:value "2108"} "2002"] "\n" [:option {:value "2157"} "2006"] "\n" [:option {:value "923578"} "2010"] "\n" [:option {:value "350087"} "2014"] "\n" [:option {:value "9000298"} "2018"] "\n" [:option {:value "19019733"} "2022"] "\n" [:option {:value "15000155"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/195"} "Event type"]] [:h1 {:class "event_title"} "10 kilometres, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "10 February 1976 — 9:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/59"} "Langlaufstadion, Seefeld"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1980"} "44 from 14 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: ?" [:br {}] "Height Differential: 80 m" [:br {}] "Intermediate 1: 5.0 km" [:br {}] "Maximum Climb: 55 m" [:br {}] "Total Climbing: 255 m"]]]] [:div {:class "description"} [:p {} "The 10 km race, organized three days after the 5 km race, involved the same four skiers in the fight for the medals, but this time with a different outcome.\n" [:a {:href "/athletes/81101"} "Nina Baldycheva"] " had this time the unlucky fate to start as number 1, but her intermediate time at 5 km was first beaten by " [:a {:href "/athletes/82399"} "Raisa Smetanina"] " by 18 seconds. Smetanina’s arch rival from the 5 km, " [:a {:href "/athletes/81510"} "Helena Takalo"] ", this time starting 1.30  behind her Soviet opponent, could not better Smetanina at the halfway point, passing that mark 10 seconds behind her. Defending champion " [:a {:href "/athletes/81587"} "Galina Kulakova"] " starting last of the favorites, was third at 5 km, five seconds behind Takalo. But Takalo, the 5 km champion, then started her move. She gained seconds on Smetanina over the last part of the race, eagerly supported by Finnish coaches, but reached the finish just one second behind Smetanina, and had to be content with the silver medal. Kulakova finished her race 25 seconds behind Smetanina, but beat her teammate Baldycheva’s time by 14 seconds, adding a bronze to her collection of Olympic medals."] "\n\n" [:p {} "Takalo won the 5 km race by 1.04 seconds, and Smetanina the 10 km by 0.87 seconds, certainly deserving of a gold medal each. Takalo finished her great Olympic season by winning both the 5 and 10 km race at Holmenkollen, but the Soviet skiers were not present."] "\n"] [:button {:id "button603373", :class "btn btn-default"} "Details"] [:script {} "$('#button603373').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "Intermediate 1"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "18"] [:td {} [:a {:href "/athletes/82399"} "Raisa Smetanina"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-ri