923482"} "12.5 kilometres Pursuit, Men"] "\n" [:option {:value "923485"} "15 kilometres Mass Start, Men"] "\n" [:option {:value "923481"} "20 kilometres, Men"] "\n" [:option {:value "923490"} "7.5 kilometres Sprint, Women"] "\n" [:option {:value "923492"} "10 kilometres Pursuit, Women"] "\n" [:option {:value "923495"} "12.5 kilometres Mass Start, Women"] "\n" [:option {:value "923491"} "15 kilometres, Women"] "\n" [:option {:value "923496"} "4 × 6 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1518"} "1968"] "\n" [:option {:value "1523"} "1972"] "\n" [:option {:value "1528"} "1976"] "\n" [:option {:value "1534"} "1980"] "\n" [:option {:value "1540"} "1984"] "\n" [:option {:value "1546"} "1988"] "\n" [:option {:value "1552"} "1992"] "\n" [:option {:value "1563"} "1994"] "\n" [:option {:value "1575"} "1998"] "\n" [:option {:value "1588"} "2002"] "\n" [:option {:value "1603"} "2006"] "\n" [:option {:value "350026"} "2014"] "\n" [:option {:value "9000224"} "2018"] "\n" [:option {:value "19019634"} "2022"] "\n" [:option {:value "15000034"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/132"} "Event type"]] [:h1 {:class "event_title"} "4 × 7.5 kilometres Relay, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "26 February 2010 — 11:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/181"} "Whistler Olympic Park, Whistler"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/923486"} "76 from 19 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Eight shots for each group of five targets. Penalty loop (150 metres) skied for each missed target."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 7,813 m" [:br {}] "Height Differential: 27 m" [:br {}] "Maximum Climb: 25 m" [:br {}] "Shooting 1: Prone at 2.5 km, 50 m range" [:br {}] "Shooting 2: Standing at 5.0 km, 50 m range" [:br {}] "Total Climbing: 252 m"]]]] [:div {:class "description"} [:p {} "Russia were the early leaders after the first leg, although many of the other teams were close behind. However by the end of the second leg, a small group – Norway, Austria, and Sweden had established a small lead ahead of the Czech Republic. It was on the third leg that " [:a {:href "/athletes/111029"} "Emil Hegle Svendsen"] " for Norway and " [:a {:href "/athletes/118518"} "Dominik Landertinger"] " for the Austrian team pulled away from the other teams and were just over 20 seconds ahead of third placed Russia. With the legendary " [:a {:href "/athletes/84154"} "Ole Einar Bjørndalen"] " on the last leg for Norway, the Scandinavians were favourites to take the gold medal they had previously won in 2002. Although Bjørndalen missed two targets, his main opponent, Austria’s anchor man " [:a {:href "/athletes/101195"} "Christoph Sumann"] ", missed four targets and fell behind after being forced to ski a penalty loop.  In the end the Norwegian team won in a time of 1-21:38.1, with Bjørndalen claiming his 6th Olympic gold medal and his 11th medal in total. " [:a {:href "/athletes/118609"} "Yevgeny Ustyugov"] " for Russia caught Sumann on the last leg, but in a sprint to the finish line, the Austrian just held on to take the silver medal from the Russians."] "\n\n" [:p {} "The Norwegian victors were a combination of youth and experience. " [:a {:href "/athletes/118590"} "Bø"] " and Svendsen were in their early twenties whilst Bjørndalen, at 36, was still four years younger than team mate " [:a {:href "/athletes/86432"} "Halvard Hanevold"] "."] "\n\n" [:p {} "The results stood until 2020 when one of the Russian silver medalists, " [:a {:href "/athletes/118609"} "Yevgeny Ustyugov"] ", was found guilty of blood doping, based on his biological passport, by the Court of Arbitration for Sport (CAS). Ustyugov appealed that decision, and the appeal dragged on for quite some time. However, in November 2024, the CAS denied his appeal, disqualifying all of Ustyugov’s results from January 2010 through the end of the 2014 season. Ustygov then appealed to the Swiss Federal Tribunal and that appeal was (finally) rejected in May 2025, which cleared the way for the IOC to re-distribute the silver and bronze medals and move all the other places up. The final decision for medal re-allocation was announced at the IOC Executive Board meeting on 19 September 2025."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Misses"] [:th {} "Extra Shots"] [:th {} "Shooting 1 Misses"] [:th {} "Shooting 1 Extra Shots"] [:th {} "Shooting 1"] [:th {} "Shooting 2 Misses"] [:th {} "Shooting 2 Extra Shots"] [:th {} "Shooting 2"] [:th {} "Exchange"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1"] [:td {} "Norway"] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "1-21:38.1"] [:td {} "0"] [:td {} "7"] [:td {} "–"] [:td {} "–"] [:td {} "– (–)"] [:td {} "–"] [:td {} "–"] [:td {} "– (–)"] [:td {} "– (–)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "Lead-Off"] [:td {:class "bib"} "1-1"] [:td {} [:a {:href "/athletes/86432"} "Halvard Hanevold"] " "] [:td {}] [:td {} "20:15.6"] [:td {} "0"] [:td {} "1"] [:td {} "0"] [:td {} "1"] [:td {} "6:52.8 (13)"] [:td {} "0"] [:td {} "0"] [:td {} "13:49.0 (5)"] [:td {} "20:15.6 (7)"] [:td {}] [:td