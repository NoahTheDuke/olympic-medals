109"} "1992"] "\n" [:option {:value "64801"} "1996"] "\n" [:option {:value "65470"} "2000"] "\n" [:option {:value "66143"} "2004"] "\n" [:option {:value "257275"} "2008"] "\n" [:option {:value "302248"} "2012"] "\n" [:option {:value "358684"} "2016"] "\n" [:option {:value "19000482"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/73"} "Event type"]] [:h1 {:class "event_title"} "High Jump, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "7 – 10 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2157"} "Stade de France, Saint-Denis, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2013639"} "31 from 22 countries"]]]]] [:div {:class "description"} [:p {} "At Tokyo 2020, the event had ended in a gold medal tie when Qatari " [:a {:href "/athletes/124789"} "Mutaz Essa Barshim"] " and Italy’s " [:a {:href "/athletes/124447"} "Gianmarco Tamberi"] " elected not to jump off for the top two medals. Both were back for Paris 2024, with Barshim having been the dominant jumper over the last decade while Tamberi had struggled since Tokyo with injuries. He made the final but only after overcoming kidney stones from earlier in the week."] "\n\n" [:p {} "In the final, Barshim led through 2.34 as he was clear past that height, while " [:a {:href "/athletes/145775"} "Hamish Kerr"] " (NZL) and " [:a {:href "/athletes/147351"} "Shelby McEwen"] " (USA) cleared 2.34, but both had two misses at that point. Italian " [:a {:href "/athletes/2103689"} "Stefano Sottile"] " was actually in second place at 2.34, with only one miss through that height."] "\n\n" [:p {} "Barshim missed his first two attempts at 2.36 while Kerr and McEwen both cleared on their first attempt to move into the lead. Sottile missed all three efforts and Barshim passed to 2.38, but he failed to clear it."] "\n\n" [:p {} "Kerr and McEwen both had three misses at 2.38 and the Olympic high jump had another possible tie. However, the athletes elected to jump this one off. Both missed again at 2.38 and also when the bar was moved down 2.36, but Kerr would clear 2.34 after McEwen had missed it and the New Zealander took the gold medal, with Kerr winning silver and Barshim taking bronze. For Barshim, it was his fourth medal in the event, the first ever to do that, after silvers in 2012 and 2016."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1107"] [:td {} [:a {:href "/athletes/145775"} "Hamish Kerr"]] [:td {} [:a {:href "/countries/NZL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NZL.png"}] "NZL"]] [:td {} "2.27 (2)"] [:td {} "2.36 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "1332"] [:td {} [:a {:href "/athletes/147351"} "Shelby McEwen"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "2.27 (1)"] [:td {} "2.36 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "1166"] [:td {} [:a {:href "/athletes/124789"} "Mutaz Essa Barshim"]] [:td {} [:a {:href "/countries/QAT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/QAT.png"}] "QAT"]] [:td {} "2.27 (=3)"] [:td {} "2.34 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bi