lue "19000318"} "400 metres Individual Medley, Women"] "\n" [:option {:value "19000326"} "4 × 100 metres Medley Relay, Women"] "\n" [:option {:value "19000331"} "4 × 100 metres Medley Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "5914"} "1968"] "\n" [:option {:value "6233"} "1972"] "\n" [:option {:value "6533"} "1976"] "\n" [:option {:value "6797"} "1980"] "\n" [:option {:value "7022"} "1984"] "\n" [:option {:value "7337"} "1988"] "\n" [:option {:value "7692"} "1992"] "\n" [:option {:value "8044"} "1996"] "\n" [:option {:value "8424"} "2000"] "\n" [:option {:value "8826"} "2004"] "\n" [:option {:value "261558"} "2008"] "\n" [:option {:value "322057"} "2012"] "\n" [:option {:value "357065"} "2016"] "\n" [:option {:value "2001598"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/573"} "Event type"]] [:h1 {:class "event_title"} "100 metres Breaststroke, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "24 – 26 July 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2105"} "Olympic Aquatics Centre, 2-1, 2chome, Tatsumi, Koto-ku, Tatsumi-no-Mori Seaside Park, Tokyo, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19000094"} "49 from 38 countries"]]]]] [:div {:class "description"} [:p {} "There was no more prohibitive favorite in men’s swimming than Great Britain’s " [:a {:href "/athletes/134063"} "Adam Peaty"] " in the 100 breaststroke. Peaty was the defending gold medallist and had won the last three World Championships. He had set the last five world records and was the only breaststroker to have bettered 57 seconds, with his last world mark of 56.88, set at the 2019 Worlds. Prior to Tokyo he had the 16 fastest times in the event."] "\n\n" [:p {} "In the preliminary round Peaty led with a time of 57.56 but a big move was made by the Netherlands " [:a {:href "/athletes/145595"} "Arno Kamminga"] ", the 2019 European Champion, who bettered his national record of 57.90, coming second to Peaty with 57.80. Peaty and Kamminga were again 1-2 in the semi-finals, with Peaty at 57.63 and Kamminga finishing in 58.19 as Italian " [:a {:href "/athletes/144212"} "Nicolo Martinenghi"] " was third with 58.28."] "\n\n" [:p {} "The final proceeded as expected as Peaty went out ahead early and was never in danger, defending his gold medal in 57.37. Kamminga was second throughout and took the silver medal in 28.00. Martinenghi was slow at the beginning, turning only in fifth place, behind American " [:a {:href "/athletes/147473"} "Michael Andrew"] " and Belarussian " [:a {:href "/athletes/141095"} "Ilia Shymanovich"] ", but he finished the quickest of the three to take the bronze."] "\n\n" [:p {} "Peaty’s gold made him only the second Olympian to defend the men’s 100 breaststroke, after Japan’s " [:a {:href "/athletes/93574"} "Kosuke Kitajima"] " in 2004-08. Martinenghi’s bronze was only the second medal for Italy in the event, after " [:a {:href "/athletes/93557"} "Domenico Fioravanti"] "’s gold back in 2000 at Sydney. Three days after this final Kamminga would win another silver in the 200 breaststroke."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/134063"} "Adam Peaty"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.co