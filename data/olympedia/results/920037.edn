central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge"] [:td {:style "width: 400px"} [:a {:href "/athletes/921540"} "John Johansen"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge"] [:td {:style "width: 400px"} [:a {:href "/athletes/5005201"} "Eugene Savage"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge"] [:td {:style "width: 400px"} [:a {:href "/athletes/5005202"} "David Alfaro Siqueiros"]] [:td {} [:a {:href "/countries/MEX"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/MEX.png"}] "MEX"]]] [:tr {:class "referees", :style ""} [:th {} "Judge"] [:td {:style "width: 400px"} [:a {:href "/athletes/921463"} "Benjamin Brown"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]]]] [:div {:class "description"} [:p {} "The jury in the painting category consisted of " [:a {:href "/athletes/5005200"} "Reginald Poland"] " (1893-1975), San Diego; " [:a {:href "/athletes/921540"} "John Johansen"] " (1876-1964), New York; " [:a {:href "/athletes/5005201"} "Eugene Savage"] " (1883-1978), New York; " [:a {:href "/athletes/5005202"} "David Alfaro Siqueiros"] " (1896-1974), Mexico; and " [:a {:href "/athletes/921463"} "Benjamin Brown"] " (1865-1942), Pasadena. All were well known painters, sculptors, and museum directors."] "\n\n" [:p {} "The division into three areas, which had been made in " [:a {:href "/editions/9/sports/ART"} "1928"] " for the first time, was retained. These were supposed to be separated as follows: “" [:a {:href "/results/920035"} "Paintings"] " (in oil on canvas or cardboard); drawings and watercolors on paper or on the appropriate fabric, single or multi-colored; " [:a {:href "/results/920036"} "graphical art"] " (engravings, lithographs, posters)”. Once again, a connection with sport was required. A total of 322 artists took part, with 665 exhibits from 19 countries."] "\n\n" [:p {} "US artist " [:a {:href "/athletes/921454"} "Lee Blair"] " painted " [:em {} "Rodeo"] ", which won the gold medal. The silver medal was earned by his colleague " [:a {:href "/athletes/921482"} "Percy Crosby"] ", a sports columnist and illustrator for the " [:em {} "New York Globe"] ", for " [:em {} "Jackknife"] ". He also entered the arts competitions in " [:a {:href "/editions/11/sports/ART"} "1936"] ". The bronze medal went to Dutch painter " [:a {:href "/athletes/921150"} "Gerard Westermann"] ", who also participated in 1936, for " [:em {} "Horseman"] "."] "\n\n" [:p {} "Four artists received honorable mention for their works. Among them was " [:a {:href "/athletes/921456"} "Acee Blue Eagle"] ", a well known Pawnee Indian who was an artist, educator, dancer, and flute player. It is also not known how the works were evaluated. Some works are referred to as “hors concours” in the " [:strong {} "Official Report"] ", and there is no further explanation for this category."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Catalogue Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Translated Title"] [:th {} "Original Title"] [:th {} "Title in Olympic Report or Catalogue"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "734"] [:td {} [:a {:href "/athletes/921454"} "Lee Blair"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:t