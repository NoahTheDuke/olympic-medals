51"} "20 kilometres, Men"] "\n" [:option {:value "1552"} "4 × 7.5 kilometres Relay, Men"] "\n" [:option {:value "1556"} "7.5 kilometres Sprint, Women"] "\n" [:option {:value "1557"} "15 kilometres, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:span {} "Not held in other editions"]] " | " [:a {:href "/event_names/137"} "Event type"]] [:h1 {:class "event_title"} "3 × 7.5 kilometres Relay, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "14 February 1992 — 10:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/11"} "Les Saisies"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1558"} "48 from 16 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Eight shots for each group of five targets. Penalty loop (150 metres) skied for each missed target."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 7,350 m" [:br {}] "Height Differential: 57 m" [:br {}] "Maximum Climb: 39 m" [:br {}] "Shooting 1: Prone at 2.5 km, 50 m range" [:br {}] "Shooting 2: Standing at 5.0 km, 50 m range" [:br {}] "Total Climbing: 279 m"]]]] [:div {:class "description"} [:p {} "Since women first competed at the biathlon World Championships in 1984, the relay had always been won the Soviet team. Norway and Sweden had usually fought out the other medals, although Finland had won two medals, and Czechoslovakia, Bulgaria, Germany and the United States had won one medal each. The Unified Team was favored in the absence of the defunct Soviet Union. But on the first leg, France took the lead, shooting cleanly, while both " [:a {:href "/athletes/80629"} "Yelena Belova"] " (EUN) and " [:a {:href "/athletes/80953"} "Uschi Disl"] " (GER) missed a target, dropping their teams to third and fourth respectively, also trailing Bulgaria. France was unknown in women’s biathlon prior to the 1991-92 season but they had won the last World Cup race prior to the Albertville Games. " [:a {:href "/athletes/82183"} "Anfisa Reztsova"] " put the Unified Team ahead after the second leg, followed by Germany and France, as the world order was restored. But the final leg brought a shocker, as " [:a {:href "/athletes/80728"} "Anne Briand-Bouthiaux"] " had the fastest leg by over 45 seconds to bring France a surprising gold medal. This was especially surprising as one of France’s best biathletes, " [:a {:href "/athletes/80761"} "Delphine Heymann-Burlet"] ", had to miss the event because of illness. Germany’s " [:a {:href "/athletes/82329"} "Petra Schaaf"] " moved her team up to second, with the Unified team winning the bronze medal."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Misses"] [:th {} "Extra Shots"] [:th {} "Shooting 1 Misses"] [:th {} "Shooting 1 Extra Shots"] [:th {} "Shooting 1"] [:th {} "Shooting 2 Misses"] [:th {} "Shooting 2 Extra Shots"] [:th {} "Shooting 2"] [:th {} "Exchange"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "France"] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "1-15:55.6"] [:td {} "0"] [:td {} "–"] [:td {} "–"] [:td {} "–"] [:td {} "– (–)"] [:td {} "–"] [:td {} "–"] [:td {} "– (–)"] [:td {} "– (–)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "Lead-Off"] [:td {} [:a {:href "/athletes/81940"} "Corinne Niogret"] " "] [:td {}] [:td {} "25:54.7"] [:td {} "0"] [:td {} "–"] [:td {} "0"] [:td {} "–"] [:td {} "– (–)"] [:td {} "0"] [:td {} "–"] [:td {} "– (–)"] [:td {} "25:54.7 (1)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2nd Leg"] [:td {} [:a {:hre