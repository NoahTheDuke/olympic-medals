"354299"} "Featherweight (≤62 kg), Men"] "\n" [:option {:value "354308"} "Lightweight (≤69 kg), Men"] "\n" [:option {:value "354317"} "Middleweight (≤77 kg), Men"] "\n" [:option {:value "354326"} "Light-Heavyweight (≤85 kg), Men"] "\n" [:option {:value "354335"} "Middle-Heavyweight (≤94 kg), Men"] "\n" [:option {:value "354344"} "Heavyweight (≤105 kg), Men"] "\n" [:option {:value "354353"} "Super-Heavyweight (&gt;105 kg), Men"] "\n" [:option {:value "354371"} "Featherweight (≤53 kg), Women"] "\n" [:option {:value "354380"} "Lightweight (≤58 kg), Women"] "\n" [:option {:value "354389"} "Middleweight (≤63 kg), Women"] "\n" [:option {:value "354398"} "Light-Heavyweight (≤69 kg), Women"] "\n" [:option {:value "354407"} "Heavyweight (≤75 kg), Women"] "\n" [:option {:value "354416"} "Super-Heavyweight (&gt;75 kg), Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "30233"} "2000"] "\n" [:option {:value "30368"} "2004"] "\n" [:option {:value "263069"} "2008"] "\n" [:option {:value "331000"} "2012"] "\n" [:option {:value "19002083"} "2020"] "\n" [:option {:value "2013245"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/647"} "Event type"]] [:h1 {:class "event_title"} "Flyweight (≤48 kg), Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 6 August 2016 — 19:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/924"} "Riocentro Pavilhão 2, Parque Olímpico da Barra, Barra da Tijuca, Rio de Janeiro"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/354362"} "12 from 12 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Total of best lifts in snatch and clean &amp; jerk determined placement.  Ties broken by lightest bodyweight."]]]] [:div {:class "description"} [:p {} "China had not lost an Olympic Games or World Championship in the women’s flyweight division since 2010 and held the records for total lift at both levels. Its entrant Hou Zhihui, however, was injured and unable to compete at the 2016 Games, while Turkey’s " [:a {:href "/athletes/111870"} "Sibel Özkan"] ", the reigning European champion over the past two years, failed to appear in Rio after having her 2008 Olympic silver medal revoked for failing a doping test. Moreover, " [:a {:href "/athletes/111879"} "Genny Pagliaro"] " of Italy, the 2013 and 2014 European champion, 2016 runner-up, and 2015 bronze medalist, was passed over in favor of younger weightlifters in other divisions for Italy’s weightlifting quota places, leaving the gold medal up for grabs. Vietnam’s " [:a {:href "/athletes/132235"} "Vương Thị Huyền"] " and Japan’s " [:a {:href "/athletes/103524"} "Hiromi Miyake"] " were the reigning World silver and bronze medalists and the only recent World or European medalists in the 48 kg to participate in Rio. Miyake was also the runner-up in 2012 and was taking part in her fourth edition of the Olympics."] "\n\n" [:p {} "In the snatch portion of the event, Vương failed to lift 83 kg in her first attempt, then 84 kg in her next two, and was therefore eliminated from contention. Miyake lifted 81 kg on her final try, but this left her well behind in a pack led by " [:a {:href "/athletes/131837"} "Sopita Tanasan"] " of Thailand, who lifted 92 kg, 7 ahead of her nearest competitors, " [:a {:href "/athletes/130535"} "Sri Wahyuni Agustiani"] " of Indonesia and " [:a {:href "/athletes/125071"} "Beatriz Pirón"] " of the Dominican Republic. Tanasan had been competing in the flyweight for less than year, having previously been a featherweight competitor and a silver medalist in that category at the 2013 World Championships. She went on to win the clean and jerk portion of the event with a 108 kg lift, and her margin of victory in the snatch meant that she faced no serious challengers for the gold medal. Agustiani and Miyake both lifted 107 kg, giving them bronze and silver respectively after Pirón managed only 102 kg. Pirón’s fourth-place finish, however, was still her nation’s best-ever Olympic result in the sport."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Kilograms"] [:th {} "Bodyweight"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/131837"} "Sopita Tanasan"]] [:td {} [:a {:href "/countries/THA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/THA.png"}] "THA"]] [:td {} "200"] [:td {} "47.91"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/130535"} "Sri Wahyuni Agustiani"]] [:td {} [:a {:href "/countries/INA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/INA.png"}] "INA"]] [:td {} "192"] [:td {} "47.25"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/103524"} "Hiromi Miyake"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]] [:td {} "188"] [:td {} "47.95"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/125071"} "Beatriz Pirón"]] [:td {} [:a {:href "/countries/DOM"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/DOM.