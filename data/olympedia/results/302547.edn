4"} "High Jump, Women"] "\n" [:option {:value "302198"} "Pole Vault, Women"] "\n" [:option {:value "9031008"} "Long Jump, Women"] "\n" [:option {:value "9031022"} "Triple Jump, Women"] "\n" [:option {:value "302181"} "Shot Put, Women"] "\n" [:option {:value "302021"} "Discus Throw, Women"] "\n" [:option {:value "302480"} "Hammer Throw, Women"] "\n" [:option {:value "302463"} "Javelin Throw, Women"] "\n" [:option {:value "302147"} "Heptathlon, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "57897"} "1928"] "\n" [:option {:value "58127"} "1932"] "\n" [:option {:value "58452"} "1936"] "\n" [:option {:value "58806"} "1948"] "\n" [:option {:value "59185"} "1952"] "\n" [:option {:value "59546"} "1956"] "\n" [:option {:value "60001"} "1960"] "\n" [:option {:value "60417"} "1964"] "\n" [:option {:value "60914"} "1968"] "\n" [:option {:value "61479"} "1972"] "\n" [:option {:value "62046"} "1976"] "\n" [:option {:value "62529"} "1980"] "\n" [:option {:value "63118"} "1984"] "\n" [:option {:value "63790"} "1988"] "\n" [:option {:value "64466"} "1992"] "\n" [:option {:value "65143"} "1996"] "\n" [:option {:value "65800"} "2000"] "\n" [:option {:value "66513"} "2004"] "\n" [:option {:value "257660"} "2008"] "\n" [:option {:value "359099"} "2016"] "\n" [:option {:value "19000773"} "2020"] "\n" [:option {:value "2013943"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/107"} "Event type"]] [:h1 {:class "event_title"} "4 × 100 metres Relay, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "9 – 10 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/874"} "Olympic Stadium, Olympic Park, Stratford, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/302547"} "69 from 16 countries"]]]]] [:div {:class "description"} [:p {} "The event was expected to come down to Jamaica against the United States, with the USA a slight favorite, led by 100 runner-up " [:a {:href "/athletes/126627"} "Carmelita Jeter"] ", and 4th/5th place in that event of " [:a {:href "/athletes/126527"} "Tianna Madison"] " and " [:a {:href "/athletes/105293"} "Allyson Felix"] ". But Jamaica could counter with the 100 winner, " [:a {:href "/athletes/114740"} "Shelly-Ann Fraser-Pryce"] ", and bronze medalist " [:a {:href "/athletes/87116"} "Veronica Campbell-Brown"] ". Nobody else was given a chance for gold as long as they got the stick around, something they had not done at Beijing, when the United States did not make the final, and Jamaica did not finish the final."] "\n\n" [:p {} "Fraser-Pryce opened for Jamaica and made up a bit of the stagger on Madison around the curve, but on the backstretch, Felix exploded away from " [:a {:href "/athletes/104904"} "Sherone Simpson"] ", putting the American team into a lead they would not surrender. " [:a {:href "/athletes/126533"} "Bianca Knight"] " ran the final curve for the USA, and Campbell-Brown did make up a small amount on that turn, although Jeter still got the baton with a 2-metre lead. Running against " [:a {:href "/athletes/114765"} "Kerron Stewart"] ", Jeter poured it on, extending the lead to 0.59 seconds at the line as the USA finished in 40.82, shattering the old world record of 41.37 that had been set by an East German squad, way back in 1985. It was one of the three oldest world records on the books for women, after Czechoslovakian " [:a {:href "/athletes/76554"} "Jarmila Kratochvilová"] "’s 800 metre mark, set in 1983, and East German " [:a {:href "/athletes/69683"} "Marita Koch"] "’s 400 mark, set on the same day as the 4×100 record. Jamaica’s silver medal was done in 41.41, the third fastest mark ever, and even Ukraine, in third, posted the eighth fastest national mark ever."] "\n\n" [:p {} "The gold medal gave Jeter a rare complete set of medals from London, as she had won silver in the 100 and bronze in the 200. Felix would return the next day and run on the winning 4×400 relay team, giving her three gold medals in London, along with her individual 200 title."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "41.64 (1 h1)"] [:td {} "40.82 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "10"} [:a {:href "/athletes/126527"} "Tianna Madison"] " • " [:a {:href "/athletes/105293"} "Allyson Felix"] " • " [:a {:href "/athletes/126533"} "Bianca Knight"] " • " [:a {:href "/athletes/126627"} "Carmelita Jeter"] " • " [:a {:href "/athletes/126526"} "Jeneba Tarmoh"] " • " [:a {:href "/athletes/104900"} "Lauryn Williams"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} "Jamaica"] [:td {} [:a {:href "/countries/JAM"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JAM.png"}] "JAM"]] [:td {} "42.37 (2 h2)"] [:td {} "41.41 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "10"} [:a {:href "/athletes/114740"} "Shelly-Ann Fraser-Pryce"] " • " [:a {:href "/athletes/104904"} "Sherone Simpson"] " • " [:a {:href "/athletes/87116