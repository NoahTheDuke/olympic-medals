alue "2184"} "1924"] "\n" [:option {:value "2194"} "1932"] "\n" [:option {:value "2199"} "1936"] "\n" [:option {:value "2204"} "1948"] "\n" [:option {:value "2210"} "1952"] "\n" [:option {:value "2217"} "1956"] "\n" [:option {:value "2224"} "1960"] "\n" [:option {:value "2231"} "1964"] "\n" [:option {:value "2238"} "1968"] "\n" [:option {:value "2245"} "1972"] "\n" [:option {:value "2252"} "1976"] "\n" [:option {:value "2259"} "1980"] "\n" [:option {:value "2266"} "1984"] "\n" [:option {:value "2273"} "1988"] "\n" [:option {:value "2287"} "1992"] "\n" [:option {:value "2301"} "1994"] "\n" [:option {:value "2311"} "1998"] "\n" [:option {:value "2321"} "2002"] "\n" [:option {:value "2334"} "2006"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/368"} "Event type"]] [:h1 {:class "event_title"} "Individual, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "17 – 18 February 1928"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/153"} "Skistadion, St. Moritz"] " / " [:a {:href "/venues/154"} "Olympiaschanze, St. Moritz"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2189"} "35 from 14 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Normal hill ski jumping and 18 kilometres skiing; placements determined by points table."]]]] [:div {:class "description"} [:p {} "The time from the " [:a {:href "/results/1891"} "18 k. race"] " was used for the cross-country section of the Nordic Combined. So, the Olympic Champion in that race, " [:a {:href "/athletes/86270"} "Johan Grøttumsbraaten"] ", had a commanding lead, almost five minutes ahead of countryman " [:a {:href "/athletes/98658"} "Hans Vinjarengen"] ", who had a lead of 4.51 on the best non-Norwegian, the Finn " [:a {:href "/athletes/87700"} "Esko Järvinen"] ". The two other Norwegians, jumping specialists " [:a {:href "/athletes/88126"} "Ole Kolterud"] " and " [:a {:href "/athletes/97661"} "John Snersrud"] ", were 7th and 9th in the cross country event, and the Norwegians had hopes for another 1-4 finish as in " [:a {:href "/results/2184"} "Chamonix"] "."] "\n\n" [:p {} "The jumping event was a formality for Grøttumsbraaten, and he secured his second gold medal in two days, placing 8th in the ski jumping. Vinjarengen, normally an excellent jumper, fell on his first jump. However, due to his fast 18 km time and a good second jump, he was able to secure the silver medal. Snersrud advanced to bronze after coming 3rd in the jumping event. The fourth Norwegian, Ole Kolterud, was leading the jumping event after the first round, but a fall in the second round after the longest jump in the competition (65.5 m) brought him down to 8th place in the overall standings and prevented Norway from sweeping the first four places."] "\n\n" [:p {} "The Czechoslovak " [:a {:href "/athletes/84486"} "Rudolf Burkert"] " was the winner of the jumping event (with the longest jump standing in the competition of 62.5 m), ahead of Italian " [:a {:href "/athletes/98608"} "Vitale Venzi"] ", but both were too weak in the cross country event and ended as 12th and 20th in the final standings. Burkert won the World Championship title in Nordic Combined in Cortina, Italy, in 1927, but with no Norwegians or Finns taking part."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Cross Country Skiing, 18 km"] [:th {} "Ski Jumping, Normal Hill"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/86270"} "Johan Grøttumsbraaten"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "17.833"] [:td {} "1-37:01 (1)"] [:td {} "1