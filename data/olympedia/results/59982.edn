 {:value "60398"} "1964"] "\n" [:option {:value "60893"} "1968"] "\n" [:option {:value "61448"} "1972"] "\n" [:option {:value "62014"} "1976"] "\n" [:option {:value "62505"} "1980"] "\n" [:option {:value "63076"} "1984"] "\n" [:option {:value "63738"} "1988"] "\n" [:option {:value "64408"} "1992"] "\n" [:option {:value "65083"} "1996"] "\n" [:option {:value "65741"} "2000"] "\n" [:option {:value "66461"} "2004"] "\n" [:option {:value "257606"} "2008"] "\n" [:option {:value "302378"} "2012"] "\n" [:option {:value "359036"} "2016"] "\n" [:option {:value "19000711"} "2020"] "\n" [:option {:value "2013868"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/98"} "Event type"]] [:h1 {:class "event_title"} "800 metres, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "6 –  7 September 1960"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/414"} "Stadio Olimpico, Roma"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/59982"} "27 from 15 countries"]]]]] [:div {:class "description"} [:p {} "After 32 years, women were once again allowed to compete over 800 metres at the Olympics. At the European Championships, the women ran 800 in both 1954 and 1958, both titles won by Soviet women. With an absence of races to choose from, no real favorite existed in 1960, but the Soviets were expected to be strong. The last five world records had been set by Soviet women, with " [:a {:href "/athletes/77249"} "Liudmyla Lysenko"] " breaking the mark in July 1960. In the heats, " [:a {:href "/athletes/64586"} "Dixie Willis"] " (AUS) had the fastest time with 2:05.9. She led the final as well, from the start until the final homestraight. But she stumbled on the curb and pulled off the track with only 50-70 metres remaining. The finish was close between Lysenko and Australia’s " [:a {:href "/athletes/64533"} "Brenda Jones"] ", but Lysenko prevailed, equaling her world record in the process."] "\n\n" [:p {} "Willis would return in 1962 to win the Commonwealth Games title. Her official status in the 1960 800 metres has been listed in various ways, none of which appear to be correct. She is listed in the Official Report as “Scratched” but she definitely ran. Other sources list her as did not finish. In fact, a YouTube video shows the race, and she actually finished the race, in approximately 2:27, as, after stepping off the track, she came back on and jogged across the finish line. This has been investigated by discussions with Willis who states that after being clipped by another runner, she stepped off the curb onto the infield and stopped briefly, but did, in fact, finish the race and was never informed of any disqualification."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "163"] [:td {} [:a {:href "/athletes/77249"} "Lyudmila Lysenko"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "2:09.2 (1 h3)"] [:td {} "2:04.3 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "6"] [:td {} [:a {:href "/athletes/64533"} "Brenda Jones"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]] [:td {} "2:11.0 (2 h1)"] [:td {} "2:04.4 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "80"] [:td {} [:a {:href "/athletes/69648"} "Ulla D