/venues/14"} "Olympic Oval, Calgary"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1067"} "38 from 18 countries"]]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/1049"} "7:02.29"] " / " [:a {:href "/athletes/86551"} "Eric Heiden"] " " [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"] " / 16 February 1980 / " [:a {:href "/records/event_name/533"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"}] [:td {} [:a {:href "/countries/UNK"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UNK.png"}] "UNK"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"}] [:td {} [:a {:href "/countries/UNK"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UNK.png"}] "UNK"]]]]] [:div {:class "description"} [:p {} "Two men had dominated this distance during the 1987-1988 season. " [:a {:href "/athletes/87796"} "Geir Karlstad"] " had won the first three World Cup races of the season. At the Heerenveen World Cup, he had improved the world record to 6:45.44, only to beat that time again at the Calgary World Cup: 6:43.59. But Karlstad had faded since, his role taken over by " [:a {:href "/athletes/86323"} "Tomas Gustafson"] ". The defending Olympic champion had won the remaining two World Cups, and had become European Allround Champion in Den Haag prior to the Games. A third title contender was " [:a {:href "/athletes/98668"} "Leo Visser"] ". He had broken the world record at the 1987 World Championships, and had been shared winner with Gustafson at the Davos World Cup."] "\n\n" [:p {} "The first of the favorites to skate, Visser rode a very steady race, finishing with 6:44.98. Karlstad then departed ambitiously, beating Visser’s splits by two seconds in the early laps. But the Norwegian was unable to keep the pace. He was eventually passed by his opponent, " [:a {:href "/athletes/86361"} "Michael Hadschieff"] ", and finished seventh. Visser’s teammate, " [:a {:href "/athletes/87871"} "Gerard Kemkers"] ", also started faster in the first half of the race, but did not fade like Karlstad, and finished only one second behind the leading time. In the ninth pair, Gustafson was the last medal contender to skate. He trailed Visser’s time for the entire race, and with one lap to go, Gustafson was 0.87 behind Visser, and even slightly behind Kemkers. But the Swede delivered an incredible final lap with 31.86 seconds (compared to Visser’s 33.08), and he moved up from bronze medal position to gold. This made Gustafson the first repeat winner of the event since " [:a {:href "/athletes/83820"} "Ivar Ballangrud"] " won it in 1928 and 1936."] "\n"] [:button {:id "button126458", :class "btn btn-default"} "Details"] [:script {} "$('#button126458').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "200 m"] [:th {:style "display: none", :class "split"} "600 m"] [:th {:style "display: none", :class "split"} "1000 m"] [:th {:style "display: none", :class "split"} "1400 m"] [:th {:style "display: none", :class "split"} "1800 m"] [:th {:style "display: none", :class "split"} "2200 m"] [:th {:style "display: none", :class "split"} "2600 m"] [:th {:style "display: none", :class "split"} "3000 m"] [:th {:style "display: none", :class "split"} "3400 m"] [:th {:style "display: none", :class "split"} "3800 m"] [:th {:style "display: none", :class "split"} "4200 m"] [:th {:style "display: none", :class "split"} "4600 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:cl