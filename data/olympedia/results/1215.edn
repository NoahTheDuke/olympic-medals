s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Gates: 56" [:br {}] "Length: 1828 m" [:br {}] "Start Altitude: 2447 m" [:br {}] "Vertical Drop: 553 m"]]]] [:div {:class "description"} [:p {} "After snow postponed the downhill, the giant slalom was the first men’s Alpine event of the 1960 Winter Olympics. The third skier down KT-22 was Austrian " [:a {:href "/athletes/97851"} "Josef “Pepi” Stiegler"] ", who took the lead with a time of 1:48.7, but the time was first announced as 1:48.1. Switzerland’s " [:a {:href "/athletes/97777"} "Roger Staub"] " was the sixth starter, his time of 1:48.3 seemingly placing him second at the time. But 18 minutes after his run ended, Stiegler’s time was corrected to 1:48.7 and Staub was in the lead, his time holding up for the gold medal. Staub had won two medals at the 1958 World Championships, with a silver in the downhill behind " [:a {:href "/athletes/97080"} "Toni Sailer"] ", and a bronze in the combined, but Staub tragically died in 1974 in a hang gliding accident. Stiegler won the silver medal, coming back in 1964 to win bronze in this event and winning a gold medal in the 1964 slalom. He would later settle in the United States at Jackson Hole, Wyoming, and his daughter, " [:a {:href "/athletes/110677"} "Resi Stiegler"] ", would ski in the Olympics for the US. Pepi Stiegler was later afflicted with multiple sclerosis."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "6"] [:td {} [:a {:href "/athletes/97777"} "Roger Staub"]] [:td {} [:a {:href "/countries/SUI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SUI.png"}] "SUI"]] [:td {} "1:48.3"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr 