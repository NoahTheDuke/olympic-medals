alue "256033"} "Canadian Singles, Slalom, Men"] "\n" [:option {:value "256036"} "Canadian Doubles, Slalom, Men"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255438"} "1972"] "\n" [:option {:value "256201"} "1996"] "\n" [:option {:value "256310"} "2000"] "\n" [:option {:value "256430"} "2004"] "\n" [:option {:value "258863"} "2008"] "\n" [:option {:value "307020"} "2012"] "\n" [:option {:value "353600"} "2016"] "\n" [:option {:value "19006326"} "2020"] "\n" [:option {:value "2008437"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/181"} "Event type"]] [:h1 {:class "event_title"} "Kayak Singles, Slalom, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 1 August 1992 — 9:01"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/675"} "Parque Olímpico del Segre, Seo de Urgel"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/256065"} "26 from 13 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Two runs, best score of two to count."]]]] [:div {:class "description"} [:p {} "The Olympic program had experimented with canoe slalom events in 1972, but they did not become a permanent fixture until the 1992 Summer Games. France’s " [:a {:href ""} "Myriam Jerusalmi"] " and Germany’s " [:a {:href "/athletes/9870"} "Elisabeth Micheler"] " had won the women’s K-1 at the 1989 and 1991 World Championships respectively, and were second and fourteenth after the first run. America’s " [:a {:href "/athletes/11029"} "Dana Chladek"] ", runner-up at both tournaments, posted a significantly higher score than Micheler, while Micheler’s compatriot " [:a {:href "/athletes/9883"} "Kordula Striepecke"] ", the 1991 World bronze medalist, was third. Micheler struck back in the second round, however, and had a great run that put her in the gold medal position. Chladek had no response to this, finishing 22nd, and settled for bronze after Australia’s " [:a {:href "/athletes/8991"} "Danielle Woodward"] ", who had been 15th after the first run, managed to leap into second-place. Striepecke and Jerusalmi improved their times somewhat in the second portion, but not sufficiently to avoid slipping down to 6th and 21st respectively in the final rankings."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Total Time"] [:th {} "Run #1"] [:th {} "Run #2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "124"] [:td {} [:a {:href "/athletes/9870"} "Elisabeth Micheler"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "126.41"] [:td {} "136.19 (2)"] [:td {} "126.41 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "101"] [:td {} [:a {:href "/athletes/8991"} "Danielle Woodward"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]] [:td {} "128.27"] [:td {} "151.54 (15)"] [:td {} "128.27 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "121"] [:td {} [:a {:href "/athletes/11029"} "Dana Chladek"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amaz