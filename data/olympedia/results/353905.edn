/athletes/5003541"} "Masaaki Ito"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]]] [:tr {:class "referees", :style ""} [:th {} "Execution Judge 3"] [:td {:style "width: 400px"} [:a {:href "/athletes/5001194"} "Anatoliy Holovan"]] [:td {} [:a {:href "/countries/UKR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UKR.png"}] "UKR"]]] [:tr {:class "referees", :style ""} [:th {} "Execution Judge 4"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003791"} "Nikolaos Touloudis"]] [:td {} [:a {:href "/countries/GRE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GRE.png"}] "GRE"]]] [:tr {:class "referees", :style ""} [:th {} "Execution Judge 5"] [:td {:style "width: 400px"} [:a {:href "/athletes/5001679"} "Cristina Ríos"]] [:td {} [:a {:href "/countries/COL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/COL.png"}] "COL"]]] [:tr {:class "referees", :style ""} [:th {} "Execution Judge 6"] [:td {:style "width: 400px"} [:a {:href "/athletes/5001303"} "Arne Tellefsen"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronization Judge 1"] [:td {:style "width: 400px"} [:a {:href "/athletes/46230"} "Rolando Ruiz"]] [:td {} [:a {:href "/countries/CUB"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CUB.png"}] "CUB"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronization Judge 2"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004892"} "William Lee"]] [:td {} [:a {:href "/countries/SGP"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SGP.png"}] "SGP"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronization Judge 3"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003669"} "Mohamed Hassan"]] [:td {} [:a {:href "/countries/EGY"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/EGY.png"}] "EGY"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronization Judge 4"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003404"} "Marco Polazzo"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronization Judge 5"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004432"} "Simon Latimer"]] [:td {} [:a {:href "/countries/NZL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NZL.png"}] "NZL"]]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/116031"} "Chen Ruolin"] " won the Olympic title in 2008 and 2012 with different partners and was hoping to make it a unique treble by winning it with yet another partner, " [:a {:href "/athletes/129586"} "Liu Huixia"] ", the 2014 FINA Female Diver of the Year. They teamed up after the 2012 London Olympics and had won all 17 events they subsequently entered, including the 2013 and 2015 World Championship and the World Cup in 2014 and 2016. Any threat to China’s domination of this event, which has seen them win all four Olympic golds since it was first held in 2000, was probably going to come from the strong Canadian duo of " [:a {:href "/athletes/116038"} "Meaghan Benfeito"] " and " [:a {:href "/athletes/116039"} "Roseline Filion"] ", bronze medalists in London 2012 and silver medalists behind Huixia and Ruolin in the Worlds in both 2013 and 2015. This was their third Olympics together."] "\n\n" [:p {} "True to form, and like their male counterparts the night before, the Chinese pair led from start to finish to win gold, but one thing was different from the men’s win - the girls were diving into green water! Mysteriously the colour of the water changed from clear blue to green overnight and as the competition progressed it got darker and murkier, but it did not put the competitors off and the event was not disrupted."] "\n\n" [:p {} "The threat to the Chinese did indeed come from the Canadian pair, and also the Malaysia duo of " [:a {:href "/athletes/125973"} "Cheong Jun Hoong"] " and " [:a {:href "/athletes/116060"} "Pandela Rinong"] ", who tied second place with the Canadians after the first two rounds and then pulled away on their own after round three when the North Koreans " [:a {:href "/athletes/131439"} "Kim Kuk-Hyang"] " and " [:a {:href "/athletes/131440"} "Kim Mi-Rae"] " dived into the bronze medal position with the best dive of the round. Going into the final round Great Britain had moved up to fourth place ahead of the Canadians after their best dive, but it all changed in the final round. The Chinese pair saved their best dive for last, scoring 87.36 and guaranteeing first place, while the Malyasian duo also had their best dive of the night to get silver, and Malaysia’s first of the Games. It was also a second medal for Pandelela Rinong to add to the individual bronze she won in the 10-metre platform event in 2012. The bronze was still to be won and poor 60+ point dives by the Korean and British girls allowed the Canadians to leapfrog them into third place with a score of 80.64 on their final dive."] "\n\n" [:p {} "For China it was continued domination of the event and, in all synchronised women’s events, they had won nine of the 10 golds since inception in 2000. For Chen Roulin it was a personal milestone as she became only the second diver