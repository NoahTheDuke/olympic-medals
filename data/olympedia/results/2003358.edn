tps://olympedia-flags.s3.eu-central-1.amazonaws.com/BRA.png"}] "BRA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge 5"] [:td {:style "width: 400px"} [:a {:href "/athletes/2000847"} " Jess"]] [:td {} [:a {:href "/countries/ESP"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ESP.png"}] "ESP"]]] [:tr {:class "referees", :style ""} [:th {} "Judge 6"] [:td {:style "width: 400px"} [:a {:href "/athletes/2000848"} " Kowloon"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]]] [:tr {:class "referees", :style ""} [:th {} "Judge 7"] [:td {:style "width: 400px"} [:a {:href "/athletes/2000849"} " Virus"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]]] [:tr {:class "referees", :style ""} [:th {} "Judge 8"] [:td {:style "width: 400px"} [:a {:href "/athletes/2000850"} " Dom:k"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge 9"] [:td {:style "width: 400px"} [:a {:href "/athletes/2000851"} " Intact"]] [:td {} [:a {:href "/countries/UKR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UKR.png"}] "UKR"]]]]] [:div {:class "description"} [:p {} "Among B-girls, the top favorites included Lithuania’s " [:a {:href "/athletes/150991"} "Nicka"] " (Dominika Banevic – 2023 World Champion), Japan’s " [:a {:href "/athletes/150986"} "Ami"] " (Ami Yuasa – 2019 and 2022 World Champion, and Red Bull BC One winner in 2018 and 2023), and the Netherlands’ " [:a {:href "/athletes/150994"} "India"] " (Dewi Sardjoe – 2022 European Champion and Red Bull BC One)."] "\n\n" [:p {} "Sixteen B-girls started the competition, split into four round-robin groups. The three favorites advanced to the quarter-finals and won their battles in that round, joined by China’s " [:a {:href "/athletes/150978"} "671"] " (Liu Qingyi) in the semi-finals."] "\n\n" [:p {} "Both semi-final battles were closely contested, with Ami and Nicka winning 2-1 over India and 671, respectively. The gold medal went to Ami, who defeated Nicka, 3-0, winning all three rounds and outpointing Nicka, 16-11. Bronze went to 671, who won the first two battles against India, and built up a huge lead, although India won the final battle."] "\n\n" [:p {} "There was some controversy with the presence of Australian B-girl " [:a {:href "/athletes/150975"} "Raygun"] " (Rachael Gunn). Competing in Group B, she lost all three of her battles, 2-0 and 18-0 in points, scoring zero points in the competition. She was later mocked on social media for not being of Olympic caliber."] "\n\n" [:p {} "In early September, further controversy arose when the World Dance Sport Federation (WDSF) announced their breaking world rankings and Raygun was surprisingly ranked #1 in the world. The WDSF noted that the rankings were based mostly on early qualifying events, going back into 2023, and the Olympics did not count towards the rankings, but this did not reflect well on the federation’s rankings."] "\n\n" [:p {} "Further controversy occurred during the competition when " [:a {:href "/athletes/150981"} "Talash"] " was disqualified for displaying the slogan “Free Afghan Women” on her tabard during her defeat against India from the Netherlands, violating IOC policy against making political statements during the Games."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Seed"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "3"] [:td {