"\n" [:option {:value "353461"} "Kayak Singles, 1,000 metres, Men"] "\n" [:option {:value "353472"} "Kayak Doubles, 200 metres, Men"] "\n" [:option {:value "353482"} "Kayak Doubles, 1,000 metres, Men"] "\n" [:option {:value "353492"} "Kayak Fours, 1,000 metres, Men"] "\n" [:option {:value "353508"} "Canadian Singles, 200 metres, Men"] "\n" [:option {:value "353521"} "Canadian Singles, 1,000 metres, Men"] "\n" [:option {:value "353554"} "Kayak Singles, 200 metres, Women"] "\n" [:option {:value "353567"} "Kayak Singles, 500 metres, Women"] "\n" [:option {:value "353580"} "Kayak Doubles, 500 metres, Women"] "\n" [:option {:value "353590"} "Kayak Fours, 500 metres, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255017"} "1936"] "\n" [:option {:value "255043"} "1948"] "\n" [:option {:value "255074"} "1952"] "\n" [:option {:value "255107"} "1956"] "\n" [:option {:value "255203"} "1960"] "\n" [:option {:value "255270"} "1964"] "\n" [:option {:value "255334"} "1968"] "\n" [:option {:value "255399"} "1972"] "\n" [:option {:value "255545"} "1976"] "\n" [:option {:value "255657"} "1980"] "\n" [:option {:value "255763"} "1984"] "\n" [:option {:value "255886"} "1988"] "\n" [:option {:value "256022"} "1992"] "\n" [:option {:value "256152"} "1996"] "\n" [:option {:value "256265"} "2000"] "\n" [:option {:value "256382"} "2004"] "\n" [:option {:value "258809"} "2008"] "\n" [:option {:value "307107"} "2012"] "\n" [:option {:value "19016188"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/172"} "Event type"]] [:h1 {:class "event_title"} "Canadian Doubles, 1,000 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "19 – 20 August 2016"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/912"} "Estádio da Lagoa, Lagoa Rodrigo de Freitas, Rio de Janeiro"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/353532"} "22 from 11 countries"]]]]] [:div {:class "description"} [:p {} "The Men’s C-2 1000 was a difficult race to call, as there were several viable challengers for gold. Defending Olympic Champion Germany entered " [:a {:href "/athletes/134140"} "Jan Vandrey"] " and " [:a {:href "/athletes/125320"} "Sebastian Brendel"] ", the latter of whom had already defended his Olympic title in the C-1 1000 and thus gave his nation a fair shot at the top of the podium, despite Germany’s struggles in other tournaments (its only recent medals were bronze at the 2014 World and 2015 European Championships). Brazil’s " [:a {:href "/athletes/122258"} "Erlon Silva"] " and " [:a {:href "/athletes/132801"} "Isaquias Queiroz"] " were the reigning World and Pan-American Champions, with the latter having become the first Brazilian to win a canoeing medal by taking silver in the C-1 1000 and bronze in the C-1 200, and would certainly benefit from a home crowd. Russia had been successful at the Europeans, winning in 2013 and 2016 and coming in as runner-up in-between, and brought rookie " [:a {:href "/athletes/120365"} "Ilya Shtokalov"] " to Rio to support the decorated " [:a {:href "/athletes/120361"} "Ilya Pervukhin"] ", who had earned a bronze medal in the event at the 2012 Summer Olympics. This was a result of Pervukhin’s normal partner, " [:a {:href "/athletes/120358"} "Aleksey Korovashkov"] ", being among the over 100 Russians banned from Rio due to doping concerns."] "\n\n" [:p {} "Germany won its preliminary heat, qualifying automatically for the final, while Russia finished third behind Brazil and Ukraine’s " [:a {:href "/athletes/136182"} "Dmytro Yanchuk"] " and " [:a {:href "/athletes/136184"} "Taras Mishchuk"] ", the 2015 European Champions. Ukraine advanced by winning its semifinal heat, while Russia was again third, this time in a semifinal won by " [:a {:href "/athletes/133367"} "Fernando Jorge"] " and " [:a {:href "/athletes/116529"} "Serguey Torres"] " of Cuba. In the final, Brazil led for most of the distance, fueled by the support of a home crowd, but was passed in the last stretch by the Germans, giving Brendel his second gold medal of the Games. Queiroz, meanwhile, became the first Brazilian to win three medals in a single edition of the Olympics. The Ukrainians came in third to round off the podium."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Pair"] [:th {} "NOC"] [:th {} "R1"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "87/189"] [:td {} [:a {:href "/athletes/125320"} "Sebastian Brendel"] " / " [:a {:href "/athletes/134140"} "Jan Vandrey"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "3:33.482 (1 h2)"] [:td {} "–"] [:td {} "3:43.912 (1 h2)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "184/63"] [:td {} [:a {:href "/athletes/122258"} "Erlon Silva"] " / " [:a {:href "/athletes/132801"} "Isaquias Queiroz"]] [:td {} [:a {:href "/countries/BRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BRA.png"}] "BRA"]] [:td {} "3:33.269 (1 h1)"] [:td {} "–"] [:td {} "3:44.819 (2 h2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "195/196"] [:td {} [:a {:href "/athletes/136182"} "Dmytro Yanchuk"] " / " [:a {:href "/athletes/136184"} 