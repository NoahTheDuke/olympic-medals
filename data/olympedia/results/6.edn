1928"] "\n" [:option {:value "17"} "2002"] "\n" [:option {:value "23"} "2006"] "\n" [:option {:value "924600"} "2010"] "\n" [:option {:value "350433"} "2014"] "\n" [:option {:value "9000790"} "2018"] "\n" [:option {:value "19020370"} "2022"] "\n" [:option {:value "15000850"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/516"} "Event type"]] [:h1 {:class "event_title"} "Skeleton, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "3 –  4 February 1948"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/149"} "Cresta Run, St. Moritz / Celerina"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/6"} "15 from 6 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Six runs, total time determined placement. First three runs contested on a shorter course."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Curves: ? / 15" [:br {}] "Length: 870 m / 1231 m" [:br {}] "Start Altitude: ? / ?" [:br {}] "Vertical Drop: ? / 157 m"]]]] [:div {:class "description"} [:p {} "Exactly 20 years after the " [:a {:href "/results/1"} "first Olympic skeleton competition"] ", one of the competitors of 1928 was again competing. Former silver medalist " [:a {:href "/athletes/86531"} "Jack Heaton"] ", now 39, was not only an entrant in the field, but also considered one of the favorites, along with " [:a {:href "/athletes/85726"} "Christian Fischbacher"] " of Switzerland and " [:a {:href "/athletes/84893"} "John Crammond"] " of Britain."] "\n\n" [:p {} "Crammond and Heaton lived up to the expectations on the first day, Crammond winning the first run, and Heaton the second. The third was won by a relative newcomer on the " [:a {:href "/venues/149"} "Cresta Run"] ", Italian " [:a {:href "/athletes/84107"} "Nino Bibbia"] ". After one day of racing, Crammond led by only two tenths of a second over Heaton and Bibbia, who were tied for second. The home favorite, Fischbacher, had crashed out at the infamous Shuttlecock curve in the first run."] "\n\n" [:p {} "On day two, Bibbia moved into the lead with a consistent performance, winning all three runs (tying with Heaton in the 5th and Crammond in the 6th) to become Italy’s first Winter Olympic Champion. Heaton won a second silver medal two decades after his first, while Crammond took the bronze."] "\n\n" [:p {} "Bibbia, who lived in St. Moritz  and had seen the 1928 Winter Olympics there as a young boy, was originally only selected for the Italian bobsleigh teams, and was entered in the skeleton only shortly before the Games. His Olympic victory was his first win on the Cresta Run, but 230 more would follow, including eight Grand Nationals."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Run #1"] [:th {} "Run #2"] [:th {} "Run #3"] [:th {} "Run #4"] [:th {} "Run #5"] [:th {} "Run #6"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/84107"} "Nino Bibbia"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} "5:23.2"] [:td {} "48.0 (4)"] [:td {} "47.6 (2)"] [:td {} "47.6 (1)"] [:td {} "59.5 (1)"] [:td {} "1:00.2 (=1)"] [:td {} "1:00.3 (=1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/86531"} "Jack Heaton"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "5:24.6"] [:td {} "48.1 (5)"] [:td {} "47.4 (1)"] [:td {} "47.7 (2)"] [:td {} "1:00.0 (2)"] [:td {} "1:00.2 (=1)"] [:td {} "1:01.2 (5)"] [:t