00723"} "Rapid-Fire Pistol, 25 metres, Men"] "\n" [:option {:value "18000728"} "Air Rifle, 10 metres, Men"] "\n" [:option {:value "18000731"} "Small-Bore Rifle, Three Positions, 50 metres, Men"] "\n" [:option {:value "18000737"} "Trap, Men"] "\n" [:option {:value "18000740"} "Skeet, Men"] "\n" [:option {:value "18000743"} "Air Pistol, 10 metres, Women"] "\n" [:option {:value "18000746"} "Sporting Pistol, 25 metres, Women"] "\n" [:option {:value "18000754"} "Small-Bore Rifle, Three Positions, 50 metres, Women"] "\n" [:option {:value "18000760"} "Trap, Women"] "\n" [:option {:value "18000763"} "Skeet, Women"] "\n" [:option {:value "18000766"} "Air Pistol, 10 metres, Team, Mixed"] "\n" [:option {:value "18000769"} "Air Rifle, 10 metres, Team, Mixed"] "\n" [:option {:value "18000772"} "Trap, Team, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "51773"} "1984"] "\n" [:option {:value "51816"} "1988"] "\n" [:option {:value "51866"} "1992"] "\n" [:option {:value "51914"} "1996"] "\n" [:option {:value "51965"} "2000"] "\n" [:option {:value "52028"} "2004"] "\n" [:option {:value "261416"} "2008"] "\n" [:option {:value "321000"} "2012"] "\n" [:option {:value "395754"} "2016"] "\n" [:option {:value "2013131"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/503"} "Event type"]] [:h1 {:class "event_title"} "Air Rifle, 10 metres, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "24 July 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2104"} "Asaka Shooting Range, Nerima, Tokyo"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/18000751"} "50 from 39 countries"]]]]] [:div {:class "description"} [:p {} "Since 1988, the women’s 10 m air rifle event has always been the first shooting event contested and it was again the very first gold medal to be decided in all sports at Tokyo. The gold medal went to " [:a {:href "/athletes/141760"} "Yang Qian"] ", who also became the first shooting medallist born in the 2000s."] "\n\n" [:p {} "None of the medallists from Rio returned to Tokyo; furthermore, of the eight finalists from Rio, only " [:a {:href "/athletes/111709"} "Snježana Pejčić"] " competed again in Tokyo. Not present in Tokyo was the reigning 2018 World Champion Im Ha-Na, and the other medallists from this event at the Worlds also did not participate. All three medallists, " [:a {:href "/athletes/142779"} "Océanne Muller"] " (gold), " [:a {:href "/athletes/140982"} "Jessie Kaps"] " (silver) and " [:a {:href "/athletes/144080"} "Sofia Ceccarello"] " (bronze) from the 2021 European Shooting Championships, however, held only about two months before the Tokyo Games, did compete. From the top three of the world ranking just before the Games " [:a {:href "/athletes/147242"} "Mary Tucker"] " (first) and " [:a {:href "/athletes/125754"} "Živa Dvoršak"] " (third) competed, but the second placed Eszter Dénes (HUN) did not qualify."] "\n\n" [:p {} "Both the qualification round, increased from 40 to 60 shots, and the final round, from a maximum of 20 to 24 shots, saw a change of format since Rio 2016. The qualification round was topped by " [:a {:href "/athletes/145679"} "Jeanette Hegg Duestad"] ", who finally finished fourth, followed by " [:a {:href "/athletes/144943"} "Park Hui-Mun"] " and Mary Tucker. The final was very close from the beginning. After the first ten shots, the first five shooters were separated by only 0.6 points. The gold medal decision came in the very last shot. " [:a {:href "/athletes/146173"} "Anastasiya Galashina"] " was 0.2 points ahead of Yang Qian, but Yang produced her poorest shot during the entire competition with a 9.8, and Galashina also had her worst shot, scoring only 8.9 and finally the lead changed again in favor of the Chinese. As " [:a {:href "/athletes/131744"} "Nina Christen"] " finished third, the three medallists all came from the last three shooters that qualified for the final round."] "\n\n" [:p {} "With " [:a {:href "/athletes/140415"} "Houda Chaabi"] " this competition also saw the first ever female shooter participating for Algeria, while " [:a {:href "/athletes/144872"} "Kanykei Kubanychbekova"] " became the first ever female shooter for Kyrgyzstan. Finishing in last position of the qualification round was " [:a {:href "/athletes/142360"} "Luna Solomon"] " representing the Refugee Olympic Team. Originally from Eritrea she came to Switzerland in 2015 where she lived in the Olympic city of Lausanne."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1212"] [:td {} [:a {:href "/athletes/141760"} "Yang Qian"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} "628.7 (6)"] [:td {} "251.8 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "1904"] [:td {} [:a {:href "/athletes/146173"} "Anastasiya Galashina"]] [:td {} [:a {:href "/countries/ROC"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ROC.png"}] "ROC"]] [:td {} "628.5 (8)"] [:td {} "251.1 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "2011"] [:td {