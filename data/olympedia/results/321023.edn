ol, 25 metres, Men"] "\n" [:option {:value "321043"} "Free Pistol, 50 metres, Men"] "\n" [:option {:value "321012"} "Air Rifle, 10 metres, Men"] "\n" [:option {:value "321046"} "Small-Bore Rifle, Three Positions, 50 metres, Men"] "\n" [:option {:value "321031"} "Small-Bore Rifle, Prone, 50 metres, Men"] "\n" [:option {:value "321052"} "Trap, Men"] "\n" [:option {:value "321015"} "Skeet, Men"] "\n" [:option {:value "321006"} "Air Pistol, 10 metres, Women"] "\n" [:option {:value "321018"} "Sporting Pistol, 25 metres, Women"] "\n" [:option {:value "321000"} "Air Rifle, 10 metres, Women"] "\n" [:option {:value "321037"} "Small-Bore Rifle, Three Positions, 50 metres, Women"] "\n" [:option {:value "321034"} "Trap, Women"] "\n" [:option {:value "321009"} "Skeet, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "51902"} "1996"] "\n" [:option {:value "51953"} "2000"] "\n" [:option {:value "52014"} "2004"] "\n" [:option {:value "261402"} "2008"] "\n" [:option {:value "395729"} "2016"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/498"} "Event type"]] [:h1 {:class "event_title"} "Double Trap, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 2 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/875"} "Royal Artillery Barracks, Woolwich, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/321023"} "23 from 18 countries"]]]]] [:div {:class "description"} [:p {} "Britain’s " [:a {:href ""} "Peter Wilson"] " was the hometown favorite and he led the qualifying in this event with 143, giving him a three-point lead over Russian " [:a {:href "/athletes/104798"} "Vasily Mosin"] " and Kuwaiti " [:a {:href "/athletes/43217"} "Fehaid Al-Deehani"] ". The final two qualifiers were Sweden’s " [:a {:href "/athletes/104790"} "Håkan Dahlby"] " and Hungarian " [:a {:href "/athletes/125846"} "Richárd Bognár"] " with 137 targets hit. Five of the six shooters hit 45 targets in the final, but Dahlby missed only once, for 49, to move into the silver medal position, which was not quite enough to catch Wilson, whose 45 clays gave him a total of 188 and two-point lead over Dahlby for the gold medal. Mosin and Al-Deehani tied for third and had to shoot-off for the bronze medal. Oddly, Al-Deehani had also tied for third in the single trap event, where he won the bronze medal. But it was not be in double trap, as Mosin broke his first two clays, Al-Deehani missing on his second, to give bronze to the Russian."] "\n\n" [:p {} "All three medals went to Europeans, the first time this has happened in the five times this event has been held at the Olympics. Defending champion " [:a {:href "/athletes/93181"} "Glenn Eller"] " had a poor day and finished only 22nd of 24 shooters."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {} "Final Shoot-Off 3/4"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1326"] [:td {} [:a {:href "/athletes/122671"} "Peter Wilson"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {} "143 (1)"] [:td {} "188 (1)"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "1722"] [:td {} [:a {:href "/athletes/104790"} "Håkan Dahlby"]] [:td {} [:a {:href "/countries/SWE"} [:im