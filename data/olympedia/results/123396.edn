e "132293"} "1996"] "\n" [:option {:value "133209"} "2000"] "\n" [:option {:value "133842"} "2004"] "\n" [:option {:value "263316"} "2008"] "\n" [:option {:value "332506"} "2012"] "\n" [:option {:value "355358"} "2016"] "\n" [:option {:value "19009561"} "2020"] "\n" [:option {:value "2008041"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/675"} "Event type"]] [:h1 {:class "event_title"} "Light-Heavyweight, Freestyle (≤87 kg), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "20 – 23 July 1952"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/369"} "Messuhalli I, Helsinki"] " / " [:a {:href "/venues/370"} "Messuhalli II, Helsinki"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/123396"} "13 from 13 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Win by fall = 0 points; win by decision = 1 point; loss of any type = 3 points.  Three judges gave decisions, thus all decisions were either 2-1 or 3-0.  Five bad points eliminated a wrestler. When only three wrestlers remained, if they had not yet met one another, they wrestled further rounds. Medal placements were determined by the match record among the medalists, with bad points as a tie breaker. A wrestler in the medal rounds could continue with 5 or more bad points."]]]] [:div {:class "description"} [:p {} "American " [:a {:href "/athletes/60801"} "Henry Wittenberg"] " was the defending gold medalist and was back, and had not been beaten since the 1948 Olympics, although he had wrestled mostly in the United States. His biggest challenger was expected to be Sweden’s " [:a {:href "/athletes/60108"} "Viking Palm"] ", runner-up at the 1949 Europeans and 1951 World Championships. The gold medal was effectively decided in round three when Palm and Wittenberg met, with Palm winning by unanimous decision. Both went on to the final round, joined by Turkey’s " [:a {:href "/athletes/60279"} "Adil Atan"] ". In the final match Palm won a split decision over Atan, which secured him the gold medal, with Wittenberg taking silver, having defeated Atan by fall, and Atan the bronze medal. Palm would compete at the 1956 and 1960 Olympics in this event, but failed to medal. Atan would return to the Olympics at Melbourne in 1956, competing in both freestyle and Greco-Roman, but also failed to mount the podium. For Wittenberg, who was also a two-time champion at the Maccabiah Games, this was the end of his wrestling career."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Medalists Match Record / Round Eliminated"] [:th {} "Bad Points"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "212"] [:td {} [:a {:href "/athletes/60108"} "Viking Palm"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "2-0"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "353"] [:td {} [:a {:href "/athletes/60801"} "Henry Wittenberg"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "1-1"] [:td {} "–"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "292"] [:td {} [:a {:href "/athletes/60279"} "Adil Atan"]] [:td {} [:a {:href "/countries/TUR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/TUR.png"}] "TUR"]] [:td {} "0-2"] [:td {} "–"] [:td {} [:span {:cl