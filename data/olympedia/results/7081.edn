wdy Gaines"] " just before the final turn, forcing Gaines to claw back with a strong second lap to secure the gold."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "3:20.14 (2 h3)"] [:td {} "3:19.03 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "455"] [:td {} [:a {:href "/athletes/51289"} "Chris Cavanaugh"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "464"] [:td {} [:a {:href "/athletes/51393"} "Mike Heath"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "450"] [:td {} [:a {:href "/athletes/51266"} "Matt Biondi"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "461"] [:td {} [:a {:href "/athletes/51352"} "Rowdy Gaines"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "465"] [:td {} [:a {:href "/athletes/51417"} "Tom Jager"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "470"] [:td {} [:a {:href "/athletes/51459"} "Robin Leamy"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} "Australia"] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src 