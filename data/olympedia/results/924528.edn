03"} "1,000 metres, Men"] "\n" [:option {:value "924504"} "1,500 metres, Men"] "\n" [:option {:value "924505"} "5,000 metres, Men"] "\n" [:option {:value "924506"} "10,000 metres, Men"] "\n" [:option {:value "924507"} "Team Pursuit (8 laps), Men"] "\n" [:option {:value "924521"} "500 metres, Women"] "\n" [:option {:value "924524"} "1,000 metres, Women"] "\n" [:option {:value "924525"} "1,500 metres, Women"] "\n" [:option {:value "924526"} "3,000 metres, Women"] "\n" [:option {:value "924527"} "5,000 metres, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1151"} "2006"] "\n" [:option {:value "350672"} "2014"] "\n" [:option {:value "9001058"} "2018"] "\n" [:option {:value "19020434"} "2022"] "\n" [:option {:value "15001134"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/542"} "Event type"]] [:h1 {:class "event_title"} "Team Pursuit (6 laps), Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "26 – 27 February 2010"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/177"} "Richmond Olympic Oval, Richmond"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/924528"} "28 from 8 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination event."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/1151"} "3:01.24"] " / " [:a {:href "/athletes/100968"} "Kristina Groves"] " • " [:a {:href "/athletes/100967"} "Cindy Klassen"] " • " [:a {:href "/athletes/110377"} "Christine Nesbitt"] " " [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"] " / 15 February 2006 / " [:a {:href "/records/event_name/542"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002185"} "Garth Linder"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002691"} "Jan Augustinus"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]]]]] [:div {:class "description"} [:p {} "Canada was the team to beat in this competition. The reigning World Champions, they had a strong showing in the pre-season, winning two of the three World Cup races, while placing second to Russian in the third. Not only did the Canadians have several star skaters, they had also trained exhaustively for the event, still relatively new. But the competition delivered surprise after surprise."] "\n\n" [:p {} "First, the strong Russian team suffered a shock quarter-final defeat at the hands of Poland, after one of the Russians fell behind in the later stages of the race. Then, it was the unheralded Americans who silenced the Canadian crowd by beating the favorites. Canada had been leading with ease, but had not paid attention to the splits of their opponents, and had failed to accelerate."] "\n\n" [:p {} "The second semi-final provided even more excitement. Defending champion Germany was facing the Americans, and they had a solid lead for most of the race. But their star skater, " [:a {:href "/athletes/99411"} "Anni Friesinger-Postma"] ", who had almost been left out of the team due to poor shape caused by injury, struggled in the final lap. While trying to close the gap with ther team mates, Friesinger fell in sight of the finish line. With swimming motions and by turning her skates towards the line, the Germans nevertheless managed to finish ahead of the Americans."] "\n\n" [:p {} "In the final, Germany faced Japan, which had reached the final with relative ease. The Japanese opened up a large lead over the Germans, who raced without Friesinger. But the three Asians totally collapsed in the final lap, resulting in a photo finish. Germany came out the winners, with just 0.02 separating gold and silver. The bronze medal race was also remarkable. The Americans brought in " [:a {:href "/athletes/99420"} "Catherine Raney-Norman"] ", which eventually cost them the bronze. She couldn’t follow the pace of the Americans, who were leading up to that point. The Polish team, of which even the best skater (" [:a {:href "/athletes/100979"} "Katarzyna Bachleda-Curuś"] ") rarely featured in the top-10 of international competitions, thus won a completely unexpected bronze medal. It was the first bronze medal since 1960, when Poland had claimed two medals in the sport’s début for women."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Germany"] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/100971"} "Daniela Anschütz-Thoms"] " • " [:a {:href "/athletes/119729"} "Stephanie Beckert"] " • " [:a {:href "/athletes/99411"} "Anni Friesinger-Postma"] " • " [:a {:href "/athletes/119684"} "Katrin Mattscherodt"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Japan"] [:td