option {:value "924547"} "Slalom, Men"] "\n" [:option {:value "924550"} "Combined, Men"] "\n" [:option {:value "924553"} "Downhill, Women"] "\n" [:option {:value "924554"} "Super G, Women"] "\n" [:option {:value "924555"} "Giant Slalom, Women"] "\n" [:option {:value "924558"} "Slalom, Women"] "\n" [:option {:value "924561"} "Combined, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1357"} "1988"] "\n" [:option {:value "1383"} "1992"] "\n" [:option {:value "1409"} "1994"] "\n" [:option {:value "1435"} "1998"] "\n" [:option {:value "1461"} "2002"] "\n" [:option {:value "1488"} "2006"] "\n" [:option {:value "350001"} "2014"] "\n" [:option {:value "9000101"} "2018"] "\n" [:option {:value "19019501"} "2022"] "\n" [:option {:value "15000001"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/30"} "Event type"]] [:h1 {:class "event_title"} "Super G, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "19 February 2010 — 11:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/180"} "Whistler Creekside, Whistler"] " (Dave Murray)"]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/924543"} "63 from 27 countries"]]] [:tr {:class "referees", :style ""} [:th {} "Course Setter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002270"} "Giovanni Rulfi"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Gates: 44" [:br {}] "Length: 2200 m" [:br {}] "Start Altitude: 1440 m" [:br {}] "Vertical Drop: 615 m"]]]] [:div {:class "description"} [:p {} "The fourth Alpine skiing race of the Vancouver Olympics was held on Friday, 19 February, as scheduled. The favorites were " [:a {:href "/athletes/101759"} "Michael Walchhofer"] " (leader of the current Super G World Cup), " [:a {:href "/athletes/109893"} "Aksel Lund Svindal"] " (second in the 2009-10 Super G World Cup, winner of the 2008-09 Super G World Cup, and bronze medalist at the 2009 World Championships), " [:a {:href "/athletes/99486"} "Didier Cuche"] " (2009 World Champion and winner at Kitzbühel in 2010), and " [:a {:href "/athletes/109895"} "Manuel Osborne-Paradis"] " (recent winner at Lake Louise). But " [:a {:href "/athletes/101056"} "Didier Défago"] " and " [:a {:href "/athletes/99516"} "Bode Miller"] " were also highly considered after winning gold and bronze in the downhill four days earlier. The 2006 medalists " [:a {:href "/athletes/99335"} "Kjetil André Aamodt"] " (gold) retired shortly after Torino, " [:a {:href "/athletes/99494"} "Hermann Maier"] " (silver) retired just before the 2009-10 season, and " [:a {:href "/athletes/101048"} "Ambrosi Hoffmann"] " (bronze) raced only in the downhill in 2010. The only World Cup Super G held on this course was won by " [:a {:href "/athletes/101055"} "Christoph Gruber"] " on 21 February 2008."] "\n\n" [:p {} "The race started at 11:30 AM with perfect sunny weather and temperatures between 3.5° (start) and 9° (finish). With number 3 the American " [:a {:href "/athletes/118320"} "Andrew Weibrecht"] " set an early quick time. The first of the favorites was Miller in start position 11. He took the lead from the first split to the finish, but he lost time in the second part of the course, and topped the time of his fellow countryman by only 0.03 seconds.  Svindal, who turned 28 on the closing day of the Vancouver Olympics, did not start well, as in the downhill, and at the first intermediate split was 0.3 seconds behind Miller, but he finished quickly to lead by 0.28 seconds at the finish line and take the gold medal. The oldest competitor in the field, " [:a {:href "/athletes/87694"} "Patrik Järbyn"] ", hooked a gate and fell in the last section of the course and landed hard on his back and head and was unconscious. He was flown to hospital by helicopter, but luckily was not hurt badly and was able to leave the hospital the next day."] "\n\n" [:p {} "When Svindal came to the leaders area, Miller was laughing and joked with him with some profanity which was broadcast around the world. Svindal won the race with an average speed of 87.67 km/hr by 0.28 seconds or 6.8 metres in front of Miller. The sensation of the race was bronze medalist Weibrecht who had never previously placed better than 10th in a World Cup race. Svindal won the first gold medal for Atomic at this Olympics. Miller, on the same skis as in the downhill and the only one of the top racers on downhill skis, won silver with Head, while Weibrecht took bronze using Rossignol."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "19"] [:td {} [:a {:href "/athletes/109893"} "Aksel Lund Svindal"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "1:30.34"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "11"] [:td {} [:a {:href "/athletes/99516"} "Bode Miller"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "1:30.62"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}