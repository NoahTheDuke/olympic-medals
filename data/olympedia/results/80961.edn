"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Jury"] [:td {:style "width: 400px"} [:a {:href "/athletes/22751"} "Rodolfo Terlizzi"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Jury"] [:td {:style "width: 400px"} [:a {:href "/athletes/23812"} "Harold Van Buskirk"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Jury"] [:td {:style "width: 400px"} [:a {:href "/athletes/899391"} "Clarence, Greve von Rosen"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]]]]] [:div {:class "description"} [:p {} "The last fencing event at the 1932 Olympics was the individual sabre. Although expected to be very exciting, the organizational weaknesses here proved distressing, as the final pool lasted nearly six hours. The Hungarians were favored as they dominated sabre fencing in this era, with the 1930-31 World championship having gone to " [:a {:href "/athletes/22519"} "György Piller"] ". Piller won the gold medal, as expected, but the silver went to the surprising " [:a {:href "/athletes/22668"} "Giulio Gaudini"] " of Italy, ahead of Hungary’s " [:a {:href "/athletes/22470"} "Endre Kabos"] ", who narrowly edged out Germany’s " [:a {:href "/athletes/22251"} "Erwin Casmir"] " for bronze."] "\n\n" [:p {} "Hungarian " [:a {:href "/athletes/22517"} "Attila Petschauer"] " had been favored for a medal, but came in fifth. Petschauer, who was Jewish, was arbitrarily arrested by the Nazis in the summer of 1942 and assigned to hard labor in the Davidovka concentration camp, which was effectively a death sentence. As a prominent prisoner, he was singled out for the harshest treatment. When in January 1943 his former teammate and current overseer " [:a {:href "/athletes/11793"} "Kálmán Cseh"] " identified him as an Olympic champion, Petschauer was beaten with a wire whip until his spine was exposed, until Colonel General Burdenko, chief surgeon of the Red Army, arrived a bit later, and stopped the brutality, but could not save his life. Petschauer was forced to climb a tree naked in the frigid weather, and had cold water sprayed on him. He died shortly thereafter. A documentation of this case appeared in the 1970s in Hungary, and Petschauer’s death by torture was the subject of the 1999 movie " [:em {} "Sunshine"] ", starring Ralph Fiennes."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/22519"} "György Piller"]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/22668"} "Giulio Gaudini"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/22470"} "Endre Kabos"]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amaz