56"] "\n" [:option {:value "124446"} "1960"] "\n" [:option {:value "125161"} "1964"] "\n" [:option {:value "125850"} "1968"] "\n" [:option {:value "126660"} "1972"] "\n" [:option {:value "127524"} "1976"] "\n" [:option {:value "128301"} "1980"] "\n" [:option {:value "129045"} "1984"] "\n" [:option {:value "130015"} "1988"] "\n" [:option {:value "132237"} "1996"] "\n" [:option {:value "133165"} "2000"] "\n" [:option {:value "133802"} "2004"] "\n" [:option {:value "263270"} "2008"] "\n" [:option {:value "332460"} "2012"] "\n" [:option {:value "355312"} "2016"] "\n" [:option {:value "19009532"} "2020"] "\n" [:option {:value "2008010"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/674"} "Event type"]] [:h1 {:class "event_title"} "Middleweight, Freestyle (≤82 kg), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "5 –  7 August 1992"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/709"} "Instituto Nacional de Educación Física de Cataluña (INEFC), Barcelona"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/131167"} "19 from 19 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Two groups (A and B).  Double elimination tournament within each group.  Top five in each group advance to placement matches for 1st-10th place."]]]] [:div {:class "description"} [:p {} "The final came down to the 1991 World Champion, " [:a {:href "/athletes/60670"} "Kevin Jackson"] " of the United States, and the 1989 World Champion, " [:a {:href "/athletes/60477"} "Elmadi Zhabrailov"] ", a Kazakh wrestling for the Unified Team. The match ended in a scoreless tie and went into overtime. At 0:46 of the overtime Zhabrailov attacked and Jackson countered, and the two wrestlers moved out of bounds and the action was re-started. The Unified coaches then protested that Zhabrailov had controlled Jackson and deserved a point, which would have ended the match, but Bulgarian referee Todor Grudev ruled that no point had been scored and this would later be upheld by FILA after a Unified Team protest. One minute later Jackson got Zhabrailov in a single-leg takedown, which earned him a point, the match, and the gold medal."] "\n\n" [:p {} "Zhabrailov was not happy. He sobbed after the loss and had to be forced to step up to the podium. Although he accepted his silver medal he did not put it around his neck. The American anthem, “The Star-Spangled Banner,” was played for Jackson, but nobody heard it because the Russian fans booed and whistled and drowned out the music."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Round Eliminated"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Classification Points", :class "footnote"} "CP"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "B2"] [:td {} [:a {:href "/athletes/60670"} "Kevin Jackson"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "A6"] [:td {} [:a {:href "/athletes/60477"} "Elmadi Zhabrailov"]] [:td {} [:a {:href "/countries/EUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/EUN.png"}] "EUN"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "B4"] [:td {} [:a {:href "/athletes/58785"} "Rasoul Khadem Azgadhi"]] [:td {} [:a {:href "/countries/IRI"} [:img {:style "padding-righ