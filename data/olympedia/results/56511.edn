6"} "1932"] "\n" [:option {:value "58355"} "1936"] "\n" [:option {:value "58689"} "1948"] "\n" [:option {:value "59061"} "1952"] "\n" [:option {:value "59451"} "1956"] "\n" [:option {:value "59877"} "1960"] "\n" [:option {:value "60294"} "1964"] "\n" [:option {:value "60780"} "1968"] "\n" [:option {:value "61277"} "1972"] "\n" [:option {:value "61851"} "1976"] "\n" [:option {:value "62408"} "1980"] "\n" [:option {:value "62913"} "1984"] "\n" [:option {:value "63556"} "1988"] "\n" [:option {:value "64238"} "1992"] "\n" [:option {:value "64917"} "1996"] "\n" [:option {:value "65576"} "2000"] "\n" [:option {:value "66256"} "2004"] "\n" [:option {:value "257389"} "2008"] "\n" [:option {:value "302072"} "2012"] "\n" [:option {:value "358817"} "2016"] "\n" [:option {:value "19000560"} "2020"] "\n" [:option {:value "2013717"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/87"} "Event type"]] [:h1 {:class "event_title"} "Hammer Throw, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "14 July 1908 — 10:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/216"} "White City Stadium, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/56511"} "19 from 8 countries"]]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/78764"} "Matt McGrath"] " (USA) led the qualifiers with 167-11 (51.18), while " [:a {:href "/athletes/78400"} "John Flanagan"] " (USA) was in second place with 165-2 (50.36).  In the final, Flanagan improved on his last throw to 170-4¼ (51.92), to repeat his victories of " [:a {:href "/results/56108"} "1900"] " and " [:a {:href "/results/56150"} "1904"] ".  Flanagan commented on his victory, 20 years later, “It was, without doubt, one of the most satisfying competition wins of my life.  Matt McGrath tended to be a little arrogant and I had the feeling he believed he was certain to win.  When it all came down to my last throw I knew I had to put everything into it and as it turned out I did.  If I have any regret at all now, it is that I was not competing for Ireland on that day.”"] "\n\n" [:p {} "John Flanagan had won the Olympic title in 1900 and 1904, and was then considered the greatest hammer thrower of the 20th century.  He set 18 marks considered as world records between 1896 and 1909.  Flanagan would win seven AAU hammer championships, and six titles with the 56-lb weight.  Of Irish birth (Kilbreedy, County Limerick), he had emigrated to the United States in 1897.  Amazingly for a man of his size (5’10” [1.78 metres], 220 lbs [100 kg]), he finished second in both the high and long jump and the all-around at the 1895 Irish Championships."] "\n\n" [:p {} "By 1908, Matt McGrath (USA) was becoming Flanagan’s rival for hammer throw supremacy.  He first appeared on the national scene in 1907, finishing 2nd in the AAU championship, but he was a world-class hammer thrower until 1928, winning seven AAU titles (the last in 1926), setting two world records, and winning three Olympic medals - silvers in 1908 and " [:a {:href "/results/57507"} "1924"] ", and a gold in " [:a {:href "/results/56920"} "1912"] ".  In his defense, it was noted that he had injured his knee in the spring of 1908, and was not fully recovered from that by the time of the Olympics."] "\n\n" [:p {} "Interestingly, all three medal winners were born in Ireland and, with Scotsman " [:a {:href "/athletes/69346"} "Tom Nicolson"] " finishing in fourth place, it was a memorable day for Gaelic throwers.  The bronze medalist, " [:a {:href "/athletes/66270"} "Con Walsh"] ", had been born in Carriganimma, County Cork, but spent most of his athletic career in Canada, and may have had the most potential of any of the throwers.  The " [:a {:href "/results/57219"} "1920"] " Olympic hammer champion, " [:a {:href "/athletes/78986"} "Paddy Ryan"] " (USA), commented on Walsh, in a 1958 interview, “Con liked the good life and as far as he was concerned training was not part of the good life.  He could have beaten the lot of us but he never bothered with any serious training.  He was lazy but thoroughly enjoyed competition and was a wonderful man to know at all times.”"] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/78400"} "John Flanagan"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "50.36 (2)"] [:td {} "51.92 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/78764"} "Matt McGrath"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "51.18 (1)"] [:td {} "51.18 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/66270"} "Con Walsh"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {} "48.51 (3)"] [:td {} "48.51 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/69346"} "Tom Nicolson"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]