value "2012215"} "Team All-Around, Men"] "\n" [:option {:value "2012230"} "Floor Exercise, Men"] "\n" [:option {:value "2012233"} "Vault, Men"] "\n" [:option {:value "2012240"} "Parallel Bars, Men"] "\n" [:option {:value "2012243"} "Horizontal Bar, Men"] "\n" [:option {:value "2012246"} "Rings, Men"] "\n" [:option {:value "2012249"} "Pommelled Horse, Men"] "\n" [:option {:value "2012252"} "Individual All-Around, Women"] "\n" [:option {:value "2012263"} "Team All-Around, Women"] "\n" [:option {:value "2012277"} "Vault, Women"] "\n" [:option {:value "2012284"} "Uneven Bars, Women"] "\n" [:option {:value "2012287"} "Balance Beam, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "70178"} "1952"] "\n" [:option {:value "70203"} "1956"] "\n" [:option {:value "70239"} "1960"] "\n" [:option {:value "70283"} "1964"] "\n" [:option {:value "70327"} "1968"] "\n" [:option {:value "70389"} "1972"] "\n" [:option {:value "70447"} "1976"] "\n" [:option {:value "70505"} "1980"] "\n" [:option {:value "70563"} "1984"] "\n" [:option {:value "70621"} "1988"] "\n" [:option {:value "70679"} "1992"] "\n" [:option {:value "70737"} "1996"] "\n" [:option {:value "70821"} "2000"] "\n" [:option {:value "70905"} "2004"] "\n" [:option {:value "259988"} "2008"] "\n" [:option {:value "313033"} "2012"] "\n" [:option {:value "353680"} "2016"] "\n" [:option {:value "19009174"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/328"} "Event type"]] [:h1 {:class "event_title"} "Floor Exercise, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "28 July –  5 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2166"} "Bercy Arena, Bercy, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2012274"} "75 from 33 countries"]]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/132107"} "Simone Biles"] " was looking to become the fourth person to win a second gold in the women’s floor exercise, having earned the gold in 2016. As a six-time World Champion, most recently in 2023, she was the clear favorite. Other medal contenders were Brazil’s " [:a {:href "/athletes/129288"} "Rebeca Andrade"] " (silver at the 2023 worlds) and defending champion " [:a {:href "/athletes/147191"} "Jade Carey"] ". The 2021 World Champion, " [:a {:href "/athletes/130775"} "Mai Murakami"] ", had since retired, while 2022 champion " [:a {:href "/athletes/143019"} "Jessica Gadirova"] " was out with an ACL injury."] "\n\n" [:p {} "Biles led Andrade in qualifying, ahead of another American, " [:a {:href "/athletes/147192"} "Jordan Chiles"] ". Defending champion Carey suffered a dramatic fall at the end of her exercise and received the 74th score. The final started with Andrade posting an exciting exercise, improving on her qualifying score with 14.166. This score was not approached by any of the other finalists, many of whom also suffered small penalties for stepping out of bounds. The next-to-last starter was Biles, whose difficulty score of 6.9 was a full point ahead of Andrade. Biles’ performance was not flawless, however, as she stepped out of bounds on two occasions. This cost her 0.6 points in penalties, which landed her at 14.133, narrowly behind the Brazilian. On the podium, silver medalist Biles and bronze medalist Chiles showed their respect for the Brazilian, bowing to her as she stepped up to receive her gold medal, making it one of the defining images of the Paris Games."] "\n\n" [:p {} "Unfortunately, the battle for the medals did not end there. Chiles had originally not been among the top three. Her score was 13.666, ranking her fifth. Chiles’ coach Cécile Canqueteau-Landi, however, had submitted an inquiry into her difficulty score. This had been accepted, and her score was raised by 0.1 to 13.766. This moved her ahead of two Romanians, " [:a {:href "/athletes/152695"} "Ana Bărbosu"] " and " [:a {:href "/athletes/152699"} "Sabrina Maneca-Voinea"] ", who had both scored 13.700. Due to a better execution score, Bărbosu had been ranked above her compatriot. After inquiry into Chiles’ score, the Romanian team filed an appeal to the Court of Arbitration for Sport (CAS), claiming the inquiry had been submitted outside of the one-minute deadline, and CAS ruled the inquiry was indeed made outside the deadline. The International Gymnastics Federation and the IOC followed the ruling by reinstating the original results and thus re-awarding Chiles’ bronze to Ana Bărbosu, who received it in her hometown on 16 August. The American gymnastics federation unsuccessfully tried to appeal to CAS, claiming the inquiry was made after 47 seconds. Andrade’s gold was her second after winning the vault in Tokyo, and Brazil’s third in gymnastics. Biles earned her 11th Olympic medal, and only her second silver."] "\n\n" [:p {} "Chiles and USA Gymnastics appealed to the Swiss Federal Tribunal, and on 29 January 2026 that tribunal upheld Chiles’ and USA Gymnastics’ argument that the appeal had been filed within the one-minute time limit and referred the case back to CAS for further review."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/129288"} "Rebeca Andrade"]] [:td {} [:a {:href "/countries/BRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BRA.png"}] "BRA"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:t