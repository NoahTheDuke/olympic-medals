n" [:option {:value "19005785"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/153"} "Event type"]] [:h1 {:class "event_title"} "Light-Heavyweight (71-80 kilograms), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "27 July –  7 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2162"} "Arena Paris Nord, Villepinte, France"] " / " [:a {:href "/venues/2164"} "Stade Roland Garros, Paris, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2001098"} "18 from 18 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single elimination tournament."]]]] [:div {:class "description"} [:p {} "With the elimination of the middleweight division from Tokyo, this division was now for boxers weighing 71-80 kg, whereas in Tokyo the weight range was 75-81 kg. The top seed was the 2023 World silver medalist, China’s " [:a {:href "/athletes/141831"} "Tuohetaerbieke Tanglatihan"] ", who was defeated by bronze medalist " [:a {:href "/athletes/151049"} "Cristian Pinales"] " (DOM) on a unanimous decision in round two. Pinales was defeated in the semi-finals by Kazakh fighter " [:a {:href "/athletes/155806"} "Nurbek Oralbay"] ", who had defeated " [:a {:href "/athletes/151015"} "Callum Peters"] " of Australia by a close 3-2 decision in round two, followed by a unanimous points win against " [:a {:href "/athletes/151021"} "Murad Allahverdiyev"] " (AZE) in the quarter-finals."] "\n\n" [:p {} "The division seemed open for the 2016 and 2020 champion Cuba’s " [:a {:href "/athletes/133361"} "Arlen López"] " to win, but a split 3-2 decision against Ukrainian " [:a {:href "/athletes/147062"} "Oleksandr Khyzhniak"] ", silver medalist in the middleweight division in 2020, saw Khyzhniak advance to the final. The final was not without note, as Khyzhniak defeated Oralbay on a split decision, two of the judges awarding all three rounds to the Ukrainian fighter. This was to be Ukraine’s only boxing medal at the 2024 Games."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/147062"} "Oleksandr Khyzhniak"]] [:td {} [:a {:href "/countries/UKR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UKR.png"}] "UKR"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/155806"} "Nurbek Oralbay"]] [:td {} [:a {:href "/countries/KAZ"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KAZ.png"}] "KAZ"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/133361"} "Arlen López"]] [:td {} [:a {:href "/countries/CUB"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CUB.png"}] "CUB"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/151049"} "Cristian Pinales"]] [:td {} [:a {:href "/countries/DOM"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/DOM.png"}] "DOM"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=5"] [:td {} [:a {:href "/athletes/151030"} "Wanderley Pereira"]] [:td {} [:a {:href "/countries/BRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BRA.png"}] "BRA"]] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :s