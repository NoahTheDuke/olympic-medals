e "125850"} "1968"] "\n" [:option {:value "126660"} "1972"] "\n" [:option {:value "127524"} "1976"] "\n" [:option {:value "128301"} "1980"] "\n" [:option {:value "129045"} "1984"] "\n" [:option {:value "130015"} "1988"] "\n" [:option {:value "131167"} "1992"] "\n" [:option {:value "132237"} "1996"] "\n" [:option {:value "133165"} "2000"] "\n" [:option {:value "133802"} "2004"] "\n" [:option {:value "263270"} "2008"] "\n" [:option {:value "332460"} "2012"] "\n" [:option {:value "355312"} "2016"] "\n" [:option {:value "2008010"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/674"} "Event type"]] [:h1 {:class "event_title"} "Middleweight, Freestyle (≤74 kg), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "5 –  6 August 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2125"} "Makuhari Messe, 2-1, Nakase, Mihama-ku, Chiba, Chiba Prefecture, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19009532"} "16 from 16 countries"]]]]] [:div {:class "description"} [:p {} "Italian " [:a {:href "/athletes/134676"} "Frank Chamizo"] " was seeded first after winning the 2019 and 2020 European Championships. He was followed in the seeding by Kazakh " [:a {:href "/athletes/144796"} "Daniyar Kaisanov"] ", who was the 2019 and 2020 Asian Champion. Those seemed more important to the seeding committee than the World Championships as the 2018 and 2019 World Champion, " [:a {:href "/athletes/146295"} "Zaurbek Sidakov"] " of the ROC team, was seeded only third. One wrestler who would have contended was American " [:a {:href "/athletes/126810"} "Jordan Burroughs"] ", four-time World Champion and 2012 Olympic gold medallist, but he failed to make the USA team."] "\n\n" [:p {} "Chamizo, Kaisanov, and Sidakov all made it into the semi-finals comfortably, where they were joined by Belarussian " [:a {:href "/athletes/141101"} "Mahamedkhabib Kadzimahamedau"] ". Kadzimahamedau upset Chamizo in the semis, winning a 9-7 decision, while Sidakov easily handled Kaisanov, winning by superiority, 11-0 in 5:34."] "\n\n" [:p {} "Sidakov showed the error of the seeding committee’s ways by shutting out Kadzimahamedau in the final, 7-0, to win the gold medal. Neither Chamizo nor Kaisanov would get a bronze medal, Chamizo losing in the repêchage final to American " [:a {:href "/athletes/147508"} "Kyle Dake"] ", who had defeated Burroughs at the US Olympic Trials."] "\n\n" [:p {} "Dake was hardly unknown as he was World Champion in 2018-19 at 79 kg, but because of the different classes at the Olympics he had to come down in weight. Kaisanov lost his final to Uzbeki " [:a {:href "/athletes/136432"} "Bekzod Abdurakhmonov"] ", who won on superiority 13-2, in 2:13. Abdurakhmonov was the 2014 and 2018 Asian Games Champion and had twice won bronze medals at the Worlds."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Classification Points", :class "footnote"} "CP"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Victories by Fall", :class "footnote"} "VF"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Victories by Technical Superiority", :class "footnote"} "ST"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Technical Points", :class "footnote"} "TP"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Technical Points Received", :class "footnote"} "TPR"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/146295"} "Zaurbek Sidakov"]] [:td {} [:a {:href "/countries/ROC"} [:img {:style "padding-right: 2px; vertical-align: middle", :src 