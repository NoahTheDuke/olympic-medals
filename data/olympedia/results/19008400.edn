6"} "2004"] "\n" [:option {:value "260951"} "2008"] "\n" [:option {:value "319061"} "2012"] "\n" [:option {:value "353920"} "2016"] "\n" [:option {:value "2012400"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/378"} "Event type"]] [:h1 {:class "event_title"} "Single Sculls, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "23 – 30 July 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2129"} "Sea Forest Waterway, 6-44, 3chome, Uminomori, Koto-ku, Tokyo Bay, Tokyo, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19008400"} "32 from 32 countries"]]]]] [:div {:class "description"} [:p {} "Considered favourites heading into this event were " [:a {:href "/athletes/143464"} "Oliver Zeidler"] ", the 2021 European champion, as well as 2019 World and European Champion " [:a {:href "/athletes/142178"} "Sverri Nielsen"] " of Denmark and " [:a {:href "/athletes/120078"} "Kjetil Borch"] " of Norway. Others to watch were Croatia’s " [:a {:href "/athletes/121787"} "Damir Martin"] ", the silver medallist at the 2016 Olympic Games, a young up and coming Canadian " [:a {:href "/athletes/141552"} "Trevor Jones"] ", two time under-23 World Champion, as well as veteran " [:a {:href "/athletes/112353"} "Mindaugas Griskonis"] " of Lithuania, participating in his fourth Olympics. In addition, Greek rower " [:a {:href "/athletes/134276"} "Stefanos Ntouskos"] " had served notice he might be peaking at the right time by winning the event at the last Olympic qualifying regatta."] "\n\n" [:p {} "Things held more or less to form in the heats, with the favourites moving through to the semi-finals. It was here that the first surprises occurred, with perhaps the top favourite, Zeidler, failing to make the final by just over half a second, being edged out by " [:a {:href "/athletes/146256"} "Aleksandr Vyazovkin"] ", representing the Russian Olympic Committee. The young Canadian, Jones, also failed to advance. In the final, Borch got out quickly, being followed closely by Nielsen, but before long the Greek, Ntouskos, made a big push to take the lead and never looked back. Nielsen challenged for a spell, but Ntouskos held him off to claim the gold, while Borch overtook Nielsen to place himself in second. The real battle emerged for third, where Martin put on a final push to edge Nielsen for the bronze, in a photo finish. A great day for Greece, as they won their very first gold medal in rowing (aside from in the unofficially recognised 1906 Intercalated Games), and in a new Olympic best time."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/134276"} "Stefanos Ntouskos"]] [:td {} [:a {:href "/countries/GRE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GRE.png"}] "GRE"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/120078"} "Kjetil Borch"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/121787"} "Damir Martin"]] [:td {} [:a {:href "/countries/CRO"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CRO.png"}] "CRO"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/142178"} "Sverri Nielse