38000"} "1900"] "\n" [:option {:value "38011"} "1904"] "\n" [:option {:value "38017"} "1908"] "\n" [:option {:value "38025"} "1912"] "\n" [:option {:value "38041"} "1920"] "\n" [:option {:value "38068"} "1924"] "\n" [:option {:value "38095"} "1928"] "\n" [:option {:value "38119"} "1932"] "\n" [:option {:value "38129"} "1936"] "\n" [:option {:value "38179"} "1948"] "\n" [:option {:value "38237"} "1952"] "\n" [:option {:value "38305"} "1956"] "\n" [:option {:value "38341"} "1960"] "\n" [:option {:value "38391"} "1964"] "\n" [:option {:value "38502"} "1972"] "\n" [:option {:value "38568"} "1976"] "\n" [:option {:value "38623"} "1980"] "\n" [:option {:value "38678"} "1984"] "\n" [:option {:value "38727"} "1988"] "\n" [:option {:value "38777"} "1992"] "\n" [:option {:value "38827"} "1996"] "\n" [:option {:value "38884"} "2000"] "\n" [:option {:value "38966"} "2004"] "\n" [:option {:value "262918"} "2008"] "\n" [:option {:value "330000"} "2012"] "\n" [:option {:value "396300"} "2016"] "\n" [:option {:value "19001580"} "2020"] "\n" [:option {:value "2003100"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/631"} "Event type"]] [:h1 {:class "event_title"} "Water Polo, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "14 – 26 October 1968"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/485"} "Alberca Olímpica Francisco Márquez, Ciudad de México"] " / " [:a {:href "/venues/509"} "Alberca Olímpica Universitaria, Universidad Nacional Autónoma de México, Ciudad de México"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/38432"} "162 from 15 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Round-robin pools advanced teams to classification matches."]]]] [:div {:class "description"} [:p {} "At the last four Olympics the top four teams had been Hungary, Yugoslavia, the Soviet Union, and Italy, with Hungary winning gold in 1952, 1956, and 1964 (Italy won in 1960), and Yugoslavia taking silver in those same years. The same four teams again made the semi-finals with Hungary winning Group A over the Soviet Union and Italy winning Group B over Yugoslavia. In the semi-finals Yugoslavia defeated Hungary 8-6, to end 16 years of Olympic water polo defeats to them, and the Soviet Union, the 1966 European Champion, bested Italy in the other semi, 8-5. Yugoslavia won the gold medal match over the Soviets, 13-11, despite seven goals by " [:a {:href "/athletes/54808"} "Oleksiy Barkalov"] ". Hungary won the bronze medal match over Italy, 9-4, also led by seven goals from " [:a {:href "/athletes/54152"} "László Felkai"] "."] "\n\n" [:p {} "Although his team finished only seventh, the Netherlands’ " [:a {:href "/athletes/54566"} "Nico van der Voet"] " led all scorers with 33 goals in nine matches. Records for goal scoring at many earlier Olympics are not fully known, but this was also an all-time Olympic record for one Games, shattering the previous known best of 14 by " [:a {:href "/athletes/54911"} "Phil Daubenspeck"] " for the United States in 1932. Van der Voet’s mark has not been beaten, and only been equalled once since at the Olympics, by Spain’s " [:a {:href "/athletes/53757"} "Manuel Estiarte"] " at the 1984 Olympics with 33 goals. Van der Voet had also been the leading scorer at Tokyo in 1964, but with only 10 goals."] "\n"] [:button {:id "button42853", :class "btn btn-default"} "Details"] [:script {} "$('#button42853').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {}] [:th {} "Pos"] [:th {} "Number"] [:th {} "Team"] [:th {} "NOC"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Games Played", :class "split", :style "display: none"} "GP"] [:th {:style "display: none", :class "split"} "Goals"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""