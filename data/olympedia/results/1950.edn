0 kilometres, Men"] "\n" [:option {:value "1951"} "4 × 10 kilometres Relay, Men"] "\n" [:option {:value "1955"} "5 kilometres, Women"] "\n" [:option {:value "1956"} "10 kilometres, Women"] "\n" [:option {:value "1957"} "3 × 5 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1890"} "1924"] "\n" [:option {:value "1892"} "1928"] "\n" [:option {:value "1894"} "1932"] "\n" [:option {:value "1896"} "1936"] "\n" [:option {:value "1902"} "1948"] "\n" [:option {:value "1908"} "1952"] "\n" [:option {:value "1916"} "1956"] "\n" [:option {:value "1927"} "1960"] "\n" [:option {:value "1938"} "1964"] "\n" [:option {:value "1962"} "1972"] "\n" [:option {:value "1974"} "1976"] "\n" [:option {:value "1987"} "1980"] "\n" [:option {:value "2000"} "1984"] "\n" [:option {:value "2014"} "1988"] "\n" [:option {:value "2031"} "1992"] "\n" [:option {:value "2051"} "1994"] "\n" [:option {:value "2071"} "1998"] "\n" [:option {:value "2091"} "2002"] "\n" [:option {:value "2134"} "2006"] "\n" [:option {:value "923554"} "2010"] "\n" [:option {:value "350067"} "2014"] "\n" [:option {:value "9000278"} "2018"] "\n" [:option {:value "19019713"} "2022"] "\n" [:option {:value "15000134"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/187"} "Event type"]] [:h1 {:class "event_title"} "50 kilometres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "17 February 1968"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/44"} "Autrans"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1950"} "51 from 18 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: ?" [:br {}] "Height Differential: 248 m" [:br {}] "Intermediate 1: 15.0 km" [:br {}] "Intermediate 2: 25.0 km" [:br {}] "Intermediate 3: 40.0 km" [:br {}] "Maximum Climb: 70 m" [:br {}] "Total Climbing: 1,480 m"]]]] [:div {:class "description"} [:p {} "Bitter cold the night before the 50 km race made the conditions in the track icy, and the race developed into the fastest 50 km race in the history of skiing to that time, and also the closest battle for the medals, as only 52 seconds separated 6th place from the gold medal. The two newly crowned champions from 30 km and 15 km, " [:a {:href "/athletes/95884"} "Franco Nones"] " and " [:a {:href "/athletes/86266"} "Harald Grønningen"] ", were not among the participants. At the first official intermediate time at 15 km, " [:a {:href "/athletes/86683"} "Reidar Hjermstad"] ", who came into the Norwegian team as a substitute for Grønningen, was in a clear lead, 21 seconds ahead of his countryman " [:a {:href "/athletes/85476"} "Ole Ellefsæter"] ", who had skied the anchor leg for the victorious Norwegian relay team three days earlier. At the halfway point Ellefsæter had taken the lead, 44 seconds ahead of Sweden’s " [:a {:href "/athletes/96872"} "Melcher Risberg"] ", who had advanced from fifth place at 15 km. Hjermstad had dropped down to third, 50 seconds behind his countryman. At 40 km Ellefsæter was still in the lead, but two other skiers had come strongly from behind. His teammate " [:a {:href "/athletes/98447"} "Pål Tyldum"] " had moved from 11th place at the halfway point to second, only 29 seconds behind, and Soviet Union’s " [:a {:href "/athletes/98594"} "Vyacheslav Vedenin"] " had moved from tenth to third, one minute behind the leader. Over the last 10 km Ellefsæter was able to cling to the lead and won Norway’s first Olympic gold medal at the distance since " [:a {:href "/athletes/86509"} "Thorleif Haug"] " won in the first Winter Olympics in 1924. Vedenin finished strongly for a silver medal 17 seconds behind, but the fastest finisher was the surprise man of the day, Switzerland’s " [:a {:href "/athletes/87306"} "Josef Haas"] ". The 30-year old skier from Marbach in Sankt Gallen moved up from 6th to bronze position during the last 10 km, and finished only 29 seconds behind the winner. He skied the last 10 km 48 seconds faster than the Olympic Champion Ellefsæter. Haas was the first skier from Middle Europe winning a medal in the Olympic 50 km race. Tyldum was unable to defend his second place and finished fourth, another 12 seconds behind Haas and closely followed by the two Swedes Risberg and " [:a {:href "/athletes/89440"} "Gunnar Larsson"] ", the bronze medalist from the 15 km race. Only 0.2 seconds separated the two Swedes. Ellefsæter’s winning time of 2-28:45.8 stood unbeaten in international skiing championships until 1980, when Olympic Champion " [:a {:href "/athletes/99245"} "Nikolay Zimyatov"] " bettered Ellefsæter’s winning time by 1:21, six years after the equipment revolution of fiberglass skis in 1974."] "\n"] [:button {:id "button527552", :class "btn btn-default"} "Details"] [:script {} "$('#button527552').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "Intermediate 1"] [:th {:style "display: none", :class "split"} "Intermediate 2"] [:th {:style "display: none", :class "split"} "Intermediate 3"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "23"] [:td {} [:a {:href "/athletes/85476"} "Ole Ellefsæter"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "2-28:45.8"] [:td {:class "split", :style "display: none"} "47:53.8 (2)"] [:td {:class "split", :sty