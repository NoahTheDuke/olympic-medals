19019631"} "12.5 kilometres Pursuit, Men"] "\n" [:option {:value "19019632"} "15 kilometres Mass Start, Men"] "\n" [:option {:value "19019633"} "20 kilometres, Men"] "\n" [:option {:value "19019634"} "4 × 7.5 kilometres Relay, Men"] "\n" [:option {:value "19019635"} "7.5 kilometres Sprint, Women"] "\n" [:option {:value "19019637"} "12.5 kilometres Mass Start, Women"] "\n" [:option {:value "19019638"} "15 kilometres, Women"] "\n" [:option {:value "19019639"} "4 × 6 kilometres Relay, Women"] "\n" [:option {:value "19019640"} "4 × 6 kilometres Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1594"} "2002"] "\n" [:option {:value "1609"} "2006"] "\n" [:option {:value "923492"} "2010"] "\n" [:option {:value "350028"} "2014"] "\n" [:option {:value "9000226"} "2018"] "\n" [:option {:value "15000036"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/134"} "Event type"]] [:h1 {:class "event_title"} "10 kilometres Pursuit, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "13 February 2022 — 17:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2138"} "Zhangjiakou Nordic Centre and Biathlon Centre, Chongli District, Zhangjiakou City, Hebei Province"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19019636"} "57 from 25 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Starting margin based on results of 7.5 kilometer. Penalty loop (150 metres) skied for each missed target."]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/137711"} "Marte Olsbu Røiseland"] " won her fourth medal of Beijing 2022, adding gold in the pursuit to the sprint gold, relay gold, and 15 km bronze. She ran a lonely race in the pursuit and celebrated a wire-to-wire victory. She crushed the field with just one penalty loop, winning by 1:36.5 from Sweden’s " [:a {:href "/athletes/148988"} "Elvira Öberg"] ". It was the largest margin of victory in any women’s Olympic biathlon event. Starting with a lead of 32.4 seconds after the sprint, she increased the margin to almost two minutes after the last shooting, easily maintaining her advantage on the last loop. After three mistakes, Öberg needed a clean shoot, and fast final loop, to improve on her sixth place, which she did to take silver from " [:a {:href "/athletes/128184"} "Tiril Eckhoff"] "."] "\n\n" [:p {} "Behind them, an intense battle for bronze broke out on the final lap, and Eckhoff finally secured the bronze medal with a furious final sprint, putting two Norwegians on the podium. Still seventh after the last shooting, she overtook " [:a {:href "/athletes/127919"} "Dorothea Wierer"] " (Italy), " [:a {:href "/athletes/147892"} "Hanna Sola"] " (Belarus), and " [:a {:href "/athletes/127326"} "Lisa Theresa Hauser"] " (Austria) to capture the bronze."] "\n\n" [:p {} [:a {:href "/athletes/137712"} "Ingrid Landmark Tandrevold"] " had the best prospects, leaving the range after the fourth shooting in third place. But the 25-year-old Norwegian struggled with major problems in the last kilometre and collapsed at the finish. She lost more than one and a half minutes to Eckhoff, the fastest skier on the final loop. Luckily, the Norwegian team doctor gave Tandrevold the all-clear a little later, but she still cancelled her starts in the relay and mass start."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Misses"] [:th {} "Start Behind"] [:th {} "Race"] [:th {} "Shooting 1 Misses"] [:th {} "Shooting 1"] [:th {} "Shooting