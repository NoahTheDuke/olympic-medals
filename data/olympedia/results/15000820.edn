value "15000810"} "Singles, Women"] "\n" [:option {:value "15000817"} "Doubles, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "350422"} "2014"] "\n" [:option {:value "9000747"} "2018"] "\n" [:option {:value "19020317"} "2022"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/1007"} "Event type"]] [:h1 {:class "event_title"} "Team Relay, Mixed" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "12 February 2026 — 18:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2202"} "Eugenio Monti Sliding Centre, Cortina d'Ampezzo, Belluno"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/15000820"} "54 from 9 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Curves: 16" [:br {}] "Finish Altitude: 1255 m" [:br {}] "Length: 1278 m" [:br {}] "Maximum Gradient: 18°" [:br {}] "Start Altitude: 1308 m" [:br {}] "Vertical Drop: 95 m"]]]] [:div {:class "description"} [:p {} "The luge team relay was on the Olympic programme for the fourth time, and the event had always won by Germany and the German (men’s) double was on the team each time. " [:a {:href "/athletes/127856"} "Tobias Wendl"] " and " [:a {:href "/athletes/127853"} "Tobias Arlt"] " had thus won four consecutive gold medals as an identical team. The gold in Cortina brought them to a total of seven golds and one bronze medal to become the most successful German athletes at the Olympic Winter Games. Wendl and Arlt, both born within two weeks in June 1987 and 38-years-old in Cortina, became the oldest gold medallists in luge of any country. In 2026, for the first time at the Olympics, the luge relay consisted of four legs with the addition of the women’ double."] "\n\n" [:p {} "As the last relay team in the event, the Germans, with individual gold medallists " [:a {:href "/athletes/148430"} "Julia Taubitz"] " and " [:a {:href "/athletes/148431"} "Max Langenhan"] ", Wendl/Arlt and women’s doubles silver medallist " [:a {:href "/athletes/137315"} "Dajana Eitberger"] " and " [:a {:href "/athletes/156568"} "Magdalena Matschina"] ", dominated with the best times on all four legs. In total they beat the well-balanced silver team from Austria by more than half-a-second, reproducing the 1-2 result from Beijing 2022."] "\n\n" [:p {} "The Austrian team consisted of " [:a {:href "/athletes/147864"} "Lisa Schulte"] ", " [:a {:href "/athletes/156075"} "Jonas Müller"] ", and the doubles pairs of " [:a {:href "/athletes/136737"} "Thomas Steu"] " / " [:a {:href "/athletes/119464"} "Wolfgang Kindl"] " and " [:a {:href "/athletes/1500139"} "Selina Egle"] " / " [:a {:href "/athletes/156056"} "Lara Kipp"] ". Kindl moved from the singles’ leg to the doubles and Selina followed her sister " [:a {:href "/athletes/136733"} "Madeleine Egle"] " as compared to Beijing. Austria had won bronze (2018) and silver (2022) in the relay before."] "\n\n" [:p {} "The Italian team, consisted of the two gold winning doubles teams, but they had only the third best times in their respective runs. For Italy it was the first medal in this event. Their team roster was " [:a {:href "/athletes/148494"} "Verena Hofer"] " and " [:a {:href "/athletes/127946"} "Dominik Fischnaller"] " in the singles and " [:a {:href "/athletes/127948"} "Emanuel Rieder"] " / " [:a {:href "/athletes/2300493"} "Simon Kainzwaldner"] " and  " [:a {:href "/athletes/127945"} "Andrea Vötter"] " / " [:a {:href "/athletes/2301530"} "Marion Oberhofer"] " in the doubles. Nevertheless, they held on to win bronze with a narrow margin ahead of Latvia and the USA. Behind these five teams there was a gap of almost 3.5 seconds to sixth place."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Leg Rank"] [:th {} "Reaction"] [:th {} "Intermediate 1"] [:th {} "Intermediate 2"] [:th {} "Exchange"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "Germany"] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "3:41.672"] [:td {} "–"] [:td {} "– (–)"] [:td {} "– (–)"] [:td {} "– (–)"] [:td {} "– (–)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "9-1"] [:td {} [:a {:href "/athletes/148430"} "Julia Taubitz"] " "] [:td {}] [:td {} "55.633"] [:td {} "1"] [:td {} "1.796 (6)"] [:td {} "19.790 (3)"] [:td {} "37.412 (2)"] [:td {} "55.633 (1)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "9-2"] [:td {} [:a {:href "/athletes/127856"} "Tobias Wendl"] " / " [:a {:href "/athletes/127853"} "Tobias Arlt"] " "] [:td {}] [:td {} "55.219"] [:td {} "1"] [:td {} "1.659 (1)"] [:td {} "19.372 (1)"] [:td {} "36.977 (1)"] [:td {} "1:50.852 (1)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "9-3"] [:td {} [:a {:href "/athletes/148431"} "Max Langenhan"] " "] [:td {}] [:td {} "54.691"] [:td {} "1"] [:td {} "1.564 (3)"] [:td {} "19.218 (2)"] [:td {} "36.710 (2)"] [:td {} "2:45.543 (1)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "9-4"] [:td {} [:a {:href "/athletes/137315"} "Dajana Eitberger"] " / " [:a {:href "/athletes/156568"} "Magdalena Matschina"] " "] [:td {}] [:td {} "56.129"] [:td {} "1"] [:td {} "1.948 (5)"] [:td {} "20.030 (5)"] [:td {} "37.760 (3)"] [:td {} "– (–)"] [:td {}] [:td {}]