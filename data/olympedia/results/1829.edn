ion {:value "1839"} "Aerials, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "905282"} "1988"] "\n" [:option {:value "905471"} "1992"] "\n" [:option {:value "1809"} "1994"] "\n" [:option {:value "1849"} "2002"] "\n" [:option {:value "1869"} "2006"] "\n" [:option {:value "924283"} "2010"] "\n" [:option {:value "350212"} "2014"] "\n" [:option {:value "9000508"} "2018"] "\n" [:option {:value "19020056"} "2022"] "\n" [:option {:value "15000493"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/295"} "Event type"]] [:h1 {:class "event_title"} "Aerials, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "16 – 18 February 1998"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/81"} "Iizuna Kogen Resort, Iizuna"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1829"} "25 from 14 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Inrun Distance: 60 m" [:br {}] "Inrun Gradient: ?" [:br {}] "Kicker #1: 4.50 m - 55° - 2.05 m" [:br {}] "Kicker #2: 6.10 m - 63° - 2.85 m" [:br {}] "Kicker #3: 7.15 m - 64° - 2.95 m" [:br {}] "Kicker #4: 8.10 m - 65° - 3.05 m" [:br {}] "Kicker #5: 8.00 m - 66° - 3.18 m" [:br {}] "Kicker #6: 8.00 m - 66° - 3.20 m" [:br {}] "Landing Distance: 30 m" [:br {}] "Landing Gradient: 37°" [:br {}] "Start Elevation: ?" [:br {}] "Table Distance: 22 m" [:br {}] "Vertical Drop: ?"]]]] [:div {:class "description"} [:p {} "The favorite was Canada’s " [:a {:href "/athletes/85779"} "Nicolas Fontaine"] ", who had won the 1997 World Championship and was leading the World Cup in 1997-98. Also considered was American " [:a {:href "/athletes/84047"} "Eric Bergoust"] ", who in 1997 had won his first World Cup event. Both made it thru qualifying, but did not come up to their usual standard, with Bergoust fourth and Fontaine eighth, as the qualifying was led by Belarus’s " [:a {:href "/athletes/99797"} "Dmitry Dashchinsky"] ". Practicing before the final, Bergoust sustained a bad crash, landing on his chest and it was not clear if he could continue. But he elected to try to compete. In the opening round of the final, Bergoust scored 133.05 on a back full-double full-full (bFdFF), considered the highest ever for single jump, which put him well into the lead over France’s " [:a {:href "/athletes/85802"} "Sébastien Foucras"] ", with Fontaine third. Bergoust’s second jump, a back double full-full-full (bdFFF) gave him 255.64 points, a new world’s best for the moguls, breaking Fontaine’s best mark. Fontaine fell on his landing in the second round and finished only 10th. Bergoust had competed at the 1994 Winter Olympics, finishing seventh, and would compete again in 2002 and 2006, but with less success."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/84047"} "Eric Bergoust"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "232.61 (4)"] [:td {} "255.64 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/85802"} "Sébastien Foucras"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flag