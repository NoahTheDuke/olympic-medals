tion {:value "16912"} "Half-Lightweight (≤65 kilograms), Men"] "\n" [:option {:value "16988"} "Lightweight (≤71 kilograms), Men"] "\n" [:option {:value "17060"} "Half-Middleweight (≤78 kilograms), Men"] "\n" [:option {:value "17130"} "Middleweight (≤86 kilograms), Men"] "\n" [:option {:value "17191"} "Half-Heavyweight (≤95 kilograms), Men"] "\n" [:option {:value "17307"} "Extra-Lightweight (≤48 kilograms), Women"] "\n" [:option {:value "17356"} "Half-Lightweight (≤52 kilograms), Women"] "\n" [:option {:value "17405"} "Lightweight (≤56 kilograms), Women"] "\n" [:option {:value "17451"} "Half-Middleweight (≤61 kilograms), Women"] "\n" [:option {:value "17504"} "Middleweight (≤66 kilograms), Women"] "\n" [:option {:value "17549"} "Half-Heavyweight (≤72 kilograms), Women"] "\n" [:option {:value "17595"} "Heavyweight (&gt;72 kilograms), Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "15091"} "1964"] "\n" [:option {:value "15351"} "1972"] "\n" [:option {:value "15646"} "1976"] "\n" [:option {:value "16004"} "1980"] "\n" [:option {:value "16385"} "1984"] "\n" [:option {:value "16794"} "1988"] "\n" [:option {:value "18008"} "1996"] "\n" [:option {:value "18747"} "2000"] "\n" [:option {:value "19475"} "2004"] "\n" [:option {:value "260537"} "2008"] "\n" [:option {:value "316678"} "2012"] "\n" [:option {:value "354880"} "2016"] "\n" [:option {:value "18001172"} "2020"] "\n" [:option {:value "2007052"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/348"} "Event type"]] [:h1 {:class "event_title"} "Heavyweight (&gt;95 kilograms), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "27 July 1992"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/691"} "Palau Blaugrana, Barcelona"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/17253"} "28 from 28 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Two single-elimination pools, with winner of each pool advanced to the final. All judoka losing to the finalists in each pool advanced to repêchage pools, with the winners of the repêchage pools earning bronze medals."]]]] [:div {:class "description"} [:p {} "Japan’s " [:a {:href "/athletes/34176"} "Naoya Ogawa"] " had won the World Championships in 1989 in both heavyweight and open class. He had been upset at the 1991 Worlds by Russian Sergei Kosorotov in the heavyweights. In the 1991 Worlds open class, Ogawa won, defeating Georgia’s " [:a {:href "/athletes/33892"} "Davit Khakhaleishvili"] " in the final. But with the former Soviet Union competing in 1992 as the Unified Team, only one athlete could represent them in this class, and Kosorotov was passed over for Khakhaleishvili. He and Ogawa were the two favorites, with the edge given to the Japanese. Ogawa did not disappoint early, winning his four pool matches, all in less than three minutes, two by " [:em {} "ippon"] ". Khakhaleishvili had been less impressive, winning his first match by " [:em {} "ippon"] ", but then needing the time limit to win his next three matches. But the final was dominated by the Georgian, as Khakhaleishvili threw Ogawa twice with " [:em {} "tani-otoshi"] " to win the gold medal in 1:04 by " [:em {} "waza-ari-wasete ippon"] ". France’s " [:a {:href "/athletes/33680"} "David Douillet"] " won one bronze medal, but would soon become the dominant " [:em {} "judoka"] " in this division, winning the 1996 and 2000 Olympic titles, and three World Championships in 1993 and 1995, winning both the heavyweight and open classes in 1995. Ogawa continued judo through the 1996 Olympics, where he placed fifth, also winning bronze medals at the 1993 and 1995 World Championships. But he was then recruited to become a professional wrestler, and later turned to mixed martial arts, competing under the name “Captain Hustle.”"] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/33892"} "Davit Khakhaleishvili"]] [:td {} [:a {:href "/countries/EUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/EUN.png"}] "EUN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/34176"} "Naoya Ogawa"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/33680"} "David Douillet"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/34575"} "Imre Csősz"]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=5"] [:td {} [:a {:href "/athletes/34093"} "Frank Moreno"]] [:td {} [:a {:href "/countries/CUB"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CUB.png"}] "CUB"