location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "37048"} "1964"] "\n" [:option {:value "37114"} "1968"] "\n" [:option {:value "37192"} "1972"] "\n" [:option {:value "37251"} "1976"] "\n" [:option {:value "37314"} "1980"] "\n" [:option {:value "37377"} "1984"] "\n" [:option {:value "37454"} "1988"] "\n" [:option {:value "37533"} "1992"] "\n" [:option {:value "37710"} "2000"] "\n" [:option {:value "37805"} "2004"] "\n" [:option {:value "262873"} "2008"] "\n" [:option {:value "329046"} "2012"] "\n" [:option {:value "396246"} "2016"] "\n" [:option {:value "19001195"} "2020"] "\n" [:option {:value "2002945"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/630"} "Event type"]] [:h1 {:class "event_title"} "Volleyball, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "20 July –  3 August 1996"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/741"} "The Omni Coliseum, Atlanta, Georgia"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/37610"} "134 from 12 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Round-robin pools advanced teams to classification matches."]]]] [:div {:class "description"} [:p {} "For the first time, the women’s tournament consisted of 12 teams, separated into two pools of six, followed by medal elimination matches. The teams were selected as follows: host nation (United States), World Cup (Cuba, Brazil, China), Continental Qualifiers (Korea, Canada, Germany, Peru), and qualifying tournaments (Russia, Japan, Netherlands, Ukraine)"] "\n\n" [:p {} "Cuba was easily the best team in the world. They had won the 1992 Olympic gold medal and the 1994 World Championships, and every other tournament they entered in the interim. But they were fortunate to get out of group play, losing two matches, and finishing only third in Group B behind Brazil and Russia. In the quarter-finals they were drawn against their arch-rival, the United States, and crushed them – 1, 10, and 12. The semi-finals saw Cuba play Brazil, who had defeated them very easily in straight sets in their group. This match was much closer, going five sets, with Cuba winning 15-12 in the fifth. In the final, Cuba faced China, World Champions in 1982 and 1986. China’s female volleyball fortunes had fallen off considerably since then, but they had replaced their coach with former star player " [:a {:href "/athletes/52134"} "Lang Ping"] ". This seemed to be the boost they needed and they reached the final undefeated. China won the first set of the final, 16-14, but Cuba came back to win the next three sets and the gold medal. The medal ceremony was tainted by booing and whistling from the American crowd when Cuba was awarded their gold medals."] "\n"] [:button {:id "button991204", :class "btn btn-default"} "Details"] [:script {} "$('#button991204').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {}] [:th {} "Pos"] [:th {} "Number"] [:th {} "Team"] [:th {} "NOC"] [:th {:style "display: none", :class "split"} "Matches Played"] [:th {:style "display: none", :class "split"} "Wins"] [:th {:style "display: none", :class "split"} "Losses"] [:th {:style "display: none", :class "split"} "Points"] [:th {:style "display: none", :class "split"} "Sets"] [:th {:style "display: none", :class "split"} "Set Ratio"] [:th {:style "display: none", :class "split"} "Points"] [:th {:style "display: none", :class "split"} "Points Ratio"] [:th {:style "display: none", :class "split"} "Side Outs"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {:class "accordion-toggle", :data-toggle "collapse", :data-tar