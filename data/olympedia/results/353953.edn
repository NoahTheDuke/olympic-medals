e Olympian and twice Olympic Champion in the single sculls, took bronze."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/121441"} "Martin Sinković"] " / " [:a {:href "/athletes/121485"} "Valent Sinković"]] [:td {} [:a {:href "/countries/CRO"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CRO.png"}] "CRO"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/112353"} "Mindaugas Griškonis"] " / " [:a {:href "/athletes/122503"} "Saulius Ritter"]] [:td {} [:a {:href "/countries/LTU"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/LTU.png"}] "LTU"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/120078"} "Kjetil Borch"] " / " [:a {:href "/athletes/39146"} "Olaf Tufte"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/123082"} "Francesco Fossi"] " / " [:a {:href "/athletes/123099"} "Romano Battisti"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {} [:a {:href "/athletes/134048"} "Jonathan Walton"] " / " [:a {:href "/athletes/134046"} "John Collins"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: