8"} "Double Sculls, Men"] "\n" [:option {:value "159388"} "Quadruple Sculls, Men"] "\n" [:option {:value "159400"} "Coxless Pairs, Men"] "\n" [:option {:value "159415"} "Coxless Fours, Men"] "\n" [:option {:value "159427"} "Eights, Men"] "\n" [:option {:value "159436"} "Lightweight Double Sculls, Men"] "\n" [:option {:value "159456"} "Lightweight Coxless Fours, Men"] "\n" [:option {:value "159471"} "Single Sculls, Women"] "\n" [:option {:value "159486"} "Double Sculls, Women"] "\n" [:option {:value "159498"} "Quadruple Sculls, Women"] "\n" [:option {:value "159507"} "Coxless Pairs, Women"] "\n" [:option {:value "159519"} "Eights, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "159701"} "2000"] "\n" [:option {:value "159879"} "2004"] "\n" [:option {:value "261138"} "2008"] "\n" [:option {:value "319156"} "2012"] "\n" [:option {:value "354122"} "2016"] "\n" [:option {:value "19008589"} "2020"] "\n" [:option {:value "2012585"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/402"} "Event type"]] [:h1 {:class "event_title"} "Lightweight Double Sculls, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "22 – 28 July 1996"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/718"} "Lake Sidney Lanier, Gainesville, Georgia"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/159527"} "33 from 16 countries"]]]]] [:div {:class "description"} [:p {} "Women’s lightweight rowing events were held for the first time at the Olympics in 1996, but they had been held at the World Championships since the mid-1980s. " [:a {:href "/athletes/36043"} "Colleen Miller"] " and " [:a {:href "/athletes/36067"} "Wendy Wiebe"] " of Canada had won the event at the last three editions of the Worlds and were the strong favorites to take the inaugural crown in Atlanta. In the opening round, however, they were outperformed by " [:a {:href "/athletes/39484"} "Constanţa Burcică"] " and " [:a {:href "/athletes/39507"} "Camelia Macoviciuc"] " of Romania, as well as " [:a {:href "/athletes/36451"} "Berit Christoffersen"] " and " [:a {:href "/athletes/36450"} "Lene Andersson"] " of Denmark. The Danes were the reigning World runners-up, while Burcică was a 1992 Olympic silver medalist in the quadruple sculls. The Canadians heat was also the slowest of the opening round, with both the Americans, 1994 World bronze medalists " [:a {:href "/athletes/40442"} "Lindsay Burns"] " and " [:a {:href "/athletes/40435"} "Teresa Bell"] ", and the Australians, " [:a {:href "/athletes/35327"} "Virginia Lee"] " and " [:a {:href "/athletes/35324"} "Rebecca Joyce"] ", posting faster times than the Romanians as they won their heats. The Americans and the Australians were again the heat winners in the semi-finals, the latter of whom helped to eliminate the favored Canadians. The situation turned again in the final, when Romania regrouped and captured the gold medal by a margin of nearly two seconds. The Americans, in winning silver, were almost two seconds ahead of the Australians, who battled the Italians down to the line to take bronze with only 0.27 seconds to spare."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/39484"} "Constanţa Burcică"] " / " [:a {:href "/athletes/39507"} "Camelia Macoviciuc"]] [:td {} [:a {:href "/countries/ROU"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.a