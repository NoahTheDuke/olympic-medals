0"} "Double Sculls, Men"] "\n" [:option {:value "260994"} "Quadruple Sculls, Men"] "\n" [:option {:value "261007"} "Coxless Pairs, Men"] "\n" [:option {:value "261021"} "Coxless Fours, Men"] "\n" [:option {:value "261034"} "Eights, Men"] "\n" [:option {:value "261043"} "Lightweight Double Sculls, Men"] "\n" [:option {:value "261063"} "Lightweight Coxless Fours, Men"] "\n" [:option {:value "261076"} "Single Sculls, Women"] "\n" [:option {:value "261101"} "Double Sculls, Women"] "\n" [:option {:value "261111"} "Quadruple Sculls, Women"] "\n" [:option {:value "261120"} "Coxless Pairs, Women"] "\n" [:option {:value "261130"} "Eights, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "159527"} "1996"] "\n" [:option {:value "159701"} "2000"] "\n" [:option {:value "159879"} "2004"] "\n" [:option {:value "319156"} "2012"] "\n" [:option {:value "354122"} "2016"] "\n" [:option {:value "19008589"} "2020"] "\n" [:option {:value "2012585"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/402"} "Event type"]] [:h1 {:class "event_title"} "Lightweight Double Sculls, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "10 – 17 August 2008"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/819"} "Shunyi Aolinpike Shuishang Gongyuan, Mapo, Shunyi"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/261138"} "34 from 17 countries"]]]]] [:div {:class "description"} [:p {} "The women’s lightweight double sculls at the 2008 Summer Olympics was a relatively open event, as no nation had been particularly dominant at the recent World Championships and Romania, the defending Olympic champion, did not send a crew to this event in Beijing. Furthermore, only Australia was represented by a World Championship-winning crew, 2007 victors " [:a {:href "/athletes/117945"} "Marguerite Houston"] " and " [:a {:href "/athletes/104210"} "Amber Halliday"] ". Germany sent 2005 World Champion " [:a {:href "/athletes/117955"} "Marie-Louise Dräger"] ",who was joined by " [:a {:href "/athletes/117954"} "Berit Carow"] ", while China’s 2006 World Champion, " [:a {:href "/athletes/104203"} "Xu Dongxiang"] ", made an appearance for the host nation with " [:a {:href "/athletes/92502"} "Yu Hua"] ". Greece’s " [:a {:href "/athletes/38061"} "Khrysa Biskitzi"] " and " [:a {:href "/athletes/117956"} "Alexandra Tsiavou"] ", meanwhile, had won the event at the European Championships when it was resurrected in 2007, while Cuba’s " [:a {:href "/athletes/117950"} "Yaima Velázquez"] " and " [:a {:href "/athletes/104216"} "Ismaray Marrero"] " were the reigning Pan American champions."] "\n\n" [:p {} "Two of the opening heats were won by China and Germany, but it was the Netherlands’ " [:a {:href "/athletes/92642"} "Kirsten van der Kolk"] " and " [:a {:href "/athletes/92646"} "Marit van Eupen"] ", the 2004 Olympic bronze medalists, who posted the fastest time. Following the 2004 Games, this duo had had internal struggles relating to their different training attitudes and broke up, with Van der Kolk quitting the sport and Van Eupen going on to win the women’s lightweight single sculls at the 2005, 2006, and 2007 World Championships. In 2007, however, they reunited to compete in Beijing. Both Cuba and Australia were eliminated in the semi-finals, in heats won by the Netherlands and the Canadian duo of " [:a {:href "/athletes/117948"} "Melanie Kok"] " and " [:a {:href "/athletes/117949"} "Tracy Cameron"] ". Canada had been the 2007 Pan American Games bronze medalist, albeit with a different crew. In the final, Germany, Canada, and the Finnish duo of " [:a {:href "/athletes/117951"} "Sanna Stén"] " and " [:a {:href "/athletes/117952"} "Minna Nieminen"] " were neck and neck for the first half of the course, but Finland pulled ahead while Germany and Canada slowly fell back and were passed by the Netherlands. Even Finland eventually succumbed to the drive of the Dutch crew, however, and surrendered the gold medal to van der Kolk and van Eupen. Thus Stén and Nieminen, the 2007 World runners-up and 2005 bronze medalists, took silver, Finland’s first Olympic rowing medal since " [:a {:href "/athletes/36779"} "Pertti Karppinen"] " had won the men’s single sculls three consecutive times from 1976 through 1984. The battle for bronze was much tighter and a photo finish was required to determine that the Canadians had edged out the Germans by 0.04 seconds."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/92642"} "Kirsten van der Kolk"] " / " [:a {:href "/athletes/92646"} "Marit van Eupen"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/117951"} "Sanna Stén"] " / " [:a {:href "/athletes/117952"} "Minna Nieminen"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/117948"} "Melanie Kok"] " / " [:a {:href "/athletes/117949"} "Tracy Cameron"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; ver