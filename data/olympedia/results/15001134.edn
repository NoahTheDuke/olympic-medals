001101"} "1,000 metres, Men"] "\n" [:option {:value "15001102"} "1,500 metres, Men"] "\n" [:option {:value "15001103"} "5,000 metres, Men"] "\n" [:option {:value "15001104"} "10,000 metres, Men"] "\n" [:option {:value "15001105"} "Mass Start, Men"] "\n" [:option {:value "15001110"} "Team Pursuit (8 laps), Men"] "\n" [:option {:value "15001124"} "500 metres, Women"] "\n" [:option {:value "15001125"} "1,000 metres, Women"] "\n" [:option {:value "15001126"} "1,500 metres, Women"] "\n" [:option {:value "15001127"} "3,000 metres, Women"] "\n" [:option {:value "15001128"} "5,000 metres, Women"] "\n" [:option {:value "15001129"} "Mass Start, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1151"} "2006"] "\n" [:option {:value "924528"} "2010"] "\n" [:option {:value "350672"} "2014"] "\n" [:option {:value "9001058"} "2018"] "\n" [:option {:value "19020434"} "2022"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/542"} "Event type"]] [:h1 {:class "event_title"} "Team Pursuit (6 laps), Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "14 – 17 February 2026"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2201"} "Milano Speed Skating Stadium, Fiera Milano Rho, Rho, Milano, ITA"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/15001134"} "26 from 8 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination event."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/19020434"} "2:53.44"] " / " [:a {:href "/athletes/127534"} "Ivanie Blondin"] " • " [:a {:href "/athletes/119809"} "Valérie Maltais"] " • " [:a {:href "/athletes/136920"} "Isabelle Weidemann"] " " [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"] " / 15 February 2022 / " [:a {:href "/records/event_name/542"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/2306865"} "Moyca Stoffel"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/1800303"} "Giovanni Talamini"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]]]]] [:div {:class "description"} [:p {} "At the Beijing Olympics, Canada had won the gold over Japan and Netherlands, and these three nations had also dominated the World Championships since these Games. Netherlands had recorded the fastest time at all three World Championships, but had only won two as in 2023 they were disqualified after their race because " [:a {:href "/athletes/156911"} "Joy Beune"] " had forgotten to wear her leg transponders to record times. Canada won that title, placing second in 2024 and third in 2025, while Japan placed second in 2023 and 2025 and third in 2024. In the 2025/206 World Cup, each of these teams had also won one race."] "\n\n" [:p {} "All of the three medal favourites won their quarterfinal race, and recorded the top three times, all in the 2:55 range. The United States, bronze medalist at the Worlds in 2023, was the fourth nation to qualify for the semi-finals. Canada, racing in the exact same formation as in 2022 - " [:a {:href "/athletes/136920"} "Isabelle Weidemann"] ", " [:a {:href "/athletes/127534"} "Ivanie Blondin"] ", and " [:a {:href "/athletes/119809"} "Valerie Maltais"] ", had no trouble beating their North American neighbours to qualify for the Olympic final for the third time. The other semi-final was very closely contested. In the quarter-finals, the difference had been 0.13 seconds in favour of the Japanese. They trailed they Dutch for 4.5 laps, but were in the lead by the bell. The Dutch managed to make up the difference, edging ahead by 0.11 at the finish line. The Japanese then had a relatively easy contest for bronze, clearly beating the Americans. In the final, the Netherlands moved to an expected early lead, but the Canadians picked up the pace earlier than usual, and were in the lead after four laps already. They gradually built out their lead to almost a second, securing an upset victory over the Dutch World Champions."] "\n\n" [:p {} "The Canadian win marked the first repeat victory since 2006-2010 (Germany), and the first repeat victory by the exact same team. For both Netherlands and Japan it was their third medal in the event, tying for the most medals by any country.  Both Belgium and Kazakhstan made their début in the event, but the Kazakhs were unable to compete in the final as " [:a {:href "/athletes/156811"} "Arina Ilyachshenko"] " injured herself with a fall in the quarter-finals. " [:a {:href "/athletes/119701"} "Miho Takagi"] ", skating for Japan, won her third bronze medal of the Games and 10th Olympic medal in total, making her the skater with the second most Olympic medals, behind only " [:a {:href "/athletes/109767"} "Ireen Wüst"] " (13)."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Canada"] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "ht