"} "Platform, Men"] "\n" [:option {:value "19002268"} "Synchronized Springboard, Men"] "\n" [:option {:value "19002279"} "Synchronized Platform, Men"] "\n" [:option {:value "19002290"} "Springboard, Women"] "\n" [:option {:value "19002318"} "Platform, Women"] "\n" [:option {:value "19002355"} "Synchronized Platform, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "54298"} "2000"] "\n" [:option {:value "54318"} "2004"] "\n" [:option {:value "259064"} "2008"] "\n" [:option {:value "309000"} "2012"] "\n" [:option {:value "353896"} "2016"] "\n" [:option {:value "2010746"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/258"} "Event type"]] [:h1 {:class "event_title"} "Synchronized Springboard, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "25 July 2021 — 15:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2105"} "Olympic Aquatics Centre, 2-1, 2chome, Tatsumi, Koto-ku, Tatsumi-no-Mori Seaside Park, Tokyo, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19002346"} "16 from 8 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "3 metres springboard. Five dives. Final round only."]]]] [:div {:class "description"} [:p {} "China’s " [:a {:href "/athletes/129588"} "Shi Tingmao"] " won two golds on her Olympic début at Rio and was back for more in Tokyo. Since the last Games, she had been the world’s leading springboard diver, winning both 3m springboard events at the 2017 and 2019 World Championships, as well as winning both at the 2018 World Cup."] "\n\n" [:p {} "With China’s excellent record in synchronized diving, Tingmao and " [:a {:href "/athletes/141673"} "Wang Han"] " were favourites to win the synchronised springboard gold medal, having occupied first and second place in the individual event at the Tokyo Olympics. Runners-up to them at the 2019 World Championships were the Canadian pair " [:a {:href "/athletes/116044"} "Jennifer Abel"] " and " [:a {:href "/athletes/141393"} "Mélissa Citrini-Beaulieu"] ", and they again finished second to the Chinese duo in Tokyo, despite lying sixth after two dives. The American pair of " [:a {:href "/athletes/147172"} "Alison Gibson"] " and " [:a {:href "/athletes/147175"} "Krysta Palmer"] " were joint second after their opening dive, and shared the lead after the second, but then fell away rapidly and ended up finishing last of eight. The Italian pair " [:a {:href "/athletes/1301897"} "Elena Bertocchi"] " and " [:a {:href "/athletes/2505324"} "Chiara Pellacani"] " looked set to take the bronze until being overtaken by the Germany’s " [:a {:href "/athletes/143289"} "Lena Hentschel"] " and " [:a {:href "/athletes/130352"} "Tina Punzel"] " in the fifth and final round."] "\n\n" [:p {} "Tingmao went on to win her third gold, adding to the two she won in Rio, but for Wang it was her first medal on her Olympic début at the age of 30. Canada’s Abel went one better than her bronze medal at London 2012 and made up for her disappointment at finishing fourth at Rio 2016. China won their fifth consecutive title and only at Sydney in 2000, when they won the silver medal, had they failed to win gold in the synchronised springboard event."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Points"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "People's Republic of China"] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olymped