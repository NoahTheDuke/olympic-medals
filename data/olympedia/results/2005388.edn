0"} "Speed, Men"] "\n" [:option {:value "2005408"} "Speed, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:span {} "Not held in other editions"]] " | " [:a {:href "/event_names/2665"} "Event type"]] [:h1 {:class "event_title"} "Boulder and Lead, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "6 – 10 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2161"} "Le Bourget Climbing Venue, La Bourget, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2005388"} "20 from 13 countries"]]]]] [:div {:class "description"} [:p {} "Slovenia’s " [:a {:href "/athletes/146543"} "Janja Garnbret"] ", the reigning Olympic champion from Tokyo 2020, entered Paris 2024 as the overwhelming favorite, and solidified her status as the greatest competition climber of her generation by winning her second consecutive Olympic gold medal. After a near-flawless bouldering performance - scoring 99.6 points in the semifinals -, Garnbret faced challenges in the final, including a finger injury sustained during the fourth boulder problem. Despite this setback, she delivered a strong lead climb, earning 84.1 points and securing a combined total of 168.5 points to capture the gold."] "\n\n" [:p {} "American climber " [:a {:href "/athletes/147160"} "Brooke Raboutou"] " arrived in Paris with strong momentum, having won both events in the Olympic Qualifier Series. She achieved a historic milestone by becoming the first U.S. woman to medal in Olympic sport climbing, scoring 84 points in bouldering and 72 in lead for a combined total of 156.0 points, earning the silver medal."] "\n\n" [:p {} "Austria’s " [:a {:href "/athletes/140861"} "Jessica Pilz"] " claimed the bronze with a total of 147.4 points. Her standout performance came in the lead discipline, where she scored 88.1 points, making up for a lower bouldering score of 59.3."] "\n\n" [:p {} "The reigning lead World champion and a strong medal contender, " [:a {:href "/athletes/151353"} "Ai Mori"] " (JPN) had previously defeated Garnbret in lead events. However, she faced difficulties in the bouldering round, scoring just 39 points. Despite a remarkable lead climb that earned her 96.1 points, Mori finished fourth overall with a combined score of 135.1. Controversy followed when fans argued that the bouldering routes were disadvantageous to shorter climbers like Mori, who struggled to reach the starting holds without a run-and-jump approach."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/146543"} "Janja Garnbret"]] [:td {} [:a {:href "/countries/SLO"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SLO.png"}] "SLO"]] [:td {} "195.7 (1)"] [:td {} "168.5 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "3"] [:td {} [:a {:href "/athletes/147160"} "Brooke Raboutou"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "155.8 (3)"] [:td {} "156.0 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "4"] [:td {} [:a {:href "/athletes/140861"} "Jessica Pilz"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]] [:td {} "156.9 (2)"] [