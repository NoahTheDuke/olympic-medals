ults/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "2475"} "1924"] "\n" [:option {:value "905002"} "1932"] "\n" [:option {:value "905198"} "1988"] "\n" [:option {:value "905418"} "1992"] "\n" [:option {:value "2481"} "1998"] "\n" [:option {:value "2557"} "2002"] "\n" [:option {:value "924070"} "2010"] "\n" [:option {:value "350096"} "2014"] "\n" [:option {:value "9000320"} "2018"] "\n" [:option {:value "19019760"} "2022"] "\n" [:option {:value "4006760"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/209"} "Event type"]] [:h1 {:class "event_title"} "Curling, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "13 – 24 February 2006"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/171"} "Palaghiaccio, Pinerolo"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2667"} "45 from 10 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Round-robin pool, followed by single-elimination medal round."]]]] [:div {:class "description"} [:p {} "After the disappointments of the 1998 and 2002 Olympics Canada had resumed its place as the world leaders in men’s curling. Randy Ferbey’s Edmonton rink had won three of the four world championships but they had performed badly at the Canadian trials, failing even to make the semi-final stage, and Canada would instead be represented by a Newfoundland rink led by former world junior champion " [:a {:href "/athletes/110167"} "Brad Gushue"] ". Canada’s rivals for gold appeared to be the Swedish team led by three-time world champion " [:a {:href "/athletes/100343"} "Peja Lindholm"] " and " [:a {:href "/athletes/110154"} "David Murdoch"] "’s Great Britain team."] "\n\n" [:p {} "Canada faltered in early play and had to rely on victories in their last two matches to reach the semi-finals as the Finnish team were the most impressive qualifiers. The host nation Italy, who had no great pedigree in the sport, shocked Canada, USA and Germany and threatened at one stage to be suprise semi-finallists."] "\n\n" [:p {} "The Finns edged out Britain in the first semi-final whilst Canada’s match against the USA was decided when the Americans gave up five shots on the ninth end. The Canada-Finland final was a tight affair at the half way stage but a series of Finnish errors gave up six shots on the sixth end and Finnish skip " [:a {:href "/athletes/102048"} "Markku Uusipaavalniemi"] " conceded with two ends still to play."] "\n\n" [:p {} "The composition of the Canadian team was unusual as, although Brad Gushue formed the team and was the nominal skip, the more experienced " [:a {:href "/athletes/110169"} "Russ Howard"] " called the shots which was the traditional skip’s role. Howard, who celebrated his 50th birthday during the Games, was the oldest Winter Olympic champion since fellow curler " [:a {:href "/athletes/100741"} "Robin Welsh"] " in 1924."] "\n\n" [:p {} "The USA defeated Great Britain for the bronze medal, America’s first in curling, in a match that was briefly interrupted by a streaker whose modesty was protected only by a strategically placed rubber chicken."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {}] [:th {} "Pos"] [:th {} "Team"] [:th {} "NOC"] [:th {} "Wins"] [:th {} "Losses"] [:th {} "Points"] [:th {} "Points"] [:th {} "Percentage"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {:class "accordion-toggle", :data-toggle "collapse", :data-target ".team-members-16763"} [:div {:class "glyphicon glyphicon-plus"}]] [:td {} "1"] [:td {} "Canada"] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "htt