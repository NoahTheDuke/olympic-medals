tion {:value "1233"} "Downhill, Women"] "\n" [:option {:value "1234"} "Giant Slalom, Women"] "\n" [:option {:value "1235"} "Slalom, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1195"} "1952"] "\n" [:option {:value "1205"} "1956"] "\n" [:option {:value "1215"} "1960"] "\n" [:option {:value "1239"} "1968"] "\n" [:option {:value "1288"} "1972"] "\n" [:option {:value "1317"} "1976"] "\n" [:option {:value "1332"} "1980"] "\n" [:option {:value "1343"} "1984"] "\n" [:option {:value "1358"} "1988"] "\n" [:option {:value "1384"} "1992"] "\n" [:option {:value "1410"} "1994"] "\n" [:option {:value "1436"} "1998"] "\n" [:option {:value "1462"} "2002"] "\n" [:option {:value "1490"} "2006"] "\n" [:option {:value "924544"} "2010"] "\n" [:option {:value "350002"} "2014"] "\n" [:option {:value "9000102"} "2018"] "\n" [:option {:value "19019502"} "2022"] "\n" [:option {:value "15001400"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/31"} "Event type"]] [:h1 {:class "event_title"} "Giant Slalom, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 2 February 1964 — 16:16"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/58"} "Axamer Lizum, Axams"] " (Brigitzköpfel)"]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1225"} "96 from 28 countries"]]] [:tr {:class "referees", :style ""} [:th {} "Course Setter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002535"} "Hubert Spieß"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Gates: 75" [:br {}] "Length: 1250 m" [:br {}] "Start Altitude: 2100 m" [:br {}] "Vertical Drop: 530 m"]]]] [:div {:class "description"} [:p {} "This was the last Olympic giant slalom to be held as a single race for men, as from 1968, there would be two runs for the men. The women would continue to compete on a single run until 1980, when their event was also expanded to two runs. The favorite was " [:a {:href "/athletes/99240"} "Egon Zimmermann"] ", who only three days before had won gold in the downhill, and was the defending World Champion. His biggest competition was expected to come from his teammate, " [:a {:href "/athletes/97312"} "Karl Schranz"] ", runner-up in the event at the 1962 Worlds, and World Champion in the downhill and combined. A third Austrian, " [:a {:href "/athletes/97851"} "Pepi Stiegler"] ", silver medalist at Squaw Valley, was the first starter and posted a time of 1:48.05, which eventually won him the bronze medal. The second skier was " [:a {:href "/athletes/84244"} "François Bonlieu"] ", a veteran of the French ski team even though he was only 26, having won a silver medal at the 1954 World Championships in the slalom when he was only 16. Bonlieu had also won a bronze in the event at the 1958 Worlds, and his run in Innsbruck enabled him to take the lead, with 1:46.71. Karl Schranz was the last skier off among the seeded racers, starting 15th. He skied well, besting Stiegler for silver, but not overcome Bonlieu’s time, which won the gold medal. Bonlieu later worked as a mountain guide, and would be murdered on the boardwalk in Cannes after an argument."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "2"] [:td {} [:a {:href "/athletes/842