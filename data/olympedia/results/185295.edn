el Vaillancourt"] " (CAN), " [:a {:href "/athletes/12385"} "François Mathy"] " (BEL), and " [:a {:href "/athletes/11374"} "Debbie Johnsey"] " (GBR). In the jump-off Vaillancourt won the silver medal with 4.00 faults, Mathy taking bronze with 8.00 faults, while Johnsey dropped off the podium with 15.25 faults."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "Horse"] [:th {} "NOC"] [:th {} "Faults"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "81"] [:td {} [:a {:href "/athletes/12711"} "Alwin Schockemöhle"]] [:td {} [:i {} [:a {:href "/horses/2653"} "Warwick Rex"]]] [:td {} [:a {:href "/countries/FRG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRG.png"}] "FRG"]] [:td {} "0.00"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "39"] [:td {} [:a {:href "/athletes/12887"} "Michel Vaillancourt"]] [:td {} [:i {} [:a {:href "/horses/332"} "Branch County"]]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {} "12.00"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "23"] [:td {} [:a {:href "/athletes/12385"} "François Mathy"]] [:td {} [:i {} [:a {:href "/horses/956"} "Gai Luron"]]] [:td {} [:a {:href "/countries/BEL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BEL.png"}] "BEL"]] [:td {} "12.00"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "63"] [:td {} [:a {:href "/athletes/11374"} "Debbie Johnsey"]] [:td {} [:i {} [:a {:href "/horses/