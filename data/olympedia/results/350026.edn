350023"} "12.5 kilometres Pursuit, Men"] "\n" [:option {:value "350024"} "15 kilometres Mass Start, Men"] "\n" [:option {:value "350025"} "20 kilometres, Men"] "\n" [:option {:value "350027"} "7.5 kilometres Sprint, Women"] "\n" [:option {:value "350028"} "10 kilometres Pursuit, Women"] "\n" [:option {:value "350029"} "12.5 kilometres Mass Start, Women"] "\n" [:option {:value "350030"} "15 kilometres, Women"] "\n" [:option {:value "350031"} "4 × 6 kilometres Relay, Women"] "\n" [:option {:value "350032"} "2 × 6 kilometres and 2 × 7.5 kilometres Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1518"} "1968"] "\n" [:option {:value "1523"} "1972"] "\n" [:option {:value "1528"} "1976"] "\n" [:option {:value "1534"} "1980"] "\n" [:option {:value "1540"} "1984"] "\n" [:option {:value "1546"} "1988"] "\n" [:option {:value "1552"} "1992"] "\n" [:option {:value "1563"} "1994"] "\n" [:option {:value "1575"} "1998"] "\n" [:option {:value "1588"} "2002"] "\n" [:option {:value "1603"} "2006"] "\n" [:option {:value "923486"} "2010"] "\n" [:option {:value "9000224"} "2018"] "\n" [:option {:value "19019634"} "2022"] "\n" [:option {:value "15000034"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/132"} "Event type"]] [:h1 {:class "event_title"} "4 × 7.5 kilometres Relay, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "22 February 2014 — 18:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/889"} "Kompleks Dlya Sorevnovaniy Po Lyzhnym Gonkam i Biatlonu Laura, Mountain Cluster, Krasnaya Polyana"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/350026"} "76 from 19 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Eight shots for each group of five targets. Penalty loop (150 metres) skied for each missed target."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 7,741 m" [:br {}] "Height Differential: 31 m" [:br {}] "Maximum Climb: 31 m" [:br {}] "Shooting 1: Prone at 2.574 km, 50 m range" [:br {}] "Shooting 2: Standing at 5.107 km, 50 m range" [:br {}] "Total Climbing: 258 m"]]]] [:div {:class "description"} [:p {} "Norway was favored in this event coming in to Sochi, as they had not been beaten at the World Championships since 2008. Russia had come to Sochi looking for multiple medals in biathlon but had struggled. The team’s benefactor was Russian billionaire Mikhail Prokhorov, who owned the NBA’s Brooklyn Nets, but as the Games neared their end, Prokhorov said he would resign as President of the Russian Biathlon Union if they did not improve their performance. And that they did by winning the final biathlon gold medal of the Sochi Olympics in the men’s relay."] "\n\n" [:p {} "Norway took the early lead, with the brothers " [:a {:href "/athletes/118590"} "Tarjei Bø"] " and " [:a {:href "/athletes/128188"} "Johannes Thingnes Bø"] " leading after the first two legs. Russia was third, as Germany’s " [:a {:href "/athletes/127808"} "Erik Lesser"] " moved his team into second. It had been a very disappointing Winter Olympics for the German biathletes, but " [:a {:href "/athletes/127807"} "Daniel Böhm"] " held onto second after the second leg. Norwegian biathlon legend, " [:a {:href "/athletes/84154"} "Ole Einar Bjørndalen"] ", looking for his record 14th Winter Olympic medal, skiied the third leg, and shot cleanly. But his skiing was slower than usual, and " [:a {:href "/athletes/118509"} "Arnd Peiffer"] " moved Germany only 2 seconds back, with Russia another 15 seconds behind. Norway’s anchor leg was " [:a {:href "/athletes/111029"} "Emil Hegle Svendsen"] ", who had won gold in Sochi in the mass start race, but had been sick throughout the Games. He shot very poorly on his leg, missing four targets and dropped completely off the podium as they would finish fourth."] "\n\n" [:p {} "The gold and silver medals came down to a race between the Russian and German anchor skiiers – " [:a {:href "/athletes/118508"} "Anton Shipulin"] " and " [:a {:href "/athletes/118583"} "Simon Schempp"] ". Schempp shot better, needing only 2 extra shots to hit all his targets, to Shipulin’s 4, but he could not match Shipulin’s speed over the snow and Shipulin came home in front by 3.5 seconds. Austria won the bronze medal, almost 30 seconds back, with Norway well behind in fourth."] "\n\n" [:p {} "And that was how the results stood until February 2020, when the International Biathlon Union (IBU) disqualified " [:a {:href "/athletes/118609"} "Yevgeny Ustyugov"] " (RUS) after a re-test of samples from 2013 revealed the presence of oxandrolone. As a result, Ustyugov was stripped of all his results from  the 2013-14 season and was disqualified from all five events in which he competed at Sochi. His relay disqualification would cost Russia the gold medal. Ustyugov appealed to the Court of Arbitration for Sport (CAS) which was rejected in November 2024, and then appealed to the Swiss Federal Tribunal. That appeal was (finally) rejected in May 2025, clearing the way for the IOC to re-distribute the medals in the event."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Misses"] [:th {} "Extra Shots"] [:th {} "Shooting 1 Misses"] [:th {} "Shooting 1 Extra Shots"] [:th {} "Shooting 1"] [:th {} "Shooting 2 Misses"] [:th {} "Shooting 2 Extra Shots"] [:th {} "Shooting 2"] [:th {} "Exchange"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1"] [:td {} "Germany"] [:td