n"] "\n" [:option {:value "1066"} "1,500 metres, Men"] "\n" [:option {:value "1067"} "5,000 metres, Men"] "\n" [:option {:value "1068"} "10,000 metres, Men"] "\n" [:option {:value "1069"} "500 metres, Women"] "\n" [:option {:value "1070"} "1,000 metres, Women"] "\n" [:option {:value "1071"} "1,500 metres, Women"] "\n" [:option {:value "1073"} "5,000 metres, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1012"} "1960"] "\n" [:option {:value "1020"} "1964"] "\n" [:option {:value "1028"} "1968"] "\n" [:option {:value "1036"} "1972"] "\n" [:option {:value "1045"} "1976"] "\n" [:option {:value "1054"} "1980"] "\n" [:option {:value "1063"} "1984"] "\n" [:option {:value "1082"} "1992"] "\n" [:option {:value "1092"} "1994"] "\n" [:option {:value "1106"} "1998"] "\n" [:option {:value "1120"} "2002"] "\n" [:option {:value "1149"} "2006"] "\n" [:option {:value "924526"} "2010"] "\n" [:option {:value "350670"} "2014"] "\n" [:option {:value "9001056"} "2018"] "\n" [:option {:value "19020427"} "2022"] "\n" [:option {:value "15001127"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/540"} "Event type"]] [:h1 {:class "event_title"} "3,000 metres, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "23 February 1988 — 18:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/14"} "Olympic Oval, Calgary"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1072"} "29 from 16 countries"]]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/1063"} "4:24.79"] " / " [:a {:href "/athletes/81847"} "Andrea Schöne"] " " [:a {:href "/countries/GDR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GDR.png"}] "GDR"] " / 15 February 1984 / " [:a {:href "/records/event_name/540"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"}] [:td {} [:a {:href "/countries/UNK"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UNK.png"}] "UNK"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"}] [:td {} [:a {:href "/countries/UNK"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UNK.png"}] "UNK"]]]]] [:div {:class "description"} [:p {} "The 3,000 m was set to be an all-East German affair. At the five international 3,000 ms held in the 1987-1988 season, five East Germans had divided the medals. Three of them had won a race, and all three of them were racing in Calgary: " [:a {:href "/athletes/82326"} "Gabi Zange"] ", " [:a {:href "/athletes/81028"} "Karin Kania"] " and " [:a {:href "/athletes/81847"} "Andrea Ehrig"] ". In fact, these three women had occupied the podium at the 1984 Olympics, when Ehrig had beaten Kania and Zange for the title. In the present season, Kania had won the World Cup races in Berlin and Butte, while Ehrig had won in Davos and at the European Championships. Zange had won the World Cup in Calgary, " [:em {} "en passant"] " breaking the world record and lowering it to 4:16.76. That record had been in the hands of " [:a {:href "/athletes/82921"} "Yvonne van Gennip"] ", who had skated 4:16.85 in Heerenveen the previous season. But van Gennip had suffered from various injuries in the past months, and had recovered only just in time for the Olympics."] "\n\n" [:p {} "The race started dramatically, with Ehrig racing against Kania. The latter took off at an insane pace. Barely half-way through the race, Kania had a five-second advantage on Zange’s world record. Unsurprisingly, she hit the wall, and barely made it to the finish line, needing almost 40 seconds for the final lap. Ehrig, in the meanwhile, had been able to keep her pace, setting a world record of 4:12.09, well below the old mark. Zange herself, riding in the third pair, approximately matched her own world record (4:16.92), which was enough to beat Kania, but not Ehrig. Van Gennip was behind the leading times for the entire race, but not by far. With her final lap, she made up for the 0.63 second deficit, and crossed the line in 4:11.94, for a very surprising gold medal. It would be the first of her three Olympic titles in Calgary, matching the feat of her compatriot " [:a {:href "/athletes/97231"} "Ard Schenk"] " in 1972."] "\n"] [:button {:id "button146399", :class "btn btn-default"} "Details"] [:script {} "$('#button146399').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "200 m"] [:th {:style "display: none", :class "split"} "600 m"] [:th {:style "display: none", :class "split"} "1000 m"] [:th {:style "display: none", :class "split"} "1400 m"] [:th {:style "display: none", :class "split"} "1800 m"] [:th {:style "display: none", :class "split"} "2200 m"] [:th {:style "display: none", :class "split"} "2600 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "4I"] [:td {} [:a {:href "/athletes/82921"} "Yvonne van Gennip"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "4:11.94"] [:td {:class "split", :style "display: none"} "20.00"] [:td {:class "split", :style "display: none"} "5