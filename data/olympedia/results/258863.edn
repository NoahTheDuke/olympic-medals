alue "258824"} "Canadian Singles, Slalom, Men"] "\n" [:option {:value "258832"} "Canadian Doubles, Slalom, Men"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255438"} "1972"] "\n" [:option {:value "256065"} "1992"] "\n" [:option {:value "256201"} "1996"] "\n" [:option {:value "256310"} "2000"] "\n" [:option {:value "256430"} "2004"] "\n" [:option {:value "307020"} "2012"] "\n" [:option {:value "353600"} "2016"] "\n" [:option {:value "19006326"} "2020"] "\n" [:option {:value "2008437"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/181"} "Event type"]] [:h1 {:class "event_title"} "Kayak Singles, Slalom, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "13 – 15 August 2008"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/819"} "Shunyi Aolinpike Shuishang Gongyuan, Mapo, Shunyi"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/258863"} "21 from 21 countries"]]]]] [:div {:class "description"} [:p {} "Two former Olympic women’s K-1 slalom champions, " [:a {:href "/athletes/9386"} "Štěpánka Hilgertová"] " of the Czech Republic (1996 and 2000) and " [:a {:href "/athletes/10714"} "Elena Kaliská"] " (2004) returned to the Games in 2008 to vie for glory once more. Kaliská had been the 2005 European and 2006 World Champion, as well as the 2007 World runner-up, while Hilgertová was the 2008 European champion, the 2005 European runner-up, and the 2007 European and World bronze medalist. Germany’s " [:a {:href "/athletes/105094"} "Jennifer Bongardt"] " was the 2007 World Champion , the 2006 European runner-up, and the 2006 World bronze medalist, while Austria’s " [:a {:href "/athletes/90126"} "Violetta Oblinger-Peters"] " was the 2007 European champion."] "\n\n" [:p {} "Kaliská had the highest score in the qualification round, while Hilgertová and Bongardt were third and fourth respectively behind China’s " [:a {:href "/athletes/105100"} "Li Jingjing"] ". Oblinger-Peters, meanwhile, was sixth. The Beijing Olympics introduced a one-round semi-final for the remaining 15 participants, which eliminated Li and Bongardt. Kaliská won this round as well, with Hilgertová third behind France’s " [:a {:href "/athletes/116614"} "Emilie Fer"] ", who was then relatively unknown, but who would go on to win the event at the 2012 Summer Olympics. Oblinger-Peters, meanwhile, sank even further to seventh. These rankings were unchanged after the first run of the final, and Kaliská won the second run by a large margin and successfully defended her Olympic title. Oblinger-Peters, meanwhile, finally improved her position to third, which, due to Fer and Hilgertová finishing seventh and ninth respectively, was sufficient to earn her a bronze medal. Sandwiched in the middle was Australia’s " [:a {:href "/athletes/116615"} "Jacqui Lawrence"] ", who had been fourth after the first run, but was second in the final portion and collected enough points to capture the silver medal."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "3"] [:td {} [:a {:href "/athletes/10714"} "Elena Kaliská"]] [:td {} [:a {:href "/countries/SVK"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SVK.png"}] "SVK"]] [:td {} "186.19 (1)"] [:td {} "97.13 (1)"] [:td {} "192.64 (1)"] [:td {} [:span {:class "Gold"} "Gol