tes/55894"} "Viktor Mitrou"] " based on lower bodyweight."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Kilograms"] [:th {} "Bodyweight"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/104562"} "Taner Sağır"]] [:td {} [:a {:href "/countries/TUR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/TUR.png"}] "TUR"]] [:td {} "375.0"] [:td {} "76.10"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/56634"} "Sergey Filimonov"]] [:td {} [:a {:href "/countries/KAZ"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KAZ.png"}] "KAZ"]] [:td {} "372.5"] [:td {} "76.65"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/104564"} "Reyhan Arabacıoğlu"]] [:td {} [:a {:href "/countries/TUR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/TUR.png"}] "TUR"]] [:td {} "360.0"] [:td {} "76.04"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/55894"} "Viktor Mitrou"]] [:td {} [:a {:href "/countries/GRE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GRE.png"}] "GRE"]] [:td {} "360.0"] [:td {} "76.11"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {} [:a {:href "/athletes/94938"} "Mohamed Hossein Barkhah"]] [:td {} [:a {:href "/coun