lesov was World Champion in 1962-63 and would win again in 1965."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Round Eliminated"] [:th {} "Bad Points"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "2"] [:td {} [:a {:href "/athletes/60488"} "Anatoly Kolesov"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "4"] [:td {} [:a {:href "/athletes/57474"} "Kiril Petkov"]] [:td {} [:a {:href "/countries/BUL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BUL.png"}] "BUL"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "8"] [:td {} [:a {:href "/athletes/60103"} "Bertil Nyström"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "16"] [:td {} [:a {:href "/athletes/59626"} "Bolesław Dubicki"]] [:td {} [:a {:href "/countries/POL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/POL.png"}] "POL"]] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=5"] [:td {:class "bib"} "11"] [:td {} [:a {:href "/athletes/58637"} "Antal Rizmayer"]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2p