n"] "\n" [:option {:value "255094"} "Kayak Singles, 10,000 metres, Men"] "\n" [:option {:value "255095"} "Kayak Doubles, 1,000 metres, Men"] "\n" [:option {:value "255102"} "Kayak Doubles, 10,000 metres, Men"] "\n" [:option {:value "255104"} "Canadian Singles, 1,000 metres, Men"] "\n" [:option {:value "255106"} "Canadian Singles, 10,000 metres, Men"] "\n" [:option {:value "255107"} "Canadian Doubles, 1,000 metres, Men"] "\n" [:option {:value "255114"} "Kayak Singles, 500 metres, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255019"} "1936"] "\n" [:option {:value "255045"} "1948"] "\n" [:option {:value "255080"} "1952"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/173"} "Event type"]] [:h1 {:class "event_title"} "Canadian Doubles, 10,000 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "30 November 1956 — 16:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/399"} "Lake Wendouree, Ballarat, Victoria"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/255113"} "20 from 10 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Final only."]]]] [:div {:class "description"} [:p {} "Canoeing’s 10000 metre distance events appeared for the last time at the 1956 Summer Olympics. Bronze medalists " [:a {:href "/athletes/9902"} "Egon Drews"] " and " [:a {:href "/athletes/9984"} "Wilfried Soltau"] " of Germany were the only 1952 Olympic podium finishers in the C-2 10000 to return to the 1956 edition, although France’s " [:a {:href "/athletes/9624"} "Georges Dransart"] " had been a bronze medalist in 1948. Dransart was also the 1950 World runner-up and was partnered with " [:a {:href "/athletes/9671"} "Marcel Renaud"] " in Melbourne. The reigning World Champion and runner-up was Hungary, although it was represented by a new duo of " [:a {:href "/athletes/10053"} "Imre Farkas"] " and " [:a {:href "/athletes/10069"} "József Hunics"] " at these Games, while the bronze medalist Czechoslovakians sent no one at all. This left no particularly strong favorites, although it was still somewhat of a surprise that the Soviet duo of " [:a {:href "/athletes/10969"} "Pavel Kharin"] " and " [:a {:href "/athletes/10950"} "Gratsian Botev"] " outperformed the entire field and won by a considerable margin over Dransart and Renaud. The Hungarians, meanwhile, came in for bronze, just ahead of the Germans. The C-2 10000 would not be Kharin and Botev’s only success in Melbourne, as they would take silver in the C-2 1000 the following day."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {} "Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/10969"} "Pavel Kharin"] " / " [:a {:href "/athletes/10950"} "Gratsian Botev"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "54:02.4"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/9624"} "Georges Dransart"] " / " [:a {:href "/athletes/9671"} "Marcel Renaud"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "54:48.3"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/10