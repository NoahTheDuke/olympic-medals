location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "43504"} "1984"] "\n" [:option {:value "43511"} "1988"] "\n" [:option {:value "43518"} "1992"] "\n" [:option {:value "43524"} "2000"] "\n" [:option {:value "43534"} "2004"] "\n" [:option {:value "261870"} "2008"] "\n" [:option {:value "323000"} "2012"] "\n" [:option {:value "353194"} "2016"] "\n" [:option {:value "2000250"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/605"} "Event type"]] [:h1 {:class "event_title"} "Duet, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "2 –  4 August 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2105"} "Olympic Aquatics Centre, 2-1, 2chome, Tatsumi, Koto-ku, Tatsumi-no-Mori Seaside Park, Tokyo, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19001980"} "44 from 22 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Top 12 duos from qualifying advanced to final free routine."]]]] [:div {:class "description"} [:p {} "Women from Russia had won the artistic duet swimming (known prior to 2017 as synchronized swimming) for the past six editions of the Olympics. Competing under the banner of “Russian Olympic Committee athletes”, as Russia had been banned from competing under its own flag due to its large-scale doping programs, " [:a {:href "/athletes/116137"} "Svetlana Romashina"] " and " [:a {:href "/athletes/131616"} "Svetlana Kolesnichenko"] " were aiming to extend that streak. Romashina had an impressive competitive history: she had captured Olympic gold in the duet with " [:a {:href "/athletes/116134"} "Nataliya Ishchenko"] " in 2012 and 2016 and in the team event from 2008 through 2016. Since 2005, she had won 21 titles at the World Championships and 13 at the Europeans, never placing lower than first. Kolesnichenko was only relatively less decorated: she had team gold from the 2016 Rio Games, 16 titles from the World Championships, and 11 from the Europeans."] "\n\n" [:p {} "As expected, the Russians, with a routine themed around spiders, took gold comfortably, making Romashina the first artistic swimmer to earn six Olympic gold medals. The Chinese duo of " [:a {:href "/athletes/116141"} "Huang Xuechen"] " and " [:a {:href "/athletes/122364"} "Sun Wenyan"] ", who had been the runners-up in Rio, repeated their silver medal performance in Tokyo with a snake-themed routine. Huang in particular had a history of coming second to the Russians – and Romashina – with silver medals at the Worlds stretching back to 2009. The Ukrainian duo of " [:a {:href "/athletes/147035"} "Marta Fiedina"] " and " [:a {:href "/athletes/131987"} "Anastasiya Savchuk"] ", meanwhile, captured bronze, the country’s first Olympic medal in the sport. Both had won numerous medals at the World and European Championships across various disciplines, Fiedina since 2018 and Savchuk since 2014. Japan’s " [:a {:href "/athletes/120837"} "Yukiko Inui"] ", who had hoped to defend her bronze medal from Rio with a new partner, " [:a {:href "/athletes/144456"} "Megumu Yoshida"] ", placed fourth. The most unfortune duo, however, were the Greeks, who were poised to qualify for the final after the technical routine, but had to withdraw following a positive COVID-19 test from one of the team members."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/131616"} "Svetlana Kolesnichenko"] " / " [:a {:href "/athletes/116137"} "Svetlana Romashina"