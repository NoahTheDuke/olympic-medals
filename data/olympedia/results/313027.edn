12240"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/317"} "Event type"]] [:h1 {:class "event_title"} "Parallel Bars, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "28 July –  7 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/872"} "North Greenwich Arena, Greenwich, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/313027"} "71 from 33 countries"]]]]] [:div {:class "description"} [:p {} "As the reigning World Champion, " [:a {:href "/athletes/126655"} "Danell Leyva"] " of the United States was a favorite to win the gold medal in the men’s parallel bars event at the 2012 Summer Olympics. His podium spot was far from assured, however, and his greatest challengers would be China’s " [:a {:href "/athletes/122117"} "Feng Zhe"] ", 2010 World and Asian Games Champion and 2009 world runner-up, and " [:a {:href "/athletes/111934"} "Marcel Nguyen"] " of Germany, winner of the two most recent European Championships. Alongside a host of other strong competitors, it was believed that the podium would be dominated by these three men but, in a surprising twist, Leyva failed to make the final, placing 12th overall and ending up in reserve position. The qualification round was won by the Tanaka brothers of Japan, " [:a {:href "/athletes/120643"} "Yusuke"] " and " [:a {:href "/athletes/120639"} "Kazuhito"] ", while Feng placed third and Nguyen sixth."] "\n\n" [:p {} "The final was unique in that there were nine gymnasts competing: " [:a {:href "/athletes/122116"} "Zhang Chenglong"] " of China, the 2010 high bar World Champion, and " [:a {:href "/athletes/111944"} "Hamilton Sabot"] " of France, 2010 European bronze medalist in the parallel bars, had tied on difficulty and execution points (and thus, on total score) and were both permitted to advance. By the midway point in the finals, the tournament had already been decided: Feng’s high difficulty, combined with the second best execution score of the round, put him comfortably ahead of the rest of the competition and earned him the gold medal. Ngyuen had a lower difficulty but a higher execution score, placing him below Feng but well above third place to win the silver. Sabot, meanwhile, made the most of his lucky qualification and finished third, 0.066 points ahead of Kazuhito Tanaka, making him the first (and only) French gymnastics medalist of the Games."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "102"] [:td {} [:a {:href "/athletes/122117"} "Feng Zhe"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "144"] [:td {} [:a {:href "/athletes/111934"} "Marcel Nguyen"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "124"] [:td {} [:a {:href "/athletes/111944"} "Hamilton Sabot"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "162"] [:td {} [:a {:href "/athletes/120639"} "Kazuhito Tanaka"]] [:td {} [:a {:href "/countries/JPN"