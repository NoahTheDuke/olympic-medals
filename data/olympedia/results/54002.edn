results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "54001"} "1906"] "\n" [:option {:value "54030"} "1912"] "\n" [:option {:value "54054"} "1920"] "\n" [:option {:value "54082"} "1924"] "\n" [:option {:value "54104"} "1928"] "\n" [:option {:value "54118"} "1932"] "\n" [:option {:value "54122"} "1936"] "\n" [:option {:value "54126"} "1948"] "\n" [:option {:value "54132"} "1952"] "\n" [:option {:value "54144"} "1956"] "\n" [:option {:value "54157"} "1960"] "\n" [:option {:value "54171"} "1964"] "\n" [:option {:value "54183"} "1968"] "\n" [:option {:value "54195"} "1972"] "\n" [:option {:value "54207"} "1976"] "\n" [:option {:value "54219"} "1980"] "\n" [:option {:value "54231"} "1984"] "\n" [:option {:value "54243"} "1988"] "\n" [:option {:value "54255"} "1992"] "\n" [:option {:value "54268"} "1996"] "\n" [:option {:value "54284"} "2000"] "\n" [:option {:value "54304"} "2004"] "\n" [:option {:value "259050"} "2008"] "\n" [:option {:value "309102"} "2012"] "\n" [:option {:value "353784"} "2016"] "\n" [:option {:value "19002234"} "2020"] "\n" [:option {:value "2010634"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/251"} "Event type"]] [:h1 {:class "event_title"} "Platform, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "20 – 24 July 1908"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/216"} "White City Stadium, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/54002"} "24 from 6 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "5 and 10 metres platforms."]]]] [:div {:class "description"} [:p {} "There were two platforms used, one of 5 metres and one of 10 metres.  Each competitor made seven dives, four compulsory and three optional in each round.  Two compulsory dives were made from the 5-metre platform, a running plain dive and a backward somersault; and two were made from the 10-metre platform, a standing plain dive and a running plain dive.  The optional dives were made from the 10-metre platform."] "\n\n" [:p {} "Sweden dominated this event, advancing seven to the semi-finals, and having the first four finishers in the final.  America’s Polish émigré " [:a {:href "/athletes/51350"} "George Gaidzik"] " was a favorite, as he had won the 1908 British highboard championship earlier in the summer.  Gaidzik got the highest total in the first round but he performed very poorly in the finals.  " [:a {:href "/athletes/50410"} "Hjalmar Johansson"] " dominated the finals, and had trailed only Gaidzik in the qualifying rounds.  He was the diving champion of Sweden from 1897 through 1908, except for 1900 and 1903 (when he lived in London).  He was also an accomplished swimmer, holding the Swedish record for the 100 breaststroke at the time of the 1908 Olympics.  The two other Swedish medalists, " [:a {:href "/athletes/50445"} "Karl Malmström"] " and " [:a {:href "/athletes/50473"} "Arvid Spångberg"] ", were relative newcomers to diving."] "\n\n" [:p {} "In the preliminaries to this event, " [:a {:href "/athletes/47225"} "George Cane"] " (GBR) had a poor dive and passed out upon landing.  Spectators and officials were not certain why he was not leaving the pool.  Hjalmar Johansson, the eventual gold medalist, realized what had happened and dove in to rescue Cane.  Fortunately, Cane was quickly revived and sustained no major injuries."] "\n\n" [:p {} "In the semi-finals, George Gaidzik (USA), one of the favorites, finished 3rd and did not qualify for the final.  He was actually briefly disqualified, as one of the judges felt he was receiving signals (coaching) from a teammate on the ground.  The judges’ scores for Gaidzik were as follows:  one gave him an 8, a 6, and a 9; one gave him a 9 for each dive; while the third judge scored him 0 for each dive, and disqualified him, based on the above reasoning.  The Americans protested and, after consideration by the judges, the protest was upheld, and Gaidzik was advanced as an extra diver to the final."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/50410"} "Hjalmar Johansson"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "78.40 (1 h2)"] [:td {} "80.75 (1 h2)"] [:td {} "83.75 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/50445"} "Karl Malmström"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "73.95 (2 h2)"] [:td {} "67.00 (2 h1)"] [:td {} "78.73 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/50473"} "Arvid Spångberg"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "79.20 (1 h4)"] [:td {} "72.30 (1 h1)"] [:td {} "74.00 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/50345"} "Robert Andersson"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.ama