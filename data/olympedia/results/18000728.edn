723"} "Rapid-Fire Pistol, 25 metres, Men"] "\n" [:option {:value "18000731"} "Small-Bore Rifle, Three Positions, 50 metres, Men"] "\n" [:option {:value "18000737"} "Trap, Men"] "\n" [:option {:value "18000740"} "Skeet, Men"] "\n" [:option {:value "18000743"} "Air Pistol, 10 metres, Women"] "\n" [:option {:value "18000746"} "Sporting Pistol, 25 metres, Women"] "\n" [:option {:value "18000751"} "Air Rifle, 10 metres, Women"] "\n" [:option {:value "18000754"} "Small-Bore Rifle, Three Positions, 50 metres, Women"] "\n" [:option {:value "18000760"} "Trap, Women"] "\n" [:option {:value "18000763"} "Skeet, Women"] "\n" [:option {:value "18000766"} "Air Pistol, 10 metres, Team, Mixed"] "\n" [:option {:value "18000769"} "Air Rifle, 10 metres, Team, Mixed"] "\n" [:option {:value "18000772"} "Trap, Team, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "51759"} "1984"] "\n" [:option {:value "51789"} "1988"] "\n" [:option {:value "51835"} "1992"] "\n" [:option {:value "51884"} "1996"] "\n" [:option {:value "51935"} "2000"] "\n" [:option {:value "51994"} "2004"] "\n" [:option {:value "261387"} "2008"] "\n" [:option {:value "321012"} "2012"] "\n" [:option {:value "395711"} "2016"] "\n" [:option {:value "2013108"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/454"} "Event type"]] [:h1 {:class "event_title"} "Air Rifle, 10 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "25 July 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2104"} "Asaka Shooting Range, Nerima, Tokyo"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/18000728"} "47 from 32 countries"]]]]] [:div {:class "description"} [:p {} "The men’s 10 m air rifle was held for the 10th consecutive time at the Olympics. In Tokyo it was again the second shooting event for men and the first of now only two rifle events for men. The format of the qualification round was unchanged, but the format of the final round was also changed to the new format of a maximum of 24 shots for the final two shooters. The three medallists " [:a {:href "/athletes/135792"} "Sergey Kamensky"] " (gold), " [:a {:href "/athletes/117298"} "Petar Gorša"] " (silver), and " [:a {:href "/athletes/142000"} "Miran Maricić"] " (bronze) from the 2018 World Championships all competed in Tokyo, but none of them reached the final. Also, the world record holders for the qualification rounds " [:a {:href "/athletes/93074"} "Péter Sidi"] " and for the final round, Yu Haonan (CHN), did not compete in Tokyo. While Yu did not qualify for the Games, Sidi was suspended by the Hungarian shooting federation related to a doping violation."] "\n\n" [:p {} "In the qualification round, " [:a {:href "/athletes/133193"} "Yang Haoran"] " set an Olympic record with 632.7, missing the standing world record only by 0.8. He was followed by " [:a {:href "/athletes/136350"} "Lucas Kozeniesky"] " and " [:a {:href "/athletes/147455"} "Will Shaner"] " both representing the United States, while his compatriot " [:a {:href "/athletes/141876"} "Sheng Lihao"] " finished eighth to qualify for the final just 0.1 ahead of " [:a {:href "/athletes/143819"} "Mahyar Sedaghat"] " who finished ninth. In the final Shaner took the lead after the eighth shot and held onto that position until the end, to win the first rifle gold medal for the United States since " [:a {:href "/athletes/104767"} "Matt Emmons"] " won the 50 m small-bore rifle prone event in 2004. Sheng won silver and Yang settled for bronze."] "\n\n" [:p {} "Silver medallist Sheng Lihao, born on 4 December 2004, was not only the youngest male shooting competitor in Tokyo but became the youngest ever Olympic medallist in shooting aged 16 years 233 days, surpassing the record previously held by " [:a {:href "/athletes/42497"} "Ulrike Holmer"] " who was 16-301 when winning a silver medal back in 1984. Also participating in this event were the first ever shooters for Kosovo " [:a {:href "/athletes/145058"} "Drilon Ibrahimi"] " and Afghanistan " [:a {:href "/athletes/140401"} "Mahdi Yovari"] "."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "2129"] [:td {} [:a {:href "/athletes/147455"} "Will Shaner"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "630.8 (3)"] [:td {} "251.6 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "1219"] [:td {} [:a {:href "/athletes/141876"} "Sheng Lihao"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} "629.2 (8)"] [:td {} "250.9 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "1220"] [:td {} [:a {:href "/athletes/133193"} "Yang Haoran"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} "632.7 (1)"] [:td {} "229.4 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "2081"] [:td {} [:a {:hr