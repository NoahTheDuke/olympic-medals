ical-align: top;"} "Olympic Record  (Ranking Round, 216 arrows)"] [:td {} [:a {:href "/results/40957"} "2,031"] " " [:span {:class "label label-primary"} "WR"] " / " [:a {:href "/athletes/1973"} "Jang Yong-Ho"] " • " [:a {:href "/athletes/1974"} "Kim Bo-Ram"] " • " [:a {:href "/athletes/1978"} "Oh Gyo-Mun"] " " [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"] " / 28 July 1996 / " [:a {:href "/records/event_name/2/Ranking%20Round,%20216%20arrows"} "Details"]]]]] [:div {:class "description"} [:p {} "Korea had won every major international event since 2003, including the 2004 Olympics, the 2005 and 2007 World Championships, and the 2006 Asian Championships. Korea led the ranking round and had an opening round bye. They then won two close matches against Poland and China to move into the final against Italy. The final was also closely fought but Korea hung on to win, 227-225, defending their gold medal. In the bronze medal match China faced Ukraine, the 2004 bronze medalists, with China winning 222-219."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Republic of Korea"] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/102882"} "Im Dong-Hyeon"] " • " [:a {:href "/athletes/111540"} "Lee Chang-Hwan"] " • " [:a {:href "/athletes/102883"} "Park Gyeong-Mo"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Italy"] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s