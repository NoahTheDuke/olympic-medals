automatic timing uncovered later, she had won the race by 0.05, but, in 1948, both runners where given the same hand time."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "692"] [:td {} [:a {:href "/athletes/73711"} "Fanny Blankers-Koen"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "11.3 (1 h1)"] [:td {} "11.4 (1 h1)"] [:td {} "11.2 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "735"] [:td {} [:a {:href "/athletes/68659"} "Maureen Gardner"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {} "11.6 (1 h2)"] [:td {} "11.8 (3 h2)"] [:td {} "11.2 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "668"] [:td {} [:a {:href "/athletes/64579"} "Shirley Strickland"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]] [:td {} "11.9 (2 h3)"] [:td {} "11.7 (1 h2)"] [:td {} "11.4 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "732"] [:td {} [:a {:href "/athletes/67982"} "Yvette Monginou"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; ve