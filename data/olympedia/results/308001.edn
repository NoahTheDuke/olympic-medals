value "308003"} "Individual Time Trial, Men"] "\n" [:option {:value "308002"} "Individual Time Trial, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "154567"} "1984"] "\n" [:option {:value "154673"} "1988"] "\n" [:option {:value "154793"} "1992"] "\n" [:option {:value "154918"} "1996"] "\n" [:option {:value "155045"} "2000"] "\n" [:option {:value "155175"} "2004"] "\n" [:option {:value "259030"} "2008"] "\n" [:option {:value "356866"} "2016"] "\n" [:option {:value "19001702"} "2020"] "\n" [:option {:value "2003682"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/242"} "Event type"]] [:h1 {:class "event_title"} "Road Race, Individual, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "29 July 2012 — 12:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/877"} "The Mall, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/308001"} "66 from 35 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Distance: 140.3 km"]]]] [:div {:class "description"} [:p {} "Following " [:a {:href "/athletes/113223"} "Mark Cavendish"] "’s disappointing finish far outside of the podium in the men’s road race the previous day, the host nation of the 2012 Olympics pinned its hopes on " [:a {:href "/athletes/126952"} "Elizabeth Armitstead"] " to capture its first medal of the Games. She would be supported by teammates that included " [:a {:href "/athletes/103694"} "Nicole Cooke"] ", who had won the 2008 Olympic road race, and " [:a {:href "/athletes/113075"} "Emma Pooley"] ", a former British road race titleholder and Olympic time trial medalist. The favorite in the race, however, was considered to be " [:a {:href "/athletes/113070"} "Marianne Vos"] " of the Netherlands who, among numerous other accolades, had won the Olympic Points Race four years earlier in Beijing, the last two editions of the Giro d’Italia Femminile, and silver medals in the road race at the last five World Championships (in addition to her victory at the 2006 edition). Other strong competitors were Italy’s " [:a {:href "/athletes/103714"} "Giorgia Bronzini"] ", who was the World Champion in the event in 2010 and 2011, " [:a {:href "/athletes/126596"} "Shelley Olds"] " of the strong United States team, and Germany’s " [:a {:href "/athletes/90397"} "Ina-Yoko Teutenberg"] ", the bronze medalist from the 2011 World Championships, all of whom were thought to be capable of a powerful sprint finish. A notable absence was France’s " [:a {:href "/athletes/13167"} "Jeannie Longo-Ciprelli"] ", who had appeared in every edition of the Olympic women’s road race since its inception in 1984 (a then-joint record of seven appearances for a woman) and was its champion in 1996."] "\n\n" [:p {} "London rains soaked the course before and throughout the race and helped keep the breakaways down during the first 100km. With 40 km left to go, however, an otherwise innocuous breakaway by Russian " [:a {:href "/athletes/120531"} "Olga Zabelinskaya"] " turned into a serious threat when she was joined by Vos and, soon after, Armitstead and Olds. When Olds punctured a tire, the field was reduced to three and the breakaway was firmly established, the intermittent downpours now working in the leaders’ favor by keeping the rest of the pack at bay. The final moments came down to the strong sprinting powers of Vos and Armitstead and, in the end, Vos took home the gold. Armitstead’s silver finish was Britain’s first medal of the Games and was followed later in the day by a bronze from " [:a {:href "/athletes/115710"} "Becky Adlington"] " in the " [:a {:href "/results/322049"} "Women’s 400 metre freestyle"] ". Zabelinskaya finished in third for the road race bronze, following the footsteps of her father " [:a {:href "/athletes/16736"} "Sergey Sukhoruchenkov"] ", who had won the men’s road race at the 1980 Summer Olympics."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time/Margin"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "8"] [:td {} [:a {:href "/athletes/113070"} "Marianne Vos"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "3-35:29"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "2"] [:td {} [:a {:href "/athletes/126952"} "Lizzie Armitstead"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {} "same time"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "29"] [:td {} [:a {:href "/athletes/120531"} "Olga Zabelinskaya"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]] [:td {} "at 0:02"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "11"] [:td {} [:a {:href "/athletes/90397"} "Ina-Yoko Teutenberg"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "at 0:27"] [:td {}] [:td {}] [:td 