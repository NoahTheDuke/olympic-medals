n"] "\n" [:option {:value "2030"} "30 kilometres (Classical), Men"] "\n" [:option {:value "2031"} "50 kilometres (Freestyle), Men"] "\n" [:option {:value "2032"} "4 × 10 kilometres Relay, Men"] "\n" [:option {:value "2036"} "5 kilometres (Classical), Women"] "\n" [:option {:value "2040"} "15 kilometres (Classical), Women"] "\n" [:option {:value "2041"} "30 kilometres (Freestyle), Women"] "\n" [:option {:value "2037"} "5/10 kilometres Pursuit, Women"] "\n" [:option {:value "2042"} "4 × 5 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "2047"} "1994"] "\n" [:option {:value "2067"} "1998"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/189"} "Event type"]] [:h1 {:class "event_title"} "10/15 kilometres Pursuit, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "13 February 1992"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/11"} "Les Saisies"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2027"} "102 from 39 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "10 kilometres (Classical) style race on day one. On day two, runners left in order of their finish in the 10 kilometres (Classical), based on time differential, and skiied 15 kilometres (Freestyle), with final placements determined by finish of that race."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: ?" [:br {}] "Height Differential: 112 m" [:br {}] "Maximum Climb: 67 m" [:br {}] "Total Climbing: 615 m"]]]] [:div {:class "description"} [:p {} "This was the first time the pursuit was contested at the Winter Olympics, and it would not feature at the World Championships until the next year. The event consisted of results from the 10 km individual race, skied in the classical style. In the second section, skiers skied 15 km freestyle, starting in the order of their placements from the 10 km. Thus, the first skier across the line was the winner of the race. The 10 km champion had been " [:a {:href "/athletes/98479"} "Vegard Ulvang"] ", who started 19 seconds ahead of " [:a {:href "/athletes/83518"} "Marco Albarello"] ", 20 seconds ahead of " [:a {:href "/athletes/92065"} "Christer Majbäck"] ", and 25 seconds ahead of his teammate, " [:a {:href "/athletes/85378"} "Bjørn Dæhlie"] ". But this was Dæhlie’s race. He caught Ulvang at four kilometers and was never headed, winning by over almost a minute, although Ulvang held on for the silver medal. Albarello dropped back to fourth while Majbäck finished sixth. The bronze medal went to " [:a {:href "/athletes/98569"} "Giorgio Vanzetta"] ", who started seventh, 50 seconds back of Ulvang, but posted the third fastest freestyle time."] "\n\n" [:p {} "This was the first Olympic gold medal for Bjørn Dæhlie, but it would become a common occurrence at major international races. He had already won two gold medals at the 1991 World Championships, and in his career would win 12 Olympic medals, with eight golds, both records for the Winter Olympics through 2006. At the World Championships, he would win 18 medals and nine titles."] "\n"] [:button {:id "button1915", :class "btn btn-default"} "Details"] [:script {} "$('#button1915').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "Start Behind"] [:th {:style "display: none", :class "split"} "Race"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "4"] [:td {} [:a {:href "/