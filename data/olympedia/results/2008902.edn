value "2008756"} "Keirin, Men"] "\n" [:option {:value "2008778"} "Team Sprint, Men"] "\n" [:option {:value "2008790"} "Team Pursuit (4,000 metres), Men"] "\n" [:option {:value "2008804"} "Madison, Men"] "\n" [:option {:value "2008805"} "Omnium, Men"] "\n" [:option {:value "2008812"} "Sprint, Women"] "\n" [:option {:value "2008868"} "Keirin, Women"] "\n" [:option {:value "2008890"} "Team Sprint, Women"] "\n" [:option {:value "2008916"} "Madison, Women"] "\n" [:option {:value "2008917"} "Omnium, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "308072"} "2012"] "\n" [:option {:value "356939"} "2016"] "\n" [:option {:value "19005112"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/996"} "Event type"]] [:h1 {:class "event_title"} "Team Pursuit (4,000 metres), Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "6 –  7 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2178"} "Vélodrome de Saint-Quentin-en-Yvelines, Montigny-le-Bretonneux, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2008902"} "44 from 10 countries"]]]]] [:div {:class "description"} [:p {} "Ten teams contested the team pursuit in Paris, up from the eight teams that took to the track in Tokyo. Germany were the defending Olympic champions and made just one change to their team, with " [:a {:href "/athletes/151523"} "Lena Reißner"] " replacing " [:a {:href "/athletes/125456"} "Lisa Brennauer"] ", who had retired in 2022. Great Britain were the defending World champions but were without their stalwart " [:a {:href "/athletes/130228"} "Katie Archibald"] " after she suffered an injury, causing her to break two bones in her leg just prior to the Games."] "\n\n" [:p {} "In the qualifying round, the New Zealand team set the pace with the fastest time, closely followed by the United States, Great Britain, and Italy. The German team only set the fifth-fastest time, just ahead of Australia, but both teams advanced to the first round, along with France and Canada."] "\n\n" [:p {} "The opening first round heat paired France against Australia, with the home team beating the Australians by more than one-and-a-half seconds. Germany then powered home against Canada in the second heat to set the fastest time at that point. There was shock and disappointment to come, however, as the next two heats produced the fastest times of all, resulting in the elimination of the defending Olympic champions Germany, along with the French and Australian teams. The United States beat Great Britain in their heat to advance to the gold medal final, with New Zealand beating Italy to also race off for gold."] "\n\n" [:p {} "The Great Britain quartet beat the Italian team by more than two seconds to win the bronze medal. In a close final, the United States just beat New Zealand to take home the gold. " [:a {:href "/athletes/132068"} "Jennifer Valente"] " won her first of two golds in Paris, and her third Olympic gold to date. Teammate " [:a {:href "/athletes/132066"} "Chloé Dygert"] " also added to her Paris medal haul after winning bronze in the individual time trial on the road. " [:a {:href "/athletes/147163"} "Lily Williams"] " was part of the American team that won a team pursuit bronze in Tokyo, and " [:a {:href "/athletes/151681"} "Kristen Faulkner"] " became the first American woman to win cycling gold on the track and the road at the same Olympics, following her victory in the road race a few days earlier. Faulkner also became only the third woman ever to win gold medals in two disciplines at a single Olympics, after Dutch cyclist " [:a {:href "/athletes/13253"} "Leontien Zijlaard-van Moorsel"] " in track and road cycling at Sydney 2000, and Czech Alpine skier/snowboarder " [:a {:href "/athletes/127620"} "Ester Ledecká"] " at Nagano 2018."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "4:05.238 (2)"] [:td {} "4:04.629 (1 h3)"] [:td {} "4:04.306 (1 h1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "11"} [:a {:href "/athletes/132068"} "Jennifer Valente"] " • " [:a {:href "/athletes/147163"} "Lily Williams"] " • " [:a {:href "/athletes/132066"} "Chloé Dygert"] " • " [:a {:href "/athletes/151681"} "Kristen Faulkner"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} "New Zealand"] [:td {} [:a {:href "/countries/NZL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NZL.png"}] "NZL"]] [:td {} "4:04.679 (1)"] [:td {} "4:04.818 (1 h4)"] [:td {} "4:04.927 (2 h1)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "11"} [:a {:href "/athletes/151619"} "Ally Wollaston"] " • " [:a {:href "/athletes/145726"} "Bryony Botha"] " • " [:a {:href "/athletes/151620"} "Emily Shearman"] " • " [:a {:href "/athletes/151624"} "Nicole Shields"]]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "–"] [:td {} "Great Britain"] [:td {} [:a {:href "/countries/GBR"} [:img {:style "pad