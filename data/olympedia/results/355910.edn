9 kg), Men"] "\n" [:option {:value "355542"} "Welterweight, Greco-Roman (≤66 kg), Men"] "\n" [:option {:value "355588"} "Middleweight, Greco-Roman (≤75 kg), Men"] "\n" [:option {:value "355634"} "Light-Heavyweight, Greco-Roman (≤85 kg), Men"] "\n" [:option {:value "355680"} "Heavyweight, Greco-Roman (≤98 kg), Men"] "\n" [:option {:value "355726"} "Super-Heavyweight, Greco-Roman (≤130 kg), Men"] "\n" [:option {:value "355220"} "Featherweight, Freestyle (≤57 kg), Men"] "\n" [:option {:value "355266"} "Welterweight, Freestyle (≤65 kg), Men"] "\n" [:option {:value "355312"} "Middleweight, Freestyle (≤74 kg), Men"] "\n" [:option {:value "355358"} "Light-Heavyweight, Freestyle (≤86 kg), Men"] "\n" [:option {:value "355404"} "Heavyweight, Freestyle (≤97 kg), Men"] "\n" [:option {:value "355450"} "Super-Heavyweight, Freestyle (≤125 kg), Men"] "\n" [:option {:value "355772"} "Flyweight, Freestyle (≤48 kg), Women"] "\n" [:option {:value "355818"} "Featherweight, Freestyle (≤53 kg), Women"] "\n" [:option {:value "355864"} "Lightweight, Freestyle (≤58 kg), Women"] "\n" [:option {:value "355956"} "Light-Heavyweight, Freestyle (≤69 kg), Women"] "\n" [:option {:value "356002"} "Heavyweight, Freestyle (≤75 kg), Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "134319"} "2004"] "\n" [:option {:value "263525"} "2008"] "\n" [:option {:value "332736"} "2012"] "\n" [:option {:value "19009735"} "2020"] "\n" [:option {:value "2008197"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/680"} "Event type"]] [:h1 {:class "event_title"} "Middleweight, Freestyle (≤63 kg), Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "18 August 2016"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/902"} "Arena Carioca 2, Parque Olímpico da Barra, Barra da Tijuca, Rio de Janeiro"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/355910"} "19 from 19 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single elimination tournament. Competitors losing to the finalists entered repechage tournament for bronze medals."]]]] [:div {:class "description"} [:p {} "When Mongolia’s " [:a {:href "/athletes/123840"} "Soronzonboldyn Battsetseg"] " won a bronze medal at the 2012 Olympic Games in London in the 63 kg weight class, it was her country’s first Olympic wrestling medal since 1980. She became a household name, adorning billboards and such, and was more popular than the president of Mongolia. Already the 2010 World champion at the time of the London Olympics, she added another World title in 2015 (after a World silver in 2013) making her the favourite for the 63kg class coming into Rio 2016. With " [:a {:href "/athletes/107562"} "Kaori Icho"] " of Japan, who she had major global losses to, moving down to the 58 kg, Battsetseg had former Icho understudy, the 2015 World silver medalist " [:a {:href "/athletes/130851"} "Risako Kawai"] " of Japan, and Ukraine’s " [:a {:href "/athletes/117016"} "Yuliya Tkach"] ", with whom she has traded gold medals with over the last two World Championships, to contend with for Rio gold."] "\n\n" [:p {} "But in a shocking turn, the World champion Battsetseg was upset by American " [:a {:href "/athletes/126543"} "Elena Pirozhkova"] " in the quarter-finals, and Tkach didn’t advance past the second round. Meanwhile Kawai dominated in her preliminaries, only giving up two points in three bouts en-route to the gold medal match, where she met " [:a {:href "/athletes/129204"} "Mariya Mamoshuk"] " of Belarus who was making her Olympic début. The Belarussian had earlier beaten Kazakhstan’s " [:a {:href "/athletes/130887"} "Yekaterina Larionova"] " 8-2, Sweden’s " [:a {:href "/athletes/120635"} "Henna Johansson"] " 7-2 and American Pirozhkova 3-2. However, Kawai was too much for the Olympic rookie, and she ran out the 3-0 winner, and with victory came Japan’s fourth wrestling gold medal in Rio. She celebrated in style by delivering two fireman’s carry takedowns on her coach Kazuhito Sakae after he ran up to congratulate her after her victory. Needless to say, the video of it went viral!"] "\n\n" [:p {} "Larionova won her bronze medal over Pirozhkova, while Poland’s " [:a {:href "/athletes/117013"} "Monika Michalik"] ", the four-time European champion competing in her third Olympic Games, defeated " [:a {:href "/athletes/131642"} "Inna Trazhukova"] " of Russia, for the other bronze."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Classification Points", :class "footnote"} "CP"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Victories by Fall", :class "footnote"} "VF"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Victories by Technical Superiority", :class "footnote"} "ST"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Technical Points", :class "footnote"} "TP"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Technical Points Received", :class "footnote"} "TPR"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/130851"} "Risako Kawai"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]] [:td {} "13"] [:td {} "0"] [:td {} "1"] [:td {} "29"] [:td {} "2"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/129204"} "Maryia Mamashuk"]] [:td {} [:a {:href "/countries/BLR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BLR.png"}] "BLR"]] [:td {} "9"] [:td {} "0"] [:td {} "0"] [:td {} "18"] [:td {} "12"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/130887"} "Yekaterina Larionova"]] [:td {} [:a {:href "/countries/KAZ"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KAZ.png"}] "KAZ"]] [:td {} "11"] [:td {} "2"] [:td {} "0"] [:td {} "10"] [:td {} "12"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/117013"} "Monika Michalik"]] [:td {} [:a {:href "/countries/POL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/POL.png"}] "POL"]] [:td {} "6"] [:td {} "0"] [:td {} "0"] [:td {} "11"] [:td {} "10"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=5"] [:td {} [:a {:href "/athletes/126543"} "Elena Pirozhkova"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "7"] [:td {} "0"] [:td {} "0"] [:td {} "18"] [:td {} "16"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=5"] [:td {} [:a {:href "/athletes/131642"} "Inna Trazhukova"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]] [:td {} "10"] [:td {} "0"] [:td {} "0"] [:td {} "20"] [:td {} "25"] [:td {}] [:td {}] [:td {}]] [:tr