923697"} "1,500 metres, Men"] "\n" [:option {:value "923712"} "5,000 metres Relay, Men"] "\n" [:option {:value "923719"} "500 metres, Women"] "\n" [:option {:value "923740"} "1,000 metres, Women"] "\n" [:option {:value "923761"} "1,500 metres, Women"] "\n" [:option {:value "923776"} "3,000 metres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "905307"} "1988"] "\n" [:option {:value "481"} "1992"] "\n" [:option {:value "555"} "1994"] "\n" [:option {:value "647"} "1998"] "\n" [:option {:value "739"} "2002"] "\n" [:option {:value "857"} "2006"] "\n" [:option {:value "350707"} "2014"] "\n" [:option {:value "9001121"} "2018"] "\n" [:option {:value "19020481"} "2022"] "\n" [:option {:value "15000901"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/544"} "Event type"]] [:h1 {:class "event_title"} "1,000 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "17 – 20 February 2010"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/176"} "Pacific Coliseum, Vancouver"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/923676"} "32 from 18 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Placements 1-8 based on final and B final.  Deeper placements based on placements in earlier rounds, and best time skated."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/857"} "1:26.739"] " / " [:a {:href "/athletes/101557"} "Hyeon-Su An"] " " [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"] " / 18 February 2006 / " [:a {:href "/records/event_name/544"} "Details"]]]]] [:div {:class "description"} [:p {} "South Korean skaters had won this event at the past four World Championships, with " [:a {:href "/athletes/101557"} "An Hyeon-Su"] " winning in 2006 and 2007, and " [:a {:href "/athletes/109911"} "Lee Ho-Seok"] " in 2008 and 2009. An was not competing in Vancouver, but Lee was. He was joined by two compatriots, " [:a {:href "/athletes/119779"} "Lee Jeong-Su"] ", the 2006 World Junior Champion and " [:a {:href "/athletes/119805"} "Seong Si-Baek"] ", who had dramatically crashed with Lee Ho-Seok in the final. But the Koreans would face tough competition from " [:a {:href "/athletes/101555"} "Apolo Anton Ohno"] " and the Canadian Hamelin brothers, " [:a {:href "/athletes/109918"} "Charles"] " and " [:a {:href "/athletes/119761"} "François"] " ."] "\n\n" [:p {} "In the first semi-final, the two Lees proceeded easily, while François Hamelin also made the final, following disqualification of " [:a {:href "/athletes/119765"} "J. R. Celski"] ". The second semi-final heat saw a very close finish, with the first three finishing within 0.035 seconds - about a skate’s length. Ohno won the heat, followed by Charles Hamelin, who edged out Seong by just 0.006. In the final, the lead was initially taken by the two Canadian brothers, but they were soon surpassed by the two Koreans. Lee Ho-Seok was in front at the bell, but Lee Jeong-Su passed him on the inside on the back straight. Because of a wide final curve, Lee Ho-Seok was able to gain back a bit of ground in the final metres, but not enough to deny his compatriot victory. Behind the two Koreans, Ohno held off the Canadians to take the bronze."] "\n\n" [:p {} "A few months after Lee Jeong-Su’s two gold medals in Vancouver, he was convicted in a match-fixing scandal. Together with fellow Olympian " [:a {:href "/athletes/119776"} "Gwak Yun-Gi"] " and their coach Jeon Jae-Mok, Lee was accused of having withdrawn during the March national team tryouts in favour of Gwak. The two skaters received an unusually severe punishment, as they were banished from competition until April 2013. Jeon was permanently expelled from coaching the national team."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Helmet Nr"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Position Last Race"] [:th {} "Positions"] [:th {} "Best Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "243"] [:td {} [:a {:href "/athletes/119779"} "Lee Jeong-Su"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} "AF-1"] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "242"] [:td {} [:a {:href "/athletes/109911"} "Lee Ho-Seok"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} "AF-2"] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "256"] [:td {} [:a {:href "/athletes/101555"} "Apolo Anton Ohno"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "AF-3"] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "205"] [:td {} [:a {:href "/athletes/109918"} "Charles Hamelin"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: m