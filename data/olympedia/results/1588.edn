"} "12.5 kilometres Pursuit, Men"] "\n" [:option {:value "1586"} "20 kilometres, Men"] "\n" [:option {:value "1592"} "7.5 kilometres Sprint, Women"] "\n" [:option {:value "1594"} "10 kilometres Pursuit, Women"] "\n" [:option {:value "1593"} "15 kilometres, Women"] "\n" [:option {:value "1595"} "4 × 7.5 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1518"} "1968"] "\n" [:option {:value "1523"} "1972"] "\n" [:option {:value "1528"} "1976"] "\n" [:option {:value "1534"} "1980"] "\n" [:option {:value "1540"} "1984"] "\n" [:option {:value "1546"} "1988"] "\n" [:option {:value "1552"} "1992"] "\n" [:option {:value "1563"} "1994"] "\n" [:option {:value "1575"} "1998"] "\n" [:option {:value "1603"} "2006"] "\n" [:option {:value "923486"} "2010"] "\n" [:option {:value "350026"} "2014"] "\n" [:option {:value "9000224"} "2018"] "\n" [:option {:value "19019634"} "2022"] "\n" [:option {:value "15000034"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/132"} "Event type"]] [:h1 {:class "event_title"} "4 × 7.5 kilometres Relay, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "20 February 2002 — 11:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/128"} "Soldier Hollow, Wasatch Mountain State Park"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1588"} "76 from 19 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Eight shots for each group of five targets. Penalty loop (150 metres) skied for each missed target."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 7,821 m" [:br {}] "Height Differential: 42 m" [:br {}] "Maximum Climb: 21 m" [:br {}] "Shooting 1: Prone at 2.5 km, 50 m range" [:br {}] "Shooting 2: Standing at 5.0 km, 50 m range" [:br {}] "Total Climbing: 242 m"]]]] [:div {:class "description"} [:p {} "Relay had been a World Cup event since the mid-1990s and Norway and Germany had won all the seasonal World Cups since 1996-97, while France and Russia had won the last two World Championships. But Norway was favored, led by their anchorman " [:a {:href "/athletes/84154"} "Ole Einar Bjørndalen"] ", who had already won the three individual gold medals in Salt Lake City. And their lead-off skier was " [:a {:href "/athletes/86432"} "Halvard Hanevold"] ", who had won the 20 km gold medal in 1998. Hanevold put Norway into second place, trailing Russia and " [:a {:href "/athletes/95275"} "Viktor Maygurov"] ", but only by 18 seconds. And on the second leg " [:a {:href "/athletes/99634"} "Frode Andresen"] " moved Norway into a lead they would never lose, leading France by 21 seconds at the second exchange. On the third leg, " [:a {:href "/athletes/99599"} "Egil Gjelland"] " moved Norway over a minute ahead of Russia with Germany close behind. Bjørndalen had an easy time of it in bringing Norway in first, and winning his fourth gold medal of the 2002 Winter Olympics. Behind him, Russia dropped back, as " [:a {:href "/athletes/91927"} "Frank Luck"] " and " [:a {:href "/athletes/99606"} "Raphaël Poirée"] " had the two fastest legs of the event to bring Germany the silver and France the bronze medal."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Misses"] [:th {} "Extra Shots"] [:th {} "Shooting 1 Misses"] [:th {} "Shooting 1 Extra Shots"] [:th {} "Shooting 1"] [:th {} "Shooting 2 Misses"] [:th {} "Shooting 2 Extra Shots"] [:th {} "Shooting 2"] [:th {} "Exchange"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :s