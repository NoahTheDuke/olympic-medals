ue "154879"} "Individual Time Trial, Men"] "\n" [:option {:value "154919"} "Individual Time Trial, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "154567"} "1984"] "\n" [:option {:value "154673"} "1988"] "\n" [:option {:value "154793"} "1992"] "\n" [:option {:value "155045"} "2000"] "\n" [:option {:value "155175"} "2004"] "\n" [:option {:value "259030"} "2008"] "\n" [:option {:value "308001"} "2012"] "\n" [:option {:value "356866"} "2016"] "\n" [:option {:value "19001702"} "2020"] "\n" [:option {:value "2003682"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/242"} "Event type"]] [:h1 {:class "event_title"} "Road Race, Individual, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "21 July 1996 — 11:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/720"} "Buckhead Cycling Course, Atlanta, Georgia"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/154918"} "58 from 30 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "104.40 km. (64.87 miles) mass start race."]]]] [:div {:class "description"} [:p {} "As always the favorite was France’s " [:a {:href "/athletes/13167"} "Jeannie Longo"] ". By 1996 she had won 10 world championships, five on the roads, and had even won a silver medal in mountain biking at the 1993 World Championships. However, at 37, the French cycling federation considered her too old and stopped funding her, but they selected her for the Games anyway. On the eighth lap of the race, Longo got away with Italy’s " [:a {:href "/athletes/13086"} "Imelda Chiappa"] " and " [:a {:href "/athletes/13139"} "Clara Hughes"] " (CAN) and " [:a {:href "/athletes/13270"} "Anna Wilson"] " (AUS). In the pouring rain, Wilson was dropped quickly, but the other three stayed away. Early on the final lap, Longo powered away from Chiappa and Hughes and rode to her much deserved gold medal. Hughes returned to the Olympics in 2000 in cycling and in 2002 and 2006, competed at the Winter Olympics in speed skating. Winning medals in both years on the ice, she is one of the few athletes (five thru 2006) to have won medals at both the Summer and Winter Olympic Games. The defending champion, " [:a {:href "/athletes/13264"} "Kathy Watt"] ", also competed but missed the winning break and finished ninth."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Margin"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/13167"} "Jeannie Longo-Ciprelli"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "2-36:13"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/13086"} "Imelda Chiappa"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} "–"] [:td {} "at 0:25"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/13139"} "Clara Hughes"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com