en"] "\n" [:option {:value "311071"} "Sabre, Individual, Men"] "\n" [:option {:value "311386"} "Sabre, Team, Men"] "\n" [:option {:value "311000"} "Foil, Individual, Women"] "\n" [:option {:value "311412"} "Foil, Team, Women"] "\n" [:option {:value "311142"} "Épée, Individual, Women"] "\n" [:option {:value "311438"} "Épée, Team, Women"] "\n" [:option {:value "311322"} "Sabre, Individual, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "72112"} "1900"] "\n" [:option {:value "72264"} "1904"] "\n" [:option {:value "72290"} "1906"] "\n" [:option {:value "72408"} "1908"] "\n" [:option {:value "73612"} "1912"] "\n" [:option {:value "73978"} "1920"] "\n" [:option {:value "74397"} "1924"] "\n" [:option {:value "77461"} "1928"] "\n" [:option {:value "80677"} "1932"] "\n" [:option {:value "82339"} "1936"] "\n" [:option {:value "85903"} "1948"] "\n" [:option {:value "86533"} "1952"] "\n" [:option {:value "86762"} "1956"] "\n" [:option {:value "87377"} "1960"] "\n" [:option {:value "90845"} "1964"] "\n" [:option {:value "93838"} "1968"] "\n" [:option {:value "97028"} "1972"] "\n" [:option {:value "100375"} "1976"] "\n" [:option {:value "103678"} "1980"] "\n" [:option {:value "105783"} "1984"] "\n" [:option {:value "108952"} "1988"] "\n" [:option {:value "112379"} "1992"] "\n" [:option {:value "114689"} "1996"] "\n" [:option {:value "115914"} "2000"] "\n" [:option {:value "116930"} "2004"] "\n" [:option {:value "259151"} "2008"] "\n" [:option {:value "357646"} "2016"] "\n" [:option {:value "19016614"} "2020"] "\n" [:option {:value "2011087"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/281"} "Event type"]] [:h1 {:class "event_title"} "Épée, Individual, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 1 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/861"} "ExCeL, Newham, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/311284"} "30 from 24 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament."]]]] [:div {:class "description"} [:p {} "The men’s épée likely had the most remarkable result of any of the 2012 Olympic fencing competitions, as none of the pre-contest favorites made it to the semi-finals. All of the semi-finalists were ranked outside of the top 10 in the FIE ranking, and none of the medallists had ever won a medal at the World Championships or Olympic Games before. In addition, both finalists won the first ever Olympic fencing medal for their country."] "\n\n" [:p {} "Eventual champion was Venezuela’s " [:a {:href "/athletes/118220"} "Rubén Limardo"] ", winning only his country’s second ever Olympic title. En route to the final, he ousted the world number 5 (" [:a {:href "/athletes/126351"} "Max Heinzer"] ") and the current World Champion (" [:a {:href "/athletes/124014"} "Paolo Pizzo"] "). His semi-final opponent, " [:a {:href "/athletes/106072"} "Seth Kelsey"] " had won World Championship medals with the US team, and had kicked out " [:a {:href "/athletes/90794"} "Nikolai Novosjolov"] ", the number one seed. Limardo’s opponent in the final was Norway’s " [:a {:href "/athletes/120084"} "Bartosz Piasecki"] ". The son of a Polish fencing coach, he had defeated two members of the 2011 French World Championship team - including a narrow 15-14 defeat of " [:a {:href "/athletes/122240"} "Yannick Borel"] " - as well as veteran " [:a {:href "/athletes/22468"} "Géza Imre"] " of Hungary."] "\n\n" [:p {} "The final saw Limardo gaining a clear 14-6 lead, before he almost succumbed to pressure, allowing Piasecki to comeback to 14-10, before finishing off the match. The bronze medal match gave more excitement: " [:a {:href "/athletes/118210"} "Jeong Jin-Seon"] " defeated Kelsey only in over-time, after two double-hits (the fencers touching each other simultaneously)."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Seed"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "12"] [:td {} [:a {:href "/athletes/118220"} "Rubén Limardo"]] [:td {} [:a {:href "/countries/VEN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/VEN.png"}] "VEN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "23"] [:td {} [:a {:href "/athletes/120084"} "Bartosz Piasecki"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "14"] [:td {} [:a {:href "/athletes/118210"} "Jeong Jin-Seon"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "17"] [:td {} [:a {:href "/athletes/106072"} "Seth Kelsey"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=5"] [:td {:class "bib"} "9"] [:td {} [:a {:href "/athletes/106057"} "Silvio Fernández Briceño"]] [:td