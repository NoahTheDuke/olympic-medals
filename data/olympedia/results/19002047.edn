d {}]]]] [:form {:class "form-inline"} [:select {:name "id", :id "sub_select_for_19002047_runs", :class "form-control"} [:option {:value ""} "Parts"] "\n" [:option {:value "19002048"} "Snatch"] "\n" [:option {:value "19002052"} "Clean &amp; Jerk"]] [:script {} "$('#sub_select_for_19002047_runs').change(function() {location.href='/results/' + $('#sub_select_for_19002047_runs').val()})"]] "\n"] "\n" [:footer {:class "footer"} "\n" [:br {}] "\n" [:div {:class "panel panel-info"} "\n" [:div {:class "panel-heading"} "\n" [:h3 {:class "panel-title"} "\n" [:span {:class "glyphicon glyphicon-info-sign"}] "\nDid you know?\n"] "\n"] "\n" [:div {:class "panel-body"} "\n" [:p {} "The host of the 1984 Winter Olympics, Yugoslavia, had never won a medal in winter sports prior to hosting. Alpine skier " [:a {:href "/athletes/85820"} "Jure Franko"] " won the nation’s first medal, a silver, in the men’s giant slalom."] "\n\n\n"] "\n"] "\n" [:div {:class "container"} "\n" [:p {} "\n" [:a {:href "/users/sign_in"} "Login"] "\n|\n" [:a {:href "/statistics/site"} "Statistics"] "\n|\n" [:a {:href "/static/about"} "About"] "\n|\n" [:a {:href "/static/faq"} "FAQ"] "\n|\n" [:a {:href "/feedbacks/new"} "Feedback"] "\n"] "\n" [:p {} "\n© " [:a {:href "/static/about"} "OlyMADMen"] " 2006 — 2026\n"] "\n"] "\n"] "\n\n" [:script {:src "/assets/lightbox.min-a06f7b5a37bdc88a78a48f95b9149ca917761a07bffb855a6d73c1a435e16552.js"}] #object[org.jsoup.nodes.TextNode 0x5ebf13db ""] [:script {} "\n  $('.footnote').tooltip();\n"] "\n"] "\n"] "\n")