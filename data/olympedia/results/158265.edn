option {:value "158255"} "Coxless Pairs, Men"] "\n" [:option {:value "158275"} "Coxless Fours, Men"] "\n" [:option {:value "158290"} "Coxed Fours, Men"] "\n" [:option {:value "158302"} "Eights, Men"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "9031207"} "1896"] "\n" [:option {:value "157510"} "1900"] "\n" [:option {:value "925415"} "1900"] "\n" [:option {:value "157649"} "1920"] "\n" [:option {:value "157691"} "1924"] "\n" [:option {:value "157797"} "1928"] "\n" [:option {:value "157903"} "1932"] "\n" [:option {:value "157959"} "1936"] "\n" [:option {:value "158041"} "1948"] "\n" [:option {:value "158164"} "1952"] "\n" [:option {:value "158347"} "1960"] "\n" [:option {:value "158425"} "1964"] "\n" [:option {:value "158506"} "1968"] "\n" [:option {:value "158594"} "1972"] "\n" [:option {:value "158690"} "1976"] "\n" [:option {:value "158822"} "1980"] "\n" [:option {:value "158943"} "1984"] "\n" [:option {:value "159067"} "1988"] "\n" [:option {:value "159234"} "1992"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/383"} "Event type"]] [:h1 {:class "event_title"} "Coxed Pairs, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "23 – 27 November 1956"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/399"} "Lake Wendouree, Ballarat, Victoria"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/158265"} "24 from 8 countries"]]]]] [:div {:class "description"} [:p {} "As the reigning European champions, " [:a {:href "/athletes/38032"} "Moritz von Groddeck"] ", " [:a {:href "/athletes/37748"} "Horst Arndt"] ", and " [:a {:href "/athletes/37768"} "Rainer Borkowsky"] " of Germany were probably the strongest competitors entering the coxed pairs event at the 1956 Summer Olympics, but the field was relatively open. " [:a {:href "/athletes/40268"} "Ihor Yemchuk"] " and " [:a {:href "/athletes/40402"} "Heorhiy Zhylin"] ", silver medalists in the double sculls at the 1952 Games, for example, had partnered with " [:a {:href ""} "Vladimir Petrov"] " to compete for the Soviet Union in this event. In the opening round, it was the American trio of " [:a {:href "/athletes/40538"} "Dan Ayrault"] ", " [:a {:href "/athletes/40650"} "Conn Findlay"] ", and " [:a {:href "/athletes/40868"} "Kurt Seiffert"] " who posted the fastest time, while the Polish crew of " [:a {:href "/athletes/39339"} "Henryk Jagodziński"] ", " [:a {:href "/athletes/39398"} "Zbigniew Schwarzer"] ", and " [:a {:href "/athletes/39369"} "Berthold Mainka"] " took that honor in the semi-finals. These four nations advanced to the finals, where they were fairly evenly matched. The first half saw Poland and the USSR contest for the lead, until both the Germans and the Americans initiated drives to claim the top podium spot. Poland, who had taken the lead from the Soviets, had no answer for this push and dipped into third place as the United States claimed gold and the Germans took silver. Poland and the Soviet Union were neck and neck approaching the finish line, but the latter pulled ahead just in time to claim bronze by a margin of 0.5 seconds. One of the Americans, Findlay, would go on to win three more Olympic medals, one of which was bronze in the two person keelboat, mixed yachting event at the 1976 Games. His most notable yachting success, however, came in 1977, when he served on the crew of the America Cup-winning _ Courageous_."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td