33"} "Double Sculls, Men"] "\n" [:option {:value "2012446"} "Quadruple Sculls, Men"] "\n" [:option {:value "2012455"} "Coxless Pairs, Men"] "\n" [:option {:value "2012468"} "Coxless Fours, Men"] "\n" [:option {:value "2012477"} "Eights, Men"] "\n" [:option {:value "2012485"} "Lightweight Double Sculls, Men"] "\n" [:option {:value "2012500"} "Single Sculls, Women"] "\n" [:option {:value "2012533"} "Double Sculls, Women"] "\n" [:option {:value "2012546"} "Quadruple Sculls, Women"] "\n" [:option {:value "2012555"} "Coxless Pairs, Women"] "\n" [:option {:value "2012568"} "Coxless Fours, Women"] "\n" [:option {:value "2012577"} "Eights, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "159527"} "1996"] "\n" [:option {:value "159701"} "2000"] "\n" [:option {:value "159879"} "2004"] "\n" [:option {:value "261138"} "2008"] "\n" [:option {:value "319156"} "2012"] "\n" [:option {:value "354122"} "2016"] "\n" [:option {:value "19008589"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/402"} "Event type"]] [:h1 {:class "event_title"} "Lightweight Double Sculls, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "28 July –  2 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2180"} "National Olympic Nautical Stadium d'Île-de-France, Vaires-sur-Marne, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2012585"} "32 from 16 countries"]]]]] [:div {:class "description"} [:p {} "The lightweight double sculls was on Olympic life support at Paris 2024, as lightweight events were not planned for the Olympic Programme in either Los Angeles 2028 or Brisbane 2032, being replaced by coastal rowing events."] "\n\n" [:p {} "The British tandem of " [:a {:href "/athletes/143050"} "Emily Craig"] " and " [:a {:href "/athletes/143054"} "Imogen Grant"] " were the clear favorites in this event. They had won the last five major international competitions, winning the World Championships and European Championships in 2022 and 2023, and the 2023 Luzern Regatta. Craig / Grant competed at Tokyo 2020, finishing fourth in the lightweight double sculls. They held the world’s best time of 6:40.47 set in winning the semi-final of the World Cup II, at Varese, Italy, on 17 June 2023."] "\n\n" [:p {} "A USA pair had finished second at the 2022 and 2023 World Championships, with " [:a {:href "/athletes/147228"} "Michelle Sechser"] " part of both pairs. In 2022, she was accompanied by " [:a {:href "athletes/147227"} "Molly Reckford"] ", while in 2023 she rowed with Mary Jones. Sechser and Reckford were entered in this event in Paris and made the final."] "\n\n" [:p {} "Nobody challenged Craig and Grant in the final. They led at 500 metres and were never headed, taking the gold medal by 1.72 seconds over Romania’s " [:a {:href "/athletes/131512"} "Gianina van Groningen"] " and " [:a {:href "/athletes/131514"} "Ionela Cozmiuc"] ". The Greek boat of " [:a {:href "/athletes/153724"} "Milena Kontou"] " and " [:a {:href "/athletes/153726"} "Zoí Fitsiou"] " had the fastest finish, moving up for the bronze medal. Sechser and Reckford were not a factor in the final, finishing sixth and last."] "\n\n" [:p {} "Van Groningen and Cozmiuc were competing in their third consecutive Olympics together, but previously as Gianina Beleagă and Ionela Lehaci. Kontou and Fitsiou made their Olympic début in Paris."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] 