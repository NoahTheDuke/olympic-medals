lue "313000"} "Team All-Around, Men"] "\n" [:option {:value "313012"} "Floor Exercise, Men"] "\n" [:option {:value "313024"} "Vault, Men"] "\n" [:option {:value "313027"} "Parallel Bars, Men"] "\n" [:option {:value "313030"} "Horizontal Bar, Men"] "\n" [:option {:value "313021"} "Rings, Men"] "\n" [:option {:value "313009"} "Individual All-Around, Women"] "\n" [:option {:value "313003"} "Team All-Around, Women"] "\n" [:option {:value "313033"} "Floor Exercise, Women"] "\n" [:option {:value "313015"} "Vault, Women"] "\n" [:option {:value "313039"} "Uneven Bars, Women"] "\n" [:option {:value "313036"} "Balance Beam, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "70003"} "1896"] "\n" [:option {:value "70071"} "1924"] "\n" [:option {:value "70087"} "1928"] "\n" [:option {:value "70109"} "1932"] "\n" [:option {:value "70126"} "1936"] "\n" [:option {:value "70148"} "1948"] "\n" [:option {:value "70170"} "1952"] "\n" [:option {:value "70195"} "1956"] "\n" [:option {:value "70230"} "1960"] "\n" [:option {:value "70274"} "1964"] "\n" [:option {:value "70318"} "1968"] "\n" [:option {:value "70371"} "1972"] "\n" [:option {:value "70429"} "1976"] "\n" [:option {:value "70487"} "1980"] "\n" [:option {:value "70545"} "1984"] "\n" [:option {:value "70603"} "1988"] "\n" [:option {:value "70661"} "1992"] "\n" [:option {:value "70719"} "1996"] "\n" [:option {:value "70792"} "2000"] "\n" [:option {:value "70876"} "2004"] "\n" [:option {:value "259979"} "2008"] "\n" [:option {:value "353655"} "2016"] "\n" [:option {:value "19009149"} "2020"] "\n" [:option {:value "2012249"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/322"} "Event type"]] [:h1 {:class "event_title"} "Pommelled Horse, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "28 July –  5 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/872"} "North Greenwich Arena, Greenwich, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/313018"} "69 from 32 countries"]]]]] [:div {:class "description"} [:p {} "As the winner of the two most recent World Championships, and the silver medalist in the two before that, " [:a {:href "/athletes/126558"} "Krisztián Berki"] " of Hungary entered the men’s pommelled horse event at the 2012 Summer Olympics as the favorite to win gold. His strongest challenger was hometown favorite " [:a {:href "/athletes/111967"} "Louis Smith"] ", 2010 world runner-up and bronze medalist at the 2007 and 2011 World Championships and  the 2008 Olympics. " [:a {:href "/athletes/121668"} "Cyril Tommasone"] " of France, silver medalist at the most recent World Championships, was a favored contender for the third podium spot, but would have to deal with a strong overall pool of competitors to earn a medal."] "\n\n" [:p {} "Smith dominated the qualifications by posting the highest scores for both difficulty and execution, and finishing nearly half a point ahead of Tommasone. " [:a {:href "/athletes/126559"} "Vid Hidvégi"] " of Hungary was third while his compatriot Berki finished in fifth, behind " [:a {:href "/athletes/91499"} "Alberto Busnari"] " of Italy who, despite having competed in every Olympic gymnastics tournament since 2000, was participating in his first final. " [:a {:href "/athletes/121661"} "Vitaliy Nakonechniy"] " of Ukraine was sixth and " [:a {:href "/athletes/123039"} "Max Whitlock"] " of Great Britain, the 2010 Commonwealth Games silver medalist, slipped into the finals in eighth place after tying " [:a {:href "/athletes/120451"} "David Belyavsky"] " of Russia and " [:a {:href "/athletes/121660"} "Mykola Kuksenkov"] " of Ukraine on points. The tie-breaker for the final two spots was the best execution score, and Belyavsky and Whitlock were 0.2 and 0.1 points ahead of Kuksenkov respectively. In the finals Berki performed an outstanding routine, moving into first place with a score of 16.066 and eclipsing the competition with 9.166 execution points. Whitlock was fairly distant behind him in second place, with 15.600 points. With only Smith left to go, Great Britain was guaranteed at least one medal, but Smith upped his difficulty and brought a second one by tying Berki’s score. Although the Hungarian was crowned Olympic champion by virtue of his higher execution score, the home nation was thrilled at their success in the event, having won their first silver medal in men’s gymnastics since 1908, after " [:a {:href "/athletes/30181"} "Walter Tysall"] "’s placement in the individual all-around."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "223"] [:td {} [:a {:href "/athletes/126558"} "Krisztián Berki"]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "133"] [:td {} [:a {:href "/athletes/111967"} "Louis Smith"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "135"] [:td {} [:a {:href "/athletes/123039"} "Max Whitlock"]] [:td {} [:a {:href "/countries/