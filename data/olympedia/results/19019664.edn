9671"} "Monobob, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "457"} "2002"] "\n" [:option {:value "474"} "2006"] "\n" [:option {:value "924254"} "2010"] "\n" [:option {:value "350047"} "2014"] "\n" [:option {:value "9000254"} "2018"] "\n" [:option {:value "15000094"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/143"} "Event type"]] [:h1 {:class "event_title"} "Two, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "18 – 19 February 2022"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2144"} "Yanqing National Sliding Centre, West Dazhuangke, Zhangshanying, Yanqing District"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19019664"} "40 from 12 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Four runs, total time determined placement. Only the best 20 teams contest the final run."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Curves: 16" [:br {}] "Length: 1,615 m" [:br {}] "Start Altitude: 1,017 m" [:br {}] "Vertical Drop: 121 m"]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/2301452"} "Laura Nolte"] " and " [:a {:href "/athletes/148384"} "Deborah Levi"] " (Germany) won the two-woman bobsleigh comfortably, posting the best time in the first three runs, and winning by 0.77 seconds. Fellow Germans " [:a {:href "/athletes/137253"} "Mariama Jamanka"] " and " [:a {:href "/athletes/143235"} "Alexandra Burghardt"] " took the silver medal, finishing with the fastest run of the final round. Burghardt was making her Winter Olympic début, but not her Olympic début, as she had been a sprinter in athletics at Tokyo 2020."] "\n\n" [:p {} [:a {:href "/athletes/118644"} "Elana Meyers Taylor"] " and " [:a {:href "/athletes/149068"} "Sylvia Hoffman"] " (USA) came home for the bronze medal, placing third on all four runs. This was the first Olympic Winter Games for Nolte, although she did win a gold medal in monobob at the 2016 Youth Olympic Winter Games. Jamanka won her second consecutive medal in the event after winning gold at PyeongChang 2018 with " [:a {:href "/athletes/137251"} "Lisa Buckwitz"] ". She immediately announced her retirement after the final run."] "\n\n" [:p {} "Meyers Taylor won her fourth medal in two-woman bobsleigh, which led the medal table in the event over " [:a {:href "/athletes/118672"} "Kaillie Humphries"] " (Canada/USA), who finished seventh eventually. Meyers Taylor’s five bobsleigh medals were the most for any woman, ahead of Humphries with four."] "\n\n" [:p {} "After winning a silver medal in monobob, Meyers Taylor also became the first woman to win two bobsleigh medals at a single Olympics. She was 37 years, 132 days old at the time, making her the oldest female medallist in bobsleigh, surpassing " [:a {:href "/athletes/83024"} "Gerda Weissensteiner"] " (Italy) who was 37 year 48 days in 2006."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Run #1"] [:th {} "Run #2"] [:th {} "Run #3"] [:th {} "Run #4"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/2301452"} "Laura Nolte"] " / " [:a {:href "/athletes/148384"} "Deborah Levi"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "4:03.96"] [:td {} "1:01.04 (1)"] [:td {} "1:01.01 (1)"] [:td {} "1:00.70 (1)"] [:td {} "1:01.21 (2)"] [:td {} [:span {:class "Gold"} "Go