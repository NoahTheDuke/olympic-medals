"id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "4548"} "1908"] "\n" [:option {:value "4630"} "1912"] "\n" [:option {:value "4709"} "1920"] "\n" [:option {:value "4785"} "1924"] "\n" [:option {:value "4887"} "1928"] "\n" [:option {:value "4988"} "1932"] "\n" [:option {:value "5081"} "1936"] "\n" [:option {:value "5192"} "1948"] "\n" [:option {:value "5307"} "1952"] "\n" [:option {:value "5427"} "1956"] "\n" [:option {:value "5556"} "1960"] "\n" [:option {:value "5742"} "1964"] "\n" [:option {:value "5989"} "1968"] "\n" [:option {:value "6303"} "1972"] "\n" [:option {:value "6580"} "1976"] "\n" [:option {:value "6835"} "1980"] "\n" [:option {:value "7099"} "1984"] "\n" [:option {:value "7778"} "1992"] "\n" [:option {:value "8120"} "1996"] "\n" [:option {:value "8518"} "2000"] "\n" [:option {:value "8912"} "2004"] "\n" [:option {:value "261646"} "2008"] "\n" [:option {:value "322165"} "2012"] "\n" [:option {:value "357141"} "2016"] "\n" [:option {:value "19000066"} "2020"] "\n" [:option {:value "2001571"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/568"} "Event type"]] [:h1 {:class "event_title"} "4 × 200 metres Freestyle Relay, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "20 – 21 September 1988"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/643"} "Su-yeong-jang, Ol-lim-pik Gong-won, Seoul"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/7421"} "75 from 16 countries"]]]]] [:div {:class "description"} [:p {} "In an unusual situation for an Olympic relay, this was considered wide-open and the United States was not favored. West Germany held the world record of 7:13.10, set in 1987 in Strasbourg, France. At the 1986 World Championships, East Germany had won with West Germany and the USA only third. In the heats the GDR team qualified first, and that was with the USA only resting two swimmers for the final. East Germany looked formidable when " [:a {:href "/athletes/47565"} "Uwe Daßler"] " took a 1.11 second lead over " [:a {:href "/athletes/51307"} "Troy Dalbey"] " on the opening leg, although Sweden’s " [:a {:href "/athletes/50401"} "Anders Holmertz"] " had the lead at 1:48.06. Italy then took the lead after two legs, with " [:a {:href "/athletes/48537"} "Giorgio Lamberti"] " splitting 1:47.29, but they would soon drop back. At this point the US was only fifth, also trailing East Germany, Sweden, and West Germany, although the gap to East Germany had closed. After three legs East Germany moved into the lead, with the American team about one body length in arrears. Then " [:a {:href "/athletes/51266"} "Matt Biondi"] " took over. His start on the exchange made up almost half the lead and at the 700 metre mark he was in front. He never let up, swimming the fastest split in history with 1:46.44 as the USA came home in 7:12.51 for gold and the world record. East Germany was over a second behind for silver with West Germany getting bronze."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "7:18.76 (2 h1)"] [:td {} "7:12.51 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "555"] [:td {} [:a {:href "/athletes/51307"} "Troy Dalbey"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:clas