30742"} "Long Jump, Women"] "\n" [:option {:value "64526"} "Shot Put, Women"] "\n" [:option {:value "64543"} "Discus Throw, Women"] "\n" [:option {:value "64560"} "Javelin Throw, Women"] "\n" [:option {:value "64577"} "Heptathlon, Women"] "\n" [:option {:value "901201"} "800 metres Wheelchair, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "56642"} "1912"] "\n" [:option {:value "57127"} "1920"] "\n" [:option {:value "57405"} "1924"] "\n" [:option {:value "57705"} "1928"] "\n" [:option {:value "57988"} "1932"] "\n" [:option {:value "58230"} "1936"] "\n" [:option {:value "58577"} "1948"] "\n" [:option {:value "58936"} "1952"] "\n" [:option {:value "59329"} "1956"] "\n" [:option {:value "59714"} "1960"] "\n" [:option {:value "60160"} "1964"] "\n" [:option {:value "60598"} "1968"] "\n" [:option {:value "61108"} "1972"] "\n" [:option {:value "61692"} "1976"] "\n" [:option {:value "62252"} "1980"] "\n" [:option {:value "62732"} "1984"] "\n" [:option {:value "63369"} "1988"] "\n" [:option {:value "64730"} "1996"] "\n" [:option {:value "65402"} "2000"] "\n" [:option {:value "66094"} "2004"] "\n" [:option {:value "257228"} "2008"] "\n" [:option {:value "302001"} "2012"] "\n" [:option {:value "358638"} "2016"] "\n" [:option {:value "19000436"} "2020"] "\n" [:option {:value "2013588"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/47"} "Event type"]] [:h1 {:class "event_title"} "10,000 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "31 July –  3 August 1992"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/668"} "Estadio Olímpico de Montjuïc, Barcelona"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/64048"} "56 from 38 countries"]]]]] [:div {:class "description"} [:p {} "While the 1964 Olympic 10K had seen the biggest upset in the event’s history, the 1992 final was the most controversial ever. The world record holder, " [:a {:href "/athletes/73469"} "Arturo Barrios"] " (MEX), was in the race, as was 1991 World Champion " [:a {:href "/athletes/72851"} "Moses Tanui"] " (KEN) and World runner-up " [:a {:href "/athletes/72746"} "Richard Chelimo"] " (KEN). Also back was 1990 European Champion and 1988 silver medalist, " [:a {:href "/athletes/71837"} "Salvatore Antibo"] " of Italy. Chelimo set the pace early in the final, dropping all but seven runners by the eighth lap. By the 16th lap, Chelimo still led, now only accompanied by Morocco’s " [:a {:href "/athletes/73346"} "Khalid Skah"] ", twice International Cross-Country champion. By the 19th lap, these two were lapping runners and one of the runners they came upon on the 22nd lap was Morocco’s " [:a {:href "/athletes/73313"} "Hammou Boutayeb"] ". Though he was lapped he suddenly found the strength to run with Chelimo and Skah, to the detriment of Chelimo. Writing in " [:em {} "Track &amp; Field News"] ", Cordner Nelson noted, “In the next lap and a half, Boutayeb committed unarmed assault.” He bumped Chelimo several times, cut him off at least twice, and made him run over and around him several times. Shortly before the bell, IAAF Technical Delegate Carl-Gustaf Tollemar ran onto the track to warn Boutayeb to stop his tactics and appeared to try to stop him, to no avail. On the last lap, Skah was the fresher runner, and outsprinted Chelimo, his tank dry from having to fight off Boutayeb’s assaults. Boutayeb dropped out on the last lap. Shortly after the finish, Skah began a victory lap that was greeted by boos and detritus being thrown at him from the stands. Before he had finished the lap, the IAAF had disqualified him and declared Chelimo the winner. Moroccan officials immediately appealed the ruling, and the next day Skah was reinstated. On the victory podium two days later, the chorus of derision on the victory lap seemed mild compared to the abuse heaped on Skah."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1214"] [:td {} [:a {:href "/athletes/73346"} "Khalid Skah"]] [:td {} [:a {:href "/countries/MAR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/MAR.png"}] "MAR"]] [:td {} "28:18.48 (6 h1)"] [:td {} "27:46.70 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "1110"] [:td {} [:a {:href "/athletes/72746"} "Richard Chelimo"]] [:td {} [:a {:href "/countries/KEN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KEN.png"}] "KEN"]] [:td {} "28:16.39 (5 h1)"] [:td {} "27:47.72 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "461"] [:td {} [:a {:href "/athletes/67378"} "Addis Abebe"]] [:td {} [:a {:href "/countries/ETH"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ETH.png"}] "ETH"]] [:td {} "28:15.76 (4 h1)"] [:td {} "28:00.07 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "988"] [:td {} [:a {:href "/athletes/71837"} "Salvatore Antibo"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.