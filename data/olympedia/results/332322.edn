g), Men"] "\n" [:option {:value "332046"} "Lightweight, Greco-Roman (≤60 kg), Men"] "\n" [:option {:value "332092"} "Welterweight, Greco-Roman (≤66 kg), Men"] "\n" [:option {:value "332138"} "Middleweight, Greco-Roman (≤74 kg), Men"] "\n" [:option {:value "332184"} "Light-Heavyweight, Greco-Roman (≤84 kg), Men"] "\n" [:option {:value "332230"} "Heavyweight, Greco-Roman (≤96 kg), Men"] "\n" [:option {:value "332276"} "Super-Heavyweight, Greco-Roman (≤120 kg), Men"] "\n" [:option {:value "332368"} "Lightweight, Freestyle (≤60 kg), Men"] "\n" [:option {:value "332414"} "Welterweight, Freestyle (≤66 kg), Men"] "\n" [:option {:value "332460"} "Middleweight, Freestyle (≤74 kg), Men"] "\n" [:option {:value "332506"} "Light-Heavyweight, Freestyle (≤84 kg), Men"] "\n" [:option {:value "332552"} "Heavyweight, Freestyle (≤96 kg), Men"] "\n" [:option {:value "332597"} "Super-Heavyweight, Freestyle (≤120 kg), Men"] "\n" [:option {:value "332644"} "Flyweight, Freestyle (≤48 kg), Women"] "\n" [:option {:value "332690"} "Lightweight, Freestyle (≤55 kg), Women"] "\n" [:option {:value "332736"} "Middleweight, Freestyle (≤63 kg), Women"] "\n" [:option {:value "332782"} "Heavyweight, Freestyle (≤72 kg), Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "120028"} "1904"] "\n" [:option {:value "120155"} "1908"] "\n" [:option {:value "120764"} "1920"] "\n" [:option {:value "121048"} "1924"] "\n" [:option {:value "121544"} "1928"] "\n" [:option {:value "121929"} "1932"] "\n" [:option {:value "122145"} "1936"] "\n" [:option {:value "122656"} "1948"] "\n" [:option {:value "123202"} "1952"] "\n" [:option {:value "123800"} "1956"] "\n" [:option {:value "124294"} "1960"] "\n" [:option {:value "125026"} "1964"] "\n" [:option {:value "125700"} "1968"] "\n" [:option {:value "126494"} "1972"] "\n" [:option {:value "127382"} "1976"] "\n" [:option {:value "128175"} "1980"] "\n" [:option {:value "128873"} "1984"] "\n" [:option {:value "129773"} "1988"] "\n" [:option {:value "131000"} "1992"] "\n" [:option {:value "132070"} "1996"] "\n" [:option {:value "133036"} "2000"] "\n" [:option {:value "133681"} "2004"] "\n" [:option {:value "263132"} "2008"] "\n" [:option {:value "355220"} "2016"] "\n" [:option {:value "19009474"} "2020"] "\n" [:option {:value "2007958"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/671"} "Event type"]] [:h1 {:class "event_title"} "Featherweight, Freestyle (≤55 kg), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "10 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/861"} "ExCeL, Newham, London"] " (North Arena 2)"]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/332322"} "19 from 19 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single elimination tournament. Competitors losing to the finalists entered repechage tournament for bronze medals."]]]] [:div {:class "description"} [:p {} "Despite never having competed in a senior World Championship, Russia’s " [:a {:href "/athletes/120369"} "Dzhamal Otarsultanov"] " was considered the favorite for the men’s freestyle featherweight event at the 2012 Olympics. Having won the last two European Championships, Otarsultanov defeated compatriot Viktor Lebedev, the reigning World Champion for the past two years, for Russia’s flyweight spot at the London Games. Among his most prominent challengers were " [:a {:href "/athletes/117045"} "Yang Kyong-Il"] " of North Korea, the 2009 World Champion and 2011 Asian Champion, and " [:a {:href "/athletes/122830"} "Hassan Rahimi"] " of Iran, the reigning Asian Champion. Notable as an underdog was " [:a {:href "/athletes/123281"} "Brandon Escobar"] " of Honduras, his nation’s first Olympic wrestler."] "\n\n" [:p {} "Yang and Otarsultanov were drawn in the same half, with the latter defeating the former in the quarterfinals on his way to the gold medal match. This left Rahimi as his most likely challenger, but the Iranian was defeated by 18 year-old Indian " [:a {:href "/athletes/120067"} "Amit Kumar"] ", who had débuted on the international scene earlier in the year with a bronze medal at the 2012 Asian Championships, a tournament won by Rahimi. Kumar in turn was overcome by Georgia’s " [:a {:href "/athletes/120316"} "Vladimer Khinchegashvili"] ", a two-time junior World Champion (2010 and 2011) who had finished seventh at the senior World Championships and only reached the Olympics by winning the European qualifier. With his subsequent defeat of Japan’s " [:a {:href "/athletes/120627"} "Shinichi Yumoto"] ", the 2010 Asian Champion, however, he guaranteed himself a medal in London. The first period of the final went to " [:em {} "par terre"] ", where Otarsultanov drew the advantaged position and converted it into a score to win the round. In the second period, the Russian scored point with a takedown in the first ten seconds that was answered soon after by the Georgian pushing his opponent out of the ring. Each scored another point in the second half of the round, but an unsuccessful challenge from the Russian coaches put Khinchegashvili ahead 3-2. Refusing to drag the match on to a third period, Otarsultanov scored another point, to which the Georgian attempted to respond in the dying seconds of the round. When he was not awarded the points, and with nothing to lose (since Otarsultanov had scored the last point and would have won the period anyways), it was the Georgian coaches’ turn for an unsuccessful challenge, leaving the Russian to win the round and capture the gold medal."] "\n\n" [:p {} "For the first of the two third-place podium spots, Yang squared off against " [:a {:href "/athletes/126717"} "Daulet Niyazbekov"] " of Kazakhstan, a bronze medalist from the most recent World Championships. The two seemed evenly, and aggressively, matched at first, with almost the entire first minute spent on the ground and each scoring two points in a first round that went to Yang for having scored the last point. In a conclusion to perhaps one of the most entertaining matches of the tournament, however, Yang displayed complete dominance and won the round early by scoring six unanswered points, earning himself a victory in the match. In the second bronze medal bout, Yumoto faced " [:a {:href "/athletes/108105"} "Radoslav Velikov"] " of Bulgaria, a distinguished wrestler who had won, among other accolades, a bronze medal at the 2008 Summer Olympics, gold at the 2006 World Championships, and silver at the 2005 and 2011 editions. They too were evenly matched, scoring one point each in the first two rounds, but Yumoto was declared the winner of the period in each case and, consequently, of the second bronze medal."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/120369"} "Dzhamal Otarsultanov"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/120316"} "Vladimer Khinchegashvili"]] [:td {} [:a {:href "/countries/GEO"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GEO.png"}] "GEO"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} 