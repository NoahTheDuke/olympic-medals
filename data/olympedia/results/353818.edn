thletes/5003541"} "Masaaki Ito"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]]] [:tr {:class "referees", :style ""} [:th {} "Execution Judge 3"] [:td {:style "width: 400px"} [:a {:href "/athletes/5001194"} "Anatoliy Holovan"]] [:td {} [:a {:href "/countries/UKR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UKR.png"}] "UKR"]]] [:tr {:class "referees", :style ""} [:th {} "Execution Judge 4"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003642"} "Min Suck-Hong"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]]] [:tr {:class "referees", :style ""} [:th {} "Execution Judge 5"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002457"} "Hélène Morneau"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]]] [:tr {:class "referees", :style ""} [:th {} "Execution Judge 6"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003382"} "Marc Faber"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronization Judge 1"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003669"} "Mohamed Hassan"]] [:td {} [:a {:href "/countries/EGY"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/EGY.png"}] "EGY"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronization Judge 2"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002068"} "Félix Calderón Rodríguez"]] [:td {} [:a {:href "/countries/PUR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/PUR.png"}] "PUR"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronization Judge 3"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004892"} "William Lee"]] [:td {} [:a {:href "/countries/SGP"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SGP.png"}] "SGP"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronization Judge 4"] [:td {:style "width: 400px"} [:a {:href "/athletes/48107"} "Ildikó Kelemen"]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronization Judge 5"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004432"} "Simon Latimer"]] [:td {} [:a {:href "/countries/NZL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NZL.png"}] "NZL"]]]]] [:div {:class "description"} [:p {} "Since its launch at the 2000 Olympics, China has won three of the four men’s synchronized springboard gold medals and " [:a {:href "/athletes/116070"} "Qin Kai"] " was hoping for a third consecutive gold medal with " [:a {:href "/athletes/122304"} "Cao Yuan"] ", with whom he won the 2015 world title. Qin had an outstanding record in springboard diving, particularly the synchronised event. He was the individual silver medalist at London in 2012 and was the synchronised gold medalist in 2008 and 2012 and the gold medal winner at all five biennial World Championships between 2007-15. He came to the Games with an impressive string of results in 2016, having won the synchronised title at all three World Series events in Windsor (Canada), Dubai and Beijing. On each occasion he was partnered by Cao Yuan and it was difficult to see gold going anywhere other than to those two. Cao was a 10-metres synchronised gold medalist in 2012, but did not defend his title, entering the 3-metre event instead. The only serious threat to the Chinese divers seemed to be coming from the Russians " [:a {:href "/athletes/120520"} "Ilya Zakharov"] " and " [:a {:href "/athletes/120521"} "Yevgeny Kuznetsov"] ", runners-up in London 2012 and second to Kai and Yuan at the 2015 World Championship, where the British pair " [:a {:href "/athletes/122961"} "Jack Laugher"] " and " [:a {:href "/athletes/122962"} "Chris Mears"] " won bronze."] "\n\n" [:p {} "The water in the pool was still the murky green colour it had mysteriously become, but it did not bother Kai and Yuan. It looked as though the Chinese clean sweep of diving golds would continue after the first two rounds when they led from Laugher and Mears and the American duo " [:a {:href "/athletes/136299"} "Sam Dorman"] " and " [:a {:href "/athletes/136298"} "Mike Hixon"] ". Round three saw the fancied Russians fall further behind after a bad dive and, unusually, the same happened to the Chinese pair as the British lads dived into the lead ahead of China and the United States."] "\n\n" [:p {} "The fourth round saw heavy rain blowing across the board but the America pair were not affected as they went ahead of China and into the silver medal position. The fifth series of dives saw the Chinese pair back into second place while the British duo held on to a 2.64 point lead. Another disastrous round by the Russians, who registered only 63.00 points, saw the 2012 silver medalists out of contention."] "\n\n" [:p {} "The fifth round was shrouded with controversy. The Germans had dived first and their 81.60 temporarily put them in the lead. Next to go were the Mexican divers " [:a {:href "/athletes/135127"} "Jahir Ocampo"] " and " [:a {:href "/athletes/107964"} "Rommel Pacheco"] ". They just set off on their dive as the stadium lights came on and they completed their dive but insisted the lights had put them off and a re-dive was ordered so they climbed up to the board to take their dive again. At poolside, however, discussions were taking place and it was decided not to allow them a re-dive and they were called back down and after an eight-minute delay the Americans were next to dive. Fortunately the delay did not affect them as they scored a competition best 98.04 and become the new leaders. Great Britain and China, however, still had to dive."] "\n\n" [:p {} "Laugher and Mears put in a great dive and knew that more than 88 points would put them in the lead, which they did with a 91.20. Now only the Chinese could deprive them of gold but, by their normal high standards, Yuan and Kai only managed 83.22 and had to be content with bronze, as Great Britain won its first ever Olympic diving gold, the pair from the Leeds diving club adding this title to the European and Commonwealth ones they already held. For Mears the win had a far reaching significance because he faced life-saving surgery to have his spleen removed in 2009 and spent time in a coma. For China that dream of a clean sweep of medals was over."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Points"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Great Britain"] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {} "454.32"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "9"} [:a {:href "/athletes/122961"} "Jack Laugher"] " • " [:a {:href "/athletes/122962"} "Chris Mears"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://oly