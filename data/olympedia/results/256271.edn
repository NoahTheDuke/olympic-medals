alue "256285"} "Canadian Doubles, Slalom, Men"] "\n" [:option {:value "256310"} "Kayak Singles, Slalom, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255411"} "1972"] "\n" [:option {:value "256030"} "1992"] "\n" [:option {:value "256160"} "1996"] "\n" [:option {:value "256388"} "2004"] "\n" [:option {:value "258816"} "2008"] "\n" [:option {:value "307006"} "2012"] "\n" [:option {:value "353502"} "2016"] "\n" [:option {:value "19006314"} "2020"] "\n" [:option {:value "2008400"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/167"} "Event type"]] [:h1 {:class "event_title"} "Kayak Singles, Slalom, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "19 – 20 September 2000"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/754"} "Penrith Whitewater Stadium, Penrith, New South Wales"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/256271"} "23 from 18 countries"]]]]] [:div {:class "description"} [:p {} "The format of the K-1 slalom had changed since the previous Olympics, as now the scores of both rounds, rather than just the best one, counted and there was a qualifying round prior to the final. Nonetheless one previous medalist, 1992 Olympic and 2000 European champion " [:a {:href "/athletes/10178"} "Pierpaolo Ferrazzi"] " of Italy, elected to participate. Canadian " [:a {:href "/athletes/9269"} "David Ford"] " was the reigning World Champion, while " [:a {:href "/athletes/9777"} "Paul Ratcliffe"] " was the 1998 European champion. Ratcliffe placed the highest among all these three in the qualifying round, but was still behind " [:a {:href "/athletes/90253"} "Mathias Röthenmund"] " of Switzerland and " [:a {:href "/athletes/90198"} "Thomas Schmidt"] " of Germany. Ferrazzi was 11th and Ford was 22nd and thus suffered elimination. Schmidt was in first after the first run of the final, with Ferrazzi in second, Ratcliffe in third, and Röthenmund in ninth. Schmidt won the second run as well and thus guaranteed himself gold, while Slovenia’s " [:a {:href "/athletes/90250"} "Dejan Kralj"] " was second. This was not sufficient to overcome his 12th-place run from the first round and thus Ratcliffe, who was third again, was able to claim the silver medal. Ferrazzi, meanwhile, was eighth but this was sufficient for him to earn bronze."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/90198"} "Thomas Schmidt"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "253.17 (2)"] [:td {} "217.25 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/9777"} "Paul Ratcliffe"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {} "253.69 (3)"] [:td {} "223.71 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/10178"} "Pierpaolo Ferrazzi"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "htt