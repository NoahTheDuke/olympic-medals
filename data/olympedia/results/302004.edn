value "62879"} "1984"] "\n" [:option {:value "63522"} "1988"] "\n" [:option {:value "64204"} "1992"] "\n" [:option {:value "64883"} "1996"] "\n" [:option {:value "65542"} "2000"] "\n" [:option {:value "66222"} "2004"] "\n" [:option {:value "257355"} "2008"] "\n" [:option {:value "358771"} "2016"] "\n" [:option {:value "19000526"} "2020"] "\n" [:option {:value "2013683"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/80"} "Event type"]] [:h1 {:class "event_title"} "Shot Put, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 3 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/874"} "Olympic Stadium, Olympic Park, Stratford, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/302004"} "40 from 34 countries"]]]]] [:div {:class "description"} [:p {} "Poland’s " [:a {:href "/athletes/103827"} "Tomasz Majewski"] " was back and expected to contend for gold, along with Canada’s " [:a {:href "/athletes/117036"} "Dylan Armstrong"] ", who was ranked #1 in the world in 2011, and " [:a {:href "/athletes/125814"} "David Storl"] " of Germany, the 2011 World Champion. The American threesome of " [:a {:href "/athletes/103812"} "Reese Hoffa"] ", " [:a {:href "/athletes/114511"} "Christian Cantwell"] ", and " [:a {:href "/athletes/126096"} "Ryan Whiting"] " was also expected to contend for medals, but American putters had had difficulty winning gold recently at major internationals, although Whiting had won the 2012 World Indoors."] "\n\n" [:p {} "In the first round Storl took the lead with 21.84, followed by Majewski with 21.19 and Hoffa in third with 20.98. Majewski improved in round two with 21.72 but Storl also did so, posting 21.86. In round three Majewski would get the shot out to 21.87, a mark that would be good enough for gold, although he would improve in the final round to 21.89. The competition for medals was effectively over after round three as Majewski would win gold, Storl silver, and Hoffa bronze, his best mark of 21.23 coming in round three. Of the leaders, only Majewski improved in the final three rounds, save for Cantwell, who was fourth going into the final rounds, and solidified that in round six with 21.19. Storl fouled on all three of his final throws."] "\n\n" [:p {} "Majewski became only the third person to defend an Olympic shot put gold medal, after " [:a {:href "/athletes/78977"} "Ralph Rose"] " in 1904 and 1908 and " [:a {:href "/athletes/78854"} "Parry O’Brien"] " in 1952 and 1956."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "2659"] [:td {} [:a {:href "/athletes/103827"} "Tomasz Majewski"]] [:td {} [:a {:href "/countries/POL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/POL.png"}] "POL"]] [:td {} "21.03 (3)"] [:td {} "21.89 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "1924"] [:td {} [:a {:href "/athletes/125814"} "David Storl"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "21.15 (2)"] [:td {} "21.86 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "3221"] [:td {} [:a {:href "/athletes/103812"} "Reese Hoffa"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] 