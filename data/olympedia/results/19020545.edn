ue "19020481"} "1,000 metres, Men"] "\n" [:option {:value "19020502"} "1,500 metres, Men"] "\n" [:option {:value "19020517"} "5,000 metres Relay, Men"] "\n" [:option {:value "19020524"} "500 metres, Women"] "\n" [:option {:value "19020566"} "1,500 metres, Women"] "\n" [:option {:value "19020581"} "3,000 metres Relay, Women"] "\n" [:option {:value "19020588"} "2,000 metres Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "905373"} "1988"] "\n" [:option {:value "601"} "1994"] "\n" [:option {:value "693"} "1998"] "\n" [:option {:value "799"} "2002"] "\n" [:option {:value "916"} "2006"] "\n" [:option {:value "923740"} "2010"] "\n" [:option {:value "350771"} "2014"] "\n" [:option {:value "9001185"} "2018"] "\n" [:option {:value "15000965"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/548"} "Event type"]] [:h1 {:class "event_title"} "1,000 metres, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "9 – 11 February 2022"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/845"} "Shoudu Tiyguan, Beijing"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19020545"} "32 from 14 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Placements 1-8 based on final and B final.  Deeper placements based on placements in earlier rounds, and best time skated."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/350771"} "1:28.771"] " / " [:a {:href "/athletes/119809"} "Valérie Maltais"] " " [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"] " / 18 February 2014 / " [:a {:href "/records/event_name/548"} "Details"]]]]] [:div {:class "description"} [:p {} "Since her Olympic win in 2018, the 1,000 m had been the domain of " [:a {:href "/athletes/137698"} "Suzanne Schulting"] ". She had earned the 2019 and 2021 world title, had won the 1,000 m World Cup in 2018/19, 2019/20 and 2021/22, and the European title in 2020 and 2021. She was not unbeatable, however, as earlier in the season, she had lost two World Cups, first to " [:a {:href "/athletes/149168"} "Kristen Santos"] " and later to " [:a {:href "/athletes/137642"} "Lee Yu-Bin"] " and " [:a {:href "/athletes/148015"} "Courtney Sarault"] ". Moreover, the 500 m had shown that " [:a {:href "/athletes/136927"} "Kim Boutin"] " and especially " [:a {:href "/athletes/109931"} "Arianna Fontana"] " were also in shape."] "\n\n" [:p {} "The first of these contenders literally fell out of competition in the heats, as Boutin fell in the final curve while leading her heat. In the quarter-finals, Schulting confirmed her role as a favorite by lowering the world record to 1:26.514, while Sarault dropped out at this stage. The semi-finals were also fairly uneventful, although Lee did not proceed after just losing out to " [:a {:href "/athletes/147886"} "Hanne Desmet"] "."] "\n\n" [:p {} "Per her usual tactics, Schulting grabbed the early lead, leaving the others to try and pass her. Behind her, Fontana seemed to be waiting for an opportunity to pass, as she had successfully done in the final of the 500 m. At the bell, Santos, Fontana and " [:a {:href "/athletes/137639"} "Choi Min-Jeong"] " all made their move. This ended badly for the Italian as she blocked Santos and both crashed out, with Fontana later being penalized. That gave Choi room to make an attempt at Schulting, but the Dutch skater clawed her way to the finish to retain her 2018 title, the first skater since " [:a {:href "/athletes/80843"} "Jeon I-Gyeong"] " to do this. Behind them it was Desmet who captured the bronze. A training partner of Schulting, they celebrated their medals together. For Belgium, it was their first Olympic medal in short-track speed skating."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Helmet Nr"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Position Last Race"] [:th {} "Positions"] [:th {} "Best Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/137698"} "Suzanne Schulting"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "AF-1"] [:td {} "1-1-1"] [:td {} "1:26.514"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "40"] [:td {} [:a {:href "/athletes/137639"} "Choi Min-Jeong"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} "AF-2"] [:td {} "3-2-1"] [:td {} "1:26.850"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "5"] [:td {} [:a {:href "/athletes/147886"} "Hanne Desmet"]] [:td {} [:a {:href "/countries/BEL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BEL.png"}] "BEL"]] [:td {} "AF-3"] [:td {} "2-2-2"] [:td {} "1:27.836"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "8"] [:td {} [:a {:href "/athletes/149168"} "Kristen Santos"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: