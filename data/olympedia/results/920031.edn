dle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge"] [:td {:style "width: 400px"} [:a {:href "/athletes/5005032"} "Eliel Saarinen"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]]] [:tr {:class "referees", :style ""} [:th {} "Judge"] [:td {:style "width: 400px"} [:a {:href "/athletes/5005044"} "Myron Hunt"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge"] [:td {:style "width: 400px"} [:a {:href "/athletes/5005045"} "Warren P. Laird"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge"] [:td {:style "width: 400px"} [:a {:href "/athletes/5005046"} "Frederick Meyer"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]]]] [:div {:class "description"} [:p {} "There were 58 participants from 14 countries who took part in architecture, with 63 exhibits (including “hors concours“). The architects were offered a wide range of possibilities. There were drawings, watercolors, perspective drawings, sketches, and photographs of construction projects to be submitted, “whose ultimate purpose is related to the training exercises of sport, such as stadiums, sports grounds, playgrounds, covered lanes, club buildings, boat houses, gymnasiums, bathhouses etc., and meet high artistic standards”. The exhibits for the two competitions, “" [:a {:href "/results/920030"} "Town Planning"] "” and “Architectural Designs”, were identical, but were assessed separately for both categories. Therefore, works that were not awarded with a medal " [:a {:href "/results/920032"} "cannot be attributed to either category"] "."] "\n\n" [:p {} "In architecture, all six medals were awarded. Probably for the first time, so-called “Honorable Mentions” were also expressed. The jury for architecture consisted of mostly well known architects from the USA."] "\n\n" [:p {} "It was quite amazing that the jury gave the gold medal to the community work of three Parisian architects — " [:a {:href "/athletes/920405"} "Gustave Saacké"] ", " [:a {:href "/athletes/920268"} "Pierre Bailly"] " and " [:a {:href "/athletes/921686"} "Pierre Montenot"] " — for their plan for a " [:em {} "Cirque pour Toros"] " when one considers that a bullring has no significant connection to the Olympics Games."] "\n\n" [:p {} "American architect " [:a {:href "/athletes/921596"} "John Russell Pope"] " earned the silver medal with " [:em {} "Payne Whitney Gymnasium, Yale University"] ", which had already been built. The bronze medal went to " [:a {:href "/athletes/920660"} "Richard Konwiarz"] " for his " [:em {} "Plan of Silesian Race Course"] ". In 1932, he competed with the same work as " [:a {:href "/results/920017"} "1928"] ", again with photos of Wrocław Stadium, this time with more success."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Catalogue Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Translated Title"] [:th {} "Original Title"] [:th {} "Title in Olympic Report or Catalogue"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "330"] [:td {} [:a {:href "/athletes/920405"} "Gustave Saacké"] " / " [:a {:href "/athletes/920268"} "Pierre Bailly"] " / " [:a {:href "/athletes/921686"} "Pierre Montenot"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://o