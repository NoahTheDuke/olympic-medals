f "/results/1034"} "1:31.40"] " / " [:a {:href "/athletes/82084"} "Monika Pflug"] " " [:a {:href "/countries/FRG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRG.png"}] "FRG"] " / 11 February 1972 / " [:a {:href "/records/event_name/538"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/99265"} "Manfred Zojer"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/1200586"} "Jean Heckly"]] [:td {} [:a {:href "/countries/SUI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SUI.png"}] "SUI"]]]]] [:div {:class "description"} [:p {} "As in the 500, the three favorites were Americans " [:a {:href "/athletes/83083"} "Sheila Young"] " and " [:a {:href "/athletes/82114"} "Leah Poulos"] ", and Soviet sprinter " [:a {:href "/athletes/80567"} "Tatyana Averina"] ". Young was better in the 500 but was still probably a slight favorite, as she had won the 1973 and 1975 World Sprints, with Poulos winning in 1974, when Young had fallen during one race. But Averina held the world record with 1:23.46, the last of three world records set in 1975 at Medeo. It was expected to be a close race. In the first pair, the defending champion " [:a {:href "/athletes/82084"} "Monika Holzner"] " posted 1:29.54 to set the mark to chase. That held up until the fifth pair, when Poulos was the first favorite to start, finishing in 1:28.57. In the next pair, Averina moved ahead, crossing the line in 1:28.43. Young started in the ninth pair and at 600 metres was ahead of both their paces, but she faded on the final lap, finishing in 1:29.14, and dropped down to the bronze medal, with Averina winning gold and Poulos the silver. Young’s bronze gave her a full set in Innsbruck, with gold in the 500, followed by a silver in the 1,500. A few weeks later at the 1976 World Sprints, Young would dominate, winning the title and all four races."] "\n"] [:button {:id "button8843", :class "btn btn-default"} "Details"] [:script {} "$('#button8843').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "200 m"] [:th {:style "display: none", :class "split"} "600 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "6O"] [:td {} [:a {:href "/athletes/80567"} "Tatyana Averina"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "1:28.43"] [:td {:class "split", :style "display: none"} "19.35"] [:td {:class "split", :style "display: none"} "52.57"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "5O"] [:td {} [:a {:href "/athletes/82114"} "Leah Poulos"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "1:28.57"] [:td {:class "split", :style "display: none"} "19.80"] [:td {:class "split", :style "display: none"} "52.77"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "9I"] [:td {} [:a {:href "/athletes/83093"} "Sheila Young"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "