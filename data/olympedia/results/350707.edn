50728"} "1,500 metres, Men"] "\n" [:option {:value "350743"} "5,000 metres Relay, Men"] "\n" [:option {:value "350750"} "500 metres, Women"] "\n" [:option {:value "350771"} "1,000 metres, Women"] "\n" [:option {:value "350792"} "1,500 metres, Women"] "\n" [:option {:value "350807"} "3,000 metres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "905307"} "1988"] "\n" [:option {:value "481"} "1992"] "\n" [:option {:value "555"} "1994"] "\n" [:option {:value "647"} "1998"] "\n" [:option {:value "739"} "2002"] "\n" [:option {:value "857"} "2006"] "\n" [:option {:value "923676"} "2010"] "\n" [:option {:value "9001121"} "2018"] "\n" [:option {:value "19020481"} "2022"] "\n" [:option {:value "15000901"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/544"} "Event type"]] [:h1 {:class "event_title"} "1,000 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "13 – 15 February 2014"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/887"} "Dvorets Zimnego Sporta Aisberg, Coastal Cluster, Adler"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/350707"} "32 from 14 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Placements 1-8 based on final and B final.  Deeper placements based on placements in earlier rounds, and best time skated."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/923676"} "1:23.747"] " / " [:a {:href "/athletes/119779"} "Lee Jeong-Su"] " " [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"] " / 20 February 2010 / " [:a {:href "/records/event_name/544"} "Details"]]]]] [:div {:class "description"} [:p {} "A South Korean had won this event in 2010, and all 1,000 m World Champions since the then had also hailed from there. However, most of them did not compete in Sochi. Defending champion " [:a {:href "/athletes/119779"} "Lee Jeong-Su"] " had retired following a race-fixing scandal at the 2010 World Championships. 2010 World Champion [Lee Ho-Seok] did race in Sochi, but only in the relay event, while 2011 champion No Jin-Kyu (brother of speed skater [No Seon-Yeong]) was absent due to a broken elbow. " [:a {:href "/athletes/119776"} "Gwak Yun-Gi"] ", the 2012 champion had failed to make the team, leaving only " [:a {:href "/athletes/128115"} "Sin Da-Un"] ", the reigning World Champion, to compete. Stiff competition was to be expected from " [:a {:href "/athletes/109918"} "Charles Hamelin"] ", who had won three of the four World Cups in late 2013; " [:a {:href "/athletes/127580"} "Wu Dajing"] ", winner of the other World Cup race and " [:a {:href "/athletes/101557"} "Viktor An"] ", the Korean-turned-Russian who had been runner-up in two World Cups and had earned the Olympic gold back in Torino."] "\n\n" [:p {} "A crash in the early stages meant that 1,500 metres gold medallist Charles Hamelin was eliminated quickly. In the first semi-final " [:a {:href "/athletes/101567"} "Vladimir Grigoryev"] " and Sin advanced comfortably when " [:a {:href "/athletes/128113"} "Lee Han-Bin"] " took out " [:a {:href "/athletes/119802"} "Sjinkie Knegt"] " and fell behind – Knegt was advanced to the final. In the second semi-final favourite Viktor An skated his usual race in coming from behind to win ahead of Wu. In the final the Russians Grigorev and An skated at the front for most of the race and, in the race to the line An was the stronger, regaining the gold medal he had last won in 2006. Knegt went on to win the bronze medal fairly comfortably. All three medals went to countries that had never before medalled at the Olympics, although the Unified Team had won a bronze in 1992, and the Dutch had medalled at the demonstration events in 1988."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Helmet Nr"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Position Last Race"] [:th {} "Positions"] [:th {} "Best Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "250"] [:td {} [:a {:href "/athletes/101557"} "Viktor An"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]] [:td {} "AF-1"] [:td {} "1-1-1"] [:td {} "1:24.102"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "252"] [:td {} [:a {:href "/athletes/101567"} "Vladimir Grigoryev"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]] [:td {} "AF-2"] [:td {} "1-2-1"] [:td {} "1:24.868"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "248"] [:td {} [:a {:href "/athletes/119802"} "Sjinkie Knegt"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "AF-3"] [:td {} "3-2-2"] [:td {} "1:25.611"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "212"] [:td {} [:a {:href "/athletes/127580"} "Wu Dajing"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: m