value "155136"} "Individual Time Trial, Men"] "\n" [:option {:value "155176"} "Individual Time Trial, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "154567"} "1984"] "\n" [:option {:value "154673"} "1988"] "\n" [:option {:value "154793"} "1992"] "\n" [:option {:value "154918"} "1996"] "\n" [:option {:value "155045"} "2000"] "\n" [:option {:value "259030"} "2008"] "\n" [:option {:value "308001"} "2012"] "\n" [:option {:value "356866"} "2016"] "\n" [:option {:value "19001702"} "2020"] "\n" [:option {:value "2003682"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/242"} "Event type"]] [:h1 {:class "event_title"} "Road Race, Individual, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "15 August 2004 — 15:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/790"} "Plateia Kozia, Athina"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/155175"} "67 from 30 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "105.6 km. (65.6 miles) mass start race."]]]] [:div {:class "description"} [:p {} "As the 2004 Olympics approached, women’s road cycling was in turmoil. The sponsorships of the late 80s and 90s were falling away. The women no longer raced a Tour de France Feminin and several other top female races were dropped because of lack of sponsorship. Thus the Olympics and World Championships assumed even greater importance to the female professional riders. For the first time ever at the Olympics, there was no clear favorite in 2004, partly because there were fewer international races. The once dominant " [:a {:href "/athletes/13167"} "Jeannie Longo"] ", rode in her sixth Olympics in 2004, but had not won any major titles in years. The defending champion, " [:a {:href "/athletes/13253"} "Leontien Zijlaard-Van Moorsel"] " of the Netherlands, was back, but nobody could expect her to repeat her 2000 Olympic performance in which she won three events (road race, time trial, individual pursuit) and was silver medalist in the points race. A fall early in the race eliminated her from the competition. Based on earlier results, Sweden’s " [:a {:href "/athletes/13166"} "Susanne Ljungskog "] ", the 2002 and 2003 World Champion was also favored for a medal, but she was dropped early and finished 33rd. The race was run thru the center of Athens, but unlike the men’s race, several groups did break away. On the final lap, the two leaders were Australia’s " [:a {:href "/athletes/103692"} "Sara Carrigan"] " and Germany’s " [:a {:href "/athletes/13057"} "Judith Arndt"] ". But it did not really come down to a sprint, as Carrigan broke Arndt over the last kilometer and won by seven seconds. It was somewhat of an upset as this was Carrigan’s first major international victory. Arndt was better known, having won a bronze medal in the pursuit at the 1996 Olympics, a World Championship in the pursuit in 1997, and she would win the 2004 World Championship road race."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Margin"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/103692"} "Sara Carrigan"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]] [:td {} "3-24:24"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :sty