514"} "High Jump, Women"] "\n" [:option {:value "302198"} "Pole Vault, Women"] "\n" [:option {:value "9031008"} "Long Jump, Women"] "\n" [:option {:value "9031022"} "Triple Jump, Women"] "\n" [:option {:value "302181"} "Shot Put, Women"] "\n" [:option {:value "302021"} "Discus Throw, Women"] "\n" [:option {:value "302480"} "Hammer Throw, Women"] "\n" [:option {:value "302463"} "Javelin Throw, Women"] "\n" [:option {:value "302147"} "Heptathlon, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "59358"} "1956"] "\n" [:option {:value "59751"} "1960"] "\n" [:option {:value "60190"} "1964"] "\n" [:option {:value "60627"} "1968"] "\n" [:option {:value "61144"} "1972"] "\n" [:option {:value "61723"} "1976"] "\n" [:option {:value "62286"} "1980"] "\n" [:option {:value "62770"} "1984"] "\n" [:option {:value "63412"} "1988"] "\n" [:option {:value "64091"} "1992"] "\n" [:option {:value "64777"} "1996"] "\n" [:option {:value "65446"} "2000"] "\n" [:option {:value "66131"} "2004"] "\n" [:option {:value "257263"} "2008"] "\n" [:option {:value "358682"} "2016"] "\n" [:option {:value "19000480"} "2020"] "\n" [:option {:value "2013638"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/69"} "Event type"]] [:h1 {:class "event_title"} "20 kilometres Race Walk, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 4 August 2012 — 17:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/877"} "The Mall, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/302002"} "56 from 34 countries"]]]]] [:div {:class "description"} [:p {} "China had been improving in the walks over the last few years, but nobody was quite expecting the result of this race. " [:a {:href "/athletes/122505"} "Chen Ding"] " won the gold medal, while his countrymen " [:a {:href "/athletes/122504"} "Wang Zhen"] " and " [:a {:href "/athletes/122507"} "Cai Zelin"] " placed 3-4, to give China three of the top four spots. The silver went to Guatemalan " [:a {:href "/athletes/123159"} "Erick Barrondo"] ", making this the first Olympic walk podium without a European, as Spain’s " [:a {:href "/athletes/126029"} "Miguel Ángel López"] " placed fifth."] "\n\n" [:p {} "Chen took the lead from the start, leading at the halfway point with Wang in 40:08, but Chen poured it on over the last 10K, negative splitting with a final 38:38, and what " [:em {} "Track &amp; Field News"] " described as a withering final lap in 7:31. The leaders were quite young, with Chen winning the day before his 20th birthday, while Wang was 20, and Barrondo and Cai only 21-years-old. Barrondo’s medal was the first ever Olympic medal for Guatemala."] "\n\n" [:p {} "The Chinese walk improvement was credited to Sandro Damilano, their Italian coach and the brother of 3-time Olympic medalist " [:a {:href "/athletes/71936"} "Maurizio Damilano"] ". He stressed technique to the Chinese, who had earlier been known for frequent disqualifications but had long overcome that. One major surprise in the 20K walk was the poor showing of the Russian walkers. Two-time World Champion " [:a {:href "/athletes/114641"} "Valeriy Borchin"] " staggered off the course with less than two kilometres left, the victim of a warm day, and did not finish, although he had been second at the time, while " [:a {:href "/athletes/120581"} "Vladimir Kanaykin"] " was disqualified, and " [:a {:href "/athletes/120584"} "Andrey Krivov"] " placed only 37th."] "\n\n" [:p {} "That was how the event and the results seemed to have ended. In 2015, however, the IOC began re-testing samples from the 2008 Beijing and 2012 London Olympics, using newer, more advanced testing techniques, in an effort to find those who had used performance enhancing drugs (PEDs), but in whom it could not be detected at the time of those Olympics. This was one of the many events affected."] "\n\n" [:p {} "In January 2015 two Russians, " [:a {:href "/athletes/114641"} "Valeriy Borchin"] " and " [:a {:href "/athletes/120581"} "Vladimir Kanaykin"] ", were “disqualified” for biological passport offenses. Kanaykin had actually already been disqualified with three red cards, so effectively he was disqualified from having been disqualified, while Borchin, who did not finish in London, was thus disqualified from not finishing. In August 2017 the third Russian competitor, " [:a {:href "/athletes/120584"} "Andrey Krivov"] ", who originally finished 37th, was also disqualified for a biological passport offense."] "\n\n" [:p {} "The three Russian walkers in the 50 km race were also all disqualified on re-testing. All Russians walkers were coached by Viktor Chegin, who was infamous for his athletes testing positive for PED usage, which more than 35 of them did between 2005-15. On 17 February 2016, Chegin was banned for life from athletics coaching by the Russian Anti-Doping Agency (RUSADA)."] "\n"] [:button {:id "button152045", :class "btn btn-default"} "Details"] [:script {} "$('#button152045').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "Total Warnings"] [:th {:style "display: none", :class "split"} "Loss of Contact Warnings"] [:th {:style "display: none", :class "split"} "Bent Knee Warnings"] [:th {:style "display: none", :class "split"} "2 km"] [:th {:style "display: none", :class "split"} "4 km"] [:th {:style "display: none", :class "split"} "6 km"] [:th {:style "display: none", :class "split"} "8 km"] [:th {:style "display: 