8"} "1,500 metres, Men"] "\n" [:option {:value "350743"} "5,000 metres Relay, Men"] "\n" [:option {:value "350750"} "500 metres, Women"] "\n" [:option {:value "350771"} "1,000 metres, Women"] "\n" [:option {:value "350792"} "1,500 metres, Women"] "\n" [:option {:value "350807"} "3,000 metres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "905286"} "1988"] "\n" [:option {:value "535"} "1994"] "\n" [:option {:value "627"} "1998"] "\n" [:option {:value "719"} "2002"] "\n" [:option {:value "838"} "2006"] "\n" [:option {:value "923655"} "2010"] "\n" [:option {:value "9001100"} "2018"] "\n" [:option {:value "19020460"} "2022"] "\n" [:option {:value "15000880"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/543"} "Event type"]] [:h1 {:class "event_title"} "500 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "18 – 21 February 2014"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/887"} "Dvorets Zimnego Sporta Aisberg, Coastal Cluster, Adler"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/350686"} "32 from 16 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Placements 1-8 based on final and B final.  Deeper placements based on placements in earlier rounds, and best time skated."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/923655"} "40.770"] " / " [:a {:href "/athletes/109918"} "Charles Hamelin"] " " [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"] " / 26 February 2010 / " [:a {:href "/records/event_name/543"} "Details"]]]]] [:div {:class "description"} [:p {} "In the four World Cup races held in the 2013-2014 season, defending Olympic Champion " [:a {:href "/athletes/109918"} "Charles Hamelin"] " of Canada and converted Korean skater " [:a {:href "/athletes/101557"} "Viktor An"] " had both taken two wins in the 500 m, with An winning the overall title. In Sochi, they would be joined by defending World champion " [:a {:href "/athletes/119780"} "Liang Wenhao"] " of China, and 2012 World Champion " [:a {:href "/athletes/119790"} "Olivier Jean"] "."] "\n\n" [:p {} "The heats of the 500 m immediately saw the exit of " [:a {:href "/athletes/109918"} "Charles Hamelin"] ", who fell in his heat by his own error. Both Korean contenders were eliminated in the quarter-finals, as was Jean. This left An and Liang both making the final, where they were joined by " [:a {:href "/athletes/127545"} "Charle Cournoyer"] " and " [:a {:href "/athletes/127580"} "Wu Dajing"] "."] "\n\n" [:p {} "In an noisy Iceberg Skating Palace, Viktor An took the ice hoping to earn his second gold of the Games. But he had a slow start, and with just two laps to go he was still last. Then, Liang crashed out, and within a lap An first passed Courneyer and then Wu. An held on until the finish, claiming the gold. He had now won all four Olympic short track events at least once."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Helmet Nr"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Position Last Race"] [:th {} "Positions"] [:th {} "Best Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "250"] [:td {} [:a {:href "/athletes/101557"} "Viktor An"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-cen