0000"} "1920"] "\n" [:option {:value "20017"} "1924"] "\n" [:option {:value "20038"} "1928"] "\n" [:option {:value "20062"} "1932"] "\n" [:option {:value "20077"} "1936"] "\n" [:option {:value "20123"} "1948"] "\n" [:option {:value "20162"} "1952"] "\n" [:option {:value "20203"} "1956"] "\n" [:option {:value "20280"} "1964"] "\n" [:option {:value "20349"} "1968"] "\n" [:option {:value "20400"} "1972"] "\n" [:option {:value "20435"} "1976"] "\n" [:option {:value "20476"} "1980"] "\n" [:option {:value "20516"} "1984"] "\n" [:option {:value "20557"} "1988"] "\n" [:option {:value "20604"} "1992"] "\n" [:option {:value "20658"} "1994"] "\n" [:option {:value "20713"} "1998"] "\n" [:option {:value "20778"} "2002"] "\n" [:option {:value "20848"} "2006"] "\n" [:option {:value "924000"} "2010"] "\n" [:option {:value "350334"} "2014"] "\n" [:option {:value "9000660"} "2018"] "\n" [:option {:value "19020200"} "2022"] "\n" [:option {:value "15000700"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/339"} "Event type"]] [:h1 {:class "event_title"} "Ice Hockey, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "19 – 28 February 1960"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/136"} "Blyth Memorial Arena, Squaw Valley, California"] " / " [:a {:href "/venues/137"} "Eastern Rink, Squaw Valley, California"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/20243"} "152 from 9 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Round-robin pools, followed by medal and consolation rounds."]]]] [:div {:class "description"} [:p {} "Many people look back at the 1960 Winter Olympic ice hockey event, and assume the Soviet Union was a heavy favorite. But that belied recent tournament history. Sweden had won the 1957 World Championship, with the USSR second. Canada had won the 1958 and 1959 World Championships. With Czechoslovakia, it was thought that any one of four teams could have won the 1960 Olympic ice hockey gold medal. The Canadian team was again the Kitchener-Waterloo Dutchmen as the Allan Cup champions, the Whitby Dunlops, declined the invitation to skate in the Olympics."] "\n\n" [:p {} "The United States was represented by a young team of players from Boston and Minnesota and was not expected to challenge for the gold medal.  They played an 18-game tour prior to the Squaw Valley Games, winning 10, tying 4, and losing 4 games, hardly scaring anyone.  But in their first Olympic match, they upset Czechoslovakia, 7-5, and advanced to the medal round.  On February 27, the Americans faced the Soviets, and prevailed 3-2, led by the goaltending of " [:a {:href "/athletes/95288"} "Jack McCartan"] ". The next day the Americans again met the Czechoslovak team, and trailed 4-3, after two periods. In the US locker room between periods, Soviet player " [:a {:href "/athletes/97690"} "Nikolay Sologubov"] " came in and showed the US players that they should take oxygen to give them more stamina for the final period. They did so, and trounced the Czechs in the 3rd period, winning 7-5."] "\n"] [:button {:id "button302565", :class "btn btn-default"} "Details"] [:script {} "$('#button302565').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {}] [:th {} "Pos"] [:th {} "Number"] [:th {} "Team"] [:th {} "NOC"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Games Played", :class "split", :style "display: none"} "GP"] [:th {:style "display: none", :class "split"} "Goals"] [:th {:style "display: none", :class "split"} "Assists"] [:th {:style "display: none", :class "split"} "Points"] [:th {:style "display: none", :class "split"} "Penalties in Minutes (PIM)"] [:th {:style "display: none", :class "split"} "Saves"] [:th {:style "display: none", :class "split"} "Save%"] [:th {:style "d