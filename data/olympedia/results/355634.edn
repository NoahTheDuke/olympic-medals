option {:value "127155"} "1972"] "\n" [:option {:value "127969"} "1976"] "\n" [:option {:value "128674"} "1980"] "\n" [:option {:value "129490"} "1984"] "\n" [:option {:value "130667"} "1988"] "\n" [:option {:value "131761"} "1992"] "\n" [:option {:value "132830"} "1996"] "\n" [:option {:value "133549"} "2000"] "\n" [:option {:value "134134"} "2004"] "\n" [:option {:value "263781"} "2008"] "\n" [:option {:value "332184"} "2012"] "\n" [:option {:value "19009387"} "2020"] "\n" [:option {:value "2007880"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/663"} "Event type"]] [:h1 {:class "event_title"} "Light-Heavyweight, Greco-Roman (≤85 kg), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "15 August 2016"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/902"} "Arena Carioca 2, Parque Olímpico da Barra, Barra da Tijuca, Rio de Janeiro"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/355634"} "21 from 21 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single elimination tournament. Competitors losing to the finalists entered repechage tournament for bronze medals."]]]] [:div {:class "description"} [:p {} "The number one contender for the 85 kg gold medal included the ever-consistent world-ranked number one Ukrainian, " [:a {:href "/athletes/136216"} "Zhan Beleniuk"] ", who entered the Rio Olympic Games as the European and World champion, and looking for his “remaining unfulfilled goal” of Olympic gold.  Also heavily favored was " [:a {:href "/athletes/117196"} "Saman Tahmasebi"] " of Azerbaijan who had bested Beleniuk in 2014, but was revenged in 2015. " [:a {:href "/athletes/135827"} "Davit Chakvetadze"] ", the Georgian-born Russian and 2015 European Games champion, entered the day ranked third in the world and found himself in the gold medal bout with Beleniuk."] "\n\n" [:p {} "Late in the gold medal final first period, Beleniuk took a 2-0 lead into the break, but the Russian controlled the second period grabbing a 3-2 advantage, throwing Beleniuk for a four-point take-down and adding two more points before the end of the bout to win the match 9-2 and win that elusive gold medal."] "\n\n" [:p {} "The bronze medals were won by " [:a {:href "/athletes/134254"} "Denis Kudla"] " of Germany and " [:a {:href "/athletes/132737"} "Dzhavid Gamzatov"] " of Belarus – the 2013 World Championships bronze medalist. Kudla, who lost by technical fall to Chakvetadze in the quarter-finals, fought back through the repêchage to fight for bronze. Behind 3-2 late in that bout against Hungary’s " [:a {:href "/athletes/134403"} "Viktor Lőrincz"] ", Kudla was awarded a penalty point with 34 seconds left that give him the edge on criteria. He held on to win the match and then collapsed to the ground in excitement. Gamzatov defeated " [:a {:href "/athletes/132996"} "Nikolay Bayryakov"] " of Bulgaria for the other bronze."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Classification Points", :class "footnote"} "CP"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Victories by Fall", :class "footnote"} "VF"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Victories by Technical Superiority", :class "footnote"} "ST"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Technical Points", :class "footnote"} "TP"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Technical Points Received", :class "footnote"} "TPR"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/135827"} "Davit Chakvetadze"]] [:td {} [:a {:href "/c