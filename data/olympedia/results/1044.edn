f "/results/1035"} "2:20.85"] " / " [:a {:href "/athletes/81312"} "Dianne Holum"] " " [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"] " /  9 February 1972 / " [:a {:href "/records/event_name/539"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/99265"} "Manfred Zojer"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/1200586"} "Jean Heckly"]] [:td {} [:a {:href "/countries/SUI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SUI.png"}] "SUI"]]]]] [:div {:class "description"} [:p {} "Unlike the women’s 500 and 1,000 in 1976, there was no clear favorite in this race. East Germany’s " [:a {:href "/athletes/81475"} "Karin Kessow"] " had won the 1975 World Championships and won the distance at that tournament. " [:a {:href "/athletes/80567"} "Tatyana Averina"] " had set the last two world records in the 1,500, the current one her 2:09.90, set at Medeo in 1975, which shattered the previous record by 4.1 seconds. And although " [:a {:href "/athletes/83083"} "Sheila Young"] " was a better sprinter, she was solid at this distance as well, and needed to be watched. The opening pair saw Norway’s " [:a {:href "/athletes/80639"} "Lisbeth Korsmo"] " break the Olympic record with a time of 2:18.99. That held up until Averina finished the fourth pairing in 2:17.96. The seventh pair had Averina’s teammate " [:a {:href "/athletes/82458"} "Galina Stepanskaya"] ", who had won the distance at the 1973 World Championships, but whose performances since had been somewhat ordinary. She set a fast pace, over a full second ahead of Averina at the 1,100 split, and held on, crossing in 2:16.58 to move well ahead. Young went off two pairs later, with Kessow, and though she was far behind at 1,100 metres, she had the fastest final lap to finish in 2:17.06 and win the silver medal, behind Stepanskaya, with Averina taking bronze, Korsmo in fourth, and Kessow placing fifth. The surprising Stepanskaya would place second at the World Championships in 1977 and 1978, winning the 1,500 and 3,000 at the 1977 Worlds."] "\n"] [:button {:id "button191469", :class "btn btn-default"} "Details"] [:script {} "$('#button191469').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "300 m"] [:th {:style "display: none", :class "split"} "700 m"] [:th {:style "display: none", :class "split"} "1100 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "7O"] [:td {} [:a {:href "/athletes/82458"} "Galina Stepanskaya"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "2:16.58"] [:td {:class "split", :style "display: none"} "28.85"] [:td {:class "split", :style "display: none"} "1:02.83"] [:td {:class "split", :style "display: none"} "1:38.63"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "9I"] [:td {} [:a {:href "/athletes/83093"} "Sheila Young"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "2:17.06"] [:td {:class "split", :style "display: none"} "28.28"] [:td {:class "sp