vents/1147"} "36 from 12 countries"]]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/1118"} "1:13.83"] " " [:span {:class "label label-primary"} "WR"] " / " [:a {:href "/athletes/83054"} "Chris Witty"] " " [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"] " / 17 February 2002 / " [:a {:href "/records/event_name/538"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002968"} "Junichi Takano"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/87337"} "Dan Immerfall"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]]]] [:div {:class "description"} [:p {} "There were many contenders for the 1000 m title in Torino. Germany’s " [:a {:href "/athletes/99411"} "Anni Friesinger"] " had won the 2003 and 2004 World Championships, and was runner-up in 2005. The crowd favorite was veteran Chiara Simionato, winner of the first 1000 m at the World Sprints just weeks before the Games. The other 1000 m that weekend had been won by the 500 m Olympic champion and World Sprint champion, " [:a {:href "/athletes/80719"} "Svetlana Boyarkina-Zhurova"] ", although she was not generally considered a 1000 m specialist. From North America, " [:a {:href "/athletes/100967"} "Cindy Klassen"] " and " [:a {:href "/athletes/99412"} "Jennifer Rodriguez"] " were also highly considered, with three Dutch women, " [:a {:href "/athletes/99388"} "Marianne Timmer"] " (1998 Olympic Champion), " [:a {:href "/athletes/99408"} "Barbara de Loor"] " (2005 World Champion) and " [:a {:href "/athletes/109767"} "Ireen Wüst"] " (winner of the 3000 m at Torino), considered as outsiders for a medal."] "\n\n" [:p {} "Not regularly skating the 1000 m, Cindy Klassen was drawn early in the program, lowering Friesinger’s track record from earlier that season to 1:16.09. Fellow Canadian " [:a {:href "/athletes/100968"} "Kristina Groves"] " faced Marianne Timmer a few pairs later. Timmer had been frustrated earlier in the Olympics, having been disqualified for two false starts in the 500 m. She opened out faster than Klassen, and held on to her lead in the last lap, beating the leading time by just 0.04 seconds."] "\n\n" [:p {} "Pair after pair failed to improve Timmer’s time, with 2002 Champion Witty doing no better than 27th, and favourite Simionato placing only 13th. In the last pair, Anni Friesinger seemed headed for the gold, clocking the same split as Klassen, and known for her strong last lap. But Friesinger, too, missed out in the end, finishing at 1:16.11, just behind Klassen to take the bronze."] "\n"] [:button {:id "button15910", :class "btn btn-default"} "Details"] [:script {} "$('#button15910').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "200 m"] [:th {:style "display: none", :class "split"} "600 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "11O"] [:td {} [:a {:href "/athletes/99388"} "Marianne Timmer"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "1:16.05"] [:td {:class "split", :style "display: none"} "17.99"] [:td {:class "split", :style "display: none"} "45.91"] [:td {} [:span {:class "Gold"} "Gold"]] [:td 