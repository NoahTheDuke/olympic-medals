ical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/76243"} "Sven Låftman"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]]]]] [:div {:class "description"} [:p {} "The world record was 5:13.8, set in 1953 at Medeo by Soviet Rimma Zhukova. At the recent World Championships, the distance had been won by " [:a {:href "/athletes/82395"} "Lidiya Skoblikova"] " (URS-1960), " [:a {:href "/athletes/81332"} "Eevi Huttunen"] " (FIN-1959), and Inga Artamanova (URS-1958). Skoblikova had already won the 1,500 metres in Squaw Valley. The other two Soviet skaters in the event, who had to be considered as no non-Soviet woman had been on the all-around podium at the World Championships since 1952, were " [:a {:href "/athletes/82242"} "Tamara Rylova"] " and " [:a {:href "/athletes/82455"} "Valentina Stenina"] ", wife of top men’s skater, " [:a {:href "/athletes/97825"} "Boris Stenin"] ". Stenina had recently won the 1960 World Championships in all-around, and had been second at this distance."] "\n\n" [:p {} "Twenty skaters came to the mark. Rylova was in the third pair and took the lead, but her time of 5:30.0 would place her only ninth. The next favorite to skate was Stenina in the seventh pair. Her time of 5:16.9 was considered fast, and put her into a comfortable lead. Huttunen was up two pairs later, and although she was ahead of Stenina’s pace through 2,200 metres, she struggled on the final laps, finishing in 5:21.0. Skoblikova was in the last pair, the 10th, but the day was cold, and the ice was still good. She led throughout, finishing in 5:14.3, the second fastest time ever. It was her second gold medal of the 1960 Winter Olympics, and four years later in Innsbruck, she would win all four women’s races."] "\n"] [:button {:id "button100989", :class "btn btn-default"} "Details"] [:script {} "$('#button100989').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "200 m"] [:th {:style "display: none", :class "split"} "600 m"] [:th {:style "display: none", :class "split"} "1000 m"] [:th {:style "display: none", :class "split"} "1400 m"] [:th {:style "display: none", :class "split"} "1800 m"] [:th {:style "display: none", :class "split"} "2200 m"] [:th {:style "display: none", :class "split"} "2600 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "10I"] [:td {} [:a {:href "/athletes/82395"} "Lidiya Skoblikova"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "5:14.3"] [:td {:class "split", :style "display: none"} "22"] [:td {:class "split", :style "display: none"} "1:00"] [:td {:class "split", :style "display: none"} "1:41"] [:td {:class "split", :style "display: none"} "2:22"] [:td {:class "split", :style "display: none"} "3:05"] [:td {:class "split", :style "display: none"} "3:47"] [:td {:class "split", :style "display: none"} "4:31"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "7I"] [:td {} [:a {:href "/athletes/82455"} "Valentina Stenina"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "5:16.9"] [:td {:class "split", :style "display: none"} "22"] [:td {:class "split", :style "display: none"} "1:01"] [:td {:class "split", :style "di