5"} "15 kilometres Mass Start, Men"] "\n" [:option {:value "923481"} "20 kilometres, Men"] "\n" [:option {:value "923486"} "4 × 7.5 kilometres Relay, Men"] "\n" [:option {:value "923490"} "7.5 kilometres Sprint, Women"] "\n" [:option {:value "923492"} "10 kilometres Pursuit, Women"] "\n" [:option {:value "923495"} "12.5 kilometres Mass Start, Women"] "\n" [:option {:value "923491"} "15 kilometres, Women"] "\n" [:option {:value "923496"} "4 × 6 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1587"} "2002"] "\n" [:option {:value "1601"} "2006"] "\n" [:option {:value "350023"} "2014"] "\n" [:option {:value "9000221"} "2018"] "\n" [:option {:value "19019631"} "2022"] "\n" [:option {:value "15000031"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/129"} "Event type"]] [:h1 {:class "event_title"} "12.5 kilometres Pursuit, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "16 February 2010 — 12:45"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/181"} "Whistler Olympic Park, Whistler"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/923482"} "60 from 24 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Starting margin based on results of 10 kilometer. Penalty loop (150 metres) skied for each missed target."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 13,095 m" [:br {}] "Height Differential: 27 m" [:br {}] "Maximum Climb: 25 m" [:br {}] "Shooting 1: Prone at 2.6 km, 50 m range" [:br {}] "Shooting 2: Prone at 5.3 km, 50 m range" [:br {}] "Shooting 3: Standing at 7.9 km, 50 m range" [:br {}] "Shooting 4: Standing at 10.5 km, 50 m range" [:br {}] "Total Climbing: 420 m"]]]] [:div {:class "description"} [:p {} "The starting order and time intervals between skiers was determined by the results of the 10 kilometres sprint event with only the top sixty finishers in the sprint being allowed to compete in the pursuit. Given that the outcome of the 10 kilometres event had largely been affected by the weather conditions, it was felt unlikely that the medallists from that event would end on the podium after the 12.5 kilometres pursuit section. For " [:a {:href "/athletes/111029"} "Emil Hegle Svendsen"] " of Norway and Croatia’s " [:a {:href "/athletes/118525"} "Jakov Fak"] ", who started 2nd and 3rd, this proved to be the case, these biathletes eventually finishing in 8th and 25th place respectively. In the end it was the Swede " [:a {:href "/athletes/101201"} "Bjorn Ferry"] " and " [:a {:href "/athletes/101195"} "Christoph Sumann"] " of Austria who started at 1:12 and 1:25 behind the first starter " [:a {:href "/athletes/118601"} "Vincent Jay"] ", who moved from 8th to 1st and 12th to 2nd , respectively, to take the gold and silver medals. Jay did well to hold on to the bronze medal by 2.8 seconds from another Austrian, the fast finishing " [:a {:href "/athletes/118582"} "Simon Eder"] ", mainly by virtue of his time in the 10 kilometres event."] "\n\n" [:p {} "Ferry, an outspoken opponent of doping in sport, had competed at the top level since 2001 but had never previously won a medal at world or Olympic level. His wife, Heidi Andersson, was an eight-time world champion in the sport of arm-wrestling."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Misses"] [:th {} "Start Behind"] [:th {} "Race"] [:th {} "Shooting 1 Misses"] [:th {} "Shooting 1"] [:th {} "Shooting 2 Misses"] [:th {} "Shooting 2"] [:th {} "Shooting 3 Misses