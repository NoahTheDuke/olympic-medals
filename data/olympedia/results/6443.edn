"4648"} "1912"] "\n" [:option {:value "4728"} "1920"] "\n" [:option {:value "4828"} "1924"] "\n" [:option {:value "4931"} "1928"] "\n" [:option {:value "5023"} "1932"] "\n" [:option {:value "5128"} "1936"] "\n" [:option {:value "5236"} "1948"] "\n" [:option {:value "5365"} "1952"] "\n" [:option {:value "5475"} "1956"] "\n" [:option {:value "5626"} "1960"] "\n" [:option {:value "5822"} "1964"] "\n" [:option {:value "6140"} "1968"] "\n" [:option {:value "6713"} "1976"] "\n" [:option {:value "6934"} "1980"] "\n" [:option {:value "7229"} "1984"] "\n" [:option {:value "7582"} "1988"] "\n" [:option {:value "7937"} "1992"] "\n" [:option {:value "8282"} "1996"] "\n" [:option {:value "8694"} "2000"] "\n" [:option {:value "9081"} "2004"] "\n" [:option {:value "261828"} "2008"] "\n" [:option {:value "322023"} "2012"] "\n" [:option {:value "357311"} "2016"] "\n" [:option {:value "19000228"} "2020"] "\n" [:option {:value "2001734"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/593"} "Event type"]] [:h1 {:class "event_title"} "4 × 100 metres Freestyle Relay, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "30 August 1972"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/543"} "Schwimmhalle, Olympiapark, München"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/6443"} "69 from 16 countries"]]]]] [:div {:class "description"} [:p {} "It was eight years since any nation other than the United States had set a world record in this event. But East Germany (GDR) was improving rapidly as a swimming power, at least among the women. The 100 freestyle champion, " [:a {:href "/athletes/51137"} "Sandy Neilson"] ", who had one that gold the day before, led off the final for the USA and put them ahead, but on the second leg, the GDR’s " [:a {:href "/athletes/47463"} "Andrea Eife"] " almost pulled even with " [:a {:href "/athletes/51080"} "Jenny Kemp"] ". After the third leg, the race was a dead-heat, with the anchor swimmers " [:a {:href "/athletes/50955"} "Shirley Babashoff"] " and " [:a {:href "/athletes/47465"} "Kornelia Ender"] ". They would become great rivals, but most of that was in Montréal four years hence. On the final leg, Babashoff had a slight lead going out but almost missed the wall on her turn and Ender took the lead coming home, only to see Babashoff rally and edge her out for the gold medal for the Americans, who finished in a world record 3:55.19."] "\n\n" [:p {} "The biggest shock of the final was the performance of the Australian women, who finished far back in last. No Aussie woman broke a minute for her split, even anchorwoman " [:a {:href "/athletes/45050"} "Shane Gould"] ". So far behind, she appeared to treat it as a warm-up swim for her 400 final, which took place an hour later, and posted a pedestrian 1:01.00."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "3:58.93 (1 h2)"] [:td {} "3:55.19 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "1072"] [:td {} [:a {:href "/athletes/51137"} "Sandy Neilson"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/51080"} "Jenny Kemp"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "1055"