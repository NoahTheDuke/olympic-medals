t", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "58121"} "1932"] "\n" [:option {:value "58442"} "1936"] "\n" [:option {:value "58796"} "1948"] "\n" [:option {:value "59173"} "1952"] "\n" [:option {:value "59536"} "1956"] "\n" [:option {:value "59989"} "1960"] "\n" [:option {:value "60407"} "1964"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/104"} "Event type"]] [:h1 {:class "event_title"} "80 metres Hurdles, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "17 – 18 October 1968"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/479"} "Estadio Olímpico Universitario, Ciudad de México"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/60903"} "33 from 23 countries"]]]]] [:div {:class "description"} [:p {} "This was the final 80 metre hurdle event at any major competition, as the women’s high hurdles moved up to 100 metres immediately after the 1968 Olympics. In June 1968, Soviet " [:a {:href "/athletes/77235"} "Vera Korsakova"] " had twice broken the world record at a meet in Rīga, Latvia, leaving the mark at 10.2 in the final – and it would become the still-standing 80 metre hurdle world record. While most sprints and horizontal jumps benefited from the altitude of Ciudad de México, with numerous world records set, the women did not match Korsakova’s world record. And Korsakova would not get to the final of the event, placing fifth in the first semi-final. The favorites were " [:a {:href "/athletes/69722"} "Karin Balzer"] ", 1964 gold medalist, and multiple European champion, and Australia’s " [:a {:href "/athletes/64535"} "Pam Kilborn"] ", Commonwealth Games champion in 1962, 1966, and later in 1970, who had not lost since the 1964 Olympics in which she was the bronze medalist. But in the final, Kilborn and Balzer both started very poorly. Balzer never recovered and finished fifth, but Kilborn came on string at the end and almost caught her teammate, the unheralded " [:a {:href "/athletes/64494"} "Maureen Caird"] ", who was only 17-years-old and remains the youngest individual track event gold medalist at the Olympics."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "36"] [:td {} [:a {:href "/athletes/64494"} "Maureen Caird"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]] [:td {} "10.4 (1 h4)"] [:td {} "10.5 (1 h1)"] [:td {} "10.3 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "37"] [:td {} [:a {:href "/athletes/64535"} "Pam Kilborn"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]] [:td {} "10.4 (1 h2)"] [:td {} "10.4 (1 h2)"] [:td {} "10.4 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "223"] [:td {} [:a {:href "/athletes/76844"} "Chi Cheng"]] [:td {} [:a {:href "/countries/TPE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/TPE.png"}] "TPE"]] [:td {} "10.5 (2 h4)"] [:td {} "10.5 (2 h2)"] [:td {} "10.4 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "106"] [:td {} [:a {:href "/athletes/77994"} "Patty