0 kilometres, Men"] "\n" [:option {:value "1988"} "4 × 10 kilometres Relay, Men"] "\n" [:option {:value "1992"} "5 kilometres, Women"] "\n" [:option {:value "1993"} "10 kilometres, Women"] "\n" [:option {:value "1994"} "4 × 5 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1915"} "1956"] "\n" [:option {:value "1926"} "1960"] "\n" [:option {:value "1937"} "1964"] "\n" [:option {:value "1949"} "1968"] "\n" [:option {:value "1961"} "1972"] "\n" [:option {:value "1973"} "1976"] "\n" [:option {:value "1999"} "1984"] "\n" [:option {:value "2013"} "1988"] "\n" [:option {:value "2030"} "1992"] "\n" [:option {:value "2050"} "1994"] "\n" [:option {:value "2070"} "1998"] "\n" [:option {:value "2090"} "2002"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/186"} "Event type"]] [:h1 {:class "event_title"} "30 kilometres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "14 February 1980 — 9:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/74"} "Mt. Van Hoevenberg Recreation Area, Lake Placid"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1986"} "57 from 20 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: ?" [:br {}] "Height Differential: 124 m" [:br {}] "Intermediate 1: 10.0 km" [:br {}] "Intermediate 2: 15.0 km" [:br {}] "Intermediate 3: 20.0 km" [:br {}] "Maximum Climb: 51 m" [:br {}] "Total Climbing: 867 m"]]]] [:div {:class "description"} [:p {} "The 1978 World Champion and defending Olympic Champion, Soviet " [:a {:href "/athletes/97200"} "Sergey Savelyev"] " was surprisingly not selected to their quartet for the 1980 cross-country opening distance, concentrating only on the 50 km. But the Soviet Union had a strong team, headed by 24-year old " [:a {:href "/athletes/99245"} "Nikolay Zimyatov"] ", the tall and lanky silver medalist at the distance at the 1978 World Championships. At 10 km, Zimyatov was in the lead, 13 seconds ahead of the Swede " [:a {:href "/athletes/98835"} "Thomas Wassberg"] ". Lying third, to everyone’s surprise, was Bulgarian " [:a {:href "/athletes/89484"} "Ivan Lebanov"] ", 1977 Junior World Champion, 19.5 seconds behind the leader. And the young Bulgarian continued to impress. At the halfway mark he had moved up to second place, 36 seconds behind the leading Zimyatov, but he was closely followed by Wassberg and Soviet " [:a {:href "/athletes/96904"} "Vasily Rochev"] ". Zimyatov continued to push the pace, at 20 km he had widened his lead to 40 seconds, but behind him it was very close: Wassberg now second, Lebanov third and Rochev fourth, all three within 8 seconds. Rochev, starting first of the favorites, was fastest over the last 10 km and finished in impressive style. Zimyatov, starting one minute behind Lobanov, caught the Bulgarian 5 km from home, and they finished together. Zimyatov came in half a minute ahead of his countryman Rochev, and Lobanov was now in bronze medal position. Wassberg, starting last of all, could not match Lobanov’s speed over the last kilometers and had to be content with fourth place. The surprise winner of the 15 km in the 1978 World Championships, the Pole " [:a {:href "/athletes/91977"} "Józef Łuszczek"] ", made his best ever Olympic placing by finishing fifth. Zimyatov won his first international championship, and Lobanov won the first ever Winter Olympics medal for Bulgaria, and it would be another 18 years before the next."] "\n"] [:button {:id "button347432", :class "btn btn-default"} "Details"] [:script {} "$('#button347432').click(splits)"] [:table