000"} "1900"] "\n" [:option {:value "38011"} "1904"] "\n" [:option {:value "38017"} "1908"] "\n" [:option {:value "38025"} "1912"] "\n" [:option {:value "38041"} "1920"] "\n" [:option {:value "38068"} "1924"] "\n" [:option {:value "38095"} "1928"] "\n" [:option {:value "38119"} "1932"] "\n" [:option {:value "38129"} "1936"] "\n" [:option {:value "38179"} "1948"] "\n" [:option {:value "38237"} "1952"] "\n" [:option {:value "38305"} "1956"] "\n" [:option {:value "38391"} "1964"] "\n" [:option {:value "38432"} "1968"] "\n" [:option {:value "38502"} "1972"] "\n" [:option {:value "38568"} "1976"] "\n" [:option {:value "38623"} "1980"] "\n" [:option {:value "38678"} "1984"] "\n" [:option {:value "38727"} "1988"] "\n" [:option {:value "38777"} "1992"] "\n" [:option {:value "38827"} "1996"] "\n" [:option {:value "38884"} "2000"] "\n" [:option {:value "38966"} "2004"] "\n" [:option {:value "262918"} "2008"] "\n" [:option {:value "330000"} "2012"] "\n" [:option {:value "396300"} "2016"] "\n" [:option {:value "19001580"} "2020"] "\n" [:option {:value "2003100"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/631"} "Event type"]] [:h1 {:class "event_title"} "Water Polo, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "25 August –  3 September 1960"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/422"} "Stadio Olimpico del Nuoto, Roma"] " / " [:a {:href "/venues/444"} "Piscina delle Rose, Roma"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/38341"} "149 from 16 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Round-robin pools advanced teams to the round-robin final pool."]]]] [:div {:class "description"} [:p {} "Italy had won the gold medal at the 1948 Olympics, while Hungary had won the last two golds, also placing first in 1932 and 1936. Along with Yugoslavia and the Soviet Union, these were the four strongest sides in the world, and they would finish in the top four at Rome, with all four advancing out of the semi-final pools to the medal round. There Italy and the Soviets tied with one win and one loss, and were equal on goal differential among the contested matches of the final pool. But the gold medal came down to the Italy-USSR match that had taken place in the semi-final pools, which Italy won 2-0. Hungary claimed the bronze medal as Yugoslavia lost both of its final pool matches."] "\n\n" [:p {} "Hungary’s " [:a {:href "/athletes/54156"} "Dezső Gyarmati"] " won his fourth consecutive water polo medal, after golds in 1952 and 1956 and a silver in 1948. He would return in 1964 to win his fifth medal, an all-time Olympic water polo record, with another gold. He is considered, with Spain’s " [:a {:href "/athletes/53757"} "Manuel Estiarte"] ", who competed from 1980-92, one of the two greatest ever water poloists. The leading goal scorer of the 1960 Olympic tournament was the surprising " [:a {:href "/athletes/54976"} "Fred Tisue"] " of the United States, which placed seventh. Tisue scored 12 goals in Rome, including five in one game against France in a preliminary round match."] "\n"] [:button {:id "button435342", :class "btn btn-default"} "Details"] [:script {} "$('#button435342').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {}] [:th {} "Pos"] [:th {} "Number"] [:th {} "Team"] [:th {} "NOC"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Games Played", :class "split", :style "display: none"} "GP"] [:th {:style "display: none", :class "split"} "Goals"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {:class "accordion-toggle", :data-toggle "collapse", :data-target ".team-members-563328"} [:div {:class "glyphicon glyphicon-plus"}]] [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "Italy"] [:td {} [:a {:href "/countrie