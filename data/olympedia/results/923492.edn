2"} "12.5 kilometres Pursuit, Men"] "\n" [:option {:value "923485"} "15 kilometres Mass Start, Men"] "\n" [:option {:value "923481"} "20 kilometres, Men"] "\n" [:option {:value "923486"} "4 × 7.5 kilometres Relay, Men"] "\n" [:option {:value "923490"} "7.5 kilometres Sprint, Women"] "\n" [:option {:value "923495"} "12.5 kilometres Mass Start, Women"] "\n" [:option {:value "923491"} "15 kilometres, Women"] "\n" [:option {:value "923496"} "4 × 6 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1594"} "2002"] "\n" [:option {:value "1609"} "2006"] "\n" [:option {:value "350028"} "2014"] "\n" [:option {:value "9000226"} "2018"] "\n" [:option {:value "19019636"} "2022"] "\n" [:option {:value "15000036"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/134"} "Event type"]] [:h1 {:class "event_title"} "10 kilometres Pursuit, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "16 February 2010 — 10:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/181"} "Whistler Olympic Park, Whistler"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/923492"} "60 from 24 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Starting margin based on results of 7.5 kilometer. Penalty loop (150 metres) skied for each missed target."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 10,480 m" [:br {}] "Height Differential: 27 m" [:br {}] "Maximum Climb: 25 m" [:br {}] "Shooting 1: Prone at 2.1 km, 50 m range" [:br {}] "Shooting 2: Prone at 4.2 km, 50 m range" [:br {}] "Shooting 3: Standing at 6.6 km, 50 m range" [:br {}] "Shooting 4: Standing at 8.5 km, 50 m range" [:br {}] "Total Climbing: 330 m"]]]] [:div {:class "description"} [:p {} "With the positions of the biathletes from the 7.5 kilometre event determining the starting places and times, this turned into a contest between [Anastasia Kuzmina] of Slovakia starting first and German " [:a {:href "/athletes/118546"} "Magdalena Neuner"] "  starting just 2 seconds behind. As the race progressed, Neuner overtook Kuzmina and stayed there to win by 12.3 seconds in a time of 30:16.0. The contest for third place was just as interesting, with " [:a {:href "/athletes/118550"} "Marie Dorin"] " of France who started in that position, fading to finish 17th. It was her compatriot, " [:a {:href "/athletes/118551"} "Marie Laure Brunet"] ", who gradually moved up from 6th place at the start into third place, half way around the course, and remain there for the rest of the race, taking the bronze medal, some 28.3 seconds behind Neuner. Remarkable runs from " [:a {:href ""} "Anna Carin Olofsson-Zidek"] " and " [:a {:href "/athletes/110008"} "Tora Berger"] " of Norway saw them move from 20th and 33rd up to 4th and 5th place respectively.\nNeuner was known for her erratic shooting but arrived in Vancouver with a run of victories in World Cup events. Olofsson-Zidek was a little unfortunate as race officials made a mistake and held her for an extra 14 seconds at the start. She finished 25 seconds behind Brunet at the finish but then had the missing seconds subtracted from her time. Whether having the Frenchwoman as a closer target to chase on the course would have spurred the Swede on to greater efforts is impossible to tell. The Swedish team lodged a protest but later withdrew it."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Misses"] [:th {} "Start Behind"] [:th {} "Race"] [:th {} "Shooting 1 Misses"] [:th 