66"} "Individual, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "40729"} "1988"] "\n" [:option {:value "40857"} "1992"] "\n" [:option {:value "41055"} "1996"] "\n" [:option {:value "41249"} "2000"] "\n" [:option {:value "41441"} "2004"] "\n" [:option {:value "257120"} "2008"] "\n" [:option {:value "301022"} "2012"] "\n" [:option {:value "18000662"} "2020"] "\n" [:option {:value "2000170"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/26"} "Event type"]] [:h1 {:class "event_title"} "Team, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "5 –  6 August 2016"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/910"} "Sambódromo, Rio de Janeiro"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/351240"} "36 from 12 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Teams consisted of three archers.  Ranking rounds scores based on scores carried over from individual ranking round.  Tie-breaking for the final placements was done by the following method.  Losers in each round were ranked according to the score they shot in that round.  Ties in that round were broken by the number of 10s shot in that round and then the number of 9s shot in that round.  If still tied the score in the preceding round was used as the tie-breaker, followed by number of 10s, and then number of 9s in the preceding round.  Team event shot entirely at 70 metres.  Matches consisted of 27 arrows, 9 per archer."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record  (Ranking Round, 216 arrows)"] [:td {} [:a {:href "/results/41441"} "2,030"] " " [:span {:class "label label-primary"} "WR"] " / " [:a {:href "/athletes/102817"} "Lee Seong-Jin"] " • " [:a {:href "/athletes/102820"} "Park Seong-Hyeon"] " • " [:a {:href "/athletes/83170"} "Yun Mi-Jin"] " " [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"] " / 12 August 2004 / " [:a {:href "/records/event_name/26/Ranking%20Round,%20216%20arrows"} "Details"]]]]] [:div {:class "description"} [:p {} "Korea’s female archers took their eighth consecutive gold medal in the team event, and continued the clean sweep since the introduction of this event in 1988. The Korean team were the clear favorites after setting a new world record of 2045 with 216 arrows over 70 m just two months before the Olympics. Consequently, they finished the ranking round with a sixty points lead before Russia. After beating Japan in the quarter-final, and the eventual bronze medal winners, Chinese Taipei, in the semi-final, their victory over Russia in the final was never in doubt."] "\n\n" [:p {} "Against Chinese Taipei, the Korean squad started with a perfect 60 in the first set. Like their fellow countrymen in the men’s team event, the Korean women did not lose a single set but had to settle for ties in one set in each of their matches. Their opponents in the final, Russia, were the reigning world champions, but had a tough time defeating India in their first match, winning only after a shoot-out. In their next match, they trailed Italy by 1-3 before coming back to win 5-3 and a place in the final, thus ending a streak of 24 years without an Olympic medal for female Russian archers. Chinese Taipei secured the bronze medal with a 5-3 victory against Italy."] "\n\n" [:p {} "Particularly unlucky losers were " [:a {:href "/athletes/111484"} "Aida Roman"] " from Mexico and " [:a {:href "/athletes/129750"} "Carolina Aguirre"] " from Colombia. Under time pressure, Roman shot only a five with her last regular arrow. That forced the team into a shoot-out against Chinese Taipei, which Mexico lost. Aguirre fell victim to her nerves when she shot only a three in the final three against India."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Republic of Korea"] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/130922"} "Choi Mi-Seon"] " • " [:a {:href "/athletes/130921"} "Jang Hye-Jin"] " • " [:a {:href "/athletes/124392"} "Gi Bo-Bae"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Russian Federation"] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/131560"} "Tuyana Dashidorzhiyeva"] " • " [:a {:href "/athletes/120353"} "Inna Stepanova"] " • " [:a {:href "/athletes/120352"} "Kseniya Perova"]]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} "Chinese Taipei"] [:td {} [:a {:href "/countries/TPE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/TPE.png"}] "TPE"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/125100"} "Tan Ya-Ting"] " • " [:a {:href "/athletes/131850"} "Lin Shih-Chia"] " • " [:a {:href "/athletes/125101"} "Lei Chien-