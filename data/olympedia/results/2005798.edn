value "2005717"} "Singles, Women"] "\n" [:option {:value "2005839"} "Doubles, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "90016763"} "1988"] "\n" [:option {:value "42177"} "1992"] "\n" [:option {:value "42394"} "1996"] "\n" [:option {:value "42650"} "2000"] "\n" [:option {:value "42840"} "2004"] "\n" [:option {:value "258157"} "2008"] "\n" [:option {:value "304193"} "2012"] "\n" [:option {:value "351748"} "2016"] "\n" [:option {:value "19005395"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/126"} "Event type"]] [:h1 {:class "event_title"} "Doubles, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "27 July –  3 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2159"} "Porte de la Chapelle Arena, Paris, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2005798"} "32 from 13 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament."]]]] [:div {:class "description"} [:p {} "There were some surprises in the group stages when the-seeded pair of " [:a {:href "/athletes/150944"} "Nami Matsuyama"] " and " [:a {:href "/athletes/150943"} "Chiharu Shida (JPN)"] " lost to " [:a {:href "/athletes/144904"} "Kim So-Yeong"] " and " [:a {:href "/athletes/144903"} "Gong Hui-Yong"] " (KOR) by a score of 24-22, 26-24, and " [:a {:href "/athletes/150948"} "Baek Ha-Na"] " and " [:a {:href "/athletes/130928"} "Lee So-Hui"] " (KOR) were beaten by the Danish pair of " [:a {:href "/athletes/142126"} "Maiken Fruergaard"] " and " [:a {:href "/athletes/142127"} "Sara Thygesen"] " by 21-18, 9-21, 21-14. The number three seeds " [:a {:href "/athletes/150917"} "Liu Shengshu"] " and " [:a {:href "/athletes/150918"} "Tan Ning"] " (CHN) also had a tough contest against the Bulgarian sisters " [:a {:href "/athletes/129383"} "Gabriela Stoeva"] " and " [:a {:href "/athletes/129385"} "Stefani Stoeva"] ", eventually winning 19-21, 21-10, 21-16. However, all the aforementioned pairs advanced to the quarter-finals, along with the Chinese number one seeds and world ranked number one women’s doubles pair, " [:a {:href "/athletes/141646"} "Chen Qingchen"] " and " [:a {:href "/athletes/141650"} "Jia Yifan"] ", with " [:a {:href "/athletes/150953"} "Pearly Tan"] " and " [:a {:href "/athletes/150954"} "Thinaah Muralitharan"] " (MAS) completing the quarter-final line-up."] "\n\n" [:p {} "The quarter-finals were largely one sided contests, all matches finishing with scores of 2-0. The contest between the two-seeded pairs Liu Shengshu and Tan Ning (CHN) and Baek Ha-Na and Lee So-Hui (KOR) finished 21-9, 21-13, with the remaining semi-finalists being Chen Qingchen and Jia Yifan (CHN), Nami Matsuyama and Chiharu Shida (JPN), and the unseeded Pearly Tan and Thinaah Muralitharan (MAS)."] "\n\n" [:p {} "In the semi-finals, both Chinese pairs won and advanced to the final. However, Chen and Jai were taken to three sets by unseeded Tan and Muralitharan, eventually winning by 21-12, 18-21, 21-15. The other semi-final was more straight forward, as the other Chinese pair of Liu and Tan defeated Matsuyama and Shida by 21-16, 21-19."] "\n\n" [:p {} "In the match for the bronze medal, Matsuyama and Shida defeated Tan and Muralitharan comfortably by 21-11, 21-11. In the match for the gold medal, it was the Chinese pair of Chen and Jai who defeated their compatriots Liu and Tan 22-20, 21-15, in a match lasting just short of an hour."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] 