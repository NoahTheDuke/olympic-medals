ion {:value "2007603"} "Welterweight (≤80 kilograms), Men"] "\n" [:option {:value "2007628"} "Heavyweight (&gt;80 kilograms), Men"] "\n" [:option {:value "2007653"} "Flyweight (≤49 kilograms), Women"] "\n" [:option {:value "2007680"} "Featherweight (≤57 kilograms), Women"] "\n" [:option {:value "2007705"} "Welterweight (≤67 kilograms), Women"] "\n" [:option {:value "2007730"} "Heavyweight (&gt;67 kilograms), Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "900582"} "1988"] "\n" [:option {:value "901033"} "1992"] "\n" [:option {:value "28000"} "2000"] "\n" [:option {:value "28227"} "2004"] "\n" [:option {:value "262097"} "2008"] "\n" [:option {:value "325000"} "2012"] "\n" [:option {:value "351300"} "2016"] "\n" [:option {:value "19004300"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/612"} "Event type"]] [:h1 {:class "event_title"} "Flyweight (≤58 kilograms), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 7 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2167"} "Grand Palais, Paris, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2007550"} "18 from 18 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament. All fighters losing to the finalists in each pool advance to repêchage tournament for the bronze medal."]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/144220"} "Vito Dell’Aquila"] " of Italy was the reigning gold medalist from 2021. Other favorites included the gold medalists from the last two World championships, " [:a {:href "/athletes/143689"} "Omar Salim"] " of Hungary and " [:a {:href "/athletes/155020"} "Park Tae-Jun"] " of South Korea. In the quarter-final, Dell’Aquila defeated Salim, but later lost in the semi-final and finished fifth. Park’s only match with three rounds was in the quarter-final, against the local favorite " [:a {:href "/athletes/155002"} "Cyrian Ravet"] ", who later finished third."] "\n\n" [:p {} "In the final, Park defeated " [:a {:href "/athletes/154973"} "Gashim Magomedov"] " of Azerbaijan, who, due to injury, withdrew from the match in the second round and took silver. Park officially won only one round, 9-0. When the match stopped, he was leading 13-1 in the second round. Park’s win was described as an upswing for South Korea, which did not win any taekwondo gold medals at the 2020 Summer Olympics. After silver in Tokyo, " [:a {:href "/athletes/2504138"} "Mohamed Khalil Jendoubi"] " of Tunisia added another medal to his list of achievements by winning the other bronze in Paris."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib/Seed"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "205"] [:td {} [:a {:href "/athletes/155020"} "Park Tae-Jun"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "210"] [:td {} [:a {:href "/athletes/154973"} "Gashim Magomedov"]] [:td {} [:a {:href "/countries/AZE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AZE.png"}] "AZE"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {:class "bib"} "204"] [: