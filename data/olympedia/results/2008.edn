tion {:value "1999"} "30 kilometres, Men"] "\n" [:option {:value "2000"} "50 kilometres, Men"] "\n" [:option {:value "2001"} "4 × 10 kilometres Relay, Men"] "\n" [:option {:value "2005"} "5 kilometres, Women"] "\n" [:option {:value "2006"} "10 kilometres, Women"] "\n" [:option {:value "2007"} "20 kilometres, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1981"} "1976"] "\n" [:option {:value "1994"} "1980"] "\n" [:option {:value "2022"} "1988"] "\n" [:option {:value "2042"} "1992"] "\n" [:option {:value "2062"} "1994"] "\n" [:option {:value "2082"} "1998"] "\n" [:option {:value "2126"} "2002"] "\n" [:option {:value "2175"} "2006"] "\n" [:option {:value "923597"} "2010"] "\n" [:option {:value "350090"} "2014"] "\n" [:option {:value "9000301"} "2018"] "\n" [:option {:value "19019736"} "2022"] "\n" [:option {:value "15000158"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/203"} "Event type"]] [:h1 {:class "event_title"} "4 × 5 kilometres Relay, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "15 February 1984 — 8:45"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/124"} "Veliko Polje, Igman"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2008"} "48 from 12 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: ?" [:br {}] "Height Differential: 89 m" [:br {}] "Maximum Climb: 38 m" [:br {}] "Total Climbing: 153 m"]]]] [:div {:class "description"} [:p {} "After their excellent team showing in the 10 and 5 km races, Norway was expected to repeat their 1968 Olympic relay gold. East Germany, the defending Olympic champion, was not expected to be among the medal contenders, with only " [:a {:href "/athletes/80535"} "Carola Anding"] " left from their 1980 gold winning team. The Soviet Union, silver medalists at the 1980 Olympics and the 1982 World Championships, missed their cross-country queen " [:a {:href "/athletes/81587"} "Galina Kulakova"] ", who had ended her glorious career at age 39, after winning a World silver medal with the 1982 team."] "\n\n" [:p {} "After the first leg, Norway had a big lead, " [:a {:href "/athletes/81960"} "Inger Helene Nybråten"] " coming to the first exchange 25 seconds ahead of the Soviet Union’s " [:a {:href "/athletes/82457"} "Yuliya Stepanova"] ". More than ten seconds further behind followed Finland, Czechoslovakia, Switzerland and Sweden. On the second leg, " [:a {:href "/athletes/81385"} "Anne Jahren"] " extended Norway’s lead to almost one minute, with the USSR still second, with Czechoslovakia and Finland close behind. When " [:a {:href "/athletes/82079"} "Brit Pettersen"] " sent " [:a {:href "/athletes/81600"} "Berit Aunli"] " out on the anchor leg, Soviet’s " [:a {:href "/athletes/80760"} "Nadezhda Buryakova"] " was 1:03 behind, with Finland and Czechoslovakia ten seconds further behind. Aunli anchored Norway to a clear victory, but the fight for the other medals were very tight. The Soviet Union’s " [:a {:href "/athletes/82399"} "Raisa Smetanina"] " was soon overtaken by " [:a {:href "/athletes/81339"} "Marja-Liisa Hämälainen"] " from Finland and Czechoslovakia’s " [:a {:href "/athletes/81398"} "Květa Jeriová"] ", and to everyone’s surprise the Czech skiier outsprinted the double Olympic champion Hämälainen in a close duel for silver. The Czechoslovakian team celebrated their first ever Olympic relay medal."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Exchange"] [:th {