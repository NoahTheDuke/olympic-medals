td {} "29 September –  1 October 1988"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/635"} "Ol-lim-pik Ju-gyeong-gi-jang, Seoul Sports Complex, Seoul"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/63350"} "59 from 46 countries"]]]]] [:div {:class "description"} [:p {} "Two-time defending champion " [:a {:href "/athletes/68969"} "Sebastian Coe"] " was not chosen for the British team. But " [:a {:href "/athletes/68983"} "Steve Cram"] " was back and became the first runner to make the 1,500 final at three Olympics. The world record was held by Morocco’s " [:a {:href "/athletes/73302"} "Saïd Aouita"] ", who had won the 5K in 1984. Aouita ran but withdrew from the semis with a hamstring injury. The 1983 World Champion " [:a {:href "/athletes/75663"} "Abdi Bile"] " of Somalia had to withdraw shortly before the Olympics began, because of a tibial stress fracture. The final was run at a slow pace, with Kenya’s " [:a {:href "/athletes/72835"} "Peter Rono"] " taking the lead at 700 metres, the 800 being passed in over two minutes. He was completely unheralded but held the lead to the end, never letting any of the kickers pass him. His final 800 was run in 1:50.0."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "668"] [:td {} [:a {:href "/athletes/72835"} "Peter Rono"]] [:td {} [:a {:href "/countries/KEN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KEN.png"}] "KEN"]] [:td {} "3:37.65 (1 h3)"] [:td {} "3:38.25 (2 h2)"] [:td {} "3:35.96 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "418"] [:td {} [:a {:href "/athletes/690