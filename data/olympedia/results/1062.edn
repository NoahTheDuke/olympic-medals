s/1053"} "2:10.95"] " / " [:a {:href "/athletes/80701"} "Annie Borckink"] " " [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"] " / 14 February 1980 / " [:a {:href "/records/event_name/539"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002442"} "Heinrich Beck"]] [:td {} [:a {:href "/countries/FRG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRG.png"}] "FRG"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003831"} "Odd-Jens Bjerkli"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]]]]] [:div {:class "description"} [:p {} "This was the first women’s event, and as with every women’s event in 1984, the favorite was East German " [:a {:href "/athletes/81028"} "Karin Enke"] ". Enke had won the World Sprints in 1980, 1981, and 1983, and was second in 1982, and at the World Championships, she had won in 1982 and earlier in 1984, placing second in 1981 and 1983. In December 1983 she had seemingly broken the world record with 2:03.40 but the ISU did not recognize the record as it had not received advance notice about the meet. Her biggest challengers were expected to be " [:a {:href "/athletes/81847"} "Andrea Schöne"] ", who had won the 1983 World Championships and was second to Enke in both 1982 and 1984, and the Soviet skater " [:a {:href "/athletes/82078"} "Nataliya Petrusyova"] ", the world record holder with 2:04.04 set at Medeo in 1983. Schöne started in the first pair, and set a challenge, breaking the Olympic record by over five seconds, finishing in 2:05.29. Petrusyova was in the third pair and started quickly, leading Schöne’s times at 300 and 700 metres, but she could not finish strongly, and crossed in 2:05.78. Enke started in the fifth pair and her pace was ahead of both at every checkpoint, and she finished better than either of her rivals, to easily win the gold medal in 2:03.42, a world record time. This one the ISU did recognize. In the final results, the medals were won by the three favorites. Four days later, in the 1,000, they would finish in precisely the same positions."] "\n"] [:button {:id "button645898", :class "btn btn-default"} "Details"] [:script {} "$('#button645898').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "300 m"] [:th {:style "display: none", :class "split"} "700 m"] [:th {:style "display: none", :class "split"} "1100 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "5O"] [:td {} [:a {:href "/athletes/81028"} "Karin Enke"]] [:td {} [:a {:href "/countries/GDR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GDR.png"}] "GDR"]] [:td {} "2:03.42"] [:td {:class "split", :style "display: none"} "26.35"] [:td {:class "split", :style "display: none"} "57.10"] [:td {:class "split", :style "display: none"} "1:29.25"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "World Record"} "WR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "1O"] [:td {} [:a {:href "/athletes/81847"} "Andrea Schöne"]] [:td {} [:a {:href "/countries/GDR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GDR.png"}] "GDR"]] [:td {} "2:05.29"] [:td {:class "split", :style "display: none"} "26.82"] [:td {:class "split", :style "display: none"} "57.87"] [:td {: