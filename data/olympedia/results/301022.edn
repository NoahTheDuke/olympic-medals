 "/athletes/111476"} "Yun Ok-Hui"] " " [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"] " / 10 August 2008 / " [:a {:href "/records/event_name/26/Match,%2024%20arrows"} "Details"]]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record  (Ranking Round, 216 arrows)"] [:td {} [:a {:href "/results/41441"} "2,030"] " " [:span {:class "label label-primary"} "WR"] " / " [:a {:href "/athletes/102817"} "Lee Seong-Jin"] " • " [:a {:href "/athletes/102820"} "Park Seong-Hyeon"] " • " [:a {:href "/athletes/83170"} "Yun Mi-Jin"] " " [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"] " / 12 August 2004 / " [:a {:href "/records/event_name/26/Ranking%20Round,%20216%20arrows"} "Details"]]]]] [:div {:class "description"} [:p {} "Since team events were reintroduced into the Olympics in 1988 South Korea had won every Olympic title and had only failed to win 3 of the last 18 global championships before the London Olympics. One of these failures had been via a semi-final defeat to India at the 2011 World Championships but neither India nor Italy, the two finalists at those championships, could negotiate the first round at London. A major factor in the event was the weather which switched from bright and still to torrential rain showers and swirling wind more than once throughout the day."] "\n\n" [:p {} "The South Koreans  coped better than any other team with the conditions and seemed unbeatable as they made their way to a gold medal showdown with China. In contrast China had scored single point victories over Italy and Russia on their way to the final. Both teams started nervously and neither could pull out a decisive lead over the other. With their last 3 arrows China needed 29 to win or 28 to force a shoot-off but all three scored nine and South Korean maintained their unbeaten Olympic record by a single point. With victory in the bronze medal match Japan ensured an all Asian Olympic podium."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Republic of Korea"] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/124392"} "Gi Bo-Bae"] " • " [:a {:href "/athletes/102817"} "Lee Seong-Jin"] " • " [:a {:href "/athletes/124395"} "Choi Hyeon-Ju"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "People's Republic of China"] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/122313"} "Cheng Ming"] " • " [:a {:href "/athletes/122314"} "Fang Yuting"] " • " [:a {:href "/athletes/122315"} "Xu Jing"]]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} "Japan"] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/120445"} "Kaori Kawanaka"] " • " [:a {:href "/athletes/120446"} "Miki Kanie"] " • " [:a {:href "/athletes/120447"} "Ren Hayakawa"]]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} "Russian Federation"] [:td {} [:a {:href "/countries/RUS"} [:img {:sty