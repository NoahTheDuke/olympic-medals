3433"} "1988"] "\n" [:option {:value "64109"} "1992"] "\n" [:option {:value "64801"} "1996"] "\n" [:option {:value "65470"} "2000"] "\n" [:option {:value "66143"} "2004"] "\n" [:option {:value "257275"} "2008"] "\n" [:option {:value "302248"} "2012"] "\n" [:option {:value "358684"} "2016"] "\n" [:option {:value "2013639"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/73"} "Event type"]] [:h1 {:class "event_title"} "High Jump, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "30 July –  1 August 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2106"} "Japan National Stadium, Kasumigaoka, Shinjuku, Tokyo"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19000482"} "33 from 24 countries"]]]]] [:div {:class "description"} [:p {} "The best jumper over the past few years had been Qatari " [:a {:href "/athletes/124789"} "Mutaz Essa Barshim"] ", but he had only managed a season’s best of 2.30 and was expected to be challenged by Russian Olympic Committee jumper " [:a {:href "/athletes/146211"} "Ilya Ivanyuk"] ". There was some focus on the United States’ " [:a {:href "/athletes/147334"} "JuVaughn Harrison"] ", who was competing in both the high jump and long jump, the first American to do that at the Olympics since " [:a {:href "/athletes/79125"} "Jim Thorpe"] " in 1912."] "\n\n" [:p {} "The level of jumping was high as seven cleared 2.33, the most ever at a competition, and four jumpers cleared 2.35 metres, with two passing to the next height of 2.37. At 2.37 three jumpers cleared on their first attempt – Barshim, Italian " [:a {:href "/athletes/124447"} "Gianmarco Tamberi"] ", and Belarussian " [:a {:href "/athletes/141075"} "Maksim Nedasekau"] ". With passes, however, there were still six jumpers in the competition at 2.39, but Harrison, Korea’s " [:a {:href "/athletes/134925"} "Wu Sang-Hyeok"] ", and Australian " [:a {:href "/athletes/132456"} "Brandon Starc"] " would not clear and the medals were decided."] "\n\n" [:p {} "When Barshim, Tamberi, and Nedasekau missed all three attempts at 2.39, the bronze medal went to the Belarussian as he had one miss at his opening height of 2.19 and Barshim and Tamberi had been clear. A jump-off for gold seemed in the offing."] "\n\n" [:p {} "Or did it? An official met with the two jumpers and they asked if they had to jump-off, or if they could share the gold medal. The official informed them they could do that, and both Barshim and Tamberi would take gold. Tamberi, a decided underdog, was exultant and his victory celebration was one of the highlights of the athletics competition at Tokyo. Two gold medals in an Olympic athletics event had not happened since the 1908 pole vault, when " [:a {:href "/athletes/78453"} "A. C. Gilbert"] " and " [:a {:href "/athletes/78262"} "Ed Cook"] " had shared gold."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "=1"] [:td {:class "bib"} "3290"] [:td {} [:a {:href "/athletes/124789"} "Mutaz Essa Barshim"]] [:td {} [:a {:href "/countries/QAT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/QAT.png"}] "QAT"]] [:td {} "2.28 (=1)"] [:td {} "2.37 (=1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=1"] [:td {:class "bib"} "2442"] [:td {} [:a {:href "/athletes/124447"} "Gianmarco Tamberi"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} "2.28 (=9)"] [:td {} "2.37 (=1)"] [:td {} [:span {: