"} "30 kilometres, Men"] "\n" [:option {:value "1938"} "50 kilometres, Men"] "\n" [:option {:value "1939"} "4 × 10 kilometres Relay, Men"] "\n" [:option {:value "1943"} "5 kilometres, Women"] "\n" [:option {:value "1945"} "3 × 5 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1913"} "1952"] "\n" [:option {:value "1921"} "1956"] "\n" [:option {:value "1932"} "1960"] "\n" [:option {:value "1956"} "1968"] "\n" [:option {:value "1968"} "1972"] "\n" [:option {:value "1980"} "1976"] "\n" [:option {:value "1993"} "1980"] "\n" [:option {:value "2006"} "1984"] "\n" [:option {:value "2020"} "1988"] "\n" [:option {:value "2108"} "2002"] "\n" [:option {:value "2157"} "2006"] "\n" [:option {:value "923578"} "2010"] "\n" [:option {:value "350087"} "2014"] "\n" [:option {:value "9000298"} "2018"] "\n" [:option {:value "19019733"} "2022"] "\n" [:option {:value "15000155"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/195"} "Event type"]] [:h1 {:class "event_title"} "10 kilometres, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 1 February 1964 — 9:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/59"} "Langlaufstadion, Seefeld"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1944"} "35 from 12 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: ?" [:br {}] "Height Differential: 103 m" [:br {}] "Intermediate 1: 5.0 km" [:br {}] "Maximum Climb: 37 m" [:br {}] "Total Climbing: 256 m"]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/81534"} "Alevtina Kolchina"] " was highly favored to win her first Olympic gold medal in her third Olympic appearance. She had won three gold medals in the 1962 World Championships in Zakopane, and had also been victorious at Holmenkollen in 1961, 1962 and 1963 in the 10 km race."] "\n\n" [:p {} "At the halfway point " [:a {:href "/athletes/80720"} "Klavdiya Boyarskikh"] ", a 24-year-old schoolteacher from Sverdlovsk, had a scant lead, only two seconds ahead of another Soviet skier, " [:a {:href "/athletes/81807"} "Yevdokiya Mekshilo"] ". Kolchina was in third place, 15 seconds behind the leader, and " [:a {:href "/athletes/81213"} "Maria Gusakova"] ", second after Kolchina in the 10 km race in World Championships 1962, followed in fourth place. The event developed into a very close race between Boyarskikh and Mekshilo, with Boyarskikh able to cling to the lead and win by 2.3 seconds. Kolchina faded in the last part of the track and dropped down to seventh place, and Gusakova with the fastest finish of the day advanced to bronze medal position. The best non-Soviet skier was " [:a {:href "/athletes/82473"} "Britt Strandberg"] ", the only skier from the victorious Swedish relay team of 1960 competing in 1964, in fourth place, only 8.4 seconds outside the bronze medal."] "\n\n" [:p {} "For the first time female skiers from outside Europe competed in the Olympics, but the four skiers from People’s Republic of Korea and Mongolia ended in the last four placings in the final rankings."] "\n"] [:button {:id "button721059", :class "btn btn-default"} "Details"] [:script {} "$('#button721059').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "Intermediate 1"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "15"] [:td {} [:a {:href "/athletes/80720"} "Klavdiya Boyarskikh"]] [:t