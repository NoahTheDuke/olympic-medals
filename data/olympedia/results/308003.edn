e "308001"} "Road Race, Individual, Women"] "\n" [:option {:value "308002"} "Individual Time Trial, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "154879"} "1996"] "\n" [:option {:value "155008"} "2000"] "\n" [:option {:value "155136"} "2004"] "\n" [:option {:value "258959"} "2008"] "\n" [:option {:value "356741"} "2016"] "\n" [:option {:value "19001701"} "2020"] "\n" [:option {:value "2003681"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/213"} "Event type"]] [:h1 {:class "event_title"} "Individual Time Trial, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 1 August 2012 — 14:15"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/883"} "Hampton Court Palace, Richmond upon Thames, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/308003"} "37 from 30 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Distance: 44 km" [:br {}] "Intermediate 1: 7.3 km" [:br {}] "Intermediate 2: 18.4 km" [:br {}] "Intermediate 3: 29.9 km"]]]] [:div {:class "description"} [:p {} "Had " [:a {:href "/athletes/124338"} "Helen Glover"] " and " [:a {:href "/athletes/123233"} "Heather Stanning"] " not won the coxless pairs event earlier in the day, " [:a {:href "/athletes/90392"} "Bradley Wiggins"] " would have certainly been Britain’s best hope for bringing home its first gold medal of the Games. With a decorated past as a track cyclist that included six gold medals at the World Championships and four at the Olympics, his more recent successes as a road cyclist included second place in the time trial at the 2011 World Championships and an overall win of the Tour de France less than two weeks prior. This made him the favorite to capture the gold in the 2012 Olympic Time Trial, but he had to contend with " [:a {:href "/athletes/125462"} "Tony Martin"] ", the reigning World Champion and perhaps the only rider who could truly challenge Wiggins for the top spot; Martin’s injury-plagued season, however, left his ability to challenge for the gold in doubt. The defending Olympic champion " [:a {:href "/athletes/103662"} "Fabian Cancellara"] " was a potential challenger as well, but the crash he suffered during the road race several days earlier hampered his speed during the time trial and he was never a factor for the podium."] "\n\n" [:p {} "There were no surprises in the race: Wiggins dominated the course throughout and Martin came in with a comfortable second-place finish. Wiggins’ teammate " [:a {:href "/athletes/126950"} "Christopher Froome"] ", who had come in second overall at the most recent Tour de France, took home the bronze. Wiggins’ victory gave him the highest lifetime total of medals for a British Olympian with seven, although the man he surpassed, rower " [:a {:href "/athletes/37440"} "Steven Redgrave"] ", still held the title of most successful Olympian with five gold medals compared to Wiggins’ four."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Intermediate 1"] [:th {} "Intermediate 2"] [:th {} "Intermediate 3"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "2"] [:td {} [:a {:href "/athletes/90392"} "Bradley Wiggins"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {} "50:39.54"] [:td {} "8:27.53 (2)"] [:td {} "23:14.73 (1)"] [:td {} "34:43.99