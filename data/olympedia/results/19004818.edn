e "19004709"} "Singles, Women"] "\n" [:option {:value "19004780"} "Doubles, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "44067"} "1900"] "\n" [:option {:value "44200"} "1906"] "\n" [:option {:value "44542"} "1912"] "\n" [:option {:value "44692"} "1920"] "\n" [:option {:value "45001"} "1924"] "\n" [:option {:value "900237"} "1968"] "\n" [:option {:value "900305"} "1968"] "\n" [:option {:value "324218"} "2012"] "\n" [:option {:value "353423"} "2016"] "\n" [:option {:value "2006718"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/611"} "Event type"]] [:h1 {:class "event_title"} "Doubles, Mixed" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "28 July –  1 August 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2126"} "Ariake Tennis Forest Park, Ariake, Koto, Tokyo, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19004818"} "32 from 14 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament."]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/117575"} "Novak Đoković"] ", playing in the mixed doubles for the first time at the Olympics, started with a 6-3, 6-4 win for him and partner " [:a {:href "/athletes/146587"} "Nina Stojanović"] ". However, the top seeds " [:a {:href "/athletes/122465"} "Kristina Mladenovic"] " and " [:a {:href "/athletes/133916"} "Nicolas Mahut"] " went out in the first round."] "\n\n" [:p {} "Đoković and Stojanović reached the semi-final with a super-quick 6-1, 6-2 victory while " [:a {:href "/athletes/140696"} "Ash Barty"] " and " [:a {:href "/athletes/132562"} "John Peers"] " required a match tie-break to progress from their quarter-final match."] "\n\n" [:p {} "In the first semi-final, Barty and Peers were again involved in a match tie-break but lost 13-11 to " [:a {:href "/athletes/131618"} "Anastasiya Pavlyuchenkova"] " and " [:a {:href "/athletes/2104243"} "Andrey Rublyov"] ". The other semi-final saw Novak Đoković’s hopes of that elusive gold medal dashed when he and Stojanović were beaten by the unseeded " [:a {:href "/athletes/117640"} "Yelena Vesnina"] " and " [:a {:href "/athletes/146277"} "Aslan Karatsev"] " to set up an all-ROC final."] "\n\n" [:p {} "Đoković pulled out of the bronze medal match with a shoulder injury, and Barty and Peers won bronze on a walkover."] "\n\n" [:p {} "In a close final, Pavlyuchenkova and Rublyov edged out compatriots Vesnina and Karatsev in a thrilling third set match tie-break, 13-11. It was the ROC’s third tennis medal of the Games, making them the leading nation. For Vesnina, defeat was a big disappointment because she celebrated her 35th birthday on the day of the final. However, it was her second Olympic medal to go with the gold she won in the mixed doubles at the 2016 Rio Games."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/131618"} "Anastasiya Pavlyuchenkova"] " / " [:a {:href "/athletes/2104243"} "Andrey Rublyov"]] [:td {} [:a {:href "/countries/ROC"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ROC.png"}] "ROC"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/117640"} "Yelena Vesnina"] " / " [:a {:href "/athletes/146277"} "Aslan Karatsev"]] [:td {} [:a {:href "/countries/ROC"} [:img {:styl