9671"} "Monobob, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "9000247"} "2018"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/1037"} "Event type"]] [:h1 {:class "event_title"} "Four, Open" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "19 – 20 February 2022"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2144"} "Yanqing National Sliding Centre, West Dazhuangke, Zhangshanying, Yanqing District"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19019657"} "112 from 17 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Four runs, total time determined placement. Only the best 20 teams contest the final run."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Curves: 16" [:br {}] "Length: 1,615 m" [:br {}] "Start Altitude: 1,017 m" [:br {}] "Vertical Drop: 121 m"]]]] [:div {:class "description"} [:p {} "Germany went 1-2 in the 4-man bobsleigh event, taking gold and silver. They repeated their finish from PyeongChang although they shared the silver medal in 2018 with the Republic of Korea."] "\n\n" [:p {} [:a {:href "/athletes/127814"} "Francesco Friedrich"] " and " [:a {:href "/athletes/127816"} "Thorsten Margis"] " also won gold for Germany in Beijing in the two-man and won both gold medals at PyeongChang. Their four gold medals equalled fellow Germans, " [:a {:href "/athletes/101871"} "Kevin Kuske"] " and " [:a {:href "/athletes/101869"} "André Lange"] " for the most golds in Olympic bobsledding history. Two of the German silver medallists, " [:a {:href "/athletes/137262"} "Johannes Lochner"] " and " [:a {:href "/athletes/148385"} "Florian Bauer"] " also took silver in the two-man event. Pilot " [:a {:href "/athletes/118670"} "Justin Kripps"] " handed Canada its third Olympic medal in the four-man bobsleigh event, after gold in 1964, and bronze in 2010. Overall, this was the 11th bobsleigh medal for Canada."] "\n\n" [:p {} "Kripps previously won gold in the 2-man event at PyeongChang 2018, a victory shared alongside Germany (Friedrich and Margis). Kripps became the third male bobsleigher representing Canada to take multiple Olympic medals, after Pierre Lueders and Lascelles Brown (both with two medals). Friedrich became the third pilot to defend his Olympic title in the 4-man, after " [:a {:href "/athletes/95777"} "Meinhard Nehmer"] " (GDR, 1976 and 1980) and Lange (2002 and 2006). Germany extending their gold medal tally in the 4-man Olympic bobsleigh event to seven."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Run #1"] [:th {} "Run #2"] [:th {} "Run #3"] [:th {} "Run #4"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Germany 1"] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "3:54.30"] [:td {} "58.29 (2)"] [:td {} "58.71 (1)"] [:td {} "58.17 (1)"] [:td {} "59.13 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "13"} [:a {:href "/athletes/127814"} "Francesco Friedrich"] " • " [:a {:href "/athletes/127816"} "Thorsten Margis"] " • " [:a {:href "/athletes/137258"} "Candy Bauer"] " • " [:a {:href "/athletes/148388"} "Alexander Schüller"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Germany 2"] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "htt