19019631"} "12.5 kilometres Pursuit, Men"] "\n" [:option {:value "19019632"} "15 kilometres Mass Start, Men"] "\n" [:option {:value "19019633"} "20 kilometres, Men"] "\n" [:option {:value "19019635"} "7.5 kilometres Sprint, Women"] "\n" [:option {:value "19019636"} "10 kilometres Pursuit, Women"] "\n" [:option {:value "19019637"} "12.5 kilometres Mass Start, Women"] "\n" [:option {:value "19019638"} "15 kilometres, Women"] "\n" [:option {:value "19019639"} "4 × 6 kilometres Relay, Women"] "\n" [:option {:value "19019640"} "4 × 6 kilometres Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1518"} "1968"] "\n" [:option {:value "1523"} "1972"] "\n" [:option {:value "1528"} "1976"] "\n" [:option {:value "1534"} "1980"] "\n" [:option {:value "1540"} "1984"] "\n" [:option {:value "1546"} "1988"] "\n" [:option {:value "1552"} "1992"] "\n" [:option {:value "1563"} "1994"] "\n" [:option {:value "1575"} "1998"] "\n" [:option {:value "1588"} "2002"] "\n" [:option {:value "1603"} "2006"] "\n" [:option {:value "923486"} "2010"] "\n" [:option {:value "350026"} "2014"] "\n" [:option {:value "9000224"} "2018"] "\n" [:option {:value "15000034"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/132"} "Event type"]] [:h1 {:class "event_title"} "4 × 7.5 kilometres Relay, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "15 February 2022 — 17:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2138"} "Zhangjiakou Nordic Centre and Biathlon Centre, Chongli District, Zhangjiakou City, Hebei Province"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19019634"} "84 from 21 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Eight shots for each group of five targets. Penalty loop (150 metres) skied for each missed target, with three extra shots allowed to obtain 5 target hits."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 7,773 m" [:br {}] "Height Differential: 52 m" [:br {}] "Maximum Climb: 21 m" [:br {}] "Shooting 1: Prone at 2.411 km, 50 m range" [:br {}] "Shooting 2: Standing at 5.087 km, 50 m range" [:br {}] "Total Climbing: 273 m"]]]] [:div {:class "description"} [:p {} "Norway won its third Olympic biathlon men’s relay gold medal in Beijing, after winning it in 2002 and 2010. The relay was re-scheduled to an earlier start by two and a half hours to avoid the freezing cold weather. Even so, it was -15 degrees at the start. Under difficult weather conditions, of the top 10 teams, only France got away without a penalty loop."] "\n\n" [:p {} "The ROC took an early lead through " [:a {:href "/athletes/2301779"} "Said Karimulla Khalili"] ", with Belarus less than a second behind, and France third. The favourites Norway were 40.3 seconds behind in seventh place due to " [:a {:href "/athletes/148696"} "Sturla Holm Lægreid"] "’s penalty loop. " [:a {:href "/athletes/128306"} "Aleksandr Loginov"] " and " [:a {:href "/athletes/148771"} "Maksim Tsvetkov"] " helped increase the ROC lead to 41.3 seconds after the second and third legs. France held on to second place with a narrow lead over Norway, thanks to " [:a {:href "/athletes/128188"} "Johannes Thingnes Bø"] " bringing them back into the reckoning. Norway trailed by 1:47.6 after the second leg until Bø ran the best third leg, making up more than one minute on the leaders. " [:a {:href "/athletes/137248"} "Benedikt Doll"] " moved Germany into fourth place going into the last exchange thanks to his time being the second-best of the third leg."] "\n\n" [:p {} "With " [:a {:href "/athletes/148769"} "Eduard Latypov"] " running a lonely race for ROC, " [:a {:href "/athletes/148695"} "Vetle Sjåstad Christiansen"] ", " [:a {:href "/athletes/137167"} "Quentin Fillon-Maillet"] ", and " [:a {:href "/athletes/148392"} "Philipp Nawrath"] " were fighting for second place. Drama came in the final standing shooting. Latypov had to go two penalty loops, lost his comfortable lead to Norway, and slipped down to third place. France also took advantage of Latypov’s mistakes and secured silver. Germany also had a penalty loop and could not close the gap and missed out on a medal behind ROC."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Misses"] [:th {} "Extra Shots"] [:th {} "Shooting 1 Misses"] [:th {} "Shooting 1 Extra Shots"] [:th {} "Shooting 1"] [:th {} "Shooting 2 Misses"] [:th {} "Shooting 2 Extra Shots"] [:th {} "Shooting 2"] [:th {} "Exchange"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Norway"] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "1-19:50.2"] [:td {} "1"] [:td {} "7"] [:td {}] [:td {}] [:td {} "– (–)"] [:td {}] [:td {}] [:td {} "– (–)"] [:td {} "– (–)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/148696"} "Sturla Holm Lægreid"] " "] [:td {}] [:td {} "20:21.2"] [:td {} "1"] [:td {} "3"] [:td {} "0"] [:td {} "0"] [:td {} "7:04.5 (4)"] [:td {} "1"] [:td {} "3"] [:td {} "14:35.5 (13)"] [:td {} "20:21.2 (7)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/118590"} "Tarjei Bø"] " "] [:td {}] [:td {} "20:40.1"] [:td {} "0"] [:td {} "2"] [:td {} "0"] [:td {} "0"] [:td {} "27:32.1 (8)"] [:td {} "0"] [:td {} "2"] [:td {} "35:10.6 (7)"] [:td {} "41:01.3 (6)"]