 and finally " [:a {:href "/athletes/22475"} "Rudolf Kárpáti"] " held their nerve to ensure the Hungary streak continued.\nThis was " [:a {:href "/athletes/22451"} "Aladár Gerevich"] "’s fourth (of six) successive victory in the event with his team-mates " [:a {:href "/athletes/22423"} "Tibor Berczelly"] ", " [:a {:href "/athletes/22483"} "Pál Kovács"] " and " [:a {:href "/athletes/22522"} "László Rajcsányi"] " both recorded their third straight title."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "Hungary"] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/22451"} "Aladár Gerevich"] " • " [:a {:href "/athletes/22423"} "Tibor Berczelly"] " • " [:a {:href "/athletes/22475"} "Rudolf Kárpáti"] " • " [:a {:href "/athletes/22483"} "Pál Kovács"] " • " [:a {:href "/athletes/22522"} "László Rajcsányi"] " • " [:a {:href "/athletes/22513"} "Bertalan Papp"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} "Italy"] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/22718"} "Vincenzo Pinton"] " • " [:a {:href "/athletes/22700"} "Renzo Nostini"] " • " [:a {:href "/athletes/22655"} "Gastone Darè"] " • " [:a {:href "/athletes/22724"} "Mauro Racca"] " • " [:a {:href "/athletes/22664"} "Roberto Ferrari"] " • " [:a {:h