29"} "Carry Geijssen"] " " [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"] " / 11 February 1968 / " [:a {:href "/records/event_name/538"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004310"} "Saburo Takabayashi"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/15004"} "Viktor Kapitonov"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]]]]] [:div {:class "description"} [:p {} "The favorites were " [:a {:href "/athletes/82872"} "Lyudmila Titova"] ", who had been the best sprinter in the world for several years, and America’s " [:a {:href "/athletes/81283"} "Anne Henning"] ", who had begun to surpass her in 1971, although she was better at the 500 metres. Titova had set two world records in 1971, but Henning had broken the mark with 1:27.3 in Davos in January 1972. The defending champion was " [:a {:href "/athletes/81129"} "Carry Geijssen"] ", who retired after the 1971 season. In the third pair, 17-year-old West German " [:a {:href "/athletes/82084"} "Monika Pflug"] " came through in 1:31.40. Henning and Titova were together in the next pair, and Henning later said that her legs still felt the effect of taking two runs in the 500 the day before, after she had been interfered with on her first run. But she still narrowly defeated Titova, 1:31.62 to 1:31.85, but did not catch Pflug. Both were also beaten by " [:a {:href "/athletes/81478"} "Atje Keulen-Deelstra"] ", skating in the next pair, who finished in 1:31.61, which would hold up for the silver medal, Henning getting bronze. The gold medal went to Pflug in a major upset. Her win was especially impressive because she had jump started twice, and started very slowly to avoid disqualification on the third gun. Her 200 split was only 13th fastest, but she was second at the 600 split, and finished strongly. She would have a very long career, competing thru 1988, five Winter Olympics, and three names, eventually as Monika Gawenus-Holzner-Pflug, but this would be her only Olympic medal."] "\n"] [:button {:id "button695891", :class "btn btn-default"} "Details"] [:script {} "$('#button695891').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "200 m"] [:th {:style "display: none", :class "split"} "600 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "3I"] [:td {} [:a {:href "/athletes/82084"} "Monika Pflug"]] [:td {} [:a {:href "/countries/FRG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRG.png"}] "FRG"]] [:td {} "1:31.40"] [:td {:class "split", :style "display: none"} "20.59"] [:td {:class "split", :style "display: none"} "54.74"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "5I"] [:td {} [:a {:href "/athletes/81478"} "Atje Keulen-Deelstra"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "1:31.61"] [:td {:class "split", :style "display: none"} "20.28"] [:td {:class "split", :style "display: none"} "55.35"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]]