alue "2008400"} "Kayak Singles, Slalom, Men"] "\n" [:option {:value "2008406"} "Canadian Singles, Slalom, Men"] "\n" [:option {:value "2008443"} "Canadian Singles, Slalom, Women"] "\n" [:option {:value "2008449"} "Kayak Cross, Slalom, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255438"} "1972"] "\n" [:option {:value "256065"} "1992"] "\n" [:option {:value "256201"} "1996"] "\n" [:option {:value "256310"} "2000"] "\n" [:option {:value "256430"} "2004"] "\n" [:option {:value "258863"} "2008"] "\n" [:option {:value "307020"} "2012"] "\n" [:option {:value "353600"} "2016"] "\n" [:option {:value "19006326"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/181"} "Event type"]] [:h1 {:class "event_title"} "Kayak Singles, Slalom, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "27 – 28 July 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2180"} "National Olympic Nautical Stadium d'Île-de-France, Vaires-sur-Marne, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2008437"} "25 from 25 countries"]]]]] [:div {:class "description"} [:p {} "Australia’s " [:a {:href "/athletes/123753"} "Jess Fox"] " was the heavy favorite, having won medals in this event at the last three Olympics, with silver at London 2012 and bronzes at Rio 2016 and Tokyo 2020. She had won the event at the World Championships in 2014, 2017, 2018, and 2023, and came into Paris world ranked #1 in the event. She was expected to be challenged by defending gold medalist " [:a {:href "/athletes/143276"} "Ricarda Funk"] " of Germany, who was World Champion in 2021 and 2022."] "\n\n" [:p {} "Fox did not disappoint, winning gold, after leading the qualifying and then winning the final by almost 1½ points. It would be her second Olympic gold medal and she would add another three days later when she won the Canadian singles. Funk made the final easily, leading the semi-finals, but she finished only 11th."] "\n\n" [:p {} "Behind Fox, " [:a {:href "/athletes/2102332"} "Klaudia Zwolińska"] " won Poland’s first Olympic medal in women’s canoe slalom, a silver, and only the nation’s second Olympic medal in the discipline, after " [:a {:href "/athletes/10490"} "Krzysztof Kołomański"] " and " [:a {:href "/athletes/10525"} "Michał Staniszewski"] " had also won silver in 2000 men’s canoe doubles. The bronze medal went to Britain’s " [:a {:href "/athletes/142982"} "Kimberley Woods"] ", who had barely qualified, finishing 12th. Woods would also win bronze in Paris in the new kayak cross event."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/123753"} "Jess Fox"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]] [:td {} "92.18 (1)"] [:td {} "104.38 (8)"] [:td {} "96.08 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "4"] [:td {} [:a {:href "/athletes/2102332"} "Klaudia Zwolińska"]] [:td {} [:a {:href "/countries/POL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/POL.png"}] "POL"]] [:td {} "93.03 (2)"] [:td {} "99.84 (2)"] [:td {} "97.53 (2)"] [:td {} [: