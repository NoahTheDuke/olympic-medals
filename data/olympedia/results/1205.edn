aws.com/UNK.png"}] "UNK"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Gates: 71" [:br {}] "Length: 2660 m" [:br {}] "Start Altitude: 2336 m" [:br {}] "Vertical Drop: 623 m"]]]] [:div {:class "description"} [:p {} "The giant slalom was the first men’s Alpine event in Cortina. It was also the only Cortina Alpine event not held at Ski Resort Tofana, instead taking place over the Illio Colli course on Monte Folaria, the course having been named after a local skier who, while skiing it, had died when he crashed into a tree. The early leader was " [:a {:href "/athletes/95538"} "Anderl Molterer"] ", the sixth starter, whose time of 3:06.3 was 2.2 seconds faster than his teammates, " [:a {:href "/athletes/86655"} "Ernst Hinterseer"] ". Mobbed by the crowd as they congratulated the man they assumed would win gold, Molterer demurred, telling them to wait for Toni. Toni was " [:em {} "The Blitz from Kitz"] ", " [:a {:href "/athletes/97080"} "Toni Sailer"] ", the leader of the Austrian team who hailed from Kitzbühel. And lead he did, 12 starters later, his time of 3:00.1 gave him a 6+ second victory, the most dominant win in Olympic Alpine skiing history. It was the first of Sailer’s three gold medal sweep of the Alpine skiing events in Cortina. Molterer would win silver, " [:a {:href "/athletes/97339"} "Walter Schuster"] " completing the Austrian medal sweep in third, the first Olympic medal sweep in Alpine skiing."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "18"] [:td {} [:a {:href "/athletes/97080"} "Toni Sailer"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]] [:td {} "3:00.1"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]]