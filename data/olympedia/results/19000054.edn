ue "19000318"} "400 metres Individual Medley, Women"] "\n" [:option {:value "19000326"} "4 × 100 metres Medley Relay, Women"] "\n" [:option {:value "19000331"} "4 × 100 metres Medley Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "4509"} "1908"] "\n" [:option {:value "4585"} "1912"] "\n" [:option {:value "4673"} "1920"] "\n" [:option {:value "4752"} "1924"] "\n" [:option {:value "4855"} "1928"] "\n" [:option {:value "4957"} "1932"] "\n" [:option {:value "5049"} "1936"] "\n" [:option {:value "5157"} "1948"] "\n" [:option {:value "5273"} "1952"] "\n" [:option {:value "5398"} "1956"] "\n" [:option {:value "5512"} "1960"] "\n" [:option {:value "5680"} "1964"] "\n" [:option {:value "5887"} "1968"] "\n" [:option {:value "6204"} "1972"] "\n" [:option {:value "6505"} "1976"] "\n" [:option {:value "6773"} "1980"] "\n" [:option {:value "6995"} "1984"] "\n" [:option {:value "7308"} "1988"] "\n" [:option {:value "7664"} "1992"] "\n" [:option {:value "8015"} "1996"] "\n" [:option {:value "8390"} "2000"] "\n" [:option {:value "8795"} "2004"] "\n" [:option {:value "261524"} "2008"] "\n" [:option {:value "322337"} "2012"] "\n" [:option {:value "357035"} "2016"] "\n" [:option {:value "2001559"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/563"} "Event type"]] [:h1 {:class "event_title"} "1,500 metres Freestyle, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "30 July –  1 August 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2105"} "Olympic Aquatics Centre, 2-1, 2chome, Tatsumi, Koto-ku, Tatsumi-no-Mori Seaside Park, Tokyo, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19000054"} "28 from 20 countries"]]]]] [:div {:class "description"} [:p {} "Always contested on the last day of the Olympic swimming tournament, the 1,500 freestyle had three favorites with little to choose between them – Italy’s " [:a {:href "/athletes/124275"} "Gregorio Paltrinieri"] ", the defending gold medallist, Ukraine’s " [:a {:href "/athletes/136206"} "Mykhailo Romanchuk"] ", and German " [:a {:href "/athletes/134244"} "Florian Wellbrock"] ", the 2019 World Champion, who had gone 2-3-4, in that order, in the 800 metres three days prior. That race had been won by American " [:a {:href "/athletes/147477"} "Robert Finke"] " in a major upset, as he was completely unheralded coming into Tokyo."] "\n\n" [:p {} "The big four led the qualifying, with Romanchuk first in 14:45.99, followed by Finke in 14:47.20, and then Wellbrock in third and Paltrinieri finishing fourth."] "\n\n" [:p {} "Finke was unknown no longer, but in the final he played the same waiting game as he had in the 800, holding third or fourth position for most of the race. Wellbrock led most of the race, taking the lead before 300 metres and holding it into the final lap, with Romanchuk second most of the way. And then Finke exploded on the last lap, as he had done in the 800, splitting the final 50 in 25.78, a full second ahead of Romanchuk, and two seconds faster than Wellbrock, which brought Finke home for a second distance gold medal."] "\n\n" [:p {} "Paltrinieri was never a factor for a medal in the last few laps, as Romanchuk held on for silver and Wellbrock took the bronze. Wellbrock would later win gold in the 10 km open water swim at Tokyo, an event he had also won at the 2019 World Championships."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class