"} "High Jump, Women"] "\n" [:option {:value "257692"} "Pole Vault, Women"] "\n" [:option {:value "9030952"} "Long Jump, Women"] "\n" [:option {:value "9030966"} "Triple Jump, Women"] "\n" [:option {:value "257754"} "Shot Put, Women"] "\n" [:option {:value "257771"} "Discus Throw, Women"] "\n" [:option {:value "257788"} "Hammer Throw, Women"] "\n" [:option {:value "257805"} "Javelin Throw, Women"] "\n" [:option {:value "257822"} "Heptathlon, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "57897"} "1928"] "\n" [:option {:value "58127"} "1932"] "\n" [:option {:value "58452"} "1936"] "\n" [:option {:value "58806"} "1948"] "\n" [:option {:value "59185"} "1952"] "\n" [:option {:value "59546"} "1956"] "\n" [:option {:value "60001"} "1960"] "\n" [:option {:value "60417"} "1964"] "\n" [:option {:value "60914"} "1968"] "\n" [:option {:value "61479"} "1972"] "\n" [:option {:value "62046"} "1976"] "\n" [:option {:value "62529"} "1980"] "\n" [:option {:value "63118"} "1984"] "\n" [:option {:value "63790"} "1988"] "\n" [:option {:value "64466"} "1992"] "\n" [:option {:value "65143"} "1996"] "\n" [:option {:value "65800"} "2000"] "\n" [:option {:value "66513"} "2004"] "\n" [:option {:value "302547"} "2012"] "\n" [:option {:value "359099"} "2016"] "\n" [:option {:value "19000773"} "2020"] "\n" [:option {:value "2013943"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/107"} "Event type"]] [:h1 {:class "event_title"} "4 × 100 metres Relay, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "21 – 22 August 2008"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/813"} "Beijing Guojia Tiyuchang, Beijing Aolinpike Gongyuan, Beijing"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/257660"} "68 from 16 countries"]]]]] [:div {:class "description"} [:p {} "Jamaica had swept the medals in the 100 metres so the only question was “by how much,” not if they would win. That assumed, of course, they had no problem getting the stick around. As always, the United States was thought to have a solid team, but was not expected to beat the Jamaicans. And in heat one, they lost all chances when the final exchange between " [:a {:href "/athletes/89124"} "Torri Edwards"] " and " [:a {:href "/athletes/104900"} "Lauryn Williams"] " was botched and they dropped the baton. Jamaica won the second heat easily and was thought to have a virtual walkover for the final, especially with the US out. The East German world record of 41.37 from 1985 was thought to be threatened. But in the final, on the second exchange, " [:a {:href "/athletes/114765"} "Kerron Stewart"] " took off early, and the incoming runner, " [:a {:href "/athletes/104904"} "Sherone Simpson"] ", could not get the baton to her and they were out of the race. With the Jamaicans out, the Russians scored a huge upset victory over Belgium, with Nigeria third. The final also saw Great Britain not finish because of difficulty with the baton, and Poland was disqualified for an exchange out of zone. Thus only five teams finished the final, after five teams had not finished in the heats."] "\n\n" [:p {} "That was how the event and the results seemed to have ended. In 2015, however, the IOC began re-testing samples from the 2008 Beijing and 2012 London Olympics, using newer, more advanced testing techniques, in an effort to find those who had used performance enhancing drugs (PEDs), but in whom it could not be detected at the time of those Olympics. This was one of the many events affected."] "\n\n" [:p {} "In August 2016 one of the Russian relay runners, " [:a {:href "/athletes/115187"} "Yuliya Chermoshanskaya"] " was revealed to have a positive re-test for turinabol (dehydrochloromethyltestosterone) and stanozolol. She was disqualified, as was the entire Russian team, losing their gold medal. Belgium received the gold medal, Nigeria the silver medal, and Brazil was moved up to bronze. This was only the third time Belgium had even entered this event in the 80 years since it was first held at the Olympics. The Belgian runners received their gold medals eight years after the race before 40,000 fans at the 2016 Van Damme Memorial meet in Brussels."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "Belgium"] [:td {} [:a {:href "/countries/BEL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BEL.png"}] "BEL"]] [:td {} "42.92 (1 h1)"] [:td {} "42.54 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "10"} [:a {:href "/athletes/115240"} "Olivia Borlée"] " • " [:a {:href "/athletes/115241"} "Hanna Mariën"] " • " [:a {:href "/athletes/107115"} "Élodie Ouédraogo"] " • " [:a {:href "/athletes/104916"} "Kim Gevaert"] " • " [:a {:href "/athletes/923867"} "Frauke Penen"] [:small {} " (DNS)"] " • " [:a {:href "/athletes/923865"} "Élisabeth Davin"] [:small {} " (DNS)"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} "Nigeria"] [:td {} [:a {:href "/countries/NGR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NGR.png"}] "NGR"]] [:td {} "43.43 (4 h1)"] [:td {} "43.04 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:clas