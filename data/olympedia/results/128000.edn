105"} "1948"] "\n" [:option {:value "123715"} "1952"] "\n" [:option {:value "124182"} "1956"] "\n" [:option {:value "124913"} "1960"] "\n" [:option {:value "125565"} "1964"] "\n" [:option {:value "126308"} "1968"] "\n" [:option {:value "127190"} "1972"] "\n" [:option {:value "128710"} "1980"] "\n" [:option {:value "129525"} "1984"] "\n" [:option {:value "130729"} "1988"] "\n" [:option {:value "131817"} "1992"] "\n" [:option {:value "132889"} "1996"] "\n" [:option {:value "133593"} "2000"] "\n" [:option {:value "134175"} "2004"] "\n" [:option {:value "263827"} "2008"] "\n" [:option {:value "332230"} "2012"] "\n" [:option {:value "355680"} "2016"] "\n" [:option {:value "19009416"} "2020"] "\n" [:option {:value "2007906"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/664"} "Event type"]] [:h1 {:class "event_title"} "Heavyweight, Greco-Roman (≤100 kg), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "20 – 24 July 1976"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/572"} "Centre Pierre-Charbonneau, Parc olympique, Montréal, Québec"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/128000"} "13 from 13 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Scoring by negative points, with negative points given for any result short of a fall (win by fall-0.0; win by superior decision-0.0; win by decision-1.0; draw-2.0; loss by decision-3.0; loss by superior decision-4.0; loss by fall-4.0). Accumulation of 6 negative points eliminated the wrestler, but a wrestler could not be eliminated after a victory. When three or fewer wrestlers remained, they advanced to a final round, with preliminary results carried forward."]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/60448"} "Nikolay Balboshin"] " of the Soviet Union came in as the overwhelming favorite. He had won the World Championships in 1973-74 and he European title in 1973 and 1975-76. His expected victory in Montréal was one of the most dominant in Olympic history, winning four matches by falls and one by disqualification. The competition really came down to who would win the silver medal, which went to Bulgaria’s " [:a {:href "/athletes/57401"} "Kamen Goranov"] " over Poland’s " [:a {:href "/athletes/59676"} "Andrzej Skrzydlewski"] ", who won bronze. This was based on Goranov defeating Skrzydlewski by decision in the final round, 6-2. Fourth-place unusually went to an American, with " [:a {:href "/athletes/60740"} "Brad Rheingans"] " posting the best ever US finish in Olympic Greco-Roman wrestling, until the 1984 Olympics."] "\n\n" [:p {} "Balboshin would continue to dominate this class over the next few years. He won three more World Championships (1977-79) and five consecutive European titles (1975-79), and went to Moskva in 1980 expected to defend his gold medal. In Moskva, however, he was injured and at far less than his best and was withdrew after two rounds."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Round Eliminated"] [:th {} "Bad Points"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "320"] [:td {} [:a {:href "/athletes/60448"} "Nikolay Balboshin"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "17"] [:td {} [:a {:href "/athletes/57401"} "Kamen Goranov"]] [:td {} [:a {:href "/countries/BUL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.c