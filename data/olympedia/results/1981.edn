ion {:value "1973"} "30 kilometres, Men"] "\n" [:option {:value "1974"} "50 kilometres, Men"] "\n" [:option {:value "1975"} "4 × 10 kilometres Relay, Men"] "\n" [:option {:value "1979"} "5 kilometres, Women"] "\n" [:option {:value "1980"} "10 kilometres, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1994"} "1980"] "\n" [:option {:value "2008"} "1984"] "\n" [:option {:value "2022"} "1988"] "\n" [:option {:value "2042"} "1992"] "\n" [:option {:value "2062"} "1994"] "\n" [:option {:value "2082"} "1998"] "\n" [:option {:value "2126"} "2002"] "\n" [:option {:value "2175"} "2006"] "\n" [:option {:value "923597"} "2010"] "\n" [:option {:value "350090"} "2014"] "\n" [:option {:value "9000301"} "2018"] "\n" [:option {:value "19019736"} "2022"] "\n" [:option {:value "15000158"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/203"} "Event type"]] [:h1 {:class "event_title"} "4 × 5 kilometres Relay, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "12 February 1976 — 9:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/59"} "Langlaufstadion, Seefeld"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1981"} "36 from 9 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: ?" [:br {}] "Height Differential: 53 m" [:br {}] "Maximum Climb: 40 m" [:br {}] "Total Climbing: 234 m"]]]] [:div {:class "description"} [:p {} "For the first time in the Olympics, the female cross country relay was with a team of four skiers, from 1952 and until 1972 the relay for women was organised with three skiers per team."] "\n\n" [:p {} "Defending champion Soviet Union was the clear favorite for this event, having won the relay in the 1974 World Championships well ahead of East Germany and Czechoslovakia, unexpected silver and bronze medal winners. The Nordic countries Finland, Sweden and Norway were easily beaten and finished off the medal podium."] "\n\n" [:p {} "On the first leg of the 1976 Olympic relay three teams went away early, and at the exchange Sweden’s " [:a {:href "/athletes/80793"} "Lena Carlzon"] " was first, two seconds ahead of Finland’s " [:a {:href "/athletes/82491"} "Liisa Suihkonen"] " with the Soviet Union’s bronze medalist from the individual 5 km race, " [:a {:href "/athletes/81101"} "Nina Baldycheva"] ", a little surprisingly another two seconds behind. The rest of the field was over half a minute behind. On the second leg, the Soviet’s " [:a {:href "/athletes/96195"} "Zinaida Amosova"] ", placing sixth in both individual events earlier in the Games, was able to build up an 18-second lead over Finland, with Sweden in third another eight seconds behind. On the third leg the newly crowned Olympic 10 km champion " [:a {:href "/athletes/82399"} "Raisa Smetanina"] " decided the race, extending the Soviet lead over Finland to one minute. East Germany’s 20-year old " [:a {:href "/athletes/82082"} "Barbara Petzold"] " brought her team up from fifth to third position at the exchange, two seconds ahead of Sweden. On the last leg, " [:a {:href "/athletes/81587"} "Galina Kulakova"] " led her team to an easy victory and collected her fourth Olympic gold medal. Finland was a clear second, and East Germany’s " [:a {:href "/athletes/81292"} "Veronika Schmidt"] " held off Sweden in the fight for the bronze medal."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Exchange"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""}