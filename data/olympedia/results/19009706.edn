 kg), Men"] "\n" [:option {:value "19009329"} "Welterweight, Greco-Roman (≤67 kg), Men"] "\n" [:option {:value "19009358"} "Middleweight, Greco-Roman (≤77 kg), Men"] "\n" [:option {:value "19009387"} "Light-Heavyweight, Greco-Roman (≤87 kg), Men"] "\n" [:option {:value "19009416"} "Heavyweight, Greco-Roman (≤97 kg), Men"] "\n" [:option {:value "19009445"} "Super-Heavyweight, Greco-Roman (≤130 kg), Men"] "\n" [:option {:value "19009474"} "Featherweight, Freestyle (≤57 kg), Men"] "\n" [:option {:value "19009503"} "Welterweight, Freestyle (≤65 kg), Men"] "\n" [:option {:value "19009532"} "Middleweight, Freestyle (≤74 kg), Men"] "\n" [:option {:value "19009561"} "Light-Heavyweight, Freestyle (≤86 kg), Men"] "\n" [:option {:value "19009590"} "Heavyweight, Freestyle (≤97 kg), Men"] "\n" [:option {:value "19009619"} "Super-Heavyweight, Freestyle (≤125 kg), Men"] "\n" [:option {:value "19009648"} "Flyweight, Freestyle (≤50 kg), Women"] "\n" [:option {:value "19009677"} "Featherweight, Freestyle (≤53 kg), Women"] "\n" [:option {:value "19009735"} "Middleweight, Freestyle (≤62 kg), Women"] "\n" [:option {:value "19009764"} "Light-Heavyweight, Freestyle (≤68 kg), Women"] "\n" [:option {:value "19009793"} "Heavyweight, Freestyle (≤76 kg), Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "134292"} "2004"] "\n" [:option {:value "263499"} "2008"] "\n" [:option {:value "332690"} "2012"] "\n" [:option {:value "355864"} "2016"] "\n" [:option {:value "2008171"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/679"} "Event type"]] [:h1 {:class "event_title"} "Lightweight, Freestyle (≤57 kg), Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "4 –  5 August 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2125"} "Makuhari Messe, 2-1, Nakase, Mihama-ku, Chiba, Chiba Prefecture, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19009706"} "16 from 16 countries"]]]]] [:div {:class "description"} [:p {} "Japan’s " [:a {:href "/athletes/130851"} "Risako Kawai"] " was the defending Olympic gold medallist and the 2019 World Champion in this class and had also won the 2018 Worlds at 59 kg and the 2017 Worlds at 60 kg. She was seeded first, followed by Nigerian " [:a {:href "/athletes/131237"} "Odunayo Adekuoroye"] ", a three-time medallist at the World Championships and a Commonwealth Games Champion in 2014 and 2018. Japan’s " [:a {:href "/athletes/107562"} "Kaori Icho"] ", likely the greatest ever female wrestler, had won gold at 58 kg in Rio, following three gold medals at 62 kg in 2004, 2008, and 2012. Since retired, Icho’s absence opened up the class for other wrestlers looking to medal."] "\n\n" [:p {} "The other seeds were " [:a {:href "/athletes/141070"} "Iryna Kurachkina"] " (BLR-3) and " [:a {:href "/athletes/141800"} "Rong Ningning"] " (CHN-4). Kurachkina had two bronze medals from the World Championships while Rong had won the Worlds in this class in 2018 and was runner-up in 2019 to Kawai. Unseeded but also expected to challenge was the United States’ " [:a {:href "/athletes/132194"} "Helen Maroulis"] ", who had won the gold medal at Rio at 53 kg, but had since moved up in class."] "\n\n" [:p {} "The shock of the opening round came when Adekuoroye was taken down by fall by unheralded Moldovan " [:a {:href "/athletes/145215"} "Anastasia Nichita"] ". Rong was also defeated in round one, but she was taken out, 8-0, by Maroulis, not really an upset. Both Kawai and Kurachkina won their opening matches."] "\n\n" [:p {} "The semi-finals saw Kawai meet Maroulis, who she defeated in a defensive struggle, 2-1, and Kurachkina facing Bulgarian " [:a {:href "/athletes/141327"} "Evelina Nikolova"] ", who was no match for the Belarussian, losing 11-0 by technical superiority in 4:42. Kawai and Kurachkina met for the gold medal, with Kawai winning a workman-like victory 5-0. For Kawai, this completed a family wrestling double as two days before, her younger sister, " [:a {:href "/athletes/144500"} "Yukako Kawai"] ", had taken the gold medal at 62 kg, and gave her two consecutive Olympic titles in this event."] "\n\n" [:p {} "The bronze medals went to Maroulis and Nikolova in easy victories, Maroulis winning by technical superiority, 11-0, over Mongolian " [:a {:href "/athletes/145353"} "Boldsaikhan Khongorzul"] ", and Nikolova taking down ROC team member " [:a {:href "/athletes/126880"} "Valeriya Koblova"] " by fall."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Classification Points", :class "footnote"} "CP"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Victories by Fall", :class "footnote"} "VF"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Victories by Technical Superiority", :class "footnote"} "ST"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Technical Points", :class "footnote"} "TP"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Technical Points Received", :class "footnote"} "TPR"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/130851"} "Risako Kawai"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]] [:td {} "12"] [:td {} "0"] [:td {} "0"] [:td {} "22"] [:td {} "3"]