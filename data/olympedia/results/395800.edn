value "396039"} "Team, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "46500"} "1988"] "\n" [:option {:value "47135"} "1992"] "\n" [:option {:value "47562"} "1996"] "\n" [:option {:value "48003"} "2000"] "\n" [:option {:value "48369"} "2004"] "\n" [:option {:value "262349"} "2008"] "\n" [:option {:value "328079"} "2012"] "\n" [:option {:value "19003870"} "2020"] "\n" [:option {:value "2005950"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/625"} "Event type"]] [:h1 {:class "event_title"} "Singles, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "6 – 11 August 2016"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/917"} "Riocentro Pavilhão 3, Parque Olímpico da Barra, Barra da Tijuca, Rio de Janeiro"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/395800"} "70 from 46 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament. Top 16 seeds advanced to round three. Seeds 17-32 advanced to round two."]]]] [:div {:class "description"} [:p {} "For the singles qualification, the world ranking list was used with a maximum of two players per nation. Players who did not participate in any of the qualification tournaments were eliminated from the list. The 22 best players qualified for Rio with 40 more places awarded to players from continental qualification tournaments. These included six players each from both Africa and Latin America, 11 each from Asia and Europe, and three each from both North America and Oceania. The remaining eight players received wild card entries, including players from the host nation."] "\n\n" [:p {} "In Rio, the 12 lowest ranked players on the world ranking took part in a preliminary round with six progressing to the first round and they were then joined by the players ranked 33-70 on the word list. In the second round the first round winners met players 17-32 in the world rankings, and It was not until the third round that the world’s 16 best ranked players joined the tournament and further elimination matches took place. These singles formats were the same as in London and possibly Beijing."] "\n\n" [:p {} "All matches were played to the best-of seven, with the first to win four sets taking the match. " [:a {:href "/athletes/117509"} "Dimitrij Ovtcharov"] " of Germany and " [:a {:href "/athletes/117536"} "Bojan Tokič"] " of Slovenia set a world record in their round of 16 match, when the first set went to 64 games, which Bojan Tokič won 33-31. " [:a {:href "/athletes/107517"} "Zhiwen He"] " from Spain was the oldest player at the age of 54 and " [:a {:href "/athletes/136380"} "Kanak Jha"] " of the USA was the youngest at 16. " [:a {:href "/athletes/121929"} "Ma Long"] " easily won his first Olympic singles final against his Chinese team-mate [Zhang Jike] by four sets to one. The clear pre-tournament favourite, he lost only four sets in the entire competition, two in the last-32 and two in the semi-final. Sensationally " [:a {:href "/athletes/693"} "Vladimir Samsonov"] " from Belarus reached the semi-final after beating Ovtcharov in the quarter-final, but was finally placed an unfortunate fourth."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/121929"} "Ma Long"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.