value "19006320"} "Canadian Singles, Slalom, Men"] "\n" [:option {:value "19006332"} "Canadian Singles, Slalom, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255438"} "1972"] "\n" [:option {:value "256065"} "1992"] "\n" [:option {:value "256201"} "1996"] "\n" [:option {:value "256310"} "2000"] "\n" [:option {:value "256430"} "2004"] "\n" [:option {:value "258863"} "2008"] "\n" [:option {:value "307020"} "2012"] "\n" [:option {:value "353600"} "2016"] "\n" [:option {:value "2008437"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/181"} "Event type"]] [:h1 {:class "event_title"} "Kayak Singles, Slalom, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "25 – 27 July 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2130"} "Kasai Canoe Slalom Centre, 1-1, Rinkaicho, Edogawa-ku, Tokyo, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19006326"} "27 from 27 countries"]]]]] [:div {:class "description"} [:p {} "The seven-time individual world champion (four in C-1 and three in K-1) and two-time Olympic medallist (silver in 2012 and bronze in 2016) " [:a {:href "/athletes/123753"} "Jessica Fox"] " of Australia was the pre-race favourite. Reigning Olympic champion " [:a {:href "/athletes/116621"} "Maialen Chourraut"] " of Spain was making her fourth Olympic appearance (she also took bronze in 2012) and was attempting to defend her title. Reigning world champion " [:a {:href "/athletes/125775"} "Eva Terčelj"] " of Slovenia was also a medal contender, but in the semi-final run she missed a gate and finished only 24th."] "\n\n" [:p {} "In both the preliminaries and semi-final, Fox dominated the field beating her rivals by a distance. The final, however, was against all expectations, with Germany’s two-time individual European champion, and the winner of the overall ICF World Cup in 2016 and 2017, " [:a {:href "/athletes/143276"} "Ricarda Funk"] " capturing the gold medal with an error-free run. The 38-year-old Chourraut took the silver, making her the oldest athlete to win a women’s Olympic medal in canoe slalom. Although Fox posted the fastest time of the day, she also picked up four seconds in penalties relegating her to bronze, repeating her performance from Rio 2016. Mistakes by two other paddlers also proved costly in the hunt for medals. Italy’s " [:a {:href "/athletes/130647"} "Stefanie Horn"] " deprived herself of a silver medal with a two-second penalty, while Poland’s " [:a {:href "/athletes/2102332"} "Klaudia Zwolinska"] " dropped from third to fifth with four seconds in penalties. Five years ago, Funk was the top athlete heading into the Rio Olympics, but failed at the final selection and missed the Games. Now she had that elusive gold medal to her credit."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "2"] [:td {} [:a {:href "/athletes/143276"} "Ricarda Funk"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "101.56 (2)"] [:td {} "107.96 (3)"] [:td {} "105.50 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "5"] [:td {} [:a {:href "/athletes/116621"} "Maialen Chourraut"]] [:td {} [:a {:h