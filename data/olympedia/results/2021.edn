l), Men"] "\n" [:option {:value "2013"} "30 kilometres (Classical), Men"] "\n" [:option {:value "2014"} "50 kilometres (Freestyle), Men"] "\n" [:option {:value "2015"} "4 × 10 kilometres Relay, Men"] "\n" [:option {:value "905272"} "5 kilometres, B1, Men"] "\n" [:option {:value "2019"} "5 kilometres (Classical), Women"] "\n" [:option {:value "2020"} "10 kilometres (Classical), Women"] "\n" [:option {:value "2022"} "4 × 5 kilometres Relay, Women"] "\n" [:option {:value "905276"} "5 kilometres, B1, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "2007"} "1984"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/197"} "Event type"]] [:h1 {:class "event_title"} "20 kilometres (Freestyle), Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "25 February 1988 — 9:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/17"} "Canmore Nordic Centre, Canmore"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2021"} "55 from 18 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: ?" [:br {}] "Height Differential: 98 m" [:br {}] "Intermediate 1: 5.0 km" [:br {}] "Intermediate 2: 10.0 km" [:br {}] "Intermediate 3: 15.0 km" [:br {}] "Maximum Climb: 51 m" [:br {}] "Total Climbing: 738 m"]]]] [:div {:class "description"} [:p {} "This event was no longer held at the World Championships, having been supplanted by a 30 km race in 1987 at Oberstdorf, and this would be the last time it was held at the Winter Olympics, as the 30 km would become the women’s long-distance event from 1992 onwards. The 1987 World Champion in the 30 km was Sweden’s " [:a {:href "/athletes/83032"} "Marie-Helene Westin-Östlund"] " but she was never a factor in Calgary, finishing 10th. The race was dominated by two Soviet skiers, " [:a {:href "/athletes/82869"} "Tamara Tikhonova"] " and " [:a {:href "/athletes/82183"} "Anfisa Reztsova"] ", who were 1-2 at every checkpoint, and would win the gold and silver medal, respectively, Reztsova over a minute ahead of the bronze medalist, their teammate, " [:a {:href "/athletes/82399"} "Raisa Smetanina"] ". The medal sweep was the first in cross-country skiing since 1960 and 1964, when the Soviet Union won all three medals in the 10 km both years. The fourth Soviet skier was " [:a {:href "/athletes/81124"} "Nina Gavrylyuk"] ", who originally placed eighth but was disqualified for wearing the logo of a shoe manufacturer on her headband."] "\n"] [:button {:id "button664951", :class "btn btn-default"} "Details"] [:script {} "$('#button664951').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "Intermediate 1"] [:th {:style "display: none", :class "split"} "Intermediate 2"] [:th {:style "display: none", :class "split"} "Intermediate 3"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "42"] [:td {} [:a {:href "/athletes/82869"} "Tamara Tikhonova"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "55:53.6"] [:td {:class "split", :style "display: none"} "15:35.0 (1)"] [:td {:class "split", :style "display: none"} "27:20.1 (1)"] [:td {:class "split", :style "display: none"} "44:01.9 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "54"] [: