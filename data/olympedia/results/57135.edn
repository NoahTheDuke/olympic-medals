928"] "\n" [:option {:value "57989"} "1932"] "\n" [:option {:value "58231"} "1936"] "\n" [:option {:value "58578"} "1948"] "\n" [:option {:value "58937"} "1952"] "\n" [:option {:value "59330"} "1956"] "\n" [:option {:value "59715"} "1960"] "\n" [:option {:value "60161"} "1964"] "\n" [:option {:value "60599"} "1968"] "\n" [:option {:value "61114"} "1972"] "\n" [:option {:value "61698"} "1976"] "\n" [:option {:value "62258"} "1980"] "\n" [:option {:value "62738"} "1984"] "\n" [:option {:value "63374"} "1988"] "\n" [:option {:value "64053"} "1992"] "\n" [:option {:value "64735"} "1996"] "\n" [:option {:value "65407"} "2000"] "\n" [:option {:value "66095"} "2004"] "\n" [:option {:value "257229"} "2008"] "\n" [:option {:value "302377"} "2012"] "\n" [:option {:value "358639"} "2016"] "\n" [:option {:value "19000437"} "2020"] "\n" [:option {:value "2013589"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/48"} "Event type"]] [:h1 {:class "event_title"} "Marathon, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "22 August 1920 — 16:12"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/243"} "Olympisch Stadion, Antwerpen"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/57135"} "48 from 17 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "42,750 metres (26.56 miles) out-and-back."]]]] [:div {:class "description"} [:p {} "The marathon course was the longest in Olympic history, at 42.75 km.  The course began and ended in " [:a {:href "/venues/243"} "Beerschot Stadium"] ", with the runners doing 1½ laps of the track at the beginning and end of the race.  Fortunately the weather was cool and damp."] "\n\n" [:p {} "South Africa’s " [:a {:href "/athletes/75269"} "Chris Gitsham"] " and Belgium’s " [:a {:href "/athletes/65157"} "Auguste Broos"] " were the early leaders, taking the lead by three kilometres.  Gitsham had been training on the course for several weeks.  At 20 km, the lead pack consisted of Gitsham, Broos, " [:a {:href "/athletes/67641"} "Hannes Kolehmainen"] ", and Italy’s " [:a {:href "/athletes/71874"} "Ettore Blasi"] ", with Estonia’s " [:a {:href "/athletes/67342"} "Jüri Lossman"] " and the Finn " [:a {:href "/athletes/67856"} "Juho Tuomikoski"] " close behind.  Kolehmainen, winner of the " [:a {:href "/results/56634"} "5K"] " and " [:a {:href "/results/56642"} "10K at Stockholm in 1912"] ", took the lead at the midpoint of the race and, overall, he and Gitsham ran together for almost 15 kilometres.  Gitsham, however, was having problems with a leg injury and withdrew at around 37 kilometres.  Kolehmainen by then was pulling away for what appeared would be an easy victory, in what was the fastest time ever run for the marathon, even with the extra-long course.  However, Lossman closed superbly and finished only about 13 seconds behind the Finn. Lossman later declared that had any of his Estonian teammates supported him, instead of going on an all day excursion, he would have won the race.  The third-place finisher, " [:a {:href "/athletes/71842"} "Valerio Arri"] " of Italy, was so delighted with his bronze medal that he performed three cartwheel somersaults as he crossed the finish line."] "\n\n" [:p {} "One of the Australian competitors, " [:a {:href "/athletes/64718"} "Wilfrid Kent Hughes"] ", wrote the following of Kolehmainen’s victory: “The winner could not rest his tired muscles.  They wrapped him in the flag of his country, placed a laurel wreath on his head, and forced him to make one more round of the track.  Kolehmainen ran round tiredly, in his fantastic ‘costume’ and reminded one of a Greek god who, dressed in a Roman toga, had just flown down from Olympus.  The crowd wildly cheered him, and the fanatic sports lovers passed him from hand to hand. It’s surprising he ever managed to survive the great ‘honour.’”"] "\n\n" [:p {} "Diplomas of merit were awarded to all runners who finished the race within 25% of the winning time, or anyone under 3-10:44.8, which worked out to be the top 30 runners."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "263"] [:td {} [:a {:href "/athletes/67641"} "Hannes Kolehmainen"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]] [:td {} "2-32:35.8"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} "WB"]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "680"] [:td {} [:a {:href "/athletes/67342"} "Jüri Lossman"]] [:td {} [:a {:href "/countries/EST"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/EST.png"}] "EST"]] [:td {} "2-32:48.6"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "464"] [:td {} [:a {:href "/athletes/71842"} "Valerio Arri"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} "2-36:37.8"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "10"] [:td {} [:a {:href "/athletes/65157"} "Auguste Broos"]] [:td {} [:a {:href "/countries/BEL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BEL.png"}] "BEL"]] [:td {} "2-39:25.8"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {:class "