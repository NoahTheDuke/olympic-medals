value "258824"} "Canadian Singles, Slalom, Men"] "\n" [:option {:value "258863"} "Kayak Singles, Slalom, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255417"} "1972"] "\n" [:option {:value "256036"} "1992"] "\n" [:option {:value "256166"} "1996"] "\n" [:option {:value "256285"} "2000"] "\n" [:option {:value "256402"} "2004"] "\n" [:option {:value "307012"} "2012"] "\n" [:option {:value "353548"} "2016"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/175"} "Event type"]] [:h1 {:class "event_title"} "Canadian Doubles, Slalom, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "13 – 15 August 2008"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/819"} "Shunyi Aolinpike Shuishang Gongyuan, Mapo, Shunyi"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/258832"} "24 from 12 countries"]]]]] [:div {:class "description"} [:p {} "Twin brothers " [:a {:href "/athletes/90262"} "Pavol"] " and " [:a {:href "/athletes/90263"} "Peter Hochschorner"] " of Slovakia had won the C-2 slalom at the last two editions of the Olympics and were the reigning European and World Champions, all of which made them strong favorites to defend their title once again at the 2008 Games. They were the top-ranked duo in the qualifiers, but were bested by Germany’s " [:a {:href "/athletes/116480"} "Felix Michel"] " and " [:a {:href "/athletes/116481"} "Sebastian Piersig"] " in the semi-final, which was new round in Beijing wherein the ten qualifiers were whittled down to six after one run. The Czech Republic’s " [:a {:href ""} "Jaroslav Volf"] " and " [:a {:href "/athletes/90161"} "Ondřej Štěpánek"] " who were, among other titles, the 2004 Olympic bronze medalists and the 2004 and 2005 European and 2006 World Champions, came in third. This order remained the same after the first run of the final, but changed after a disastrous run in the second portion left the Germans not only last in that round, but last overall. The Slovakians and the Czechs were again second and third, which allowed them to claim gold and silver respectively, even though they were defeated in the second run by " [:a {:href "/athletes/116482"} "Cédric Forgit"] " and " [:a {:href "/athletes/116483"} "Martin Braud"] " of France. Forgit and Braud were the 2006 European champions, but their fifth-place ranking after the first round prevented them from climbing higher than fourth overall after the second run. Thus Russia’s " [:a {:href ""} "Mikhail Kuznetsov"] " and " [:a {:href "/athletes/116487"} "Dmitry Larionov"] ", who had been fourth in both portions, took bronze. The Hochschorner brothers’ victory made them the first duo or team to win three consecutive gold medals with the same lineup. In 2012 two other teams with the same lineup won their third medal in the same event” Americans " [:a {:href "/athletes/94425"} "Venus"] " and " [:a {:href "/athletes/94424"} "Serena Williams"] " in tennis doubles (2000, 2008, 2012) and " [:a {:href "/athletes/94592"} "Kerri Walsh"] " and " [:a {:href "/athletes/94405"} "Misty May-Treanor"] " in beach volleyball (2004, 2008, and 2012)."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Pair"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/90262"} "Pavol Hochschorner"] " / " [:a {:href "/athletes/90263"} "Peter Hochschorner"]] [:td {} [:a {:href "/countries/SVK"} [:img {:style "pad