on {:value "351326"} "Featherweight (≤68 kilograms), Men"] "\n" [:option {:value "351352"} "Welterweight (≤80 kilograms), Men"] "\n" [:option {:value "351378"} "Heavyweight (&gt;80 kilograms), Men"] "\n" [:option {:value "351430"} "Featherweight (≤57 kilograms), Women"] "\n" [:option {:value "351456"} "Welterweight (≤67 kilograms), Women"] "\n" [:option {:value "351482"} "Heavyweight (&gt;67 kilograms), Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "900733"} "1988"] "\n" [:option {:value "901121"} "1992"] "\n" [:option {:value "28116"} "2000"] "\n" [:option {:value "28343"} "2004"] "\n" [:option {:value "262209"} "2008"] "\n" [:option {:value "325104"} "2012"] "\n" [:option {:value "19004404"} "2020"] "\n" [:option {:value "2007653"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/616"} "Event type"]] [:h1 {:class "event_title"} "Flyweight (≤49 kilograms), Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "17 – 18 August 2016"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/903"} "Arena Carioca 3, Parque Olímpico da Barra, Barra da Tijuca, Rio de Janeiro"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/351404"} "16 from 16 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament. All fighters losing to the finalists in each pool advance to repêchage tournament for the bronze medal."]]]] [:div {:class "description"} [:p {} "China’s " [:a {:href "/athletes/117366"} "Wu “Joy” Jingyu"] " dominated this weight division throughout the 2015 Grand Prix series and seemed set to add to the two Olympic gold medals she already had, thus becoming the first taekwondo exponent to win three Olympic golds. It was no surprise when she won the WTF Female Player of the Year for 2015. By a strange coincidence, Wu played a bit part in a 2003 Chinese movie called “Taekwondo”, which told the story of a character winning gold at Beijing in 2008 and London in 2012 – just as Wu did. Thailand’s number two seed " [:a {:href "/athletes/131834"} "Panipak Wongpattanakit"] " was dominated by Wu in 2015, but was the only fighter able to land a head kick on her. She was a medal contender as was the very experienced Croatian " [:a {:href "/athletes/123593"} "Lucija Zaninović"] ", the world number three. Brazil’s fourth-seeded " [:a {:href "/athletes/129341"} "Iris Sing"] " had the benefit of the home fans behind her."] "\n\n" [:p {} "Wu opened with a 10-1 win over the 16th seed, " [:a {:href "/athletes/131866"} "Huang Huai-Hsuan"] " of Chinese Taipei, but then came the biggest shock of the day when she lost 17-7 to the Serbian " [:a {:href "/athletes/131713"} "Tijana Bogdanović"] ". The number two seed, Wongpattanakit, also fell at the quarter-final stage, losing 6-5 to Kim So-hui of South Korea. Remarkably, all of the top four seeds went at the last eight stage with local favourite Sing losing heavily, 14-4, to Mexico’s Itzel Manjarrez. Wu’s conqueror, Bogdanovic went all the way to the final where she lost 7-6 to " [:a {:href "/athletes/130972"} "Kim So-Hui"] " of South Korea, a 2013 and 2014 world champion. Kim reached the final after ending 0-0 against " [:a {:href "/athletes/130187"} "Yasmina Aziez"] " of France in he semi-final, but won on the sudden death golden point. The bronze medals went to second seed Wongpattanakit and " [:a {:href "/athletes/129113"} "Patimat Abakarova"] " of Azerbaijan."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]]