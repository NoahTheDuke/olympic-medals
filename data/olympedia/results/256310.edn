alue "256278"} "Canadian Singles, Slalom, Men"] "\n" [:option {:value "256285"} "Canadian Doubles, Slalom, Men"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255438"} "1972"] "\n" [:option {:value "256065"} "1992"] "\n" [:option {:value "256201"} "1996"] "\n" [:option {:value "256430"} "2004"] "\n" [:option {:value "258863"} "2008"] "\n" [:option {:value "307020"} "2012"] "\n" [:option {:value "353600"} "2016"] "\n" [:option {:value "19006326"} "2020"] "\n" [:option {:value "2008437"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/181"} "Event type"]] [:h1 {:class "event_title"} "Kayak Singles, Slalom, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "17 – 18 September 2000"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/754"} "Penrith Whitewater Stadium, Penrith, New South Wales"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/256310"} "20 from 16 countries"]]]]] [:div {:class "description"} [:p {} "The format of the K-1 slalom had changed since the previous Olympics, as now the scores of both rounds, rather than just the best one, counted and there was a qualifying round prior to the final. The defending Olympic champion, the Czech Republic’s " [:a {:href "/athletes/9386"} "Štěpánka Hilgertová"] ", returned to the Games in 2000 as the reigning European and World Champion, as well as runner-up in those events in 1998 and 1997 respectively, and was a strong favorite to defend her title. Slovakia’s " [:a {:href "/athletes/10714"} "Elena Kaliská"] " and France’s " [:a {:href "/athletes/90176"} "Brigitte Guibal"] " were the 1998 and 1997 European and World Champions respectively, while Australia’s " [:a {:href "/athletes/8991"} "Danielle Woodward"] " was the 1992 Olympic runner-up."] "\n\n" [:p {} "Kaliská, Hilgertová, and the latter’s compatriot " [:a {:href "/athletes/9390"} "Irena Pavelková"] ", the 2000 European bronze medalist, finished in the top three in the qualifying round, with Guibal in fourth and Woodward in 14th. Guibal and Hilgertová were in the top two positions after the first run of the final, with France’s " [:a {:href "/athletes/90174"} "Anne-Lise Bardet"] " in third. Kaliská, meanwhile, was in fifth, while Pavelková and Woodward were in eighth and tenth respectively. Hilgertová had an excellent second run that allowed her to come out on top of both the round and the final rankings, winning the gold medal and leaving Guibal, who was third in the second portion of the competition, with silver. Pavelková’s second-place finish in the second round, meanwhile, was only good enough to bring her to fifth place, and thus Bardet, fourth in the second run, took bronze."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/9386"} "Štěpánka Hilgertová"]] [:td {} [:a {:href "/countries/CZE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CZE.png"}] "CZE"]] [:td {} "285.07 (2)"] [:td {} "247.04 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/90176"} "Brigitte Guibal"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.ama