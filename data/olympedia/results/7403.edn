um, and the US had the gold medal and a world record of 3:16.53. The USSR was almost two seconds back for the silver, followed by East Germany."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "3:19.52 (1 h3)"] [:td {} "3:16.53 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "560"] [:td {} [:a {:href "/athletes/51415"} "Chris Jacobs"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "555"] [:td {} [:a {:href "/athletes/51307"} "Troy Dalbey"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "561"] [:td {} [:a {:href "/athletes/51417"} "Tom Jager"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "548"] [:td {} [:a {:href "/athletes/51266"} "Matt Biondi"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "569"] [:td {} [:a {:href "/athletes/51454"} "Brent Lang"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "559"] [:td {} [:a {:href "/athletes/51362"} "Doug Gjertsen"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "563"] [:td {} [:a {:href "/athletes/51425"} "Shaun Jordan"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td 