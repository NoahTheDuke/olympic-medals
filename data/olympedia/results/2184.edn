lue "2189"} "1928"] "\n" [:option {:value "2194"} "1932"] "\n" [:option {:value "2199"} "1936"] "\n" [:option {:value "2204"} "1948"] "\n" [:option {:value "2210"} "1952"] "\n" [:option {:value "2217"} "1956"] "\n" [:option {:value "2224"} "1960"] "\n" [:option {:value "2231"} "1964"] "\n" [:option {:value "2238"} "1968"] "\n" [:option {:value "2245"} "1972"] "\n" [:option {:value "2252"} "1976"] "\n" [:option {:value "2259"} "1980"] "\n" [:option {:value "2266"} "1984"] "\n" [:option {:value "2273"} "1988"] "\n" [:option {:value "2287"} "1992"] "\n" [:option {:value "2301"} "1994"] "\n" [:option {:value "2311"} "1998"] "\n" [:option {:value "2321"} "2002"] "\n" [:option {:value "2334"} "2006"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/368"} "Event type"]] [:h1 {:class "event_title"} "Individual, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "2 –  4 February 1924"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/25"} "Stade Olympique, Chamonix"] " / " [:a {:href "/venues/25"} "Stade Olympique, Chamonix"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2184"} "30 from 9 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Normal hill ski jumping and 18 kilometres skiing; placements determined by points table."]]]] [:div {:class "description"} [:p {} "The 18 km cross country part of Nordic Combined was integrated in the " [:a {:href "/results/1889"} "“normal“ 18 km race"] ", and put all the four Norwegians in front of their opponents with a decisive margin. " [:a {:href "/athletes/86509"} "Thorleif Haug"] " and " [:a {:href "/athletes/86270"} "Johan Grøttumsbraaten"] " took the gold and silver in the cross country event and were also entered for Nordic Combined, and " [:a {:href "/athletes/97917"} "Thoralf Strømstad"] " and " [:a {:href "/athletes/99306"} "Harald Økern"] " had times in the 18 km race that would have placed them as 5th and 11th among the specialists."] "\n\n" [:p {} "The ski jumping part of the event was held on the same day as the " [:a {:href "/results/2350"} "main ski jumping event"] ", and Haug astonished the audience again by winning the jumping event as well, aided by his superb style. He was followed by his countrymen Strømstad and Økern, which had longer jumps than Haug in both rounds, Økern’s 47 metre in the 2nd round being the longest in the competition. It ended as in the " [:a {:href "/results/1890"} "50 km cross-country"] ", with a clean sweep for the Norwegian quartet. The best non-Norwegian, the Swede " [:a {:href "/athletes/95857"} "Axel-Herman Nilsson"] ", was a distant 5th, and the great Haug had won three gold of three possible so far in skiing."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Cross Country Skiing, 18 km"] [:th {} "Ski Jumping, Normal Hill"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/86509"} "Thorleif Haug"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "18.906"] [:td {} "1-14:31 (1)"] [:td {} "17.812 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/97917"} "Thoralf Strømstad"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "18.219"] [:td {} "1-17:03 (3)"] [:td {} "17.687 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/86270"} "Johan Grøttumsbr