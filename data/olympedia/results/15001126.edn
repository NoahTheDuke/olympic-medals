tres, Men"] "\n" [:option {:value "15001102"} "1,500 metres, Men"] "\n" [:option {:value "15001103"} "5,000 metres, Men"] "\n" [:option {:value "15001104"} "10,000 metres, Men"] "\n" [:option {:value "15001105"} "Mass Start, Men"] "\n" [:option {:value "15001110"} "Team Pursuit (8 laps), Men"] "\n" [:option {:value "15001124"} "500 metres, Women"] "\n" [:option {:value "15001125"} "1,000 metres, Women"] "\n" [:option {:value "15001127"} "3,000 metres, Women"] "\n" [:option {:value "15001128"} "5,000 metres, Women"] "\n" [:option {:value "15001129"} "Mass Start, Women"] "\n" [:option {:value "15001134"} "Team Pursuit (6 laps), Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "905033"} "1932"] "\n" [:option {:value "1011"} "1960"] "\n" [:option {:value "1019"} "1964"] "\n" [:option {:value "1027"} "1968"] "\n" [:option {:value "1035"} "1972"] "\n" [:option {:value "1044"} "1976"] "\n" [:option {:value "1053"} "1980"] "\n" [:option {:value "1062"} "1984"] "\n" [:option {:value "1071"} "1988"] "\n" [:option {:value "1081"} "1992"] "\n" [:option {:value "1091"} "1994"] "\n" [:option {:value "1105"} "1998"] "\n" [:option {:value "1119"} "2002"] "\n" [:option {:value "1148"} "2006"] "\n" [:option {:value "924525"} "2010"] "\n" [:option {:value "350669"} "2014"] "\n" [:option {:value "9001055"} "2018"] "\n" [:option {:value "19020426"} "2022"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/539"} "Event type"]] [:h1 {:class "event_title"} "1,500 metres, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "20 February 2026 — 16:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2201"} "Milano Speed Skating Stadium, Fiera Milano Rho, Rho, Milano, ITA"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/15001126"} "29 from 16 countries"]]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/19020426"} "1:53.28"] " / " [:a {:href "/athletes/109767"} "Ireen Wüst"] " " [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"] " /  7 February 2022 / " [:a {:href "/records/event_name/539"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/1807428"} "Karl Skoog"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/1807429"} "André de Vries"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]]]]] [:div {:class "description"} [:p {} "With defending and three-time Olympic champion " [:a {:href "/athletes/109767"} "Ireen Wüst"] " retiring after the Beijng Games, this left 1,500 m title open. " [:a {:href "/athletes/156911"} "Joy Beune"] " was the obvious candidate for the title, having won the 2025 World Title and all four World Cup races she contested in the 2025/2026 season. However, she had failed to qualify for the Olympics at the Dutch Olympic Trials, missing in the cut-off there by 0.17 seconds. With Beune out, the role of favourite fell to " [:a {:href "/athletes/119701"} "Miho Takagi"] ". Silver medallist in 2022, she had won the only World Cup of the season that Beune did not race in, as well as the overall World Cup title. In addition she had won the 2024 world title in the event, and had already earned three bronzes in MilanoCortina. There were various others mentioned for a medal position: " [:a {:href "/athletes/128166"} "Antoinette Rijpma-de Jong"] " (bronze in 2022), " [:a {:href "/athletes/148714"} "Ragne Wiklund"] " (2021 World Champion), " [:a {:href "/athletes/128778"} "Brittany Bowe"] " (2015 World Champion) and " [:a {:href "/athletes/136972"} "Han Mei"] " (2-time World Championship medalist)."] "\n\n" [:p {} "Competition was opened by " [:a {:href "/athletes/148672"} "Femke Kok"] ", who had not skated a 1,500 m since she was a junior, but had surprising friend and foe by bettering the track record at a test race in Heerenveen. She followed this up by qualifying at the Dutch Trials, and was considered an outsider. Racing alone, the sprinter started fast and faded in the final lap. Given the usual fast times at Milano, she was disappointed to finish in 1:54.79. In fact, the time remained fastest through the ice preparation break, with only compatriot " [:a {:href "/athletes/148670"} "Marijke Groenewoud"] " coming close (1:55.16). Only in pair 10 was Kok’s time finally beaten. " [:a {:href "/athletes/119809"} "Valérie Maltais"] ", who had already won gold in the team pursuit and bronze in the 3,000 m, gained a lot of ground in the final two laps, resulting in 1:54.40. Three pairs later, Maltais’ good friend Wiklund mounted a serious attack on the leading time. Despite losing ground in the final lap, the Norwegian bettered the best mark to 1:54.15 Next up were Rijpma-de Jong and Bowe. As a sprinter, Bowe opened fast, with Rijpma-de Jong not far behind. At the bell, both skaters were slightly faster than Wiklund. While Bowe could not keep the pace in the final lap (1:54.70), Rijpma-de Jong did hold on and finished after 1:54.09. In the final pair, Takagi then took off 0.3 seconds faster than the leading time, building out that advantage to 0.4 seconds at 1,100 m. By the final curve, the virtual difference (visible in the stadium and on tv) hovered between -0.1 and +0.1 seconds, but eventually Takagi faded and fell back further, finishing in 1:54.86."] "\n\n" [:p {} "It was the sixth Olympic medal for Rijpma-de Jong, but her first Olympic title. It marked the fifth consecutive time a Dutch skater had won the event, with Wüst winning it in 2010, 2018 and 2022, and " [:a {:href "/athletes/119771"} "Jorien ter Mors"] " in 2014. For both Wiklund and Maltai it was the third medal of the Games."] "\n\n"] [:button {:id "button227962", :class "btn btn-default"} "Details"] [:script {} "$('#button227962').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "300 m"] [:th {:style "display: none", :class "split"} "700 m"] [:th {:style "display: none", :class "split"} "1100 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "14O"] [:td {} [:a {:href "/athletes/128166"} "Antoinette Rijpma-de Jong"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "1:54.09"] [:td {:class "split", :style "display: none"} "25.26"] [:td {:class "split", :style "display: none"} "53.26"] [:td {:class "split", :style "display: none"} "1:23.06"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "13O"] [:td {} [:a {:href "/athletes/148714"} "Ragne Wiklund"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "1:54.15"] [:td {:class "split", :style "display: none"} "25.68"] [:td {:class "split", :styl