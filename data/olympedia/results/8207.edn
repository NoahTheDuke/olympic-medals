[:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "4816"} "1924"] "\n" [:option {:value "4915"} "1928"] "\n" [:option {:value "5010"} "1932"] "\n" [:option {:value "5109"} "1936"] "\n" [:option {:value "5217"} "1948"] "\n" [:option {:value "5348"} "1952"] "\n" [:option {:value "5459"} "1956"] "\n" [:option {:value "5605"} "1960"] "\n" [:option {:value "5790"} "1964"] "\n" [:option {:value "6066"} "1968"] "\n" [:option {:value "6370"} "1972"] "\n" [:option {:value "6648"} "1976"] "\n" [:option {:value "6888"} "1980"] "\n" [:option {:value "7164"} "1984"] "\n" [:option {:value "7505"} "1988"] "\n" [:option {:value "7860"} "1992"] "\n" [:option {:value "8606"} "2000"] "\n" [:option {:value "8996"} "2004"] "\n" [:option {:value "261735"} "2008"] "\n" [:option {:value "322120"} "2012"] "\n" [:option {:value "357226"} "2016"] "\n" [:option {:value "19000238"} "2020"] "\n" [:option {:value "2001744"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/595"} "Event type"]] [:h1 {:class "event_title"} "100 metres Backstroke, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "22 July 1996"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/724"} "Georgia Tech Aquatic Center, Atlanta, Georgia"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/8207"} "36 from 30 countries"]]]]] [:div {:class "description"} [:p {} "The 100 metres backstroke final was memorable for being literally a battle between master and pupil. The two main protagonists were both American with 25-year-old schoolteacher " [:a {:href "/athletes/51053"} "Whitney Hedgepeth"] " facing off against 15-year-old high school student " [:a {:href "/athletes/50971"} "Beth Botsford"] " for the Olympic title."] "\n\n" [:p {} "Their paths to the medal podium were made considerably easier by the failure to qualify to the final of the two women who finished 1-2 at the last World Championships. " [:a {:href "/athletes/46079"} "He Cihong"] " was another of the Chinese team to fail to live up to the reputation gained in their glory year of 1994 whilst " [:a {:href "/athletes/50700"} "Nina Zhivanevskaya"] " of Russia finished just 0.04 outside the top eight who qualified."] "\n\n" [:p {} "Botsford was never headed in the final and while Hedgepath did close slowly in the latter stages she was nearly three tenths of a second clear at the end of the race.  This victory earned her a place on the US medley relay team where she earned a second gold medal. Botsford won a Pan American Games silver medal over this distance in 1999 and a Universiade bronze over 50 metres in 2003 but this was her first and last Olympic Games."] "\n\n" [:p {} "Hungary’s " [:a {:href "/athletes/48094"} "Krisztina Egerszegi"] " chose not to swim in order to focus on other events. The time she set on the backstroke leg of the medley relay in Atlanta would have been enough to win gold in the 100 metres backstroke."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "B Final"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/50971"} "Beth Botsford"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "1:02.00 (2 h5)"] [:td {} "–"] [:td {} "1:01.19 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/51053"} "Whitney Hedgepeth"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-