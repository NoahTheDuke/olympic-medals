e "154918"} "Road Race, Individual, Women"] "\n" [:option {:value "154919"} "Individual Time Trial, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "155008"} "2000"] "\n" [:option {:value "155136"} "2004"] "\n" [:option {:value "258959"} "2008"] "\n" [:option {:value "308003"} "2012"] "\n" [:option {:value "356741"} "2016"] "\n" [:option {:value "19001701"} "2020"] "\n" [:option {:value "2003681"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/213"} "Event type"]] [:h1 {:class "event_title"} "Individual Time Trial, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 3 August 1996 — 8:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/720"} "Buckhead Cycling Course, Atlanta, Georgia"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/154879"} "38 from 23 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "52.2 km. (32.4 miles)."]]]] [:div {:class "description"} [:p {} "The men’s road race had been conducted as an individual time trial from 1912 thru 1932, when it was switched to a mass start race. But in 1994, the World Championships added an individual road time trial, based on the popularity of the individual time trial stages held at the major Tours, such as the Tour de France and Giro d’Italia. The Olympic Program in 1996 also added this race, dropping the team time trial. The favorite was Spain’s " [:a {:href "/athletes/14847"} "Miguel Induráin"] ". Induráin had competed in the Olympic road race in 1984, but failed to finish. He turned professional in 1985, but struggled at his first few attempts in the Tour de France. Finally, in 1991 he won the Tour, and he would then win it from 1991-95, only the fourth five-time winner of the Tour, and the first to do it five times consecutively. Induráin’s specialty was the individual time trial, the " [:em {} "contre la montre"] " to the French, but also known as the “Race of Truth,” because it so often determined the champion in major stage races."] "\n\n" [:p {} "In 1996, Induráin finally was defeated at the Tour de France, placing 11th behind Denmark’s " [:a {:href "/athletes/16311"} "Bjarne Riis"] ". He was going to skip the Olympics, citing fatigue, until a special appeal from IOC President [Juan Antonio Samaranch](/athletes/899318. The early leader in the race was " [:a {:href "/athletes/13641"} "Chris Boardman"] ", gold medalist in 1992 in the individual pursuit. The next-to-last to start was " [:a {:href "/athletes/15932"} "Abraham Olano"] ", World Champion in 1995 on the road. He surpassed Boardman’s time and took the lead. Induráin went off last and was ahead of Boardman’s leading splits at all the early marks and won, besting Olano’s time by 12 seconds, with Boardman winning the bronze."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Margin"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/14847"} "Miguel Induráin"]] [:td {} [:a {:href "/countries/ESP"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ESP.png"}] "ESP"]] [:td {} "1-04:05"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/15932"} "Abraham Olano"]] [:td {} [:a {:href "/countries/ESP"} [:img {:style "padding-right: 2px; vertical-align: middle