"15000901"} "1,000 metres, Men"] "\n" [:option {:value "15000937"} "5,000 metres Relay, Men"] "\n" [:option {:value "15000944"} "500 metres, Women"] "\n" [:option {:value "15000965"} "1,000 metres, Women"] "\n" [:option {:value "15000986"} "1,500 metres, Women"] "\n" [:option {:value "15001001"} "3,000 metres Relay, Women"] "\n" [:option {:value "15001008"} "2,000 metres Mixed Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "905322"} "1988"] "\n" [:option {:value "759"} "2002"] "\n" [:option {:value "876"} "2006"] "\n" [:option {:value "923697"} "2010"] "\n" [:option {:value "350728"} "2014"] "\n" [:option {:value "9001142"} "2018"] "\n" [:option {:value "19020502"} "2022"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/545"} "Event type"]] [:h1 {:class "event_title"} "1,500 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "14 February 2026"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2193"} "Forum di Milano, Assago, Milano, Milano"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/15000922"} "36 from 19 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Placements 1-12 based on A and B final.  Deeper placements based on placements in earlier rounds, and best time skated."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/19020502"} "2:09.213"] " / " [:a {:href "/athletes/127892"} "Shaolin Sándor Liu"] " " [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"] " /  9 February 2022 / " [:a {:href "/records/event_name/545"} "Details"]]]]] [:div {:class "description"} [:p {} "The 2022 champion " [:a {:href "/athletes/137644"} "Hwang Dae-Heon"] " had suffered from a COVID-19 infection after those Games, missing the 2022 World Championships and suffering through the aftermath in the following season. His results had not been at the same level as before Beijing 2022, but he was still considered a factor in the 1,500 m. World Champions since 2022 had been " [:a {:href "/athletes/137351"} "Shaoang Liu"] ",  now racing for China instead of Hungary, Park Ji-Won, who failed to qualify for Milano, " [:a {:href "/athletes/148134"} "Sun Long"] " and " [:a {:href "/athletes/156214"} "William Dandjinou"] ". In the World Tour, Dandjinou had also dominated, winning three out of four races, the other one going to " [:a {:href "/athletes/156852"} "In Jong-Eon"] ". After his performance in the 1,000 m, " [:a {:href "/athletes/148681"} "Jens van ‘t Wout"] " was also considered a contender."] "\n\n" [:p {} "The quarter-finals saw the elimination of In, as well as home favorite " [:a {:href "/athletes/148510"} "Pietro Sighel"] ". The semi-finals were a messy affair, with a penalty in each heat, as well as an advancement for every penalty. Thanks to this, all the favorites made it through to the final: Dandjinou, Hwang, Liu, Van ‘t Wout, Sun. They were joined by " [:a {:href "/athletes/148016"} "Steven Dubois"] ",  " [:a {:href "/athletes/148371"} "Niall Treacy"] ", " [:a {:href "/athletes/156853"} "Sin Dong-Min"] " and " [:a {:href "/athletes/148636"} "Roberts Krūzbergs"] ". After a slow start in the final, Van ‘t Wout rode into the lead with 6 laps to go. This sparked a series of overtakes behind him. Treacy moved to the outside when there was no room and tripped, taking Sun with him (and earning a penalty). Sin then clashed with Dandjinou, causing the Canadian to go wide and fall back to last place. Dandjinou briefly recovered back to second but then fell back: first behind Hwang, then also behind Krūzbergs. In the front, there were no further changes as Van ‘t Wout brought home his second gold of the Games, ahead of Hwang and Krūzbergs."] "\n\n" [:p {} "As in the 1,000 m, Van ‘t Wout’s gold was the first ever for the Netherlands in the event, having previously won one medal. Hwang won his second medal in the 1,500 m, tying the record held by " [:a {:href "/athletes/101555"} "Apolo Anton Ohno"] " and " [:a {:href "/athletes/101557"} "Viktor An"] ". The medal won by Krūzbergs was the first ever won by Latvia in short-track, and the first ever in the Winter Games not won in a sliding sport."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Final Round Placement"] [:th {} "Semi-Final Placement"] [:th {} "Quarter-Final Placement"] [:th {} "Best Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "2"] [:td {} [:a {:href "/athletes/148681"} "Jens van 't Wout"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "1"] [:td {} "1"] [:td {} "1"] [:td {} "2:12.219"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "110"] [:td {} [:a {:href "/athletes/137644"} "Hwang Dae-Heon"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} "2"] [:td {} "2"] [:td {} "1"] [:td {} "2:12.304"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "7"] [:td {} [:a {:href "/athletes/148636"} "Roberts Krūzbergs