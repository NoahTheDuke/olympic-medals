"} "Jon Olsen"] " for the USA, " [:a {:href "/athletes/45928"} "Stephen Clarke"] " for Canada, and the formidable " [:a {:href "/athletes/50058"} "Aleksandr Popov"] " for the Russian Unifieds. Popov outswam Clarke by over two seconds to get the Unified Team home for silver. But he had started 2½ seconds behind Olsen, who brought the Americans home in 3:36.93 to equal the world record for the medley relay."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "3:39.84 (1 h3)"] [:td {} "3:36.93 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "Backstroke"] [:td {:class "bib"} "627"] [:td {} [:a {:href "/athletes/51540"} "Jeff Rouse"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "Breaststroke"] [:td {:class "bib"} "606"] [:td {} [:a {:href "/athletes/51318"} "Nelson Diebel"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "Butterfly"] [:td {:class "bib"} "623"] [:td {} [:a {:href "/athletes/51497"} "Pablo Morales"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "Freestyle"] [:td {:class "bib"} "626"] [:td {} [:a {:href "/athletes/51512"} "Jon Olsen"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "Backstroke"] [:td {:class "bib"} "602"] [:td {} [:a {:href "/athletes/51264"} "Dave Berkoff"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "",