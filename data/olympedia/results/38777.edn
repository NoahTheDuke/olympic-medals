38000"} "1900"] "\n" [:option {:value "38011"} "1904"] "\n" [:option {:value "38017"} "1908"] "\n" [:option {:value "38025"} "1912"] "\n" [:option {:value "38041"} "1920"] "\n" [:option {:value "38068"} "1924"] "\n" [:option {:value "38095"} "1928"] "\n" [:option {:value "38119"} "1932"] "\n" [:option {:value "38129"} "1936"] "\n" [:option {:value "38179"} "1948"] "\n" [:option {:value "38237"} "1952"] "\n" [:option {:value "38305"} "1956"] "\n" [:option {:value "38341"} "1960"] "\n" [:option {:value "38391"} "1964"] "\n" [:option {:value "38432"} "1968"] "\n" [:option {:value "38502"} "1972"] "\n" [:option {:value "38568"} "1976"] "\n" [:option {:value "38623"} "1980"] "\n" [:option {:value "38678"} "1984"] "\n" [:option {:value "38727"} "1988"] "\n" [:option {:value "38827"} "1996"] "\n" [:option {:value "38884"} "2000"] "\n" [:option {:value "38966"} "2004"] "\n" [:option {:value "262918"} "2008"] "\n" [:option {:value "330000"} "2012"] "\n" [:option {:value "396300"} "2016"] "\n" [:option {:value "19001580"} "2020"] "\n" [:option {:value "2003100"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/631"} "Event type"]] [:h1 {:class "event_title"} "Water Polo, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "1 –  9 August 1992"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/679"} "Piscina Municipal de Montjuïc, Barcelona"] " / " [:a {:href "/venues/692"} "Piscinas Bernat Picornell, Barcelona"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/38777"} "152 from 12 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Round-robin pools advanced teams to classification matches."]]]] [:div {:class "description"} [:p {} "Yugoslavia was the world’s top side. They had won the gold medal in 1984, and won the World and European Championships in 1991, defeating Spain in the final of both of those tournaments. The tournament was expected to come down to those two teams. But shortly before the Barcelona Olympics, the United Nations had sanctioned Yugoslavia for its actions in the Bosnian and Croatian war, and the International Olympic Committee (IOC) agreed to ban the nation from the Olympics. It provided an out, however, by allowing individual Yugoslav athletes to competed as Independent Olympic Participants (IOP), but teams from Yugoslavia could not compete, and thus their water polo team was not in Barcelona."] "\n\n" [:p {} "The United States and the Unified Team advanced to the semi-finals from Group A, while Spain and Italy advanced from Group B. In the semis, Italy defeated the Unified Team 9-8, while Spain defeated the United States 6-4. Italy and Spain had already met in pool play, tying 9-9."] "\n\n" [:p {} "The final became the longest water polo match in Olympic history. It was tied at the end of regulation, 7-7, and remained that way through two overtime periods. In the second overtime, Spanish superstar, " [:a {:href "/athletes/53757"} "Manuel Estiarte"] " scored on a penalty throw with only 42 seconds remaining, appearing to give Spain the gold medal. But with 33 seconds to go, " [:a {:href "/athletes/53803"} "Jordi Sans"] " was sent off and Italy’s " [:a {:href "/athletes/54308"} "Massimiliano Ferretti"] " scored the equalizer. Three more overtimes were played, with no score. In the sixth overtime, Italy’s " [:a {:href ""} "Fernando Gandolfi"] " scored with 32 seconds on the clock, to put Italy ahead, 9-8. A last second Spanish shot failed and Italy won the gold medal."] "\n\n" [:p {} "As in 1980, 1984, and 1988, " [:a {:href "/athletes/53757"} "Manuel Estiarte"] " was the leading scorer in the Olympic tournament, with 22 goals in Barcelona, but this time he was tied by Hungary’s " [:a {:href "/athletes/54135"} "Tibor Benedek"] "."] "\n"] [:button {:id "button144248", :class "btn btn-default"} "Details"] [:script {} "$('#button144248').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {}] [:th {} "Pos"] [:th {} "Number"] [:th {} "Team"] [:th {} "NOC"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Games Played", :class "split", :style "display: none"} "GP"] [:th {:style "display: none", :class "split"} "Goals/Saves"] [:th {:style "display: none", :class "split"} "Attempts"] [:th {:style "display: none", :class "split"} "Shot %"] [:th {:style "display: none", :class "split"} "Natural Action Goals/Attempts"] [:th {:style "display: none", :class "split"} "Centre Goals/Attempts"] [:th {:style "display: none", :class "split"} "Extraman Goals/Attempts"] [:th {:style "display: none", :class "split"} "Penalty Shots/Attempts"] [:th {:style "display: none", :class "split"} "Counter Attack Goals/Attempts"] [:th {:style "display: none", :class "split"} "Turnover Fouls"] [:th {:style "display: none", :class "split"} "Steals"] [:th {:style "display: none", :class "split"} "Penalty Fouls"] [:th {:style "display: none", :class "split"} "Exclusion (w/wo Sub)"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {:class "accordion-toggle", :data-toggle "collapse", :data-target ".team-members-573559"} [:div {:class "glyphicon glyphicon-plus"}]] [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "Italy"] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {:class "split", :style "display: none"} "7"] [:td {:class "split", :style "display: none"} "59"] [:td {:class "split", :style "display: none"} "169"] [:td {:class "split", :style "display: none"} "34.9%"] [:td {:class "split", :style "display: none"} "13/65"] [:td {:class "split", :style "display: none"} "8/23"] [:td {:class "split", :style "display: none"} "19/53"] [:td {:class "split", :style "display: none"} "9/10"] [:td {: