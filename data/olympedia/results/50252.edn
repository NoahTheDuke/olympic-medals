ocation.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "50072"} "1952"] "\n" [:option {:value "50090"} "1956"] "\n" [:option {:value "50108"} "1960"] "\n" [:option {:value "50126"} "1964"] "\n" [:option {:value "50144"} "1968"] "\n" [:option {:value "50162"} "1972"] "\n" [:option {:value "50180"} "1976"] "\n" [:option {:value "50198"} "1980"] "\n" [:option {:value "50216"} "1984"] "\n" [:option {:value "50234"} "1988"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/362"} "Event type"]] [:h1 {:class "event_title"} "Team, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "26 – 29 July 1992"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/680"} "Real Club de Polo, Barcelona"] " / " [:a {:href "/venues/682"} "Palacio de la Metalurgia, Barcelona"] " / " [:a {:href "/venues/692"} "Piscinas Bernat Picornell, Barcelona"] " / " [:a {:href "/venues/693"} "Campo de Tiro Olímpico de Mollet, Mollet del Vallès"] " / " [:a {:href "/venues/694"} "Estadio Pau Negre, Barcelona"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/50252"} "51 from 17 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Scoring by point tables.  Team scores totalled from individual scores. Three-man teams with all scores counting.                                                                                                  "]]]] [:div {:class "description"} [:p {} "This was the final team modern pentathlon at the Olympics, likely forever, as the event was discontinued after 1992. The Soviet Union had won the 1990 and 1991 World Championships, and their surrogate, the Unified Team, was the favorite. Hungary led after the fencing and swimming, but Poland pulled ahead after the third phase, shooting. For the second time ever at the Olympics (after 1928), the event did not end with the cross-country run, but the Russian-led Unifieds were strong and pulled into the lead, with Poland second and Hungary third. In the steeplechase ride, Russian " [:a {:href "/athletes/35028"} "Eduard Zenovka"] ", leading the individual competition, had a disastrous ride, finishing only 56th of 66 competitors. With his poor point score, the Unifieds placed only eighth in the ride, and Poland, second in the steeplechase, moved ahead to win the gold medal. Hungary also struggled on the horse, finishing only 13th, and dropped to fifth place overall. Italy had the best performance in the riding and moved up to a bronze medal."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Team Points"] [:th {} "Individual Points"] [:th {} "Fencing"] [:th {} "Swimming"] [:th {} "Shooting"] [:th {} "Running"] [:th {} "Riding"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Poland"] [:td {} [:a {:href "/countries/POL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/POL.png"}] "POL"]] [:td {} "16,018"] [:td {} "–"] [:td {} "2,575 (2)"] [:td {} "3,632 (16)"] [:td {} "3,420 (1)"] [:td {} "3,369 (8)"] [:td {} "3,022 (2)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/34996"} "Arkadiusz Skrzypaszek"] " "] [:td {}] [:td {} "16,018"] [:td {} "5,559"] [:td {} "2,575"] [:td {} "3,632"] [:td {} "3,420"] [:td {} "3,369"] [:td {} "3,022"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/34988"} "Dariusz Goździak"] " "] [:td {}] [:td {} "16,018"] [:td {} "5,254"] [:td {} "2,575"] [:td {} "3,632"] [:t