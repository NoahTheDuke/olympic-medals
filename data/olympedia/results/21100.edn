09265"} "1870"] "\n" [:option {:value "21103"} "1904"] "\n" [:option {:value "926219"} "1904"] "\n" [:option {:value "21115"} "1906"] "\n" [:option {:value "21122"} "1908"] "\n" [:option {:value "21131"} "1912"] "\n" [:option {:value "21134"} "1920"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/622"} "Event type"]] [:h1 {:class "event_title"} "Tug-Of-War, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "16 July 1900"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/193"} "Croix Catelan, Bois de Boulogne, Paris"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/21100"} "12 from 3 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-contest."]]]] [:div {:class "description"} [:p {} "Tug-of-war was contested by only two teams – one from France, and a mixed Scandinavian team from Sweden and Denmark. A United States’ team was also entered but did not take part. In various sources over the years, very different results are seen for this sport, despite the small number of entrants. The best study of the problem was done by Ture Widlund, a founding member of the International Society of Olympic Historians (ISOH), who published his work, “Dragkamp vid Olympiska Spelen i Paris 1900,” in " [:em {} "Idrott Historia och Samhälle"] ", in 1981. His conclusion is quite unmistakable that only the two teams mentioned actually competed, with the Scandinavian team defeating the French team."] "\n\n" [:p {} "However, both the " [:em {} "Journal des Sports"] " and " [:em {} "The New York Herald Tribune"] " (Paris edition) noted that, after the competition had ended, the American team pulled against the Swedish/Danish team. " [:em {} "Journal des Sports"] " wrote (translated), “The Americans wanted to tug in spiked shoes. Protests were raised, whereupon they took off their shoes and tugged barefoot, which gave them a certain advantage. The first round was won by the Americans. In the second round some Americans, who did not belong to the team, grabbed the rope to help their countrymen, who were tired. An unpleasant incident now followed, which nearly ended in a common fight. Officials intervened and brought an end to the unpleasant scene.” " [:em {} "The New York Times"] " noted, “The remaining event, the tug-of-war, was won by a Swedish team against a French team, the Americans not competing.”"] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Mixed team"] [:td {} [:a {:href "/countries/MIX"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/MIX.png"}] "MIX"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/17806"} "Edgar Aabye"] " (DEN) • " [:a {:href "/athletes/66989"} "Eugen Schmidt"] " (DEN) • " [:a {:href "/athletes/67011"} "Charles Winckler"] " (DEN) • " [:a {:href "/athletes/76331"} "August Nilsson"] " (SWE) • " [:a {:href "/athletes/76419"} "Gustaf Söderström"] " (SWE) • " [:a {:href "/athletes/76397"} "Karl Gustaf Staaf"] " (SWE)"]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Racing Club de France"] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/17910"} "Roger Basset"] " • " [:a {:href "/athletes/17878"} "Jean Collas"] " • " [:a {:href "/athletes/17890"} "Charles Gondouin"] " • " [:a {:href "/athletes/127263"} "Francis Henríquez 