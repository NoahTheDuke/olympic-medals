 {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Judge / Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003169"} "L. Saari"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Judge / Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002367"} "H. Schultz"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]]]]] [:div {:class "description"} [:p {} "America’s " [:a {:href "/athletes/8764"} "Ed Sanders"] " created carnage in the heavyweight division as he battered his way to the final with three brutal knockout victories. His opponent in the final, Sweden’s " [:a {:href "/athletes/8161"} "Ingemar Johansson"] ", appeared to be completely intimidated by the American’s reputation and spent most of the fight backpedaling around the ring. When Sanders did get into range, Johansson would simply grab hold of his opponent. Eventually, an increasingly irate referee grew tired of warning the Swede and disqualified him for “not trying”. This also had the effect of denying Johansson his silver medal, and the second step on the podium remained vacant."] "\n\n" [:p {} "Sanders, a member of the US Navy, turned professional in 1954 with high expectations, but these were derailed when he lost only his fourth pro fight. In December 1954, he was knocked out by Willie James in a fight at the Boston Garden. Sanders was rushed to the hospital with a blood clot on the brain and succumbed to his injury, dying three days later."] "\n\n" [:p {} "Ironically, it was Johansson who became a household name as a professional when he became the first European to win the World Heavyweight Championship for over 20 years after knocking out fellow Olympic champion " [:a {:href "/athletes/8746"} "Floyd Patterson"] ". In 1982, 30 years after his Olympic embarrassment, Johansson was finally awarded his silver medal after the " [:a {:href "/organizations/1"} "International Olympic Committee"] " (IOC) was persuaded to reverse their decision."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/8764"} "Ed Sanders"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/8161"} "Ingemar Johansson"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {} [:a {:class "footnote", :href "#", :title "Originally disqualified for passivity, and no silver medal awarded. His silver medal was restored by the IOC in 1982.", :data-toggle "tooltip", :data-placement "right"} "1"]]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/7990"} "Dries Niemann"]] [:td {} [:a {:href "/countries/RSA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RSA.png"}] "RSA"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/2947"} "Ilkka Koski"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src 