ming since before World War II, at the finish Kolb was half-a-pool ahead of the silver medalist, her teammate " [:a {:href "/athletes/51224"} "Lynn Vidali"] ". East German " [:a {:href "/athletes/47542"} "Sabine Steinbach"] ", who had been touched out for bronze in the 200 IM, placed third over the fast closing American " [:a {:href "/athletes/51149"} "Sue Pedersen"] "."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "15390"] [:td {} [:a {:href "/athletes/51086"} "Claudia Kolb"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "5:17.2 (1 h5)"] [:td {} "5:08.5 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "15399"] [:td {} [:a {:href "/athletes/51224"} "Lynn Vidali"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "5:28.9 (1 h3)"] [:td {} "5:22.2 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "23076"] [:td {} [:a {:href "/athletes/47542"} "Sabine Steinbach"]] [:td {} [:a {:href "/countries/GDR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GDR.png"}] "GDR"]] [:td {} "5:31.3 (1 h2)"] [:td {} "5:25.3 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "15394"] [:td {} [:a {:href "/athletes/51149"} "Sue Pedersen"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-rig