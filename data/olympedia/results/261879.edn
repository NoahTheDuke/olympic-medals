059"} "Doubles, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "44000"} "1896"] "\n" [:option {:value "44028"} "1900"] "\n" [:option {:value "44077"} "1904"] "\n" [:option {:value "926092"} "1904"] "\n" [:option {:value "926128"} "1904"] "\n" [:option {:value "44135"} "1906"] "\n" [:option {:value "44210"} "1908"] "\n" [:option {:value "44337"} "1912"] "\n" [:option {:value "44578"} "1920"] "\n" [:option {:value "44715"} "1924"] "\n" [:option {:value "900151"} "1968"] "\n" [:option {:value "900254"} "1968"] "\n" [:option {:value "900391"} "1984"] "\n" [:option {:value "45037"} "1988"] "\n" [:option {:value "45230"} "1992"] "\n" [:option {:value "45440"} "1996"] "\n" [:option {:value "45658"} "2000"] "\n" [:option {:value "45876"} "2004"] "\n" [:option {:value "324071"} "2012"] "\n" [:option {:value "353205"} "2016"] "\n" [:option {:value "19004600"} "2020"] "\n" [:option {:value "2006500"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/607"} "Event type"]] [:h1 {:class "event_title"} "Singles, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "10 – 17 August 2008"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/841"} "Beijing Aolinpike Gongyuan Wangqiuchang, Beijing Aolinpike Gongyuan, Beijing"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/261879"} "64 from 33 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament."]]]] [:div {:class "description"} [:p {} "The favorite was Spain’s " [:a {:href "/athletes/107371"} "Rafael Nadal"] ", who was the hottest player on the ATP Tour in 2008, and was poised to displace Switzerland’s legendary " [:a {:href "/athletes/94261"} "Roger Federer"] " from the #1 world ranking. Nadal had recently won the French Open (as he always did) and Wimbledon, and had a 32-match winning streak that was ended at the Cincinnati Open, his final tournament before the Beijing Olympics. Both Federer and Nadal won their first three matches, but Federer was then upset by American " [:a {:href "/athletes/117556"} "James Blake"] " in the quarter-finals. Blake then lost to Chile’s " [:a {:href ""} "Fernando González"] " in the semis in three sets, while Nadal advanced to the final with a difficult three-set win over Serbia’s " [:a {:href "/athletes/117575"} "Novak Đoković"] ". Đoković was world ranked #3, but was not yet the dominant force in tennis that he would become in the next few years."] "\n\n" [:p {} "González was hoping to match his countryman, " [:a {:href "/athletes/94197"} "Nicolás Massú"] ", who had won the Olympic singles gold in 2004, but the final was relatively easy for Nadal, who defeated González in straight sets, although it was not a runaway, winning 6-3, 7-6 (2), 6-3. The next day, Nadal advanced to become the #1 ranked player in the world, displacing Federer, who had been ranked #1 for a record 237 consecutive weeks. In the third-place match Đoković dispatched Blake with ease in straight sets to win the bronze medal."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/107371"} "Rafael Nadal"]] [:td {} [:a {:href "/countries/ESP"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ESP.png"}] "ESP"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/107356"}