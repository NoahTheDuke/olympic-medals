ue "19020481"} "1,000 metres, Men"] "\n" [:option {:value "19020502"} "1,500 metres, Men"] "\n" [:option {:value "19020517"} "5,000 metres Relay, Men"] "\n" [:option {:value "19020524"} "500 metres, Women"] "\n" [:option {:value "19020545"} "1,000 metres, Women"] "\n" [:option {:value "19020581"} "3,000 metres Relay, Women"] "\n" [:option {:value "19020588"} "2,000 metres Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "905388"} "1988"] "\n" [:option {:value "819"} "2002"] "\n" [:option {:value "936"} "2006"] "\n" [:option {:value "923761"} "2010"] "\n" [:option {:value "350792"} "2014"] "\n" [:option {:value "9001206"} "2018"] "\n" [:option {:value "15000986"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/549"} "Event type"]] [:h1 {:class "event_title"} "1,500 metres, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "16 February 2022"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/845"} "Shoudu Tiyguan, Beijing"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19020566"} "36 from 17 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Placements 1-12 based on final and B final.  Deeper placements based on placements in earlier rounds, and best time skated."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/923761"} "2:16.993"] " / " [:a {:href "/athletes/119816"} "Zhou Yang"] " " [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"] " / 20 February 2010 / " [:a {:href "/records/event_name/549"} "Details"]]]]] [:div {:class "description"} [:p {} "With giants " [:a {:href "/athletes/137698"} "Suzanne Schulting"] " (1,000 m) and " [:a {:href "/athletes/109931"} "Arianna Fontana"] " (500 m) having both won an individual title in Beijing, the third race seemed to be another duel between them. Schulting had been the better of the two earlier in the year, winning two World Cups, but the overall standings were led by Korea’s " [:a {:href "/athletes/137642"} "Lee Yu-Bin"] ". The defending champion and 2018 and 2019 World Champion " [:a {:href "/athletes/137639"} "Choi Min-Jeong"] " was also a serious title contender, having already won silver in the 1,000 m."] "\n\n" [:p {} "Despite some issues with the timing and lap counter controls, the quarter-finals went as expected. The semi-finals were mostly the same, with Lee and Fontana eliminating " [:a {:href "/athletes/136927"} "Kim Boutin"] ", bronze medalist in the 500 m, in the first heat. Schulting and " [:a {:href "/athletes/147886"} "Hanne Desmet"] " dominated the second semi-final, while Choi bettered the Olympic record in the final heat, with " [:a {:href "/athletes/136981"} "Han Yutong"] " and " [:a {:href "/athletes/148679"} "Xandra Velzeboer"] " tagging along."] "\n\n" [:p {} "Han attempted to pull away from the field early in the final, with Schulting quickly catching up. The two did not press, and the rest of the field reconnected, with Choi now taking charge. At three laps to go, Schulting attempted to pass Han, but was pushed to the outside, dropping her back behind Fontana. Schulting quickly passed Han on the next opportunity, but with the high pace set by Choi, there were no further options for passing."] "\n\n" [:p {} "This made Choi the third 2018 female short-track skater to retain her 2018 title, after Fontana (500 m) and Schulting (1,000 m), and with all three of them ending up on the podium."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Helmet Nr"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Position Last Race"] [:th {} "Positions"] [:th {} "Best Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "40"] [:td {} [:a {:href "/athletes/137639"} "Choi Min-Jeong"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} "AF-1"] [:td {} "1-1"] [:td {} "2:16.831"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "3"] [:td {} [:a {:href "/athletes/109931"} "Arianna Fontana"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} "AF-2"] [:td {} "2-2"] [:td {} "2:17.862"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/137698"} "Suzanne Schulting"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "AF-3"] [:td {} "1-1"] [:td {} "2:17.865"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "5"] [:td {} [:a {:href "/athletes/147886"} "Hanne Desmet"]] [:td {} [:a {:href "/countries/BEL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BEL.png"}] "BEL"]] [:td {} "AF-4"] [:td {} "2-2"] [:td {} "2:18.711"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {:class "bib"} "6"] [:td {} [:a {:href "/athletes/148679"} "Xandra Velzeboer