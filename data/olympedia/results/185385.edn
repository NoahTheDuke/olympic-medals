{:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/DEN.png"}] "DEN"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #2"] [:td {:style "width: 400px"} [:a {:href "/athletes/2305709"} "Hans Britschgi"]] [:td {} [:a {:href "/countries/SUI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SUI.png"}] "SUI"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #3"] [:td {:style "width: 400px"} [:a {:href "/athletes/12623"} "Jaap Rijks"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #4"] [:td {:style "width: 400px"} [:a {:href "/athletes/2305692"} "Kim Johnson"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]]] [:tr {:class "referees", :style ""} [:th {} "Course Designer"] [:td {:style "width: 400px"} [:a {:href "/athletes/2305648"} "Olaf Petersen"]] [:td {} [:a {:href "/countries/FRG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRG.png"}] "FRG"]]]]] [:div {:class "description"} [:p {} "The format was different as two rounds of qualifying were held, with the top 50% of riders advancing to the final round, with no more than three riders allowed in the final from any nation. The qualifying scoring was also different as it was a positive scoring system, rather than based on negative faults. The final round consisted of two rounds, again using the negative fault system, with both rounds to count for the final score. Only the top 20 riders and ties in the first final round advanced. German Olaf Petersen designed the course, which measured 770 metres in length, with verticals up to 1.60 metres. The largest oxer was 2.00 metres wide and the water jump measured 4.60 metres in width."] "\n\n" [:p {} "Gail Grennough had won the 1986 World Championship but was not named to the Canadian team for the 1988 Olympics. American Katharine Burdsall was the 1987 World Cup leader, but was also not at the Seoul Olympics. With several top riders out, the competition was considered wide open. In the final, West German " [:a {:href "/athletes/12143"} "Karsten Huck"] " went clean in round one to lead narrowly over France’s " [:a {:href "/athletes/11904"} "Pierre Durand, Jr."] " (with 0.25 faults) and Canadian " [:a {:href "/athletes/12430"} "Ian Millar"] " (with 0.75 faults). Thirteen riders tied for fourth with 4 faults. In the second round American " [:a {:href "/athletes/11617"} "Greg Best"] " had the only clean ride to finish with 4 faults. Durand had only one fault to finish with 1.25 faults. Huck was the last rider and needed 1 or less faults, but hit the penultimate barrier and dropped back to a tie with Best, giving Durand the gold medal. In the jump-off Best and Huck both had 4 faults, but Best won the silver medal based on time."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "Horse"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "283"] [:td {} [:a {:href "/athletes/11904"} "Pierre Durand"]] [:td {} [:i {} [:a {:href "/horses/1249"} "Jappeloup de Luze"]]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "110.00 (18)"] [:td {} "1.25 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "881"] [:td {} [:a {:href "/athletes/11617"} "Greg Best"]