"} "High Jump, Women"] "\n" [:option {:value "302198"} "Pole Vault, Women"] "\n" [:option {:value "9031008"} "Long Jump, Women"] "\n" [:option {:value "9031022"} "Triple Jump, Women"] "\n" [:option {:value "302181"} "Shot Put, Women"] "\n" [:option {:value "302021"} "Discus Throw, Women"] "\n" [:option {:value "302480"} "Hammer Throw, Women"] "\n" [:option {:value "302463"} "Javelin Throw, Women"] "\n" [:option {:value "302147"} "Heptathlon, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "61484"} "1972"] "\n" [:option {:value "62051"} "1976"] "\n" [:option {:value "62530"} "1980"] "\n" [:option {:value "63123"} "1984"] "\n" [:option {:value "63799"} "1988"] "\n" [:option {:value "64471"} "1992"] "\n" [:option {:value "65149"} "1996"] "\n" [:option {:value "65810"} "2000"] "\n" [:option {:value "66518"} "2004"] "\n" [:option {:value "257665"} "2008"] "\n" [:option {:value "359105"} "2016"] "\n" [:option {:value "19000779"} "2020"] "\n" [:option {:value "2013948"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/108"} "Event type"]] [:h1 {:class "event_title"} "4 × 400 metres Relay, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "10 – 11 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/874"} "Olympic Stadium, Olympic Park, Stratford, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/302552"} "71 from 16 countries"]]]]] [:div {:class "description"} [:p {} "The United States had won this title at the last four Olympic Games and was expected to do so again. They were led by " [:a {:href "/athletes/105045"} "Sanya Richards-Ross"] ", the individual 400 champion, " [:a {:href "/athletes/105036"} "DeeDee Trotter"] ", the bronze medalist in the 400, along with " [:a {:href "/athletes/105293"} "Allyson Felix"] ", the open 200 champion, but one who often ran the 400 metres in invitational meets, and had attempted a 200/400 double at the 2011 World Championships. No other team was given much of a chance for gold."] "\n\n" [:p {} "In the end it was more a coronation than a real race. Trotter gave the USA a nice lead on the opener, posting 50.2, with Russia’s " [:a {:href "/athletes/114820"} "Yuliya Gushchina"] " second at 51.0. Felix then ended any suspense with 48.2 on the second leg, the fastest of the race, as Russia trailed by more than two seconds. " [:a {:href "/athletes/126546"} "Francena McCorory"] " had the third leg for the Americans and opened the lead further, giving " [:a {:href "/athletes/105045"} "Sanya Richards-Ross"] " what amounted to a victory lap. She brought it home in 49.10 for a final time of 3:16.87, equal to the fifth fastest time ever. Russia trailed almost four seconds back for silver, with Ukraine getting bronze. Richards-Ross won her second gold medal of the London Olympics, while Felix won her third, including the 4×100 relay the day before. Richards-Ross also won her third consecutive gold medal in the event, emulating " [:a {:href "/athletes/79221"} "Frank Wykoff"] ", who won three relay gold medals for the United States in the 4×100 in 1928-36."] "\n\n" [:p {} "That was how the event and the results seemed to have ended. In 2015, however, the IOC began re-testing samples from the 2008 Beijing and 2012 London Olympics, using newer, more advanced testing techniques, in an effort to find those who had used performance enhancing drugs (PEDs), but in whom it could not be detected at the time of those Olympics. This was one of the many events affected."] "\n\n" [:p {} "In February 2017, " [:a {:href "/athletes/120568"} "Antonina Krivoshapka"] " was revealed to have tested positive for turinabol (dehydrochloromethyltestosterone). Her disqualification led to the Russian relay team losing the silver medal. Jamaica was advanced to the silver medal, and Ukraine received the bronze medal. In early October 2017, another Russian team member, " [:a {:href "/athletes/"} "Yuliya Gushchina"] ", also had a re-test positive (substance not announced), and in February 2019, " [:a {:href "/athletes/107763"} "Tatyana Firova"] " was also disqualified for an anti-doping rule violation (ADRV)."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "3:22.09 (1 h2)"] [:td {} "3:16.87 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "10"} [:a {:href "/athletes/105036"} "DeeDee Trotter"] " • " [:a {:href "/athletes/105293"} "Allyson Felix"] " • " [:a {:href "/athletes/126546"} "Francena McCorory"] " • " [:a {:href "/athletes/105045"} "Sanya Richards-Ross"] " • " [:a {:href "/athletes/126699"} "Keshia Baker"] " • " [:a {:href "/athletes/127099"} "Diamond Dixon"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} "Jamaica"] [:td {} [:a {:href "/countries/JAM"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JAM.png"}] "JAM"]] [:td {} "3:25.13 (1 h1)"] [:td {} "3:20.95 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "10"} [:a {:h