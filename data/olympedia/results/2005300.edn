{:value "2005321"} "Park, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "18000370"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/2557"} "Event type"]] [:h1 {:class "event_title"} "Street, Men" [:small {} [:a {:class "footnote", :href "#", :title "Originally scheduled for 27 July, postponed to 29 July due to rain.", :data-toggle "tooltip", :data-placement "right"} "1"]]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "29 July 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2168"} "Place de la Concorde, Paris, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2005300"} "22 from 11 countries"]]]]] [:div {:class "description"} [:p {} "The rainy weather that marked Friday’s Opening Ceremony on July 27 and led to the postponement of Saturday’s men’s street final to Monday didn’t take away from the setting, as the event went ahead at the iconic " [:a {:href "/venues/2168"} "Place de la Concorde"] ", with the Eiffel Tower in the background. Adding to the buzz was the presence of celebrities, including American Snoop Dogg, who energized the crowd with his enthusiastic support for the athletes."] "\n\n" [:p {} "This final is widely regarded as the greatest men’s street skateboarding contest to date, with athletes pushing the boundaries and delivering unprecedented performances.\nJapan’s " [:a {:href "/athletes/144702"} "Yuto Horigome"] " made Olympic history by defending his gold medal from Tokyo 2020, becoming the first skateboarder to win two Olympic golds in the sport. Despite a shaky start, Horigome executed a flawless nollie 270 backside noseblunt on his final trick, earning a near-perfect score of 97.08 points. This clutch performance edged out silver medalist American " [:a {:href "/athletes/147458"} "Jagger Eaton"] " by a mere 0.10 points, culminating in a total score of 281.14 points for Horigome. Eaton, who captured bronze at Tokyo 2020, had a standout moment with his nollie frontside 270 noseblunt that scored 95.25 points, temporarily placing him in the lead."] "\n\n" [:p {} "After a disappointing seventh-place finish at Tokyo 2020, American skateboarding icon " [:a {:href "/athletes/147460"} "Nyjah Huston"] " achieved redemption by earning his first Olympic medal – a bronze. He led early in the finals but couldn’t land his final trick, concluding with a total score of 279.38 points."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/144702"} "Yuto Horigome"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]] [:td {} "270.18 (1 h3)"] [:td {} "281.14 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/147458"} "Jagger Eaton"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "274.88 (1 h2)"] [:td {} "281.04 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/147460"} "Nyjah Huston"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags