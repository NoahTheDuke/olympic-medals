1"} "1964"] "\n" [:option {:value "5967"} "1968"] "\n" [:option {:value "6281"} "1972"] "\n" [:option {:value "6572"} "1976"] "\n" [:option {:value "6828"} "1980"] "\n" [:option {:value "7394"} "1988"] "\n" [:option {:value "7751"} "1992"] "\n" [:option {:value "8094"} "1996"] "\n" [:option {:value "8491"} "2000"] "\n" [:option {:value "8890"} "2004"] "\n" [:option {:value "261625"} "2008"] "\n" [:option {:value "322007"} "2012"] "\n" [:option {:value "357120"} "2016"] "\n" [:option {:value "19000151"} "2020"] "\n" [:option {:value "2001659"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/580"} "Event type"]] [:h1 {:class "event_title"} "400 metres Individual Medley, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "30 July 1984"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/608"} "Olympic Swim Stadium, University of Southern California, Los Angeles, California"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/7074"} "23 from 19 countries"]]]]] [:div {:class "description"} [:p {} "Sidelined by a shoulder injury in 1982, Canadian Alex Baumann had to watch as the World Championships were held, and Brazil’s " [:a {:href "/athletes/45677"} "Ricardo Prado"] " won the title and set the world record of 4:19.78. But Baumann improved later that year and won gold in both IMs at the 1982 Commonwealth Games. Early in 1984, East German " [:a {:href "/athletes/47781"} "Jens-Peter Berndt"] " broke Prado’s world record in Magdeburg, recording 4:19.61, only to see Baumann improve that at the Canadian Olympic Trials in June, with 4:17.53. Berndt was out, a victim of the Soviet-led boycott, but Prado was in Los Angeles, as was American " [:a {:href "/athletes/51599"} "Jesse Vassallo"] ", once the world best in this event, holding the world mark from 1978-82, but now past his best."] "\n\n" [:p {} "In the final Prado led after the first two legs, with Baumann still 1.7 seconds back at 200 metres, with Vassallo. But Baumann outswam Prado by three seconds on the breaststroke to take the lead, as Vassallo fell back. Baumann held on in the freestyle, and won with a world record 4:17.41, over a second ahead of Prado, as the bronze medal went to the surprising Australian " [:a {:href "/athletes/45318"} "Rob Woodhouse"] "."] "\n\n" [:p {} "A few weeks later Berndt won the Friendship Games in 4:18.29. On 7 January 1985, after swimming at a meet in Arkansas, Berndt defected to the United States at the Oklahoma City airport, and would later swim for West Germany at the 1988 Olympics. Baumann had known similar circumstances. Born in Czechoslovakia, he and his family were in New Zealand in 1968 when Soviet tanks rolled into Prague to crush Czech resistance. The family decided not to return to their native land, and settled in Sudbury, Ontario, where Baumann grew up and became the world’s greatest all-around swimmer."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "B Final"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "73"] [:td {} [:a {:href "/athletes/45912"} "Alex Baumann"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {} "4:22.46 (1 h3)"] [:td {} "–"] [:td {} "4:17.41 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "65"] [:td {} [:a {:href "/athletes/45677"} "Ricardo Prado"]] [:td {} [:a {:href "/countries/BRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BRA.png"}] "BR