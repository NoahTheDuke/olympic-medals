/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronisation Judges 3"] [:td {:style "width: 400px"} [:a {:href "/athletes/90609"} "Yeoh Ken Nee"]] [:td {} [:a {:href "/countries/MAS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/MAS.png"}] "MAS"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronisation Judges 4"] [:td {:style "width: 400px"} [:a {:href "/athletes/2000764"} "Yehia Daw"]] [:td {} [:a {:href "/countries/EGY"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/EGY.png"}] "EGY"]]] [:tr {:class "referees", :style ""} [:th {} "Synchronisation Judges 5"] [:td {:style "width: 400px"} [:a {:href "/athletes/107976"} "Hugo Parisi"]] [:td {} [:a {:href "/countries/BRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BRA.png"}] "BRA"]]]]] [:div {:class "description"} [:p {} "While defending champions " [:a {:href "/athletes/141842"} "Wang Zongyuan"] " and " [:a {:href "/athletes/141843"} "Xie Siyi"] " were both competing in Paris, only Wang returned to the synchronized springboard event. With his new partner, " [:a {:href "/athletes/151703"} "Long Daoyi"] ", he had won the 2023 and 2024 World Championships (and also the 2022 edition, with " [:a {:href "/athletes/122304"} "Cao Yuan"] "). Behind the Chinese, the event was pretty much open. The other Tokyo medalists were not returning, and medals at the past Worlds had been divided by five duos, four of whom were entered in Paris."] "\n\n" [:p {} "Long and Wang started strongly, claiming top scores in their first two dives. However, after they entered the water with bent legs on the fourth dive, they saw " [:a {:href "/athletes/145302"} "Juan Manuel Celaya"] " and " [:a {:href "/athletes/145304"} "Osmar Olvera"] " of Mexico at the top of the leaderboard. Long and Wang regained the lead with their next dive by just 1.08 points. The Britons " [:a {:href "/athletes/2503064"} "Anthony Harding"] " and " [:a {:href "/athletes/122961"} "Jack Laugher"] " were also less than seven points behind."] "\n\n" [:p {} "For the last dives, the Chinese pair went first, recording the highest scores of the competition. The performance of the Mexicans seemed to be very close, but they received one point less from the judges. The resulting silver was Mexico’s first ever medal in the event. Celaya had finished an unfortunate fourth in Tokyo. Wang became the second person to win the synchronized springboard twice, after " [:a {:href "/athletes/116070"} "Qin Kai"] " in 2008-12."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Points"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "People's Republic of China"] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} "446.10"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "9"} [:a {:href "/athletes/151703"} "Long Daoyi"] " • " [:a {:href "/athletes/141842"} "Wang Zongyuan"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Mexico"] [:td {} [:a {:href "/countries/MEX"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/MEX.png"}] "MEX"]] [:td {} "444.03"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "9"} [:a {:href "/athletes/145302"} "Juan Manuel Celaya"] " • " [:a {:href "/athletes/145304"} "Osmar Olvera"]]] [:tr {:class "", :style ""} [:td {