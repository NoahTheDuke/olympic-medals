predicted."] "\n\n" [:p {} "This was the fourth time that a French vaulter had won Olympic gold, after " [:a {:href "/athletes/68266"} "Fernand Gonder"] " in 1906, " [:a {:href "/athletes/68468"} "Pierre Quinon"] " in 1984, and " [:a {:href "/athletes/68249"} "Jean Galfione"] " in 1996."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1758"] [:td {} [:a {:href "/athletes/125941"} "Renaud Lavillenie"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "5.65 (=1)"] [:td {} "5.97 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "1917"] [:td {} [:a {:href "/athletes/125804"} "Björn Otto"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "5.50 (=8)"] [:td {} "5.91 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "1904"] [:td {} [:a {:href "/athletes/115359"} "Raphael Holzdeppe"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "5.65 (=1)"] [:td {} "5.91 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=4"] [:td {:class "bib"} "1817"] [:td {} [:a {:href "/athletes/115364"} "Steve Lewis"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.