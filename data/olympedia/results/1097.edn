padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"] " / 18 February 1994 / " [:a {:href "/records/event_name/531"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004475"} "Stanley Strzykalski"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002100"} "Folkert Brouwer"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]]]]] [:div {:class "description"} [:p {} "The 1000 m world record had taken quite a beating before the Olympics. Starting out at 1:11.67, it was first lowered to 1:10.63 by " [:a {:href "/athletes/99347"} "Jan Bos"] " and " [:a {:href "/athletes/87155"} "Manabu Horii"] ", who tied for first at the Calgary World Cup. On the second day of competition there, " [:a {:href "/athletes/89506"} "Lee Gyu-Hyeok"] " again lowered it to 1:10.42, before " [:a {:href "/athletes/99342"} "Jeremy Wotherspoon"] ", brought it down even further to 1:10.16. Of these skaters, the top favorite was Jan Bos, having won the distance twice at the recent World Sprint Championships. He was expected be challenged by the other Dutch and Canadian skaters, though."] "\n\n" [:p {} "With no skaters having approached the 1:11.00 barrier yet, the first to touch it was 500 m champion " [:a {:href "/athletes/97498"} "Hiroyasu Shimizu"] ". Not known for his 1000 ms, the Japanese continued his 500 m form and clocked 1:11.00 exactly, a new personal best. The very next pair featured an outside favorite for a medal, " [:a {:href "/athletes/99359"} "Ids Postma"] ". Not a regular 1000 m skater, he was better known as an allround skater. His Olympics had not been as he had expected, having fallen in the first 500 m race, and losing the 1500 m gold due to a mishap in the last curve. Postma got his revenge in this race, setting the fastest time, by virtue of an excellent final lap. Wotherspoon led Postma’s split at the bell by 0.6 seconds, but dropped back to an eventual 6th place finish. " [:a {:href "/athletes/99351"} "Leeuwangh"] " and " [:a {:href "/athletes/84284"} "Sylvain Bouchard"] " met a similar fate, leaving only Jan Bos to challenge in the final pair. He, too had a half-second lead over his compatriot, but also failed in the final lap, missing the gold by just 0.07 seconds. Ids Postma was a farmer from Friesland, the province in the Netherlands best known for its speed skaters. He was, however, the first Olympic Champion speed skating champion to come from Friesland."] "\n"] [:button {:id "button246149", :class "btn btn-default"} "Details"] [:script {} "$('#button246149').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "200 m"] [:th {:style "display: none", :class "split"} "600 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "17O"] [:td {} [:a {:href "/athletes/99359"} "Ids Postma"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} "1:10.64"] [:td {:class "split", :style "display: none"} "16.90"] [:td {:class "split", :style "display: none"} "43.32"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "21O"] [:td {} [:a {:href "/athletes/99347"} "Jan Bos"]] [:td {} [