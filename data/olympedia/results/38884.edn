location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "38000"} "1900"] "\n" [:option {:value "38011"} "1904"] "\n" [:option {:value "38017"} "1908"] "\n" [:option {:value "38025"} "1912"] "\n" [:option {:value "38041"} "1920"] "\n" [:option {:value "38068"} "1924"] "\n" [:option {:value "38095"} "1928"] "\n" [:option {:value "38119"} "1932"] "\n" [:option {:value "38129"} "1936"] "\n" [:option {:value "38179"} "1948"] "\n" [:option {:value "38237"} "1952"] "\n" [:option {:value "38305"} "1956"] "\n" [:option {:value "38341"} "1960"] "\n" [:option {:value "38391"} "1964"] "\n" [:option {:value "38432"} "1968"] "\n" [:option {:value "38502"} "1972"] "\n" [:option {:value "38568"} "1976"] "\n" [:option {:value "38623"} "1980"] "\n" [:option {:value "38678"} "1984"] "\n" [:option {:value "38727"} "1988"] "\n" [:option {:value "38777"} "1992"] "\n" [:option {:value "38827"} "1996"] "\n" [:option {:value "38966"} "2004"] "\n" [:option {:value "262918"} "2008"] "\n" [:option {:value "330000"} "2012"] "\n" [:option {:value "396300"} "2016"] "\n" [:option {:value "19001580"} "2020"] "\n" [:option {:value "2003100"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/631"} "Event type"]] [:h1 {:class "event_title"} "Water Polo, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "23 September –  1 October 2000"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/758"} "Sydney International Aquatic Centre, Olympic Park, Sydney, New South Wales"] " / " [:a {:href "/venues/776"} "Ryde Aquatic Leisure Centre, Ryde, New South Wales"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/38884"} "153 from 12 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Round-robin pools advanced teams to classification matches."]]]] [:div {:class "description"} [:p {} "The 2007 World Championship had come down to a Croatia-Hungary final, with Croatia prevailing, 9-8. In 2005 Hungary had also lost the final of the World Championship to another remnant of Yugoslavia, this time Serbia &amp; Montenegro. Since World War II, Hungary and Yugoslavia had been the top water polo powers in the world, with Hungary winning Olympic medals at 12 straight Olympics from 1928-80. But the Soviet-led boycott of 1984 had knocked them from their perch and Hungary had not won an Olympic medal since 1980."] "\n\n" [:p {} "That changed in Sydney, although they lost two matches in group play. But they qualified for the quarter-finals where they easily defeated Italy, 8-5, moving onto a match against their arch-rivals, Serbia &amp; Montenegro, or what was remaining of Yugoslavia. Both semi-finals were close, Hungary winning 8-7, and Russia eliminating Spain by the same score. The final would come down to Hungary and Russia, best known for their historic 1956 match, which ended in a bloody brawl shortly after the Soviet Union had invaded Hungary. That match had ended in a 4-0 Hungarian victory but the 2000 final was not even that close. Hungary was well ahead after each period – 3-1, 8-2, 10-4 – finally winning 13-6 for their first Olympic water polo gold medal since 1976 in Montréal."] "\n\n" [:p {} "Defending Olympic champion Spain lost the bronze medal match to Serbia &amp; Montenegro, 8-3. That was the final Olympic appearance for their star, " [:a {:href "/athletes/53757"} "Manuel Estiarte"] ", competing in his sixth Olympics. Usually considered, along with Hungarian " [:a {:href "/athletes/54156"} "Dezső Gyarmati"] ", as one of the two greatest water poloists ever, Estiarte had led the Olympic tournament scoring in 1980, 1984, 1988, and 1992, and finished his Olympic career with 126 goals in 45 matches."] "\n"] [:button {:id "button318393", :class "btn btn-default"} "Details"] [:script {} "$('#button318393').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {}] [:th {} "Pos"] [:th {} "Number"] [:th {} "Team"] [:th {} "NOC"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Games Played", :class "split", :style "display: none"} "GP"] [:th {:style "display: none", :class "split"} "Goals/Saves"] [:th {:style "display: none", :class "split"} "Attempts"] [:th {:style "display: none", :class "split"} "Shot %"] [:th {:style "display: none", :class "split"} "Natural Action Goals/Attempts"] [:th {:style "display: none", :class "split"} "Centre Goals/Attempts"] [:th {:style "display: none", :class "split"} "Extraman Goals/Attempts"] [:th {:style "display: none", :class "split"} "7-metres Goals/Attempts"] [:th {:style "display: none", :class "split"} "Penalty Shot Goals/Attempts"] [:th {:style "display: none", :class "split"} "Counter-Attack Goals/Attempts"] [:th {:style "display: none", :class "split"} "Assists"] [:th {:style "display: none", :class "split"} "Turnover Fouls"] [:th {:style "display: none", :class "split"} "Steals"] [:th {:style "display: none", :class "split"} "Blocks"] [:th {:style "display: none", :class "split"} "Exclusion (20 seconds) (Centre/Field)"] [:th {:style "display: none", :class "split"} "Penalty Fouls"] [:th {:style "display: none", :class "split"} "Exclusion (w/wo Sub)"] [:th {:style "display: none", :class "split"} "Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {:class "accordion-toggle", :data-toggle "collapse", :data-target ".team-members-576236"} [:div {:class "glyphicon glyphicon-plus"}]] [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "Hungary"] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"]] 