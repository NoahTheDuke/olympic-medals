tion {:value "1410"} "Giant Slalom, Men"] "\n" [:option {:value "1413"} "Slalom, Men"] "\n" [:option {:value "1416"} "Combined, Men"] "\n" [:option {:value "1421"} "Downhill, Women"] "\n" [:option {:value "1422"} "Super G, Women"] "\n" [:option {:value "1423"} "Giant Slalom, Women"] "\n" [:option {:value "1426"} "Slalom, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1171"} "1936"] "\n" [:option {:value "1189"} "1948"] "\n" [:option {:value "1377"} "1988"] "\n" [:option {:value "1403"} "1992"] "\n" [:option {:value "1455"} "1998"] "\n" [:option {:value "1482"} "2002"] "\n" [:option {:value "1510"} "2006"] "\n" [:option {:value "924561"} "2010"] "\n" [:option {:value "350019"} "2014"] "\n" [:option {:value "9000119"} "2018"] "\n" [:option {:value "19019519"} "2022"] "\n" [:option {:value "15000019"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/38"} "Event type"]] [:h1 {:class "event_title"} "Combined, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "20 – 21 February 1994"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/61"} "Hafjell Alpinsenter, Øyer"] " / " [:a {:href "/venues/62"} "Kvitfjell Alpinsenter, Ringebu"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1429"} "41 from 20 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "One downhill run and two slalom runs, total time determined placement."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Gates: 35" [:br {}] "Length: 2418 m" [:br {}] "Start Altitude: 823 m" [:br {}] "Vertical Drop: 641 m"]]]] [:div {:class "description"} [:p {} "As with the men, a change occurred in the format of the combined, with the placements determined by total time in the downhill and the two slalom runs. Previously, scoring had been by a point system based on the times of the skiers. The new system favored slalom skiers, as long as they could place reasonably well in the downhill. In the combined downhill, the first three finishers were " [:a {:href "/athletes/82343"} "Katja Seizinger"] ", " [:a {:href "/athletes/82474"} "Picabo Street"] ", and " [:a {:href "/athletes/81551"} "Isolde Kostner"] ", who had finished 1-2-3 the day before in the open downhill. But all three were power skiers and only Street would finish the slalom, placing 14th in that section and 10th overall. The first slalom run was won by Sweden’s " [:a {:href "/athletes/83038"} "Pernilla Wiberg"] ", with Swiss " [:a {:href "/athletes/82306"} "Vreni Schneider"] " second. Schneider turned the tables on the second run, narrowly defeating Wiberg, but Wiberg hung on for the gold medal, the silver going to Schneider. The bronze medalist was Slovenian " [:a {:href "/athletes/80966"} "Alenka Dovžan"] ", the first Olympic medal for Slovenia as an independent nation."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Downhill"] [:th {} "Slalom"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/83038"} "Pernilla Wiberg"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "3:05.16"] [:td {} "1:28.70 (5)"] [:td {} "1:36.46 (2)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "17"] [:td {} [:a {:href "/athletes/82306"} "Vreni Schneider"]] [:td 