"} "1924"] "\n" [:option {:value "57843"} "1928"] "\n" [:option {:value "58080"} "1932"] "\n" [:option {:value "58376"} "1936"] "\n" [:option {:value "59089"} "1952"] "\n" [:option {:value "59475"} "1956"] "\n" [:option {:value "59906"} "1960"] "\n" [:option {:value "60318"} "1964"] "\n" [:option {:value "60814"} "1968"] "\n" [:option {:value "61311"} "1972"] "\n" [:option {:value "61885"} "1976"] "\n" [:option {:value "62432"} "1980"] "\n" [:option {:value "62947"} "1984"] "\n" [:option {:value "63590"} "1988"] "\n" [:option {:value "64272"} "1992"] "\n" [:option {:value "64951"} "1996"] "\n" [:option {:value "65610"} "2000"] "\n" [:option {:value "66290"} "2004"] "\n" [:option {:value "257423"} "2008"] "\n" [:option {:value "302536"} "2012"] "\n" [:option {:value "358863"} "2016"] "\n" [:option {:value "19000594"} "2020"] "\n" [:option {:value "2013751"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/93"} "Event type"]] [:h1 {:class "event_title"} "Decathlon, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "5 –  6 August 1948"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/339"} "Empire Stadium, Wembley, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/58715"} "35 from 20 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Scoring by 1934 point tables."]]]] [:div {:class "description"} [:p {} "The level of athletics competition after World War II was down somewhat, as would be expected. The 1948 Olympic decathlon was also affected by the absence of the man who was likely the best in the world in the late 40’s – " [:a {:href "/athletes/1800223"} "Heino Lipp"] ". Lipp was Estonian but his country had been annexed by the Soviet Union and, since the USSR did not compete in the Olympics until " [:a {:href "/editions/13"} "1952"] ", he could not compete at London. In addition, Lipp was labeled by Soviet authorities as a risk to defect, and it is likely he would not have been allowed to travel, even if the USSR had sent a team to London. In Lipp’s absence, the favorite was probably the Frenchman " [:a {:href "/athletes/68290"} "Ignace Heinrich"] ". The 1948 AAU/Olympic Trials champion had been " [:a {:href "/athletes/78742"} "Bob Mathias"] ", a 17-year-old who had competed in his first decathlon only two weeks before the AAU Meet. He had defeated " [:a {:href "/athletes/79043"} "Floyd “Chunk” Simmons"] " and " [:a {:href "/athletes/78802"} "Irving “Moon” Mondschein"] ", who had been 1-2 at the 1947 AAUs, but Mathias was thought to be too young to contend for the gold medal in London."] "\n\n" [:p {} "The Argentine " [:a {:href "/athletes/64435"} "Enrique Kistenmacher"] " led after the first day, with Heinrich second. The second day had miserable conditions, with cold, rainy weather present throughout. Mathias took the lead after the discus throw, although in that event, officials had lost the marker on his best throw, and he likely lost several feet, and points, because of that. He held on to win the event from there, with Heinrich placing second when he outran Simmons in the 1,500. Thru 2024, Mathias remains the youngest man to have won an individual Olympic gold medal in track &amp; field athletics. Though Heino Lipp was never able to compete at the Olympics, when Estonia returned to the Olympics at Barcelona, in 1992, he was chosen as the " [:a {:href "/flagbearers?edition_id=23"} "Estonian flag bearer"] " at the Opening Ceremony."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Points (1952 Tables)"] [:th {} "Points (1962 Tables)"] [:th {} "Points (1985 Hand Tables)"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "615"] [:td