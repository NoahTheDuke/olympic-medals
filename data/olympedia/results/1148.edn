"/events/1148"} "35 from 13 countries"]]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/1119"} "1:54.02"] " " [:span {:class "label label-primary"} "WR"] " / " [:a {:href "/athletes/99411"} "Anni Friesinger"] " " [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"] " / 20 February 2002 / " [:a {:href "/records/event_name/539"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003386"} "Marcel Lesche Vanberg"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/87337"} "Dan Immerfall"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]]]] [:div {:class "description"} [:p {} "Based on performances from the last two years, two women were assumed to fight it out for the Olympic 1500 m: " [:a {:href "/athletes/100967"} "Cindy Klassen"] " and " [:a {:href "/athletes/99411"} "Anni Friesinger"] ". Friesinger, the defending Olympic Champion, had won the world title in 2001, 2003 and 2004 and was runner-up in 2005. She had also taken the 1500 m World Cup in 2003. Klassen had taken the World Cup in 2004 and 2005, also winning the 2005 World Championships. In 2005, the women had been exchanging the World Record set by Friesinger during her Olympic victory in 2002. First bettered by Klassen in January, she again lowered it in October, only to be beaten by Friesinger a week later. At the World Cup in Salt Lake City, Klassen then took it back, setting a staggering 1:51.79."] "\n\n" [:p {} "Interestingly, the two top contenders were drawn in the same pair. At the time they took to the ice, the leading time had been set by " [:a {:href "/athletes/100968"} "Kristina Groves"] " of Canada, 1:56.74, better than Friesinger’s pre-Games rink record. Klassen took off with an insane pace, leaving Friesinger well behind. She managed to come back a little in the first full lap, but this effort cost her too much, and she had to let Klassen go. The Canadian finished almost 1½ seconds ahead of the leading time with 1:55.27, while beating Friesinger by a full two seconds. In the final pair, 3000 m winner " [:a {:href "/athletes/109767"} "Ireen Wüst"] " managed to edge ahead of Friesinger for a bronze medal, leaving Klassen and Groves a 1-2 Canadian victory."] "\n"] [:button {:id "button191821", :class "btn btn-default"} "Details"] [:script {} "$('#button191821').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "300 m"] [:th {:style "display: none", :class "split"} "700 m"] [:th {:style "display: none", :class "split"} "1100 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "17O"] [:td {} [:a {:href "/athletes/100967"} "Cindy Klassen"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {} "1:55.27"] [:td {:class "split", :style "display: none"} "25.42"] [:td {:class "split", :style "display: none"} "53.83"] [:td {:class "split", :style "display: none"} "1:23.50"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "15O"] [:td {} [:a {:href "/athletes/100968"} "Kristina Groves"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vert