a {:href "/athletes/103316"} "Reiko Nakamura"] " repeating her performance of 2004 by claiming third place. Coventry, who had been world champion in 2005, regained her world title in 2009."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/94046"} "Kirsty Coventry"]] [:td {} [:a {:href "/countries/ZIM"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ZIM.png"}] "ZIM"]] [:td {} "2:06.76 (1 h4)"] [:td {} "2:07.76 (1 h2)"] [:td {} "2:05.24 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/103919"} "Margaret Hoelzer"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "2:09.12 (3 h5)"] [:td {} "2:08.25 (3 h2)"] [:td {} "2:06.23 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/103316"} "Reiko Nakamura"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]] [:td {} "2:09.77 (4 h5)"] [:td {} "2:08.21 (2 h1)"] [:td {} "2:07.13 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/115651"} "Anastasiya Zuyeva"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]] [:td {} "2:09.01 (2 h3)"] [:td {} "2:09.07 (5 h2)"] [:td {} "2:07.88 (4)"] [:td {}] [:td {}] 