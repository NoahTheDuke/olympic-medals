 "19019631"} "12.5 kilometres Pursuit, Men"] "\n" [:option {:value "19019633"} "20 kilometres, Men"] "\n" [:option {:value "19019634"} "4 × 7.5 kilometres Relay, Men"] "\n" [:option {:value "19019635"} "7.5 kilometres Sprint, Women"] "\n" [:option {:value "19019636"} "10 kilometres Pursuit, Women"] "\n" [:option {:value "19019637"} "12.5 kilometres Mass Start, Women"] "\n" [:option {:value "19019638"} "15 kilometres, Women"] "\n" [:option {:value "19019639"} "4 × 6 kilometres Relay, Women"] "\n" [:option {:value "19019640"} "4 × 6 kilometres Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1602"} "2006"] "\n" [:option {:value "923485"} "2010"] "\n" [:option {:value "350024"} "2014"] "\n" [:option {:value "9000222"} "2018"] "\n" [:option {:value "15000032"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/130"} "Event type"]] [:h1 {:class "event_title"} "15 kilometres Mass Start, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "18 February 2022 — 17:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2138"} "Zhangjiakou Nordic Centre and Biathlon Centre, Chongli District, Zhangjiakou City, Hebei Province"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19019632"} "30 from 13 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Penalty loop (150 metres) skied for each missed target."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 15,220 m" [:br {}] "Height Differential: 52 m" [:br {}] "Maximum Climb: 21 m" [:br {}] "Shooting 1: Prone at 2.411 km, 50 m range" [:br {}] "Shooting 2: Prone at 5.087 km, 50 m range" [:br {}] "Shooting 3: Standing at 7.763 km, 50 m range" [:br {}] "Shooting 4: Standing at 10.439 km, 50 m range" [:br {}] "Total Climbing: 560 m"]]]] [:div {:class "description"} [:p {} "The biathlon competitions at the Beijing Winter Olympics ended with the men’s mass start at a temperature of -17.4 degrees. Just two hours after the women’s event, Norway’s " [:a {:href "/athletes/128188"} "Johannes Thingnes Bø"] " dominated the race and won gold in 38:14.4 ahead of Sweden’s " [:a {:href "/athletes/138153"} "Martin Ponsiluoma"] " (+40.3 seconds). Bronze went to Bø’s team-mate " [:a {:href "/athletes/148695"} "Vetle Sjåstad Christiansen"] " (+1:12.5) in extremely difficult wind conditions. Bø became the first Norwegian athlete to claim five medals at a single Olympic Winter Games."] "\n\n" [:p {} "Bø was leading the pack from the second shooting. Although the eventual silver medallist Ponsiluoma only had to go two penalty loops, he lost to Bø with a significantly slower skiing time. Christiansen came from behind and entered the medal ranks thanks to a flawless last shooting."] "\n\n" [:p {} [:a {:href "/athletes/137167"} "Quentin Fillon Maillet"] " was in reach of a medal thanks to his excellent skiing performance, but was blown away by sudden gusts of wind resulting in three penalty loops. The same happened to " [:a {:href "/athletes/137248"} "Benedikt Doll"] ", " [:a {:href "/athletes/138154"} "Sebastian Samuelsson"] ", and " [:a {:href "/athletes/136823"} "Christian Gow"] " when the wind picked up again and all three dropped out of the top six."] "\n\n" [:p {} "Bronze medallist Christiansen won his first ever individual medal at the Winter Olympic Games or World Championships, having previously won gold in the relay at Beijing and three gold and one silver in relays at World Championships. With Bø and Christiansen, Norway repeated the women’s achievement with two athletes on the podium. It was the first time ever in this event that two athletes from one NOC had entered the podium."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Misses"] [:th {} "Shooting 1 Misses"] [:th {} "Shooting 1"] [:th {} "Shooting 2 Misses"] [:th {} "Shooting 2"] [:th {} "Shooting 3 Misses"] [:th {} "Shooting 3"] [:th {} "Shooting 4 Misses"] [:th {} "Shooting 4"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/128188"} "Johannes Thingnes Bø"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "38:14.4"] [:td {} "4"] [:td {} "1"] [:td {} "7:51.7 (8)"] [:td {} "0"] [:td {} "15:29.8 (1)"] [:td {} "1"] [:td {} "23:21.5 (1)"] [:td {} "2"] [:td {} "31:25.4 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/138153"} "Martin Ponsiluoma"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "38:54.7"] [:td {} "2"] [:td {} "1"] [:td {} "7:56.3 (14)"] [:td {} "0"] [:td {} "15:42.0 (6)"] [:td {} "0"] [:td {} "23:27.5 (2)"] [:td {} "1"] [:td {} "31:43.2 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/148695"} "Vetle Sjåstad Christiansen"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "39:26.9"] [:td {} "3"] [:td {} "2"] [:td {} "8:21.1 (25)"] [:td {} "0"] [:td {} "16:10.1 (11)"] [:td {} "1"] [:td {} "24:12.5 (7)"] [:td {} "0"] [:td {} "32:10.7 (3)"] [:td {} [:span {:class "Bronze"}