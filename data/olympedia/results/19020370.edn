n.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1"} "1928"] "\n" [:option {:value "6"} "1948"] "\n" [:option {:value "17"} "2002"] "\n" [:option {:value "23"} "2006"] "\n" [:option {:value "924600"} "2010"] "\n" [:option {:value "350433"} "2014"] "\n" [:option {:value "9000790"} "2018"] "\n" [:option {:value "15000850"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/516"} "Event type"]] [:h1 {:class "event_title"} "Skeleton, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "10 – 11 February 2022"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2144"} "Yanqing National Sliding Centre, West Dazhuangke, Zhangshanying, Yanqing District"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19020370"} "25 from 15 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Four runs, total time determined placement. Top 20 after three runs qualified for final run."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Curves: 16" [:br {}] "Length: 1,615 m" [:br {}] "Start Altitude: 1,017 m" [:br {}] "Vertical Drop: 121 m"]]]] [:div {:class "description"} [:p {} "Germany took the top two positions in the men’s skeleton at the National Sliding Centre, but it was the bronze medallist who stole the limelight."] "\n\n" [:p {} "Germany’s " [:a {:href "/athletes/137322"} "Christopher Grotheer"] " lived up to his billing as champion at the last two world championships to take gold in a combined time of 4:01.01 while teammate " [:a {:href "/athletes/137323"} "Axel Jungk"] " won silver in 4:01.67."] "\n\n" [:p {} "China, a relative novice in the sport compared to sliding powerhouse Germany, took bronze. " [:a {:href "/athletes/148122"} "Yan Wengang"] "’s time of 4:01.77 meant he took the bronze medal ahead of a field that contained multiple Olympic medallists and world champions. The bronze was China’s first medal in any sliding sport, and only the second time that a man from outside Europe or North America won an Olympic skeleton medal."] "\n\n" [:p {} "Teammate " [:a {:href "/athletes/148123"} "Yin Zheng"] " also impressed with a fifth-place finish, and ended the Games as the start record holder on the Yanqing track. Six-time world champion " [:a {:href "/athletes/111080"} "Martins Dukurs"] ", who was chasing an elusive Olympic gold, finished a disappointing seventh."] "\n\n" [:p {} "Grotheer agreed that China was an up-and-coming force in skeleton, with the women also having posted creditable results after two runs. " [:a {:href "/athletes/140093"} "Zhao Dan"] " was fourth going into Heat 3. Germany, which was so strong in the sliding sports of bobsleigh and luge, finally won its first medal in men’s skeleton when\n" [:a {:href "/athletes/137322"} "Christopher Grotheer"] " and " [:a {:href "/athletes/137323"} "Axel Jungk"] " finished 1-2 for gold and silver."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Run #1"] [:th {} "Run #2"] [:th {} "Run #3"] [:th {} "Run #4"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/137322"} "Christopher Grotheer"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "4:01.01"] [:td {} "1:00.00 (1)"] [:td {} "1:00.33 (1)"] [:td {} "1:00.16 (1)"] [:td {} "1:00.52 (6)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/137323"} "Axel Jungk"]]