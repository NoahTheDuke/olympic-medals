e "22014"} "Bantamweight (≤118 pounds), Men"] "\n" [:option {:value "22075"} "Lightweight (≤135 pounds), Men"] "\n" [:option {:value "22107"} "Welterweight (≤147 pounds), Men"] "\n" [:option {:value "22138"} "Middleweight (≤160 pounds), Men"] "\n" [:option {:value "22163"} "Light-Heavyweight (≤175 pounds), Men"] "\n" [:option {:value "22191"} "Heavyweight (&gt;175 pounds), Men"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "21204"} "1904"] "\n" [:option {:value "21237"} "1908"] "\n" [:option {:value "21324"} "1920"] "\n" [:option {:value "21492"} "1924"] "\n" [:option {:value "21719"} "1928"] "\n" [:option {:value "21892"} "1932"] "\n" [:option {:value "22282"} "1948"] "\n" [:option {:value "22529"} "1952"] "\n" [:option {:value "22816"} "1956"] "\n" [:option {:value "23053"} "1960"] "\n" [:option {:value "23382"} "1964"] "\n" [:option {:value "23737"} "1968"] "\n" [:option {:value "24125"} "1972"] "\n" [:option {:value "24540"} "1976"] "\n" [:option {:value "24921"} "1980"] "\n" [:option {:value "25263"} "1984"] "\n" [:option {:value "25725"} "1988"] "\n" [:option {:value "26200"} "1992"] "\n" [:option {:value "26644"} "1996"] "\n" [:option {:value "27085"} "2000"] "\n" [:option {:value "27483"} "2004"] "\n" [:option {:value "258310"} "2008"] "\n" [:option {:value "19005637"} "2020"] "\n" [:option {:value "2000987"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/147"} "Event type"]] [:h1 {:class "event_title"} "Featherweight (≤126 pounds), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "11 – 15 August 1936"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/316"} "Deutschlandhalle, Berlin"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/22044"} "24 from 24 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single elimination tournament."]]]] [:div {:class "description"} [:p {} "Two names missing from the competition were the top rated American " [:a {:href "/athletes/1005550"} "Joe Church"] ", sent home from Berlin by the US boxing team management for disciplinary reasons, and Otto Kästner, the European champion who had been supplanted in the German team by " [:a {:href "/athletes/3629"} "Josef Miner"] ". Miner was considered one of the best fighters in the division, along with " [:a {:href "/athletes/7964"} "Charlie Catterall"] " of South Africa, who was the British Empire Games champion, and " [:a {:href "/athletes/3798"} "Dezső Frigyes"] " of Hungary."] "\n\n" [:p {} "The only stoppage of the first series was that of " [:a {:href "/athletes/7652"} "Felipe Gabuco"] " of the Phillipines, carried out by the “replacement” US boxer " [:a {:href "/athletes/8707"} "Ted Kara"] " in the most impressive display of the early rounds. Kara was not to fight for a medal, as he fell victim to the tricky Catterall in the quarter-finals. " [:a {:href "/athletes/3320"} "Óscar Casanovas"] " of Argentina came to notice when he defeated future European champion " [:a {:href "/athletes/7764"} "Aleksander Polus"] " of Poland with ease in the last eight, and he followed this up with another impressive victory against the talented Hungarian Frigyes in the semi-finals. The South African Catterall built upon his reputation with a victory over the home boxer Miner, in front of an excited Berlin crowd, and guaranteed what was to be South Africa’s only medal of the Games."] "\n\n" [:p {} "The final produced a clash of styles, the Argentine edging to victory with a late flourish, landing a series of hooks on his opponent. Although this continued the run of Argentine boxing victories that had started in " [:a {:href "/editions/9/sports/BOX"} "1928"] ", the Argentine team themselves were disappointed with only a single gold medal."] "\n\n" [:p {} "Catterall later became a South African professional champion, whilst Miner was a victim of World War II."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/3320"} "Óscar Casanovas"]] [:td {} [:a {:href "/countries/ARG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ARG.png"}] "ARG"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/7964"} "Charlie Catterall"]] [:td {} [:a {:href "/countries/RSA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RSA.png"}] "RSA"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/3629"} "Josef Miner"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/3798"} "Dezső Frigyes"]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"]] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=5"] [:td {} [:a {:href "/athletes/1209"} "Billy Marquart"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.