n: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UNK.png"}] "UNK"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Judge / Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004830"} "W. Than Yin"]] [:td {} [:a {:href "/countries/UNK"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UNK.png"}] "UNK"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Judge / Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004831"} "W. Van Eecken"]] [:td {} [:a {:href "/countries/BEL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BEL.png"}] "BEL"]]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/100851"} "Arnoldo Parés"] " of Argentina was considered by many as the favorite, having lost just five of his 195 amateur bouts. Future world professional champion " [:a {:href "/athletes/8003"} "Vic Toweel"] " of South Africa lost to Parés in the opening match, but Parés was not to match the achievements of his " [:a {:href "/results/22214"} "flyweight"] " and " [:a {:href "/results/22445"} "heavyweight"] " teammates and was defeated by Australia’s " [:a {:href "/athletes/5035"} "Jimmy Carruthers"] " in the second round. Carruthers was unfortunate to sustain an eye injury in that match and had to withdraw from the tournament."] "\n\n" [:p {} "The beneficiary of Carruthers’ misfortune was the Hungarian boxer " [:a {:href "/athletes/3788"} "Tibor Csík"] ", and he proved able to maximize his opportunity. The Hungarian used his speed and mobility to outscore Italy’s " [:a {:href "/athletes/4193"} "Gianni Zuddas"] " in the final."] "\n\n" [:p {} "Csík left Hungary and lived in Australia until his death in 1976. " [:a {:href "/athletes/7875"} "Juan Venegas"] " became the first Puerto Rican to stand on the Olympic podium when he defeated his Spanish opponent in the bronze medal match."] "\n\n" [:p {} "In 1950, Vic Toweel became the first South African to hold a universally recognized World professional title after defeating Manuel Ortiz. After four defenses, he lost to Jimmy Carruthers on a first round knockout, in a bout refereed by " [:a {:href "/results/21465"} "1924 Olympic bantamweight"] " champion " [:a {:href "/athletes/7998"} "Willie Smith"] ". Carruthers had an unusual ally helping him to weigh inside the bantamweight limit – after his retirement, he was found to have been carrying a 30 foot long tapeworm inside him."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/3788"} "Tibor Csík"]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/4193"} "Gianni Zuddas"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/7875"} "Juan Venegas"]] [:td {} [:a {:href "/countries/PUR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/PUR.png"}] "PUR"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/2895"} "Álvaro Vicente"]] [:td {} [:a {:href "/countries/ESP"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ESP.png"}] "E