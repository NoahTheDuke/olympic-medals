/5003190"} "Laura McNair"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #8"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002178"} "Gale Tanger"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #9"] [:td {:style "width: 400px"} [:a {:href "/athletes/5005009"} "Zsofia Wagner"]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #10"] [:td {:style "width: 400px"} [:a {:href "/athletes/5003036"} "Katarina Henriksson"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #11"] [:td {:style "width: 400px"} [:a {:href "/athletes/5004974"} "Yuriy Kliushnykov"]] [:td {} [:a {:href "/countries/UKR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UKR.png"}] "UKR"]]] [:tr {:class "referees", :style ""} [:th {} "Judge #12"] [:td {:style "width: 400px"} [:a {:href "/athletes/5001925"} "Elisabeth Louesdon"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]]]]] [:div {:class "description"} [:p {} "The skater with the most talent was easy – " [:a {:href "/athletes/101843"} "Sasha Cohen"] " (USA), who had been runner-up at the 2004-05 Worlds. But she had a nasty habit of skating poorly under pressure situations and dropping out of the lead. The skater with the best pedigree was the 2002 silver medalist, " [:a {:href "/athletes/100125"} "Irina Slutskaya"] " (RUS), who had been World Champion in 2002 and 2005, and shortly before Torino, had won her seventh European title, bettering the record of " [:a {:href "/athletes/83053"} "Katarina Witt"] " and " [:a {:href "/athletes/81280"} "Sonja Henie"] " , who had won six Europeans. Another contender was Japan’s " [:a {:href "/athletes/100131"} "Shizuka Arakawa"] ", who was World Champion in 2004, but she had not skated well in the early 2005-06 season. Cohen won the short program, but her lead was almost non-existent. She scored 66.73 to 66.70 for Slutskaya and 66.02 for Arakawa. In the free skate, Cohen skated well, not succumbing to her personal demons, and bettered Slutskaya, who had skated earlier, 116.63 to 114.74. Arakawa was the last skater on the ice, and she skated superbly, scoring 125.32 to win the gold medal, the first ever by an Asian figure skater, and again deny Cohen a major international title, with Slutskaya winning the bronze. Both Cohen and Slutskaya had problems with falls, Slutskaya in the free program, and Cohen in the short."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Short Program"] [:th {} "Free Skating"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/100131"} "Shizuka Arakawa"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JPN.png"}] "JPN"]] [:td {} "191.34"] [:td {} "66.02 (3)"] [:td {} "125.32 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/101843"} "Sasha Cohen"]] [:td {} [:a {:href "/countries/USA"} [:img {