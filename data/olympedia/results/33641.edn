"} "1900"] "\n" [:option {:value "33505"} "1904"] "\n" [:option {:value "33511"} "1906"] "\n" [:option {:value "33519"} "1908"] "\n" [:option {:value "33530"} "1912"] "\n" [:option {:value "33556"} "1920"] "\n" [:option {:value "33584"} "1924"] "\n" [:option {:value "33615"} "1928"] "\n" [:option {:value "33663"} "1948"] "\n" [:option {:value "33688"} "1952"] "\n" [:option {:value "33721"} "1956"] "\n" [:option {:value "33739"} "1960"] "\n" [:option {:value "33775"} "1964"] "\n" [:option {:value "33814"} "1968"] "\n" [:option {:value "33855"} "1972"] "\n" [:option {:value "33902"} "1976"] "\n" [:option {:value "33934"} "1980"] "\n" [:option {:value "33975"} "1984"] "\n" [:option {:value "34016"} "1988"] "\n" [:option {:value "34057"} "1992"] "\n" [:option {:value "34098"} "1996"] "\n" [:option {:value "34161"} "2000"] "\n" [:option {:value "34224"} "2004"] "\n" [:option {:value "259883"} "2008"] "\n" [:option {:value "312000"} "2012"] "\n" [:option {:value "359500"} "2016"] "\n" [:option {:value "19012000"} "2020"] "\n" [:option {:value "2002380"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/303"} "Event type"]] [:h1 {:class "event_title"} "Football, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "3 – 15 August 1936"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/314"} "Olympiastadion, Reichssportfeld, Berlin"] " / " [:a {:href "/venues/325"} "Mommsenstadion, Berlin"] " / " [:a {:href "/venues/326"} "Poststadion, Berlin"] " / " [:a {:href "/venues/327"} "Hertha-BSC-Platz, Berlin"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/33641"} "201 from 16 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament."]]]] [:div {:class "description"} [:p {} "Already before the " [:a {:href "/results/33615"} "1928 Olympics"] ", " [:a {:href "/organizations/7"} "FIFA"] " and the " [:a {:href "/organizations/1"} "IOC"] " had been in conflict over amateur rules. When FIFA allowed professional players to compete at the inaugural World Cup in 1930, football was scratched as an Olympic sport by the IOC Executive committee. It was reinstated for 1936, but amateur rules were enforced. Players were not allowed to receive any compensation, including wage compensation paid to their employers. This ruling caused several European countries to withdraw their entries, and most South American teams forfeited as well."] "\n\n" [:p {} "A major surprise occurred in the first round of the tournament, when medal favorite Sweden was eliminated by Japan, despite leading 2-0 at half-time. Another Scandinavian team, Norway, caused a surprise by eliminating the home team in the quarter-finals. The match was attended by German chancellor " [:a {:href "/athletes/1100010"} "Adolf Hitler"] ", who reportedly left the stadium in anger after the German loss. Norway eventually held on for third place."] "\n\n" [:p {} "The most notable match, however, was another quarter- final, Peru v Austria. The match saw Peru come from 0-2 behind to win the match 4-2 after extra time. However, the contest was marred by rough play from both sides and, in overtime, several Peruvian spectators stormed the field and held the Austrian players. Because of this, Austria filed a protest, which was upheld by the jury of appeal. A replay was ordered, but Peru failed to show up for that match, with Austria advancing by forfeit. Back in Lima, the decision to replay the match caused riots at the German and Austrian embassies."] "\n\n" [:p {} "The Austrians reached the final, in which they played Italy. Italy was the reigning World Champion, but all of the 1934 players were professionals and not allowed to play in Berlin. As in 1928, the final score was 1-1 after 90 minutes. Italy scored quickly in overtime, and the exhausted Austrians were unable to crack their opponent’s defense in the remaining minutes. Three players would also play on the Italian squad that won the 1938 World Cup: " [:a {:href "/athletes/26050"} "Alfredo Foni"] ", " [:a {:href "/athletes/26069"} "Ugo Locatelli"] ", and " [:a {:href "/athletes/26108"} "Pietro Rava"] "."] "\n"] [:button {:id "button538063", :class "btn btn-default"} "Details"] [:script {} "$('#button538063').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {}] [:th {} "Pos"] [:th {} "Number"] [:th {} "Team"] [:th {} "NOC"] [:th {:style "display: none", :class "split"} "Goals"] [:th {:style "display: none", :class "split"} "Yellow Cards"] [:th {:style "display: none", :class "split"} "Red Cards"] [:th {:style "display: none", :class "split"} "Penalty Kicks"] [:th {:style "display: none", :class "split"} "Shots"] [:th {:style "display: none", :class "split"} "Shots on Goal"] [:th {:style "display: none", :class "split"} "Corner Kicks"] [:th {:style "display: none", :class "split"} "Free Kicks"] [:th {:style "display: none", :class "split"} "Offsides"] [:th {:style "display: none", :class "split"} "Fouls Committed"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {:class "accordion-toggle", :data-toggle "collapse", :data-target ".team-members-473461"} [:div {:class "glyphicon glyphicon-plus"}]] [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "Italy"] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {:class "split", :style "display: none"} "13"] [:td {:class "split", :style "display: none"} "2"] [:td {:class "split", :style "display: none"} "0"] [:td {:class "split", :style "display: none"} "–"] [:td {:class "split", :style "display: none"} "–"] [:td {:class "split", :style "display: none"} "–"] [:td {:class "split", :style "display: none"} "–"] [:td {:class "split", :style "display: none"} 