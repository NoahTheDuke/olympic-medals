dividual, Men"] "\n" [:option {:value "9000766"} "Team, Men"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "923615"} "2010"] "\n" [:option {:value "350424"} "2014"] "\n" [:option {:value "19020350"} "2022"] "\n" [:option {:value "15000830"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/741"} "Event type"]] [:h1 {:class "event_title"} "Normal Hill / 10 km, Individual, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "14 February 2018"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/937"} "Alpensia Cross-Country Centre, Alpensia Resort, Mountain Cluster, Daegwallyeong"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/9000760"} "48 from 16 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Normal hill ski jumping and 10 kilometres skiing. Pursuit-style cross-country race, with skiers leaving in order of their finish in the ski jumping, so that final placement determined by final placement in cross-country ski race."]]]] [:div {:class "description"} [:p {} "The normal hill was expected to be dominated by two Germans, " [:a {:href "/athletes/119468"} "Eric Frenzel"] " and " [:a {:href "/athletes/119470"} "Johannes Rydzek"] ", with other contenders felt to be France’s " [:a {:href "/athletes/109612"} "Jason Lamy-Chappuis"] " and Japan’s " [:a {:href "/athletes/110874"} "Akito Watabe"] ". Frenzel had won the last five overall World Cup titles, and was the defending gold medalist, while Rydzek had won four gold medals at the 2017 World Championships, and also won this event at the 2015 Worlds."] "\n\n" [:p {} "Rydzek performed poorly on the normal hill, finishing only 11th. The phase was won by Austrian " [:a {:href "/athletes/136738"} "Franz-Josef Rehrl"] ", who was not expected to contend in the skiing phase. Watabe was third after the ski jump, and Frenzel fifth, still very much in contention, with Norwegian " [:a {:href "/athletes/137749"} "Jarl Magnus Riiber"] " in second place."] "\n\n" [:p {} "Among the contenders, Rydzek had the best ski time, placing third behind Italy’s " [:a {:href "/athletes/109591"} "Alessandro Pittin"] ", who finished only 19th overall due to his poor jumping – 38th of 48 competitors. Frenzel was sixth in the ski phase, but distanced Watabe to defend his gold by 4.8 seconds. Austrian " [:a {:href "/athletes/127372"} "Lukas Klapfer"] " had been fourth in jumping but out-skiied Riiber by 21.4 seconds to take the bronze medal."] "\n\n" [:p {} "Frenzel would win team gold and a bronze on the large hill event in PyeongChang to give him six medals and three golds in Nordic combined at three Winter Olympics. Rydzek would come back to win the large hill event and with Frenzel, help Germany to a comfortable win in the team event."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time Margin"] [:th {} "Ski Jumping, Normal Hill"] [:th {} "Cross Country Skiing, 10 km"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/119468"} "Eric Frenzel"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "24:51.4"] [:td {} "121.7 (5)"] [:td {} "24:51.4 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/110874"} "Akito Watabe"]] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-righ