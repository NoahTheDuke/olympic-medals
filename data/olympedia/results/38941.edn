location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "900026"} "1920"] "\n" [:option {:value "39019"} "2004"] "\n" [:option {:value "262970"} "2008"] "\n" [:option {:value "330051"} "2012"] "\n" [:option {:value "396351"} "2016"] "\n" [:option {:value "19001631"} "2020"] "\n" [:option {:value "2003151"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/632"} "Event type"]] [:h1 {:class "event_title"} "Water Polo, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "16 – 23 September 2000"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/758"} "Sydney International Aquatic Centre, Olympic Park, Sydney, New South Wales"] " / " [:a {:href "/venues/776"} "Ryde Aquatic Leisure Centre, Ryde, New South Wales"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/38941"} "78 from 6 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Round-robin pools advanced teams to classification matches."]]]] [:div {:class "description"} [:p {} "This was the first ever Olympic water polo tournament for women. The last two World Champions had been Italy (1998) and Hungary (1994), although both Italy and the Netherlands had been on the podium both years, Italy also winning the European title in 1995, 1997, and 1999. But Italy was not one of the six teams in Sydney, having placed fourth at the Olympic Qualifying Tournament. The qualified teams were the host Australians, the top European and American teams from the 1999 World Cup (Netherlands and Canada), the top two from the qualifying tournament (USA and Russia), and the best Asian team from the qualifying tournament (Kazakhstan, which finished sixth)."] "\n\n" [:p {} "The round-robin served to eliminate Canada and Kazakhstan, with Australia winning four of five matches and taking first seed into the semi-finals. After the round-robin every match was close and was decided by only one goal. Australia and the United States eliminated Russia and the Netherlands, 7-6 and 6-5, respectively. The final match saw the USA leading 2-1 at the half. With only 13 seconds left in the match, American " [:a {:href "/athletes/94900"} "Brenda Villa"] " scored to tie the match 3-3, but with only 1.3 seconds remaining Australia’s " [:a {:href "/athletes/94875"} "Yvette Higgins"] " scored after a foul and a free throw-in, giving Australia the gold medal, 4-3."] "\n"] [:button {:id "button446639", :class "btn btn-default"} "Details"] [:script {} "$('#button446639').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {}] [:th {} "Pos"] [:th {} "Number"] [:th {} "Team"] [:th {} "NOC"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Games Played", :class "split", :style "display: none"} "GP"] [:th {:style "display: none", :class "split"} "Goals/Saves"] [:th {:style "display: none", :class "split"} "Attempts"] [:th {:style "display: none", :class "split"} "Shot %"] [:th {:style "display: none", :class "split"} "Natural Action Goals/Attempts"] [:th {:style "display: none", :class "split"} "Centre Goals/Attempts"] [:th {:style "display: none", :class "split"} "Extraman Goals/Attempts"] [:th {:style "display: none", :class "split"} "7-metres Goals/Attempts"] [:th {:style "display: none", :class "split"} "Penalty Shot Goals/Attempts"] [:th {:style "display: none", :class "split"} "Counter-Attack Goals/Attempts"] [:th {:style "display: none", :class "split"} "Assists"] [:th {:style "display: none", :class "split"} "Turnover Fouls"] [:th {:style "display: none", :class "split"} "Steals"] [:th {:style "display: none", :class "split"} "Blocks"] [:th {:style "display