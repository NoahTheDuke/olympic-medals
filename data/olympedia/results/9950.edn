398"} "Frank Hübner"] " and " [:a {:href "/athletes/61391"} "Harro Bode"] ", enabling them to move ahead of the Spanish crew of " [:a {:href "/athletes/62173"} "Antonio Gorostegui"] " and " [:a {:href "/athletes/63022"} "Pedro Millet"] " and win the gold medal. Of the medalists, only Gorostegui would ever compete at the Olympics again and this was his only medal."] "\n\n" [:p {} "The Colombian boat finished 22nd, with " [:a {:href "/athletes/60934"} "Beatriz de Lisocky"] " as the crew member. De Lisocky was the only female to compete in sailing at the 1976 Olympics."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Net Points"] [:th {} "Total Points"] [:th {} "Race #1"] [:th {} "Race #2"] [:th {} "Race #3"] [:th {} "Race #4"] [:th {} "Race #5"] [:th {} "Race #6"] [:th {} "Race #7"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "West Germany"] [:td {} [:a {:href "/countries/FRG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRG.png"}] "FRG"]] [:td {} "42.4"] [:td {} "71.4"] [:td {} ".0 (1)"] [:td {} "11.7 (6)"] [:td {} "19.0 (13)"] [:td {} "11.7 (6)"] [:td {} ".0 (1)"] [:td {} "29.0 (" [:span {:class "label label-primary"} [:abbrev {:title "Yacht Materially Prejudiced"} "YMP"]] ")"] [:td {} ".0 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "17"} [:a {:href "/athletes/62398"} "Frank Hübner"] " • " [:a {:href "/athletes/61391"} "Harro Bode"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Spain"] [:td {} [:a {:href "/countries/ESP"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ESP.png"}] "ESP"]] [:td {} "49.7"] [:td {} "63.7"] [:td {} "8.0 (4)"] [:td {} "14.0 (8)"] [:td {} "3.0 (2)"] [:td {} "10.0 (5)"] [:td {} "5.7 (3)"] [:td {}