9"} "1924"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/142"} "Event type"]] [:h1 {:class "event_title"} "Four/Five, Men" [:small {} [:a {:class "footnote", :href "#", :title "Teams could consist of either 4- or 5-man teams.  Originally planned for 16 and 17 February, but postponed due to poor weather conditions. Eventually only two runs were contested.", :data-toggle "tooltip", :data-placement "right"} "1"]]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "18 February 1928"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/148"} "Olympia Bobrun, St. Moritz / Celerina"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/236"} "116 from 14 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Four runs, total time determined placement. "]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Curves: 17" [:br {}] "Length: 1722 m" [:br {}] "Start Altitude: ?" [:br {}] "Vertical Drop: 130 m"]]]] [:div {:class "description"} [:p {} "Originally, two days of racing were planned, with two heats contested on 16 and 17 February. But warm weather led to a postponement, and eventually only two runs were contested on the 18th. Both runs were won by one of the Americans crews. USA I was steered by " [:a {:href "/athletes/86530"} "Jennison Heaton"] ", the winner of the " [:a {:href "/results/1"} "skeleton race"] ", while the second sled was piloted by 16-year-old " [:a {:href "/athletes/85736"} "Billy Fiske"] ". Three of Fiske’s crewmen had been recruited through a newspaper advertisement, and " [:a {:href "/athletes/98421"} "Nion Tucker"] ", " [:a {:href "/athletes/95211"} "Geoffrey Mason"] " and " [:a {:href "/athletes/96214"} "Dick Parke"] " had no prior bobsleigh experience. Fiske won the first heat, ahead of Belgium’s " [:a {:href "/athletes/89377"} "Ernest Casimir-Lambert"] ", one of the pre-race favorites. Casimir-Lambert’s crew sported two Summer Olympians, fencing silver medalist " [:a {:href "/athletes/21302"} "Léon Tom"] ", and sprinter " [:a {:href "/athletes/65215"} "Max Houben"] ", who would go on to pilot bobsleds himself and win a " [:a {:href "/results/274"} "silver medal in 1948"] ". However, the Belgians made a major error in the second run and dropped to sixth."] "\n\n" [:p {} "Fiske’s final descent was also slower than his first, but Heaton’s fastest time of the day was not enough for a gold medal. " [:a {:href "/athletes/87930"} "Hanns Kilian"] "’s bronze medal was Germany’s first Olympic podium since the First World War, having been excluded in " [:a {:href "/editions/7"} "1920"] " and 1924. The two Argentine bobs were the surprise of the competition."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Run #1"] [:th {} "Run #2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "United States 2"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "3:20.5"] [:td {} "1:38.9 (1)"] [:td {} "1:41.6 (5)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "11"} [:a {:href "/athletes/85736"} "Billy Fiske"] " • " [:a {:href "/athletes/98421"} "Nion Tucker"] " • " [:a {:href "/athletes/95211"} "Geoffrey Mason"] " • " [:a {:href "/athletes/86222"} "Clifford Gray"] " • " [:a {:href "/athletes/96214"} "Dick Parke"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "United States 1"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "3:21.0"] [:td {} "1:42.3 (=8)"] [:td {} "1:38.7 (1)"