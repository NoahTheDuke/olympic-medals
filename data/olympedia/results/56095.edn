60"} "1928"] "\n" [:option {:value "58031"} "1932"] "\n" [:option {:value "58303"} "1936"] "\n" [:option {:value "58634"} "1948"] "\n" [:option {:value "59008"} "1952"] "\n" [:option {:value "59390"} "1956"] "\n" [:option {:value "59789"} "1960"] "\n" [:option {:value "60226"} "1964"] "\n" [:option {:value "60678"} "1968"] "\n" [:option {:value "61188"} "1972"] "\n" [:option {:value "61763"} "1976"] "\n" [:option {:value "62325"} "1980"] "\n" [:option {:value "62818"} "1984"] "\n" [:option {:value "63462"} "1988"] "\n" [:option {:value "64137"} "1992"] "\n" [:option {:value "64828"} "1996"] "\n" [:option {:value "65488"} "2000"] "\n" [:option {:value "66164"} "2004"] "\n" [:option {:value "257298"} "2008"] "\n" [:option {:value "302440"} "2012"] "\n" [:option {:value "358704"} "2016"] "\n" [:option {:value "19000487"} "2020"] "\n" [:option {:value "2013644"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/75"} "Event type"]] [:h1 {:class "event_title"} "Pole Vault, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "15 July 1900 — 16:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/193"} "Croix Catelan, Bois de Boulogne, Paris"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/56095"} "8 from 5 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Final only."]]]] [:div {:class "description"} [:p {} "The event was usually called the pole jump in 1900, though the programme listed it, of course, as “le championnat de saut à la perche.” All the arguments about Sunday competition reached the height of absurdity with this event."] "\n\n" [:p {} "The event was scheduled to start at 4:30 PM (1630) on Sunday afternoon, with no qualifying held on Saturday. The Americans claimed that the French told them that any field event final which was contested on Sunday would not be considered finished until the Americans had a chance, on the next day, to better the marks posted. This was apparently ruled at a meeting on Wednesday, 11 July. But, on Saturday night, the French ruled that the results of all Sunday events would be final, with no recourse to any athletes who did not compete due to Sabbatarian objections. Apparently, the Americans were not told of this decision."] "\n\n" [:p {} "The top American vaulters were " [:a {:href "/athletes/78355"} "Charles Dvorak"] ", " [:a {:href "/athletes/78572"} "Daniel Horton"] ", and " [:a {:href "/athletes/890886"} "Bascom Johnson"] ". They were not at the field on Sunday when the pole vault started. Fortunately for the American team, " [:a {:href "/athletes/78090"} "Irv Baxter"] " (who had just won the " [:a {:href "/results/56090"} "high jump"] ", which started at 3:45 PM [1545]), and " [:a {:href "/athletes/78247"} "Meredith Colket"] " were present and were able to compete in the vault.  They took the first two places without much difficulty."] "\n\n" [:p {} "On Monday, Bascom Johnson, in a special event organized by the French authorities to assuage the angry American authorities, cleared 3.38 metres.  However, it had no bearing on the Olympic championship. On Thursday, 19 July, the pole vault handicap was held, and was won by " [:a {:href "/athletes/71187"} "Jakab Kauser"] " of Hungary. But the Americans were still protesting the Sunday competition, so again a special pole vault competition, at scratch, was organized. In this event, Daniel Horton cleared 3.45 metres, and Charles Dvorak was second with 3.35. It mattered little as the French never changed their ruling, and the listing below is the accepted one.  The 1900 Olympic pole vault champion remained Irv Baxter."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Best Height Cleared"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :st