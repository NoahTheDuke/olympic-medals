24000"} "Singles, Women"] "\n" [:option {:value "324180"} "Doubles, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "44067"} "1900"] "\n" [:option {:value "44200"} "1906"] "\n" [:option {:value "44542"} "1912"] "\n" [:option {:value "44692"} "1920"] "\n" [:option {:value "45001"} "1924"] "\n" [:option {:value "900237"} "1968"] "\n" [:option {:value "900305"} "1968"] "\n" [:option {:value "353423"} "2016"] "\n" [:option {:value "19004818"} "2020"] "\n" [:option {:value "2006718"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/611"} "Event type"]] [:h1 {:class "event_title"} "Doubles, Mixed" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "28 July –  5 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/882"} "All-England Lawn Tennis &amp; Croquet Club, Wimbledon, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/324218"} "32 from 13 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament."]]]] [:div {:class "description"} [:p {} "The return of the mixed doubles to the Olympic Games after a break of 88 years proved a godsend to Belarus doubles specialist " [:a {:href "/athletes/94190"} "Max Mirnyi"] ". Despite being one of the leading lights in doubles for more than a decade and having six grand slam titles to his credit he had never won an Olympic medal due, in the main part, to a lack of another top level male doubles player from his own country to partner him at the Games. With the mixed event added to the Olympic programme he had the perfect opportunity to put matters straight and to form a team with the world’s top ranked female singles star " [:a {:href "/athletes/117615"} "Viktoriya Azarenko"] "  who herself was highly regarded at doubles. Although they were the top seeds they had an unfavourable draw but, after surviving a close semi-final against " [:a {:href "/athletes/107361"} "Mike Bryan"] " and " [:a {:href "/athletes/107306"} "Lisa Raymond"] " of the USA, they duly booked their places in the final. Their opponents for the gold medal would be the wildcard British pairing of " [:a {:href "/athletes/117576"} "Andy Murray"] ", an hour removed from his singles triumph, and former Wimbledon junior champion " [:a {:href "/athletes/122939"} "Laura Robson"] ". The Britons had been forced to dig deep through three matches decided by the champions tie-break format to contest the final. Crowd excitement rose as the Britons led by a set and a break but Mirnyi and Azarenko fought back to level and kept their nerve in a tense tie-break to win 10-8 and earn a first Olympic tennis title for their nation."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/117615"} "Vika Azarenka"] " / " [:a {:href "/athletes/94190"} "Max Mirny"]] [:td {} [:a {:href "/countries/BLR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BLR.png"}] "BLR"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/122939"} "Laura Robson"] " / " [:a {:href "/athletes/117576"} "Andy Murray"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {