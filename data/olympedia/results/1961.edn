 kilometres, Men"] "\n" [:option {:value "1963"} "4 × 10 kilometres Relay, Men"] "\n" [:option {:value "1967"} "5 kilometres, Women"] "\n" [:option {:value "1968"} "10 kilometres, Women"] "\n" [:option {:value "1969"} "3 × 5 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1915"} "1956"] "\n" [:option {:value "1926"} "1960"] "\n" [:option {:value "1937"} "1964"] "\n" [:option {:value "1949"} "1968"] "\n" [:option {:value "1973"} "1976"] "\n" [:option {:value "1986"} "1980"] "\n" [:option {:value "1999"} "1984"] "\n" [:option {:value "2013"} "1988"] "\n" [:option {:value "2030"} "1992"] "\n" [:option {:value "2050"} "1994"] "\n" [:option {:value "2070"} "1998"] "\n" [:option {:value "2090"} "2002"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/186"} "Event type"]] [:h1 {:class "event_title"} "30 kilometres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 4 February 1972 — 9:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/109"} "Makomanai Cross Country Events Site, Sapporo"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1961"} "59 from 18 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: ?" [:br {}] "Height Differential: 119 m" [:br {}] "Intermediate 1: 10.0 km" [:br {}] "Intermediate 2: 20.0 km" [:br {}] "Maximum Climb: 85 m" [:br {}] "Total Climbing: 823 m"]]]] [:div {:class "description"} [:p {} "Soviet’s " [:a {:href "/athletes/98594"} "Vyacheslav Vedenin"] " – who won Olympic silver in the 50 km event in 1968 – had a great World Championships in 1970, winning the 30 km race, placing second in the 50 km race and also becoming World Champion as a member of the winning Soviet relay team. He was one of the hottest favorites for the 30 km Olympic gold in Sapporo, but started rather slowly and was lying in seventh place after 10 km, almost half a minute behind the leader, his teammate " [:a {:href "/athletes/97546"} "Fyodor Simashov"] ", who was the bronze medalist at 15 km at the 1970 World Championships. In second place, four seconds behind Simashev, was another Soviet skier, " [:a {:href "/athletes/85248"} "Vladimir Dolganov"] ", followed by the Norwegian " [:a {:href "/athletes/86487"} "Johs  Harviken"] ", another four seconds behind. But now Vedenin started his move. At 20 km he was in the lead, 11 seconds ahead of the Norwegian " [:a {:href "/athletes/98447"} "Pål Tyldum"] ", who had advanced from sixth to second position. " [:a {:href "/athletes/98594"} "Gunnar Larsson"] " from Sweden had moved from fifth to third, and Harviken was close behind, still among the medal contenders. Dolganov had dropped to sixth and Simashev to seventh, seemingly out of the medal struggle. Vedenin finished strongly and won the first ever Olympic cross-country gold for a Soviet man with a margin of over 54 seconds. The fight for the other medals was very tight between the two Norwegians and Larsson. Harviken, starting half a minute behind his Swedish rival, had a strong finish and beat Larsson’s final time by just over one second. Tyldum, starting last of all the competitors, was able to stay ahead of his countryman and won the silver medal, defeating Harviken by seven seconds. The West German veteran " [:a {:href "/athletes/85148"} "Walter Demel"] ", starting in his third Winter Olympics, finished strongly to finish in fifth place."] "\n"] [:button {:id "button757899", :class "btn btn-default"} "Details"] [:script {} "$('#button757899').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {