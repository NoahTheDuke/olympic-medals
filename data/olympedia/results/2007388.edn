6 kilograms), Men"] "\n" [:option {:value "2006884"} "Lightweight (≤73 kilograms), Men"] "\n" [:option {:value "2006926"} "Half-Middleweight (≤81 kilograms), Men"] "\n" [:option {:value "2006968"} "Middleweight (≤90 kilograms), Men"] "\n" [:option {:value "2007010"} "Half-Heavyweight (≤100 kilograms), Men"] "\n" [:option {:value "2007052"} "Heavyweight (&gt;100 kilograms), Men"] "\n" [:option {:value "2007094"} "Extra-Lightweight (≤48 kilograms), Women"] "\n" [:option {:value "2007136"} "Half-Lightweight (≤52 kilograms), Women"] "\n" [:option {:value "2007178"} "Lightweight (≤57 kilograms), Women"] "\n" [:option {:value "2007220"} "Half-Middleweight (≤63 kilograms), Women"] "\n" [:option {:value "2007262"} "Middleweight (≤70 kilograms), Women"] "\n" [:option {:value "2007304"} "Half-Heavyweight (≤78 kilograms), Women"] "\n" [:option {:value "2007346"} "Heavyweight (&gt;78 kilograms), Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "18000780"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/2568"} "Event type"]] [:h1 {:class "event_title"} "Team, Mixed" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} " 3 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2173"} "Grand Palais Éphémère, Paris, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2007388"} "129 from 19 countries"]]]]] [:div {:class "description"} [:p {} "France had won the gold medal in this event on Japanese home soil at Tokyo 2020, the only previous time the event was on the Olympic Programme. It was considered a big upset, as Japan had won the World Championships six times, or every time it had been contested, in 2017-19 and 2021-23. France had won five silver medals at the Worlds, in 2018-19 and 2021-23, but France had the ultimate weapon in " [:a {:href "/athletes/112724"} "Teddy Riner"] ", the redoubtable French heavyweight judoka."] "\n\n" [:p {} "As expected, France and Japan made it to the gold medal match, with France defeating Italy 4-1 and Japan besting Germany 4-0 in the semi-finals. The result was the same as in 2020, with France taking gold and Japan silver. Japan got off to an early 3-1 lead in bouts in the final, Riner beating " [:a {:href "/athletes/153296"} "Tatsuru Saito"] " in extra time at 7:04, by " [:em {} "ippon"] " using " [:em {} "uchi-mata"] ", but France won the next two bouts, with " [:a {:href "/athletes/153253"} "Joan-Benjamin Gaba"] " defeating " [:a {:href "/athletes/2103742"} "Hifumi Abe"] " by " [:em {} "ippon"] " at 8:52 in extra time, an epic fight, and then " [:a {:href "/athletes/130152"} "Clarisse Agbegnenou"] " winning by " [:em {} "waza-ari"] " over " [:a {:href "/athletes/130793"} "Miku Takaichi"] ". At 3-3, the deciding category was determined by an electronic draw. The men’s &gt;90 kg category was drawn, leading to a Riner-Saito rematch for the win. Riner finally triumphed by " [:em {} "ippon"] " over Saito, once again in extra time at 6:26, using " [:em {} "o-uchi-gari"] ". The Grand Palais Éphémère was on fire!"] "\n\n" [:p {} "Germany and Italy did not win medals, as Brazil defeated Italy and Korea took down Germany in the bronze medal matches. Both matches were very close, ending with 4-3 scores, " [:a {:href "/athletes/122491"} "Rafaela Silva"] " and " [:a {:href "/athletes/134967"} "An Ba-Ul"] " winning the deciding contests, respectively, for Brazil and Korea."] "\n\n" [:p {} "Riner won his seventh Olympic medal and fifth gold medal, both all-time Olympic records for judo. Next in the all-time list medalists are " [:a {:href "/athletes/33327"} "Ryoko Tamura-Tani"] ", Clarisse Agbegnenou, and " [:a {:href "/athletes/134778"} "Takanori Nagase"] " with five Olympic medals. Riner’s five golds were also a French record for the Summer Olympics, trailing only biathlete " [:a {:href "/athletes/118554"} "Martin Fourcade"] ", who had six gold medals at the Winter Olympics."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "France"] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/142750"} "Sarah-Léonie Cysique"] " • " [:a {:href "/athletes/130152"} "Clarisse Agbegnenou"] " • " [:a {:href "/athletes/153250"} "Marie-Ève Gahié"] " • " [:a {:href "/athletes/142749"} "Romane Dicko"] " • " [:a {:href "/athletes/153253"} "Joan-Benjamin Gaba"] " • " [:a {:href "/athletes/153254"} "Maxime-Gaël Ngayap Hambou"] " • " [:a {:href "/athletes/112724"} "Teddy Riner"] " • " [:a {:href "/athletes/133875"} "Walide Khyar"] [:small {} " (DNS)"] " • " [:a {:href "/athletes/142746"} "Amandine Buchard"] [:small {} " (DNS)"] " • " [:a {:href "/athletes/142747"} "Madeleine Malonga"] [:small {} " (DNS)"] " • " [:a {:href "/athletes/142751"} "Shirine Boukli"] [:small {} " (DNS)"] " • " [:a {:href "/athletes/142903"} "Luka Mkheidze"] [:small {} " (DNS)"] " • " [:a {:href "/athletes/153251"} "Alpha Djalo"] [:small {} " (DNS)"] " • " [:a {:href "/athletes/153252"} "Aurélien Diesse"] [:small {} " (DNS)"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Japan"] [:td {} [:a {:href "/countries/JPN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazon