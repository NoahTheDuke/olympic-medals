000221"} "12.5 kilometres Pursuit, Men"] "\n" [:option {:value "9000222"} "15 kilometres Mass Start, Men"] "\n" [:option {:value "9000223"} "20 kilometres, Men"] "\n" [:option {:value "9000224"} "4 × 7.5 kilometres Relay, Men"] "\n" [:option {:value "9000225"} "7.5 kilometres Sprint, Women"] "\n" [:option {:value "9000226"} "10 kilometres Pursuit, Women"] "\n" [:option {:value "9000227"} "12.5 kilometres Mass Start, Women"] "\n" [:option {:value "9000228"} "15 kilometres, Women"] "\n" [:option {:value "9000230"} "2 × 6 kilometres and 2 × 7.5 kilometres Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1611"} "2006"] "\n" [:option {:value "923496"} "2010"] "\n" [:option {:value "350031"} "2014"] "\n" [:option {:value "19019639"} "2022"] "\n" [:option {:value "15000039"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/138"} "Event type"]] [:h1 {:class "event_title"} "4 × 6 kilometres Relay, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "22 February 2018 — 20:15"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/936"} "Alpensia Biathlon Centre, Alpensia Resort, Mountain Cluster, Daegwallyeong"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/9000229"} "72 from 18 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Eight shots for each group of five targets. Penalty loop (150 metres) skied for each missed target, with three extra shots allowed to obtain 5 target hits."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 5,928 m" [:br {}] "Height Differential: 36 m" [:br {}] "Maximum Climb: 40 m" [:br {}] "Shooting 1: Prone at 1.864 km, 50 m range" [:br {}] "Shooting 2: Standing at 3.993 km, 50 m range" [:br {}] "Total Climbing: 156 m"]]]] [:div {:class "description"} [:p {} "Germany came in as the favorites, led by " [:a {:href "/athletes/127804"} "Laura Dahlmeier"] ", but three missed targets and 11 extra shots left them back in eighth place. For some time disqualifying the German team was discussed by the officials. The tragic figure was first leg runner " [:a {:href "/athletes/127806"} "Franziska Preuß"] ", who hit all five targets in her first round of shooting, but thought she had missed a shot. She reloaded a cartridge, but did not shoot when she noticed her miscalculation. The jury did not disqualify her, but at the second shooting she then missed four targets and had to run a penalty loop."] "\n\n" [:p {} "The event ended up being very close, with only 64 seconds separating gold medal winning Belarus from ninth-placed Italy. Belarus never led until the final leg, when their anchor skier " [:a {:href "/athletes/118516"} "Darya Domracheva"] " pulled ahead of France’s " [:a {:href "/athletes/127713"} "Anaïs Bescond"] " and won the event by 10.7 seconds over Sweden, led by their anchor " [:a {:href "/athletes/138149"} "Hanna Öberg"] ", who pulled them from eighth place after three legs with the fastest leg of the entire relay, marked by perfect shooting. Bescond and France held on for the bronze medal, with Norway finishing fourth. Italy had been third after three legs, but " [:a {:href "/athletes/137383"} "Federica Sanfilippo"] " struggled both skiing and shooting as they dropped back to ninth."] "\n\n" [:p {} "Domracheva won her fourth gold medal, after three in Sochi, and replaced Germany’s " [:a {:href "/athletes/100035"} "Kati Wilhelm"] " and Slovkaia’s " [:a {:href "/athletes/118501"} "Anastasia Kuzmina"] ", both with three golds, as the most successful female biathletes in Olympic history in terms of gold medals. Wilhelm was the color commentator for this race on German TV."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Misses"] [:th {} "Extra Shots"] [:th {} "Shooting 1 Misses"] [:th {} "Shooting 1 Extra Shots"] [:th {} "Shooting 1"] [:th {} "Shooting 2 Misses"] [:th {} "Shooting 2 Extra Shots"] [:th {} "Shooting 2"] [:th {} "Exchange"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Belarus"] [:td {} [:a {:href "/countries/BLR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BLR.png"}] "BLR"]] [:td {} "1-12:03.4"] [:td {} "0"] [:td {} "9"] [:td {} "–"] [:td {} "–"] [:td {} "– (–)"] [:td {} "–"] [:td {} "–"] [:td {} "– (–)"] [:td {} "– (–)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/118564"} "Nadzeya Skardzina"] " "] [:td {}] [:td {} "17:35.2"] [:td {} "0"] [:td {} "2"] [:td {} "0"] [:td {} "0"] [:td {} "5:42.6 (8)"] [:td {} "0"] [:td {} "2"] [:td {} "12:30.7 (10)"] [:td {} "17:35.2 (10)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/136768"} "Iryna Kryuko"] " "] [:td {}] [:td {} "18:08.2"] [:td {} "0"] [:td {} "1"] [:td {} "0"] [:td {} "1"] [:td {} "23:44.9 (9)"] [:td {} "0"] [:td {} "0"] [:td {} "30:41.2 (3)"] [:td {} "35:43.4 (5)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/136767"} "Dzinara Alimbekava"] " "] [:td {}] [:td {} "18:52.4"] [:td {} "0"] [:td {} "3"] [:td {} "0"] [:td {} "2"] [:td {} "42:06.0 (3)"] [:td {} "0"] [:td {} "1"] [:td {} "49:07.3 (1)"] [:td {} "54:35.8 (4)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {} [:a {:href "/athletes/118516"} "Daria Domrachava"] " "] [:td {}] [:td {} "17:27.6"] [:td {} "0"] [:td {} "3"] [:td {} "0"] [: