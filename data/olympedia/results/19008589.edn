3"} "Double Sculls, Men"] "\n" [:option {:value "19008446"} "Quadruple Sculls, Men"] "\n" [:option {:value "19008455"} "Coxless Pairs, Men"] "\n" [:option {:value "19008468"} "Coxless Fours, Men"] "\n" [:option {:value "19008478"} "Eights, Men"] "\n" [:option {:value "19008486"} "Lightweight Double Sculls, Men"] "\n" [:option {:value "19008504"} "Single Sculls, Women"] "\n" [:option {:value "19008537"} "Double Sculls, Women"] "\n" [:option {:value "19008550"} "Quadruple Sculls, Women"] "\n" [:option {:value "19008559"} "Coxless Pairs, Women"] "\n" [:option {:value "19008572"} "Coxless Fours, Women"] "\n" [:option {:value "19008581"} "Eights, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "159527"} "1996"] "\n" [:option {:value "159701"} "2000"] "\n" [:option {:value "159879"} "2004"] "\n" [:option {:value "261138"} "2008"] "\n" [:option {:value "319156"} "2012"] "\n" [:option {:value "354122"} "2016"] "\n" [:option {:value "2012585"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/402"} "Event type"]] [:h1 {:class "event_title"} "Lightweight Double Sculls, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "24 – 29 July 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2129"} "Sea Forest Waterway, 6-44, 3chome, Uminomori, Koto-ku, Tokyo Bay, Tokyo, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19008589"} "36 from 18 countries"]]]]] [:div {:class "description"} [:p {} "The Netherlands’ " [:a {:href "/athletes/145509"} "Marieke Keijser"] " and " [:a {:href "/athletes/131182"} "Ilse Paulis"] " had moved to the top of the favourites list by setting a world best time at the recent World Rowing Cup III, and Paulis being the defending Olympic champion (though with a different partner). Great Britain’s " [:a {:href "/athletes/143050"} "Emily Craig"] " and " [:a {:href "/athletes/143054"} "Imogen Grant"] " were also ranked as strong contenders, having gained victory at World Rowing Cup II earlier in 2021, and finishing second to Italy’s " [:a {:href "/athletes/136521"} "Valentina Rodini"] " and " [:a {:href "/athletes/144071"} "Federica Cesarini"] " at this year’s European championship. Italy’s victory at that event also put them in the mix for a potential Olympic medal."] "\n\n" [:p {} "The final featured the favourites, with France, the United States, and Romania filling out the field. The Netherlands and France set out fastest, with the latter’s " [:a {:href "/athletes/142767"} "Laura Tarantola"] " and " [:a {:href "/athletes/142765"} "Claire Bove"] " seeming intent on crashing the favourites’ party. Italy and Great Britain soon took up the challenge and joined the other two teams in a four-boat pack at the front. By the halfway point, less than a second separated the four and with only 500m to go it was still anyone’s race. At the end, in a classic photo finish, Italy took the victory by 0.14 seconds over the surprising French. It was a disappointing finish for the Dutch pair, who were well positioned to repeat their Olympic championship before a stroke of bad luck led them to “catch a crab” and grind their boat to a near-halt in the final metres, dropping them to bronze position which they narrowly held onto by the slimmest of margins: 0.01 seconds over the British."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/136521"} "Valentina Rodini"] " / " [:a {:href "/athl