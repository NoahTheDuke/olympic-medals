rlands, but then Korea did not lose its advantage and won with a score of 5-3. Mexico won the bronze medal, beating Turkey 6-2."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Republic of Korea"] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/144969"} "Kim Je-Deok"] " • " [:a {:href "/athletes/144886"} "An San"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Netherlands"] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/145535"} "Steve Wijler"] " • " [:a {:href "/athletes/131049"} "Gabriela Schloesser"]]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} "Mexico"] [:td {} [:a {:href "/countries/MEX"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/MEX.png"}] "MEX"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a {:href "/athletes/122283"} "Luis Álvarez"] " • " [:a {:href "/athletes/122929"} "Alejandra Valencia"]]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} "Turkey"] [:td {} [:a {:href "/countries/TUR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/TUR.png"}] "TUR"]] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "8"} [:a 