02029"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/636"} "Event type"]] [:h1 {:class "event_title"} "Lightweight (≤69 kg), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "11 – 12 August 2008 — 19:00 (12/8) (A), 10:00 (12/8) (B), 12:30 (11/8) (C)"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/846"} "Beijing Hangkong Hangtian Daxue Tiyuguan, Beijing"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/263015"} "30 from 26 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Total of best lifts in snatch and clean &amp; jerk determined placement.  Ties broken by lightest bodyweight."]]]] [:div {:class "description"} [:p {} "There was no definite favorite in this class. The 2004 Olympic featherweight gold medalist, " [:a {:href "/athletes/103555"} "Shi Zhiyong"] ", snatched 152.0 kg but injured himself during the clean &amp; jerk and did not finish. The Athinai silver medalist, Korean " [:a {:href "/athletes/94962"} "Lee Bae-Yeong"] ", had lifted 155.0 kg in the snatch but tore a calf muscle in the clean &amp; jerk and also did not finish. The 2007 World Champion and defending gold medalist was China’s " [:a {:href "/athletes/94706"} "Zhang Guozheng"] ", but he was beaten out for a spot on the Chinese team by " [:a {:href "/athletes/116327"} "Liao Hui"] ". Liao had the best lifts in both snatch and clean &amp; jerk to win the gold medal. His margin was 10 kg over France’s " [:a {:href "/athletes/103798"} "Vencelas Dabaya"] " and Armenia’s World Junior Champion " [:a {:href "/athletes/116329"} "Tigran G. Martirosyan"] ". Dabaya and Martirosyan tied at 338.0 kg, with silver going to Dabaya on lower bodyweight."] "\n\n" [:p {} "That was how the event and the results seemed to have ended. In 2015, however, the IOC began re-testing samples from the 2008 Beijing and 2012 London Olympics, using newer, more advanced testing techniques, in an effort to find those who had used performance enhancing drugs (PEDs), but in whom it could not be detected at the time of those Olympics. This was one of the many events affected."] "\n\n" [:p {} "In August 2016 Armenian " [:a {:href "/athletes/116329"} "Tigran G. Martirosyan"] " had a positive re-test for turinabol (dehydrochloromethyltestosterone) and stanozolol, and was disqualified, losing his bronze medal, which was re-assigned to Cuban lifter " [:a {:href "/athletes/116330"} "Yordanis Borrero"] "."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Kilograms"] [:th {} "Bodyweight"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/116327"} "Liao Hui"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} "348.0"] [:td {} "68.97"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/103798"} "Vencelas Dabaya"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "338.0"] [:td {} "68.38"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/116330"} "Yordanis Borrero"]] [:td {} [:a {:href "/countries/CUB"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CUB.png"}] "CUB"]] [:td {} "328.0"] [:td {} "68.92"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/94915"} "Tur