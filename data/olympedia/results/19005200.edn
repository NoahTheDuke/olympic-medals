{:value "19005395"} "Doubles, Women"] "\n" [:option {:value "19005436"} "Doubles, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "900321"} "1972"] "\n" [:option {:value "90016742"} "1988"] "\n" [:option {:value "42000"} "1992"] "\n" [:option {:value "42214"} "1996"] "\n" [:option {:value "42470"} "2000"] "\n" [:option {:value "42726"} "2004"] "\n" [:option {:value "257994"} "2008"] "\n" [:option {:value "304000"} "2012"] "\n" [:option {:value "351550"} "2016"] "\n" [:option {:value "2005600"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/123"} "Event type"]] [:h1 {:class "event_title"} "Singles, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "24 July –  2 August 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2124"} "Musashino Forest Sports Plaza, Chōfu, Tokyo, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19005200"} "41 from 36 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament."]]]] [:div {:class "description"} [:p {} "The defending Olympic champion in men’s singles was China’s " [:a {:href "/athletes/121932"} "Chen Long"] ", who had a long history of international podium successes, dating back to 2009. The winner of the two most recent World Championships (2018 and 2019) and the top-ranked qualifier was " [:a {:href "/athletes/144557"} "Kento Momota"] " of Japan, who would have the advantage of playing on home soil. Also among the contenders were Denmark’s " [:a {:href "/athletes/133435"} "Viktor Axelsen"] ", the 2017 world champion and 2016 Olympic bronze medallist, and the most recent world bronze medallists " [:a {:href "/athletes/146807"} "Kantaphon Wangcharoen"] " of Thailand and " [:a {:href "/athletes/1303424"} "B. Sai Praneeth"] " of India."] "\n\n" [:p {} "In the preliminaries, both Wangcharoen and Sai Praneeth failed to reach the elimination rounds, with Sai Praneeth losing both of his matches. The biggest surprise, however, was Momota’s defeat at the hands of South Korean " [:a {:href "/athletes/144973"} "Heo Gwang-Hui"] ", who also triumphed over American " [:a {:href "/athletes/147369"} "Timothy Lam"] " to win the pool and advance directly to the quarterfinals. Thus the elimination rounds were dominated by Chen and Axelson, who met in the final, where Axelson bested Chen in two sets to become the first individual outside of Asia to win Olympic gold in this event since fellow Dane " [:a {:href "/athletes/2383"} "Poul-Erik Høyer Larsen"] " in 1996, and the only badminton medallist from outside of Asia in Tokyo. Bronze went to Indonesia’s " [:a {:href "/athletes/2103599"} "Anthony Ginting"] ", a bronze medallist at both the 2014 Youth Olympics and the 2018 Asian Games, who defeated four-time Olympian " [:a {:href "/athletes/112838"} "Kevin Cordón"] " of Guatemala in two sets. Cordón had eliminated Heo in the quarterfinals, before being overcome in turn by Axelsen in the semis."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/133435"} "Viktor Axelsen"]] [:td {} [:a {:href "/countries/DEN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/DEN.png"}] "DEN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/121932"} "Chen Long"]] [:td {} [:a {:href "/co