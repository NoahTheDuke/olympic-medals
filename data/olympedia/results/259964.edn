a"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "9 – 17 August 2008"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/832"} "Guojia Tiyuguan, Beijing Aolinpike Gongyuan, Beijing"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/259964"} "77 from 28 countries"]]]]] [:div {:class "description"} [:p {} "The format was the same as it had been from 1984-2004, with eight gymnasts advancing from the team all-around, but no more than two per nation. Brazilian " [:a {:href "/athletes/111962"} "Diego Hypólito"] " came in as the favorite, as the 2005/07 World Champion, and a silver medalist in 2006. He led the qualifying, followed by Romanian " [:a {:href "/athletes/91544"} "Marian Drăgulescu"] ", the 2004 silver medalist and 2006 World Champion. In the final Hypólito was on course for gold until he fell landing his final tumbling pass and dropped down to sixth place. Drăgulescu also fell in the final, on his second tumbling pass, and would place seventh. Gold went to China’s " [:a {:href "/athletes/111922"} "Zou Kai"] ", who performed the most difficult final routine, and won easily over Spain’s " [:a {:href "/athletes/91291"} "Gervasio Deferr"] ". Zou would defend his gold medal at London in 2012, after winning silver medals on floor at the 2009 and 2011 World Championships."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "126"] [:td {} [:a {:href "/athletes/111922"} "Zou Kai"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "136"] [:td {} [:a {:href "/athletes/91291"} "Gervasio