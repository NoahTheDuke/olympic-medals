itions: “Magda IX” winning with “Erna Signe” in second, and the “Heatherbell” in third place. It was the only class of the 1912 sailing events in which no sail-off was required."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Race #1"] [:th {} "Race #2"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} "Magda IX"] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "14"] [:td {} "3-17:17 (1)"] [:td {} "3-32:00 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "11"} [:a {:href "/athletes/62713"} "Alfred Larsen"] " • " [:a {:href "/athletes/61186"} "Johan Anker"] " • " [:a {:href "/athletes/61324"} "Nils Berthelsen"] " • " [:a {:href "/athletes/62268"} "Halfdan Hansen"] " • " [:a {:href "/athletes/62637"} "Magnus Konow"] " • " [:a {:href "/athletes/62714"} "Petter Larsen"] " • " [:a {:href "/athletes/61971"} "Eilert Falch-Lund"] " • " [:a {:href "/athletes/63742"} "Fritz Staib"] " • " [:a {:href "/athletes/62306"} "Arnfinn Heje"] " • " [:a {:href "/athletes/63893"} "Gustav Thaulow"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} "Erna Signe"] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "6"] [:td {} "3-24:13 (2)"] [:td {} "3-48:06 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:colspan "11"} [:a {:href "/athletes/80446"} "Hugo Clason"] " • " [:a {:href "/athletes/63286"} "Nils Persson"] " • " [:a {:href "/athletes/80447"} "Hugo Sällström"] " • " [:a {:href "/athletes/62699"} "Iwan Lamby"] " • " [:a {:href "/athletes/61322"} "Kurt Ber