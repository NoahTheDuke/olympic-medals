 "12.5 kilometres Pursuit, Men"] "\n" [:option {:value "1602"} "15 kilometres Mass Start, Men"] "\n" [:option {:value "1600"} "20 kilometres, Men"] "\n" [:option {:value "1603"} "4 × 7.5 kilometres Relay, Men"] "\n" [:option {:value "1607"} "7.5 kilometres Sprint, Women"] "\n" [:option {:value "1610"} "12.5 kilometres Mass Start, Women"] "\n" [:option {:value "1608"} "15 kilometres, Women"] "\n" [:option {:value "1611"} "4 × 6 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1594"} "2002"] "\n" [:option {:value "923492"} "2010"] "\n" [:option {:value "350028"} "2014"] "\n" [:option {:value "9000226"} "2018"] "\n" [:option {:value "19019636"} "2022"] "\n" [:option {:value "15000036"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/134"} "Event type"]] [:h1 {:class "event_title"} "10 kilometres Pursuit, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "18 February 2006 — 12:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/172"} "Cesana San Sicario"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1609"} "58 from 22 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Starting margin based on results of 7.5 kilometer. Penalty loop (150 metres) skied for each missed target."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 10,000 m" [:br {}] "Height Differential: 41 m" [:br {}] "Maximum Climb: 13 m" [:br {}] "Shooting 1: Prone at 2.0 km, 50 m range" [:br {}] "Shooting 2: Prone at 4.0 km, 50 m range" [:br {}] "Shooting 3: Standing at 6.0 km, 50 m range" [:br {}] "Shooting 4: Standing at 8.0 km, 50 m range" [:br {}] "Total Climbing: 340 m"]]]] [:div {:class "description"} [:p {} "The very close finish in the sprint, with the top eight finishers within 22 seconds of one another, meant that this race would also have a lot of contenders. The race was on a course that had seen a snowfall the night before, making for difficult ski conditions. Germany’s " [:a {:href "/athletes/80953"} "Uschi Disl"] " was the defending World Champion, and was trying to finally win an individual Olympic gold medal. But she started almost two minutes back and could only get up to 10th. The sprint champion, France’s " [:a {:href "/athletes/99570"} "Florence Baverel-Robert"] ", was done in by poor shooting, missing four targets. Despite the closeness of the start, the event would be a runaway for German " [:a {:href "/athletes/100035"} "Kati Wilhelm"] ". Starting only 18 seconds back, she took the lead early and pushed ahead, missing only one target, and winning by 1:13.6 over her teammate " [:a {:href "/athletes/101163"} "Martina Glagow"] ". The bronze went to Russian " [:a {:href "/athletes/99555"} "Albina Akhatova"] ", and Glagow and Akhatova had finished in the same positions in the 15 km individual, although only after the doping disqualification of " [:a {:href ""} "Olga Pyleva"] ". This was Wilhelm’s third Olympic gold medal, after sprint and relay golds in 2002, and she would add two more silvers in Torino, in the pursuit and relay."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Misses"] [:th {} "Start Behind"] [:th {} "Race"] [:th {} "Shooting 1 Misses"] [:th {} "Shooting 1"] [:th {} "Shooting 2 Misses"] [:th {} "Shooting 2"] [:th {} "Shooting 3 Misses"] [:th {} "Shooting 3"] [:th {} "Shooting 4 Misses"] [:th {} "Shooting 4"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athl