ue "256395"} "Canadian Singles, Slalom, Men"] "\n" [:option {:value "256402"} "Canadian Doubles, Slalom, Men"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255438"} "1972"] "\n" [:option {:value "256065"} "1992"] "\n" [:option {:value "256201"} "1996"] "\n" [:option {:value "256310"} "2000"] "\n" [:option {:value "258863"} "2008"] "\n" [:option {:value "307020"} "2012"] "\n" [:option {:value "353600"} "2016"] "\n" [:option {:value "19006326"} "2020"] "\n" [:option {:value "2008437"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/181"} "Event type"]] [:h1 {:class "event_title"} "Kayak Singles, Slalom, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "17 – 18 August 2004"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/789"} "Olympiako Kentro Kanoe/Kagiak Slalom, Olympiako Syngrotima Ellenikou, Hellinikon"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/256430"} "19 from 16 countries"]]]]] [:div {:class "description"} [:p {} "The Czech Republic’s " [:a {:href "/athletes/9386"} "Štěpánka Hilgertová"] " was the reigning World and two-time Olympic champion, as well as the 2002 European champion, in the women’s K-1 slalom, and was a favorite at the 2004 Summer Olympics. She would certainly be challenged, however, by Slovakia’s " [:a {:href "/athletes/10714"} "Elena Kaliská"] ", winner of three of the last four European championships and another favorite. Hilgertová had a poor qualifying round, finishing 11th, while Kaliská was second behind Germany’s " [:a {:href "/athletes/105094"} "Jennifer Bongardt"] ", the 2003 World runner-up.  Great Britain’s " [:a {:href "/athletes/105095"} "Helen Reeves"] " came in third. Kaliská was at the top of the rankings after the first run of the final, while " [:a {:href "/athletes/105098"} "Peggy Dickens"] " of France was second and Bongardt was third. Reeves, meanwhile, came in with a fifth-place score while Hilgertová was eighth. Kaliská was first again in the second run and secured the gold medal while 2002 World Champion " [:a {:href "/athletes/90279"} "Rebecca Giddens’"] " second-place was sufficient for silver, after having been fourth in first portion. Hilgertová was third, but her earlier placing meant that she would rise no higher than fifth. Thus bronze seemed to go Dickens, but she was dealt an extra penalty point at the conclusion of the event and lost the final podium spot to Reeves by a mere 0.03 points."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1"] [:td {} [:a {:href "/athletes/10714"} "Elena Kaliská"]] [:td {} [:a {:href "/countries/SVK"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SVK.png"}] "SVK"]] [:td {} "212.65 (2)"] [:td {} "103.74 (1)"] [:td {} "210.03 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "15"] [:td {} [:a {:href "/athletes/90279"} "Rebecca Giddens"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "224.94 (5)"] [:td {} "107.56 (4)"] [:td {} "214.62 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:t