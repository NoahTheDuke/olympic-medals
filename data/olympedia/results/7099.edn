4548"} "1908"] "\n" [:option {:value "4630"} "1912"] "\n" [:option {:value "4709"} "1920"] "\n" [:option {:value "4785"} "1924"] "\n" [:option {:value "4887"} "1928"] "\n" [:option {:value "4988"} "1932"] "\n" [:option {:value "5081"} "1936"] "\n" [:option {:value "5192"} "1948"] "\n" [:option {:value "5307"} "1952"] "\n" [:option {:value "5427"} "1956"] "\n" [:option {:value "5556"} "1960"] "\n" [:option {:value "5742"} "1964"] "\n" [:option {:value "5989"} "1968"] "\n" [:option {:value "6303"} "1972"] "\n" [:option {:value "6580"} "1976"] "\n" [:option {:value "6835"} "1980"] "\n" [:option {:value "7421"} "1988"] "\n" [:option {:value "7778"} "1992"] "\n" [:option {:value "8120"} "1996"] "\n" [:option {:value "8518"} "2000"] "\n" [:option {:value "8912"} "2004"] "\n" [:option {:value "261646"} "2008"] "\n" [:option {:value "322165"} "2012"] "\n" [:option {:value "357141"} "2016"] "\n" [:option {:value "19000066"} "2020"] "\n" [:option {:value "2001571"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/568"} "Event type"]] [:h1 {:class "event_title"} "4 × 200 metres Freestyle Relay, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "30 July 1984"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/608"} "Olympic Swim Stadium, University of Southern California, Los Angeles, California"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/7099"} "62 from 14 countries"]]]]] [:div {:class "description"} [:p {} "The world record had been set in August 1983 by the West German team, and it was expected to be a very close final between the FRG and United States. Nobody could really envision how close, although " [:em {} "Sports Illustrated"] "’s Craig Neff did call it, predicting in the Olympic Preview issue, “The West Germans will likely lose their world record and the gold medal to the U.S. – but just barely.” That record went in the heats as the US B team came home in 7:18.87 for a world record to qualify first."] "\n\n" [:p {} "US coach Don Gambril made the choice to lead off with America’s best, " [:a {:href "/athletes/51393"} "Mike Heath"] ", and make the Germans catch up, as the German anchor would certainly be " [:a {:href "/athletes/47812"} "Michael Groß"] ", probably the top male freestyler in Los Angeles. On the first leg Heath went ahead of " [:a {:href "/athletes/47802"} "Thomas Fahrner"] ", 1:48.67 to 1:49.83. On the next leg " [:a {:href "/athletes/51456"} "David Larson"] " extended the lead to 2.87 seconds at 300 metres, but he had gone out too fast, and Dirk Korthals closed so that the US lead was only 9/10ths of a second by the exchange. The third US swimmer, " [:a {:href "/athletes/51339"} "Jeff Float"] ", also went out quickly and had 3 seconds on the Germans at 500 metres, but " [:a {:href "/athletes/47915"} "Alexander Schowtka"] " reeled in Float on the second 100, with the margin 1.56 seconds as the anchor swimmers started their work."] "\n\n" [:p {} "Groß anchored Germany, as expected, and he faced off against American " [:a {:href "/athletes/51392"} "Bruce Hayes"] ". At the first turn of the anchor, Groß had caught up, but Gambril later noted that “Groß paid too much to catch Bruce that early.” For the next 100 they swam together, Groß unable to shake Hayes, until Germany took a slight lead at the final turn. With 25 metres to go, Hayes had made that up and they swam together to the wall, nobody really knowing who had won, until the scoreboard showed that it was the United States – 7:15.69 to 7:15.73 – the closest relay in Olympic swimming history. The time was a world record by over three seconds."] "\n\n" [:p {} "Groß was magnanimous in defeat, stating, “I simply did not have any more to give. We never expected to swim so fast in the relay, so we cannot be too disappointed.” His final leg of 1:46.89 was the fastest 200 split ever recorded at that time."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "United States"] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "7:18.87 (1 h1)"] [:td {} "7:15.69 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "464"] [:td {} [:a {:href "/athletes/51393"} "Mike Heath"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "469"] [:td {} [:a {:href "/athletes/51456"} "David Larson"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "459"] [:td {} [:a {:href "/athletes/51339"} "Jeff Float"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "463"] [:td {} [:a {:href "/athletes/51392"} "Bruce Hayes"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "460"] [:td {} [:a {:href "/athletes/51349"} "Geoff Gaberino"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "480"] [:td {} [:a {:href "/athletes/51546"} "Rich Saeger"] " "] [:td {}] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} "West Germany"] [:td {} [:a {:href "/countries/FRG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRG