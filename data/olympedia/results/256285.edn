:value "256278"} "Canadian Singles, Slalom, Men"] "\n" [:option {:value "256310"} "Kayak Singles, Slalom, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255417"} "1972"] "\n" [:option {:value "256036"} "1992"] "\n" [:option {:value "256166"} "1996"] "\n" [:option {:value "256402"} "2004"] "\n" [:option {:value "258832"} "2008"] "\n" [:option {:value "307012"} "2012"] "\n" [:option {:value "353548"} "2016"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/175"} "Event type"]] [:h1 {:class "event_title"} "Canadian Doubles, Slalom, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "19 – 20 September 2000"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/754"} "Penrith Whitewater Stadium, Penrith, New South Wales"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/256285"} "24 from 10 countries"]]]]] [:div {:class "description"} [:p {} "The format of the K-1 slalom had changed since the previous Olympics, as now the scores of both rounds, rather than just the best one, counted and there was a qualifying round prior to the final. Defending Olympic champions " [:a {:href "/athletes/9589"} "Franck Adisson"] " and " [:a {:href "/athletes/9629"} "Wilfrid Forgues"] " of France had kept busy by winning the 1997 World Championships and coming in second at the 2000 European Championships. The reigning World Champions, however, were " [:a {:href "/athletes/90156"} "Marek Jiras"] " and " [:a {:href "/athletes/90158"} "Tomáš Máder"] " of the Czech Republic, while twin brothers " [:a {:href "/athletes/90262"} "Pavol"] " and " [:a {:href "/athletes/90263"} "Peter Hochschorner"] " of Slovakia had won the event at the last two editions of the European Championships. Finally, 1996 Olympic bronze medalists " [:a {:href "/athletes/9903"} "André Ehrenberg"] " and " [:a {:href "/athletes/9983"} "Michael Senft"] " had been runners-up at the 1997 World Championships."] "\n\n" [:p {} "The Slovakian, French, and German crews were the top finishers in the qualifying round, but Jiras and Máder, in fifth place, also advanced. France and Slovakia occupied the top two positions after the first run, while the Czechs were fourth behind " [:a {:href "/athletes/10536"} "Andrzej Wójs"] " and " [:a {:href "/athletes/10509"} "Sławomir Mordarski"] " of Poland and the Germans were seventh. Both the Frenchmen and the Germans had terrible runs in the second round that placed them seventh and eighth respectively not only in that portion of the competition, but in the final rankings as well, despite the defending Olympic champions’ great first run. This cleared the way for Slovakia to win the gold medal, which they did in style by winning the second run, while another Polish duo, " [:a {:href "/athletes/10490"} "Krzysztof Kołomański"] " and " [:a {:href "/athletes/10525"} "Michał Staniszewski"] ", the 1995 World Champions and 1999 runners-up, came in second with enough points to bring them from sixth after the first round to a silver medal. With Wójs and Mordarski slipping to sixth in the second run, Jiras and Máder’s third-best time was enough to earn them bronze. The Hochschorner brothers would go on to win the C-2 slalom at the 2004 and 2008 Games."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Pair"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} [:a {:href "/athletes/90262"} "Pavol Hochschorner"] " / " [:a {:href "/athletes