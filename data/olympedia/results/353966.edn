ead of the South Africans, who in turn finished just over two seconds ahead of Italy."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/104360"} "Eric Murray"] " / " [:a {:href "/athletes/112414"} "Hamish Bond"]] [:td {} [:a {:href "/countries/NZL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NZL.png"}] "NZL"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/135735"} "Lawrence Brittain"] " / " [:a {:href "/athletes/112367"} "Shaun Keeling"]] [:td {} [:a {:href "/countries/RSA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RSA.png"}] "RSA"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/134630"} "Giovanni Abagnale"] " / " [:a {:href "/athletes/134633"} "Marco Di Costanzo"]] [:td {} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/134043"} "Alan Sinclair"] " / " [:a {:href "/athletes/134054"} "Stewart Innes"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {} [:a {:href "/athletes/112403"} "Germain Chardin"] " / " [:a {:href "/athletes/118275"} "Dorian Mortelette"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px;