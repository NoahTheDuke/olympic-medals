l-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/923645"} "146.5"] " / " [:a {:href "/athletes/119523"} "Gregor Schlierenzauer"] " " [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"] " / 22 February 2010 / " [:a {:href "/records/event_name/519"} "Details"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "K-Point: 125 m"]]]] [:div {:class "description"} [:p {} "The qualification round on 16 February confirmed excellent form by the Norwegians, " [:a {:href "/athletes/137753"} "Robert Johansson"] " who qualified in first place, followed by " [:a {:href "/athletes/137752"} "Johann André Forfang"] ". Japan’s " [:a {:href "/athletes/137476"} "Ryoyu Kobayashi"] ", starting at number 33, was the surprise of the qualification round, finishing third, and in the process, set a new hill record, with a mighty jump of 143.5 m, an improvement of four metres. After Kobayashi’s record, the remaining jumpers had to climb down from gate 18 to gate 16, and even 15 for the highest ranked jumpers."] "\n\n" [:p {} "In the final the next day, " [:a {:href "/athletes/109725"} "Kamil Stoch"] " was back in contention, taking the lead after the first round, followed by Austrian " [:a {:href "/athletes/127378"} "Michael Hayböck"] " and the gold medalist on the normal hill, " [:a {:href "/athletes/127867"} "Andreas Wellinger"] ". Hayböck had the longest jump of the round, 140 m. In the second round, lying a distant 15th place after his first jump, Norwegian " [:a {:href "/athletes/137755"} "Daniel-André Tande"] " took the lead with an excellent jump of 138.5 m, and was at the top in the leaderboard with the four best men from the first round still to jump. He was then overtaken, firstly, by countryman Johansson, and then Wellinger, who took the lead with a clear margin after the best jump of the day, 142 m. Hayböck could not respond and dropped down to sixth place, but Stoch kept calm, despite a difficult wind, and took a well-deserved gold medal."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/109725"} "Kamil Stoch"]] [:td {} [:a {:href "/countries/POL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/POL.png"}] "POL"]] [:td {} "125.6 (7)"] [:td {} "285.7 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/127867"} "Andreas Wellinger"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "127.1 (4)"] [:td {} "282.3 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/137753"} "Robert Johansson"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "131.9 (1)"] [:td {} "275.3 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/137755"} "Daniel-André Tande"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "126.5 (6)"] [:td {} "273.1 (4)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {} [:a {:href "/athletes/137752"} "Johann André Forfang"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flag