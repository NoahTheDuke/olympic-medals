7"} "Double Sculls, Men"] "\n" [:option {:value "319094"} "Coxless Pairs, Men"] "\n" [:option {:value "319107"} "Quadruple Sculls, Men"] "\n" [:option {:value "319191"} "Coxless Fours, Men"] "\n" [:option {:value "319000"} "Eights, Men"] "\n" [:option {:value "319171"} "Lightweight Double Sculls, Men"] "\n" [:option {:value "319040"} "Lightweight Coxless Fours, Men"] "\n" [:option {:value "319129"} "Single Sculls, Women"] "\n" [:option {:value "319120"} "Double Sculls, Women"] "\n" [:option {:value "319009"} "Quadruple Sculls, Women"] "\n" [:option {:value "319018"} "Coxless Pairs, Women"] "\n" [:option {:value "319053"} "Eights, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "159527"} "1996"] "\n" [:option {:value "159701"} "2000"] "\n" [:option {:value "159879"} "2004"] "\n" [:option {:value "261138"} "2008"] "\n" [:option {:value "354122"} "2016"] "\n" [:option {:value "19008589"} "2020"] "\n" [:option {:value "2012585"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/402"} "Event type"]] [:h1 {:class "event_title"} "Lightweight Double Sculls, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "29 July –  4 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/860"} "Eton Dorney, Windsor"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/319156"} "34 from 17 countries"]]]]] [:div {:class "description"} [:p {} "The Greek duo of " [:a {:href "/athletes/124732"} "Christina Giazitzidou"] " and " [:a {:href "/athletes/117956"} "Alexandra Tsiavou"] " were the reigning World Champions in the women’s lightweight double sculls, as well as the champions from 2009, but their prowess had waned somewhat over the past season, leaving the gold medal at the 2012 Olympics up for grabs. China’s team of " [:a {:href "/athletes/104203"} "Xu Dongxiang"] ", a 2006 World Champion and twice Olympic finalist, and rookie " [:a {:href "/athletes/122078"} "Huang Wenyi"] " had shown promise during the most recent World Cup, a tournament that saw New Zealand’s " [:a {:href "/athletes/126160"} "Louise Ayling"] " and " [:a {:href "/athletes/126162"} "Julia Edward"] " take home gold and set a world record time. Canada had won the 2010 World Championship and, although only " [:a {:href "/athletes/122781"} "Lindsay Jennerich"] " remained from that duo, she had still captured silver at the 2011 edition with her new partner " [:a {:href "/athletes/122793"} "Patricia Obee"] ". The Netherlands was the defending Olympic champion, but its lineup had changed since the 2008 Games and the nation had not been a factor at the World Championships since."] "\n\n" [:p {} "In the heats, however, a major surprise for Britain came when its duo, " [:a {:href "/athletes/123222"} "Katherine Copeland"] " and " [:a {:href "/athletes/123226"} "Sophie Hosking"] ", posted the fastest time by nearly seven seconds. Hosking was a veteran, having won four World Championship medals, including bronze in the lightweight double sculls in 2011, but Copeland was a new partner and a rookie on the senior international scene. The semi-finals proved that this was not a fluke, as they once again took the top time by over three seconds. In the final Greece pushed out to an early lead, which they held until the halfway point, but the Britons fought them the entire way and, by the 1500m mark, had placed themselves in a position where they would be nearly uncatchable. Copeland and Hosking won British women’s rowing third gold medal of the 2012 Games – and ever – while the Greeks had to settle for a bronze medal after being edged out by China for silver at the line."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/123222"} "Kat Copeland"] " / " [:a {:href "/athletes/123226"} "Sophie Hosking"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/104203"} "Xu Dongxiang"] " / " [:a {:href "/athletes/122078"} "Huang Wenyi"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/124732"} "Christina Giazitzidou"] " / " [:a {:href "/athletes/117956"} "Alexandra Tsiavou"]] [:td {} [:a {:href "/countries/GRE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GRE.png"}] "GRE"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/122910"} "Anne Lolk Thomsen"] " / " [:a {:href "/athletes/104212"} "Juliane Rasmussen"]] [:td {} [:a {:href "/countries/DEN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/DEN.png"}] "DEN"]] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {} [:a {:href "/athletes/123839"} "Bronwen Watson"] " / " [:a {:href "/athletes/123830"} "Hannah Every-Hall"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", 