ue "313000"} "Team All-Around, Men"] "\n" [:option {:value "313012"} "Floor Exercise, Men"] "\n" [:option {:value "313024"} "Vault, Men"] "\n" [:option {:value "313027"} "Parallel Bars, Men"] "\n" [:option {:value "313030"} "Horizontal Bar, Men"] "\n" [:option {:value "313021"} "Rings, Men"] "\n" [:option {:value "313018"} "Pommelled Horse, Men"] "\n" [:option {:value "313009"} "Individual All-Around, Women"] "\n" [:option {:value "313003"} "Team All-Around, Women"] "\n" [:option {:value "313015"} "Vault, Women"] "\n" [:option {:value "313039"} "Uneven Bars, Women"] "\n" [:option {:value "313036"} "Balance Beam, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "70178"} "1952"] "\n" [:option {:value "70203"} "1956"] "\n" [:option {:value "70239"} "1960"] "\n" [:option {:value "70283"} "1964"] "\n" [:option {:value "70327"} "1968"] "\n" [:option {:value "70389"} "1972"] "\n" [:option {:value "70447"} "1976"] "\n" [:option {:value "70505"} "1980"] "\n" [:option {:value "70563"} "1984"] "\n" [:option {:value "70621"} "1988"] "\n" [:option {:value "70679"} "1992"] "\n" [:option {:value "70737"} "1996"] "\n" [:option {:value "70821"} "2000"] "\n" [:option {:value "70905"} "2004"] "\n" [:option {:value "259988"} "2008"] "\n" [:option {:value "353680"} "2016"] "\n" [:option {:value "19009174"} "2020"] "\n" [:option {:value "2012274"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/328"} "Event type"]] [:h1 {:class "event_title"} "Floor Exercise, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "29 July –  7 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/872"} "North Greenwich Arena, Greenwich, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/313033"} "82 from 45 countries"]]]]] [:div {:class "description"} [:p {} "The women’s floor exercise event at the 2012 Summer Olympics had several strong competitors in contention for the gold medal. " [:a {:href "/athletes/117655"} "Kseniya Afanasyeva"] " of Russia was the reigning World Champion while " [:a {:href "/athletes/117661"} "Sandra Izbaşa"] " of Romania was the defending Olympic champion, a three time European Champion (2006, 2008, 2011), and had already won gold in the vault event earlier in the Games. The reigning European Champion was " [:a {:href "/athletes/121283"} "Larisa Iordache"] ", also from Romania, as was the runner-up " [:a {:href "/athletes/107141"} "Cătălina Ponor"] ", a three time Olympic gold medalist from the 2004 Games (including the floor exercises)."] "\n\n" [:p {} "The qualification round was won by " [:a {:href "/athletes/126759"} "Aly Raisman"] " of the United States, bronze medalist in the event at the most recent World Championships. Izbașa came in second, followed by " [:a {:href "/athletes/117690"} "Vanessa Ferrari"] " of Italy, the 2007 European Champion. Afanasyeva came in fourth, Ponor in seventh, and Iordache deep in the field at 32nd. Raisman went third in the finals and there was no question that she was the Olympic champion, earning a 15.600 with the highest difficulty and execution scores of the evening. Ponor came out next, putting forth a valiant effort to catch up to Raisman, but in the end the American was untouchable and Ponor settled for silver with 15.200 points. No other competitor scored above 15.000, leaving " [:a {:href "/athletes/120455"} "Aliya Mustafina"] " of Russia to capture bronze, her fourth medal of the Olympics after gold on the uneven bars, silver in the team all-around, and bronze in the individual all-around."] "\n"] [:table