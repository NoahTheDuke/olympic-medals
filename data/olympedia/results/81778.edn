ht: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Jury"] [:td {:style "width: 400px"} [:a {:href "/athletes/23812"} "Harold Van Buskirk"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Jury"] [:td {:style "width: 400px"} [:a {:href "/athletes/899391"} "Clarence, Greve von Rosen"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]]]]] [:div {:class "description"} [:p {} "Whenever it will be spoken in Olympic history about women’s fencing, one of the outstanding personalities was German-American defending champion " [:a {:href "/athletes/20711"} "Helene Mayer"] ". She was the clear favorite for gold, with no serious rivals, having won the 1929 and 1931 World Championships. Other medal contenders were Belgian " [:a {:href "/athletes/20526"} "Jenny Addams"] ", the 1930 World Champion, and Austria’s " [:a {:href "/athletes/20521"} "Ellen Preis"] ". Preis had placed third at the 1932 World Championships. Of dual German/Austrian nationality, she wanted to fence for Germany in 1932, but was denied by the German federation, possibly because of her Jewish heritage (although Mayer was also Jewish)."] "\n\n" [:p {} "In the preliminary round, Mayer demonstrated her superiority by winning all bouts. In the second preliminary round group, the Hungarian " [:a {:href "/athletes/20733"} "Erna Bogen"] " and Preis impressed the spectators."] "\n\n" [:p {} "Mayer’s boyfriend had died shortly before the Olympics began, and this may have affected her in the final pool, where Mayer was surprisingly upset by Addams by 5-4 hits, and lost by the same 