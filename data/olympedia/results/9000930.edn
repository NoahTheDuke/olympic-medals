:value "9000895"} "Slopestyle, Men"] "\n" [:option {:value "9000874"} "Halfpipe, Men"] "\n" [:option {:value "9000909"} "Cross, Men"] "\n" [:option {:value "9000884"} "Big Air, Men"] "\n" [:option {:value "9000975"} "Slopestyle, Women"] "\n" [:option {:value "9000954"} "Halfpipe, Women"] "\n" [:option {:value "9000989"} "Cross, Women"] "\n" [:option {:value "9000964"} "Big Air, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1664"} "2002"] "\n" [:option {:value "1752"} "2006"] "\n" [:option {:value "924415"} "2010"] "\n" [:option {:value "350557"} "2014"] "\n" [:option {:value "19020750"} "2022"] "\n" [:option {:value "15001244"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/525"} "Event type"]] [:h1 {:class "event_title"} "Parallel Giant Slalom, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "22 – 24 February 2018"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/940"} "Phoenix Snow Park, Mountain Cluster, Bongpyeong"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/9000930"} "31 from 14 countries"]]] [:tr {:class "referees", :style ""} [:th {} "Course Setter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5001393"} "Bernd Krug"]] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUT.png"}] "AUT"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Gates: 27" [:br {}] "Length: 595 m" [:br {}] "Start Altitude: 848 m" [:br {}] "Vertical Drop: 155 m"]]]] [:div {:class "description"} [:p {} "An intriguing event all about speed, the women’s parallel giant slalom competition at the 2018 Olympic Winter Games was held on 24 February at the Bogwang Phoenix Park. The shorter parallel slalom race from Sochi 2014 was dropped to add in the big air to the Olympic programme."] "\n\n" [:p {} "The granddaughter of two-time Olympic medalist ice hockey player " [:a {:href "/athletes/88014"} "Jan Klapáč"] ", snowboarder " [:a {:href "/athletes/127620"} "Ester Ledecká"] " from Czech Republic had long dominated the parallel giant slalom (PGS) world, winning gold at the World Championships in 2015 and 2017. A two-sport athlete, prior to the PGS in PyeongChang, Ledecka competed in alpine skiing’s super-G where she came out of nowhere on borrowed ski’s from " [:a {:href "/athletes/128669"} "Mikaela Shiffrin"] "’s to win an unexpected Olympic title by 0.01 seconds in one of the most insane races in Olympic history. The two-time World snowboarding champion shocked the alpine ski world and with one Olympic gold medal already around her neck, Ledecká was still the odds-on favourite for the parallel giant slalom title in 2018."] "\n\n" [:p {} "Also podium threats were the Sochi 2014 parallel slalom champion Austrian " [:a {:href "/athletes/127379"} "Julia Dujmovits"] ", Sochi bronze medalist Russia’s " [:a {:href "/athletes/119555"} "Alyona Zavarzina"] ", and two strong German World Cup performers " [:a {:href "/athletes/137330"} "Ramona Hofmeister"] " and her teammate " [:a {:href "/athletes/119627"} "Selina Jörg"] "."] "\n\n" [:p {} "The defending medalists from Sochi 2014 were unable to recapture medals this time around. Silver medalist " [:a {:href "/athletes/101487"} "Tomoka Takeuchi"] " from Japan was just edged out by Jörg in the quarter-finals, and gold medalist " [:a {:href "/athletes/128534"} "Patrizia Kummer"] " of Switzerland was unable to advance against eventual winner Ledecká. Austria’s " [:a {:href "/athletes/119578"} "Ina Meschik"] " who was just off the podium in fourth in Sochi, was unable to advance against Hofmeister."] "\n\n" [:p {} "So, a week after winning alpine gold in PyeongChang, Ledecká became the first woman to win Olympic Winter Games golds in different sports in the same Games, only the third athlete to ever accomplish this, the first since 1932, and one of just five in Winter Olympics history to win a gold medal in two separate sports. She simply would have made history by just competing, as no woman had ever competed in both alpine skiing and snowboarding in the same Olympic Winter Games."] "\n\n" [:p {} "Ledecká won the Big Final by 0.46 seconds against Jörg, and Hofmeister won the Small Final by 4.07 seconds against Zavarzina, who seemed to momentarily slip in both races (against Jörg in the semi-final heat and against Hofmeister in the Small Final). The silver medal went to Jörg, and the bronze went to Hofmeister. Zavarzina came in fourth place just off the podium."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "7"] [:td {} [:a {:href "/athletes/127620"} "Ester Ledecká"]] [:td {} [:a {:href "/countries/CZE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CZE.png"}] "CZE"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "16"] [:td {} [:a {:href "/athletes/119627"} "Selina Jörg"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "8"] [:td {} [:a {:href "/athletes/137330"} "Ramona Hofmeister"]] [:td {} [:a {:href