lue "63539"} "1988"] "\n" [:option {:value "64221"} "1992"] "\n" [:option {:value "64900"} "1996"] "\n" [:option {:value "65559"} "2000"] "\n" [:option {:value "66239"} "2004"] "\n" [:option {:value "257372"} "2008"] "\n" [:option {:value "302271"} "2012"] "\n" [:option {:value "358794"} "2016"] "\n" [:option {:value "19000543"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/84"} "Event type"]] [:h1 {:class "event_title"} "Discus Throw, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "5 –  7 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2157"} "Stade de France, Saint-Denis, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2013700"} "32 from 21 countries"]]]]] [:div {:class "description"} [:p {} "The favorites in this event were: Sweden’s " [:a {:href "/athletes/135988"} "Daniel Ståhl"] ", the defending gold medalist; Slovenian " [:a {:href "/athletes/146551"} "Kristjan Čeh"] ", the 2022 World Champion and 2024 European Champion; and " [:a {:href "/athletes/150306"} "Mykolas Alekna"] " (LTU), who had broken the long-standing (since 1986) world record in April 2024. Alekna’s father, " [:a {:href "/athletes/73209"} "Virgilijus"] ", was the gold medalist in the event in 2000 and 2004, and Mykolas was hoping to make them the first father-son pair to win athletics gold in the same individual event."] "\n\n" [:p {} "All three favorites made the final, as Alekna took the lead in round one with 68.55 metres, improving that to 69.97 in round two, which would be his best mark and good for silver. Ståhl never got going, recording a best mark of 66.95 in round two, and he would finish seventh. Čeh also struggled, his best mark coming in round two, 68.41 metres, that would eventually miss the podium in fourth. Australian " [:a {:href "/athletes/132468"} "Matthew Denny"] ", the 2022 Commonwealth Games and 2023 Diamond League Champion, briefly took the lead in round two with 69.31, before Alekna moved ahead, which would hold up for Denny for a bronze medal."] "\n\n" [:p {} "Jamaica’s little-known " [:a {:href "/athletes/150198"} "Rojé Stona"] " barely made the final rounds, standing seventh after round three with 66.16 metres. In round four, he uncorked a huge PR of 70.00 metres to take the lead. Despite fouls in rounds five and six, that throw would bring him a very surprising gold medal, the first ever medal for Jamaica in the event, and the second Olympic medal overall, after " [:a {:href "/athletes/150194"} "Rajindra Campbell"] "’s bronze in the shot put event three days before."] "\n\n" [:p {} "Stona attended college in the United States, at the University of Arkansas, where he trained with, and was coached by, three-time Olympic shot champion " [:a {:href "/athletes/136264"} "Ryan Crouser"] ". In a very deep Olympic competition, best-ever marks-for-place were recorded for 3rd and 6th through 9th place. Virgilijus Alekna’s Olympic record of 69.89 in 2004 was beaten twice, first by his son Mykolas, then by Rojé Stona."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "914"] [:td {} [:a {:href "/athletes/150198"} "Rojé Stona"]] [:td {} [:a {:href "/countries/JAM"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/JAM.png"}] "JAM"]] [:td {} "65.32 (6)"] [:td {} "70.00 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "1013"] [:td {} [:a {:href "/athletes/150306"} "Mykolas Alekna"]] [:td {} [:a {:href "/countries/LTU"} [:img {:style "