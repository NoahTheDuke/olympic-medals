thletes/59214"} "No Gyeong-Seon"] ", who had defeated Ivanov in the final match of Group B, and then defeated Turkey’s " [:a {:href "/athletes/60268"} "Ahmet Ak"] ", bronze medalist at the 1987 Worlds and silver medalist at the 1988 Europeans, to take third place. Mohammedian won another Olympic silver medal in 1992, that time as a featherweight."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Round Eliminated"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Classification Points", :class "footnote"} "CP"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "13"] [:td {} [:a {:href "/athletes/60450"} "Sergey Beloglazov"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "12"] [:td {} [:a {:href "/athletes/58800"} "Asgari Mohammadian"]] [:td {} [:a {:href "/countries/IRI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/IRI.png"}] "IRI"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "8"] [:td {} [:a {:href "/athletes/59214"} "No Gyeong-Seon"]] [:td {} [:a {:href "/countries/KOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KOR.png"}] "KOR"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "25"] [:td {} [:a {:href "/athletes/60268"} "Ahmet Ak"]] [:td {} [:a {:href "/countries/TUR