0"] "\n" [:option {:value "5866"} "1968"] "\n" [:option {:value "6484"} "1976"] "\n" [:option {:value "6756"} "1980"] "\n" [:option {:value "6975"} "1984"] "\n" [:option {:value "7284"} "1988"] "\n" [:option {:value "7642"} "1992"] "\n" [:option {:value "7995"} "1996"] "\n" [:option {:value "8368"} "2000"] "\n" [:option {:value "8772"} "2004"] "\n" [:option {:value "261502"} "2008"] "\n" [:option {:value "322083"} "2012"] "\n" [:option {:value "357013"} "2016"] "\n" [:option {:value "19000028"} "2020"] "\n" [:option {:value "2001531"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/556"} "Event type"]] [:h1 {:class "event_title"} "200 metres Freestyle, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "29 August 1972"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/543"} "Schwimmhalle, Olympiapark, München"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/6185"} "46 from 27 countries"]]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/51572"} "Mark Spitz"] " was the heavy favorite, as this was one of his four individual events in his attempt to win seven swimming gold medals in Munich. The day before the 200 freestyle, he had won his first two gold medals in the 200 butterfly and with the United States’ 4 x 100 freestyle relay team. His biggest challenger was thought to have been his teammate, " [:a {:href "/athletes/51355"} "Steve Genter"] ", but Genter had been hospitalized in Munich only four days earlier with a collapsed lung (pneumothorax), and had to have the air and fluid drained from his chest cavity. However, Genter heroically came to the line on Tuesday morning for the prelims and qualified for the final easily."] "\n\n" [:p {} "In the final Spitz went out fast, leading Soviet " [:a {:href "/athletes/50792"} "Vladimir Bure"] ", later a bronze medalist in the 100 free, at the first turn. But on the second lap, Genter took over the lead, 54.93 to Spitz’s 55.06. Spitz closed on the third lap, but Genter turned better to regain the lead for the final 50. Defending champion " [:a {:href ""} "Michael Wenden"] " of Australia closed to third at 150, but he fell back in the closing metres. The final lap was all Spitz who won by five metres and almost a second, with Genter taking a courageous silver. The bronze medal went to the fast closing " [:a {:href "/athletes/47867"} "Werner Lampe"] " of West Germany. For Spitz it was three down, four to go."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "571"] [:td {} [:a {:href "/athletes/51572"} "Mark Spitz"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "1:55.29 (1 h7)"] [:td {} "1:52.78 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "558"] [:td {} [:a {:href "/athletes/51355"} "Steve Genter"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "1:55.42 (1 h6)"] [:td {} "1:53.73 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "236"] [:td {} [:a {:href "/athletes/47867"} "Werner Lampe"]] [:td {} [:a {:href "/countries/FRG"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRG.png"}] "FRG"]] [:td {} "1:55.97 (1 h3)"] [:td {} "1:53.99 (3)"] [:td {