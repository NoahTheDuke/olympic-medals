lue "307000"} "Canadian Singles, Slalom, Men"] "\n" [:option {:value "307012"} "Canadian Doubles, Slalom, Men"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255438"} "1972"] "\n" [:option {:value "256065"} "1992"] "\n" [:option {:value "256201"} "1996"] "\n" [:option {:value "256310"} "2000"] "\n" [:option {:value "256430"} "2004"] "\n" [:option {:value "258863"} "2008"] "\n" [:option {:value "353600"} "2016"] "\n" [:option {:value "19006326"} "2020"] "\n" [:option {:value "2008437"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/181"} "Event type"]] [:h1 {:class "event_title"} "Kayak Singles, Slalom, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "30 July –  2 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/869"} "Lee Valley White Water Centre, Waltham Cross"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/307020"} "21 from 21 countries"]]]]] [:div {:class "description"} [:p {} "The champion in the kayak singles from the past two Olympics, Slovakian " [:a {:href "/athletes/10714"} "Elena Kaliská"] ", did not reappear to defend her title in 2012, having lost her spot in the event to " [:a {:href "/athletes/125120"} "Jana Dukatova"] ", the 2006 World Champion, during the trials. Dukatova was ranked number one in the world and was a favorite going into the event. The reigning World Champion was " [:a {:href "/athletes/125823"} "Corinna Kuhnle"] " of Austria, who first won the title in 2010. Other notable participants included Germany’s " [:a {:href "/athletes/125327"} "Jasmin Schornberg"] ", the 2009 World Champion, " [:a {:href "/athletes/9386"} "Štěpánka Hilgertová"] " of the Czech Republic, who had competed in the event in every edition of the Games since 1992 (winning in 1996 and 2000), and Australian " [:a {:href "/athletes/123753"} "Jessica Fox"] ", daughter of former World Champions " [:a {:href "/athletes/90262"} "Myriam"] " and " [:a {:href "/athletes/9742"} "Richard Fox"] "."] "\n\n" [:p {} "In this relatively more open field, each of the rounds had its share of unpredicted results. The fastest time in the heats came from Spain’s " [:a {:href "/athletes/116621"} "Maialen Chourraut"] ", a silver and bronze medalist at the World Championships in 2009 and 2011 respectively, with Britain’s " [:a {:href "/athletes/123203"} "Lizzie Neave"] " and Italy’s " [:a {:href ""} "Clara Giai"] " coming in second and third. In the semi-finals, however, both Neave and Giai were eliminated on penalties in a round won by Poland’s low-ranked " [:a {:href "/athletes/122367"} "Natalia Pacierpnik"] ". In the final Fox, who had the best time in the semi-finals before penalties, went third and had an outstanding run, but was bested by France’s " [:a {:href "/athletes/116614"} "Émilie Fer"] ", another surprise paddler whose only World Championship medal was gold in the K-1 Team Event in 2006. Third place was taken by Chourraut who, after near misses in the men’s C-1 and K-1 events, captured Spain’s first Olympic medal in canoe slalom. Hilgertová finished in fourth, 3.26 seconds off the podium, Dukatova in sixth, and Kuhnle in a distant last place in the final, having accrued 52 penalty points over the course."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "7"] [:td {} [:a {:href "/athletes/116614"} "Émilie Fer"]] [: