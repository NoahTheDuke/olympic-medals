624"} "2016"] "\n" [:option {:value "2013570"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/44"} "Event type"]] [:h1 {:class "event_title"} "1,500 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "3 –  7 August 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2106"} "Japan National Stadium, Kasumigaoka, Shinjuku, Tokyo"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19000422"} "47 from 27 countries"]]]]] [:div {:class "description"} [:p {} "The favorite was the 2019 World Champion, Kenyan " [:a {:href "/athletes/144858"} "Timothy Cheruiyot"] ", who had dominated the Diamond League circuit since 2018, with young Norwegian " [:a {:href "/athletes/145682"} "Jakob Ingebrigtsen"] ", close behind on the form chart. However, the two had raced 12 times since 2017, and Ingebrigtsen had yet to defeat Cheruiyot. The defending champion was American " [:a {:href "/athletes/126529"} "Matthew Centrowitz"] ", who was back and had recently set a personal best for the mile, running 3:49.26."] "\n\n" [:p {} "Centrowitz did not make the final, placing ninth in the second semi-final. Cheruiyot and Ingebritsen qualified easily and everyone expected the two to set a fast pace in the final, which they did."] "\n\n" [:p {} "Ingebrigtsen took the lead and led through the first lap of the final in 56.2. He was then passed by Cheruiyot who took over at 500 metres. The two pushed the pace through the first three laps, with Cheruiyot passing 800 metres in 1:51.76 and 1,200 metres in 2:47.24. On the final bend, Ingebrigtsen passed Cheruiyot, who could not answer, and the Norwegian pulled away on the straightaway to win the gold medal with five metres to spare over Cheruiyot."] "\n\n" [:p {} "Ingebrigtsen recorded 3:28.32 to Cheruiyot’s 3:29.01, setting an Olympic record and moving him to eighth all-time on the performer list. His finish was blazing for the pace, with the final 100 in 13.6 and the final 200 in 27.1. Behind the top two Great Britain’s " [:a {:href "/athletes/143104"} "Josh Kerr"] " also closed quickly for the bronze medal, running his final 800 metres in 1:49.9, as he set a personal best of 3:29.05, just failing to catch Cheruiyot."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "3081"] [:td {} [:a {:href "/athletes/145682"} "Jakob Ingebrigtsen"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "3:36.49 (4 h3)"] [:td {} "3:32.13 (2 h2)"] [:td {} "3:28.32 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "2770"] [:td {} [:a {:href "/athletes/144858"} "Timothy Cheruiyot"]] [:td {} [:a {:href "/countries/KEN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/KEN.png"}] "KEN"]] [:td {} "3:36.01 (2 h1)"] [:td {} "3:33.95 (3 h1)"] [:td {} "3:29.01 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "2052"] [:td {} [:a {:href "/athletes/143104"} "Josh Kerr"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {} "3:36.29 (7 h1)"] [:td {} "3:32.18 (3 h2)"] [:td {} "3:29.05 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "27