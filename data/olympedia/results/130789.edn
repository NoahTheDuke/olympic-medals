 Gardner"] "."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Round Eliminated"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Classification Points", :class "footnote"} "CP"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "13"] [:td {} [:a {:href "/athletes/59868"} "Aleksandr Karelin"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "10"] [:td {} [:a {:href "/athletes/57398"} "Rangel Gerovski"]] [:td {} [:a {:href "/countries/BUL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/BUL.png"}] "BUL"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "15"] [:td {} [:a {:href "/athletes/60056"} "Tomas Johansson"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "2"] [:td {} [:a {:href "/athletes/57767"} "Hassan El-Haddad"]] [:td {} [:a {:href "/countries/EGY"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/EGY.png"}] "EGY"]] [:td {} "–"] [:td {} "–"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {:class "bib"} "9"] [:td {} [:a {:href "/athletes/58590"} "László Klauz"]] [:td {} [:a 