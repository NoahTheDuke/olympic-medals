lue "19004709"} "Singles, Women"] "\n" [:option {:value "19004818"} "Doubles, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "44678"} "1920"] "\n" [:option {:value "44979"} "1924"] "\n" [:option {:value "900227"} "1968"] "\n" [:option {:value "900297"} "1968"] "\n" [:option {:value "45211"} "1988"] "\n" [:option {:value "45404"} "1992"] "\n" [:option {:value "45620"} "1996"] "\n" [:option {:value "45838"} "2000"] "\n" [:option {:value "46056"} "2004"] "\n" [:option {:value "262059"} "2008"] "\n" [:option {:value "324180"} "2012"] "\n" [:option {:value "353385"} "2016"] "\n" [:option {:value "2006680"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/610"} "Event type"]] [:h1 {:class "event_title"} "Doubles, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "1 August 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2126"} "Ariake Tennis Forest Park, Ariake, Koto, Tokyo, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19004780"} "64 from 23 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament."]]]] [:div {:class "description"} [:p {} "In the doubles, the top seeds were " [:a {:href "/athletes/142067"} "Barbora Krejčíková"] " and " [:a {:href "/athletes/142069"} "Kateřina Siniaková"] " of the Czech Republic, while the ROC had a strong pairing in " [:a {:href "/athletes/117640"} "Yelena Vesnina"] ", the 2016 gold medallist, and her new partner " [:a {:href "/athletes/146190"} "Veronika Kudermetova"] "."] "\n\n" [:p {} "Local favourites " [:a {:href "/athletes/144471"} "Shuko Aoyama"] " and " [:a {:href "/athletes/144469"} "Ena Shibahara"] " were also a fancied pairing, but the No. 2 seeds were eliminated on a third set match tie-break in the first round."] "\n\n" [:p {} "The quarter-finals saw " [:a {:href "/athletes/140696"} "Ash Barty"] ", beaten again, this time on a match tie-break by the top seeds Krejčíková and Siniaková. The Czech duo were the only seeds in the last four."] "\n\n" [:p {} "Krejčíková and Siniaková were pushed in their semi-final by Vesnina and Kudermetova, and only won after a match tie-break. The other semi-final saw Switzerland’s " [:a {:href "/athletes/146650"} "Belinda Bencic"] " reach her second final of the day with team-mate " [:a {:href "/athletes/146651"} "Viktorija Golubic"] "."] "\n\n" [:p {} "Bencic, " [:a {:href "/athletes/94261"} "Roger Federer"] "’s former mixed doubles partner, became only the fifth player after " [:a {:href "/athletes/ 94424"} "Serena"] " (2012) and " [:a {:href "/athletes/94425"} "Venus Williams"] " (2000), " [:a {:href "/athletes/117576"} "Andy Murray"] " (2012), and " [:a {:href "/athletes/94197"} "Nicolás Massú"] " (2004) to reach singles and doubles finals at the same Olympics since the sport’s return in 1988."] "\n\n" [:p {} "The bronze medal match saw " [:a {:href "/athletes/2101360"} "Luisa Stefani"] " and " [:a {:href "/athletes/147675"} "Laura Pigossi"] " make history as the first Brazilians to win an Olympic tennis medal. Sadly for Switzerland’s Belinda Bencic, there was no double joy as she and Viktorija Golubic lost to the number one seeds Krejčíková and Siniaková 7-5, 6-1."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/142067"} "Barbora Krejčíková"] " / " [:a {:href "/athletes/142069"} "Kateřina Siniaková"]] [:td {} [:a {:href "/countries/CZE"} [:img {:style