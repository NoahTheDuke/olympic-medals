"\n" [:h3 {:class "panel-title"} "\n" [:span {:class "glyphicon glyphicon-info-sign"}] "\nDid you know?\n"] "\n"] "\n" [:div {:class "panel-body"} "\n" [:p {} "The high altitude of Mexico City (2,134 m above sea level) helped cause a barrage of world records in track and field events, notably " [:a {:href "/athletes/78091"} "Bob Beamon"] "’s stunning 8.90 m long jump."] "\n\n\n"] "\n"] "\n" [:div {:class "container"} "\n" [:p {} "\n" [:a {:href "/users/sign_in"} "Login"] "\n|\n" [:a {:href "/statistics/site"} "Statistics"] "\n|\n" [:a {:href "/static/about"} "About"] "\n|\n" [:a {:href "/static/faq"} "FAQ"] "\n|\n" [:a {:href "/feedbacks/new"} "Feedback"] "\n"] "\n" [:p {} "\n© " [:a {:href "/static/about"} "OlyMADMen"] " 2006 — 2026\n"] "\n"] "\n"] "\n\n" [:script {:src "/assets/lightbox.min-a06f7b5a37bdc88a78a48f95b9149ca917761a07bffb855a6d73c1a435e16552.js"}] #object[org.jsoup.nodes.TextNode 0x53ae9c16 ""] [:script {} "\n  $('.footnote').tooltip();\n"] "\n"] "\n"] "\n")