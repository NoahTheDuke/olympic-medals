lue "2184"} "1924"] "\n" [:option {:value "2189"} "1928"] "\n" [:option {:value "2194"} "1932"] "\n" [:option {:value "2199"} "1936"] "\n" [:option {:value "2204"} "1948"] "\n" [:option {:value "2210"} "1952"] "\n" [:option {:value "2217"} "1956"] "\n" [:option {:value "2224"} "1960"] "\n" [:option {:value "2231"} "1964"] "\n" [:option {:value "2238"} "1968"] "\n" [:option {:value "2252"} "1976"] "\n" [:option {:value "2259"} "1980"] "\n" [:option {:value "2266"} "1984"] "\n" [:option {:value "2273"} "1988"] "\n" [:option {:value "2287"} "1992"] "\n" [:option {:value "2301"} "1994"] "\n" [:option {:value "2311"} "1998"] "\n" [:option {:value "2321"} "2002"] "\n" [:option {:value "2334"} "2006"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/368"} "Event type"]] [:h1 {:class "event_title"} "Individual, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "4 –  5 February 1972"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/109"} "Makomanai Cross Country Events Site, Sapporo"] " / " [:a {:href "/venues/112"} "Miyanomori Jump Hill, Sapporo"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2245"} "40 from 14 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Normal hill ski jumping and 15 kilometres skiing; placements determined by points table."]]]] [:div {:class "description"} [:p {} "Defending champion " [:a {:href "/athletes/87863"} "Franz Keller"] " and reigning World Champion from 1970, " [:a {:href "/athletes/97033"} "Ladislav Rygl"] " were among the contenders, but both showed poor form in the ski jumping and were too far behind to compete for medals. The 19-year old Japanese " [:a {:href "/athletes/95735"} "Hideki Nakano"] " was outstanding in the jumping, with the longest and best jump in all of the three rounds. However, his abilities as a cross-country skier were rather modest, ending last in the cross-country event and placing 13th in the final classification. The great surprise of the event was another 19-year old, the East German " [:a {:href "/athletes/98862"} "Ulrich Wehling"] ", placing fourth in the jumping event. To win, he had to beat his closest rival, the 22-year old Finn " [:a {:href "/athletes/95429"} "Rauno Miettinen"] " by approximately one minute in the cross-country, and the young and unmerited German skied well, achieving the third fastest time of the day and beating Miettinen by almost two minutes. His team-mate " [:a {:href "/athletes/91928"} "Karl-Heinz Luck"] " was fastest in the cross-country and advanced from 17th place in the jumping event to a bronze medal in the final classification."] "\n\n" [:p {} "This was the start of a rather unique career in Nordic Combined for Wehling, ending as the most successful Nordic Combined in the history of the Winter Olympics. He and Miettinen became the dominant figures in Nordic Combined for the rest of the decade. With his three Olympic Gold medals Wehling was the king of the Olympics. Miettinen is one of the few athletes who can claim five victories at the prestigious Holmenkollen."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Ski Jumping, Normal Hill"] [:th {} "Cross Country Skiing, 15 km"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/98862"} "Ulrich Wehling"]] [:td {} [:a {:href "/countries/GDR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GDR.png"}] "GDR"]] [:td {} "413.340"] [:td {} "200.9 (4)"] [:td {} "49:15.3 (3)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/95429"} "Rauno Miettinen"]] [:td {} [:a {:href "/coun