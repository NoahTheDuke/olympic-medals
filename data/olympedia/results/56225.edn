"} "1952"] "\n" [:option {:value "59390"} "1956"] "\n" [:option {:value "59789"} "1960"] "\n" [:option {:value "60226"} "1964"] "\n" [:option {:value "60678"} "1968"] "\n" [:option {:value "61188"} "1972"] "\n" [:option {:value "61763"} "1976"] "\n" [:option {:value "62325"} "1980"] "\n" [:option {:value "62818"} "1984"] "\n" [:option {:value "63462"} "1988"] "\n" [:option {:value "64137"} "1992"] "\n" [:option {:value "64828"} "1996"] "\n" [:option {:value "65488"} "2000"] "\n" [:option {:value "66164"} "2004"] "\n" [:option {:value "257298"} "2008"] "\n" [:option {:value "302440"} "2012"] "\n" [:option {:value "358704"} "2016"] "\n" [:option {:value "19000487"} "2020"] "\n" [:option {:value "2013644"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/75"} "Event type"]] [:h1 {:class "event_title"} "Pole Vault, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "25 April 1906"]] [:tr {} [:th {} "Status"] [:td {} "Intercalated"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/186"} "Panathinaiko Stadio, Athina"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/56225"} "11 from 8 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Final only."]]]] [:div {:class "description"} [:p {} "The favorite was France’s " [:a {:href "/athletes/68266"} "Fernand Gonder"] ", who had set several world records.  The rest of the field was very representative, however, perhaps the top internationally flavored Olympic event to date.  America’s " [:a {:href "/athletes/79725"} "Ed Glover"] " had won the 1905 AAU championship, while Sweden’s " [:a {:href "/athletes/76418"} "Bruno Söderström"] " was to win the 1907 AAA championship, which in 1908 would be taken by Canada’s " [:a {:href "/athletes/65950"} "Ed Archibald"] "."] "\n\n" [:p {} "Archibald was hampered in Athens, however, as his pole was lost on the train ride through Italy.  When the Canadian athletes arrived in Naples, the train officials refused permission for Archibald to carry the pole in the passenger’s coach, but agreed to secure it for him behind the engines.  When the train reached Tarranto, however, the pole was nowhere to be found.  A Greek official loaned him a pole, but it broke and almost impaled him, shattering his confidence.  He had been vaulting nearly 12 feet (3.65) in practice with his own pole, but never came close to that height in Athens with the strange poles."] "\n\n" [:p {} "The opening height was 2.50 m and, as in the " [:a {:href "/results/56223"} "high jump"] ", everybody was forced to jump at every height.  Through 3.30 m, only four competitors remained - Bruno Söderström, Ed Glover, " [:a {:href "/athletes/79664"} "Theodoros Makris"] ", and the world-record holder Fernand Gonder.  At 3.35 m, Glover and Makris went out.  Söderström was perfect through this height, the only competitor without a miss to that point.  Gonder and Söderström both made 3.40 m, but missed their two attempts at 3.50 m.  After Gonder missed his third effort, Söderström made his third attempt only to have his pole break in mid-flight.  A jump-off was started at 3.50 m and, this time, Gonder managed to clear on his first attempt to win the competition. Of the 11 competitors, all but Glover used a bamboo pole, the first time at the Olympics that bamboo was the predominant choice of the vaulters."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Best Height Cleared"] [:th {} "Attempts at 2.75 m"] [:th {} "Attempts at 3.00 m"] [:th {} "Attempts at 3.25 m"] [:th {} "Attempts at 3.35 m"] [:th {} "Attempts at 3.40 m"] [:th {} "Attempts at 3.50 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "214"] [:td {} [:a {:href "/athletes/68266"} "Fernand Gonder"]] [:td {} [:a {:hre