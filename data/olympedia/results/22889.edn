MYA.png"}] "MYA"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Judge / Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5001859"} "Ed Devery"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Judge / Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002547"} "I. Gruia"]] [:td {} [:a {:href "/countries/ROU"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ROU.png"}] "ROU"]]] [:tr {:class "hidden_referees", :style "display: none"} [:th {} "Judge / Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002985"} "Károly Kovács"]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"]]]]] [:div {:class "description"} [:p {} "The clear favourite for the welterweight division was " [:a {:href "/athletes/3409"} "Nicky Gargano"] " of Great Britain who had been European Champion in 1955. After defeating the Soviet Union’s " [:a {:href "/athletes/8485"} "Eduard Borisov"] " in his first bout it was assumed that he had a clear run to the final but that reckoned without " [:a {:href "/athletes/7921"} "Nicolae Linca"] " of Romania. With a close and unpopular, at least with the crowd, decision Linca upset Gargano in the semi-final. The other semi-final was contested between " [:a {:href "/athletes/4025"} "Fred Tiedt"] ", an Irishman of Austrian extraction, and the home favourite " [:a {:href "/athletes/5058"} "Kevin Hogarth"] ". Although he was comfortably out boxed by Tiedt, Hogarth did have the consolation of becoming the first Australian boxing medal winner since the 1908 Games. The final was the most controversial of the 1956 boxing tournament. Two judges gave the victory to Tiedt by comfortable margins but the three other had Linca narrowly in front. The Official Report of the Games considered Tiedt to be an “unlucky loser” and even decades later Irish sports fans still refer to it as a “robbery”. As of 2012, Linca is unique as the only Romanian to have won an Olympic title in boxing. His life ended tragically as he was stricken by Parkinson’s disease and later Alzheimer’s Disease."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/7921"} "Nicolae Linca"]] [:td {} [:a {:href "/countries/ROU"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ROU.png"}] "ROU"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/4025"} "Fred Tiedt"]] [:td {} [:a {:href "/countries/IRL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/IRL.png"}] "IRL"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/5058"} "Kevin Hogarth"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/3409"} "Nicky Gargano"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=5"] [:td {} [:a {:href "