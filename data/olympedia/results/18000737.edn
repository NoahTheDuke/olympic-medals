s, Men"] "\n" [:option {:value "18000728"} "Air Rifle, 10 metres, Men"] "\n" [:option {:value "18000731"} "Small-Bore Rifle, Three Positions, 50 metres, Men"] "\n" [:option {:value "18000740"} "Skeet, Men"] "\n" [:option {:value "18000743"} "Air Pistol, 10 metres, Women"] "\n" [:option {:value "18000746"} "Sporting Pistol, 25 metres, Women"] "\n" [:option {:value "18000751"} "Air Rifle, 10 metres, Women"] "\n" [:option {:value "18000754"} "Small-Bore Rifle, Three Positions, 50 metres, Women"] "\n" [:option {:value "18000760"} "Trap, Women"] "\n" [:option {:value "18000763"} "Skeet, Women"] "\n" [:option {:value "18000766"} "Air Pistol, 10 metres, Team, Mixed"] "\n" [:option {:value "18000769"} "Air Rifle, 10 metres, Team, Mixed"] "\n" [:option {:value "18000772"} "Trap, Team, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "51514"} "1900"] "\n" [:option {:value "51540"} "1908"] "\n" [:option {:value "51570"} "1912"] "\n" [:option {:value "51598"} "1920"] "\n" [:option {:value "51627"} "1924"] "\n" [:option {:value "51648"} "1952"] "\n" [:option {:value "51661"} "1956"] "\n" [:option {:value "51692"} "1960"] "\n" [:option {:value "51707"} "1964"] "\n" [:option {:value "51899"} "1996"] "\n" [:option {:value "51950"} "2000"] "\n" [:option {:value "52011"} "2004"] "\n" [:option {:value "261399"} "2008"] "\n" [:option {:value "321052"} "2012"] "\n" [:option {:value "395723"} "2016"] "\n" [:option {:value "2013117"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/494"} "Event type"]] [:h1 {:class "event_title"} "Trap, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "28 – 29 July 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2104"} "Asaka Shooting Range, Nerima, Tokyo"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/18000737"} "29 from 23 countries"]]]]] [:div {:class "description"} [:p {} "Contested for the 23rd time at the Olympics, trap was the most traditional shooting event held in Tokyo. After making all the shooting events gender equal for the Tokyo Games, this event saw the smallest field since 1920 with only 29 competitors. The field included all three medallists from the 2018 World Championships, with " [:a {:href "/athletes/111779"} "Alberto Fernández"] " (gold) and " [:a {:href "/athletes/111775"} "Erik Varga"] " (silver) both competing in their fourth Olympics, and " [:a {:href "/athletes/134462"} "Abdulrahman Al-Faihan"] " (bronze). Of the two World Shotgun Championships held since the last Olympics, only " [:a {:href "/athletes/125224"} "Jiří Lipták"] " (bronze in 2017), " [:a {:href "/athletes/143190"} "Matthew Coward-Holley"] " (gold in 2019) and " [:a {:href "/athletes/144195"} "Mauro De Filippis"] " (silver in 2019) competed. " [:a {:href "/athletes/111767"} "Josip Glasnović"] " was the only medallist from Rio to compete in Tokyo and he was also the last person to score a perfect 125 in the qualification round during the World Cup at Al-Ain back in April 2019. The world record for final rounds just before the Games was 48 hits and was secured by Fernández (twice), " [:a {:href "/athletes/136082"} "Yang Kun-Pi"] " and " [:a {:href "/athletes/104805"} "Naser Al-Meqlad"] ", but the latter was not present in Tokyo."] "\n\n" [:p {} "The qualification round was won by Lipták, who only missed one target to score 124. Four shooters scored 123 and another six scored 122. As a result, positions two to five saw a shoot-off and the last place in the final was also decided between six shooters in a shoot-off. This place was taken by " [:a {:href "/athletes/145333"} "Jorge Martín Orozco"] ", who finished fourth in the final. Coward-Holley won bronze for Great Britain to give them their first shooting medal of the Games and followed his compatriot " [:a {:href "/athletes/104811"} "Ed Ling"] ", who also won bronze in Rio. Lipták and " [:a {:href "/athletes/41735"} "David Kostelecký"] ", both from the Czech Republic, fought for gold in a shoot-off after both broke 43 of 50 targets. Kostelecký, who won Olympic gold back in 2008, missed the seventh target and placed second. The one-two finish of Lipták and Kostelecký was the first for a nation in this event since " [:a {:href "/athletes/44603"} "Mark Arie"] ", " [:a {:href "/athletes/44783"} "Frank Troeh"] " and " [:a {:href "/athletes/44794"} "Frank Wright"] " made a clean sweep for the United States 101 years ago, at the 1920 Olympics."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Qualifying Shoot-Off 2-5"] [:th {} "Qualifying Shoot-Off 6-11"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1275"] [:td {} [:a {:href "/athletes/125224"} "Jiří Lipták"]] [:td {} [:a {:href "/countries/CZE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CZE.png"}] "CZE"]] [:td {} "124 (1)"] [:td {} "–"] [:td {} "–"] [:td {} "43 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "1274"] [:td {} [:a {:href "/athletes/41735"} "David Kostelecký"]] [:td {} [:a {:href "/countries/CZE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CZE.png"}] "CZE"]] [:td {} "123 (4)"] [:td {} "5 (3)"] [:td {} "–"] [:td {} "43 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td 