n"] "\n" [:option {:value "9446"} "6 metres, Open"] "\n" [:option {:value "9459"} "8 metres, Open"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "9308"} "1924"] "\n" [:option {:value "9335"} "1928"] "\n" [:option {:value "9367"} "1932"] "\n" [:option {:value "9473"} "1948"] "\n" [:option {:value "9538"} "1952"] "\n" [:option {:value "9603"} "1956"] "\n" [:option {:value "9668"} "1960"] "\n" [:option {:value "9733"} "1964"] "\n" [:option {:value "9798"} "1968"] "\n" [:option {:value "9863"} "1972"] "\n" [:option {:value "9937"} "1976"] "\n" [:option {:value "10015"} "1980"] "\n" [:option {:value "10093"} "1984"] "\n" [:option {:value "10184"} "1988"] "\n" [:option {:value "10568"} "1996"] "\n" [:option {:value "10786"} "2000"] "\n" [:option {:value "11117"} "2004"] "\n" [:option {:value "261153"} "2008"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/412"} "Event type"]] [:h1 {:class "event_title"} "One Person Dinghy (Olympic Monotype), Open" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "4 – 10 August 1936"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/335"} "Kieler Förde, Kiel"] " (Innenförde)"]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/9420"} "28 from 25 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "25 points for first-place in each race, with scoring down to 1 point for 25th place."]]]] [:div {:class "description"} [:p {} "This class was termed the Olympic Monotype, as in " [:a {:href "/results/9308"} "1924"] ", but the two classes were much different. The 1936 Monotype class was actually known as the O-jolle, or Olympiajolle, and was designed by Hellmut Wilhelm Strauch in 1933 specifically for the 1936 Olympics. It was a Bermuda rig, also called a Marconi rig, with a specific design of mast and rigging."] "\n\n" [:p {} "The competition was held in boats provided by the organization. Each of them was named after a German city, and the eventual winner " [:a {:href "/athletes/62544"} "Daan Kagchelland"] " sailed in the “Nürnberg” (Nuremberg). The regattas were affected by the poor weather. Competition had to be suspended for an hour and a half on the first day due to stormy weather. Although the races were held, rain and heavy wind gave an advantage to the heavier sailors. By contrast, the remaining days were plagued by a lack of wind, causing the races to be postponed on three occasions."] "\n\n" [:p {} "The battle for the gold was between Kagchelland, German sailor " [:a {:href "/athletes/62663"} "Werner Krogmann"] " and Briton " [:a {:href "/athletes/63607"} "Peter Scott"] ". The latter took the lead on the first day, being joined by the Dutchman after four races. The sixth heat proved vital, as Kagchelland sailed to victory with Krogmann and Scott way back. The Dutch sailor would need only a 10th place in the final race to secure the gold. However, Krogmann and Scott collided, causing the British boat to forfeit and drop to bronze medal position."] "\n\n" [:p {} "Peter Scott was the son of Robert F. Scott, the famed polar explorer who died on Antarctica in 1912 after losing the race to the South Pole to Norwegian Roald Amundsen."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Race #1"] [:th {} "Race #2"] [:th {} "Race #3"] [:th {} "Race #4"] [:th {} "Race #5"] [:th {} "Race #6"] [:th {} "Race #7"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/62544"} "Daan Kagchelland"]] [:td