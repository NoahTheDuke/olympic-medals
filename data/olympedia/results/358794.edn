href "/athletes/134109"} "Daniel Jasinski"] "’s bronze medal gave Germany two athletes on the podium."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "2496"] [:td {} [:a {:href "/athletes/134108"} "Christoph Harting"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "65.41 (3)"] [:td {} "68.37 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "2847"] [:td {} [:a {:href "/athletes/114697"} "Piotr Małachowski"]] [:td {} [:a {:href "/countries/POL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/POL.png"}] "POL"]] [:td {} "65.89 (1)"] [:td {} "67.55 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "2503"] [:td {} [:a {:href "/athletes/134109"} "Daniel Jasinski"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "62.83 (11)"] [:td {} "67.05 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "2380"] [:td {} [:a {:href "/athletes/133732"} "Martin Kupper"]] [:td {} [:a {:href "/countries/EST"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/EST.png"}] "EST"]] [:td {} "62.92 (10)"] [:td {} "66.58 (4)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {:class "bib"} "2377"] [:td {} [:a {