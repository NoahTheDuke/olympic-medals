4"} "100 metres Freestyle, Men"] "\n" [:option {:value "19000028"} "200 metres Freestyle, Men"] "\n" [:option {:value "19000040"} "400 metres Freestyle, Men"] "\n" [:option {:value "19000054"} "1,500 metres Freestyle, Men"] "\n" [:option {:value "19000061"} "4 × 100 metres Freestyle Relay, Men"] "\n" [:option {:value "19000066"} "4 × 200 metres Freestyle Relay, Men"] "\n" [:option {:value "19000071"} "100 metres Backstroke, Men"] "\n" [:option {:value "19000083"} "200 metres Backstroke, Men"] "\n" [:option {:value "19000094"} "100 metres Breaststroke, Men"] "\n" [:option {:value "19000106"} "200 metres Breaststroke, Men"] "\n" [:option {:value "19000117"} "100 metres Butterfly, Men"] "\n" [:option {:value "19000129"} "200 metres Butterfly, Men"] "\n" [:option {:value "19000140"} "200 metres Individual Medley, Men"] "\n" [:option {:value "19000151"} "400 metres Individual Medley, Men"] "\n" [:option {:value "19000159"} "4 × 100 metres Medley Relay, Men"] "\n" [:option {:value "19000164"} "50 metres Freestyle, Women"] "\n" [:option {:value "19000181"} "100 metres Freestyle, Women"] "\n" [:option {:value "19000194"} "200 metres Freestyle, Women"] "\n" [:option {:value "19000205"} "400 metres Freestyle, Women"] "\n" [:option {:value "19000213"} "800 metres Freestyle, Women"] "\n" [:option {:value "19000221"} "1,500 metres Freestyle, Women"] "\n" [:option {:value "19000228"} "4 × 100 metres Freestyle Relay, Women"] "\n" [:option {:value "19000233"} "4 × 200 metres Freestyle Relay, Women"] "\n" [:option {:value "19000238"} "100 metres Backstroke, Women"] "\n" [:option {:value "19000250"} "200 metres Backstroke, Women"] "\n" [:option {:value "19000261"} "100 metres Breaststroke, Women"] "\n" [:option {:value "19000274"} "200 metres Breaststroke, Women"] "\n" [:option {:value "19000285"} "100 metres Butterfly, Women"] "\n" [:option {:value "19000297"} "200 metres Butterfly, Women"] "\n" [:option {:value "19000307"} "200 metres Individual Medley, Women"] "\n" [:option {:value "19000318"} "400 metres Individual Medley, Women"] "\n" [:option {:value "19000326"} "4 × 100 metres Medley Relay, Women"] "\n" [:option {:value "19000331"} "4 × 100 metres Medley Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "2001551"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/2569"} "Event type"]] [:h1 {:class "event_title"} "800 metres Freestyle, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "27 – 29 July 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2105"} "Olympic Aquatics Centre, 2-1, 2chome, Tatsumi, Koto-ku, Tatsumi-no-Mori Seaside Park, Tokyo, Japan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19000047"} "33 from 28 countries"]]]]] [:div {:class "description"} [:p {} "The 800 metre freestyle, long a staple at the World Championships, had last been contested at the 1904 Olympics in St. Louis, when it was raced over 880 yards. With the addition of the women’s 1,500 metre freestyle to the 2020 Olympic Program, FINA also lobbied to equalize the program and add the men’s 800, which was approved."] "\n\n" [:p {} "The favorite was the Italian distance specialist " [:a {:href "/athletes/124275"} "Gregorio Paltrinieri"] ", who had won this event at the 2019 World Championships, and was the World 1,500 metre champion in 2015 and 2017. Also formidable was Ukraine’s " [:a {:href "/athletes/136206"} "Mykhailo Romanchuk"] ". Romanchuk led the qualifiers with 7:41.28 just head of German " [:a {:href "/athletes/134244"} "Florian Wellbrock"] ", who recorded 7:41.77, but the biggest shock was that Paltrinieri barely qualified, finishing eighth in 7:47.63, obviously resting for the final, but it almost cost him."] "\n\n" [:p {} "Paltrinieri made no such mistake in the final two days later, taking the lead on the first lap and holding it through 700 metres, followed by Wellbrock and Romanchuk for most of the race, although Wellbrock took the lead at 750 metres. American " [:a {:href "/athletes/147477"} "Robert Finke"] " lingered back in fifth for most of the race, but at 750 metres he had moved into fourth and he looked to have a shot at a medal."] "\n\n" [:p {} "It was more than that. Finke shattered the field over the final 50, splitting 26.39, a last lap that was over 1½ seconds faster than the next fastest split (Australian " [:a {:href "/athletes/132553"} "Jack McLoughlin"] "’s 28.00 back in fifth), and it brought Finke all the way to the top of the podium and a completely surprising gold medal. Paltrinieri held on for silver while Romanchuk took bronze."] "\n\n" [:p {} "American men’s distance swimming had been in the doldrums, as no USA male had won a gold medal in the 1,500 metres since " [:a {:href "/athletes/51511"} "Mike O’Brien"] " in 1984. To prove that his 800 gold was no fluke, Finke would come back on the last day of swimming at the Tokyo Olympics and add a second gold in the 1,500 metre freestyle."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/147477"} "Bobby Finke"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "7:42.72 (3 h4)"] [:td {} "7:41.87 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {