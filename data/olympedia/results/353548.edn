value "353542"} "Canadian Singles, Slalom, Men"] "\n" [:option {:value "353600"} "Kayak Singles, Slalom, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255417"} "1972"] "\n" [:option {:value "256036"} "1992"] "\n" [:option {:value "256166"} "1996"] "\n" [:option {:value "256285"} "2000"] "\n" [:option {:value "256402"} "2004"] "\n" [:option {:value "258832"} "2008"] "\n" [:option {:value "307012"} "2012"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/175"} "Event type"]] [:h1 {:class "event_title"} "Canadian Doubles, Slalom, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "8 – 11 August 2016"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/904"} "Estádio de Canoagem Slalom, Parque Olímpico de Deodoro, Deodoro, Rio de Janeiro"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/353548"} "24 from 12 countries"]]]]] [:div {:class "description"} [:p {} "The Slovakian Hochschorner twins, " [:a {:href "/athletes/90262"} "Pavol"] " and " [:a {:href "/athletes/90263"} "Peter"] ", had been the 2000, 2004, and 2008 Olympic Champions in the Men’s C-2 Slalom, but had been bested by Britain’s " [:a {:href "/athletes/123201"} "Tim Baillie"] " and " [:a {:href "/athletes/123204"} "Etienne Stott"] " in 2012. Nonetheless, Slovakia’s prospects remained considerable in Rio thanks to another set of relatives, cousins " [:a {:href "/athletes/135975"} "Ladislav"] " and " [:a {:href "/athletes/135977"} "Peter Škantár"] ", who were the 2007, 2010, and 2014 European Champions, 2008 European and 2009 World runners-up, and bronze medallists, at the 2011, 2013, and 2014 Worlds and 2004, 2005, and 2011 Europeans. Britain, meanwhile, was represented by " [:a {:href "/athletes/116471"} "David Florence"] " and " [:a {:href "/athletes/123202"} "Richard Hounslow"] ", the 2012 Olympic runners-up, as well as the 2013 World Champions, and the 2010 World and 2010 and 2015 European bronze medallists. Other contenders were Germany’s " [:a {:href "/athletes/134139"} "Franz Anton"] " and " [:a {:href "/athletes/116470"} "Jan Benzien"] ", the reigning World Champions and 2015 European runners-up, and Slovenia’s " [:a {:href "/athletes/125752"} "Luka Božič"] " and " [:a {:href "/athletes/125774"} "Sašo Taljat"] ", the 2014 World Champions, 2016 European runners-up, and 2009 World and 2014 European bronze medallists."] "\n\n" [:p {} "The Škantár cousins had little trouble winning the preliminaries, although the French duo of " [:a {:href "/athletes/124656"} "Gauthier Klauss"] " and " [:a {:href "/athletes/124658"} "Matthieu Péché"] ", the 2015 World bronze medallists, were able to finish ahead of Florence and Hounslow. The semifinals were won by Anton and Benzien, while Florence and Hounslow remained third behind Czechs " [:a {:href "/athletes/133416"} "Jonáš Kašpar"] " and " [:a {:href "/athletes/133418"} "Marek Šindler"] ". Kašpar and Šindler were impressive in the finals as well, but flipped over during their run, which ended their chances for a medal. The Škantár cousins, therefore, took gold without much trouble, and were followed by Great Britain and France respectively on the podium."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Pair"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "5-A/5-B"] [:td {} [:a {:href "/athletes/135975"} "Ladislav Škantár"] " / " [:a {:href "/athletes/135977"} "Peter Škantár"]] [:td {} 