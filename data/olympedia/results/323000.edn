etes/116141"} "Huang Xuechen"] " and " [:a {:href "/athletes/116142"} "Liu Ou"] ", who had been fourth in Beijing."] "\n\n" [:p {} "This was the fourth consecutive victory in this event for a Russian pair. Ishchenko and Romashina would also win gold on the Russian team that won the team event. Japan failed to medal in this event for the first time ever, as " [:a {:href "/athletes/120837"} "Yukiko Inui"] " and " [:a {:href "/athletes/120839"} "Chisa Kobayashi"] " placed fifth."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/116134"} "Nataliya Ishchenko"] " / " [:a {:href "/athletes/116137"} "Svetlana Romashina"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]] [:td {} "196.800 (1)"] [:td {} "197.100 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/124830"} "Ona Carbonell"] " / " [:a {:href "/athletes/107723"} "Andrea Fuentes"]] [:td {} [:a {:href "/countries/ESP"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ESP.png"}] "ESP"]] [:td {} "192.590 (3)"] [:td {} "192.900 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/116141"} "Huang Xuechen"] " / " [:a {:href "/athletes/116142"} "Liu Ou"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} "192.810 (2)"] [:td {} "192.870 (3)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", 