4526"} "28 from 13 countries"]]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/1120"} "3:57.70"] " " [:span {:class "label label-primary"} "WR"] " / " [:a {:href "/athletes/82053"} "Claudia Pechstein"] " " [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"] " / 10 February 2002 / " [:a {:href "/records/event_name/540"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002185"} "Garth Linder"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002691"} "Jan Augustinus"]] [:td {} [:a {:href "/countries/NED"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NED.png"}] "NED"]]]]] [:div {:class "description"} [:p {} "Since the 2006 Games, " [:a {:href "/athletes/109768"} "Martina Sáblíková"] " had emerged as the first successful skater from the Czech Republic. She won the 2007 world title in the 3,000 m, three titles in the 5,000 m and had taken the long distance overall World Cup in the past three seasons. She had also become World All-round Champion in 2009, and won the European title in 2007 and 2010. Two of Sáblíková’s expected top opponents were not in medal contention. " [:a {:href "/athletes/82053"} "Claudia Pechstein"] ", the 2002 champion, had been suspended for illegal blood values at the 2009 World Championships. Since she had not actually been caught using doping, Pechstein had fought this suspension right up to the Olympics at several courts, but without success. Two-time silver medallist and reigning World Champion " [:a {:href "/athletes/100966"} "Renate Groenewold"] " was competing in Richmond, but her season had been plagued by injuries and she had even considered not going to the Games after a poor showing at the Dutch Olympic Trials."] "\n\n" [:p {} "The first medal contender to skate, Sáblíková laid down a very consistent race, with 31-second laps for all but the final lap. Her 4:02.53 turned out to be too fast for the rest of the field. German " [:a {:href "/athletes/119729"} "Stephanie Beckert"] ", who had twice beaten Sáblíková during World Cup races earlier in the season, fought out a close duel with " [:a {:href "/athletes/100968"} "Kristina Groves"] ", but both remained out of reach. Beckert trailed Groves for nearly the entire race, but powered past the Canadian with her trademark fast final lap. In the final pair, " [:a {:href "/athletes/100971"} "Daniela Anschütz-Thoms"] " appeared to add a second German medal, but she lost her 0.6-advantage over Groves to finish fourth by just 0.02 seconds."] "\n"] [:button {:id "button746782", :class "btn btn-default"} "Details"] [:script {} "$('#button746782').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "200 m"] [:th {:style "display: none", :class "split"} "600 m"] [:th {:style "display: none", :class "split"} "1000 m"] [:th {:style "display: none", :class "split"} "1400 m"] [:th {:style "display: none", :class "split"} "1800 m"] [:th {:style "display: none", :class "split"} "2200 m"] [:th {:style "display: none", :class "split"} "2600 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "11O"] [:td {} [:a {:href "/athletes/109768"} "Martina Sáblíková"]] [:td {} [:a {:href "/countries/CZE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.