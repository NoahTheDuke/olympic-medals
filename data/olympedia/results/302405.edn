2514"} "High Jump, Women"] "\n" [:option {:value "302198"} "Pole Vault, Women"] "\n" [:option {:value "9031008"} "Long Jump, Women"] "\n" [:option {:value "9031022"} "Triple Jump, Women"] "\n" [:option {:value "302181"} "Shot Put, Women"] "\n" [:option {:value "302021"} "Discus Throw, Women"] "\n" [:option {:value "302480"} "Hammer Throw, Women"] "\n" [:option {:value "302463"} "Javelin Throw, Women"] "\n" [:option {:value "302147"} "Heptathlon, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "65799"} "2000"] "\n" [:option {:value "66512"} "2004"] "\n" [:option {:value "257659"} "2008"] "\n" [:option {:value "359110"} "2016"] "\n" [:option {:value "19000784"} "2020"] "\n" [:option {:value "2013953"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/110"} "Event type"]] [:h1 {:class "event_title"} "20 kilometres Race Walk, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "11 August 2012 — 17:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/877"} "The Mall, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/302405"} "61 from 33 countries"]]]]] [:div {:class "description"} [:p {} "The top women’s walker for the past few years had been Russian " [:a {:href "/athletes/116959"} "Olga Kaniskina"] ". She was the defending champion and had won the World Championships in 2007, 2009, and 2011. The London race was expected to be between her and her youthful teammate, 20-year-old " [:a {:href "/athletes/120585"} "Yelena Lashmanova"] ". That was how it worked out as the two separated themselves from the pack, with only China’s " [:a {:href "/athletes/122525"} "Qieyang Shenjie"] " staying with them near the end. After 19 km Kaniskina seemed to have the race in hand, leading and in control, but it was Lashmanova who finished fastest and came down the 10th lap of the race to win in 1-25:02, seven seconds ahead of Kaniskina, setting an Olympic and world record in the process. Lashmanova’s final lap of 8:07 was the fastest split of the race. Qieyang won bronze, followed by her teammate " [:a {:href "/athletes/116960"} "Liu Hong"] " in fourth. The fifth-place finisher was Russian " [:a {:href "/athletes/120583"} "Anisya Kirdyapkina"] ", whose husband, " [:a {:href "/athletes/115456"} "Sergey Kirdyapkin"] ", had just won the 50 km walk that morning."] "\n\n" [:p {} "That was how the event and the results seemed to have ended. In 2015, however, the IOC began re-testing samples from the 2008 Beijing and 2012 London Olympics, using newer, more advanced testing techniques, in an effort to find those who had used performance enhancing drugs (PEDs), but in whom it could not be detected at the time of those Olympics. This was one of the many events affected."] "\n\n" [:p {} "In January 2015 Russian " [:a {:href "/athletes/116959"} "Olga Kaniskina"] ", the original silver medalist, was disqualified for a biological passport offense, losing her silver medal. Chinese walkers " [:a {:href "/athletes/122525"} "Qieyang Shenjie"] " and Liu Hong were advanced to the silver and bronze medals, respectively. In March 2022 " [:a {:href "/athletes/120585"} "Yelena Lashmanova"] " was disqualified by the Athletic Integrity Unit (AIU) and she accepted the sanction proposed by the AIU which caused her to lose the gold medal in this event. In March 2023 the IOC announced medal re-allocations which ended up with China sweeping the medals in the event - gold to Qieyang Shenjie, silver to Liu Hong, and bronze to Li Xiuzhi."] "\n"] [:button {:id "button721032", :class "btn btn-default"} 