n" [:option {:value "255058"} "Kayak Singles, 10,000 metres, Men"] "\n" [:option {:value "255059"} "Kayak Doubles, 1,000 metres, Men"] "\n" [:option {:value "255067"} "Canadian Singles, 1,000 metres, Men"] "\n" [:option {:value "255073"} "Canadian Singles, 10,000 metres, Men"] "\n" [:option {:value "255074"} "Canadian Doubles, 1,000 metres, Men"] "\n" [:option {:value "255080"} "Canadian Doubles, 10,000 metres, Men"] "\n" [:option {:value "255081"} "Kayak Singles, 500 metres, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255013"} "1936"] "\n" [:option {:value "255037"} "1948"] "\n" [:option {:value "255102"} "1956"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/164"} "Event type"]] [:h1 {:class "event_title"} "Kayak Doubles, 10,000 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "27 July 1952 — 17:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/372"} "Taivallahti, Helsinki"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/255066"} "36 from 18 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Final only."]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/10813"} "Gunnar Åkerlund"] " and " [:a {:href "/athletes/10811"} "Hans Wetterström"] " were, among other titles, the reigning Olympic and World Champions in the K-2 10,000, and favorites to repeat their victory at the " [:a {:href "/results/255037"} "1952 Summer Olympics"] ". Their strongest challengers included " [:a {:href "/athletes/10405"} "Ivar Mathisen"] " and " [:a {:href "/athletes/10424"} "Knut Østby"] " of Norway, the 1948 Olympic K-2 10,000 and 1950 World K-2 1,000 runners-up, and " [:a {:href "/athletes/9452"} "Ingvard Nørregaard"] " and " [:a {:href "/athletes/9431"} "Svend Frømming"] " of Denmark, the 1950 World K-2 10,000 silver medalists."] "\n\n" [:p {} "It was " [:a {:href "/athletes/9535"} "Yrjö Hietanen"] " and " [:a {:href "/athletes/9565"} "Kurt Wires"] " of Finland who led the race for the entire course, however, the latter of whom was the 1948 Olympic runner-up in the " [:a {:href "/results/255030"} "K-1 10,000"] ". Near the end, the Swedes undertook a strong drive to overtake the Finns that nearly succeeded, but Hietanen and Wires were able to respond in kind and just barely claimed the gold medal at the finish line, with only 0.4 seconds to spare. The 1948 champions, therefore, had to settle for silver, while the Hungarian duo of " [:a {:href "/athletes/10111"} "Ferenc Varga"] " and " [:a {:href "/athletes/10060"} "József Gurovits"] " captured a surprise bronze medal. Hietanen and Wires, meanwhile, would go on to win another gold medal against Sweden in the " [:a {:href "/results/255059"} "K-2 1,000"] " the following day."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {} "Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/9565"} "Kurt Wires"] " / " [:a {:href "/athletes/9535"} "Yrjö Hietanen"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]] [:td {} "44:21.3"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/10813"} "Gunnar Åkerlund"] " / " [:a {:href "/athletes/10811"} "Hans Wetterström"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://o