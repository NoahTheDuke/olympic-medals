lue "42579"} "Singles, Women"] "\n" [:option {:value "42650"} "Doubles, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "900350"} "1972"] "\n" [:option {:value "90016770"} "1988"] "\n" [:option {:value "42432"} "1996"] "\n" [:option {:value "42878"} "2004"] "\n" [:option {:value "258178"} "2008"] "\n" [:option {:value "304234"} "2012"] "\n" [:option {:value "351789"} "2016"] "\n" [:option {:value "19005436"} "2020"] "\n" [:option {:value "2005839"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/127"} "Event type"]] [:h1 {:class "event_title"} "Doubles, Mixed" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "16 – 21 September 2000"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/746"} "The Dome and Exhibition Complex, Olympic Park, Sydney, New South Wales"] " (Pavilion 4)"]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/42688"} "54 from 14 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament."]]]] [:div {:class "description"} [:p {} "The #1 seeds were the Indonesian team of " [:a {:href "/athletes/247"} "Minarti Timur"] " and " [:a {:href "/athletes/254"} "Tri Kushharyanto"] ". They would make it to the final but they were beaten there by the Chinese pair of " [:a {:href "/athletes/89244"} "Gao Ling"] " and " [:a {:href "/athletes/82700"} "Zhang Jun"] ", the 2nd seeds. Gao and Zhang had only been playing together for a year prior to the Sydney Olympics, and they had lost twice earlier in the year to Timur and Kusharyanto. They had a difficult road to the final, winning three-set matches in both the first round and semi-final. In the final, they looked overmatched early, as Timur/Kusharyanto won the first game 15-1. But Zhang/Gao fought back and won the final two games to win a surprising gold medal. The bronze medal match was unusual as it consisted of two European teams, the British pair " [:a {:href "/athletes/73"} "Joanne Wright-Goode"] " and " [:a {:href "/athletes/75"} "Simon Archer"] ", who defeated the Danish team of " [:a {:href "/athletes/2368"} "Rikke Olsen"] " and " [:a {:href "/athletes/2393"} "Michael Søgaard"] ". This was the first big title for Zhang and Gao but not the last. They would win the World Championships in 2001, the All-England Titles in 2001, 2003, and 2006, and defend their Olympic title in 2004. Gao would then combine with " [:a {:href "/athletes/105864"} "Zheng Bo"] " to win the World Championships in mixed doubles in 2007-08."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/89244"} "Gao Ling"] " / " [:a {:href "/athletes/82700"} "Zhang Jun"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/247"} "Minarti Timur"] " / " [:a {:href "/athletes/254"} "Tri Kusharyanto"]] [:td {} [:a {:href "/countries/INA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/INA.png"}] "INA"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/73"} "Joanne Goode"] " / " [:a {:href "/athletes/75"} "Simon Archer"]] [:td {} [:a {:href "/