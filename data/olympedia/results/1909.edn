on {:value "1908"} "50 kilometres, Men"] "\n" [:option {:value "1913"} "10 kilometres, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1897"} "1936"] "\n" [:option {:value "1903"} "1948"] "\n" [:option {:value "1917"} "1956"] "\n" [:option {:value "1928"} "1960"] "\n" [:option {:value "1939"} "1964"] "\n" [:option {:value "1951"} "1968"] "\n" [:option {:value "1963"} "1972"] "\n" [:option {:value "1975"} "1976"] "\n" [:option {:value "1988"} "1980"] "\n" [:option {:value "2001"} "1984"] "\n" [:option {:value "2015"} "1988"] "\n" [:option {:value "2032"} "1992"] "\n" [:option {:value "2052"} "1994"] "\n" [:option {:value "2072"} "1998"] "\n" [:option {:value "2104"} "2002"] "\n" [:option {:value "2148"} "2006"] "\n" [:option {:value "923569"} "2010"] "\n" [:option {:value "350069"} "2014"] "\n" [:option {:value "9000280"} "2018"] "\n" [:option {:value "19019715"} "2022"] "\n" [:option {:value "15000136"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/191"} "Event type"]] [:h1 {:class "event_title"} "4 × 10 kilometres Relay, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "23 February 1952 — 12:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/100"} "Holmenkollen Langrennssentret, Oslo"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1909"} "52 from 13 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: ?" [:br {}] "Height Differential: 160 m / 140 m" [:br {}] "Maximum Climb: ?" [:br {}] "Total Climbing: ?"]]]] [:div {:class "description"} [:p {} "The Finnish squad was heavily favored in the relay, organised three days after the " [:a {:href "/results/1908"} "50 km race"] ", with the Swedish book " [:strong {} [:em {} "Olympiaboken"]] " noting, “Finland would win as a given.” In addition to the three skiers who placed second, third and fourth in the " [:a {:href "/results/1907"} "18 km race"] ", they selected " [:a {:href "/athletes/88530"} "Urpo Korhonen"] " for the third leg instead of " [:a {:href "/athletes/86390"} "Veikko Hakulinen"] ", the newly crowned 50 km champion. Norway used their quartet from the 18 km race, and Sweden decided to put " [:a {:href "/athletes/91969"} "Martin Lundström"] ", the Olympic Champion at " [:a {:href "/results/1901"} "18 km in 1948"] ", on their anchor leg."] "\n\n" [:p {} [:a {:href "/athletes/86504"} "Heikki Hasu"] " took a commanding lead for Finland on the first leg and, at the exchange, he was 1:18 ahead of Sweden’s " [:a {:href "/athletes/98460"} "Nils Täpp"] ", with Norway’s " [:a {:href "/athletes/85573"} "Magnar Estenstad"] " another disappointing 33 seconds behind. Estenstad was apparently not fully recovered after the 50 km race. On the second leg, " [:a {:href "/athletes/91902"} "Paavo Lonkila"] " increased Finland’s lead to over 2½ minutes. Norway’s " [:a {:href "/athletes/87985"} "Mikal Kirkholt"] " was able to almost catch the Swede " [:a {:href "/athletes/83617"} "Sigurd Andersson"] ", and he was only one second behind at the exchange. On the third leg, " [:a {:href "/athletes/74227"} "Martin Stokken"] " had the fastest time and brought Norway into the silver medal position, but Finland and Urpo Korhonen still had a decisive lead. On the anchor leg, " [:a {:href "/athletes/95689"} "Tapio Mäkelä"] " impressed with the fastest leg-time of the day, and Finland won with a decisive margin of almost three minutes. In the duel for silver between the two Olympic 18 km champions, " [:a {:href "/athletes/84355"} "Hallgeir Brenden"] " and Martin Lundström, Norway’s Brenden was able to leave Sweden one minute behind at the finish, to the great satisfaction of the home crowd."] "\n\n" [:p {} "The other 10 teams competing in the relay were far behind the Nordic medalists. France had the satisfaction to be the best non-Scandinavian team and came in fourth, almost 11 minutes behind Finland."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Exchange"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "2"] [:td {} "Finland"] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]] [:td {} "2-20:16"] [:td {} "– (–)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "Lead-Off"] [:td {:class "bib"} "2-1"] [:td {} [:a {:href "/athletes/86504"} "Heikki Hasu"] " "] [:td {}] [:td {} "35:01"] [:td {} "35:01 (1)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2nd Leg"] [:td {:class "bib"} "2-2"] [:td {} [:a {:href "/athletes/91902"} "Paavo Lonkila"] " "] [:td {}] [:td {} "35:22"] [:td {} "1-10:23 (1)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3rd Leg"] [:td {:class "bib"} "2-3"] [:td {} [:a {:href "/athletes/88530"} "Urpo Korhonen"] " "] [:td {}] [:td {} "35:47"] [:td {} "1-46:10 (1)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "Anchor"] [:td {:class "bib"} "2-4"] [:td {} [:a {:href "/athletes/95689"} "Tapio Mäkelä"] " "] [:td {}] [:td {} "34:06"] [:td {} "2-20:16 (1)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "12"] [:td {} "Norway"] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "2-23:1