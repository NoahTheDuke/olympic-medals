pedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"] " / 12 February 1976 / " [:a {:href "/records/event_name/531"} "Details"]]] [:tr {:class "referees", :style ""} [:th {} "Starter"] [:td {:style "width: 400px"}] [:td {} [:a {:href "/countries/UNK"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UNK.png"}] "UNK"]]] [:tr {:class "referees", :style ""} [:th {} "Referee"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002203"} "Georg Pettersson"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]]]]] [:div {:class "description"} [:p {} "This one was considered a given. " [:a {:href "/athletes/86551"} "Eric Heiden"] " was favored in all five speed skating events in Lake Placid but none more so than in the 1,000 metres. He had never lost the distance in any international race, and had set the last three world records, having posted 1:14.99 in March 1978 at Savalen and again in February 1979 at Inzell, and bettering it with 1:13.60 in winning the 1980 World Sprints at Davos. He already had two gold medals, having earlier won the 500 and 5,000. Heiden was in the first pair with Canada’s " [:a {:href "/athletes/84286"} "Gaétan Boucher"] ", who had placed second at the 1979 and 1980 World Sprints to Heiden. But Heiden was dominant. He posted the fastest split at 200 metres, at 600 metres, and for each lap, winning his third gold medal by a full 1½ seconds over Boucher, a ridiculous margin for the 1,000 at this level of competition, posting 1:15.18. Third place was a tie, with Norway’s " [:a {:href "/athletes/97050"} "Frode Rønning"] " and the Soviet’s " [:a {:href "/athletes/89700"} "Vladimir Lobanov"] " both posting 1:16.91, and winning bronze medals. The defending champion, American " [:a {:href "/athletes/95623"} "Peter Mueller"] ", who had won the event in 1976 in its first appearance on the Olympic program, placed fifth."] "\n"] [:button {:id "button775150", :class "btn btn-default"} "Details"] [:script {} "$('#button775150').click(splits)"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {:style "display: none", :class "split"} "200 m"] [:th {:style "display: none", :class "split"} "600 m"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "1I"] [:td {} [:a {:href "/athletes/86551"} "Eric Heiden"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "1:15.18"] [:td {:class "split", :style "display: none"} "17.30"] [:td {:class "split", :style "display: none"} "45.49"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "Olympic Record"} "OR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "1O"] [:td {} [:a {:href "/athletes/84286"} "Gaétan Boucher"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {} "1:16.68"] [:td {:class "split", :style "display: none"} "17.33"] [:td {:class "split", :style "display: none"} "45.69"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {:class "bib"} "4I"] [:td {} [:a {:href "/athletes/89700"} "Vladimir Lobanov"]] [:td {} [:a {:href "/countries/URS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/URS.png"}] "URS"]] [:td {} "1:16.91"] [:td {:class "split", :style "display: none"} "17.64"] [:td {:class "split", :style "display: none"} "46.16"] [:td {} [:span {:class "Bronze"} "Br