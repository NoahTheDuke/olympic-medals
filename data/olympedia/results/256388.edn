alue "256402"} "Canadian Doubles, Slalom, Men"] "\n" [:option {:value "256430"} "Kayak Singles, Slalom, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255411"} "1972"] "\n" [:option {:value "256030"} "1992"] "\n" [:option {:value "256160"} "1996"] "\n" [:option {:value "256271"} "2000"] "\n" [:option {:value "258816"} "2008"] "\n" [:option {:value "307006"} "2012"] "\n" [:option {:value "353502"} "2016"] "\n" [:option {:value "19006314"} "2020"] "\n" [:option {:value "2008400"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/167"} "Event type"]] [:h1 {:class "event_title"} "Kayak Singles, Slalom, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "19 – 20 August 2004"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/789"} "Olympiako Kentro Kanoe/Kagiak Slalom, Olympiako Syngrotima Ellenikou, Hellinikon"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/256388"} "25 from 21 countries"]]]]] [:div {:class "description"} [:p {} "Two former Olympic champions, Italy’s " [:a {:href "/athletes/10178"} "Pierpaolo Ferrazzi"] " (1992, also a bronze medalist in 2000) and Germany’s " [:a {:href "/athletes/90198"} "Thomas Schmidt"] " (2000), travelled to the 2004 Games to bid for the title again, although neither had won any major international medals within the last three years. France’s " [:a {:href "/athletes/105123"} "Fabien Lefèvre"] ", as the two-time World Champion, was the favorite in the event. Schmidt and Lefèvre were third and fourth respectively in the qualifying heat, having been bested by " [:a {:href "/athletes/105122"} "Mike Kurt"] " of Switzerland and " [:a {:href "/athletes/105121"} "Campbell Walsh"] " of Great Britain. Ferrazzi, meanwhile, was 19th, only two positions shy of elimination. The final round had a new rule, wherein only the top ten canoeists after the first run would advance to the second. This ended up working against both Ferrazzi and Kurt, who occupied the last two spots on the table after the first round. Walsh, meanwhile, was first, followed by " [:a {:href "/athletes/105131"} "Benoît Peschier"] " of France and " [:a {:href "/athletes/105136"} "Sam Oud"] " of the Netherlands. Schmidt and Lefèvre, meanwhile, were now fifth and sixth. In the final portion, both Frenchmen had good runs, finishing first and second, but Peschier’s was great enough to him the gold medal, as Walsh had placed third. The Briton thus took silver while Lefèvre, hampered by his earlier mark, settled for bronze. Schmidt was again fifth and ended up fifth in the final rankings, while Oud slipped to ninth in the round and eighth overall."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Bib"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Qualifying"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "7"] [:td {} [:a {:href "/athletes/105131"} "Benoît Peschier"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "194.37 (8)"] [:td {} "93.93 (2)"] [:td {} "187.96 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "2"] [:td {} [:a {:href "/athletes/105121"} "Campbell Walsh"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png