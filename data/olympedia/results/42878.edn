ue "42802"} "Singles, Women"] "\n" [:option {:value "42840"} "Doubles, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "900350"} "1972"] "\n" [:option {:value "90016770"} "1988"] "\n" [:option {:value "42432"} "1996"] "\n" [:option {:value "42688"} "2000"] "\n" [:option {:value "258178"} "2008"] "\n" [:option {:value "304234"} "2012"] "\n" [:option {:value "351789"} "2016"] "\n" [:option {:value "19005436"} "2020"] "\n" [:option {:value "2005839"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/127"} "Event type"]] [:h1 {:class "event_title"} "Doubles, Mixed" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "14 – 19 August 2004"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/783"} "Olympiako Gymnastirio Goudiou, Olympiako Syngrotima Goudiou, Athina"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/42878"} "46 from 17 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single-elimination tournament."]]]] [:div {:class "description"} [:p {} "The defending champions " [:a {:href "/athletes/82700"} "Zhang Jun"] " and " [:a {:href "/athletes/89244"} "Gao Ling"] " of China were slight favorites coming into 2004. Since Sydney they had won the 2001 World Championships, and the 2001 and 2003 All-England titles. They had lost the 2003 Worlds in the final to Korea’s " [:a {:href "/athletes/916"} "Kim Dong-Mun"] " and " [:a {:href "/athletes/907"} "Na Gyeong-Min"] ", who had won 14 straight World Cup finals in 2003-04, but they lost in the Athina quarters to the Danish pair of " [:a {:href "/athletes/2368"} "Rikke Olsen"] " and " [:a {:href "/athletes/105857"} "Jonas Rasmussen"] ". The semi-finals were highly unusual for Olympic badminton as only one Asian team made it there – Zhang and Gao. They were joined by Olsen/Rasmussen, Danes " [:a {:href "/athletes/82708"} "Mette Schjoldager"] " and " [:a {:href "/athletes/2377"} "Jens Eriksen"] ", and the British team of " [:a {:href "/athletes/105923"} "Gail Emms"] " and " [:a {:href "/athletes/82719"} "Nathan Robertson"] ". Both semis were won in straights, with Zhang/Gao facing Emms/Robertson in the final. The British couple seemed overmatched, losing the first game 15-1, but they came back to win the second game and extend the match. Emms and Robertson led the final game 11-8, but Zhang and Gao scored six consecutive points and won 15-12. Emms and Robertson would win the World Championships in 2006."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/82700"} "Zhang Jun"] " / " [:a {:href "/athletes/89244"} "Gao Ling"]] [:td {} [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/82719"} "Nathan Robertson"] " / " [:a {:href "/athletes/105923"} "Gail Emms"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/2377"} "Jens Eriksen"] " / " [:a {:href "/athletes/82708"} "Mette Schjoldager"]] [:td {} [:a {:href "/countries/DEN"} [:img {:style "padding-