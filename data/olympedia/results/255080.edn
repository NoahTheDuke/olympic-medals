n"] "\n" [:option {:value "255058"} "Kayak Singles, 10,000 metres, Men"] "\n" [:option {:value "255059"} "Kayak Doubles, 1,000 metres, Men"] "\n" [:option {:value "255066"} "Kayak Doubles, 10,000 metres, Men"] "\n" [:option {:value "255067"} "Canadian Singles, 1,000 metres, Men"] "\n" [:option {:value "255073"} "Canadian Singles, 10,000 metres, Men"] "\n" [:option {:value "255074"} "Canadian Doubles, 1,000 metres, Men"] "\n" [:option {:value "255081"} "Kayak Singles, 500 metres, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "255019"} "1936"] "\n" [:option {:value "255045"} "1948"] "\n" [:option {:value "255113"} "1956"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/173"} "Event type"]] [:h1 {:class "event_title"} "Canadian Doubles, 10,000 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "27 July 1952 — 18:05"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/372"} "Taivallahti, Helsinki"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/255080"} "18 from 9 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Final only."]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/10873"} "Oldřich Lomecký"] " and " [:a {:href "/athletes/10862"} "Bohuslav Karlík"] " were the most recent World bronze medalists in the C-2 10,000, but were also representing the World Champion nation of Czechoslovakia at the 1952 Summer Olympics, who had won the event in 1950 with " [:a {:href "/athletes/10838"} "Jan Brzák-Felix"] " and " [:a {:href "/athletes/10870"} "Bohumil Kudrna"] ", competitors in the " [:a {:href "/results/255074"} "C-2 1,000 in Helsinki"] ". Karlík and Brzák-Felix had also been the 1938 World Champions in the C-2 10,000 and runners-up in the C-2 1,000. France’s " [:a {:href "/athletes/9654"} "Armand Loreau"] " and " [:a {:href "/athletes/9624"} "Georges Dransart"] " were the reigning World runners-up in both disciplines, but they took part in the C-2 1,000 and left this event to " [:a {:href "/athletes/9677"} "Georges Turlier"] " and " [:a {:href "/athletes/9649"} "Jean Laudet"] "."] "\n\n" [:p {} "It was the Canadian pair of " [:a {:href "/athletes/9291"} "Ken Lane"] " and " [:a {:href "/athletes/9279"} "Don Hawgood"] ", however, who led the race for most of the course, being passed only at the end by Turlier and Laudet, who captured the gold medal. The Canadians thus settled for silver, while the German duo, " [:a {:href "/athletes/9902"} "Egon Drews"] " and " [:a {:href "/athletes/9984"} "Wilfried Soltau"] ", took bronze. The Germans would win another bronze medal the next day in the C-2 1,000."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {} "Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/9677"} "Georges Turlier"] " / " [:a {:href "/athletes/9649"} "Jean Laudet"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "54:08.3"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/9291"} "Ken Lane"] " / " [:a {:href "/athletes/9279"} "Don Hawgood"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {} "54:09.9"] [:td {} [:span {:class "Silver"} "Silver"]] [:td 