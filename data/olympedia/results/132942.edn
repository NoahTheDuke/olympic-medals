 what is considered one of the biggest upsets in Olympic history in any sport."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Classification Points", :class "footnote"} "CP"] [:th {:data-toggle "tooltip", :data-placement "right", :data-original-title "Technical Points", :class "footnote"} "TP"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "3"] [:td {} [:a {:href "/athletes/59868"} "Aleksandr Karelin"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "13"] [:td {} [:a {:href "/athletes/60641"} "Matt Ghaffari"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "5"] [:td {} [:a {:href "/athletes/59318"} "Sergei Mureico"]] [:td {} [:a {:href "/countries/MDA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/MDA.png"}] "MDA"]] [:td {} "–"] [:td {} "–"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "11"] [:td {} [:a {:href "/athletes/60425"} "Petro Kotok"]] [:td {} [:a {:href "/countries/UKR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/UKR.png"}] "UKR"]] [:td {} "–"] [:td {} "–"] [:td {}] [:t