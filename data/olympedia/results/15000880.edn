000922"} "1,500 metres, Men"] "\n" [:option {:value "15000937"} "5,000 metres Relay, Men"] "\n" [:option {:value "15000944"} "500 metres, Women"] "\n" [:option {:value "15000965"} "1,000 metres, Women"] "\n" [:option {:value "15000986"} "1,500 metres, Women"] "\n" [:option {:value "15001001"} "3,000 metres Relay, Women"] "\n" [:option {:value "15001008"} "2,000 metres Mixed Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "905286"} "1988"] "\n" [:option {:value "535"} "1994"] "\n" [:option {:value "627"} "1998"] "\n" [:option {:value "719"} "2002"] "\n" [:option {:value "838"} "2006"] "\n" [:option {:value "923655"} "2010"] "\n" [:option {:value "350686"} "2014"] "\n" [:option {:value "9001100"} "2018"] "\n" [:option {:value "19020460"} "2022"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/543"} "Event type"]] [:h1 {:class "event_title"} "500 metres, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "16 – 18 February 2026"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2193"} "Forum di Milano, Assago, Milano, Milano"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/15000880"} "32 from 18 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Placements 1-8 based on A and B final.  Deeper placements based on placements in earlier rounds, and best time skated."]] [:tr {:class "records", :style ""} [:th {:style "vertical-align: top;"} "Olympic Record "] [:td {} [:a {:href "/results/9001100"} "39.584"] " " [:span {:class "label label-primary"} "WR"] " / " [:a {:href "/athletes/127580"} "Wu Dajing"] " " [:a {:href "/countries/CHN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CHN.png"}] "CHN"] " / 22 February 2018 / " [:a {:href "/records/event_name/543"} "Details"]]]]] [:div {:class "description"} [:p {} "Defending champion " [:a {:href "/athletes/137351"} "Shaoang Liu"] " had applied for nationality from his native Hungary to China (the country of his mother) in late 2022, forcing him to sit out a period of inactivity. Although still one of the top racers in the 500 m, he was no longer as strong as he had been in 2022, when he had won both the Olympic and World titles. Since then, the best in the world had been " [:a {:href "/athletes/148510"} "Pietro Sighel"] " of Italy, " [:a {:href "/athletes/137647"} "Lin Xiaojun"] " of China and " [:a {:href "/athletes/148016"} "Steven Dubois"] " of Canada. Like Liu, Lin had previously competed for a different nation, South Korea (as " [:a {:href "/athletes/137647"} "Im Hyo-Jun"] "). In 2019 he had been removed from the national team on the accusation of sexual harassment. While he was reinstated in court, he was invited to skate for China, which he accepted, but his nationality change was not approved in time for the 2022 Games. Top contender based on the 2025/26 season was " [:a {:href "/athletes/156214"} "William Dandjinou"] ", who had won 3 of the 4 World Tour 500 metres. With two gold medals in Milano, " [:a {:href "/athletes/148681"} "Jens van ‘t Wout"] " was also seriously considered for the podium."] "\n\n" [:p {} "There were no surprises in the heats, while the quarterfinals saw Lin exit the competition in a strong heat. In the first semi-final, Sighel and " [:a {:href "/athletes/148017"} "Maxime Laoun"] " fell, allowing Dandjinou and " [:a {:href "/athletes/156926"} "Melle van ‘t Wout"] ", Jens’ brother, to advance. Jens would also advance to the final with Dubois, as Liu crashed out in the final lap. " [:a {:href "/athletes/156924"} "Teun Boer"] " completed the field for the final, with three Dutchmen and two Canadians. In the final, Dubois immediately passed Jens for the early lead. Dandjinou then attempted a late pass. While succeeding, it caused Boer to fall, and a near fall for Jens. This left Dubois and Melle clear of the pack, and the Canadian brought it home unchallenged, ahead of Melle and Jens van ‘t Wout. Dandjinou came in fourth but received a penalty for his actions."] "\n\n" [:p {} "Despite Jens van ‘t Wout missing out on a third gold, he wildly celebrated the medals won by him and his brother. It was the standout performance by Melle van ‘t Wout, who had previously scored a single World Tour podium. He had suffered from a knee injury for two years. Dubois became the third Canadian to win the 500 m, and the first since " [:a {:href "/athletes/109918"} "Charles Hamelin"] " in 2010. With three golds and eight medals, Canada has won more than any other NOC in this event. Of note, Dubois was the ninth Olympic champion in nine editions of the 500 m, so without any repeat champions."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Helmet Nr"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Final Round Placement"] [:th {} "Semi-Final Placement"] [:th {} "Quarter-Final Placement"] [:th {} "Round One Placement"] [:th {} "Best Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "4"] [:td {} [:a {:href "/athletes/148016"} "Steven Dubois"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {} "1"] [:td {} "2"] [:td {} "1"] [:td {} "1"] [:td {} "40.163"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "121"] [:td {} [:a {:href "/athletes/156926"} "Melle van 't Wout"]] [:td {} [:a {:href "/c