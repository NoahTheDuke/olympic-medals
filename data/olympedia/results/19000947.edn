00779"} "4 × 400 metres Relay, Women"] "\n" [:option {:value "19000784"} "20 kilometres Race Walk, Women"] "\n" [:option {:value "19000785"} "High Jump, Women"] "\n" [:option {:value "19000790"} "Pole Vault, Women"] "\n" [:option {:value "9031120"} "Long Jump, Women"] "\n" [:option {:value "9031134"} "Triple Jump, Women"] "\n" [:option {:value "19000829"} "Shot Put, Women"] "\n" [:option {:value "19000846"} "Discus Throw, Women"] "\n" [:option {:value "19000863"} "Hammer Throw, Women"] "\n" [:option {:value "19000880"} "Javelin Throw, Women"] "\n" [:option {:value "19000897"} "Heptathlon, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "2014114"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/2572"} "Event type"]] [:h1 {:class "event_title"} "4 × 400 metres Relay, Mixed" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "30 – 31 July 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2106"} "Japan National Stadium, Kasumigaoka, Shinjuku, Tokyo"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19000947"} "76 from 15 countries"]]]]] [:div {:class "description"} [:p {} "The mixed relay event had been held at the 2019 World Championships, won by the United States, but there was really no way to make predictions for the event, as nobody knew which athletes would compete for their nations. The two heats ended up being the most complex part of the event."] "\n\n" [:p {} "The USA ostensibly won the first heat in 3:11.39 followed by the Dominican Republic but the two teams were soon disqualified for an exchange irregularity. For the US " [:a {:href "/athletes/147119"} "Lynna Irby"] " had lined up in the wrong spot on the first exchange while waiting for " [:a {:href "/athletes/147325"} "Elija Godwin"] ". Both teams protested the DQ and it was upheld as the United States’ case was that Irby had been directed to the wrong spot for the exchange by a track official. For the Dominican Republic the announcement was that “the Dominican Republic athlete\ncorrectly positioned herself in position 2 in response to an incorrect original placement. There was no interference or adverse consequence to any other team as result of the action by the Dominican Republic athlete.”"] "\n\n" [:p {} "Belgium, Germany, Ireland, the Netherlands, Poland, and Spain then counter-appealed against the decision to reinstate the two teams. Germany and Spain had the most interest as they would be ninth and tenth in qualifying if both teams were reinstated. Eventually Germany’s appeal was also upheld and the final proceeded with nine teams running."] "\n\n" [:p {} "In the final, all nine teams ran the M/F/F/M order, which had predominated at the Doha Worlds. The leader after the first leg was the Netherlands, as " [:a {:href "/athletes/125054"} "Liemarvin Bonevacia"] " ran 44.8. The Dominican Republic was in fourth place at the first exchange, but " [:a {:href "/athletes/142190"} "Marileidy Paulino"] " ran 48.7 for the fastest female leg of the competition, and handed off first for the third leg."] "\n\n" [:p {} "For the Netherlands, only fourth after the second leg, 400 hurdler " [:a {:href "/athletes/145442"} "Femke Bol"] " ran the third leg and brought them back into the lead, running 49.74. At the bell the Dominican Republic was in second, with Poland third, and the United States fourth. Poland’s " [:a {:href "/athletes/145964"} "Kajetan Duszynski"] " then ran a 44.38 leg to bring Poland home with the gold medal, as the Dominicans won silver, and the USA finished third, the Netherlands fading off the podium into fourth place."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "–"] [:td {} "Poland"] [:td {} [:a {:href "/countries/POL"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/POL.png"}] "POL"]] [:td {} "3:10.44 (1 h2)"] [:td {} "3:09.87 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "10"} [:a {:href "/athletes/135464"} "Karol Zalewski"] " • " [:a {:href "/athletes/145918"} "Natalia Kaczmarek"] " • " [:a {:href "/athletes/120218"} "Justyna Święty-Ersetic"] " • " [:a {:href "/athletes/145964"} "Kajetan Duszyński"] " • " [:a {:href "/athletes/145963"} "Dariusz Kowaluk"] " • " [:a {:href "/athletes/121883"} "Iga Baumgart-Witan"] " • " [:a {:href "/athletes/131375"} "Małgorzata Hołub-Kowalik"] " • " [:a {:href "/athletes/145910"} "Dominika Baćmaga"] [:small {} " (DNS)"] " • " [:a {:href "/athletes/145915"} "Kornelia Lesiewicz"] [:small {} " (DNS)"] " • " [:a {:href "/athletes/145969"} "Patryk Grzegorzewicz"] [:small {} " (DNS)"] " • " [:a {:href "/athletes/135462"} "Jakub Krzewina"] [:small {} " (DNS)"]]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "–"] [:td {} "Dominican Republic"] [:td {} [:a {:href "/countries/DOM"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/DOM.png"}] "DOM"]] [:td {} "3:12.74 (2 h1)"] [:td {} "3:10.21 (2)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {}] [:td {:colspan "10"} [:a {:href "/athletes/142210"} "Lidio Féliz"] " • " [:a {:href "/athletes/142190"} "Marileidy Paulino"] " • " [:a {:href "/athletes/142188"} 