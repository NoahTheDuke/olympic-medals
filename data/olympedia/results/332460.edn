26660"} "1972"] "\n" [:option {:value "127524"} "1976"] "\n" [:option {:value "128301"} "1980"] "\n" [:option {:value "129045"} "1984"] "\n" [:option {:value "130015"} "1988"] "\n" [:option {:value "131167"} "1992"] "\n" [:option {:value "132237"} "1996"] "\n" [:option {:value "133165"} "2000"] "\n" [:option {:value "133802"} "2004"] "\n" [:option {:value "263270"} "2008"] "\n" [:option {:value "355312"} "2016"] "\n" [:option {:value "19009532"} "2020"] "\n" [:option {:value "2008010"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/674"} "Event type"]] [:h1 {:class "event_title"} "Middleweight, Freestyle (≤74 kg), Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "10 August 2012"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/861"} "ExCeL, Newham, London"] " (North Arena 2)"]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/332460"} "19 from 19 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Single elimination tournament. Competitors losing to the finalists entered repechage tournament for bronze medals."]]]] [:div {:class "description"} [:p {} "A successful college-level wrestler, American " [:a {:href "/athletes/126810"} "Jordan Burroughs"] " had exploded onto the international scene by winning the Pan American and World Championship titles in the men’s middleweight freestyle wrestling division in 2011 and was the favorite to win Olympic Gold at the 2012 Summer Olympics. His greatest rival was Russia’s " [:a {:href "/athletes/120370"} "Denis Tsargush"] ", two-time World (2009 and 2010) and three-time European Champion (2010-2012) in the category. Another strong challenger was " [:a {:href "/athletes/122828"} "Sadegh Goudarzi"] " of Iran, the Asian Champion in 2009 and 2012 and World Championship runner-up the past two years."] "\n\n" [:p {} "Burroughs and Tsargush were drawn in the same half, where the American edged out the Russian in the semi-finals, while Goudarzi was the winner of his bracket and advanced to challenge the World Champion in the gold medal match. Both wrestlers were extremely agile fighters, but Borroughs was quicker in each round, ably dodging all of the Iranians attacks and scoring in the final seconds of both rounds to win the United States’ first wrestling gold medal of the Games."] "\n\n" [:p {} "Of the two wrestlers who met in the first bronze medal match, " [:a {:href "/athletes/117078"} "Soslan Tigiyev"] " of Uzbekistan was the more heralded, having won a silver medal at the 2008 Games and bronze at the 2006 Asian Games. His opponent, " [:a {:href "/athletes/108097"} "Gábor Hatos"] " of Hungary, had finished 15th at the 2004 edition and had bronze medals from the 2006 European Championships and the 2010 World Championships. Tigiyev won the first round with a takedown and drew the advantaged position in a second round " [:em {} "par terre"] ", which he was able to convert not only to a point, but a bronze medal as well. For the final podium spot Tsargush faced " [:a {:href "/athletes/117089"} "Matt Gentry"] " of Canada, a Pan American bronze medalist in 2007 and 2011 who finished 18th at the 2008 Olympics. As expected, the Russian had little trouble scoring against the Canadian, winning the match, and the bronze medal, 1-0 and 2-0 in the first and second rounds respectively."] "\n\n" [:p {} "In November 2012, " [:a {:href "/athletes/117078"} "Soslan Tigiyev"] " (UZB) was revealed to have a positive test for turinabol (dehydrochloromethyltestosterone), and was disqualified, losing his bronze medal. Hungarian " [:a {:href "/athletes/108097"} "Gábor Hatos"] ", who lost to Tigiyev in the repêchage final, was advanced to the bronze medal position. At Beijing in 2008, Tigiyev had also won a bronze medal in this class, but in October 2016, he was revealed to have a positive test for turinabol (dehydrochloromethyltestosterone), and was disqualified, losing his bronze medal."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/126810"} "Jordan Burroughs"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/122828"} "Sadegh Goudarzi"]] [:td {} [:a {:href "/countries/IRI"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/IRI.png"}] "IRI"]] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/108097"} "Gábor Hatos"]] [:td {} [:a {:href "/countries/HUN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/HUN.png"}] "HUN"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "=3"] [:td {} [:a {:href "/athletes/120370"} "Denis Tsargush"]] [:td {} [:a {:href "/countries/RUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/RUS.png"}] "RUS"]] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {} [:a {:href "/athletes/117089"} "Matt Gentry"]] [:td {} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "6"] [:td {} [:a {:href "/athletes/122322"} "Davit Khutsi