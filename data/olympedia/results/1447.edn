/79"} "Happo'one, Hakuba"] " (Olympic Course II)"]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1447"} "39 from 16 countries"]]] [:tr {:class "referees", :style ""} [:th {} "Course Setter"] [:td {:style "width: 400px"} [:a {:href "/athletes/5002703"} "Jan Tischhauser"]] [:td {} [:a {:href "/countries/IFR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/IFR.png"}] "IFR"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Gates: 32" [:br {}] "Length: 2518 m" [:br {}] "Start Altitude: 1590 m" [:br {}] "Vertical Drop: 691 m"]]]] [:div {:class "description"} [:p {} "As with the men’s downhill, the women’s downhill was delayed by weather, rain and fog causing the start to be moved from 14 February to 16 February. " [:a {:href "/athletes/82343"} "Katja Seizinger"] " was the defending champion and was probably still the best female speed skiier in the world. Since Lillehammer she had won the 1996 World Cup in both overall and Super G and she was leading the 1997-98 downhill World Cup. But she had competition. Two Americans, " [:a {:href "/athletes/82474"} "Picabo Street"] " in 1996 and " [:a {:href "/athletes/81684"} "Hilary Lindh"] " in 1997, had won the last two World Championship downhills. Street was World Cup champion in 1995 and 1996, and Austrian " [:a {:href "/athletes/81225"} "Renate Götschl"] " won the 1997 World Cup. But Street had been badly injured in December 1996, breaking her femur and tearing her anterior cruciate ligament (ACL) in a fall, and had only been skiing competitively for two months at the time of Nagano. Also expected to challenge was Sweden’s " [:a {:href "/athletes/83038"} "Pernilla Wiberg"] ", who was better known for her technical skills, but was a good all-rounder and the 1997 overall World Cup champion. Of the challengers, Seizinger was first down the mountain, and her time of 1:28.89 would hold up, making her the first skier to win two Olympic downhill golds. Wiberg placed second while the bronze went to France’s " [:a {:href "/athletes/81776"} "Florence Masnada"] ". Street finished sixth while Götschl would not finish."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Time"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "5"] [:td {} [:a {:href "/athletes/82343"} "Katja Seizinger"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "1:29.89"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "15"] [:td {} [:a {:href "/athletes/83038"} "Pernilla Wiberg"]] [:td {} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] [:td {} "1:29.18"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {:class "bib"} "2"] [:td {} [:a {:href "/athletes/81776"} "Florence Masnada"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "1:29.37"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {:class "bib"} "4"] [:td {} [:a {:href "/athletes/82489"} "Mélanie Suchet"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "1:29.48"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "5"] [:td {:class "bib"} "27"] [:td {} [:a {:href "/athletes/81154"} "Svetlana Gladysheva"]] [:td {} [:a {:hre