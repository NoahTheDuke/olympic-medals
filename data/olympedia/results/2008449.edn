 "2008400"} "Kayak Singles, Slalom, Men"] "\n" [:option {:value "2008406"} "Canadian Singles, Slalom, Men"] "\n" [:option {:value "2008437"} "Kayak Singles, Slalom, Women"] "\n" [:option {:value "2008443"} "Canadian Singles, Slalom, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:span {} "Not held in other editions"]] " | " [:a {:href "/event_names/2661"} "Event type"]] [:h1 {:class "event_title"} "Kayak Cross, Slalom, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "2 –  5 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2180"} "National Olympic Nautical Stadium d'Île-de-France, Vaires-sur-Marne, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2008449"} "37 from 25 countries"]]]]] [:div {:class "description"} [:p {} "Kayak cross was making it Olympic début. Sometimes called kayak slalom extreme, the event consists of head-to-head races between two or more canoeists over a whitewater course. The favorites were Australia’s " [:a {:href "/athletes/123753"} "Jess Fox"] " and Great Britain’s " [:a {:href "/athletes/142982"} "Kimberley Woods"] ". Woods was the 2023 World Champion, while Fox had won that title in 2021 and 2022 and had already won both the kayak singles and Canadian singles in Paris 2024 when this event started."] "\n\n" [:p {} "Fox was second in the time trial, qualifying behind France’s " [:a {:href "/athletes/2101735"} "Camille Prigent"] ", silver medalist at the 2023 World Championships, but Fox would fail to get past the second round, finishing last in her heat and eventually only 26th overall. Any disappointment Fox had would be assuaged as she watched her sister, " [:a {:href "/athletes/151176"} "Noemie Fox"] ", qualify eighth, but then win her heat in every round, taking the gold medal relatively easily. This was Noemie’s first Olympic appearance and the only event she competed at the 2024 Paris Olympics. Her only previous medals at the Worlds and Junior Worlds had been in team events."] "\n\n" [:p {} "The final consisted of Noemie Fox, Woods, France’s " [:a {:href "/athletes/151229"} "Angèle Hug"] ", and German " [:a {:href "/athletes/151235"} "Elena Lilik"] ". Hug, also making her Olympic début, held on for the silver medal, with Woods taking bronze. This was Woods second medal at Paris 2024, as she had also won bronze in the kayak singles."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Phase"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/151176"} "Noemie Fox"]] [:td {} [:a {:href "/countries/AUS"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/AUS.png"}] "AUS"]] [:td {} "FA"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/151229"} "Angèle Hug"]] [:td {} [:a {:href "/countries/FRA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FRA.png"}] "FRA"]] [:td {} "FA"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/142982"} "Kimberley Woods"]] [:td {} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] [:td {} "FA"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/151235"} "Elena Lilik"]] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://ol