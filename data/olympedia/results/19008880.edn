5"} "One Person Dinghy (Laser), Men"] "\n" [:option {:value "19008746"} "Two Person Dinghy (470), Men"] "\n" [:option {:value "19008767"} "Skiff (49er), Men"] "\n" [:option {:value "19008792"} "One Person Heavyweight Dinghy (Finn), Men"] "\n" [:option {:value "19008813"} "Windsurfer (Neil Pryde RS:X), Women"] "\n" [:option {:value "19008838"} "One Person Dinghy (Laser Radial), Women"] "\n" [:option {:value "19008859"} "Two Person Dinghy (470), Women"] "\n" [:option {:value "19008905"} "Multihull (Nacra 17), Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "356240"} "2016"] "\n" [:option {:value "2012865"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/1026"} "Event type"]] [:h1 {:class "event_title"} "Skiff (49er FX), Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "27 July –  3 August 2021"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/470"} "Enoshima, Sagami-wan"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19008880"} "42 from 21 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Points awarded for placement in each race.  Best 11 of 12 scores to count for final placement, and advancement to the medal race.. Medal race points count double."]]]] [:div {:class "description"} [:p {} "This was only the second time the 49er FX class was held at the Olympics, with the 2016 event having been won by the Brazilian pair of " [:a {:href "/athletes/129317"} "Martine Grael"] " and " [:a {:href "/athletes/129316"} "Kahena Kunze"] ". They had also won the 2014 World Championships in the class, and finished second in 2015, 2017, and 2019. However, the top crew since Rio had been the Dutch tandem of " [:a {:href "/athletes/131192"} "Annemiek Bekkering"] " and " [:a {:href "/athletes/131193"} "Annette Duetz"] ", who were seventh at Rio. Also expected to challenge for medals were the Spanish crew of " [:a {:href "/athletes/125044"} "Támara Echegoyen"] " and " [:a {:href "/athletes/142442"} "Paula Barcelo"] ", who had won the 2019 Worlds. Echegoyen had been at the helm of the Spanish boat that won gold in the three-person keelboat match racing event at the 2012 London Olympics."] "\n\n" [:p {} "The British pair of " [:a {:href "/athletes/130276"} "Charlotte Dobson"] " and " [:a {:href "/athletes/130603"} "Saskia Tidey"] " won the first two races in the regatta, but Grael/Kunze came to win the third phase. After Bekkering and Duetz won races four and six, the Brazilian pair was only in fifth place, but Brazil won the seventh race to move into a medal position. Bekkering and Duetz still led through eleven races, but Brazil moved ahead in the penultimate phase, and took the lead going into the medal race."] "\n\n" [:p {} "Brazil finished the medal race in third place but when the Netherlands placed only ninth, Grael and Kunze had defended their gold medal. The German crew of " [:a {:href "/athletes/143322"} "Tina Lutz"] " and " [:a {:href "/athletes/143320"} "Susann Beucke"] " moved past Bekkering/Duetz in the medal race to secure the silver medal with the Dutch pair taking bronze, as Echegoyen and Barcelo were off the podium in fourth place."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Pair"] [:th {} "NOC"] [:th {} "Net Points"] [:th {} "Total Points"] [:th {} "Race #1"] [:th {} "Race #2"] [:th {} "Race #3"] [:th {} "Race #4"] [:th {} "Race #5"] [:th {} "Race #6"] [:th {} "Race #7"] [:th {} "Race #8"] [:th {} "Race #9"] [:th {} "Race #10"] [:th {} "Race #11"] [:th {} "Race #12"] [:th {} "Medal Race"] [:t