16"} "100 metres Freestyle, Men"] "\n" [:option {:value "2001531"} "200 metres Freestyle, Men"] "\n" [:option {:value "2001543"} "400 metres Freestyle, Men"] "\n" [:option {:value "2001551"} "800 metres Freestyle, Men"] "\n" [:option {:value "2001559"} "1,500 metres Freestyle, Men"] "\n" [:option {:value "2001566"} "4 × 100 metres Freestyle Relay, Men"] "\n" [:option {:value "2001571"} "4 × 200 metres Freestyle Relay, Men"] "\n" [:option {:value "2001576"} "100 metres Backstroke, Men"] "\n" [:option {:value "2001588"} "200 metres Backstroke, Men"] "\n" [:option {:value "2001598"} "100 metres Breaststroke, Men"] "\n" [:option {:value "2001611"} "200 metres Breaststroke, Men"] "\n" [:option {:value "2001622"} "100 metres Butterfly, Men"] "\n" [:option {:value "2001636"} "200 metres Butterfly, Men"] "\n" [:option {:value "2001647"} "200 metres Individual Medley, Men"] "\n" [:option {:value "2001659"} "400 metres Individual Medley, Men"] "\n" [:option {:value "2001666"} "4 × 100 metres Medley Relay, Men"] "\n" [:option {:value "2001671"} "50 metres Freestyle, Women"] "\n" [:option {:value "2001688"} "100 metres Freestyle, Women"] "\n" [:option {:value "2001702"} "200 metres Freestyle, Women"] "\n" [:option {:value "2001712"} "400 metres Freestyle, Women"] "\n" [:option {:value "2001726"} "1,500 metres Freestyle, Women"] "\n" [:option {:value "2001734"} "4 × 100 metres Freestyle Relay, Women"] "\n" [:option {:value "2001739"} "4 × 200 metres Freestyle Relay, Women"] "\n" [:option {:value "2001744"} "100 metres Backstroke, Women"] "\n" [:option {:value "2001756"} "200 metres Backstroke, Women"] "\n" [:option {:value "2001766"} "100 metres Breaststroke, Women"] "\n" [:option {:value "2001778"} "200 metres Breaststroke, Women"] "\n" [:option {:value "2001788"} "100 metres Butterfly, Women"] "\n" [:option {:value "2001799"} "200 metres Butterfly, Women"] "\n" [:option {:value "2001808"} "200 metres Individual Medley, Women"] "\n" [:option {:value "2001818"} "400 metres Individual Medley, Women"] "\n" [:option {:value "2001824"} "4 × 100 metres Medley Relay, Women"] "\n" [:option {:value "2001829"} "4 × 100 metres Medley Relay, Mixed"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "6058"} "1968"] "\n" [:option {:value "6362"} "1972"] "\n" [:option {:value "6642"} "1976"] "\n" [:option {:value "6883"} "1980"] "\n" [:option {:value "7158"} "1984"] "\n" [:option {:value "7498"} "1988"] "\n" [:option {:value "7853"} "1992"] "\n" [:option {:value "8200"} "1996"] "\n" [:option {:value "8599"} "2000"] "\n" [:option {:value "8989"} "2004"] "\n" [:option {:value "261726"} "2008"] "\n" [:option {:value "322301"} "2012"] "\n" [:option {:value "357219"} "2016"] "\n" [:option {:value "19000213"} "2020"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/592"} "Event type"]] [:h1 {:class "event_title"} "800 metres Freestyle, Women" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "2 –  3 August 2024"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2158"} "Paris La Défense Arena, Nanterre, France"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2001719"} "16 from 13 countries"]]]]] [:div {:class "description"} [:p {} [:a {:href "/athletes/126653"} "Katie Ledecky"] " was the three-time defending gold medalist, and was the consensus choice as the greatest female swimmer of all-time. She had set the 16 fastest times in the event and had set five world records, the last coming in her gold medal performance at Rio 2016."] "\n\n" [:p {} "But there was now a slight chink in her mantle of distance swimming invincibility. She had not been defeated at 800 metres from 2010 until February 2024, when she lost to Canada’s " [:a {:href "/athletes/141457"} "Summer McIntosh"] " at a race in Orlando, Florida, but McIntosh had a full schedule at Paris 2024 and elected not to race the 800 freestyle. Ledecky’s biggest challenge would again come from Australian " [:a {:href "/athletes/140687"} "Ariarne Titmus"] ", the silver medalist at Tokyo 2020, and the two-time gold medalist in the 400 freestyle, having handled Ledecky easily in the 400 on the opening night of swimming at Paris 2024."] "\n\n" [:p {} "Ledecky qualified the fastest, with 8:16.62, followed by her teammate " [:a {:href "/athletes/147280"} "Paige Madden"] ", and Titmus in third, although ominously more than three seconds slower than Ledecky. The final was somewhat close, as Ledecky went to the lead on the first lap. She would never be headed, but Titmus was right with her through 500 metres. Ledecky was too strong over the last half of the race and pulled away to win over Titmus by 1¼ seconds, in 8:11.04. Madden took the bronze with a PR, taking more than five seconds off her best time."] "\n\n" [:p {} "This was Ledecky’s final race of the Paris Olympics. She finished it with 14 Olympic medals, the most ever by a female swimmer, and second all-time only to " [:a {:href "/athletes/93860"} "Michael Phelps"] "’ 28, although tied with Australia’s " [:a {:href "/athletes/129061"} "Emma McKeon"] ", who took home three relay medals from Paris. In all Olympic sports, Ledecky and McKeon trailed only Phelps, Soviet gymnast " [:a {:href "/athletes/29198"} "Larisa Latynina"] " with 18, Soviet gymnast " [:a {:href "/athletes/31235"} "Nikolay Andrianov"] " with 15, and Norwegian cross-country skier " [:a {:href "/athletes/101008"} "Marit Bjørgen"] ", also with 15. In Paris, German equestrian dressage rider " [:a {:href "/athletes/11503"} "Isabell Werth"] " also equaled Ledecky and McKeon by winning her 13th and 14th Olympic medals."] "\n\n" [:p {} "Ledecky’s ninth gold medal moved her to second all-time at the Olympics, in any sport, trailing Phelps’ 23, and equalling Latynina, " [:a {:href "/athletes/67728"} "Paavo Nurmi"] " (FIN - ATH), " [:a {:href "/athletes/51572"} "Mark Spitz"] " (USA - SWM), and " [:a {:href "/athletes/78692"} "Carl Lewis"] " (USA - ATH). In Paris, American " [:a {:href "/athletes/136353"} "Caeleb Dressel"] " joined that group with two relay golds."] "\n\n" [:p {} "Ledecky’s fourth consecutive victory in the 800 freestyle had only been matched in individual Olympic swimming events by Michael Phelps in the 200 IM, from 2004-2016. In all Olympic sports, this had been done previously only by Phelps, " [:a {:href "/athletes/78857"} "Al Oerter"] " (USA - ATH) in the men’s discus throw from 1956-1968, Carl Lewis in the men’s long jump from 1984-1996, Danish sailor " [:a {:href "/athletes/61927"} "Paul Elvstrøm"] " in one-person monotype from 1948-1960, and Cuban Greco-Roman heavyweight wrestler " [:a {:href "/athletes/107601"} "Mijaín López"] " from 2008-2020."] "\n\n" [:p {} "It should be noted that López would win his fifth consecutive heavyweight Greco-Roman wrestling gold medal in Paris, the first time that had ever been done in an individual event; and American shooter " [:a {:href "/athletes/117326"} "Vincent Hancock"] " won his fourth skeet shooting gold medal in Paris, uniquely not in consecutive Olympics."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/126653"} "Katie Ledecky"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "8:16.62 (1 h2)"] [:td {} "8:11.04 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [