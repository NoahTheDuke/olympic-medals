lue "2184"} "1924"] "\n" [:option {:value "2189"} "1928"] "\n" [:option {:value "2194"} "1932"] "\n" [:option {:value "2199"} "1936"] "\n" [:option {:value "2204"} "1948"] "\n" [:option {:value "2217"} "1956"] "\n" [:option {:value "2224"} "1960"] "\n" [:option {:value "2231"} "1964"] "\n" [:option {:value "2238"} "1968"] "\n" [:option {:value "2245"} "1972"] "\n" [:option {:value "2252"} "1976"] "\n" [:option {:value "2259"} "1980"] "\n" [:option {:value "2266"} "1984"] "\n" [:option {:value "2273"} "1988"] "\n" [:option {:value "2287"} "1992"] "\n" [:option {:value "2301"} "1994"] "\n" [:option {:value "2311"} "1998"] "\n" [:option {:value "2321"} "2002"] "\n" [:option {:value "2334"} "2006"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/368"} "Event type"]] [:h1 {:class "event_title"} "Individual, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "17 – 18 February 1952"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/99"} "Holmenkollbakken, Oslo"] " / " [:a {:href "/venues/100"} "Holmenkollen Langrennssentret, Oslo"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/2210"} "25 from 11 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Normal hill ski jumping and 18 kilometres skiing; placements determined by points table."]]]] [:div {:class "description"} [:p {} "The Olympic Champion from " [:a {:href "/results/2204"} "1948"] ", " [:a {:href "/athletes/86504"} "Heikki Hasu"] ", won another gold medal at the World Championships in Lake Placid in 1950, but this time things went better for the Norwegians. " [:a {:href "/athletes/86091"} "Ottar Gjermundshaug"] " placed second and " [:a {:href "/athletes/97636"} "Simon Slåttvik"] " third, with the other Norwegians placing fourth and sixth. Slåttvik had emerged as Hasu’s closest rival, winning the prestigious Holmenkollen Nordic Combined both in 1950 and 1951, and beating Hasu on both occations. In 1950, it was a very close contest, but, in 1951, Hasu fell in two of his three jumps and was out of contention for the victory. Slåttvik had now moved from his birthplace in Nordland to Lillehammer, which made it much easier for him to train and participate in important competitions."] "\n\n" [:p {} "At the Olympic Games in Oslo, the schedule of events for the Nordic Combined had changed. For the first time, the ski jumping was the first part of the competition, and the 18 km cross-country part was scheduled the day after, and as usual combined with the " [:a {:href "/results/1907"} "specialist’s race"] "."] "\n\n" [:p {} "The audience of almost 30,000 held their breath when home favorite Slåttvik fell in his first jump measuring 67.5 m, the longest in the first round. The two best jumps of three counted, and the pressure was on Slåttvik. He produced two excellent jumps in superb style and ended as winner of the jumping event, 0.5 point better than his countryman " [:a {:href "/athletes/97823"} "Sverre Stenersen"] ", a 25-year-old newcomer to the team, and like Slåttvik also from the northern part of Norway. Stenersen had the longest jump of the day, jumping 69.5 m in the third round. Hasu, however, jumped better than expected and placed fifth in the event. He had to beat Slåttvik by 4:32 minutes in the cross-country, and that was considered quite possible since Hasu was an excellent cross-country skier, a medal candidate among the specialists."] "\n\n" [:p {} "Hasu again made an excellent 18 km, missing the bronze medal among the specialists with only four seconds, and beating his closest rival among the Nordic Combined participants, his countryman " [:a {:href "/athletes/88529"} "Paavo Korhonen"] ", by over three minutes. Slåttvik, however, made his best cross-country competition ever. With massive support from an enthusiastic home crowd, he crossed the finish line with a time only 3:16 behind Hasu, placing third in the cross-country and winning the Olympic gold with a clear margin. Stenersen was able to keep ahead of Korhonen and secured the bronze, even if he was beaten by Hasu by over seven minutes."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "Points"] [:th {} "Ski Jumping, Normal Hill"] [:th {} "Cross Country Skiing, 18 km"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/97636"} "Simon Slåttvik"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "451.621"] [:td {} "223.5 (1)"] [:td {} "1-05:40 (3)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/86504"} "Heikki Hasu"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]] [:td {} "447.500"] [:td {} "207.5 (5)"] [:td {} "1-02:24 (1)"] [:td {} [:span {:class "Silver"} "Silver"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "3"] [:td {} [:a {:href "/athletes/97823"} "Sverre Stenersen"]] [:td {} [:a {:href "/countries/NOR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/NOR.png"}] "NOR"]] [:td {} "436.335"] [:td {} "223.0 (2)"] [:td {} "1-09:44 (9)"] [:td {} [:span {:class "Bronze"} "Bronze"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "4"] [:td {} [:a {:href "/athletes/88529"} "Paavo Korhonen"]] [:td {} [:a {:href "/countries/FIN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/FIN.png"}] "FIN"]] [:td {} "434.727"] [:td {} "206.0 (=6