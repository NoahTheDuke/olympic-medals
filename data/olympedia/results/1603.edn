1"} "12.5 kilometres Pursuit, Men"] "\n" [:option {:value "1602"} "15 kilometres Mass Start, Men"] "\n" [:option {:value "1600"} "20 kilometres, Men"] "\n" [:option {:value "1607"} "7.5 kilometres Sprint, Women"] "\n" [:option {:value "1609"} "10 kilometres Pursuit, Women"] "\n" [:option {:value "1610"} "12.5 kilometres Mass Start, Women"] "\n" [:option {:value "1608"} "15 kilometres, Women"] "\n" [:option {:value "1611"} "4 × 6 kilometres Relay, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "1518"} "1968"] "\n" [:option {:value "1523"} "1972"] "\n" [:option {:value "1528"} "1976"] "\n" [:option {:value "1534"} "1980"] "\n" [:option {:value "1540"} "1984"] "\n" [:option {:value "1546"} "1988"] "\n" [:option {:value "1552"} "1992"] "\n" [:option {:value "1563"} "1994"] "\n" [:option {:value "1575"} "1998"] "\n" [:option {:value "1588"} "2002"] "\n" [:option {:value "923486"} "2010"] "\n" [:option {:value "350026"} "2014"] "\n" [:option {:value "9000224"} "2018"] "\n" [:option {:value "19019634"} "2022"] "\n" [:option {:value "15000034"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/132"} "Event type"]] [:h1 {:class "event_title"} "4 × 7.5 kilometres Relay, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "21 February 2006 — 12:00"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/172"} "Cesana San Sicario"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/1603"} "68 from 17 countries"]]] [:tr {} [:th {} "Format"] [:td {:colspan "2"} "Eight shots for each group of five targets. Penalty loop (150 metres) skied for each missed target."]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Course Length: 7,500 m" [:br {}] "Height Differential: 48 m" [:br {}] "Maximum Climb: 13 m" [:br {}] "Shooting 1: Prone at 2.5 km, 50 m range" [:br {}] "Shooting 2: Standing at 5.0 km, 50 m range" [:br {}] "Total Climbing: 249 m"]]]] [:div {:class "description"} [:p {} "As always the big three nations were considered to be Germany, Russia, and Norway. Norway had won the 2005 World Championship, and was second to Germany in 2004, with Russia second in 2005. France, third at the 2004 Worlds, was also expected to be strong. But an unusual thing happened on the opening leg as the lead was taken by a nation with no significant biathlon history, the United States, with " [:a {:href "/athletes/99626"} "Jay Hakkinen"] " putting them almost four seconds up on the Czech Republic, with Germany in third. But that didn’t last long as the USA dropped to eighth after the second leg, with Germany moving into the lead over Italy and Poland. By the final exchange the Germans led, with Russia second and France third, while Norway was struggling, back in 10th place, as " [:a {:href "/athletes/99634"} "Frode Andresen"] " missed seven shots and had to ski two penalty loops. Germany would hold on for the gold medal, Russia finishing second. The race for the bronze was extremely close with Sweden’s " [:a {:href "/athletes/101202"} "Carl Johan Bergman"] " and France’s " [:a {:href "/athletes/99606"} "Raphaël Poirée"] " coming to the line almost together. But a stumble right at the line by Bergman enabled France to get onto the podium, winning by about a boot-length. Norway would move up in the final leg, as " [:a {:href "/athletes/84154"} "Ole Einar Bjørndalen"] " brought them up to fifth. The United States? They would finish ninth."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Misses"] [:th {} "E