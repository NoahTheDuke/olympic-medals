938"} "1952"] "\n" [:option {:value "59331"} "1956"] "\n" [:option {:value "59716"} "1960"] "\n" [:option {:value "60162"} "1964"] "\n" [:option {:value "60600"} "1968"] "\n" [:option {:value "61115"} "1972"] "\n" [:option {:value "61699"} "1976"] "\n" [:option {:value "62259"} "1980"] "\n" [:option {:value "62739"} "1984"] "\n" [:option {:value "63375"} "1988"] "\n" [:option {:value "64054"} "1992"] "\n" [:option {:value "64736"} "1996"] "\n" [:option {:value "65408"} "2000"] "\n" [:option {:value "66096"} "2004"] "\n" [:option {:value "257230"} "2008"] "\n" [:option {:value "302288"} "2012"] "\n" [:option {:value "358640"} "2016"] "\n" [:option {:value "19000438"} "2020"] "\n" [:option {:value "2013590"} "2024"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/49"} "Event type"]] [:h1 {:class "event_title"} "110 metres Hurdles, Men" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "21 – 25 July 1908"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/216"} "White City Stadium, London"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/56370"} "25 from 10 countries"]]]]] [:div {:class "description"} [:p {} "The Olympic record in this event was 15.4, set by " [:a {:href "/athletes/78667"} "Al Kraenzlein"] " in Paris in " [:a {:href "/results/56067"} "1900"] ".  The world record was 15.2, co-held by America’s " [:a {:href "/athletes/78438"} "Johnny Garrels"] " and " [:a {:href "/athletes/79024"} "Art Shaw"] ".  The Americans were the top hurdlers in the world, and it is instructive to look at the winners of their recent major meets.  " [:a {:href "/athletes/79068"} "Forrest Smithson"] " had won the 1907 AAU title, while in 1908 Art Shaw won that event.  At the 1908 American Olympic Trial Meets, four different hurdlers won: Smithson (Western), Garrels (Central), Shaw (IC4A), and " [:a {:href "/athletes/78577"} "Leonard Howe"] ", of Yale (Eastern).  Garrels had also won the IC4A crown in 1907."] "\n\n" [:p {} "This race was not run on the cinder track, but on a grass track in the infield of the " [:a {:href "/venues/216"} "White City Stadium"] ".  Fourteen heats resulted in the elimination of only 11 competitors.  In the second round, Forrest Smithson equaled the Olympic record, and then set a world record of 15.0 in the final.  The four American finalists were undoubtedly the best in the field but, surprisingly, they had never raced against each other before."] "\n\n" [:p {} "A well known photograph suggests that Smithson won the final carrying a Bible in his left hand, and this false rumor has been oft repeated.  But this was, in fact, a posed photograph taken to support Smithson’s protest against Sunday competition.  Precisely to whom this protest was directed to is not clear.  The Olympic final was held on a Saturday, and Sunday competition was virtually unknown in England at the time.  Smithson was a devoutly religious man and, after winning the 1909 AAU hurdles title, he became a minister."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Competitor"] [:th {} "NOC"] [:th {} "R1"] [:th {} "SF"] [:th {} "Final"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {} [:a {:href "/athletes/79068"} "Forrest Smithson"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/USA.png"}] "USA"]] [:td {} "15.8 (1 h10)"] [:td {} "15.4 (1 h2)"] [:td {} "15.0 (1)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {} [:span {:class "label label-default"} [:abbrev {:title "World Record"} "WR"]]] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {} [:a {:href "/athletes/78438"} "Johnny Garrels"]] [:td {} [:a {:href "/countries/USA"} [:img {:style "padding-right: 2px