value "19020310"} "Singles, Women"]] [:script {} "$('#same_games_select').change(function(){location.href='/results/' + $('#same_games_select').val();})"]] " | " [:form {:class "form-inline form-inline-header"} [:select {:name "id", :id "other_games_select", :class "form-control"} [:option {:value ""} "In other Games"] "\n" [:option {:value "350422"} "2014"] "\n" [:option {:value "9000747"} "2018"] "\n" [:option {:value "15000820"} "2026"]] [:script {} "$('#other_games_select').change(function(){location.href='/results/' + $('#other_games_select').val();})"]] " | " [:a {:href "/event_names/1007"} "Event type"]] [:h1 {:class "event_title"} "Team Relay, Mixed" [:small {}]] [:table {:class "biodata"} [:tbody {} [:tr {} [:th {} "Date"] [:td {} "10 February 2022 — 21:30"]] [:tr {} [:th {} "Status"] [:td {} "Olympic"]] [:tr {} [:th {} "Location"] [:td {} [:a {:href "/venues/2144"} "Yanqing National Sliding Centre, West Dazhuangke, Zhangshanying, Yanqing District"]]] [:tr {} [:th {} "Participants"] [:td {} [:a {:href "/events/19020317"} "56 from 14 countries"]]] [:tr {} [:th {:valign "top"} "Details"] [:td {} "Curves: 15" [:br {}] "Length: 1,475 m" [:br {}] "Start Altitude: 1,000 m" [:br {}] "Vertical Drop: 104 m"]]]] [:div {:class "description"} [:p {} "Germany won its third consecutive gold medal in the mixed team relay having won it each time it has been on the Olympic Programme. Their team consisted of " [:a {:href "/athletes/119444"} "Natalie Geisenberger"] ", the doubles pair of " [:a {:href "/athletes/127853"} "Tobias Arlt"] " and " [:a {:href "/athletes/127856"} "Tobias Wendl"] ", and " [:a {:href "/athletes/137316"} "Johannes Ludwig"] ". All the German sliders had won their individual or doubles events earlier in the Beijing Games, making them clear favourites in the mixed relay."] "\n\n" [:p {} "Germany swept the luge gold medals in Beijing, something that has been achieved four times before, and all were by German teams. The German Democratic Republic did so in 1976 and 1988, and Germany in 1998 and 2014. Only the 2014 Germany sweep was over four events as opposed to three in the other years, as the mixed team relay was added to that year’s Olympic programme."] "\n\n" [:p {} "The German team was very experienced as all four sliders grew up training together. Geisenberger, Arlt, and Wendl were 34-years-old, while Ludwig was almost 36. Ludwig became the oldest gold medallist in this event at 35 years, 361 days. He was the second oldest gold medallist in any luge event, after " [:a {:href "/athletes/82005"} "Sylke Otto"] " in 2006 women’s singles, who was 36 years, 221 days"] "\n\n" [:p {} "Geisenberger and Wendl/Arlt won their third gold medals in the event, while Ludwig won his second, as the German team was the same foursome that won gold in 2018. Arlt, Wendl and Geisenberger all won their sixth luge gold medals, the best ever for Olympic luge sliders. This also puts all three in a tie for fifth place for most gold medals at the Olympic Winter Games. Geisenberger then became Germany’s most successful winter Olympian with six gold and one bronze in total."] "\n\n" [:p {} "The German victory was much closer than expected, as their margin over the second-placed Austrian team was only 0.08 seconds, and Germany trailed for much of the relay, with only Arlt and Wendl pulling ahead on their run. The Austrian team consisted of " [:a {:href "/athletes/136733"} "Madeleine Egle"] ", " [:a {:href "/athletes/119464"} "Wolfgang Kindl"] ", and the doubles pair of " [:a {:href "/athletes/136737"} "Thomas Steu"] " and " [:a {:href "/athletes/136736"} "Lorenz Koller"] "."] "\n\n" [:p {} "Latvia took the bronze medal, almost a full second behind Germany. Their team roster was " [:a {:href "/athletes/128134"} "Elīza Tīruma-Cauce"] ", " [:a {:href "/athletes/137661"} "Kristers Aparjods"] ", and the doubles pair of " [:a {:href "/athletes/148631"} "Mārtiņš Bots"] " and " [:a {:href "/athletes/148632"} "Roberts Plūme"] ". Austria and Latvia had both medalled in this event previously, Austria winning bronze in 2018 and Latvia taking bronze in 2014. Plūme became the youngest male medallist in this event at 21 years, 341 days."] "\n"] [:table {:class "table table-striped"} [:thead {} [:tr {} [:th {} "Pos"] [:th {} "Number"] [:th {} "Competitors"] [:th {} "NOC"] [:th {} "Time"] [:th {} "Leg Rank"] [:th {} "Reaction"] [:th {} "Intermediate 1"] [:th {} "Intermediate 2"] [:th {} "Exchange"] [:th {}] [:th {}] [:th {}]]] [:tbody {} [:tr {:class "", :style ""} [:td {} "1"] [:td {:class "bib"} "16"] [:td {} "Germany"] [:td {} [:a {:href "/countries/GER"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GER.png"}] "GER"]] [:td {} "3:03.406"] [:td {} "–"] [:td {} "– (–)"] [:td {} "– (–)"] [:td {} "– (–)"] [:td {} "– (–)"] [:td {} [:span {:class "Gold"} "Gold"]] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "14-1"] [:td {} [:a {:href "/athletes/119444"} "Natalie Geisenberger"] " "] [:td {}] [:td {} "1:00.090"] [:td {} "2"] [:td {} "– (–)"] [:td {} "22.323 (2)"] [:td {} "47.695 (2)"] [:td {} "1:00.090 (2)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "14-2"] [:td {} [:a {:href "/athletes/137316"} "Johannes Ludwig"] " "] [:td {}] [:td {} "1:01.407"] [:td {} "2"] [:td {} "1.907 (1)"] [:td {} "23.957 (1)"] [:td {} "49.177 (2)"] [:td {} "2:01.497 (2)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {}] [:td {:class "bib"} "14-3"] [:td {} [:a {:href "/athletes/127856"} "Tobias Wendl"] " / " [:a {:href "/athletes/127853"} "Tobias Arlt"] " "] [:td {}] [:td {} "1:01.909"] [:td {} "1"] [:td {} "2.044 (2)"] [:td {} "24.093 (1)"] [:td {} "49.411 (1)"] [:td {} "3:03.406 (1)"] [:td {}] [:td {}] [:td {}]] [:tr {:class "", :style ""} [:td {} "2"] [:td {:class "bib"} "13"] [:td {} "Austria"] [:td {} [:a {:href "/countries/AUT"} [:img {:style "padding-right: 2px; vertical-align: middl