 in all winning at least one medal."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/325000"} "Flyweight (≤58 kilograms), Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} " 8 August 2012"] "\n" [:td {} "16"] "\n" [:td {} "16"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/325026"} "Featherweight (≤68 kilograms), Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} " 9 August 2012"] "\n" [:td {} "16"] "\n" [:td {} "16"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/325052"} "Welterweight (≤80 kilograms), Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "10 August 2012"] "\n" [:td {} "16"] "\n" [:td {} "16"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/325078"} "Heavyweight (&gt;80 kilograms), Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "11 August 2012"] "\n" [:td {} "16"] "\n" [:td {} "16"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/325104"} "Flyweight (≤49 kilograms), Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} " 8 August 2012"] "\n" [:td {} "16"] "\n" [:td {} "16"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/325130"} "Featherweight (≤57 kilograms), Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} " 9 August 2012"] "\n" [:td {} "16"] "\n" [:td {} "16"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/325156"} "Welterweight (≤67 kilograms), Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "10 August 2012"] "\n" [:td {} "16"] "\n" [:td {} "16"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/325182"} "Heavyweight (&gt;67 kilograms), Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "11 August 2012"] "\n" [:td {} "16"] "\n" [:td {} "16"] "\n"] "\n" [:tr {} "\n" [:td {}] "\n" [:td {}] "\n" [:td {}] "\n" [:td {:class "border-top"} "\n128 (64/64)\n"] "\n" [:td {:class "border-top"} "\n63 (48/45)\n"] "\n"] "\n