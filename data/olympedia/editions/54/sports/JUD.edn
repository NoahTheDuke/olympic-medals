n\n" [:p {} "There was no single dominant judo nation in 2012. The Russian men won five medals and three golds, but no Russian woman made the podium. France’s women won five medals but on the distaff side, the seven events were won by seven different nations. Japan won only one women’s class, but tied France with seven medals in all."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/316000"} "Extra-Lightweight (≤60 kilograms), Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "28 July 2012"] "\n" [:td {} "37"] "\n" [:td {} "37"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/316117"} "Half-Lightweight (≤66 kilograms), Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "29 July 2012"] "\n" [:td {} "36"] "\n" [:td {} "36"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/316234"} "Lightweight (≤73 kilograms), Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "30 July 2012"] "\n" [:td {} "34"] "\n" [:td {} "34"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/316393"} "Half-Middleweight (≤81 kilograms), Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "31 July 2012"] "\n" [:td {} "33"] "\n" [:td {} "33"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/316510"} "Middleweight (≤90 kilograms), Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} " 1 August 2012"] "\n" [:td {} "30"] "\n" [:td {} "30"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/316636"} "Half-Heavyweight (≤100 kilograms), Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} " 2 August 2012"] "\n" [:td {} "30"] "\n" [:td {} "30"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/316678"} "Heavyweight (&gt;100 kilograms), Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} " 3 August 2012"] "\n" [:td {} "31"] "\n" [:td {} "31"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/316075