n"] "\n" [:option {:value "BOB"} "Bobsleigh"] "\n" [:option {:value "CCS"} "Cross Country Skiing"] "\n" [:option {:value "CUR"} "Curling"] "\n" [:option {:value "FSK"} "Figure Skating"] "\n" [:option {:value "FRS"} "Freestyle Skiing"] "\n" [:option {:value "IHO"} "Ice Hockey"] "\n" [:option {:value "LUG"} "Luge"] "\n" [:option {:value "NCB"} "Nordic Combined"] "\n" [:option {:value "SJP"} "Ski Jumping"] "\n" [:option {:value "SSK"} "Speed Skating"]]] [:script {} "$('#sports_in_same_games_select').change(function(){location.href='/editions/43/sports/'+$('#sports_in_same_games_select').val()})"] [:form {:id "other_games_form", :class "form-inline", :style "display: inline", :method "get"} [:select {:name "year", :id "sport_in_other_games_select", :class "form-control"} [:option {:value ""} "Short Track Speed Skating in other Games"] "\n" [:option {:value "44"} "1992 Winter Olympics"] "\n" [:option {:value "45"} "1994 Winter Olympics"] "\n" [:option {:value "46"} "1998 Winter Olympics"] "\n" [:option {:value "47"} "2002 Winter Olympics"] "\n" [:option {:value "49"} "2006 Winter Olympics"] "\n" [:option {:value "57"} "2010 Winter Olympics"] "\n" [:option {:value "66"} "2012 Winter Youth Olympics"] "\n" [:option {:value "58"} "2014 Winter Olympics"] "\n" [:option {:value "68"} "2016 Winter Youth Olympics"] "\n" [:option {:value "60"} "2018 Winter Olympics"] "\n" [:option {:value "70"} "2020 Winter Youth Olympics"] "\n" [:option {:value "62"} "2022 Winter Olympics"] "\n" [:option {:value "73"} "2024 Winter Youth Olympics"] "\n" [:option {:value "72"} "2026 Winter Olympics"]]] [:script {} "$('#sport_in_other_games_select').change(function(){location.href='/editions/' + $('#sport_in_other_games_select').val() + '/sports/STK'})"] "\n" [:h1 {} "Short Track Speed Skating at the 1988 Winter Olympics"] "\n" [:table {:class "biodata"} "\n" [:tbody {} [:tr {} "\n" [:th {} "Dates"] "\n" [:td {} "20 – 25 February 1988"] "\n"] "\n" [:tr {} "\n" [:th {} "Non-medal Events"] "\n" [:td {} "10"] "\n"] "\n" [:tr {} "\n" [:th {} "Venues"] "\n" [:td {}] "\n"] "\n"]] "\n" [:div {:class "description"} "\n" [:p {} "The sport of short-track speed skating, in which skaters compete in packs, rather than in pairs racing the clock, is essentially a variant of the long-track speed skating, which has been held at the Olympics since 1924. It was most popular in North America, and the 1932 Olympic long-track competition was effectively held under short-track rules. However, the sport evolved since, becoming more frequently held on indoor hockey rinks, rather than outdoor 400 m rinks. It was recognized as a separate sport by the ISU in 1967, and the first World Championships (still unofficial at that time) were held in 1976. While initially popular in North America, it soon attracted a following in Asia and Europe."] "\n\n" [:p {} "In 1983, it was decided to add the sport to the program for the 1988 Winter Olympics as a demonstration event. Remarkably, as in long-track skating, the events were staged as a single-distance competition, even though the World Championships are mostly an all-around affair, with the winner decided on points scored in the individual distances. Otherwise, a full program of 10 distances was held. The track, in the Max Bell Arena, was fairly narrow (4.5 m), instead of the more common (6.5 m). The ISU adjusted rink regulations after the Games."] "\n\n" [:p {} "If there had been an allround competition in Calgary, the men’s event would have been won by Wilf O’Reilly, who won both the 500 and 1,000 m. On the women’s side, Canada’s Sylvie Daigle reached the final in all four distances, winning the 1,500 m while placing second in the 1,000 and 3,000 m."] "\n\n"] "\n\n\n" [:h2 {} "Non-medal events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/r