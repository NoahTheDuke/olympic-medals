n64 (32/32)\n"] "\n" [:td {:class "border-top"} "\n12 (10/11)\n"] "\n"] "\n"]] "\n\n\n\n"] "\n" [:footer {:class "footer"} "\n" [:br {}] "\n" [:div {:class "panel panel-info"} "\n" [:div {:class "panel-heading"} "\n" [:h3 {:class "panel-title"} "\n" [:span {:class "glyphicon glyphicon-info-sign"}] "\nDid you know?\n"] "\n"] "\n" [:div {:class "panel-body"} "\n" [:p {} "The 1908 London Olympics spanned more than six months, lasting from 27 April through 31 October."] "\n\n\n"] "\n"] "\n" [:div {:class "container"} "\n" [:p {} "\n" [:a {:href "/users/sign_in"} "Login"] "\n|\n" [:a {:href "/statistics/site"} "Statistics"] "\n|\n" [:a {:href "/static/about"} "About"] "\n|\n" [:a {:href "/static/faq"} "FAQ"] "\n|\n" [:a {:href "/feedbacks/new"} "Feedback"] "\n"] "\n" [:p {} "\n© " [:a {:href "/static/about"} "OlyMADMen"] " 2006 — 2026\n"] "\n"] "\n"] "\n\n" [:script {:src "/assets/lightbox.min-a06f7b5a37bdc88a78a48f95b9149ca917761a07bffb855a6d73c1a435e16552.js"}] #object[org.jsoup.nodes.TextNode 0x38d78829 ""] [:script {} "\n  $('.footnote').tooltip();\n"] "\n"] "\n"] "\n")