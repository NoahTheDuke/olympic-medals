obsleigh"] "\n" [:option {:value "CCS"} "Cross Country Skiing"] "\n" [:option {:value "FSK"} "Figure Skating"] "\n" [:option {:value "FRS"} "Freestyle Skiing"] "\n" [:option {:value "IHO"} "Ice Hockey"] "\n" [:option {:value "LUG"} "Luge"] "\n" [:option {:value "NCB"} "Nordic Combined"] "\n" [:option {:value "STK"} "Short Track Speed Skating"] "\n" [:option {:value "SKN"} "Skeleton"] "\n" [:option {:value "SJP"} "Ski Jumping"] "\n" [:option {:value "SBD"} "Snowboarding"] "\n" [:option {:value "SSK"} "Speed Skating"]]] [:script {} "$('#sports_in_same_games_select').change(function(){location.href='/editions/72/sports/'+$('#sports_in_same_games_select').val()})"] [:form {:id "other_games_form", :class "form-inline", :style "display: inline", :method "get"} [:select {:name "year", :id "sport_in_other_games_select", :class "form-control"} [:option {:value ""} "Curling in other Games"] "\n" [:option {:value "29"} "1924 Winter Olympics"] "\n" [:option {:value "31"} "1932 Winter Olympics"] "\n" [:option {:value "43"} "1988 Winter Olympics"] "\n" [:option {:value "44"} "1992 Winter Olympics"] "\n" [:option {:value "46"} "1998 Winter Olympics"] "\n" [:option {:value "47"} "2002 Winter Olympics"] "\n" [:option {:value "49"} "2006 Winter Olympics"] "\n" [:option {:value "57"} "2010 Winter Olympics"] "\n" [:option {:value "66"} "2012 Winter Youth Olympics"] "\n" [:option {:value "58"} "2014 Winter Olympics"] "\n" [:option {:value "68"} "2016 Winter Youth Olympics"] "\n" [:option {:value "60"} "2018 Winter Olympics"] "\n" [:option {:value "70"} "2020 Winter Youth Olympics"] "\n" [:option {:value "62"} "2022 Winter Olympics"] "\n" [:option {:value "73"} "2024 Winter Youth Olympics"]]] [:script {} "$('#sport_in_other_games_select').change(function(){location.href='/editions/' + $('#sport_in_other_games_select').val() + '/sports/CUR'})"] "\n" [:h1 {} "Curling at the 2026 Winter Olympics"] "\n" [:table {:class "biodata"} "\n" [:tbody {} [:tr {} "\n" [:th {} "Dates"] "\n" [:td {} "4 – 22 February 2026"] "\n"] "\n" [:tr {} "\n" [:th {} "Medal Events"] "\n" [:td {} "3"] "\n"] "\n" [:tr {} "\n" [:th {} "Venues"] "\n" [:td {} [:a {:href "/venues/26"} "Stadio del Ghiaccio, Cortina d'Ampezzo"]] "\n"] "\n"]] "\n" [:div {:class "description"} "\n" [:p {} "Curling at the 2026 Milano-Cortina Olympic Winter Games was held at the Cortina Olympic Stadium, with a total of 102 athletes (51 men, 51 women) from 14 nations competing in three events - men’s, women’s, and mixed doubles. Estonia made their Olympic début with the mixed doubles team of " [:a {:href ""} "Marie Kaldvee"] " and " [:a {:href "/athletes/1800114"} "Harri Lill"] "."] "\n\n" [:p {} "Since Beijing 2022, World Curling added limits on certain sweeping techniques and tighter brush-head equipment rules, clarified delivery and double-touch enforcement so stones could be removed for violations, and refined umpiring procedures (including adjustments during the 2026 Games) to improve consistency, while keeping core gameplay and scoring rules the same."] "\n\n" [:p {} "At Milano-Cortina 2026, men’s and women’s teams received 38 minutes of thinking time per 10-end game with one 60-second timeout; mixed doubles had 22 minutes per eight ends and the same timeout allowance. Clocks run only during strategy, not while stones are in motion. Tied games go to a full extra end (or ends in mixed doubles) with additional thinking time and a timeout for each team until a winner is decided. Teams may substitute an injured player at the start of the next end or continue with three players, but mixed doubles does not allow substitutions. These timing, extra-end, and substitution rules remained consistent throughout the 2022 Beijing event."] "\n\n" [:p {} "A rules dispute over double-touching the stone sparked debate about officiating and sportsmanship. Still, it did not affect the medal results and highlighted ongoing concerns about consistency in rule interpretations during the Games."] "\n\n" [:p {} "Traditional powers battled for podium positions, making curling one of the most competitive and closely watched sports of the Games. Sweden, Canada and Switzerland won two medals each, with Sweden leading with two golds (mixed doubles, women)."] "\n\n" [:p {} "Spectators were greeted with traditional bagpipe music at the venue, a nod to curling’s Scottish heritage. The performance was delivered by an Italian pipe band in full traditional attire."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/4006760"} "Curling, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "11 – 21 February 2026"] "\n" [:td {} "46"] "\n" [:td {} "10"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/4006707"} "Curling, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "12 – 22 February 2026"] "\n" [:td {} "44"] "\n" [:td {} "10"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/15000286"} "Doubles, Mixed"]] "\n" [:td {} "Olympic"] "\n" [:td {} "4 – 10 February 2026"] "\n" [:td {} "20"] "\n" [:td {} "10"] "\n"] "\n" [:tr {} "\n" [:td {}] "\n" [:td {}] "\n" [:td {}] "\n" [:td {:class "border-top"} "\n102 (51/51)\n"] "\n" [:td {:class "border-top"} "\n14 (12/13)\n"] "\n"] "\n"]] "\n\n\n" [:h2 {} "Medals"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {:colspan "2"} [:span {:class "Gold"} "Gold"]] "\n" [:th {:colspan "2"} [:span {:class "Silver"} "Silver"]] "\n" [:th {:colspan "2"} [:span {:class "Bronze"} "Bronze"]] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {:class "top"} [:a {:href "/results/4006760"} "Curling, Men"]] "\n" [:td {:style "vertical-align: top"} "Canada"] [:td {:style "vertical-align: top"} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olym