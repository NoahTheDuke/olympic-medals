on"] "\n" [:option {:value "BOB"} "Bobsleigh"] "\n" [:option {:value "CCS"} "Cross Country Skiing"] "\n" [:option {:value "CUR"} "Curling"] "\n" [:option {:value "FSK"} "Figure Skating"] "\n" [:option {:value "FRS"} "Freestyle Skiing"] "\n" [:option {:value "IHO"} "Ice Hockey"] "\n" [:option {:value "LUG"} "Luge"] "\n" [:option {:value "NCB"} "Nordic Combined"] "\n" [:option {:value "SKN"} "Skeleton"] "\n" [:option {:value "SJP"} "Ski Jumping"] "\n" [:option {:value "SBD"} "Snowboarding"] "\n" [:option {:value "SSK"} "Speed Skating"]]] [:script {} "$('#sports_in_same_games_select').change(function(){location.href='/editions/72/sports/'+$('#sports_in_same_games_select').val()})"] [:form {:id "other_games_form", :class "form-inline", :style "display: inline", :method "get"} [:select {:name "year", :id "sport_in_other_games_select", :class "form-control"} [:option {:value ""} "Short Track Speed Skating in other Games"] "\n" [:option {:value "43"} "1988 Winter Olympics"] "\n" [:option {:value "44"} "1992 Winter Olympics"] "\n" [:option {:value "45"} "1994 Winter Olympics"] "\n" [:option {:value "46"} "1998 Winter Olympics"] "\n" [:option {:value "47"} "2002 Winter Olympics"] "\n" [:option {:value "49"} "2006 Winter Olympics"] "\n" [:option {:value "57"} "2010 Winter Olympics"] "\n" [:option {:value "66"} "2012 Winter Youth Olympics"] "\n" [:option {:value "58"} "2014 Winter Olympics"] "\n" [:option {:value "68"} "2016 Winter Youth Olympics"] "\n" [:option {:value "60"} "2018 Winter Olympics"] "\n" [:option {:value "70"} "2020 Winter Youth Olympics"] "\n" [:option {:value "62"} "2022 Winter Olympics"] "\n" [:option {:value "73"} "2024 Winter Youth Olympics"]]] [:script {} "$('#sport_in_other_games_select').change(function(){location.href='/editions/' + $('#sport_in_other_games_select').val() + '/sports/STK'})"] "\n" [:h1 {} "Short Track Speed Skating at the 2026 Winter Olympics"] "\n" [:table {:class "biodata"} "\n" [:tbody {} [:tr {} "\n" [:th {} "Dates"] "\n" [:td {} "10 – 20 February 2026"] "\n"] "\n" [:tr {} "\n" [:th {} "Medal Events"] "\n" [:td {} "9"] "\n"] "\n" [:tr {} "\n" [:th {} "Venues"] "\n" [:td {} [:a {:href "/venues/2193"} "Forum di Milano, Assago, Milano, Milano"]] "\n"] "\n"]] "\n" [:div {:class "description"} "\n" [:p {} "There were no changes compared to the 2022 program, when the mixed relay was introduced. Competitions were held in the Forum di Milano (known as the Unipol Forum outside of the Games), where the figure skating competitions were also held."] "\n\n" [:p {} "Competition was dominated by the Netherlands, which had previously won three gold medals in the sport, but now earned five golds and seven medals total. Traditional powerhouse Korea was again well represented on the podium, also earning seven medals, with two golds. Host nation Italy and Canada divided the remaining two titles. Of note, Latvia won its first ever medal in the sport as " [:a {:href "/athletes/148636"} "Roberts Krūzbergs"] " earned a bronze in the 1,500 m."] "\n\n" [:p {} "Individually, Dutchman " [:a {:href "/athletes/148681"} "Jens van ‘t Wout"] " stood out with three golds and a bronze, tying the record of " [:a {:href "/athletes/101557"} "Viktor An"] " who won three golds at the 2006 and 2014 Games. " [:a {:href "/athletes/148679"} "Xandra Velzeboer"] " (Netherlands) and " [:a {:href "/athletes/156835"} "Kim Gil-Ri"] " (Korea) also won two gold medals in Milano. Also noteworthy were the performances of " [:a {:href "/athletes/109931"} "Arianna Fontana"] ". Competing in her sixth Olympic Games, she earned three medals (two silvers and a gold), bringing her total to 14. This further cemented her position as the short-tracker with the most Olympic medals (the next most is eight), and made her the Italian Olympian with the most medals, surpassing " [:a {:href "/athletes/22677"} "Edoardo Mangiarotti"] "."] "\n\n" [:p {} "A new nation competing in the sport was Uzbekistan. " [:a {:href "/athletes/148870"} "Daniil Eybog"] " had represented ROC in 2022, but had since switched nationality to Uzbekistan, allowing him to compete without the restrictions to compete as an individual neutral athlete (AIN)."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/15000880"} "500 metres, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "16 – 18 February 2026"] "\n" [:td {} "32"] "\n" [:td {} "18"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/15000901"} "1,000 metres, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "10 – 12 February 2026"] "\n" [:td {} "32"] "\n" [:td {} "17"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/15000922"} "1,500 metres, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "14 February 2026"] "\n" [:td {} "36"] "\n" [:td {} "19"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/15000937"} "5,000 metres Relay, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "16 – 20 February 2026"] "\n" [:td {} "35"] "\n" [:td {} "8"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/15000944"} "500 metres, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "10 – 12 February 2026"] "\n" [:td {} "32"] "\n" [:td {} "16"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/15000965"} "1,000 metres, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "14 – 16 February 2026"] "\n" [:td {} "32"] "\n" [:td {} "14"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/15000986"} "1,500 metres, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "20 February 2026"] "\n" [:td {} "36"] "\n" [:td {} "15"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/15001001"} "3,000 metres Relay, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "14 – 18 February 2026"] "\n" [:td {} "35"] "\n" [:td {} "8"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/15001008"} "2,000 metres Mixed Relay, Mixed"