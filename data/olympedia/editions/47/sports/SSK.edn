 (Germany). Both of them captured the two longest distances with two new world records, with Uytdehaage also taking silver in the 1,500 m."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/1108"} "500 metres, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "11 – 12 February 2002"] "\n" [:td {} "38"] "\n" [:td {} "15"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/1111"} "1,000 metres, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "16 February 2002"] "\n" [:td {} "44"] "\n" [:td {} "18"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/1112"} "1,500 metres, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "19 February 2002"] "\n" [:td {} "48"] "\n" [:td {} "17"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/1113"} "5,000 metres, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} " 9 February 2002"] "\n" [:td {} "32"] "\n" [:td {} "14"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/1114"} "10,000 metres, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "22 February 2002"] "\n" [:td {} "16"] "\n" [:td {} "10"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/1115"} "500 metres, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "13 – 14 February 2002"] "\n" [:td {} "31"] "\n" [:td {} "12"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/1118"} "1,000 metres, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "17 February 2002"] "\n" [:td {} "36"] "\n" [:td {} "14"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/1119"} "1,500 metres, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "20 February 2002"] "\n" [:td {} "39"] "\n" [:td {} "17"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/1120"} "3,000 metres, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "10 February 2002"] "\n" [:td {} "32"] "\n" [:td {} "16"] "\n"] "\n" [