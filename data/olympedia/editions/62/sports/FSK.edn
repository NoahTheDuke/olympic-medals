lue "BOB"} "Bobsleigh"] "\n" [:option {:value "CCS"} "Cross Country Skiing"] "\n" [:option {:value "CUR"} "Curling"] "\n" [:option {:value "FRS"} "Freestyle Skiing"] "\n" [:option {:value "IHO"} "Ice Hockey"] "\n" [:option {:value "LUG"} "Luge"] "\n" [:option {:value "NCB"} "Nordic Combined"] "\n" [:option {:value "STK"} "Short Track Speed Skating"] "\n" [:option {:value "SKN"} "Skeleton"] "\n" [:option {:value "SJP"} "Ski Jumping"] "\n" [:option {:value "SBD"} "Snowboarding"] "\n" [:option {:value "SSK"} "Speed Skating"]]] [:script {} "$('#sports_in_same_games_select').change(function(){location.href='/editions/62/sports/'+$('#sports_in_same_games_select').val()})"] [:form {:id "other_games_form", :class "form-inline", :style "display: inline", :method "get"} [:select {:name "year", :id "sport_in_other_games_select", :class "form-control"} [:option {:value ""} "Figure Skating in other Games"] "\n" [:option {:value "5"} "1908 Summer Olympics"] "\n" [:option {:value "7"} "1920 Summer Olympics"] "\n" [:option {:value "29"} "1924 Winter Olympics"] "\n" [:option {:value "30"} "1928 Winter Olympics"] "\n" [:option {:value "31"} "1932 Winter Olympics"] "\n" [:option {:value "32"} "1936 Winter Olympics"] "\n" [:option {:value "33"} "1948 Winter Olympics"] "\n" [:option {:value "34"} "1952 Winter Olympics"] "\n" [:option {:value "35"} "1956 Winter Olympics"] "\n" [:option {:value "36"} "1960 Winter Olympics"] "\n" [:option {:value "37"} "1964 Winter Olympics"] "\n" [:option {:value "38"} "1968 Winter Olympics"] "\n" [:option {:value "39"} "1972 Winter Olympics"] "\n" [:option {:value "40"} "1976 Winter Olympics"] "\n" [:option {:value "41"} "1980 Winter Olympics"] "\n" [:option {:value "42"} "1984 Winter Olympics"] "\n" [:option {:value "43"} "1988 Winter Olympics"] "\n" [:option {:value "44"} "1992 Winter Olympics"] "\n" [:option {:value "45"} "1994 Winter Olympics"] "\n" [:option {:value "46"} "1998 Winter Olympics"] "\n" [:option {:value "47"} "2002 Winter Olympics"] "\n" [:option {:value "49"} "2006 Winter Olympics"] "\n" [:option {:value "57"} "2010 Winter Olympics"] "\n" [:option {:value "66"} "2012 Winter Youth Olympics"] "\n" [:option {:value "58"} "2014 Winter Olympics"] "\n" [:option {:value "68"} "2016 Winter Youth Olympics"] "\n" [:option {:value "60"} "2018 Winter Olympics"] "\n" [:option {:value "70"} "2020 Winter Youth Olympics"] "\n" [:option {:value "73"} "2024 Winter Youth Olympics"] "\n" [:option {:value "72"} "2026 Winter Olympics"]]] [:script {} "$('#sport_in_other_games_select').change(function(){location.href='/editions/' + $('#sport_in_other_games_select').val() + '/sports/FSK'})"] "\n" [:h1 {} "Figure Skating at the 2022 Winter Olympics"] "\n" [:table {:class "biodata"} "\n" [:tbody {} [:tr {} "\n" [:th {} "Dates"] "\n" [:td {} "4 – 19 February 2022"] "\n"] "\n" [:tr {} "\n" [:th {} "Medal Events"] "\n" [:td {} "5"] "\n"] "\n" [:tr {} "\n" [:th {} "Venues"] "\n" [:td {} [:a {:href "/venues/845"} "Shoudu Tiyguan, Beijing"]] "\n"] "\n"]] "\n" [:div {:class "description"} "\n" [:p {} "Figure skating is often the focal point of the Winter Games, whether through the brilliance of skaters like " [:a {:href "/athletes/84513"} "Dick Button"] ",  " [:a {:href "/athletes/83053"} "Katarina Witt"] ", or the pair of " [:a {:href "/athletes/82209"} "Rodnina"] " and " [:a {:href "/athletes/99186"} "Zaitsev"] ", the episodes of controversial judging that had blighted the sport down through the years or even the sheer madness of the " [:a {:href "/athletes/81471"} "Kerrigan"] "-" [:a {:href "/athletes/81251"} "Harding"] " situation at the Lillehammer Games, but the spectre of doping had never loomed large on the sport prior to the 2022 Winter Games."] "\n\n" [:p {} "After the team from the Russian Olympic Committee had easily won the team event on February 7th, the IOC announced that the medal ceremony would not go on as planned and the media reported that this was because a doping irregularity connected to the winning team.  Eventually the International Testing Agency confirmed 15-year-old " [:a {:href "/athletes/148809"} "Kamila Valiyeva"] " had tested positive for trimetazidine at the Russian Championships in December."] "\n\n" [:p {} "After a hearing at the Court of Arbitration, Valiyeva was allowed to compete in the women’s event because “the Panel is persuaded that in the face of irreparable harm to the Athlete upon issuance of a Provisional Suspension (eventually possibly being found to be unjustified), there is no founded and equally tangible irreparable harm in case of lifting of the Provisional Suspension (sic), neither for the Applicants nor for the other competitors.”"] "\n\n" [:p {} "Unsurprisingly, in the face of extreme media scrutiny, Valiyeva fell apart in the long programme and the heavy favourite failed even to make the Olympic podium.  Russia still won the title in the shape of " [:a {:href "/athletes/149174"} "Anna Shcherbakova"] ", herself only 17 years of age."] "\n\n" [:p {} [:a {:href "/athletes/138305"} "Nathan Chen"] " of the USA, who had dominated his event at the World Championships since the last Winter Games, won the men’s title quite comfortably ahead of a procession of talented Japanese skaters while the victory of the pair of " [:a {:href "/athletes/136958"} "Sui Wenjing"] " and " [:a {:href "/athletes/136961"} "Han Cong"] " must have been immensely satisfying after missing out on gold at the 2018 Games by .5 of a point."] "\n\n" [:p {} "Western European pride was upheld by French ice dancers " [:a {:href "/athletes/137188"} "Gabriella Papadakis"] "  and " [:a {:href "/athletes/137190"} "Guillaume Cizeron"] ", who won gold ahead of strong challenges from the  Russian Olympic Committee and the United States."] "\n\n" [:p {} "The competitions were held at the Shoudu Tiyguan (The Capital Indoor Stadium), a venue that had held volleyball at the 2008 Summer Olympics.\nQualification for the Games came in two stages. The majority of the field qualified by performances at the 2021 World Championships while the rest of the qualifiers came via the Nebelhorn Trophy in Oberstdorf, Germany in late September 2021."] "\n\n" [:p {} "The results from the team competition are still unconfirmed pending an inquiry into Valiyeva as of April 2022."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/19020000"} "Singles, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "8 – 10 February 2022"] "\n" [:td {} "29"] "\n" [:td {} "20"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19020003"} "Singles, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "15 – 17 February 2022"] "\n" [:td {} "30"] "\n" [:td {} "23"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19020006"} "Pairs, Mixed"]] "\n" [:td {} "Olympic"] "\n" [:td {} "18 – 19 February 2022"] "\n" [:td {} "36"] "\n" [:td {} "12"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19020009"} "Ice Dancing, Mixed"]] "\n" [:td {} "Olympic"] "\n" [:td {} "12 – 14 February 2022"] "\n" [:td {} "46"] "\n" [:td {} "17"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19020012"} "Team, Mixed"]] "\n" [:td {} "Olympic"] "\n" [:td {} "4 –  7 February 2022"] "\n" [:td {} "66"] "\n" [:td {} "10"] "\n"] "\n" [:tr {} "\n" [:td {}] "\n" [:td {}] "\n" [:td {}] "\n" [:td {:class "border-top"} "\n146 (73/73)\n"] "\n" [:td {:class "border-top"} "\n31 (28/29)\n"] "\n"] "\n"]] "\n\n\n" [:h2 {} "Medals"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {:colspan "2"} [:span {:class "Gold"} "Gold"]] "\n" [:th {:colspan "2"} [:span {:class "Silver"} "Silver"]] "\n" [:th {:colspan "2"} [:span {:class "Bronze"} "Bronze"]] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {:class "top"} [:a {:href "/results/19020000"} "S