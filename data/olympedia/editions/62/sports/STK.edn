n"] "\n" [:option {:value "BOB"} "Bobsleigh"] "\n" [:option {:value "CCS"} "Cross Country Skiing"] "\n" [:option {:value "CUR"} "Curling"] "\n" [:option {:value "FSK"} "Figure Skating"] "\n" [:option {:value "FRS"} "Freestyle Skiing"] "\n" [:option {:value "IHO"} "Ice Hockey"] "\n" [:option {:value "LUG"} "Luge"] "\n" [:option {:value "NCB"} "Nordic Combined"] "\n" [:option {:value "SKN"} "Skeleton"] "\n" [:option {:value "SJP"} "Ski Jumping"] "\n" [:option {:value "SBD"} "Snowboarding"] "\n" [:option {:value "SSK"} "Speed Skating"]]] [:script {} "$('#sports_in_same_games_select').change(function(){location.href='/editions/62/sports/'+$('#sports_in_same_games_select').val()})"] [:form {:id "other_games_form", :class "form-inline", :style "display: inline", :method "get"} [:select {:name "year", :id "sport_in_other_games_select", :class "form-control"} [:option {:value ""} "Short Track Speed Skating in other Games"] "\n" [:option {:value "43"} "1988 Winter Olympics"] "\n" [:option {:value "44"} "1992 Winter Olympics"] "\n" [:option {:value "45"} "1994 Winter Olympics"] "\n" [:option {:value "46"} "1998 Winter Olympics"] "\n" [:option {:value "47"} "2002 Winter Olympics"] "\n" [:option {:value "49"} "2006 Winter Olympics"] "\n" [:option {:value "57"} "2010 Winter Olympics"] "\n" [:option {:value "66"} "2012 Winter Youth Olympics"] "\n" [:option {:value "58"} "2014 Winter Olympics"] "\n" [:option {:value "68"} "2016 Winter Youth Olympics"] "\n" [:option {:value "60"} "2018 Winter Olympics"] "\n" [:option {:value "70"} "2020 Winter Youth Olympics"] "\n" [:option {:value "73"} "2024 Winter Youth Olympics"] "\n" [:option {:value "72"} "2026 Winter Olympics"]]] [:script {} "$('#sport_in_other_games_select').change(function(){location.href='/editions/' + $('#sport_in_other_games_select').val() + '/sports/STK'})"] "\n" [:h1 {} "Short Track Speed Skating at the 2022 Winter Olympics"] "\n" [:table {:class "biodata"} "\n" [:tbody {} [:tr {} "\n" [:th {} "Dates"] "\n" [:td {} "5 – 16 February 2022"] "\n"] "\n" [:tr {} "\n" [:th {} "Medal Events"] "\n" [:td {} "9"] "\n"] "\n" [:tr {} "\n" [:th {} "Venues"] "\n" [:td {} [:a {:href "/venues/845"} "Shoudu Tiyguan, Beijing"]] "\n"] "\n"]] "\n" [:div {:class "description"} "\n" [:p {} "For the first time since 2002, the Olympic program of short-track speed skating was expanded. Answering to the IOC’s call for more mixed events, short-track introduced the mixed relay. Having already been pioneered at the Winter YOG since 2012, the event gained World Cup status in the 2018/19 season. Despite the new event, the total number of competitors for the sport was slightly reduced, from 120 in PyeongChang to 112 in Beijing."] "\n\n" [:p {} "All competitions were held at the Capital Indoor Stadium, which had hosted the 2008 Olympic volleyball events and was also used for the figure skating competitions at the 2022 Games."] "\n\n" [:p {} "Two skaters claimed two gold medals, home favorite " [:a {:href "/athletes/136984"} "Ren Ziwei"] " and " [:a {:href "/athletes/137698"} "Suzanne Schulting"] " of the Netherlands. The latter earned four medals in total, the most of any short-track skater in Beijing, while four others won three medals each. Schulting became the first female short-track speedskater to win four medals at a single Olympic Winter Games."] "\n\n" [:p {} [:a {:href "/athletes/109931"} "Arianna Fontana"] "’s three 2022 medals brought her Olympic total to 11, the most of any short-tracker in history, surpassing " [:a {:href "/athletes/101557"} "Viktor An"] " and " [:a {:href "/athletes/101555"} "Apolo Anton Ohno"] "’s total of eight. An still holds the record for most golds, though, with six. Of note, all individual women’s titles went to the same skaters as in 2018."] "\n\n" [:p {} "As in PyeongChang, six different NOCs won a gold medal, with no nation dominating. Republic of Korea did well with five medals, but four other countries earned four. Belgium joined the nations having medaled in the sport, earning its first ever bronze in the sport through " [:a {:href "/athletes/147886"} "Hanne Desmet"] ". Two countries made their Olympic début in the sport, Croatia – through " [:a {:href "/athletes/148139"} "Valentina Aščić"] " – and Turkey, which saw " [:a {:href "/athletes/149045"} "Furkan Akar"] " score a surprising sixth place in the 1,000 m."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/19020460"} "500 metres, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "11 – 13 February 2022"] "\n" [:td {} "32"] "\n" [:td {} "17"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19020481"} "1,000 metres, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "5 –  7 February 2022"] "\n" [:td {} "32"] "\n" [:td {} "17"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19020502"} "1,500 metres, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} " 9 February 2022"] "\n" [:td {} "36"] "\n" [:td {} "16"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19020517"} "5,000 metres Relay, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "11 – 16 February 2022"] "\n" [:td {} "34"] "\n" [:td {} "8"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19020524"} "500 metres, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "5 –  7 February 2022"] "\n" [:td {} "32"] "\n" [:td {} "15"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19020545"} "1,000 metres, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "9 – 11 February 2022"] "\n" [:td {} "32"] "\n" [:td {} "14"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19020566"} "1,500 metres, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "16 February 2022"] "\n" [:td {} "36"] "\n" [:td {} "17"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19020581"} "3,000 metres Relay, Women"]] "\n" [:td {} "Olym