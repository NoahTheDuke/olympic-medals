option {:value "BOB"} "Bobsleigh"] "\n" [:option {:value "CUR"} "Curling"] "\n" [:option {:value "FSK"} "Figure Skating"] "\n" [:option {:value "FRS"} "Freestyle Skiing"] "\n" [:option {:value "IHO"} "Ice Hockey"] "\n" [:option {:value "LUG"} "Luge"] "\n" [:option {:value "NCB"} "Nordic Combined"] "\n" [:option {:value "STK"} "Short Track Speed Skating"] "\n" [:option {:value "SKN"} "Skeleton"] "\n" [:option {:value "SJP"} "Ski Jumping"] "\n" [:option {:value "SBD"} "Snowboarding"] "\n" [:option {:value "SSK"} "Speed Skating"]]] [:script {} "$('#sports_in_same_games_select').change(function(){location.href='/editions/62/sports/'+$('#sports_in_same_games_select').val()})"] [:form {:id "other_games_form", :class "form-inline", :style "display: inline", :method "get"} [:select {:name "year", :id "sport_in_other_games_select", :class "form-control"} [:option {:value ""} "Cross Country Skiing in other Games"] "\n" [:option {:value "29"} "1924 Winter Olympics"] "\n" [:option {:value "30"} "1928 Winter Olympics"] "\n" [:option {:value "31"} "1932 Winter Olympics"] "\n" [:option {:value "32"} "1936 Winter Olympics"] "\n" [:option {:value "33"} "1948 Winter Olympics"] "\n" [:option {:value "34"} "1952 Winter Olympics"] "\n" [:option {:value "35"} "1956 Winter Olympics"] "\n" [:option {:value "36"} "1960 Winter Olympics"] "\n" [:option {:value "37"} "1964 Winter Olympics"] "\n" [:option {:value "38"} "1968 Winter Olympics"] "\n" [:option {:value "39"} "1972 Winter Olympics"] "\n" [:option {:value "40"} "1976 Winter Olympics"] "\n" [:option {:value "41"} "1980 Winter Olympics"] "\n" [:option {:value "42"} "1984 Winter Olympics"] "\n" [:option {:value "43"} "1988 Winter Olympics"] "\n" [:option {:value "44"} "1992 Winter Olympics"] "\n" [:option {:value "45"} "1994 Winter Olympics"] "\n" [:option {:value "46"} "1998 Winter Olympics"] "\n" [:option {:value "47"} "2002 Winter Olympics"] "\n" [:option {:value "49"} "2006 Winter Olympics"] "\n" [:option {:value "57"} "2010 Winter Olympics"] "\n" [:option {:value "66"} "2012 Winter Youth Olympics"] "\n" [:option {:value "58"} "2014 Winter Olympics"] "\n" [:option {:value "68"} "2016 Winter Youth Olympics"] "\n" [:option {:value "60"} "2018 Winter Olympics"] "\n" [:option {:value "70"} "2020 Winter Youth Olympics"] "\n" [:option {:value "73"} "2024 Winter Youth Olympics"] "\n" [:option {:value "72"} "2026 Winter Olympics"]]] [:script {} "$('#sport_in_other_games_select').change(function(){location.href='/editions/' + $('#sport_in_other_games_select').val() + '/sports/CCS'})"] "\n" [:h1 {} "Cross Country Skiing at the 2022 Winter Olympics"] "\n" [:table {:class "biodata"} "\n" [:tbody {} [:tr {} "\n" [:th {} "Dates"] "\n" [:td {} "5 – 20 February 2022"] "\n"] "\n" [:tr {} "\n" [:th {} "Medal Events"] "\n" [:td {} "12"] "\n"] "\n" [:tr {} "\n" [:th {} "Venues"] "\n" [:td {} [:a {:href "/venues/2138"} "Zhangjiakou Nordic Centre and Biathlon Centre, Chongli District, Zhangjiakou City, Hebei Province"]] "\n"] "\n"]] "\n" [:div {:class "description"} "\n" [:p {} "The 2022 Beijing Olympic Winter Games hosted twelve cross-country skiing events, six each for both men and women. The venue was the Guyangshu Nordic Ski and Biathlon Center near Zhangjiakou, located 180 km north-west of Beijing. Due to the COVID-19 pandemic, the pre-Olympic competitions, planned as the completion of the 2020/21 World Cup, had to be canceled, meaning most athletes were confronted with a completely unknown course."] "\n\n" [:p {} "The program for the cross-country events had not changed since 2006, when team-sprint and skiathlon were introduced for both men and women. According to the usual routine, events that were run in classical style in 2018 were now held in freestyle, and vice versa."] "\n\n" [:p {} "Most of the events took place in the afternoon daylight under varying weather conditions. Some events suffered from icy winds and extreme cold temperatures of more than -15° C. On the last two days of the Games, the two longest races were rescheduled by a few hours to avoid the worst conditions. For the first time in the history of the Winter Games, the men’s 50 km was also shortened, to just under 30 km."] "\n\n" [:p {} "The most successful male athlete was " [:a {:href "/athletes/137797"} "Aleksandr Bolshunov"] " (ROC) with five medals (3G – 1S – 1B), who dominated the distance events, followed by " [:a {:href "/athletes/137724"} "Johannes Høsflot Klæbo"] " from Norway with four (2G – 1S – 1B). Klæbo, a triple gold medalist in PyeongChang, repeated his victories in sprint and team sprint. " [:a {:href "/athletes/127665"} "Iivo Niskanen"] ", classical specialist from Finland, was the only male athlete, other than Bolshunov and Klæbo, to secure an individual gold."] "\n\n" [:p {} "After her doping ban in 2018, " [:a {:href "/athletes/118852"} "Therese Johaug"] " returned to win three golds in all three distance events, adding them to her relay gold in 2010, and silver and bronze in 2014. " [:a {:href "/athletes/2300905"} "Jonna Sundling"] " took the remaining individual gold in the sprint. In the team sprint, however, Germany celebrated an upset victory, beating Sweden with the individual sprint gold and silver medalists in their team. The relay gold medals both went to ROC, who had the strongest runners. At her third Olympics, American " [:a {:href "/athletes/128689"} "Jessie Diggins"] " took medals in the shortest and longest events (bronze in sprint, silver in the 30 km) showing her versatility."] "\n\n" [:p {} "Overall, the most gold medals went to Norway (five) with ROC taking four. The ROC, however, won the most medals in total with 11, compared to Norway’s eight. Norway had been more superior four years earlier because of the ban of many Russian athletes. The traditional cross-country nations, Sweden and Finland, took six and five medals respectively in 2022 and the remaining three gold medals were shared by Finland, Sweden, and Germany."] "\n\n" [:p {} "France extended their medal-winning streak in the men’s relay to three back-to-back bronze medals. Germany took their first gold since 2010. Iivo, and his sister " [:a {:href "/athletes/127662"} "Kerttu Niskanen"] ", increased their collective medal tally to 3G – 4S – 2B from three Olympic appearances. Other countries on the podium were Italy with " [:a {:href "/athletes/127933"} "Federico Pellegrino"] ", who placed second in the sprint behind Klæbo, replicating the 2018 result, and Austria with " [:a {:href "/athletes/127336"} "Teresa Stadlober"] " (bronze in skiathlon). Stadlober finally won the medal that she missed in the 30km at PyeongChang after taking a wrong turn."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/19019700"} "Sprint (Freestyle), Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} " 8 February 2022"] "\n" [:td {} "88"] "\n" [:td {} "44"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19019712"} "15 kilometres (Classical), Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "11 February 2022"] "\n" [:td {} "97"] "\n" [:td {} "50"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19019713"} "50 kilometres (Mass Start, Freestyle), Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "19 February 2022"] "\n" [:td {} "60"] "\n" [:td {} "32"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19019714"} "30 kilometres Skiathlon, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} " 6 February 2022"] "\n" [:td {} "69"] "\n" [:td {} "34"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19019715"} "4 × 10 kilometres Relay, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "13 February 2022"] "\n" [:td {} "60"] "\n" [:td {} "15"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19019716"} "Team Sprint (Classical), Men"]] "\n" [:td {} "Olympic"] "\n" [:td 