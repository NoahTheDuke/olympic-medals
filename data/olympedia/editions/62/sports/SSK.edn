ue "BOB"} "Bobsleigh"] "\n" [:option {:value "CCS"} "Cross Country Skiing"] "\n" [:option {:value "CUR"} "Curling"] "\n" [:option {:value "FSK"} "Figure Skating"] "\n" [:option {:value "FRS"} "Freestyle Skiing"] "\n" [:option {:value "IHO"} "Ice Hockey"] "\n" [:option {:value "LUG"} "Luge"] "\n" [:option {:value "NCB"} "Nordic Combined"] "\n" [:option {:value "STK"} "Short Track Speed Skating"] "\n" [:option {:value "SKN"} "Skeleton"] "\n" [:option {:value "SJP"} "Ski Jumping"] "\n" [:option {:value "SBD"} "Snowboarding"]]] [:script {} "$('#sports_in_same_games_select').change(function(){location.href='/editions/62/sports/'+$('#sports_in_same_games_select').val()})"] [:form {:id "other_games_form", :class "form-inline", :style "display: inline", :method "get"} [:select {:name "year", :id "sport_in_other_games_select", :class "form-control"} [:option {:value ""} "Speed Skating in other Games"] "\n" [:option {:value "29"} "1924 Winter Olympics"] "\n" [:option {:value "30"} "1928 Winter Olympics"] "\n" [:option {:value "31"} "1932 Winter Olympics"] "\n" [:option {:value "32"} "1936 Winter Olympics"] "\n" [:option {:value "33"} "1948 Winter Olympics"] "\n" [:option {:value "34"} "1952 Winter Olympics"] "\n" [:option {:value "35"} "1956 Winter Olympics"] "\n" [:option {:value "36"} "1960 Winter Olympics"] "\n" [:option {:value "37"} "1964 Winter Olympics"] "\n" [:option {:value "38"} "1968 Winter Olympics"] "\n" [:option {:value "39"} "1972 Winter Olympics"] "\n" [:option {:value "40"} "1976 Winter Olympics"] "\n" [:option {:value "41"} "1980 Winter Olympics"] "\n" [:option {:value "42"} "1984 Winter Olympics"] "\n" [:option {:value "43"} "1988 Winter Olympics"] "\n" [:option {:value "44"} "1992 Winter Olympics"] "\n" [:option {:value "45"} "1994 Winter Olympics"] "\n" [:option {:value "46"} "1998 Winter Olympics"] "\n" [:option {:value "47"} "2002 Winter Olympics"] "\n" [:option {:value "49"} "2006 Winter Olympics"] "\n" [:option {:value "57"} "2010 Winter Olympics"] "\n" [:option {:value "66"} "2012 Winter Youth Olympics"] "\n" [:option {:value "58"} "2014 Winter Olympics"] "\n" [:option {:value "68"} "2016 Winter Youth Olympics"] "\n" [:option {:value "60"} "2018 Winter Olympics"] "\n" [:option {:value "70"} "2020 Winter Youth Olympics"] "\n" [:option {:value "73"} "2024 Winter Youth Olympics"] "\n" [:option {:value "72"} "2026 Winter Olympics"]]] [:script {} "$('#sport_in_other_games_select').change(function(){location.href='/editions/' + $('#sport_in_other_games_select').val() + '/sports/SSK'})"] "\n" [:h1 {} "Speed Skating at the 2022 Winter Olympics"] "\n" [:table {:class "biodata"} "\n" [:tbody {} [:tr {} "\n" [:th {} "Dates"] "\n" [:td {} "5 – 19 February 2022"] "\n"] "\n" [:tr {} "\n" [:th {} "Medal Events"] "\n" [:td {} "14"] "\n"] "\n" [:tr {} "\n" [:th {} "Venues"] "\n" [:td {} [:a {:href "/venues/2140"} "National Speed Skating Oval, Olympic Green, Beijing"]] "\n"] "\n"]] "\n" [:div {:class "description"} "\n" [:p {} "After the introduction of the mass start in 2018, the speed skating program remained the same. The overall number of participants was reduced, however, from 180 to 166, as were the number of starters per event (at most 30, down from 36) and per NOC (at most 9, down from 10)."] "\n\n" [:p {} "The competitions were held at the National Speed Skating Oval, built at the site of the 2008 Olympic field hockey and archery venues. A modern and spacey venue, the rink was praised by many skaters, even though COVID-19 restrictions had prevented staging of a serious speed skating competition prior to the Olympics, meaning nobody knew who fast it was."] "\n\n" [:p {} "Winning times turned out to be of a high level, on par with the best lowland rinks. Competitions saw most of the Olympic records beaten, and one case even the world record, which came courtesy of one of the two stars of the oval, " [:a {:href "/athletes/138219"} "Nils van der Poel"] ". The Swede not only took the 5,000 m/10,000 m double, bettering his own world best in the later event, but also made headlines with his remarkable training approach, quotes, and post-Olympic actions."] "\n\n" [:p {} "Van der Poel’s medal haul was topped by Netherlands’ " [:a {:href "/athletes/137692"} "Irene Schouten"] ", who also won the two longest distances, but added gold in the mass start and bronze in the team pursuit. Japan’s " [:a {:href "/athletes/119701"} "Miho Takagi"] " also earned four medals, one gold and three silver medals. Of note, " [:a {:href "/athletes/109767"} "Ireen Wüst"] " won her sixth gold medal in the sport, as well as her 12th and 13th medals overall, both records."] "\n\n" [:p {} "As in the past two Olympics, the Netherlands won most of the speed skating medals (12) and most of the golds (6) but was less dominant than in Sochi and PyeongChang. A record eight NOCs won gold medals in the sport, including the first ever for Belgium, the first for Sweden since 1988, the first for the USA since 2010, and the first ever for a Chinese man."] "\n\n" [:p {} "Outside of the medals, Argentina made its speed skating début through " [:a {:href "/athletes/147815"} "María Victoria Rodríguez"] ", while Great Britain’s return to Olympic speed skating after 30 years was accomplished by the couple " [:a {:href "/athletes/148370"} "Cornelius Kersten"] " and " [:a {:href "/athletes/148369"} "Ellia Smeding"] ". " [:a {:href "/athletes/82053"} "Claudia Pechstein"] " also appeared at the 1992 Olympic Winter Games, and she competed in Beijing for the eighth time, becoming only the second Winter Olympian to achieve this, as well as the oldest female Winter Olympian in any sport."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/19020400"} "500 metres, Men"]] "\n" [:td {} "Olympic"] "\n" [:td 