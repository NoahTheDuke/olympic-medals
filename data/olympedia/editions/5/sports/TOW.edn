\nDid you know?\n"] "\n"] "\n" [:div {:class "panel-body"} "\n" [:p {} "The match for 3rd place in boxing was eliminated for the 1952 Olympics. Originally, this also meant the elimination of bronze medals in the sport, but this decision was later reversed, and the losing semi-finalists finally received their medals in 1970."] "\n\n\n"] "\n"] "\n" [:div {:class "container"} "\n" [:p {} "\n" [:a {:href "/users/sign_in"} "Login"] "\n|\n" [:a {:href "/statistics/site"} "Statistics"] "\n|\n" [:a {:href "/static/about"} "About"] "\n|\n" [:a {:href "/static/faq"} "FAQ"] "\n|\n" [:a {:href "/feedbacks/new"} "Feedback"] "\n"] "\n" [:p {} "\n© " [:a {:href "/static/about"} "OlyMADMen"] " 2006 — 2026\n"] "\n"] "\n"] "\n\n" [:script {:src "/assets/lightbox.min-a06f7b5a37bdc88a78a48f95b9149ca917761a07bffb855a6d73c1a435e16552.js"}] #object[org.jsoup.nodes.TextNode 0x1fc7ad14 ""] [:script {} "\n  $('.footnote').tooltip();\n"] "\n"] "\n"] "\n")