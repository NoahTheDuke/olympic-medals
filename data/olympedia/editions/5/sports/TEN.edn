Olympics."] "\n\n" [:p {} "The 1908 Olympic events were basically European and British Empire championships.  No Americans or Australian tennis players competed in London.  Outside of Europe, the only other players were from Canada and South Africa.  In the covered court events, the representation was even more limited; only tennis players from Great Britain and Sweden took part."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/44210"} "Singles, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "6 – 11 July 1908"] "\n" [:td {} "31"] "\n" [:td {} "9"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/44260"} "Doubles, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "6 – 11 July 1908"] "\n" [:td {} "24"] "\n" [:td {} "8"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/44284"} "Singles, Covered Courts, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "6 – 11 May 1908"] "\n" [:td {} "7"] "\n" [:td {} "2"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/44297"} "Doubles, Covered Courts, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "6 –  9 May 1908"] "\n" [:td {} "10"] "\n" [:td {} "2"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/44309"} "Singles, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "7 – 11 July 1908"] "\n" [:td {} "5"] "\n" [:td {} "1"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/44325"} "Singles, Covered Courts, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "7 – 11 May 1908"] "\n" [:td {} "7"] "\n" [:td {} "2"] "\n"] "\n" [:tr {} "\n" [:td {}] "\n" [:td {}] "\n" [:td {}] "\n" [:td {:class "border-top"} "\n50 (40/10)\n"] "\n" [:td {:class "border-top"} "\n10 (10/2)\n"] "\n"] "\n"]] "\n\n\n" [:h2 {} "Medals"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n