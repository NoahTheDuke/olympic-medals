value "SWA"} "Artistic Swimming"] "\n" [:option {:value "ATH"} "Athletics"] "\n" [:option {:value "BDM"} "Badminton"] "\n" [:option {:value "BKB"} "Basketball"] "\n" [:option {:value "VBV"} "Beach Volleyball"] "\n" [:option {:value "BOX"} "Boxing"] "\n" [:option {:value "CSL"} "Canoe Slalom"] "\n" [:option {:value "CSP"} "Canoe Sprint"] "\n" [:option {:value "BMX"} "Cycling BMX Racing"] "\n" [:option {:value "MTB"} "Cycling Mountain Bike"] "\n" [:option {:value "CRD"} "Cycling Road"] "\n" [:option {:value "CTR"} "Cycling Track"] "\n" [:option {:value "DIV"} "Diving"] "\n" [:option {:value "EDR"} "Equestrian Dressage"] "\n" [:option {:value "EVE"} "Equestrian Eventing"] "\n" [:option {:value "EJP"} "Equestrian Jumping"] "\n" [:option {:value "FEN"} "Fencing"] "\n" [:option {:value "FBL"} "Football"] "\n" [:option {:value "GLF"} "Golf"] "\n" [:option {:value "HBL"} "Handball"] "\n" [:option {:value "HOC"} "Hockey"] "\n" [:option {:value "JUD"} "Judo"] "\n" [:option {:value "OWS"} "Marathon Swimming"] "\n" [:option {:value "MPN"} "Modern Pentathlon"] "\n" [:option {:value "GRY"} "Rhythmic Gymnastics"] "\n" [:option {:value "ROW"} "Rowing"] "\n" [:option {:value "SAL"} "Sailing"] "\n" [:option {:value "SHO"} "Shooting"] "\n" [:option {:value "SWM"} "Swimming"] "\n" [:option {:value "TTE"} "Table Tennis"] "\n" [:option {:value "TKW"} "Taekwondo"] "\n" [:option {:value "TEN"} "Tennis"] "\n" [:option {:value "GTR"} "Trampolining"] "\n" [:option {:value "TRI"} "Triathlon"] "\n" [:option {:value "VVO"} "Volleyball"] "\n" [:option {:value "WPO"} "Water Polo"] "\n" [:option {:value "WLF"} "Weightlifting"] "\n" [:option {:value "WRE"} "Wrestling"]]] [:script {} "$('#sports_in_same_games_select').change(function(){location.href='/editions/59/sports/'+$('#sports_in_same_games_select').val()})"] [:form {:id "other_games_form", :class "form-inline", :style "display: inline", :method "get"} [:select {:name "year", :id "sport_in_other_games_select", :class "form-control"} [:option {:value ""} "Rugby Sevens in other Games"] "\n" [:option {:value "67"} "2014 Summer Youth Olympics"] "\n" [:option {:value "69"} "2018 Summer Youth Olympics"] "\n" [:option {:value "61"} "2020 Summer Olympics"] "\n" [:option {:value "63"} "2024 Summer Olympics"]]] [:script {} "$('#sport_in_other_games_select').change(function(){location.href='/editions/' + $('#sport_in_other_games_select').val() + '/sports/RU7'})"] "\n" [:h1 {} "Rugby Sevens at the 2016 Summer Olympics"] "\n" [:table {:class "biodata"} "\n" [:tbody {} [:tr {} "\n" [:th {} "Dates"] "\n" [:td {} "6 – 11 August 2016"] "\n"] "\n" [:tr {} "\n" [:th {} "Medal Events"] "\n" [:td {} "2"] "\n"] "\n" [:tr {} "\n" [:th {} "Venues"] "\n" [:td {} [:a {:href "/venues/921"} "Estádio de Deodoro, Parque Olímpico de Deodoro, Deodoro, Rio de Janeiro"]] "\n"] "\n"]] "\n" [:div {:class "description"} "\n" [:p {} "After a gap of 92 years the sport of rugby union returned to the Olympic fold at the Rio Olympics in the form of 12 team rugby sevens tournaments for men and women. The reintroduction of the sport to the Olympic Games came as a result of a 20-year campaign by World Rugby, the international governing body that reached a culmination at the 2009 IOC session in København, Denmark where the sport, as well as golf, was voted into the Olympic programme. The main contenders for the men’s tournament were world champions New Zealand and Fiji who had won the World Sevens Series for the last years. Perennial runners-up South Africa were also earmarked for medal contention whilst Great Britain, despite only coming together as a combined team for a few months before the Games, could pick from 4th ranked England, 2009 world champions Wales and a Scotland team that had won the last World Series tournament of the 2015-16 season."] "\n\n" [:p {} "The format used saw 12 teams involved in both men’s and women’s tournaments divided into three pools each containing four teams. The top two teams in each pool were joined in the quarter-finals by the two third place teams with the best records. In the women’s tournament New Zealand also arrived as world champions but their form had been eclipsed in recent times by Australia who had won 4 of the last 6 tournaments on the World Sevens Series. The other two had been won by Canada and England. Both would also be considered as medal contenders in Rio, although England would play under the Great Britain tag with a lone Welshwoman (but no Scots) added to their squad. France and the United States appeared to be teams that could come into contention if others faltered."] "\n\n" [:p {} "So at 11am on August 6, 2016 rugby finally re-entered the Olympic Games when Spain’s Patricia Garcia took the kick off in their game against France. The pool stages and quarter finals largely went as expected, although New Zealand had to battle hard to turn back the challenge of the Americans in order to reach the semi-finals. The New Zealanders had less trouble defeating Great Britain to reach the final and their expected showdown with the Australians, who had eliminated Canada in their own semi-final. New Zealand scored first in the final but it proved a false dawn for the Kiwis and Australia went on a run of scoring that took them a 24 -7 lead. A fightback from New Zealand took them to within 7 points of their opponents but time ran out with Australia confirmed as the first Olympic women’s rugby champion. Canada avenged a pool stage defeat to Great Britain to win the bronze medal match."] "\n\n" [:p {} "If the women’s tournament had panned out in roughly in the way experts had predicted, then the same could not be said for the men’s equivalent event. A stunning upset victory by Japan sent world champions New Zealand scrambling for a quarter-final place, which they only eventually obtained via the wildcard third place qualification. Fiji and Great Britain recorded perfect records to top their pools with South Africa winning a closely contested Group B. These results saw the expected final instead take place in the quarter-finals with the world champions from New Zealand being eliminated by favourites Fiji in a hard fought contest. Joining the South Sea islanders in the last four were the British, South Africans and the surprise team, Japan. Fiji ended Japanese’s hopes with little bother but the other semi-final was an epic of defensive play that saw Great Britain overcome South Africa by 7 to 5."] "\n\n" [:p {} "The final saw the country where the sport was invented facing the nation that had appropriated the sevens version of the game as its own. It was the latter who emerged triumphant with a glittering display of rugby. The Fijians ripped through the British defence time after time and recorded 29 unanswered points in the first half of the game. The game concluded 43-7 in favour of the team from the Pacific. This was Fiji’s first ever Olympic medal after 64 years of competition and was greeted with a public holiday on their home islands."] "\n\n" [:p {} "The tournament was held in a temporary stadium at the Deodoro Modern Pentathlon Park, which replaced the proposed venue at Estádio São Januário, the home of Vasco Da Gama Football Club."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/357350"} "Rugby Sevens, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "9 – 11 August 2016"] "\n" [:td {} "151"] "\n" [:td {} "12"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/357395"} "Rugby Sevens, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "6 –  8 August 2016"] "\n" [:td {} "148"] "\n" [:td {} "12"] "\n"] "\n" [:tr {} "\n" [:td {}] "\n" [:td {}] "\n" [:td {}] "\n" [:td {:class "border-top"} "\n299 (151/148)\n"] "\n" [:td {:class "border-top"} "\n14 (12/12)\n"] "\n"] "\n"]] "\n\n\n" [:h2 {} "Medals"]