value "CRD"} "Cycling Road"] "\n" [:option {:value "CTR"} "Cycling Track"] "\n" [:option {:value "DIV"} "Diving"] "\n" [:option {:value "FEN"} "Fencing"] "\n" [:option {:value "FBL"} "Football"] "\n" [:option {:value "ROW"} "Rowing"] "\n" [:option {:value "SHO"} "Shooting"] "\n" [:option {:value "TEN"} "Tennis"] "\n" [:option {:value "TOW"} "Tug-Of-War"] "\n" [:option {:value "WLF"} "Weightlifting"] "\n" [:option {:value "WRE"} "Wrestling"]]] [:script {} "$('#sports_in_same_games_select').change(function(){location.href='/editions/4/sports/'+$('#sports_in_same_games_select').val()})"] [:form {:id "other_games_form", :class "form-inline", :style "display: inline", :method "get"} [:select {:name "year", :id "sport_in_other_games_select", :class "form-control"} [:option {:value ""} "Swimming in other Games"] "\n" [:option {:value "1"} "1896 Summer Olympics"] "\n" [:option {:value "2"} "1900 Summer Olympics"] "\n" [:option {:value "3"} "1904 Summer Olympics"] "\n" [:option {:value "5"} "1908 Summer Olympics"] "\n" [:option {:value "6"} "1912 Summer Olympics"] "\n" [:option {:value "7"} "1920 Summer Olympics"] "\n" [:option {:value "8"} "1924 Summer Olympics"] "\n" [:option {:value "9"} "1928 Summer Olympics"] "\n" [:option {:value "10"} "1932 Summer Olympics"] "\n" [:option {:value "11"} "1936 Summer Olympics"] "\n" [:option {:value "12"} "1948 Summer Olympics"] "\n" [:option {:value "13"} "1952 Summer Olympics"] "\n" [:option {:value "14"} "1956 Summer Olympics"] "\n" [:option {:value "15"} "1960 Summer Olympics"] "\n" [:option {:value "16"} "1964 Summer Olympics"] "\n" [:option {:value "17"} "1968 Summer Olympics"] "\n" [:option {:value "18"} "1972 Summer Olympics"] "\n" [:option {:value "19"} "1976 Summer Olympics"] "\n" [:option {:value "20"} "1980 Summer Olympics"] "\n" [:option {:value "21"} "1984 Summer Olympics"] "\n" [:option {:value "22"} "1988 Summer Olympics"] "\n" [:option {:value "23"} "1992 Summer Olympics"] "\n" [:option {:value "24"} "1996 Summer Olympics"] "\n" [:option {:value "25"} "2000 Summer Olympics"] "\n" [:option {:value "26"} "2004 Summer Olympics"] "\n" [:option {:value "53"} "2008 Summer Olympics"] "\n" [:option {:value "65"} "2010 Summer Youth Olympics"] "\n" [:option {:value "54"} "2012 Summer Olympics"] "\n" [:option {:value "67"} "2014 Summer Youth Olympics"] "\n" [:option {:value "59"} "2016 Summer Olympics"] "\n" [:option {:value "69"} "2018 Summer Youth Olympics"] "\n" [:option {:value "61"} "2020 Summer Olympics"] "\n" [:option {:value "63"} "2024 Summer Olympics"]]] [:script {} "$('#sport_in_other_games_select').change(function(){location.href='/editions/' + $('#sport_in_other_games_select').val() + '/sports/SWM'})"] "\n" [:h1 {} "Swimming at the 1906  Intercalated Games"] "\n" [:table {:class "biodata"} "\n" [:tbody {} [:tr {} "\n" [:th {} "Dates"] "\n" [:td {} "24 – 28 April 1906"] "\n"] "\n" [:tr {} "\n" [:th {} "Medal Events"] "\n" [:td {} "4"] "\n"] "\n" [:tr {} "\n" [:th {} "Venues"] "\n" [:td {} [:a {:href "/venues/214"} "Ormos Falirou, Peiraias"]] "\n"] "\n"]] "\n" [:div {:class "description"} "\n" [:p {} "The 1906 swimming competitions were held in the " [:a {:href "/venues/214"} "Faliron Bay"] ", off the coast of Athens. This was in contrast to " [:a {:href "/editions/1/sports/SWM"} "1896"] ", when the events were held in a nearby bay, the " [:a {:href "/venues/190"} "Bay of Zea"] ". The judges had trouble with the open bay as the site for the swimming events because they had difficulty keeping the swimming lanes free of private boats. Barcs noted that “most of the swimmers complained because of the waves water got into their throat as they tried to breathe, and so they lost valuable seconds. Some even suffered from bouts of coughing and were forced to give up the race.”"] "\n\n" [:p {} "This was probably the greatest international swimming competition held to that time. Almost all of the greatest swimmers in the world were present. The British sent their top swimmers, Hungary was represented by " [:a {:href "/athletes/48187"} "Zoltán Halmay"] ", who was easily their greatest swimmer of that era, the Americans were represented by their greatest swimmer, " [:a {:href "/athletes/51308"} "Charlie Daniels"] ", and the Australians also sent one top swimmer, " [:a {:href "/athletes/45217"} "Cecil Healy"] "."] "\n\n" [:p {} "One swimmer, however, was tragically absent. This was the Australian Bernard Bede “Barney” Kieran, who was the world record holder at two of the events on the programme, the 400 metres and one mile freestyle events. He was the greatest Australian swimmer in the first decade of the 20th century and had set multiple world records in 1905. It was expected that he would compete at Athens in 1906 but, near the end of 1905, he underwent surgery for appendicitis and died during the surgery. However, he left his mark on the 1906 Olympics in the person of Charlie Daniels. In 1905, Daniels faced Kieran at a meet in London, in which Kieran defeated Daniels easily. Kieran gave Daniels several pointers concerning his stroke and Daniels improved greatly after that, enabling him to win the " [:a {:href "/results/4471"} "100-metre freestyle"] " at Athens in 1906."] "\n\n" [:p {} "The 1906 swimming competitions were marred by poor weather as they were held out in the open sea. They were begun on 24 April [11 April], and several events were also contested for 25 April [12 April]. However, the entire schedule on 26 April [13 April] had to be canceled because gale force winds that day brought huge waves to the Faliron Bay, and the swimming competitions (and the " [:a {:href "/results/54001"} "diving event"] ") could not be conducted on that day."] "\n\n" [:p {} "On 27 April [14 April], when the swimming competitions resumed, they were started but gale force winds again blew up in the afternoon, roughening the seas so much that the events were again postponed until the next day."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-stri