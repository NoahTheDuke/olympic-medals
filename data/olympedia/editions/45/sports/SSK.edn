ue "BOB"} "Bobsleigh"] "\n" [:option {:value "CCS"} "Cross Country Skiing"] "\n" [:option {:value "FSK"} "Figure Skating"] "\n" [:option {:value "FRS"} "Freestyle Skiing"] "\n" [:option {:value "IHO"} "Ice Hockey"] "\n" [:option {:value "LUG"} "Luge"] "\n" [:option {:value "NCB"} "Nordic Combined"] "\n" [:option {:value "STK"} "Short Track Speed Skating"] "\n" [:option {:value "SJP"} "Ski Jumping"]]] [:script {} "$('#sports_in_same_games_select').change(function(){location.href='/editions/45/sports/'+$('#sports_in_same_games_select').val()})"] [:form {:id "other_games_form", :class "form-inline", :style "display: inline", :method "get"} [:select {:name "year", :id "sport_in_other_games_select", :class "form-control"} [:option {:value ""} "Speed Skating in other Games"] "\n" [:option {:value "29"} "1924 Winter Olympics"] "\n" [:option {:value "30"} "1928 Winter Olympics"] "\n" [:option {:value "31"} "1932 Winter Olympics"] "\n" [:option {:value "32"} "1936 Winter Olympics"] "\n" [:option {:value "33"} "1948 Winter Olympics"] "\n" [:option {:value "34"} "1952 Winter Olympics"] "\n" [:option {:value "35"} "1956 Winter Olympics"] "\n" [:option {:value "36"} "1960 Winter Olympics"] "\n" [:option {:value "37"} "1964 Winter Olympics"] "\n" [:option {:value "38"} "1968 Winter Olympics"] "\n" [:option {:value "39"} "1972 Winter Olympics"] "\n" [:option {:value "40"} "1976 Winter Olympics"] "\n" [:option {:value "41"} "1980 Winter Olympics"] "\n" [:option {:value "42"} "1984 Winter Olympics"] "\n" [:option {:value "43"} "1988 Winter Olympics"] "\n" [:option {:value "44"} "1992 Winter Olympics"] "\n" [:option {:value "46"} "1998 Winter Olympics"] "\n" [:option {:value "47"} "2002 Winter Olympics"] "\n" [:option {:value "49"} "2006 Winter Olympics"] "\n" [:option {:value "57"} "2010 Winter Olympics"] "\n" [:option {:value "66"} "2012 Winter Youth Olympics"] "\n" [:option {:value "58"} "2014 Winter Olympics"] "\n" [:option {:value "68"} "2016 Winter Youth Olympics"] "\n" [:option {:value "60"} "2018 Winter Olympics"] "\n" [:option {:value "70"} "2020 Winter Youth Olympics"] "\n" [:option {:value "62"} "2022 Winter Olympics"] "\n" [:option {:value "73"} "2024 Winter Youth Olympics"] "\n" [:option {:value "72"} "2026 Winter Olympics"]]] [:script {} "$('#sport_in_other_games_select').change(function(){location.href='/editions/' + $('#sport_in_other_games_select').val() + '/sports/SSK'})"] "\n" [:h1 {} "Speed Skating at the 1994 Winter Olympics"] "\n" [:table {:class "biodata"} "\n" [:tbody {} [:tr {} "\n" [:th {} "Dates"] "\n" [:td {} "13 – 25 February 1994"] "\n"] "\n" [:tr {} "\n" [:th {} "Medal Events"] "\n" [:td {} "10"] "\n"] "\n" [:tr {} "\n" [:th {} "Venues"] "\n" [:td {} [:a {:href "/venues/66"} "Olympiahall, Hamar"]] "\n"] "\n"]] "\n" [:div {:class "description"} "\n" [:p {} "Like the other skating events, the 1994 Olympic speed skating competitions were held in the town of Hamar, some 60 km south of Lillehammer. Hamar has a rich speed skating history. International championships had been held on the Mjøsa Lake outside of the town in the late 19th century. Later, competitions had been held at Hamar Stadion, where " [:a {:href "/athletes/83598"} "Hjalmar Andersen"] " most famously skated his 16:32.6 world record in the 10,000 m, which lasted for 8 years. For the 1994 Games, a new indoor rink was built, the Olympia Hall. It is more generally known by its nickname, the Vikingskipet (“Viking ship”), as its roof resembles the hull of a Viking ship. The hall had opened in 1993, and was fast, as evidenced by four world records being skated during the the pre-Olympic World Cup competition and European Championships. During Olympic competition, four world records would fall, all in the men’s events."] "\n\n" [:p {} "While the program of the speed skating events had remained the same, entry regulations had become much stricter than in 1992. For the first time, skaters wanting to compete in the Olympics needed to achieve qualifying times. In addition, the number of competitors in the longest events was restricted. In the 3000 m (women) and 5000 m (men), only 32 competitors were allowed. The top 16 skaters in that event would earn one spot for their country in the longest distance (5000 m / 10000 m), which was restricted to 16 competitors. Despite this restriction, several countries débuted in Olympic speed skating, all due to the break-up of the Soviet Union. Belarus, Kazakhstan, Russian and Ukraine all entered for the first time. In addition Latvia returned after nearly 60 years, having last competed in 1936."] "\n\n" [:p {} "Media coverage of the men’s events was dominated by two skaters. Norwegian " [:a {:href "/athletes/88548"} "Johann Olav Koss"] " emulated Hjalmar Andersen’s performance from 1952 by winning three gold medals in front of a home crowd, while " [:a {:href "/athletes/87473"} "Dan Jansen"] " finally won a gold medal in the 1,000 m, after failing to do so in the 500 m for the fourth time. Of the female skaters, " [:a {:href "/athletes/80673"} "Bonnie Blair"] " repeated her double victory of the 1992 Games, while expected triple champion " [:a {:href "/athletes/81514"} "Gunda Niemann"] " surprisingly failed and )only) won a silver and a bronze medal."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/1084"} "500 metres, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "14 February 1994"] "\n" [:td {} "40"] "\n" [:td {} "16"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/1085"} "1,000 metres, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "18 February 1994"] "\n" [:td {} "43"] "\n" [:td {} "17"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/1086"} "1,500 metres, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "16 February 1994"] "\n" [:td {} "44"] "\