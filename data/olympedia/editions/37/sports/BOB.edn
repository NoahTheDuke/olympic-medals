 "Cross Country Skiing"] "\n" [:option {:value "FSK"} "Figure Skating"] "\n" [:option {:value "IHO"} "Ice Hockey"] "\n" [:option {:value "LUG"} "Luge"] "\n" [:option {:value "NCB"} "Nordic Combined"] "\n" [:option {:value "SJP"} "Ski Jumping"] "\n" [:option {:value "SSK"} "Speed Skating"]]] [:script {} "$('#sports_in_same_games_select').change(function(){location.href='/editions/37/sports/'+$('#sports_in_same_games_select').val()})"] [:form {:id "other_games_form", :class "form-inline", :style "display: inline", :method "get"} [:select {:name "year", :id "sport_in_other_games_select", :class "form-control"} [:option {:value ""} "Bobsleigh in other Games"] "\n" [:option {:value "29"} "1924 Winter Olympics"] "\n" [:option {:value "30"} "1928 Winter Olympics"] "\n" [:option {:value "31"} "1932 Winter Olympics"] "\n" [:option {:value "32"} "1936 Winter Olympics"] "\n" [:option {:value "33"} "1948 Winter Olympics"] "\n" [:option {:value "34"} "1952 Winter Olympics"] "\n" [:option {:value "35"} "1956 Winter Olympics"] "\n" [:option {:value "38"} "1968 Winter Olympics"] "\n" [:option {:value "39"} "1972 Winter Olympics"] "\n" [:option {:value "40"} "1976 Winter Olympics"] "\n" [:option {:value "41"} "1980 Winter Olympics"] "\n" [:option {:value "42"} "1984 Winter Olympics"] "\n" [:option {:value "43"} "1988 Winter Olympics"] "\n" [:option {:value "44"} "1992 Winter Olympics"] "\n" [:option {:value "45"} "1994 Winter Olympics"] "\n" [:option {:value "46"} "1998 Winter Olympics"] "\n" [:option {:value "47"} "2002 Winter Olympics"] "\n" [:option {:value "49"} "2006 Winter Olympics"] "\n" [:option {:value "57"} "2010 Winter Olympics"] "\n" [:option {:value "66"} "2012 Winter Youth Olympics"] "\n" [:option {:value "58"} "2014 Winter Olympics"] "\n" [:option {:value "68"} "2016 Winter Youth Olympics"] "\n" [:option {:value "60"} "2018 Winter Olympics"] "\n" [:option {:value "70"} "2020 Winter Youth Olympics"] "\n" [:option {:value "62"} "2022 Winter Olympics"] "\n" [:option {:value "73"} "2024 Winter Youth Olympics"] "\n" [:option {:value "72"} "2026 Winter Olympics"]]] [:script {} "$('#sport_in_other_games_select').change(function(){location.href='/editions/' + $('#sport_in_other_games_select').val() + '/sports/BOB'})"] "\n" [:h1 {} "Bobsleigh at the 1964 Winter Olympics"] "\n" [:table {:class "biodata"} "\n" [:tbody {} [:tr {} "\n" [:th {} "Dates"] "\n" [:td {} "31 January –  7 February 1964"] "\n"] "\n" [:tr {} "\n" [:th {} "Medal Events"] "\n" [:td {} "2"] "\n"] "\n" [:tr {} "\n" [:th {} "Venues"] "\n" [:td {} [:a {:href "/venues/54"} "Kunsteis-Bob- und Rodelbahn, Igls"]] "\n"] "\n"]] "\n" [:div {:class "description"} "\n" [:p {} "For the only time in Winter Games history there had been no bobsleigh competition at the 1960 Winter Olympics at Squaw Valley. The Squaw Valley organizers polled the Winter Olympic nations and found that only nine countries were planning on entering a bobsled team so they elected to scrap the entire bobsleigh programme. The Fédération Internationale de Bobsleigh et de Tobogganing (FIBT) was furious and asked the IOC to overrule the decision, but to no avail. The FIBT decided instead to hold a World Championship, not usually held in Olympic years, in 1960 at Cortina d’Ampezzo, and both the two and four man titles were won by bobs piloted by Italy’s " [:a {:href "/athletes/95556"} "Eugenio Monti"] ". The FIBT would not again hold World Championships in the Winter Olympic year until 1992."] "\n\n" [:p {} "For the 1964 Games a track was built 7 km south from the centre of Innsbruck in the district of Igls near to the site that held the disastrous 1935 World Championship which was marred by a brace of fatal accidents. The artificial track, the first of its’ kind to feature in Olympic competition, measured 1506 m in length, and had 14 curves. The start was located at 1133 m above sea level, and the finish line 138 m lower, making for an average descent of 9.2%. The track was completed in time to host the 1963 World Championship."] "\n\n" [:p {} "One oddity of the 1964 bobsleigh events was that neither of the gold medal winning crews came from a country which had a bobsled track. The British two man crew made the Sankt Moritz track in Switzerland their regular winter base whilst the Canadian quartet trained below the border in Lake Placid, New York."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/309"} "Two, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "31 January –  1 February 1964"] "\n" [:td {} "42"] "\n" [:td {} "11"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/316"} "Four, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "5 –  7 February 1964"] "\n" [:td {} "75"] "\n" [:td {} "11"] "\n"] "\n" [:tr {} "\n" [:td {}] "\n" [:td {}] "\n" [:td {}] "\n" [:td {:class "border-top"} "\n81 (81/0)\n"] "\n" [:td {:class "border-top"} "\n11 (11/0)\n"] "\n"] "\n"]] "\n\n\n" [:h2 {} "Medals"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {:colspan "2"} [:span {:class "Gold"} "Gold"]] "\n" [:th {:colspan "2"} [:span {:class "Silver"} "Silver"]] "\n" [:th {:colspan "2"} [:span {:class "Bronze"} "Bronze"]] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {:class "top"} [:a {:href "/results/309"} "Two, Men"]] "\n" [:td {:style "vertical-align: top"} "Great Britain 1"] [:td {:style "vertical-align: top"} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/GBR.png"}] "GBR"]] "\n" [:td {:style "vertical-align: top"} "Italy 2"] [:td {:style "vertical-align: top"} [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazo