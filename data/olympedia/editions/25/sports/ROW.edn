2"} "1900 Summer Olympics"] "\n" [:option {:value "3"} "1904 Summer Olympics"] "\n" [:option {:value "4"} "1906  Intercalated Games"] "\n" [:option {:value "5"} "1908 Summer Olympics"] "\n" [:option {:value "6"} "1912 Summer Olympics"] "\n" [:option {:value "7"} "1920 Summer Olympics"] "\n" [:option {:value "8"} "1924 Summer Olympics"] "\n" [:option {:value "9"} "1928 Summer Olympics"] "\n" [:option {:value "10"} "1932 Summer Olympics"] "\n" [:option {:value "11"} "1936 Summer Olympics"] "\n" [:option {:value "12"} "1948 Summer Olympics"] "\n" [:option {:value "13"} "1952 Summer Olympics"] "\n" [:option {:value "14"} "1956 Summer Olympics"] "\n" [:option {:value "15"} "1960 Summer Olympics"] "\n" [:option {:value "16"} "1964 Summer Olympics"] "\n" [:option {:value "17"} "1968 Summer Olympics"] "\n" [:option {:value "18"} "1972 Summer Olympics"] "\n" [:option {:value "19"} "1976 Summer Olympics"] "\n" [:option {:value "20"} "1980 Summer Olympics"] "\n" [:option {:value "21"} "1984 Summer Olympics"] "\n" [:option {:value "22"} "1988 Summer Olympics"] "\n" [:option {:value "23"} "1992 Summer Olympics"] "\n" [:option {:value "24"} "1996 Summer Olympics"] "\n" [:option {:value "26"} "2004 Summer Olympics"] "\n" [:option {:value "53"} "2008 Summer Olympics"] "\n" [:option {:value "65"} "2010 Summer Youth Olympics"] "\n" [:option {:value "54"} "2012 Summer Olympics"] "\n" [:option {:value "67"} "2014 Summer Youth Olympics"] "\n" [:option {:value "59"} "2016 Summer Olympics"] "\n" [:option {:value "69"} "2018 Summer Youth Olympics"] "\n" [:option {:value "61"} "2020 Summer Olympics"] "\n" [:option {:value "63"} "2024 Summer Olympics"]]] [:script {} "$('#sport_in_other_games_select').change(function(){location.href='/editions/' + $('#sport_in_other_games_select').val() + '/sports/ROW'})"] "\n" [:h1 {} "Rowing at the 2000 Summer Olympics"] "\n" [:table {:class "biodata"} "\n" [:tbody {} [:tr {} "\n" [:th {} "Dates"] "\n" [:td {} "17 – 24 September 2000"] "\n"] "\n" [:tr {} "\n" [:th {} "Medal Events"] "\n" [:td {} "14"] "\n"] "\n" [:tr {} "\n" [:th {} "Venues"] "\n" [:td {} [:a {:href "/venues/753"} "Sydney International Regatta Centre, Penrith, New South Wales"]] "\n"] "\n"]] "\n" [:div {:class "description"} "\n" [:p {} "Rowing at the 2000 Summer Olympics was held at the " [:a {:href "/venues/753"} "Sydney International Regatta Centre"] ", a venue built specifically for the Games. Increased efforts to draw in more countries to all events in the Olympics helped rowing set a new participation record of 51 nations. The men’s single sculls saw three new nations: Kazakhstan through " [:a {:href "/athletes/92623"} "Vladimir Belonogov"] ", Tunisia through " [:a {:href "/athletes/92705"} "Riadh Ben Khedher"] ", and Pakistan through " [:a {:href "/athletes/92653"} "Muhammad Akram"] ". Tunisia also sent " [:a {:href "/athletes/92706"} "Ibtissem Trimèch"] " to the women’s single sculls, while Pakistan was also represented by " [:a {:href "/athletes/92655"} "Zahid Ali Pirzada"] " and " [:a {:href "/athletes/92654"} "Hazrat Islam"] " in the lightweight double sculls. " [:a {:href "/athletes/92704"} "Phuttharaksa Nikree"] ", meanwhile, made her first of three (as of 2012) appearances as Thailand’s only representative in rowing. India sent " [:a {:href "/athletes/92599"} "Kasam Khan"] " and " [:a {:href "/athletes/92600"} "Inderpal Singh"] " to debut in the men’s coxless pairs, while the new entity of Serbia and Montenegro (the Federal Republic of Yugoslavia) appeared for the first time in the men’s coxless pairs and fours."] "\n\n" [:p {} "Romania won three medals, all of them gold, to top the table in 2000, but the results were fairly evenly spread out, with France, Great Britain, and Germany all taking two titles, the latter of whom won six medals overall. Australia, meanwhile, took five medals without winning a single event. Both Lithuania, in the women’s double sculls, and Croatia, in the men’s coxed eights, won their first medals as independent nations with third-place finishes, while Slovenia won its first Olympic rowing title in the men’s double sculls (and one of its first two gold medals ever, along with " [:a {:href "/athletes/43999"} "Rajmond Debevec"] "’s victory in the rifle, three positions at 50 metres). Great Britain, meanwhile, won the men’s coxed eights for the first time since 1912."] "\n\n" [:p {} "The 2000 program remained the same from the 1996 edition, which is, as of 2012, its current state.  There were two sets of multiple medalists: " [:a {:href "/athletes/92645"} "Pieta van Dishoeck"] " and " [:a {:href "/athletes/38831"} "Eeke van Nes"] " were runners-up in the women’s double sculls and coxed eights, while Romania’s " [:a {:href "/athletes/92674"} "Georgeta Damian"] " and " [:a {:href "/athletes/39501"} "Doina Ignat"] " became champions in the women’s coxless pairs and coxed eights. Another notable champion was Great Britain’s " [:a {:href "/athletes/37440"} "Steven Redgrave"] ", who capped off a legendary career by winning the coxless fours for his fifth Olympic title (and sixth Olympic medal overall), his first having come in the coxed fours at the 1984 Games. He was, at the time, the oldest rower to win Olympic gold (Australia’s " [:a {:href "/athletes/35534"} "James Tomkins"] " and Romania’s " [:a {:href "/athletes/39517"} "Elisabeta Lipă"] " would surpass him in 2004) and remains the only rower to have captured a title at five consecutive Olympics."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/159542"} "Single Sculls, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "17 – 23 September 2000"] "\n" [:td {} "24"] "\n" [:td {} "24"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/159563"} "Double Sculls, Men"]] "\n" [:td {} "Olympic"] "\