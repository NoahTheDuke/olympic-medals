e "SWA"} "Artistic Swimming"] "\n" [:option {:value "ATH"} "Athletics"] "\n" [:option {:value "BBL"} "Baseball"] "\n" [:option {:value "BOX"} "Boxing"] "\n" [:option {:value "CSP"} "Canoe Sprint"] "\n" [:option {:value "CRD"} "Cycling Road"] "\n" [:option {:value "CTR"} "Cycling Track"] "\n" [:option {:value "DIV"} "Diving"] "\n" [:option {:value "EDR"} "Equestrian Dressage"] "\n" [:option {:value "EVE"} "Equestrian Eventing"] "\n" [:option {:value "EJP"} "Equestrian Jumping"] "\n" [:option {:value "FEN"} "Fencing"] "\n" [:option {:value "FBL"} "Football"] "\n" [:option {:value "HBL"} "Handball"] "\n" [:option {:value "HOC"} "Hockey"] "\n" [:option {:value "JUD"} "Judo"] "\n" [:option {:value "MPN"} "Modern Pentathlon"] "\n" [:option {:value "GRY"} "Rhythmic Gymnastics"] "\n" [:option {:value "ROW"} "Rowing"] "\n" [:option {:value "SAL"} "Sailing"] "\n" [:option {:value "SHO"} "Shooting"] "\n" [:option {:value "SWM"} "Swimming"] "\n" [:option {:value "TEN"} "Tennis"] "\n" [:option {:value "VVO"} "Volleyball"] "\n" [:option {:value "WPO"} "Water Polo"] "\n" [:option {:value "WLF"} "Weightlifting"] "\n" [:option {:value "WRE"} "Wrestling"]]] [:script {} "$('#sports_in_same_games_select').change(function(){location.href='/editions/21/sports/'+$('#sports_in_same_games_select').val()})"] [:form {:id "other_games_form", :class "form-inline", :style "display: inline", :method "get"} [:select {:name "year", :id "sport_in_other_games_select", :class "form-control"} [:option {:value ""} "Basketball in other Games"] "\n" [:option {:value "3"} "1904 Summer Olympics"] "\n" [:option {:value "11"} "1936 Summer Olympics"] "\n" [:option {:value "12"} "1948 Summer Olympics"] "\n" [:option {:value "13"} "1952 Summer Olympics"] "\n" [:option {:value "14"} "1956 Summer Olympics"] "\n" [:option {:value "15"} "1960 Summer Olympics"] "\n" [:option {:value "16"} "1964 Summer Olympics"] "\n" [:option {:value "17"} "1968 Summer Olympics"] "\n" [:option {:value "18"} "1972 Summer Olympics"] "\n" [:option {:value "19"} "1976 Summer Olympics"] "\n" [:option {:value "20"} "1980 Summer Olympics"] "\n" [:option {:value "22"} "1988 Summer Olympics"] "\n" [:option {:value "23"} "1992 Summer Olympics"] "\n" [:option {:value "24"} "1996 Summer Olympics"] "\n" [:option {:value "25"} "2000 Summer Olympics"] "\n" [:option {:value "26"} "2004 Summer Olympics"] "\n" [:option {:value "53"} "2008 Summer Olympics"] "\n" [:option {:value "54"} "2012 Summer Olympics"] "\n" [:option {:value "59"} "2016 Summer Olympics"] "\n" [:option {:value "61"} "2020 Summer Olympics"] "\n" [:option {:value "63"} "2024 Summer Olympics"]]] [:script {} "$('#sport_in_other_games_select').change(function(){location.href='/editions/' + $('#sport_in_other_games_select').val() + '/sports/BKB'})"] "\n" [:h1 {} "Basketball at the 1984 Summer Olympics"] "\n" [:table {:class "biodata"} "\n" [:tbody {} [:tr {} "\n" [:th {} "Dates"] "\n" [:td {} "29 July – 10 August 1984"] "\n"] "\n" [:tr {} "\n" [:th {} "Medal Events"] "\n" [:td {} "2"] "\n"] "\n" [:tr {} "\n" [:th {} "Venues"] "\n" [:td {} [:a {:href "/venues/601"} "The Forum, Inglewood, California"]] "\n"] "\n"]] "\n" [:div {:class "description"} "\n" [:p {} "The 1984 Olympic basketball tournaments were held at the Los Angeles Forum, famous as the long-time home of the Los Angeles Lakers of the NBA. The Forum, as it was later called (it has had various names), was built in 1967 and is still in use, now primarily as an entertainment and concert venue."] "\n\n" [:p {} "There were again 12 teams in the men’s tournament. The absence of the Soviet Union weakened the field, but Yugoslavia was still present in Los Angeles. Except for the Soviets, the Eastern Bloc boycott had little effect on the tournament. Defending champion Yugoslavia, 1980 runner-up Italy, and host United States were automatically eligible. The other qualifying tournaments were as follows – European Olympic Qualifying Tournament (Spain, France, West Germany); Americas Olympic Qualifying Tournament (Brazil, Uruguay, Canada); and the 1983 Oceanian, Asian, and African Champions (Australia, China, Egypt, respectively)."] "\n\n" [:p {} "The 12 teams were separated into two six-team groups, which played a round-robin tournament. New in 1984 was that the knock-out phase now included quarter-finals, as the top four teams in each group qualified for the quarters. The United States had won of the strongest amateur teams ever assembled, which included " [:a {:href "/athletes/6342"} "Michael Jordan"] " and " [:a {:href "/athletes/6085"} "Patrick Ewing"] ", and they won the tournament easily, defeating Spain in the final game by 31 points. It is highly unlikely the Soviet Union would have changed the outcome, given the strength of the US team."] "\n\n" [:p {} "The women’s format was the same as in 1980 with six teams playing a round-robin and the top two teams in the field playing a final match for the gold medal, while the 3rd- and 4th-place teams played for the bronze medal. The United States was eligible as the host nation, as were the Soviet Union as the 1983 World Champion, but they did not compete. The other spots came from the World Olympic Qualifying Tournament, and were awarded to China, Yugoslavia, Canada, Korea, and Australia. Australia was the replacement team for the Soviets."] "\n\n" [:p {} "The United States women also won the gold medal, going undefeated, and crushing Korea, 85-55, in the final match. China won the bronze medal with a 63-57 victory over Canada."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/32570"} "Basketball, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "29 July – 10 August 1984"] "\n" [:td {} "142"] "\n" [:td {} "12"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/32625"} "Bas