ion {:value "10"} "1932 Summer Olympics"] "\n" [:option {:value "11"} "1936 Summer Olympics"] "\n" [:option {:value "13"} "1952 Summer Olympics"] "\n" [:option {:value "14"} "1956 Summer Olympics"] "\n" [:option {:value "15"} "1960 Summer Olympics"] "\n" [:option {:value "16"} "1964 Summer Olympics"] "\n" [:option {:value "17"} "1968 Summer Olympics"] "\n" [:option {:value "18"} "1972 Summer Olympics"] "\n" [:option {:value "19"} "1976 Summer Olympics"] "\n" [:option {:value "20"} "1980 Summer Olympics"] "\n" [:option {:value "21"} "1984 Summer Olympics"] "\n" [:option {:value "22"} "1988 Summer Olympics"] "\n" [:option {:value "23"} "1992 Summer Olympics"] "\n" [:option {:value "24"} "1996 Summer Olympics"] "\n" [:option {:value "25"} "2000 Summer Olympics"] "\n" [:option {:value "26"} "2004 Summer Olympics"] "\n" [:option {:value "53"} "2008 Summer Olympics"] "\n" [:option {:value "65"} "2010 Summer Youth Olympics"] "\n" [:option {:value "54"} "2012 Summer Olympics"] "\n" [:option {:value "67"} "2014 Summer Youth Olympics"] "\n" [:option {:value "59"} "2016 Summer Olympics"] "\n" [:option {:value "69"} "2018 Summer Youth Olympics"] "\n" [:option {:value "61"} "2020 Summer Olympics"] "\n" [:option {:value "63"} "2024 Summer Olympics"]]] [:script {} "$('#sport_in_other_games_select').change(function(){location.href='/editions/' + $('#sport_in_other_games_select').val() + '/sports/GAR'})"] "\n" [:h1 {} "Artistic Gymnastics at the 1948 Summer Olympics"] "\n" [:table {:class "biodata"} "\n" [:tbody {} [:tr {} "\n" [:th {} "Dates"] "\n" [:td {} "7 – 14 August 1948"] "\n"] "\n" [:tr {} "\n" [:th {} "Medal Events"] "\n" [:td {} "9"] "\n"] "\n" [:tr {} "\n" [:th {} "Non-medal Events"] "\n" [:td {} "2"] "\n"] "\n" [:tr {} "\n" [:th {} "Venues"] "\n" [:td {} [:a {:href "/venues/341"} "Empress Hall, Earls Court Exhibition Centre, Kensington, London"]] "\n"] "\n"]] "\n" [:div {:class "description"} "\n" [:p {} "The 1948 Olympic gymnastics events were scheduled to be held outdoors, in the " [:a {:href "/venues/339"} "Empire Stadium"] ", but the " [:a {:href "/organizations/1"} "IOC"] " and the " [:a {:href "/organizations/62"} "FIG (Fédération Internationale de Gymnastique)"] " did not count on the vagaries of an English summer and, when rain made it impossible to conduct the gymnastics events outdoors, they were switched, literally at the last minute, to the " [:a {:href "/venues/341"} "Empress Hall"] ", at the Earls Court Exhibition Centre. The events were also postponed for three days because of the venue switch."] "\n\n" [:p {} "The men contested the standard Olympic programme, with all-around competition in " [:a {:href "/results/70135"} "individual"] " and " [:a {:href "/results/70136"} "teams"] ". All entrants competed on every apparatus, with the individual all-around scores simply added from the apparatus scores, and the team scores derived by adding the individual team member scores. This was the last Olympics at which the Soviet Union would not compete and, beginning in " [:a {:href "/editions/13/sports/GAR"} "1952"] ", they would start to dominate gymnastics."] "\n\n" [:p {} "Women contested only a " [:a {:href "/results/70149"} "team all-around event"] ", which was the last time the women would not have individual apparatus championships or an individual all-around at the Olympics. The women’s team event was especially poignant. Czechoslovakia brought two Misáková sisters – " [:a {:href "/athletes/1805149"} "Eliška"] " and " [:a {:href "/athletes/29133"} "Miloslava"] ". However, Eliška contracted poliomyelitis on arriving in England, and was quickly placed into an iron lung for four days at Uxbridge Isolation Hospital. She died on the day the women’s gymnastic event started. Czechoslovakia still competed and won the gold medal. At the victory ceremony, the Czechoslovak flag was raised with a black border around it in mourning for Eliška."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:the