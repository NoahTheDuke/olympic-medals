place finish. In women’s hockey, Switzerland became only the fifth nation to win an Olympic medal, a feat it accomplished despite winning only two games in the tournament."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/350334"} "Ice Hockey, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "12 – 23 February 2014"] "\n" [:td {} "286"] "\n" [:td {} "12"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/350374"} "Ice Hockey, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "8 – 20 February 2014"] "\n" [:td {} "158"] "\n" [:td {} "8"] "\n"] "\n" [:tr {} "\n" [:td {}] "\n" [:td {}] "\n" [:td {}] "\n" [:td {:class "border-top"} "\n444 (286/158)\n"] "\n" [:td {:class "border-top"} "\n14 (12/8)\n"] "\n"] "\n"]] "\n\n\n" [:h2 {} "Medals"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {:colspan "2"} [:span {:class "Gold"} "Gold"]] "\n" [:th {:colspan "2"} [:span {:class "Silver"} "Silver"]] "\n" [:th {:colspan "2"} [:span {:class "Bronze"} "Bronze"]] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {:class "top"} [:a {:href "/results/350334"} "Ice Hockey, Men"]] "\n" [:td {:style "vertical-align: top"} "Canada"] [:td {:style "vertical-align: top"} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"]] "\n" [:td {:style "vertical-align: top"} "Sweden"] [:td {:style "vertical-align: top"} [:a {:href "/countries/SWE"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/SWE.png"}] "SWE"]] "\n" [:td {:style "vertical-align: top"} "Finland"] [:td {:style "vertical-align: top"} [:a {:href "/countries/FIN"} [:img 