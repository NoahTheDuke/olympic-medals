value "ATH"} "Athletics"] "\n" [:option {:value "BOX"} "Boxing"] "\n" [:option {:value "CRD"} "Cycling Road"] "\n" [:option {:value "CTR"} "Cycling Track"] "\n" [:option {:value "DIV"} "Diving"] "\n" [:option {:value "EDR"} "Equestrian Dressage"] "\n" [:option {:value "EVE"} "Equestrian Eventing"] "\n" [:option {:value "EJP"} "Equestrian Jumping"] "\n" [:option {:value "FEN"} "Fencing"] "\n" [:option {:value "FBL"} "Football"] "\n" [:option {:value "HOC"} "Hockey"] "\n" [:option {:value "LAX"} "Lacrosse"] "\n" [:option {:value "MPN"} "Modern Pentathlon"] "\n" [:option {:value "ROW"} "Rowing"] "\n" [:option {:value "SAL"} "Sailing"] "\n" [:option {:value "SWM"} "Swimming"] "\n" [:option {:value "WPO"} "Water Polo"] "\n" [:option {:value "WLF"} "Weightlifting"] "\n" [:option {:value "WRE"} "Wrestling"]]] [:script {} "$('#sports_in_same_games_select').change(function(){location.href='/editions/9/sports/'+$('#sports_in_same_games_select').val()})"] [:form {:id "other_games_form", :class "form-inline", :style "display: inline", :method "get"} [:select {:name "year", :id "sport_in_other_games_select", :class "form-control"} [:option {:value ""} "Korfball in other Games"] "\n" [:option {:value "7"} "1920 Summer Olympics"]]] [:script {} "$('#sport_in_other_games_select').change(function(){location.href='/editions/' + $('#sport_in_other_games_select').val() + '/sports/KBL'})"] "\n" [:h1 {} "Korfball at the 1928 Summer Olympics"] "\n" [:table {:class "biodata"} "\n" [:tbody {} [:tr {} "\n" [:th {} "Dates"] "\n" [:td {} "6 –  6 August 1928"] "\n"] "\n" [:tr {} "\n" [:th {} "Non-medal Events"] "\n" [:td {} "1"] "\n"] "\n" [:tr {} "\n" [:th {} "Venues"] "\n" [:td {}] "\n"] "\n"]] "\n" [:div {:class "description"} "\n" [:p {} "The " [:a {:href "/organizations/1"} "IOC"] " allowed for two demonstration sports to be held at the 1928 Olympics. One of these was reserved for a national sport, specific to the host nation but unknown internationally, and one for an international sport but unknown in the host nation. Korfball, which was already demonstrated at the " [:a {:href "/results/900025"} "1920 Olympics"] ", was elected as the “national” demonstration sport, in part because Dutch IOC member " [:a {:href "/athletes/899372"} "Frederik, Baron van Tuyll van Serooskerken"] " (who passed away in 1924) had promised to select the sport. Kaatsen, however, was picked as an unofficial " [:a {:href "/results/900049"} "second national demonstration"] ". As a tribute, the korfball players participated in a brief memorial prior to their demonstration match, at the Van Tuyll monument outside of the stadium."] "\n\n" [:p {} "In 1993, korfball would be officially recognized by the IOC, and it has been part of the World Games - a multi-sport event for non-Olympic sports - since 1985. It is unlikely to be upgraded to Olympic medal status, as the sport is still primarily played in the Netherlands and, to a lesser extent, Belgium."] "\n\n"] "\n\n\n" [:h2 {} "Non-medal events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/900055"} "Korfball, Mixed"]] "\n" [:td {} "Olympic (non-medal)"] "\n" [:td {} " 6 August 1928"] "\n" [:td {} "24"] "\n" [:td {} "1"] "\n"] "\n" [:tr {} "\n" [:td {}] "\n" [:td {}] "\n" [:td {}] "\n" [:td {:class "border-top"} "\n24 (12/12)\n"] "\n" [:td {:class "border-top"} "\n1 (1/1)\n"] "\n"] "\n"]] "\n\n\n\n"] "\n" [:footer {:class "footer"} "\n" [:br {}] "\n" [:div {:class "panel panel-info"} "\n" [:div {:class "panel-heading"} "\n" [:h3 {:class "panel-title"} "\n" [:span {:class "glyphicon glyphicon-info-sign"}] "\nDid you know?\n"] "\n"] "\n" [:div {:class "panel-body"} "\n" [:p {} "At the 2020 Olympics " [:a {:href "/athletes/116263"} "Hidilyn Diaz"] " won the first ever Olympic gold medal for the Philippines."] "\n\n\n"] "\n"] 