als."] "\n\n" [:p {} "Britain’s " [:a {:href "/athletes/46996"} "Joyce Cooper"] " was the only swimmer to win three medals, but failed to win a gold, winning " [:a {:href "/results/4931"} "one silver"] " and two bronze. Four American swimmers won two gold medals – " [:a {:href "/athletes/51140"} "Martha Norelius"] ", " [:a {:href "/athletes/51143"} "Albina Osipowich"] ", " [:a {:href "/athletes/51448"} "George Kojac"] ", and " [:a {:href "/athletes/51611"} "Johnny Weissmuller"] "."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/4829"} "100 metres Freestyle, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "10 – 11 August 1928"] "\n" [:td {} "30"] "\n" [:td {} "17"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/4843"} "400 metres Freestyle, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "7 –  9 August 1928"] "\n" [:td {} "26"] "\n" [:td {} "17"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/4855"} "1,500 metres Freestyle, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "4 –  6 August 1928"] "\n" [:td {} "19"] "\n" [:td {} "13"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/4887"} "4 × 200 metres Freestyle Relay, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "9 – 11 August 1928"] "\n" [:td {} "55"] "\n" [:td {} "13"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/4866"} "100 metres Backstroke, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "7 –  9 August 1928"] "\n" [:td {} "19"] "\n" [:td {} "12"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/4877"} "200 metres Breaststroke, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "6 –  8 August 1928"] "\n" [:td {} "21"] "\n" [:td {} "13"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/4893"} "100 metres Freestyle, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "10 –