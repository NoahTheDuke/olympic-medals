ther change that began in 1976 was that on the last night of the Olympics, prior to the closing ceremony, the figure skating medalists skated exhibition programs to the delight of an always packed stadium and a large television audience."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/13362"} "Singles, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "8 – 11 February 1976"] "\n" [:td {} "20"] "\n" [:td {} "12"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/13412"} "Singles, Women"]] "\n" [:td {} "Olympic"] "\n" [:td {} "10 – 13 February 1976"] "\n" [:td {} "21"] "\n" [:td {} "15"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/13462"} "Pairs, Mixed"]] "\n" [:td {} "Olympic"] "\n" [:td {} "5 –  7 February 1976"] "\n" [:td {} "28"] "\n" [:td {} "9"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/13492"} "Ice Dancing, Mixed"]] "\n" [:td {} "Olympic"] "\n" [:td {} "4 –  9 February 1976"] "\n" [:td {} "36"] "\n" [:td {} "9"] "\n"] "\n" [:tr {} "\n" [:td {}] "\n" [:td {}] "\n" [:td {}] "\n" [:td {:class "border-top"} "\n105 (52/53)\n"] "\n" [:td {:class "border-top"} "\n18 (16/16)\n"] "\n"] "\n"]] "\n\n\n" [:h2 {} "Medals"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {:colspan "2"} [:span {:class "Gold"} "Gold"]] "\n" [:th {:colspan "2"} [:span {:class "Silver"} "Silver"]] "\n" [:th {:colspan "2"} [:span {:class "Bronze"} "Bronze"]] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {:class "top"} [:a {:href "/results/13362"} "Singles, Men"]] "\n" [:td {:style "vertical-align: top"} [:a {:href "/athletes/84944"} "John Curry"]] [:td {:style "vertical-align: top"} [:a {:href "/countries/GBR"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https: