D"} "Cycling Road"] "\n" [:option {:value "CTR"} "Cycling Track"] "\n" [:option {:value "FEN"} "Fencing"] "\n" [:option {:value "ROW"} "Rowing"] "\n" [:option {:value "SHO"} "Shooting"] "\n" [:option {:value "SWM"} "Swimming"] "\n" [:option {:value "TEN"} "Tennis"] "\n" [:option {:value "WLF"} "Weightlifting"]]] [:script {} "$('#sports_in_same_games_select').change(function(){location.href='/editions/1/sports/'+$('#sports_in_same_games_select').val()})"] [:form {:id "other_games_form", :class "form-inline", :style "display: inline", :method "get"} [:select {:name "year", :id "sport_in_other_games_select", :class "form-control"} [:option {:value ""} "Wrestling in other Games"] "\n" [:option {:value "75"} "1870 Zappas Olympic Games"] "\n" [:option {:value "3"} "1904 Summer Olympics"] "\n" [:option {:value "4"} "1906  Intercalated Games"] "\n" [:option {:value "5"} "1908 Summer Olympics"] "\n" [:option {:value "6"} "1912 Summer Olympics"] "\n" [:option {:value "7"} "1920 Summer Olympics"] "\n" [:option {:value "8"} "1924 Summer Olympics"] "\n" [:option {:value "9"} "1928 Summer Olympics"] "\n" [:option {:value "10"} "1932 Summer Olympics"] "\n" [:option {:value "11"} "1936 Summer Olympics"] "\n" [:option {:value "12"} "1948 Summer Olympics"] "\n" [:option {:value "13"} "1952 Summer Olympics"] "\n" [:option {:value "14"} "1956 Summer Olympics"] "\n" [:option {:value "15"} "1960 Summer Olympics"] "\n" [:option {:value "16"} "1964 Summer Olympics"] "\n" [:option {:value "17"} "1968 Summer Olympics"] "\n" [:option {:value "18"} "1972 Summer Olympics"] "\n" [:option {:value "19"} "1976 Summer Olympics"] "\n" [:option {:value "20"} "1980 Summer Olympics"] "\n" [:option {:value "21"} "1984 Summer Olympics"] "\n" [:option {:value "22"} "1988 Summer Olympics"] "\n" [:option {:value "23"} "1992 Summer Olympics"] "\n" [:option {:value "24"} "1996 Summer Olympics"] "\n" [:option {:value "25"} "2000 Summer Olympics"] "\n" [:option {:value "26"} "2004 Summer Olympics"] "\n" [:option {:value "53"} "2008 Summer Olympics"] "\n" [:option {:value "65"} "2010 Summer Youth Olympics"] "\n" [:option {:value "54"} "2012 Summer Olympics"] "\n" [:option {:value "67"} "2014 Summer Youth Olympics"] "\n" [:option {:value "59"} "2016 Summer Olympics"] "\n" [:option {:value "69"} "2018 Summer Youth Olympics"] "\n" [:option {:value "61"} "2020 Summer Olympics"] "\n" [:option {:value "63"} "2024 Summer Olympics"]]] [:script {} "$('#sport_in_other_games_select').change(function(){location.href='/editions/' + $('#sport_in_other_games_select').val() + '/sports/WRE'})"] "\n" [:h1 {} "Wrestling at the 1896 Summer Olympics"] "\n" [:table {:class "biodata"} "\n" [:tbody {} [:tr {} "\n" [:th {} "Dates"] "\n" [:td {} "10 – 11 April 1896"] "\n"] "\n" [:tr {} "\n" [:th {} "Medal Events"] "\n" [:td {} "1"] "\n"] "\n" [:tr {} "\n" [:th {} "Venues"] "\n" [:td {} [:a {:href "/venues/186"} "Panathinaiko Stadio, Athina"]] "\n"] "\n"]] "\n" [:div {:class "description"} "\n" [:p {} "The 1896 wrestling competition consisted of a single event. It was contested basically in the Greco-Roman style, although some legholds were allowed. No weight limit was placed. The matches took place in the infield of the " [:a {:href "/venues/186"} "Panathinaiko Stadio"] ", on a sand-covered circle near the Splendone end of the stadium. There was no time limit, with a wrestler losing if he was thrown onto his back."] "\n\n" [:p {} "Britain’s " [:a {:href "/athletes/69034"} "Launceston Elliot"] ", already popular with the Greeks because of his performance in " [:a {:href "/editions/1/sports/WLF"} "weightlifting"] ", was thought to be a favorite. He was much larger than his opponent, Germany’s " [:a {:href "/athletes/70502"} "Carl Schuhmann"] ", but Schuhmann defeated him easily. Elliot took his defeat badly, claiming that only one of his shoulders touched the ground, not both as required by the rules. After refusing to accept the judge’s decision, he had to be escorted from the field by the Royal Princes."] "\n\n" [:p {} "The Greeks were upset when their two wrestlers, " [:a {:href "/athletes/58508"} "Georgios Tsitas"] " and " [:a {:href "/athletes/58481"} "Stefanos Christopoulos"] ", met each other in the only semi-final. Tsitas won when Christopoulos had to retire with a broken shoulder."] "\n\n" [:p {} "The matches had started in the late afternoon on a Friday.  After the semi-final, this left Carl Schuhmann to wrestle against Georgios Tsitas in the final. After 40 minutes of wrestling, no decision had been reached and it was now quite dark. The match was postponed to 0900 Saturday morning, although Schuhmann protested, stating that it would take him only a few more minutes to defeat Tsitas. It took Schuhmann 15 minutes more on Saturday morning to defeat Tsitas, with an armpull and a pressed-down bridge. He became the first known Olympic wrestling champion since " [:a {:href "/athletes/2800241"} "Aurelius Helix"] " of Phoenicia in " [:a {:href "/results/14001016"} "213 AD"] "."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/120000"} "Unlimited Class, Greco-Roman, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "10 – 11 April 1896"] "\n" [:td {} "5"] "\n" [:td {} "4"] "\n"] "\n" [:tr {} "\n" [:td {}] "\n" [:td {}] "\n" [:td {}] "\n" [:td {:class "border-top"} "\n5 (5/0)\n"] "\n" [:td {:class "border-top"} "\n4 (4/0)\n"] "\n"] "\n"]] "\n\n\n" [:h2 {} "Medals"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {:colspan "2"} [:span {:class "Gold"} "Gold"]] "\n" [:th {:colspan "2"} [:span {:class "Silver"} "Silver"]] "\n" [:th {:colspan "2"} [:span {:class "Bronze"} "Bronze"]] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {:class "top"} [:a {:href "/results/120000"} "Unli