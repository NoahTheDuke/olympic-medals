s accompanied by Prince Konstantinos, King Alexandros of Serbia, Queen Olga, and Prince Andreas. French cyclist " [:a {:href "/athletes/15526"} "Paul Masson"] " (no relation to the wine company) won three gold medals on the track."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/153001"} "Sprint, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "11 April 1896"] "\n" [:td {} "4"] "\n" [:td {} "3"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/153000"} "333⅓ metres Time Trial, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "11 April 1896"] "\n" [:td {} "8"] "\n" [:td {} "5"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/153002"} "10,000 metres, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "11 April 1896"] "\n" [:td {} "6"] "\n" [:td {} "4"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/153003"} "100 kilometres, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} " 8 April 1896"] "\n" [:td {} "9"] "\n" [:td {} "5"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/153004"} "12-Hours Race, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "13 April 1896"] "\n" [:td {} "7"] "\n" [:td {} "4"] "\n"] "\n" [:tr {} "\n" [:td {}] "\n" [:td {}] "\n" [:td {}] "\n" [:td {:class "border-top"} "\n16 (16/0)\n"] "\n" [:td {:class "border-top"} "\n5 (5/0)\n"] "\n"] "\n"]] "\n\n\n" [:h2 {} "Medals"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {:colspan "2"} [:span {:class "Gold"} "Gold"]] "\n" [:th {:colspan "2"} [:span {:class "Silver"} "Silver"]] "\n" [:th {:colspan "2"} [:span {:class "Bronze"} "Bronze"]] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {:class "top"} [:a {:href "/results/153001"} "Sprint, Men"]] "\n" [:td {:style "vertical-align: top"} [:a {:href "/athletes/15526"} "