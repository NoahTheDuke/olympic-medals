have accounted for the closeness of the finishing times. Although Switzerland were clear winners the rest of the top ten were separated by less than four tenths of a second."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/431"} "Two, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "14 – 15 February 1998"] "\n" [:td {} "76"] "\n" [:td {} "24"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/438"} "Four, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "20 – 21 February 1998"] "\n" [:td {} "128"] "\n" [:td {} "25"] "\n"] "\n" [:tr {} "\n" [:td {}] "\n" [:td {}] "\n" [:td {}] "\n" [:td {:class "border-top"} "\n156 (156/0)\n"] "\n" [:td {:class "border-top"} "\n28 (28/0)\n"] "\n"] "\n"]] "\n\n\n" [:h2 {} "Medals"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {:colspan "2"} [:span {:class "Gold"} "Gold"]] "\n" [:th {:colspan "2"} [:span {:class "Silver"} "Silver"]] "\n" [:th {:colspan "2"} [:span {:class "Bronze"} "Bronze"]] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {:class "top"} [:a {:href "/results/431"} "Two, Men"]] "\n" [:td {:style "vertical-align: top"} "Canada 1" [:br {}] "Italy 1"] [:td {:style "vertical-align: top"} [:a {:href "/countries/CAN"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/CAN.png"}] "CAN"] [:br {}] [:a {:href "/countries/ITA"} [:img {:style "padding-right: 2px; vertical-align: middle", :src "https://olympedia-flags.s3.eu-central-1.amazonaws.com/ITA.png"}] "ITA"]] "\n" [:td {:style "vertical-align: top"} "—"] [:td {:style "vertical-align: top"} "—"] "\n" [:td {:style "vertical-align: top"} "Germany 1"] [:td {:style "vertical-align: top"} [:a {:href "/countries/GER"} [:img