RE"} "Wrestling"]]] [:script {} "$('#sports_in_same_games_select').change(function(){location.href='/editions/61/sports/'+$('#sports_in_same_games_select').val()})"] [:form {:id "other_games_form", :class "form-inline", :style "display: inline", :method "get"} [:select {:name "year", :id "sport_in_other_games_select", :class "form-control"} [:option {:value ""} "Table Tennis in other Games"] "\n" [:option {:value "22"} "1988 Summer Olympics"] "\n" [:option {:value "23"} "1992 Summer Olympics"] "\n" [:option {:value "24"} "1996 Summer Olympics"] "\n" [:option {:value "25"} "2000 Summer Olympics"] "\n" [:option {:value "26"} "2004 Summer Olympics"] "\n" [:option {:value "53"} "2008 Summer Olympics"] "\n" [:option {:value "65"} "2010 Summer Youth Olympics"] "\n" [:option {:value "54"} "2012 Summer Olympics"] "\n" [:option {:value "67"} "2014 Summer Youth Olympics"] "\n" [:option {:value "59"} "2016 Summer Olympics"] "\n" [:option {:value "69"} "2018 Summer Youth Olympics"] "\n" [:option {:value "63"} "2024 Summer Olympics"]]] [:script {} "$('#sport_in_other_games_select').change(function(){location.href='/editions/' + $('#sport_in_other_games_select').val() + '/sports/TTE'})"] "\n" [:h1 {} "Table Tennis at the 2020 Summer Olympics"] "\n" [:table {:class "biodata"} "\n" [:tbody {} [:tr {} "\n" [:th {} "Dates"] "\n" [:td {} "24 July –  6 August 2021"] "\n"] "\n" [:tr {} "\n" [:th {} "Medal Events"] "\n" [:td {} "5"] "\n"] "\n" [:tr {} "\n" [:th {} "Venues"] "\n" [:td {} [:a {:href "/venues/463"} "Tōkyō Taiikukan, Shibuya, Tokyo"]] "\n"] "\n"]] "\n" [:div {:class "description"} "\n" [:p {} "The table tennis competitions were held between 24 July and 6 August in the Tokyo Metropolitan Gymnasium (Tōkyō Taiikukan). A total of 174 athletes (86 men and 88 women), representing 57 NOCs, competed in five events. For the first time since 2008, when the men’s and women’s doubles were replaced by respective team events, the program was changed. In line with the IOC’s attempt to introduce more mixed events, a mixed doubles contest was added. Interestingly, the women’s singles saw 70 players competing compared to 65 in the men’s event. For the mixed doubles, as well as for both team events, only one team per country could qualify for a maximum of 16 teams in each event."] "\n\n" [:p {} "Just like at the 2008-16 Olympics, the People’s Republic of China took gold and silver in both men and women’s singles and also gold in the two team events. " [:a {:href "/athletes/121929"} "Ma Long"] " repeated his 2016 double gold success, while the women’s events saw the rise of " [:a {:href "/athletes/141782"} "Chen Meng"] " taking gold in both the singles and team event. In the mixed, Japan with Rio medallists " [:a {:href "/athletes/117511"} "Jun Mizutani"] " and " [:a {:href "/athletes/130838"} "Mima Ito"] " probably benefitted from the home advantage and defeated the Chinese pair in seven hard-fought games, 4-3. In the medal count, Japan placed second behind the dominant Chinese with one gold, one silver and two bronze. The 32-year-old veteran " [:a {:href "/athletes/117509"} "Dimitrij Ovtcharov"] " won bronze in the singles and silver in the team event as Germany’s top player. He added the medals number five and six to his tally, as he took home at least one medal from every Olympics since 2008."] "\n\n"] "\n\n" [:h2 {} "Events"] "\n" [:table {:class "table table-striped"} "\n" [:thead {} "\n" [:tr {} "\n" [:th {} "Event"] "\n" [:th {} "Status"] "\n" [:th {} "Date"] "\n" [:th {} "Participants"] "\n" [:th {} "NOCs"] "\n"] "\n"] "\n" [:tbody {} [:tr {} "\n" [:td {} [:a {:href "/results/19003870"} "Singles, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "24 – 30 July 2021"] "\n" [:td {} "64"] "\n" [:td {} "43"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19003949"} "Team, Men"]] "\n" [:td {} "Olympic"] "\n" [:td {} "1 –  6 August 2021"] "\n" [:td {} "48"] "\n" [:td {} "16"] "\n"] "\n" [:tr {} "\n" [:td {} [:a {:href "/results/19004030"} "Singles, Wome